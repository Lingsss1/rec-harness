    "equations": {
      "entry": "e=L0(query,H)",
      "round1": "raw1=L1(e,H); z1=e+g1*(raw1-e); y1=L2(e,z1)",
      "carry": "q2=e+0.5*(z1-e)",
      "round2": "raw2=L1(q2,H); z2=q2+g2*(raw2-q2); y2=L2(y1,z2); original post and task heads",
      "gate": "g_t=1+tanh(a_t), per channel, a initialized zero",
      "shared": "a1=a2 is one trainable vector",
      "distinct": "a1,a2 independent trainable vectors",
      "no_carry": "q2=e; keep z1,y1 and complete second work/prediction computation"
    },
    "planned_fits": [
      "shared_carry",
      "distinct_carry",
