{
  "loader_contract": {
    "class": "MaturityUniRankDataloader",
    "maturity_mode": [
      "mature"
    ],
    "num_workers": 0,
    "max_len": 100,
    "padding": "pre",
    "target_index": "unchanged original seq_len l",
    "target_timestamp": "full_timestamp_seq[l] inferred from matching user_info row",
    "independent_target_timestamp_crosscheck_available": false,
    "slice": "[max(0,l-100):l] before masking",
    "valid_history": "item>0 AND history_timestamp<target_timestamp",
    "same_second": "exclude entire token in both modes",
    "future_history": "exclude entire token in both modes; report separately",
    "backfill": false,
    "masked_history_fields": "all item_dict history fields zero; common history mask zero",
    "positions": "native cumsum(valid_mask)-1 convention after common masking",
    "target_action": 0,
    "target_labels": "all four original labels unchanged",
    "target_rows_and_seq_len": "never filter/reindex target rows or rewrite seq_len",
    "released": "retain original action combination on common valid history",
    "mature": "retain original combination only if history_timestamp+86400<target_timestamp; otherwise hide BOTH positive and zero cart/fav/buy, retaining click only under its explicit availability assumption",
    "window_seconds": 86400,
    "window_tasks": [
      "cart",
      "fav",
      "buy"
    ],
    "equality_at_86400": "immature",
    "action_ids": {
      "0": "padding",
      "1..16": "original ID-to-name map unchanged",
      "17": "delayed_unknown",
      "18": "is_click|delayed_unknown"
    },
    "unknown_semantics": "cart/fav/buy unavailable, not mature negative, exposure or padding; action embedding must use 17/18",
    "unknown_task_masks": "zero means no observed positive in the helper mask, not known negative; original QFormer consumes actual action embedding",
    "click_availability": "conditional assumption; no independent click-event or ingestion timestamp",
    "original_release_files": "read-only; create a separate derived feature map/metadata identity, never relabel original files",
    "per_target_transform": true,
    "tuple_contract": "batch_dict,item_dict,history_mask,multi_masks preserved",
    "audit": "mode-independent ordered row/batch identity, mode-specific transformed-input identity, exclusions/unknown counts, valid-length/empty counts, source checks and side-cache read counts/costs; reconcile all four runs without a separate broad scan"
  },
  "execution_limits": {
