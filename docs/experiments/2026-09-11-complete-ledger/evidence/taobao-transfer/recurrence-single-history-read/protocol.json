    "entry_memory": "original H0",
    "work_steps": 2,
    "prediction_to_work_feedback": false,
    "history_encoder_calls_per_forward": 1,
    "sequence": "G→L0(H0)→L1(Hread1)→optional history gate(e or z1)→L2→L1(Hread2)→L2→original post",
