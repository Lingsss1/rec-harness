+    observed_items = torch.where(selected, pos, seq)
+    observed_candidates = (
+        observed_items.unsqueeze(-1) == candidate_ids.view(1, 1, -1)
+    ).any(dim=1)
+    row_ids = selected.nonzero(as_tuple=True)[0]
+    invalid_candidates = observed_candidates[row_ids]
+    invalid_candidates = invalid_candidates | (
+        targets.unsqueeze(1) == candidate_ids.unsqueeze(0)
+    )
+    candidate_scores = candidate_scores.masked_fill(
