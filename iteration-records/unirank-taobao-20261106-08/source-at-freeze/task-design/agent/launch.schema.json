{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task-independent research launch references",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_ref", "runtime_ref", "workspace_ref"],
  "properties": {
    "task_ref": {"type": "string", "pattern": "^task://[A-Za-z0-9._/-]+$"},
    "runtime_ref": {"type": "string", "pattern": "^run://[A-Za-z0-9._/-]+$"},
    "workspace_ref": {"type": "string", "pattern": "^workspace://[A-Za-z0-9._/-]+$"}
  }
}
