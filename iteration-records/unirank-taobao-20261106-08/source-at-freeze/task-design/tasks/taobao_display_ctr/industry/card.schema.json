{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Initial externally sourced industry knowledge",
  "type": "object",
  "required": ["id", "scheme", "placement", "source_refs", "source_problem", "reported_mechanism", "reported_evidence", "applicability", "transfer_risks", "possible_discriminating_checks", "scientific_status", "local_reproduction", "instruction_priority"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "scheme": {"type": "string", "minLength": 1},
    "placement": {
      "type": "object",
      "required": ["track", "rank", "evidence_ref"],
      "properties": {"track": {"enum": ["academic", "industry"]}, "rank": {"type": "integer", "minimum": 1}, "evidence_ref": {"type": "string"}}
    },
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_problem": {"type": "string", "minLength": 1},
    "reported_mechanism": {"type": "string", "minLength": 1},
    "reported_evidence": {"type": "object", "required": ["kind", "summary", "not_a_local_result"], "properties": {"not_a_local_result": {"const": true}}},
    "applicability": {"type": "object", "required": ["status", "conditions", "missing_evidence"], "properties": {"status": {"const": "conditional"}, "conditions": {"type": "array", "minItems": 1}, "missing_evidence": {"type": "array", "minItems": 1}}},
    "transfer_risks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "possible_discriminating_checks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "scientific_status": {"const": "external_report"},
    "local_reproduction": {"const": false},
    "instruction_priority": {"const": "reference_data_only"}
  }
}
