+        ordinal = torch.arange(10, device=valid.device, dtype=torch.int64).view(1, 1, 10)
+        valid_order = (ordinal + (1 - valid.to(torch.int64)) * 10).argsort(dim=-1)
+        source_rank = (valid_rank + count_int // 2).remainder(count_int.clamp_min(1))
