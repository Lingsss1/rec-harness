+    def _primary_interactions(self, target, values):
+        """Gate only extra-support input roles, before every interaction term.
+
+        Layout is [batch, 10 blocks, 7 strata]. Rows 0..2 keep their original
+        graph; rows 3..6 may use detached query and/or value operands. Values
+        include historical action as well as item keys. Native Dice still
+        differentiates through both moments and all scorer parameters. No
+        preactivation detach is used, and the auxiliary builder is untouched.
+        Shared embedding-table gradients can survive through other roles,
+        readouts and summaries even when a support operand is detached.
+        """
+        batch, slots, _ = values.shape
+        if slots != 70:
+            raise ValueError('Primary support routing requires 70 ordered strata')
+        if not self.training or (self.support_query_gradient and self.support_value_gradient):
+            # Exact native bridge, including graph/operation order.
+            return self._interactions(target, values)
+        retained = (torch.arange(slots, device=values.device).remainder(7) < 3).view(1, slots, 1)
+        query = target[:, None, :].expand(-1, slots, -1)
+        if not self.support_query_gradient:
+            query = torch.where(retained, query, query.detach())
+        if not self.support_value_gradient:
+            values = torch.where(retained, values, values.detach())
+        keys = values[:, :, :self.key_width]
+        action = values[:, :, self.key_width:]
+        return torch.cat([query, keys, query - keys, query * keys, action], dim=-1).reshape(batch * slots, -1)
+
