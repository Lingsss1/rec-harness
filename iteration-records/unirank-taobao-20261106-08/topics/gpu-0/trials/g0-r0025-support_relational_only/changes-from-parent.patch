+    def _primary_interactions(self, target, values):
+        """Stop selected support-input Jacobians AFTER forming interactions.
+
+        Flattening follows [batch, 10 blocks, 7 strata]. Rows 0..2 retain all
+        input derivatives. For rows 3..6, the direct family is [q,k,action]
+        and the relational family is [q-k,q*k]. Detaching a formed term
+        preserves its forward value and its affine-weight gradient, while
+        removing just that term's derivative into the embedding operands.
+        Native Dice and all scorer parameters stay attached. This differs
+        from detaching q or k before constructing every interaction term.
+        Shared embedding tables remain trainable via all other live paths.
+        """
+        batch, slots, _ = values.shape
+        if slots != 70:
+            raise ValueError('Primary support routing requires 70 ordered strata')
+        interactions = self._interactions(target, values)
+        if not self.training or (self.support_marginal_gradient and self.support_relational_gradient):
+            # Exact native both-attached bridge; no extra tensor operations.
+            return interactions
+        retained = (torch.arange(batch * slots, device=values.device)
+                    .remainder(7) < 3).unsqueeze(-1)
+        if not self.support_marginal_gradient and not self.support_relational_gradient:
+            # Derivative-equivalent to detaching both support operands in
+            # r0024; fixed-state forward/buffer and backward parity need
+            # host verification, especially under the frozen BF16 recipe.
+            return torch.where(retained, interactions, interactions.detach())
+        direct, relative, action = torch.split(
+            interactions, [2 * self.key_width, 2 * self.key_width,
+                           self.value_width - self.key_width], dim=-1)
+        if not self.support_marginal_gradient:
+            direct = torch.where(retained, direct, direct.detach())
+            action = torch.where(retained, action, action.detach())
+        if not self.support_relational_gradient:
+            relative = torch.where(retained, relative, relative.detach())
+        return torch.cat([direct, relative, action], dim=-1)
+
