+    def _gate_auxiliary_adapter_context(self, context):
+        """Forward-identical selection of context field backward edges.
+
+        No normalization is recomputed or split. The same full-batch tower
+        Dice still couples examples. These are field tensor-edge controls,
+        not loss-example selection or complete optimizer isolation.
+        """
+        identity = self.aux_adapter_identity_context_grad
+        other = self.aux_adapter_other_context_grad
+        if identity and other:
+            return context
+        if not identity and not other:
+            return context.detach()
+        if context.ndim != 2 or context.shape[-1] != len(self.user_fields) * self._aux_context_field_width:
+            raise ValueError('Context field-width mismatch')
+        fields = context.split(self._aux_context_field_width, dim=-1)
+        return torch.cat([
+            value if (identity if index == self._aux_identity_field_index else other)
+            else value.detach()
+            for index, value in enumerate(fields)
+        ], dim=-1)
