+class _AuxiliaryContextCotangent(torch.autograd.Function):
+    """Identity forward with a declared first-order backward replacement.
+
+    This custom VJP intentionally differs from the derivative of an identity
+    map. Validate its analytic VJP, not an identity finite-difference test.
+    One shared invocation collects the sum of all three auxiliary task
+    cotangents before the replacement. No other model path uses its output.
+    """
+
+    @staticmethod
+    def forward(ctx, context, field_width, mode):
+        ctx.save_for_backward(context)
+        ctx.field_width = field_width
+        ctx.mode = mode
+        return context
+
+    @staticmethod
+    @torch.autograd.function.once_differentiable
+    def backward(ctx, grad_output):
+        context, = ctx.saved_tensors
+        # No optimizer state, parameter gradients, labels or host state are
+        # inspected. Every reduction is local to one example and one field.
+        with torch.autocast(device_type=context.device.type, enabled=False):
+            reference = context.detach().float().reshape(
+                context.shape[0], -1, ctx.field_width)
+            gradient = grad_output.float().reshape_as(reference)
+            reference_norm2 = reference.square().sum(dim=-1, keepdim=True)
+            unit = reference * reference_norm2.clamp_min(1e-12).rsqrt()
+            unit = torch.where(reference_norm2 > 1e-12, unit,
+                               torch.zeros_like(unit))
+            radial = unit * (gradient * unit).sum(dim=-1, keepdim=True)
+            tangent = gradient - radial
+            gradient_norm2 = gradient.square().sum(dim=-1, keepdim=True)
+            tangent_norm2 = tangent.square().sum(dim=-1, keepdim=True)
+            gain = (tangent_norm2 / gradient_norm2.clamp_min(1e-30)).sqrt()
+            norm_matched = gradient * gain
+            # A fixed numerical guard passes negligible cotangents through
+            # in BOTH modes, maintaining their matched local norm. Zero
+            # reference vectors have unit=0 and pass all gradients through.
+            reliable = gradient_norm2 > 1e-30
+            tangent = torch.where(reliable, tangent, gradient)
+            norm_matched = torch.where(reliable, norm_matched, gradient)
+            result = tangent if ctx.mode == 'tangent' else norm_matched
+        return result.reshape_as(grad_output).to(context.dtype), None, None
 
 
