+    def _auxiliary_product_context(self, context):
+        """Preserve values; gate only the selected field input derivatives.
+
+        Called only on an enabled auxiliary product path during training.
+        Linear query parameters still learn from all context field values.
+        Pure identity/full-detach cases preserve the prior execution graph;
+        mixed cases use views and concatenate unchanged field values.
+        """
+        identity = self.aux_product_identity_context_grad
+        other = self.aux_product_other_context_grad
+        if identity and other:
+            return context
+        if not identity and not other:
+            return context.detach()
+        fields = context.split(self._context_field_widths, dim=-1)
+        return torch.cat([
+            value if (identity if name == 'user_id' else other) else value.detach()
+            for name, value in zip(self.user_fields, fields)
+        ], dim=-1)
