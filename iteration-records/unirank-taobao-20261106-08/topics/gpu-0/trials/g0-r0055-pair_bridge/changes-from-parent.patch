+    @staticmethod
+    def _block_pair_statistics(hidden, occupied):
+        """Centered diagonal products on paths with equal node degrees.
+
+        Compact valid blocks in their original order, then permute interior
+        ranks even-first/odd-second for the scrambled path. Both paths retain
+        the original endpoints, all M nodes and exactly M-1 edges. This
+        excludes padding and matches degree-weighted marginal second moments.
+        A common M>=4 gate excludes cases with no distinct interior ordering.
+        All arithmetic on bounded tanh outputs is FP32, without variance
+        division, random draws, new parameters or mutation of native buffers.
+        """
+        batch, length, width = hidden.shape
+        ranks = torch.arange(length, device=hidden.device).view(1, length).expand(batch, -1)
+        count = occupied.sum(dim=1, keepdim=True)
+        # Unique integer keys put occupied blocks first in original order;
+        # no stable-sort assumption and no ordering of hidden values is used.
+        compact_indices = torch.argsort(ranks + (~occupied).long() * length, dim=1)
+        safe_hidden = torch.where(occupied.unsqueeze(-1), hidden.float(),
+                                  torch.zeros_like(hidden, dtype=torch.float32))
+        compact = torch.gather(safe_hidden, 1, compact_indices.unsqueeze(-1).expand(-1, -1, width))
+        active = ranks < count
+        mean = compact.sum(dim=1, keepdim=True) / count.clamp_min(1).unsqueeze(-1).float()
+        centered = torch.where(active.unsqueeze(-1), compact - mean,
+                               torch.zeros_like(compact))
+        interior_key = ranks.remainder(2) * length + ranks
+        keys = torch.where(ranks == 0, torch.full_like(ranks, -1), interior_key)
+        keys = torch.where(ranks == count - 1, torch.full_like(ranks, 2 * length), keys)
+        keys = torch.where(active, keys, 3 * length + ranks)
+        permutation = torch.argsort(keys, dim=1)
+        scrambled = torch.gather(centered, 1, permutation.unsqueeze(-1).expand(-1, -1, width))
+        edge_mask = ((ranks[:, :-1] < count - 1) & (count >= 4)).unsqueeze(-1).float()
+        divisor = (count - 1).clamp_min(1).float()
+        left, right = centered[:, :-1], centered[:, 1:]
+        ordered = (left * right * edge_mask).sum(dim=1) / divisor
+        shuffled = (scrambled[:, :-1] * scrambled[:, 1:] * edge_mask).sum(dim=1) / divisor
+        marginal = (0.5 * (left.square() + right.square()) * edge_mask).sum(dim=1) / divisor
+        # |centered|<=2, so this prospectively fixed scale bounds each
+        # statistic by one. No data-dependent rescaling or hyperparameter fit.
+        return 0.25 * ordered, 0.25 * shuffled, 0.25 * marginal
+
