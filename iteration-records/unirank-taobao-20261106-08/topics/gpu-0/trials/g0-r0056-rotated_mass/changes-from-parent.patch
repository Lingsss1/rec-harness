+    @staticmethod
+    def _rotate_occupied_counts(counts, occupied):
+        """One-step cyclic count permutation on occupied ordinal ranks.
+
+        Empty entries never enter packed counts. Support, total mass and
+        the positive count multiset are unchanged, including sparse gaps.
+        There is no RNG, learned state, value dependence or label access.
+        """
+        safe_counts = torch.where(occupied, counts.float(), torch.zeros_like(counts).float())
+        ranks = (occupied.long().cumsum(dim=1) - 1).clamp_min(0)
+        number = occupied.long().sum(dim=1, keepdim=True)
+        packed = torch.zeros_like(safe_counts).scatter_add(1, ranks, safe_counts)
+        source = (ranks + 1).remainder(number.clamp_min(1))
+        rotated = packed.gather(1, source)
+        return torch.where(occupied, rotated, torch.zeros_like(rotated))
