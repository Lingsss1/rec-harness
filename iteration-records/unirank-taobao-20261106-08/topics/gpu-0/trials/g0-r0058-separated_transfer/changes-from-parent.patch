+    @staticmethod
+    def _block_pair_indices(occupied):
+        """Symmetric partners in occupied chronological rank; no learned state.
+
+        Pack only occupied original positions. For even E<=M, both pairings
+        pair ranks0..E-1; if M is odd, the newest rank M-1 pairs with itself.
+        The two maps are involutions with identical fixed points/support.
+        Invalid positions may point to rank0 but are excluded before/after use.
+        All index operations depend solely on the authorized history mask.
+        """
+        batch, length = occupied.shape
+        positions = torch.arange(length, device=occupied.device, dtype=torch.long)
+        positions = positions.unsqueeze(0).expand(batch, -1)
+        valid = occupied.to(torch.long)
+        ranks = (valid.cumsum(dim=1) - 1).clamp_min(0)
+        packed_positions = torch.zeros_like(positions).scatter_add(
+            1, ranks, positions * valid)
+        number = valid.sum(dim=1, keepdim=True)
+        even = number - number.remainder(2)
+        paired = occupied & (ranks < even)
+        adjacent_rank = ranks + 1 - 2 * ranks.remainder(2)
+        separated_rank = (ranks + even // 2).remainder(even.clamp_min(1))
+        adjacent_rank = torch.where(paired, adjacent_rank, ranks)
+        separated_rank = torch.where(paired, separated_rank, ranks)
+        adjacent = packed_positions.gather(1, adjacent_rank)
+        separated = packed_positions.gather(1, separated_rank)
+        return adjacent, separated
+
+    @staticmethod
+    def _paired_block_summary(preactivation, occupied, partner, number):
+        # Both operands are FP32. Scale before adding to avoid gratuitous
+        # overflow from adding two large finite same-sign preactivations.
+        safe = torch.where(occupied.unsqueeze(-1), preactivation,
+                           torch.zeros_like(preactivation))
+        partner_values = safe.gather(
+            1, partner.unsqueeze(-1).expand(-1, -1, safe.shape[-1]))
+        paired = 0.5 * safe + 0.5 * partner_values
+        hidden = torch.tanh(paired)
+        hidden = torch.where(occupied.unsqueeze(-1), hidden,
+                             torch.zeros_like(hidden))
+        return hidden.sum(dim=1) / number.clamp_min(1.0)
+
