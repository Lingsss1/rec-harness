+    def _block_activation(self, preactivation):
+        """Exact selected forward value; explicitly selected local derivative.
+
+        f.detach() + (g - g.detach()) has value f and local derivative g'.
+        The parentheses preserve exact forward values for finite tensors.
+        Both g paths execute backward in all cells through a zero edge.
+        Off-diagonal cells are declared surrogate-gradient interventions.
+        They must be checked against the selected analytic derivative,
+        not finite differences of their forward map. No custom autograd,
+        hooks, parameter/state mutation or label-dependent rule is used.
+        """
+        z = preactivation.float()
+        tanh_value = torch.tanh(z)
+        softsign_value = z / (1.0 + z.abs())
+        forward_value = (tanh_value if self.block_forward_activation == 'tanh'
+                         else softsign_value)
+        if self.block_backward_activation == 'tanh':
+            backward_value = tanh_value + 0.0 * softsign_value
+        else:
+            backward_value = softsign_value + 0.0 * tanh_value
+        return forward_value.detach() + (backward_value - backward_value.detach())
+
