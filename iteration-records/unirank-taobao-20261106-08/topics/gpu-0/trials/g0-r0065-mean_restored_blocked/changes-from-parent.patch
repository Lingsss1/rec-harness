+class _MeanDirectionVJP(torch.autograd.Function):
+    """Identity forward with explicitly prescribed first-order backward.
+
+    This sits BEFORE the live RMS normalizer, so incoming v is J_R(x)^T g.
+    Project v onto the orthogonal complement of the all-ones direction.
+    Scaling for norm computation avoids squaring tiny raw gradients. It does
+    not change the prescribed ratios in real arithmetic. Both alternatives
+    execute in every cell. There is no RNG, persistent state or added capacity.
+    An exactly constant v projects to zero; its lost direction cannot be
+    normalized. Both intervention modes return zero in that degenerate case.
+    No finite-difference claim is made for this intentional surrogate VJP.
+    """
+    @staticmethod
+    def forward(ctx, fused, mode):
+        ctx.mode = mode
+        return fused.clone()
+
+    @staticmethod
+    def backward(ctx, grad_output):
+        v = grad_output.float()
+        projected = v - v.mean(dim=-1, keepdim=True)
+        scale = v.abs().amax(dim=-1, keepdim=True)
+        safe_scale = torch.where(scale > 0, scale, torch.ones_like(scale))
+        unit = v / safe_scale
+        projected_unit = projected / safe_scale
+        native_norm = torch.linalg.vector_norm(unit, dim=-1, keepdim=True)
+        projected_norm = torch.linalg.vector_norm(projected_unit, dim=-1, keepdim=True)
+        safe_native_norm = torch.where(
+            native_norm > 0, native_norm, torch.ones_like(native_norm))
+        safe_projected_norm = torch.where(
+            projected_norm > 0, projected_norm, torch.ones_like(projected_norm))
+        restored = (projected_unit / safe_projected_norm) * native_norm * scale
+        shrunk = v * (projected_norm / safe_native_norm)
+        if ctx.mode == 'mean_restored':
+            result = restored
+        elif ctx.mode == 'native_shrunk':
+            result = shrunk
+        elif ctx.mode == 'mean_removed':
+            # Diagnostic endpoint: previous trial's exact FP32 projection.
+            result = projected
+        elif ctx.mode == 'native':
+            # Diagnostic endpoint: unchanged first-order derivative.
+            result = v
+        else:
+            raise ValueError('Unknown product VJP control')
+        return result.to(grad_output.dtype), None
 
 
