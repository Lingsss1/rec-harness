+class _BranchProductVJP(torch.autograd.Function):
+    """Exact product forward; specified first-order branch derivatives.
+
+    With v = J_R(q*s)^T g and P(v)=v-mean(v), return
+    dq = (P(v) if query_removed else v) * s,
+    ds = (P(v) if summary_removed else v) * q.
+    Projection precedes each branch multiplication, matching the archived
+    pre-RMS mean-removal intervention when both switches are enabled.
+    Both native and projected products execute for every factorial cell.
+    Downstream branch norms are NOT matched; location and magnitude effects
+    are not separated by this experiment. Zero/constant v is handled without
+    a division or arbitrary tolerance. No RNG or persistent state is used.
+    """
+    @staticmethod
+    def forward(ctx, query, summary, query_removed, summary_removed):
+        ctx.save_for_backward(query, summary)
+        ctx.query_removed = query_removed
+        ctx.summary_removed = summary_removed
+        return query * summary
+
+    @staticmethod
+    @torch.autograd.function.once_differentiable
+    def backward(ctx, grad_output):
+        query, summary = ctx.saved_tensors
+        v = grad_output.float()
+        projected = v - v.mean(dim=-1, keepdim=True)
+        native_query = v * summary.float()
+        native_summary = v * query.float()
+        removed_query = projected * summary.float()
+        removed_summary = projected * query.float()
+        query_grad = removed_query if ctx.query_removed else native_query
+        summary_grad = removed_summary if ctx.summary_removed else native_summary
+        return (query_grad.to(query.dtype), summary_grad.to(summary.dtype),
+                None, None)
 
 
