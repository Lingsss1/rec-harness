+class _BuyContextVJP(torch.autograd.Function):
+    """Split context values, then replace only the buy-to-context VJP.
+
+    Both output copies are always used, including in the raw control, so
+    private branch derivatives and backward work are retained. Work in FP32
+    before casting the final input derivative. A zero selected direction
+    falls back to the sum; such rows do not identify a direction effect.
+    Zero sum norm requests zero update. No ratio clipping or RNG is used.
+    """
+    @staticmethod
+    def forward(ctx, context, mode):
+        ctx.mode = mode
+        ctx.input_dtype = context.dtype
+        ctx.set_materialize_grads(False)
+        return context.clone(), context.clone()
+
+    @staticmethod
+    def _row_norm(vector):
+        scale = vector.abs().amax(dim=-1, keepdim=True)
+        safe_scale = torch.where(scale > 0, scale, torch.ones_like(scale))
+        return scale * torch.sqrt((vector / safe_scale).square().sum(
+            dim=-1, keepdim=True))
+
+    @staticmethod
+    @torch.autograd.function.once_differentiable
+    def backward(ctx, residual_grad, product_grad):
+        if residual_grad is None and product_grad is None:
+            return None, None
+        if residual_grad is None:
+            residual_grad = torch.zeros_like(product_grad)
+        if product_grad is None:
+            product_grad = torch.zeros_like(residual_grad)
+        residual = residual_grad.float()
+        product = product_grad.float()
+        total = residual + product
+        total_norm = _BuyContextVJP._row_norm(total)
+        residual_norm = _BuyContextVJP._row_norm(residual)
+        product_norm = _BuyContextVJP._row_norm(product)
+        safe_residual = torch.where(residual_norm > 0, residual_norm,
+                                    torch.ones_like(residual_norm))
+        safe_product = torch.where(product_norm > 0, product_norm,
+                                   torch.ones_like(product_norm))
+        matched_residual = torch.where(
+            residual_norm > 0, (residual / safe_residual) * total_norm, total)
+        matched_product = torch.where(
+            product_norm > 0, (product / safe_product) * total_norm, total)
+        if ctx.mode == 'product_sum_norm':
+            result = matched_product
+        elif ctx.mode == 'residual_sum_norm':
+            result = matched_residual
+        elif ctx.mode == 'both':
+            result = total
+        elif ctx.mode == 'product_raw':
+            result = product
+        else:
+            raise ValueError('Unknown buy context VJP control')
+        return result.to(ctx.input_dtype), None
+
