+    def _feedback_detail_bank(self, values, mask, task_masks):
+        """One value-width centered feedback summary per prediction task.
+
+        Binary masks can overlap (multi-action history tokens). Each is
+        intersected with validity BEFORE centering or valid-rank rotation.
+        Coefficients have zero sum within each 10-event block and match the
+        whole-history local-position coefficient norm when nondegenerate.
+        Rotation preserves block counts and coefficient norms, not the
+        resulting value-summary norm. All four factorial banks execute in
+        every cell without new learned state, randomness or input access.
+        """
+        batch, length, width = values.shape
+        if length != 100 or len(task_masks) != self.num_tasks:
+            raise ValueError('Frozen history/task schema mismatch')
+        for task_mask in task_masks:
+            if task_mask.shape != mask.shape:
+                raise ValueError('Historical task mask shape mismatch')
+        valid = mask.bool().reshape(batch, 1, 10, 10)
+        typed = torch.stack([m > 0 for m in task_masks], dim=1)
+        typed = typed.reshape(batch, self.num_tasks, 10, 10) & valid
+        union = typed.any(dim=1, keepdim=True)
+        membership = torch.cat([typed, union], dim=1)
+        expanded_valid = valid.expand_as(membership)
+        rotated = self._rotate_valid_membership(membership, expanded_valid)
+        valid_float = valid.to(torch.float32)
+        counts = valid_float.sum(dim=-1, keepdim=True)
+        position = torch.arange(10, device=values.device,
+                                dtype=torch.float32).view(1, 1, 1, 10) / 9.0
+        position_mean = (position * valid_float).sum(
+            dim=-1, keepdim=True) / counts.clamp_min(1.0)
+        position_coefficients = valid_float * (position - position_mean)
+        target_norm2 = position_coefficients.square().sum(
+            dim=(-2, -1), keepdim=True)
+        aligned_coefficients = self._center_feedback_coefficients(
+            membership, valid_float, counts, target_norm2)
+        rotated_coefficients = self._center_feedback_coefficients(
+            rotated, valid_float, counts, target_norm2)
+        # An explicit mask makes finite padding-value perturbations inert.
+        safe_values = torch.where(mask.bool().unsqueeze(-1), values,
+                                  torch.zeros_like(values))
+        aligned_details = torch.bmm(aligned_coefficients.to(values.dtype).reshape(
+            batch, self.num_tasks + 1, length), safe_values)
+        rotated_details = torch.bmm(rotated_coefficients.to(values.dtype).reshape(
+            batch, self.num_tasks + 1, length), safe_values)
+        total = counts.sum(dim=-2).clamp_min(1.0).sqrt().to(aligned_details.dtype)
+        aligned_details = aligned_details / total
+        rotated_details = rotated_details / total
+        selected = (aligned_details if self.feedback_detail_alignment == 'aligned'
+                    else rotated_details)
+        if self.feedback_detail_scope == 'task':
+            return selected[:, :self.num_tasks, :]
+        return selected[:, self.num_tasks:, :].expand(-1, self.num_tasks, -1)
+
+    @staticmethod
+    def _center_feedback_coefficients(membership, valid, counts, target_norm2):
+        binary = membership.to(torch.float32)
+        fraction = binary.sum(dim=-1, keepdim=True) / counts.clamp_min(1.0)
+        centered = binary - valid * fraction
+        norm2 = centered.square().sum(dim=(-2, -1), keepdim=True)
+        scale = (target_norm2 / norm2.clamp_min(1e-12)).sqrt()
+        return centered * scale * (norm2 > 1e-10).to(centered.dtype)
 
