+    def _historical_action_values(self, item_emb, mask, task_masks):
+        """Replace only the historical action channel, before ANY summary.
+
+        Counts-only is a learned linear projection of the complete per-row
+        action histogram, divided by valid history length. The existing
+        length/count channels remain available. It contains no binding to
+        item identity, order, block, target match or feedback stratum.
+        Blind is the uniform mean over the existing nonpadding action
+        codebook, independent of the row's action tokens. It retains a
+        learned channel and every original table/module/parameter shape.
+        Optimizer exposure of codebook rows differs, an explicit confound.
+        """
+        history = item_emb[self.action_field][:, :-1]
+        valid = mask.bool().unsqueeze(-1)
+        if self.historical_action_mode == 'full':
+            return history
+        if self.historical_action_mode == 'counts_only':
+            active = torch.where(valid, history.float(), 0.0)
+            count = mask.bool().sum(dim=1, keepdim=True).clamp_min(1).unsqueeze(-1)
+            mean = (active.sum(dim=1, keepdim=True) / count).to(history.dtype)
+            replacement = mean.expand_as(history)
+        elif self.historical_action_mode == 'blind':
+            spec = self.feature_map.features[self.action_field]
+            codes = torch.arange(int(spec['vocab_size']), device=history.device)
+            keep = codes != 0
+            if spec.get('padding_idx') is not None:
+                keep = keep & (codes != int(spec['padding_idx']))
+            codes = codes[keep]
+            if codes.numel() == 0:
+                raise ValueError('Action codebook has no nonpadding rows')
+            codebook = self.embedding_layer({self.action_field: codes})[self.action_field]
+            mean = codebook.float().mean(dim=0).to(history.dtype).view(1, 1, -1)
+            replacement = mean.expand_as(history)
+        elif self.historical_action_mode == 'within_membership_cycle':
+            donors = _membership_donor_indices(mask, task_masks)
+            replacement = history.gather(1, donors.unsqueeze(-1).expand_as(history))
+        else:
+            raise ValueError('Unknown historical action intervention')
+        # Preserve the actual padding representation, and never use target action.
+        return torch.where(valid, replacement, history)
