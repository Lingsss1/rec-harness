+def _membership_donor_indices(mask, task_masks):
+    """Cycle valid positions within each row's EXACT four-mask stratum.
+
+    Membership codes are derived only from supplied historical masks. The
+    unique position suffix makes sorting deterministic without stable-sort
+    assumptions. No event, item, mask, padding or target tensor is changed.
+    A heterogeneous stratum is necessary for a nonidentity intervention.
+    """
+    if mask.ndim != 2 or len(task_masks) != 4:
+        raise ValueError('Expected history mask [B,L] and four task masks')
+    batch, length = mask.shape
+    if length != 100:
+        raise ValueError('Frozen history length must be 100')
+    valid = mask.bool()
+    membership = torch.zeros_like(mask, dtype=torch.long)
+    for index, task_mask in enumerate(task_masks):
+        if task_mask.shape != mask.shape:
+            raise ValueError('Historical membership mask shape mismatch')
+        membership = membership + (task_mask > 0).to(torch.long) * (1 << index)
+    membership = torch.where(valid, membership, 16)
+    positions = torch.arange(length, device=mask.device).view(1, length).expand(batch, -1)
+    order = torch.argsort(membership * length + positions, dim=1)
+    sorted_membership = membership.gather(1, order)
+    previous = torch.cat([sorted_membership[:, :1], sorted_membership[:, :-1]], dim=1)
+    starts = (positions == 0) | (sorted_membership != previous)
+    first = torch.where(starts, positions, 0).cummax(dim=1).values
+    following = (positions + 1).clamp_max(length - 1)
+    same_next = ((positions + 1 < length)
+                 & (sorted_membership == sorted_membership.gather(1, following)))
+    donor_sorted = torch.where(same_next, following, first)
+    donor_original = order.gather(1, donor_sorted)
+    donors = torch.zeros_like(order).scatter(1, order, donor_original)
+    return torch.where(valid, donors, positions)
+
