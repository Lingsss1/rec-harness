+    def _membership_action_means(self, history, mask, task_masks):
+        """Per-row, exact-mask-stratum mean; no cross-row/event-item lookup.
+
+        Anchor at the first valid event in each stratum, then average FP32
+        residuals. Constant strata have identically zero residuals, so their
+        replacement equals the original exactly (also after the dtype cast).
+        Anchor choice cancels algebraically; FP32 summation order can matter
+        in heterogeneous strata. All arms run this helper, with no RNG,
+        persistent state, CPU extraction or gradients into any other field.
+        Target action never enters. Invalid slots retain their original value.
+        """
+        batch, length, width = history.shape
+        valid = mask.bool()
+        codes = self._membership_codes(mask, task_masks)
+        positions = torch.arange(length, device=history.device).unsqueeze(0).expand(batch, -1)
+        positions = torch.where(valid, positions, length)
+        first = torch.full((batch, 16), length, device=history.device, dtype=torch.long)
+        first.scatter_reduce_(1, codes, positions, reduce='amin', include_self=True)
+        anchors = history.float().gather(
+            1, first.clamp_max(length - 1).unsqueeze(-1).expand(-1, -1, width))
+        event_index = codes.unsqueeze(-1).expand(-1, -1, width)
+        event_anchor = anchors.gather(1, event_index)
+        residual = torch.where(valid.unsqueeze(-1), history.float() - event_anchor, 0.0)
+        # Avoid floating atomic scatter reductions. This small stratum/event
+        # assignment costs B*16*L FP32 elements and executes in every cell.
+        strata = torch.arange(16, device=history.device).view(1, 16, 1)
+        assignment = ((strata == codes.unsqueeze(1)) & valid.unsqueeze(1)).float()
+        with torch.autocast(device_type=history.device.type, enabled=False):
+            sums = torch.bmm(assignment, residual)
+            counts = assignment.sum(dim=-1)
+            means = anchors + sums / counts.clamp_min(1.0).unsqueeze(-1)
+        replacement = means.gather(1, event_index).to(history.dtype)
+        return torch.where(valid.unsqueeze(-1), replacement, history)
+
+    def conditional_action_diagnostics(self, inputs):
+        """Optional training-only host preflight, not an automatic collector.
