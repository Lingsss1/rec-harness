+class Model(_CoupledModel):
+    def __init__(self, feature_map, model_id='Rank15CoordinateCompletion', gpu=-1,
+                 completion_trainable=False,
+                 id_embedding_dim=15, attribute_embedding_dim=15,
+                 action_embedding_dim=16, source_coupled_initialization=True,
+                 item_coordinate_mode='zero_lift16', **kwargs):
+        if not isinstance(completion_trainable, bool):
+            raise ValueError('Completion trainability must be boolean')
+        if (id_embedding_dim != 15 or attribute_embedding_dim != 15
+                or action_embedding_dim != 16
+                or source_coupled_initialization is not True
+                or item_coordinate_mode != 'zero_lift16'):
+            raise ValueError('Completion requires coupled uniform15 tables and width16 outputs')
+        super().__init__(
+            feature_map, model_id=model_id, gpu=gpu,
+            id_embedding_dim=id_embedding_dim,
+            attribute_embedding_dim=attribute_embedding_dim,
+            action_embedding_dim=action_embedding_dim,
+            source_coupled_initialization=source_coupled_initialization,
+            item_coordinate_mode=item_coordinate_mode, **kwargs)
+        # Add AFTER source copying: the reference has no completion state.
+        # new_zeros consumes no random draws; the inherited sampler RNG and
+        # all inherited parameter/buffer initialization remain unchanged.
+        # Keep this outside embedding_layer: it is a dense AdamW parameter.
+        # Preserve table aliases in the completion as well as the lookup.
+        owners = []
+        self.completion_indices = {}
+        for name in self.item_fields:
+            table = self.embedding_layer.embedding_layers[name]
+            index = next((i for i, owner in enumerate(owners) if table is owner), None)
+            if index is None:
+                index = len(owners)
+                owners.append(table)
+            self.completion_indices[name] = index
+        self.coordinate_completion = nn.Parameter(
+            self.local_activation[0].weight.new_zeros((len(owners), 15)),
+            requires_grad=completion_trainable)
+
+    def _lift_item(self, name, embedded):
+        # No bias: zero/padding vectors remain zero. Retain one tied map per
+        # field across all 101 positions. Auxiliary item detachment later in
+        # forward also blocks auxiliary gradients into these coefficients.
+        index = self.completion_indices[name]
+        missing = torch.matmul(
+            embedded[..., :15], self.coordinate_completion[index].unsqueeze(-1))
+        return torch.cat((embedded[..., :15], missing), dim=-1)
