+    def _embed_history_channel(self, item, mask):
+        """Erase token identity before lookup; never modify visibility masks.
+
+        Task-mask-derived feedback partitions remain present in every cell.
+        Thus zero/context_code remove token content conditional on those
+        partitions; neither is a complete feedback-information deletion.
+        The context control reuses action-table capacity for a fixed brand
+        code. Its table usage/frequency and optimization can still differ.
+        """
+        if self.action_channel == 'observed':
+            return self.embedding_layer(item)
+        coded_item = dict(item)
+        coded_item[self.action_field] = torch.zeros_like(item[self.action_field])
+        if self.action_channel == 'context_code':
+            brand = item['brand'][:, :-1]
+            valid = mask.bool() & (brand > 0)
+            for special in self.match_excluded_ids['brand']:
+                valid = valid & (brand != special)
+            codebook = torch.tensor(self.action_replacement_ids,
+                                    device=brand.device, dtype=torch.long)
+            codes = codebook[brand.remainder(len(self.action_replacement_ids))]
+            codes = torch.where(valid, codes, torch.zeros_like(codes))
+            # Target action remains the unknown zero in all interventions.
+            coded_item[self.action_field] = torch.cat(
+                [codes, torch.zeros_like(item[self.action_field][:, -1:])], dim=1)
+        embedded = self.embedding_layer(coded_item)
+        if self.action_channel == 'zero':
+            # Exact zero even if row zero has no declared padding semantics.
+            embedded[self.action_field] = torch.zeros_like(embedded[self.action_field])
+        else:
+            allowed = torch.cat([valid, torch.zeros_like(valid[:, -1:])], dim=1)
+            embedded[self.action_field] = (embedded[self.action_field]
+                                          * allowed.unsqueeze(-1).to(embedded[self.action_field].dtype))
+        return embedded
 
