+    def _match_action_content(self, item_summaries, actions):
+        """Duplicate existing item inputs in raw/scaled match action slots.
+
+        Each row's field embeddings already occur in the residual input.
+        Their fixed sum/sqrt(F) has the action embedding's width. The scale
+        is fixed by field count, never calibrated from observed actions.
+        It is a conditioning/active-input control, not a same-information-
+        rank or same-gradient control. Ordinal action rows remain untouched.
+        FP32 aggregation precedes conversion to the inherited summary dtype.
+        """
+        if self.match_action_content == 'observed':
+            return actions
+        batch, rows, action_width = actions.shape
+        fields = len(self.item_fields)
+        duplicate = item_summaries.reshape(batch, rows, fields, action_width)
+        duplicate = duplicate.float().sum(dim=2) / (fields ** 0.5)
+        selected = torch.tensor((True, False, False, False, True),
+                                device=actions.device, dtype=torch.bool).view(1, 5, 1)
+        return torch.where(selected, duplicate.to(actions.dtype), actions)
 
