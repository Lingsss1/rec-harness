+    def _history_stratified_summary_values(self, values, mask, membership):
+        """Average within each sample's visible click/nonclick history group.
+
+        Membership is derived from the supplied historical click mask; the
+        shifted control moves that membership by the inherited valid-rank
+        rotation within ten-event blocks before this operator. It preserves
+        per-block group counts. Neither cell changes the original task masks.
+        No input outside the same sample's valid history can contribute.
+
+        This is a nested coarsening of the blockwise group projection: it
+        preserves global group sums, removes between-block conditional-mean
+        variation, and is idempotent in exact arithmetic. It need not preserve
+        per-block sums, energy, per-event norms or target-match summary rank.
+        Only raw/scaled match-action rows use it; those local derivatives are
+        stopped by the unchanged downstream consumer. Every other item,
+        action, normalization and gradient-ownership path is inherited.
+        """
+        batch, length, width = values.shape
+        if length != 100 or mask.shape != values.shape[:2] or membership.shape != mask.shape:
+            raise ValueError('Expected frozen history and membership shapes')
+        valid = mask.bool()
+        member = membership.bool() & valid
+        groups = torch.stack((valid & ~member, member), dim=1)
+        action_width = width - self.key_width
+        original = values[:, :, self.key_width:]
+        with torch.autocast(device_type=values.device.type, enabled=False):
+            weights32 = groups.float()
