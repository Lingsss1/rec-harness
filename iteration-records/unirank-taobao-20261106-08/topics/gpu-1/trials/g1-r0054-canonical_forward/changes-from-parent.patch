+    def _history_layout(self, item, mask, task_masks):
+        """Reindex only valid events; preserve padding slots and current target.
+
+        Stable least-significant-key sorts implement an exact lexicographic
+        order on encoded event fields, historical action and task eligibility.
+        No original position is a key. Equal complete tuples are identical
+        for every downstream consumer, so stable ties leak no event order.
+        The validity pattern is retained, giving invariance to valid-event
+        permutations conditional on that pattern (the released pre-padding).
+        Sorting nominal IDs is a content grouping, not a semantic chronology.
+        """
+        batch, length = mask.shape
+        if len(task_masks) != self.num_tasks:
+            raise ValueError('Wrong number of historical task masks')
+        for eligibility in task_masks:
+            if eligibility.shape != mask.shape:
+                raise ValueError('Historical task mask shape mismatch')
+        for field in item.values():
+            if field.ndim != 2 or field.shape != (batch, length + 1):
+                raise ValueError('Expected event fields including unchanged target')
+        if self.history_order == 'supplied' and self.history_orientation == 'forward':
+            return item, task_masks
+        valid = mask.bool()
+        positions = torch.arange(length, device=mask.device, dtype=torch.long)
+        positions = positions.unsqueeze(0).expand(batch, -1)
+        index = positions
+        if self.history_order == 'canonical':
+            # All downstream item/action fields participate. Eligibility is
+            # part of the tuple and travels with its event for ALL tasks.
+            keys = [item[name][:, :-1]
+                    for name in self.item_fields + [self.action_field]]
+            keys.extend(eligibility for eligibility in task_masks)
+            for key in reversed(keys):
+                local_order = torch.argsort(key.gather(1, index), dim=1, stable=True)
+                index = index.gather(1, local_order)
+        # Pack valid sources first, preserving the chosen order among them.
+        # Invalid IDs cannot affect the relative order of valid sources.
+        partition = torch.argsort((~valid).long().gather(1, index),
+                                  dim=1, stable=True)
+        index = index.gather(1, partition)
+        valid_rank = (valid.long().cumsum(dim=1) - 1).clamp_min(0)
+        if self.history_orientation == 'reverse':
+            valid_rank = (valid.long().sum(dim=1, keepdim=True) - 1
+                          - valid_rank).clamp_min(0)
+        sources = index.gather(1, valid_rank)
+        # Invalid destinations keep their original fields/masks exactly.
+        sources = torch.where(valid, sources, positions)
+        reordered = {
+            name: torch.cat([field[:, :-1].gather(1, sources), field[:, -1:]], dim=1)
+            for name, field in item.items()
+        }
+        eligibility = [task_mask.gather(1, sources) for task_mask in task_masks]
+        return reordered, eligibility
 
