+    def _history_layout(self, item, mask, task_masks):
+        """Preserve source groups; content-sort members and/or full groups.
+
+        Exact lexicographic sorting produces dense ranks of COMPLETE tuples.
+        Equal tuples get equal ranks; original positions never break a rank
+        tie. Sorted rank vectors are collision-free keys for block multisets.
+        A block's original ordered content ranks are a secondary key for
+        identical multisets. Thus the blocks-only cell also has no positional
+        tie breaker. After member canonicalization these tied blocks become
+        identical, so that secondary key cannot leak member order downstream.
+        """
+        batch, length = mask.shape
+        if length != 100 or len(task_masks) != self.num_tasks:
+            raise ValueError('Frozen history and all task masks are required')
+        for eligibility in task_masks:
+            if eligibility.shape != mask.shape:
+                raise ValueError('Historical task mask shape mismatch')
+        for field in item.values():
+            if field.ndim != 2 or field.shape != (batch, length + 1):
+                raise ValueError('Expected event fields with unchanged target')
+        valid = mask.bool()
+        positions = torch.arange(length, device=mask.device, dtype=torch.long)
+        positions = positions.unsqueeze(0).expand(batch, -1)
+        raw_keys = [item[name][:, :-1]
+                    for name in self.item_fields + [self.action_field]]
+        raw_keys.extend(task_masks)
+        # Mask invalid keys before sorting. Invalid IDs/masks never become
+        # evidence, and remain unchanged at their original destinations.
+        keys = [torch.where(valid, key, torch.zeros_like(key))
+                for key in raw_keys]
+        order = positions
+        for key in reversed(keys):
+            sorting = torch.argsort(key.gather(1, order), dim=1, stable=True)
+            order = order.gather(1, sorting)
+        # Inverting a stable sort alone would retain original ranks for tied
+        # tuples. Collapse equality explicitly before scattering ranks back.
+        different = torch.zeros_like(valid)
+        for key in keys:
+            sorted_key = key.gather(1, order)
+            adjacent = sorted_key[:, 1:] != sorted_key[:, :-1]
+            different = different | torch.cat(
+                [torch.zeros_like(adjacent[:, :1]), adjacent], dim=1)
+        sorted_rank = different.long().cumsum(dim=1)
+        rank = torch.zeros_like(positions).scatter(1, order, sorted_rank)
+
+        groups, width = 10, 10
+        group_valid = valid.reshape(batch, groups, width)
+        group_rank = rank.reshape(batch, groups, width)
+        local = torch.arange(width, device=mask.device, dtype=torch.long)
+        local = local.view(1, 1, width).expand(batch, groups, -1)
+        members = torch.argsort(group_rank, dim=2, stable=True)
+        partition = torch.argsort(
+            (~group_valid).long().gather(2, members), dim=2, stable=True)
+        members = members.gather(2, partition)
+        destination_rank = (group_valid.long().cumsum(dim=2) - 1).clamp_min(0)
+        members = members.gather(2, destination_rank)
+        members = torch.where(group_valid, members, local)
+        offsets = torch.arange(groups, device=mask.device, dtype=torch.long)
+        offsets = offsets.view(1, groups, 1) * width
+        canonical_members = members + offsets
+        # Completely valid blocks have ten canonical member ranks. Partial
