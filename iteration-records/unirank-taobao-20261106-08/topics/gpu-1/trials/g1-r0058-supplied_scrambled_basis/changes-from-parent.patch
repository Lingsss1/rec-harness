+    def _coarse_basis_coefficients(self, original_linear, original_quadratic,
+                                   scrambled_rank, valid, total):
+        """Same capacity; new span versus an invertible coordinate control.
+
+        Center and orthogonalize under actual valid-event counts. Distinct
+        fixed scrambled ranks give nondegenerate linear/quadratic directions
+        whenever the inherited respective target norm is nonzero. No extra
+        support gate is introduced. Original fourth/fifth gates stay intact.
+        Rotation is constant and invertible on EVERY support, including rank
+        one: it preserves joint energy/span but may redistribute channel norm.
+        """
+        mean = (scrambled_rank * valid).sum(dim=(1, 2), keepdim=True) / total.unsqueeze(-1)
+        linear = valid * (scrambled_rank - mean)
+        linear_norm2 = linear.square().sum(dim=(1, 2), keepdim=True)
+        quadratic, quadratic_norm2 = self._orthogonal_block_residual(
+            (scrambled_rank - mean).square(), linear, linear_norm2, valid, total)
+        target_linear_norm2 = original_linear.square().sum(dim=(1, 2), keepdim=True)
+        target_quadratic_norm2 = original_quadratic.square().sum(dim=(1, 2), keepdim=True)
+        scrambled_linear = linear * (target_linear_norm2 / linear_norm2.clamp_min(1e-12)).sqrt()
+        scrambled_quadratic = quadratic * (target_quadratic_norm2 / quadratic_norm2.clamp_min(1e-12)).sqrt()
+        rotated_linear = (original_linear + original_quadratic) * (2.0 ** -0.5)
+        rotated_quadratic = (original_quadratic - original_linear) * (2.0 ** -0.5)
+        return scrambled_linear, scrambled_quadratic, rotated_linear, rotated_quadratic
 
