+    @staticmethod
+    def _rotate_coarse_pair(first, second):
+        # R=[[s,s],[-s,s]], s=1/sqrt(2). Explicit FP32 arithmetic
+        # then restoration of the original dtype; no detach or new state.
+        scale = 2.0 ** -0.5
+        rotated_first = (first.float() + second.float()) * scale
+        rotated_second = (second.float() - first.float()) * scale
+        return rotated_first.to(first.dtype), rotated_second.to(second.dtype)
+
+    def _transport_coarse_input_weights(self, input_width):
+        # signal=[match, local_position, coarse_linear, coarse_quadratic,
+        #         duplicate_match]. Both consumers contain all five channels.
+        # The residual prefix is [context,target,base,match_counts]; the
+        # history prefix is [base,match_counts]. Coarse columns begin after
+        # the first two signals. W_new=W_old R^T acts on columns, not rows.
+        width = self.value_width
+        residual_start = input_width + len(self.match_fields) + 2 * width
+        history_start = width + len(self.match_fields) + 2 * width
+        consumers = [(adapter[0], residual_start) for adapter in self.residual_bank]
+        consumers.extend((projection, history_start) for projection in self.history_projections)
+        with torch.no_grad():
