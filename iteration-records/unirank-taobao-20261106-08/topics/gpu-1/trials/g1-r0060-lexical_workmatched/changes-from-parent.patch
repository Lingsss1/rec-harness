+    def _content_hash(keys, seed):
+        """Fixed bounded integer mixing; not a cryptographic or random oracle.
+
+        Inputs are complete masked event tuples, with no original positions.
+        Every intermediate fits signed int64: max square < (2**31-1)**2.
+        Hash collisions are resolved by exact tuple order, never source rank.
+        """
+        modulus = 2147483647
+        mixed = torch.zeros_like(keys[0], dtype=torch.long) + seed
+        for index, key in enumerate(keys):
+            bounded = key.long().remainder(modulus)
+            mixed = (mixed * 48271 + bounded * 69621
+                     + 17 * (index + 1)).remainder(modulus)
+            mixed = mixed.square().remainder(modulus)
+        return mixed
+
+    def _history_layout(self, item, mask, task_masks):
+        """Canonicalize all valid events, retaining padding at its destinations.
+
+        Build lexical and two hash orders in EVERY cell before selecting one.
+        Exact complete-tuple tie breakers include action and all task masks.
+        Stable source ties occur only for indistinguishable complete tuples.
+        All event fields and eligibility masks follow one common permutation;
+        neither current target nor history validity is permuted or fabricated.
+        """
+        batch, length = mask.shape
+        if length != 100 or len(task_masks) != self.num_tasks:
+            raise ValueError('Frozen history and all four task masks required')
+        for eligibility in task_masks:
+            if eligibility.shape != mask.shape:
+                raise ValueError('Historical task mask shape mismatch')
+        for field in item.values():
+            if field.ndim != 2 or field.shape != (batch, length + 1):
+                raise ValueError('Expected event fields with unchanged target')
+        names = self.item_fields + [self.action_field]
+        if set(item) != set(names):
+            raise ValueError('Every supplied event field must enter the tuple key')
+        valid = mask.bool()
+        positions = torch.arange(length, device=mask.device, dtype=torch.long)
+        positions = positions.unsqueeze(0).expand(batch, -1)
+        raw_keys = [item[name][:, :-1] for name in names] + list(task_masks)
+        keys = [torch.where(valid, key, torch.zeros_like(key)) for key in raw_keys]
+        lexical = positions
+        for key in reversed(keys):
