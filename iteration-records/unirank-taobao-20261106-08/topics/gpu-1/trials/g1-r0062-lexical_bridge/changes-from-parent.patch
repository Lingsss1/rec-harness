+    @staticmethod
+    def _cyclic_sources(ranks, packed, count, positions):
+        """Exact minimum circular rotation, forward and over both directions.
+
+        Prefix doubling ranks all 2L oriented rotations together. Seven rounds
+        compare 128 symbols, sufficient for any cycle of at most 100 events.
+        Equal final ranks imply identical complete tuple sequences, including
+        periodic ties. Original rank breaks only these indistinguishable ties.
+        Integer pair codes stay below (2L+1)**2; no probabilistic hash is used.
+        Empty rows use a harmless length-one denominator and are masked later.
+        """
+        length = positions.shape[1]
+        safe_count = count.clamp_min(1)
+        active = positions < count
+        reverse_index = (count - 1 - positions).clamp_min(0)
+        reverse_ranks = ranks.gather(1, reverse_index)
+        combined = torch.cat([ranks, reverse_ranks], dim=1)
+        both_active = torch.cat([active, active], dim=1)
+        pair_base = 2 * length + 1
+        combined = torch.where(both_active, combined,
+                               torch.full_like(combined, pair_base))
+        for step in (1, 2, 4, 8, 16, 32, 64):
+            following = (positions + step).remainder(safe_count)
+            successors = torch.cat([following, following + length], dim=1)
+            pair = combined * pair_base + combined.gather(1, successors)
+            pair = torch.where(both_active, pair,
+                               torch.full_like(pair, pair_base * pair_base))
+            ordering = torch.argsort(pair, dim=1, stable=True)
+            sorted_pairs = pair.gather(1, ordering)
+            changes = torch.cat([
+                torch.ones_like(sorted_pairs[:, :1]),
+                (sorted_pairs[:, 1:] != sorted_pairs[:, :-1]).long()], dim=1)
+            sorted_ranks = changes.cumsum(dim=1) - 1
+            combined = torch.zeros_like(sorted_ranks).scatter(1, ordering, sorted_ranks)
+            combined = torch.where(both_active, combined,
+                                   torch.full_like(combined, pair_base))
+        forward_start = combined[:, :length].argmin(dim=1, keepdim=True)
+        both_start = combined.argmin(dim=1, keepdim=True)
+        forward_offsets = (positions + forward_start).remainder(safe_count)
+        both_offsets = (positions + both_start.remainder(length)).remainder(safe_count)
+        both_offsets = torch.where(both_start < length, both_offsets,
+                                   count - 1 - both_offsets).clamp_min(0)
+        return packed.gather(1, forward_offsets), packed.gather(1, both_offsets)
