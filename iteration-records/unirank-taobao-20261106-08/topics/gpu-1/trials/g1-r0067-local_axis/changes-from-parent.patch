+    @staticmethod
+    def _canonical_moment(moment):
+        """[B,D] -> representative of {m,-m}, with no added learned state.
+
+        FP32 detached pivot selection uses the first maximum-absolute
+        coordinate. Ties therefore resolve identically for m and -m; zero
+        uses positive orientation and remains zero. Multiply the WHOLE
+        vector, preserving norm, relative coordinate signs and outer product.
+        This is not coordinatewise abs. The local Jacobian away from pivot
+        boundaries is orientation * identity; the discrete choice has no
+        gradient. Learned embeddings can cross those boundaries, which is
+        an optimization confound to measure rather than hide.
+        """
+        if moment.ndim != 2 or moment.shape[1] < 1:
+            raise ValueError('Expected a nonempty-width moment matrix [B,D]')
+        detached = moment.detach().float()
+        index = detached.abs().argmax(dim=-1, keepdim=True)
+        pivot = detached.gather(-1, index)
+        orientation = torch.where(pivot < 0, -torch.ones_like(pivot),
+                                  torch.ones_like(pivot)).to(moment.dtype)
+        return moment * orientation
 
