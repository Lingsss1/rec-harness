+    @staticmethod
+    def _target_coarse_chart(moment, target, pivot_sign):
+        """Orient toward the supplied current item, with a fixed tie fallback.
+
+        Only matching item-field coordinates enter the FP32 inner product;
+        the historical action coordinates have no current-action anchor.
+        The detached sign multiplies the WHOLE original moment. At relative
+        dot margins <=1e-6 use the existing deterministic pivot convention.
+        Conditional on target, c(-m)=c(m) and s*c=m, including orthogonal,
+        all-zero and action-only cases. The discrete sign has no derivative
+        into either item source; all inherited auxiliary gates still apply.
+        No raw IDs, new event information or learned parameters are added.
+        """
+        if (moment.ndim != 2 or target.ndim != 2
+                or moment.shape[0] != target.shape[0]
+                or target.shape[1] < 1 or target.shape[1] > moment.shape[1]
+                or pivot_sign.shape != moment[:, :1].shape):
+            raise ValueError('Invalid moment, target or fallback shapes')
+        item_moment = moment.detach().float()[:, :target.shape[1]]
+        anchor = target.detach().float()
+        dot = (item_moment * anchor).sum(dim=-1, keepdim=True)
+        scale = (item_moment.square().sum(dim=-1, keepdim=True).sqrt()
+                 * anchor.square().sum(dim=-1, keepdim=True).sqrt())
+        target_sign = torch.where(dot < 0, -torch.ones_like(dot),
+                                  torch.ones_like(dot))
+        orientation = torch.where(dot.abs() > 1e-6 * scale,
+                                  target_sign, pivot_sign.float()).to(moment.dtype)
         return moment * orientation, orientation
 
