+    @staticmethod
+    def _coarse_axis(moment):
+        """Canonicalize only global sign, with the inherited pivot convention.
+
+        The lowest-index maximal absolute FP32 coordinate sets a detached
+        sign. Zero uses +1; gradients are the selected sign times identity
+        away from pivot boundaries. No supplied event or mask is changed.
+        This quotients one learned vector, not the whole history order.
+        """
+        if moment.ndim != 2 or moment.shape[1] < 1:
+            raise ValueError('Expected a nonempty-width moment matrix [B,D]')
+        detached = moment.detach().float()
+        index = detached.abs().argmax(dim=-1, keepdim=True)
+        pivot = detached.gather(-1, index)
+        orientation = torch.where(pivot < 0, -torch.ones_like(pivot),
+                                  torch.ones_like(pivot)).to(moment.dtype)
+        return moment * orientation
+
+    def _consumer_signals(self, detail, position, coarse, curvature, joint):
+        """Work-matched forward construction; select each consumer separately.
+
+        This is called AFTER original per-task source-gradient gating.
+        Only the third of five summary vectors can differ. Native signed
+        inputs are used directly, avoiding a learned sign-bit decoder.
+        No module, buffer, RNG or cross-task mutable state is introduced.
+        """
+        axis = self._coarse_axis(coarse)
+        signed_signal = torch.cat([detail, position, coarse, curvature, joint], dim=-1)
+        axis_signal = torch.cat([detail, position, axis, curvature, joint], dim=-1)
+        adapter_signal = signed_signal if self.adapter_coarse_signed else axis_signal
+        interaction_signal = signed_signal if self.interaction_coarse_signed else axis_signal
+        return adapter_signal, interaction_signal
