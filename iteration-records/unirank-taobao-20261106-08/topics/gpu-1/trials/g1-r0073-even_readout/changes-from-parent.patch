+    def _primary_adapter_correction(self, index, features):
+        """Average the two signs BEFORE the downstream tower and its Dice.
+
+        The last five value-width slices are match, local, coarse, quadratic,
+        and joint summaries. Only coarse is reflected. Shared prefix and all
+        sibling summaries are unchanged. The inherited adapter consists only
+        of Linear/ReLU/Linear, so these calls have no running-state effect.
+        FP32 averaging reduces cancellation error under host BF16 autocast.
+        Explicit zero terms retain all evaluations in every backward graph.
+        """
+        width = self.value_width
+        coarse_start = features.shape[1] - 3 * width
+        coarse_end = coarse_start + width
+        coarse = features[:, coarse_start:coarse_end]
+        reflected = torch.cat([features[:, :coarse_start], -coarse,
+                               features[:, coarse_end:]], dim=-1)
+        canonical = torch.cat([features[:, :coarse_start], self._coarse_axis(coarse),
+                               features[:, coarse_end:]], dim=-1)
+        positive = self.residual_bank[index](features)
+        negative = self.residual_bank[index](reflected)
+        axis = self.residual_bank[index](canonical)
+        even = ((positive.float() + negative.float()) * 0.5).to(positive.dtype)
+        if self.primary_adapter_readout == 'even':
+            return even + 0.0 * positive + 0.0 * negative + 0.0 * axis
+        if self.primary_adapter_readout == 'signed':
+            return positive + 0.0 * even + 0.0 * negative + 0.0 * axis
+        return axis + 0.0 * even + 0.0 * positive + 0.0 * negative
