+    def training_loss(self, inputs, probabilities, train_labels):
+        """Unweighted four-task BCE, replacing only the click objective.
+
+        Every cell computes the same two loss candidates. Reflection/per_view
+        selects mean BCE(p+, y), BCE(p-, y); all others select BCE(mean p, y).
+        The duplicate objectives deliberately share exactly one expression,
+        avoiding a false null contrast caused by different reduction graphs.
+        No label is used by forward or retained after this hook. Labels follow
+        feature_map.labels, with no assumption that click is the first column.
+        """
+        if not self.training:
+            raise ValueError('training_loss is available only in training mode')
+        views = self._click_objective_views
+        self._click_objective_views = None
+        if views is None:
+            raise ValueError('training_loss requires one fresh forward per batch')
+        if (probabilities.ndim != 2 or probabilities.shape[1] != self.num_tasks
+                or train_labels.shape != probabilities.shape):
+            raise ValueError('Expected aligned probabilities and labels [B,4]')
+        first, second = views
+        if (first.shape != (probabilities.shape[0], 1)
+                or second.shape != first.shape
+                or first.device != probabilities.device
+                or second.device != probabilities.device):
+            raise ValueError('Cached click views do not match the current batch')
+        labels = train_labels.to(device=probabilities.device, dtype=torch.float32)
+        click = list(self.feature_map.labels).index('is_click')
+        click_labels = labels[:, click:click + 1]
+        # Probabilities are already FP32 in the inherited view readout.
+        # BCE runs in FP32, outside the host's autocast context if necessary:
+        # binary_cross_entropy is disallowed inside CUDA autocast by PyTorch.
+        with torch.autocast(device_type=probabilities.device.type, enabled=False):
+            task_losses = nn.functional.binary_cross_entropy(
+                probabilities.float(), labels, reduction='none').mean(dim=0)
+            first_loss = nn.functional.binary_cross_entropy(
+                first.float(), click_labels, reduction='mean')
+            second_loss = nn.functional.binary_cross_entropy(
+                second.float(), click_labels, reduction='mean')
+            per_view = (first_loss + second_loss) * 0.5
+            selected = list(task_losses.unbind())
+            if (self.coarse_view_treatment == 'reflect'
+                    and self.click_view_objective == 'per_view'):
+                selected[click] = per_view
+            # Both candidate loss graphs remain present in all cells.
+            # For duplicate treatment both objectives select identical code.
+            return (torch.stack(selected).sum() + 0.0 * per_view
+                    + 0.0 * task_losses.sum())
