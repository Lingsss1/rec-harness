+    @staticmethod
+    def _balance_feedback_weights(counts):
+        """Equal mass per occupied feedback stratum, after native means.
+
+        For each real temporal block, retain the uniform and target-match
+        support counts. Feedback counts become n/k on each originally
+        nonempty feedback row, where n is valid-event count and k is the
+        number of occupied feedback rows (0, 1 or 2). Thus feedback mass
+        sums to n and no empty stratum becomes occupied. This changes
+        readout weighting, never the events used to compute any mean or
+        the rows entering Dice. No parameters, state or RNG are added.
+        """
+        occupied = (counts[:, 1:3] > 0).to(counts.dtype)
+        strata = occupied.sum(dim=-1, keepdim=True)
+        balanced = occupied * (counts[:, :1] / strata.clamp_min(1))
+        return torch.cat((counts[:, :1], balanced, counts[:, 3:]), dim=-1)
