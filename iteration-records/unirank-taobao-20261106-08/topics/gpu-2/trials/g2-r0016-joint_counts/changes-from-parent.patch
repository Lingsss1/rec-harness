+    def _membership_shift(self, valid):
+        """A bijection of valid positions within each of two absolute ages.
+
+        Move ALL four task memberships together by one valid-event rank.
+        Preserve task overlaps and per-age marginals, including with holes.
+        Empty and singleton groups are identity maps; padded positions fixed.
+        This is a deterministic placebo, not an exchangeable random null.
+        """
+        positions = torch.arange(100, device=valid.device)[None, :].expand_as(valid)
+        permutation = positions
+        for age in self.match_age:
+            member = valid & age[None, :]
+            count = member.long().sum(dim=1, keepdim=True)
+            rank = member.long().cumsum(dim=1) - 1
+            ordered = torch.where(member, positions,
+                                  torch.full_like(positions, 100)).sort(dim=1).values
+            source_rank = (rank + 1).remainder(count.clamp_min(1))
+            selected = ordered.gather(1, source_rank).clamp(max=99)
+            permutation = torch.where(member, selected, permutation)
+        return permutation
+
+    def _match_statistics(self, item, mask, task_masks):
+        # Equal encoded IDs are observable inputs. Zero IDs never count as
+        # matches. Positive OOV/missing codes may still alias: no claim that
+        # these indicators establish semantic identity or conversion credit.
+        valid = mask.bool()
+        matches = []
+        for name in self.match_fields:
+            ids = item[name]
+            if ids.ndim != 2 or ids.shape != (mask.shape[0], 101):
+                raise ValueError('Expected frozen [B,101] item fields')
+            target_id = ids[:, -1:]
+            matches.append((ids[:, :-1] == target_id)
+                           & (ids[:, :-1] > 0) & (target_id > 0) & valid)
+        # Include the category AND brand conjunction, not just its marginals.
+        matches.append(matches[1] & matches[4])
+        match = torch.stack(matches, dim=1)  # [B,7,100], canonical field order
+        members = []
+        for index in self.match_task_indices:
+            if task_masks[index].shape != mask.shape:
+                raise ValueError('Historical task mask shape mismatch')
+            members.append((task_masks[index] > 0) & valid)
+        member = torch.stack(members, dim=1)  # [B,4,100], overlaps permitted
+        permutation = self._membership_shift(valid)
+        shifted = member.gather(2, permutation[:, None, :].expand(-1, 4, -1))
+        age = self.match_age[None, :, :] & valid[:, None, :]
+        aligned_age = age[:, :, None, :] & member[:, None, :, :]
+        shifted_age = age[:, :, None, :] & shifted[:, None, :, :]
+        # FP32 is deliberate for exact counts and the fractional independence
+        # replacement. It changes no learned scorer or host training recipe.
+        with torch.autocast(device_type=mask.device.type, enabled=False):
+            population = age.float().sum(dim=-1)  # [B,2]
+            task_count = aligned_age.float().sum(dim=-1)  # [B,2,4]
+            match_count = torch.bmm(age.float(), match.float().transpose(1, 2))
+            aligned_joint = torch.bmm(
+                aligned_age.reshape(-1, 8, 100).float(),
+                match.float().transpose(1, 2)).reshape(-1, 2, 4, 7)
+            shifted_joint = torch.bmm(
+                shifted_age.reshape(-1, 8, 100).float(),
+                match.float().transpose(1, 2)).reshape(-1, 2, 4, 7)
+            independent = (task_count[:, :, :, None] * match_count[:, :, None, :]
+                           / population.clamp_min(1)[:, :, None, None])
+            if self.match_view == 'joint':
+                joint = aligned_joint
+            elif self.match_view == 'marginal':
+                joint = independent
+            else:
+                joint = shifted_joint
+            # Same 24 common marginals plus 56 replaced joint coordinates.
+            # Fixed-window counts /100 are not temporal rates or new labels.
+            return torch.cat((population.flatten(1), task_count.flatten(1),
+                              match_count.flatten(1), joint.flatten(1)), dim=1) / 100.0
 
