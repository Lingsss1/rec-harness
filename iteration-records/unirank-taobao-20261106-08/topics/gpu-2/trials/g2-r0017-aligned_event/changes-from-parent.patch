+        ], dim=-1)
+        correction = self.moment_correction(inputs.reshape(batch * slots, -1))
+        # No new BatchNorm/Dice population; inactive rows cannot change a weight.
+        return correction * (counts > 0).reshape(-1, 1).to(correction.dtype)
