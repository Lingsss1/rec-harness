+            reversed_mean = reversed_weight.sum(dim=-1, keepdim=True) / n
+            # Computing both cross-moments in every mode matches forward work;
+            # selected and unused backward paths intentionally differ.
+            paired = torch.bmm(paired_weight, clean) / n - paired_mean * mean_value
+            reversed_cov = (torch.bmm(reversed_weight, clean) / n
+                            - reversed_mean * mean_value)
