+    def _transport_values(self, target, raw_values, mask, auxiliary, values):
+        """Bounded value tilt; original scorer/identity values stay unchanged.
+
+        No [B,slot,event,value] tensor is materialized. Score reversal is a
+        deterministic within-slot bijection including arbitrary mask holes.
+        Sort/gather indices have no trainable state and consume no RNG.
+        FP32 statistics are local architecture operations; host precision,
+        optimizers, loss and input visibility remain unchanged.
+        """
+        batch, length, _ = raw_values.shape
+        valid = mask.bool()
+        valid_blocks = self.partition[None, :, :] & valid[:, None, :]
+        member = auxiliary[:, None, :] & valid_blocks
+        assignment = torch.stack((valid_blocks, valid_blocks & ~member, member), dim=2)
+        assignment = assignment.reshape(batch, 30, length)
+        # All cells build the same reversal map, preserving slot membership.
+        positions = torch.arange(length, device=raw_values.device).view(1, 1, length)
+        ordered = torch.where(assignment, positions, torch.full_like(positions, length))
+        ordered = ordered.sort(dim=-1).values
+        rank = assignment.long().cumsum(dim=-1) - 1
+        count_int = assignment.long().sum(dim=-1, keepdim=True)
+        reverse_rank = (count_int - 1 - rank).clamp(min=0, max=length - 1)
+        reverse_positions = ordered.gather(2, reverse_rank).clamp(max=length - 1)
+        fields = len(self.item_fields)
+        with torch.autocast(device_type=raw_values.device.type, enabled=False):
+            clean = torch.where(valid[:, :, None], raw_values.float(),
+                                torch.zeros_like(raw_values, dtype=torch.float32))
+            keys = clean[:, :, :self.key_width].reshape(
+                batch, length, fields, self.moment_embedding_dim)
+            keys = torch.nn.functional.normalize(keys, p=2, dim=-1, eps=1e-8)
+            query = target.float().reshape(batch, fields, self.moment_embedding_dim)
+            query = torch.nn.functional.normalize(query, p=2, dim=-1, eps=1e-8)
+            rotated = torch.roll(query, shifts=1, dims=-1)
+            query = rotated if self.transport_mode == 'rotated' else query
+            # Action values are transported but never used as a target query.
+            score = (keys * query[:, None, :, :]).sum(dim=-1).mean(dim=-1)
+            score = score.clamp(min=-1.0, max=1.0)
+            score = torch.where(valid, score, torch.zeros_like(score))
+            slot_score = score[:, None, :].expand(-1, 30, -1)
+            reversed_score = slot_score.gather(2, reverse_positions)
+            a = assignment.float()
