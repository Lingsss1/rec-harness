+class _AuxiliaryFirstProjection(nn.Module):
+    """Task history affine plus an explicitly supplied common projection.
+
+    A shared weight has exactly one owner on Model, so device transfers and
+    optimizers cannot accidentally turn three aliases into distinct weights.
+    This cell owns independent Parameters copied from each task's native map.
+    """
+
+    def __init__(self, original, prefix_width, initial_common, independent):
+        super().__init__()
+        self.prefix_width = prefix_width
+        if independent:
+            self.context_weight = nn.Parameter(initial_common.detach().clone())
+        else:
+            self.register_parameter('context_weight', None)
+        self.history_weight = nn.Parameter(
+            original.weight[:, prefix_width:].detach().clone())
+        # This Parameter is removed from its old owner when that affine is
+        # replaced; neither the obsolete weight nor an unused copy survives.
+        self.bias = original.bias
+
+    def forward(self, features, common_projection=None):
+        if common_projection is None:
+            if self.context_weight is None:
+                raise ValueError('Tied auxiliary projection must be supplied')
+            common_projection = torch.nn.functional.linear(
+                features[:, :self.prefix_width], self.context_weight)
+        history_projection = torch.nn.functional.linear(
+            features[:, self.prefix_width:], self.history_weight, self.bias)
+        return common_projection + history_projection
 
 
