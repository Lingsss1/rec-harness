+    def _evaluation_batched_towers(self, task_features):
+        """Batch dispatch only; every task retains its own learned function.
+
+        Affine batching uses [tasks,batch,width] with one independent weight
+        matrix per task. Dice batching concatenates CHANNELS, not examples:
+        each channel keeps its own original running mean, variance and alpha.
+        Frozen BatchNorm is pointwise; no moments are estimated or updated.
+        All stacks/concatenations are ephemeral and rebuilt from live tensors.
+        No Parameter, buffer, initialization, detach, or persistent cache is added.
+        """
+        if self.training:
+            raise ValueError('Task-tower batching is evaluation-only')
+        hidden = task_features
+        for depth in range(len(self.towers[0])):
+            layers = [tower[depth] for tower in self.towers]
+            if isinstance(layers[0], nn.Linear):
+                if self.evaluation_tower_batching in ('affine', 'both'):
+                    # baddbmm preserves separate biases without a separate
+                    # low-precision output-plus-bias rounding site. The GEMM
+                    # dispatch still differs from four independent Linear calls.
+                    weights = torch.stack([layer.weight for layer in layers])
+                    biases = torch.stack([layer.bias for layer in layers])
+                    packed = torch.baddbmm(
+                        biases[:, None, :], torch.stack(hidden),
+                        weights.transpose(1, 2))
+                    hidden = list(packed.unbind(dim=0))
+                else:
+                    hidden = [layer(value) for layer, value in zip(layers, hidden)]
+            elif isinstance(layers[0], Dice):
+                if self.evaluation_tower_batching in ('dice', 'both'):
+                    for layer in layers:
+                        if (layer.training or layer.bn.training or layer.bn.affine
+                                or layer.bn.running_mean is None
+                                or layer.bn.running_var is None
+                                or layer.bn.eps != layers[0].bn.eps):
+                            raise ValueError('Expected frozen, independent upstream Dice gates')
+                    packed = torch.cat(hidden, dim=-1)
+                    running_mean = torch.cat([layer.bn.running_mean for layer in layers])
+                    running_var = torch.cat([layer.bn.running_var for layer in layers])
+                    normalized = torch.nn.functional.batch_norm(
+                        packed, running_mean, running_var, weight=None, bias=None,
+                        training=False, momentum=0.0, eps=layers[0].bn.eps)
+                    probability = torch.sigmoid(normalized)
+                    alpha = torch.cat([layer.alpha for layer in layers])
+                    packed = packed * torch.addcmul(alpha, probability, 1 - alpha)
+                    hidden = list(packed.split(layers[0].alpha.numel(), dim=-1))
+                else:
+                    hidden = [self._evaluation_dice(layer, value)
+                              for layer, value in zip(layers, hidden)]
+            else:
+                raise ValueError('Expected inherited Linear/Dice task towers')
+        return {label + '_pred': torch.sigmoid(logits)
+                for label, logits in zip(self.feature_map.labels, hidden)}
+
