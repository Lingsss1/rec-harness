+    def _select_owner_first_channels(tower, selection):
+        """Materialize one fixed 96-of-112 subnetwork before optimization.
+
+        Select matching first-affine rows, Dice state and second-affine
+        columns. All original template initialization has already executed;
+        other modules and the external RNG are untouched. No trained weight,
+        validation statistic or label selects these indices. No rescaling.
+        The ordinary reduction helper runs next. Indexing occurs only here,
+        with no masks, gather, padding or full-width storage left in forward.
+        """
+        if selection == 'suffix':
+            channels = list(range(16, 112))
+        elif selection == 'spread':
+            # Drop 6,13,...,111: sixteen uniformly spaced indices.
+            channels = [index for index in range(112) if index % 7 != 6]
+        else:
+            raise ValueError('The prefix control uses the unchanged reducer')
+        if len(channels) != 96 or len(set(channels)) != 96:
+            raise ValueError('Expected 96 distinct retained channels')
+        first, dice, second = tower[0], tower[1], tower[2]
+        if (not isinstance(first, nn.Linear) or not isinstance(dice, Dice)
+                or not isinstance(second, nn.Linear)
+                or first.out_features != 128 or second.in_features != 128):
+            raise ValueError('Channel selection requires the unmodified 128-channel template')
+        indices = torch.tensor(channels, dtype=torch.long, device=first.weight.device)
+        with torch.no_grad():
+            first.weight = nn.Parameter(
+                first.weight.index_select(0, indices).detach().clone(),
+                requires_grad=first.weight.requires_grad)
+            first.bias = nn.Parameter(
+                first.bias.index_select(0, indices).detach().clone(),
+                requires_grad=first.bias.requires_grad)
+            dice.alpha = nn.Parameter(
+                dice.alpha.index_select(0, indices).detach().clone(),
+                requires_grad=dice.alpha.requires_grad)
+            dice.bn.running_mean = dice.bn.running_mean.index_select(0, indices).detach().clone()
+            dice.bn.running_var = dice.bn.running_var.index_select(0, indices).detach().clone()
+            second.weight = nn.Parameter(
+                second.weight.index_select(1, indices).detach().clone(),
+                requires_grad=second.weight.requires_grad)
+            first.out_features = 96
+            dice.bn.num_features = 96
+            second.in_features = 96
 
