+class _CompactItemEmbedding(nn.Module):
+    """A smaller ID table lifted into the unchanged sixteen-wide interface.
+
+    Install only after all inherited resets, random draws and reductions.
+    The compact table contains selected columns of the fresh untrained table;
+    the lift initially injects these columns into their original coordinates.
+    Both fixed and learned lifts execute the same linear operator. No source
+    table, checkpoint, vocabulary remapping, persistent cache or RNG is used.
+    The table remains an nn.Embedding child for the host Adagrad split; only
+    the learned lift belongs to the host dense AdamW/gradient clipping group.
+    """
+    def __init__(self, source, rank, coordinates, lift):
+        super().__init__()
+        if type(source) is not nn.Embedding:
+            raise ValueError('ID intervention requires an ordinary embedding table')
+        if isinstance(rank, bool) or not isinstance(rank, int):
+            raise ValueError('ID rank must be an integer')
+        if source.embedding_dim != 16 or rank != 12:
+            raise ValueError('This study fixes the outer width16 and ID rank12')
+        if coordinates not in ('prefix', 'spread') or lift not in ('fixed', 'learned'):
+            raise ValueError('Unknown ID coordinate or lift control')
+        if source.max_norm is not None:
+            raise ValueError('State-mutating max_norm embeddings are unsupported')
+        if (source.embedding_dim - rank) * source.num_embeddings <= source.embedding_dim * rank:
+            raise ValueError('The learned lift must still reduce actual Parameter storage')
+        self.num_embeddings = source.num_embeddings
+        self.embedding_dim = source.embedding_dim
+        self.rank = rank
+        selected = (list(range(rank)) if coordinates == 'prefix'
+                    else [index * source.embedding_dim // rank for index in range(rank)])
+        if len(set(selected)) != rank:
+            raise ValueError('Retained embedding coordinates must be distinct')
+        columns = torch.tensor(selected, dtype=torch.long, device=source.weight.device)
+        with torch.no_grad():
+            compact = source.weight.detach().index_select(1, columns).clone()
+            # Supplying _weight bypasses random initialization. Do not reset
+            # this module afterward; the full fresh parent table is discarded.
+            self.table = nn.Embedding(
