+                max_norm=None, norm_type=source.norm_type,
+                scale_grad_by_freq=source.scale_grad_by_freq, sparse=source.sparse,
+                _weight=compact)
+            self.table.weight.requires_grad_(source.weight.requires_grad)
+            projection = source.weight.new_zeros((source.embedding_dim, rank))
+            projection[columns, torch.arange(rank, device=columns.device)] = 1
+            if lift == 'learned':
+                self.projection = nn.Parameter(projection)
+            else:
+                self.register_buffer('projection', projection)
+
