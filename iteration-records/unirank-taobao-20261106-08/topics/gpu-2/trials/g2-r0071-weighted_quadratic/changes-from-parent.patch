+    @staticmethod
+    def _weighted_orthogonal_block_residual(raw, linear, linear_norm2, counts, total):
+        """Evaluation-only coarse residual on [B,10,1] with event-count weights.
+
+        All operands are FP32 coefficient tensors. Preserve clamp thresholds,
+        the two centerings and the projection sequence of the event version.
+        Return the compact residual and its event-weighted squared norm.
+        This does not assert identical floating-point residuals or support.
+        """
+        present = (counts > 0).to(counts.dtype)
+        denominator = total.unsqueeze(-1)
+        mean = (raw * counts).sum(dim=(1, 2), keepdim=True) / denominator
+        residual = present * (raw - mean)
+        slope = ((residual * linear * counts).sum(dim=(1, 2), keepdim=True)
+                 / linear_norm2.clamp_min(1e-12))
+        residual = present * (residual - slope * linear)
+        residual_mean = ((residual * counts).sum(dim=(1, 2), keepdim=True)
+                         / denominator)
+        residual = present * (residual - residual_mean)
+        norm2 = (residual.square() * counts).sum(dim=(1, 2), keepdim=True)
+        return residual, norm2
+
+    @staticmethod
+    def _weighted_coarse_residual(raw, linear, quadratic, counts, total):
+        """Same two ordered projection sweeps over ten weighted block values.
+
+        Zero-count blocks contribute neither means nor inner products. Both
+        residuals, their norms, and every inherited gate are still evaluated.
+        No state, learned weight, cache, input or random draw is added.
+        """
+        present = (counts > 0).to(counts.dtype)
+        denominator = total.unsqueeze(-1)
+        residual = present * raw
+        linear_norm2 = (linear.square() * counts).sum(dim=(1, 2), keepdim=True)
+        quadratic_norm2 = (quadratic.square() * counts).sum(dim=(1, 2), keepdim=True)
+        for _ in range(2):
+            mean = (residual * counts).sum(dim=(1, 2), keepdim=True) / denominator
+            residual = present * (residual - mean)
+            slope = ((residual * linear * counts).sum(dim=(1, 2), keepdim=True)
+                     / linear_norm2.clamp_min(1e-12))
+            residual = present * (residual - slope * linear)
+            slope = ((residual * quadratic * counts).sum(dim=(1, 2), keepdim=True)
+                     / quadratic_norm2.clamp_min(1e-12))
+            residual = present * (residual - slope * quadratic)
+        mean = (residual * counts).sum(dim=(1, 2), keepdim=True) / denominator
+        residual = present * (residual - mean)
+        norm2 = (residual.square() * counts).sum(dim=(1, 2), keepdim=True)
+        return residual, norm2
 
