+class _WeightCoordinateAffine(nn.Module):
+    """Keep orthogonal trainable coordinates; transform the small weight.
+
+    Inputs use [q,k,q*k,action]. The stored weight and its optimizer state
+    retain the inherited orthogonal coordinates. The transformation remains
+    inside forward so auxiliary functional_call detaches every scorer path.
+    No derived weights persist, and no fresh parameters or RNG draws occur.
+    FP32 algebra and input/weight derivatives match the explicit coordinates;
+    different BF16 rounding can change the subsequent training trajectory.
+    """
+    def __init__(self, source, key_width):
+        super().__init__()
+        if not isinstance(source, nn.Linear):
+            raise ValueError('Expected the reduced native scorer affine')
+        if source.in_features <= 3 * key_width or source.bias is None:
+            raise ValueError('Expected q,k,product and historical action')
+        self.in_features = source.in_features
+        self.out_features = source.out_features
+        self.key_width = key_width
+        # Preserve Parameter identity, names, dtype and requires_grad. The
+        # caller removes the old affine; no redundant weight is registered.
+        self.weight = source.weight
+        self.bias = source.bias
+
+    def forward(self, features):
+        dimension = self.key_width
+        shared = self.weight[:, :dimension] / (2.0 ** 0.5)
+        difference = self.weight[:, dimension:2 * dimension] * ((3.0 / 2.0) ** 0.5)
+        effective = torch.cat((shared + difference, shared - difference,
+                               self.weight[:, 2 * dimension:]), dim=-1)
+        return torch.nn.functional.linear(features, effective, self.bias)
+
