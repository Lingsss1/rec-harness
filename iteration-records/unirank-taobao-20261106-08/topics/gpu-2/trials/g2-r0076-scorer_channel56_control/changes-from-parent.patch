+class _ScorerFactorAffine(nn.Module):
+    """Balanced factors of the fresh orthogonal scorer weight.
+
+    Rank64 controls the new factorized optimization and two-GEMM execution.
+    Rank48 keeps every nonlinear output but restricts the shared linear map.
+    SVD is CPU FP32 construction work only. No checkpoint, observations,
+    full-sized weight backing storage, derived cache or new RNG is retained.
+    """
+    def __init__(self, source, rank):
+        super().__init__()
+        if not isinstance(source, _WeightCoordinateAffine):
+            raise ValueError('Expected the inherited orthogonal scorer')
+        if isinstance(rank, bool) or not isinstance(rank, int):
+            raise ValueError('Scorer rank must be an integer')
+        if not 1 <= rank <= min(source.out_features, source.in_features):
+            raise ValueError('Scorer rank exceeds the affine dimensions')
+        if source.out_features != 64 or source.bias is None:
+            raise ValueError('Factor contrast retains all64 scorer outputs')
+        self.in_features = source.in_features
+        self.out_features = source.out_features
+        self.key_width = source.key_width
+        self.rank = rank
+        with torch.no_grad():
+            left, singular, right = torch.linalg.svd(
+                source.weight.detach().to(device='cpu', dtype=torch.float32),
+                full_matrices=False)
+            left, singular, right = left[:, :rank], singular[:rank], right[:rank, :]
+            pivots = left.abs().argmax(dim=0, keepdim=True)
+            signs = left.gather(0, pivots).squeeze(0).sign()
+            signs = torch.where(signs == 0, torch.ones_like(signs), signs)
+            root = singular.sqrt()
+            output_factor = (left * signs.unsqueeze(0)) * root.unsqueeze(0)
+            input_factor = root.unsqueeze(1) * (right * signs.unsqueeze(1))
+            self.input_factor = nn.Parameter(
+                input_factor.to(device=source.weight.device,
+                                dtype=source.weight.dtype).clone(),
+                requires_grad=source.weight.requires_grad)
+            self.output_factor = nn.Parameter(
+                output_factor.to(device=source.weight.device,
+                                 dtype=source.weight.dtype).clone(),
+                requires_grad=source.weight.requires_grad)
+        # Reuse the bias Parameter; the replaced module has no remaining owner.
+        self.bias = source.bias
+
+    def forward(self, features):
+        # Transform only the small input factor. Trainable coordinates remain
+        # orthogonal; no activation or bias occurs between the two factors.
+        # Both factors stay inside functional_call for auxiliary detachment.
+        dimension = self.key_width
+        shared = self.input_factor[:, :dimension] / (2.0 ** 0.5)
+        difference = self.input_factor[:, dimension:2 * dimension] * ((3.0 / 2.0) ** 0.5)
+        effective = torch.cat((shared + difference, shared - difference,
+                               self.input_factor[:, 2 * dimension:]), dim=-1)
+        hidden = torch.nn.functional.linear(features, effective)
+        return torch.nn.functional.linear(hidden, self.output_factor, self.bias)
+
