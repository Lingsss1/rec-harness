+    def _action_inputs(self, item, mask):
+        """Treat only valid historical codes; retain padding and target bytes.
+
+        A fixed half-length rotation is a bijection of each row's valid
+        ranks, including noncontiguous masks. It preserves the row's action
+        multiset but changes action/item/position/task-mask alignment. No
+        action moves between examples. Empty and singleton rows are identities.
+        The constant-token arm retains a learned action channel at the same
+        width and all allocated parameters, but removes variation of codes
+        beyond the unchanged supplied masks. Effective embedding-row usage
+        necessarily differs and must be reported with measured host costs.
+        """
+        if HISTORICAL_ACTION_TREATMENT == 'permute_eval' and self.training:
+            # Exactly the incumbent tensor path and RNG during training.
+            return item
+        action = item[self.action_field]
+        if (action.ndim != 2 or action.shape[1] != mask.shape[1] + 1
+                or action.shape[0] != mask.shape[0]):
+            raise ValueError('Expected aligned action codes [B,101]')
+        history = action[:, :-1]
+        valid = mask.bool()
+        if HISTORICAL_ACTION_TREATMENT == 'blind_constant':
+            # Use an existing nonspecial token as a learned shared constant.
+            # Selection uses schema metadata, never the observed action codes.
+            spec = self.feature_map.features[self.action_field]
+            excluded = {0}
+            for name in ('padding_idx', 'oov_idx'):
+                if spec.get(name) is not None:
+                    excluded.add(int(spec[name]))
+            constant_id = next((index for index in range(1, int(spec['vocab_size']))
+                                if index not in excluded), None)
+            if constant_id is None:
+                raise ValueError('Action-blind control needs a nonspecial vocabulary row')
+            treated = torch.full_like(history, constant_id)
+        elif HISTORICAL_ACTION_TREATMENT in ('permute_both', 'permute_eval'):
+            ranks = (valid.long().cumsum(dim=-1) - 1).clamp_min(0)
+            counts = valid.long().sum(dim=-1, keepdim=True)
+            # Invalid entries add zero even when their packed indices collide.
+            packed = torch.zeros_like(history).scatter_add(
+                -1, ranks, torch.where(valid, history, torch.zeros_like(history)))
+            source = (ranks + counts // 2).remainder(counts.clamp_min(1))
+            treated = packed.gather(-1, source)
+        else:
+            raise ValueError('Unknown historical action treatment')
