+    def _action_inputs(self, item, mask, task_masks, auxiliary):
+        """Rotate codes within row-local groups without modifying host inputs.
+
+        The ordering key (group * length + position) is unique per row,
+        so sorting needs no tie rule. Invalid events occupy a final bucket
+        and never contribute counts. Scatter computes each original slot's
+        packed rank; group counts and exclusive starts locate a half-group
+        cyclic source. This is a bijection within each valid group, even
+        for noncontiguous masks. Singleton and code-constant groups are
+        identities. Codes never move between rows, groups or into padding.
+        Every treatment computes all four mask bits and uses the same
+        gather/scatter path. No parameters, buffers, RNG or labels enter.
+        """
+        action = item[self.action_field]
+        if (action.ndim != 2 or action.shape[1] != mask.shape[1] + 1
+                or action.shape[0] != mask.shape[0]):
+            raise ValueError('Expected aligned action codes [B,101]')
+        if len(task_masks) != 4 or any(m.shape != mask.shape for m in task_masks):
+            raise ValueError('Expected four aligned historical task masks')
+        history = action[:, :-1]
+        valid = mask.bool()
+        signature = torch.zeros_like(history)
+        for index, task_mask in enumerate(task_masks):
+            signature = signature + (task_mask > 0).long() * (1 << index)
+        if ACTION_PERMUTATION_GROUPS == 'all_valid':
+            groups = torch.zeros_like(signature)
+        elif ACTION_PERMUTATION_GROUPS == 'auxiliary_union':
+            groups = auxiliary.long()
+        elif ACTION_PERMUTATION_GROUPS == 'task_signature':
+            groups = signature
+        else:
+            raise ValueError('Unknown action permutation groups')
+        length = history.shape[1]
+        positions = torch.arange(length, device=history.device, dtype=torch.long)
+        positions = positions.unsqueeze(0).expand_as(history)
+        bucket = torch.where(valid, groups, torch.full_like(groups, 16))
+        order = (bucket * length + positions).argsort(dim=-1)
+        packed_rank = torch.zeros_like(history).scatter(-1, order, positions)
+        counts = history.new_zeros((history.shape[0], 17)).scatter_add(
+            -1, bucket, valid.long())
+        starts = counts.cumsum(dim=-1) - counts
+        own_count = counts.gather(-1, bucket)
+        own_start = starts.gather(-1, bucket)
+        source = own_start + (
+            packed_rank - own_start + own_count // 2
+        ).remainder(own_count.clamp_min(1))
+        treated = history.gather(-1, order).gather(-1, source)
+        result = dict(item)
+        result[self.action_field] = torch.cat(
+            [torch.where(valid, treated, history), action[:, -1:]], dim=1)
+        return result
+
