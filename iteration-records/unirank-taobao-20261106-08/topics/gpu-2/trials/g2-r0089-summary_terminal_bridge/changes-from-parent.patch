+def _terminal_resolution_orders(mask, generator=None):
+    """All factorial cells, with identical work and RNG at fixed input shape.
+
+    Destination-to-source convention: local.gather(1, block) first chooses
+    the donor block, then its source event. Older and terminal block maps
+    have disjoint support. Terminal local maps permute valid offsets only
+    inside the selected full blocks. No event crosses the two-block region.
+    """
+    batch = mask.shape[0]
+    positions = torch.arange(100, device=mask.device).expand(batch, -1)
+    within, block_orders = _summary_group_orders(mask, generator)
+    full = mask.bool().reshape(batch, 10, 10).all(dim=2)
+    anchors = _summary_anchor_sets(full)['newest_two']
+    terminal = anchors.unsqueeze(-1).expand(-1, -1, 10).reshape(batch, 100)
+    terminal_within = torch.where(terminal, within, positions)
+    older = block_orders['newest_two']
+    paired = older.gather(1, block_orders['terminal_pair'])
+    return {
+        (False, False): older,
+        (True, False): paired,
+        (False, True): terminal_within.gather(1, older),
+        (True, True): terminal_within.gather(1, paired),
+    }
+
+
+def check_terminal_resolution_contract(device='cpu'):
+    """Host-only prerequisite, with structural and deliberate-movement gates.
+
+    Run on CPU and the host GPU before training. No dataset, scoring, model
+    construction, file access or persistent RNG/state. This is not invoked
+    automatically by forward. Full-model parity/backward gates and actual
+    population movement remain separate prerequisites in proposal.json.
+    """
+    device = torch.device(device)
+    lengths = (0, 1, 2, 9, 10, 17, 19, 20, 21, 30, 40, 64, 99, 100)
+    batch = len(lengths) + 2
+    mask = torch.zeros((batch, 100), device=device)
+    for row, count in enumerate(lengths):
+        mask[row, 100-count:] = 1
+    for block in (0, 2, 5, 9):
+        mask[-2, 10*block:10*block+10] = 1
+    for lo, hi in ((10,20),(40,50),(80,90),(23,27),(95,99)):
+        mask[-1, lo:hi] = 1
+    valid = mask.bool()
+    positions = torch.arange(100, device=device).expand(batch, -1)
+    full = valid.reshape(batch, 10, 10).all(dim=2)
+    anchors = _summary_anchor_sets(full)['newest_two']
+    terminal = anchors.unsqueeze(-1).expand(-1,-1,10).reshape(batch,100)
+    # Explicit oracles independent of vectorized rank construction.
+    assert anchors[-2].nonzero().flatten().tolist() == [5,9]
+    assert anchors[-1].nonzero().flatten().tolist() == [4,8]
+    before_cpu = torch.random.get_rng_state().clone()
+    before_gpu = torch.cuda.get_rng_state(device).clone() if device.type == 'cuda' else None
+    rng = torch.Generator(device=device).manual_seed(862104)
+    orders = _terminal_resolution_orders(mask, rng)
+    assert torch.equal(before_cpu, torch.random.get_rng_state())
+    if before_gpu is not None:
+        assert torch.equal(before_gpu, torch.cuda.get_rng_state(device))
+    reference_rng = torch.Generator(device=device).manual_seed(862104)
+    inherited_within, inherited_blocks = _summary_group_orders(mask, reference_rng)
+    assert torch.equal(rng.get_state(), reference_rng.get_state())
+    assert torch.equal(orders[(False,False)], inherited_blocks['newest_two'])
+    budget_rng = torch.Generator(device=device).manual_seed(862104)
+    torch.rand((batch,10,10),dtype=torch.float64,device=device,generator=budget_rng)
+    torch.rand((batch,10),dtype=torch.float64,device=device,generator=budget_rng)
+    assert torch.equal(rng.get_state(), budget_rng.get_state())
+    again = _terminal_resolution_orders(mask, torch.Generator(device=device).manual_seed(862104))
+    assert all(torch.equal(order,again[cell]) for cell,order in orders.items())
+    fields = ('item_id','cate_id','campaign_id','customer_id','brand','price_bucket','action')
+    token = positions + 1
+    item = {name: torch.cat((token*(k+2)+k,
+                            torch.full((batch,1),2000+k,device=device)),dim=1)
+            for k,name in enumerate(fields)}
+    item['action'][:,-1] = 0
+    original_item = {name:value.clone() for name,value in item.items()}
+    memberships = [((token%(k+2))==0).float()*mask for k in range(4)]
+    original_memberships = [m.clone() for m in memberships]
+    values = torch.stack([item[name][:,:-1].float() for name in fields],dim=-1)
+    values.requires_grad_()
+    moved_fractions = {}
+    for (pair,local),order in orders.items():
+        assert torch.equal(order.sort(dim=1).values,positions)
+        assert torch.equal(order[~valid],positions[~valid])
+        assert torch.equal(mask.gather(1,order),mask)
+        assert torch.equal(terminal.gather(1,order),terminal)
+        # Older-block intervention is bit-identical across all four cells.
+        assert torch.equal(order[~terminal],orders[(False,False)][~terminal])
+        if not pair:
+            assert torch.equal((order//10)[terminal],(positions//10)[terminal])
+        if not local:
+            assert torch.equal(order%10,positions%10)
+        # Even the joint cell preserves each original ten-event block as a
+        # set. It removes these two rank scales, not all terminal information.
+        donor_blocks = (order//10).reshape(batch,10,10)
+        assert bool((donor_blocks == donor_blocks[:,:,:1]).all())
+        if pair:
+            assert torch.equal(order[full.sum(dim=1)<2]//10,
+                               orders[(False,local)][full.sum(dim=1)<2]//10)
+        gathered = _gather_history_item(item,order)
+        transported = _gather_history_values(values,order)
+        for k,name in enumerate(fields):
+            assert torch.equal(gathered[name][:,-1],item[name][:,-1])
+            assert torch.equal(gathered[name][:,:-1][~valid],item[name][:,:-1][~valid])
+            assert torch.equal(transported[:,:,k],gathered[name][:,:-1].float())
+        for membership in memberships:
+            moved = membership.gather(1,order)
+            assert torch.equal(moved.sum(dim=1),membership.sum(dim=1))
+            assert torch.equal(torch.zeros_like(moved).scatter(1,order,moved),membership)
+        union = memberships[0].bool() | memberships[1].bool()
+        moved_union = union.gather(1,order)
+        assert torch.equal(torch.zeros_like(union).scatter(1,order,moved_union),union)
+        weights = torch.arange(transported.numel(),device=device,dtype=values.dtype).reshape_as(values)
+        gradient, = torch.autograd.grad((transported*weights).sum(),values)
+        expected = torch.zeros_like(values).scatter(1,order.unsqueeze(-1).expand_as(values),weights)
+        assert torch.equal(gradient,expected)
+        moved_fractions[str((pair,local))] = float(((order!=positions)&terminal).sum()/terminal.sum().clamp_min(1))
+    for name in fields:
+        assert torch.equal(item[name],original_item[name])
+    for membership,original in zip(memberships,original_memberships):
+        assert torch.equal(membership,original)
+    # A single random realization can be identity for a pair. Across fixed
+    # synthetic seeds, require both swap and identity; never force a swap in
+    # training, which would retain order via an invertible relabeling.
+    seen_swap, seen_identity, seen_local = False,False,False
+    for seed in range(16):
+        fixture = _terminal_resolution_orders(mask,torch.Generator(device=device).manual_seed(seed))
+        base = fixture[(False,False)]
+        pair = fixture[(True,False)]
+        selected = terminal[-2]
+        seen_swap = seen_swap or bool((pair[-2,selected]!=base[-2,selected]).any())
+        seen_identity = seen_identity or bool(torch.equal(pair[-2,selected],base[-2,selected]))
+        seen_local = seen_local or bool((fixture[(False,True)][-2,selected]!=base[-2,selected]).any())
+    assert seen_swap and seen_identity and seen_local
+    return {'contract':'passed','fixture_terminal_moved_fractions':moved_fractions,
+            'pair_swap_and_identity_seen':True,
+            'population_treatment_strength':'not measured; host required'}
