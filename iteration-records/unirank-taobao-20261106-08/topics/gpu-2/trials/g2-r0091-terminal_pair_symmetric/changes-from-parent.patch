+def _terminal_pair_exchange(mask):
+    """Deterministic involution of the two greatest-index full blocks.
+
+    It is identity below two full blocks and at every nonselected position.
+    This map generates the TWO-element orbit; it is never used alone as a
+    supposed order-removal treatment. No timestamp or random draw enters.
+    """
+    if mask.ndim != 2 or mask.shape[1] != 100:
+        raise ValueError('Expected frozen mask[B,100]')
+    batch = mask.shape[0]
+    full = mask.bool().reshape(batch, 10, 10).all(dim=2)
+    block = torch.arange(10, device=mask.device).view(1, 10).expand(batch, -1)
+    latest = block.masked_fill(~full, -1).amax(dim=1, keepdim=True)
+    previous = block.masked_fill(~full | (block == latest), -1).amax(dim=1, keepdim=True)
+    selected = full & ((block == latest) | (block == previous)) & (previous >= 0)
+    donor = torch.where(selected, latest + previous - block, block)
+    local = torch.arange(10, device=mask.device).view(1, 1, 10)
+    return (10 * donor.unsqueeze(-1) + local).reshape(batch, 100)
+
+
+def _combine_terminal_pair_summaries(first, second, mode):
+    """Equal learned capacity, equal blend graph; no average of predictions.
+
+    Accumulate low-precision summaries in FP32 and cast once. Equal halves
+    make exchanging the two views commutative, including in the forward
+    floating-point addition. FP64 fixtures retain FP64 for gradient checks.
+    The supplied arm uses (1,0) and preserves a finite first view exactly.
+    Both paths retain autograd; neither modifies inputs or running state.
+    """
+    if mode not in ('symmetric', 'supplied') or len(first) != 5 or len(second) != 5:
+        raise ValueError('Expected five summaries and a registered blend mode')
+    weight = 0.5 if mode == 'symmetric' else 1.0
+    outputs = []
+    for left, right in zip(first, second):
+        if left.shape != right.shape or left.dtype != right.dtype:
+            raise ValueError('Pair summary shape/dtype mismatch')
+        dtype = torch.float64 if left.dtype == torch.float64 else torch.float32
+        outputs.append((weight * left.to(dtype) + (1.0 - weight) * right.to(dtype)).to(left.dtype))
+    return tuple(outputs)
+
+
+def check_terminal_pair_orbit_contract(device='cpu'):
+    """Host-only tensor gate; no training, data access, scoring or file I/O.
+
+    Exercise every suffix history length plus irregular full-block layouts,
+    distinct event fields/actions/task memberships, and both blend gradients.
+    Actual model-summary invariance and population strength are separate gates.
+    """
+    device = torch.device(device)
+    mask = torch.zeros((104, 100), device=device)
+    for row in range(101):
+        if row:
+            mask[row, 100-row:] = 1
+    for block in (0, 2, 5, 9):
+        mask[101, 10*block:10*block+10] = 1
+    for block in (1, 4, 8):
+        mask[102, 10*block:10*block+10] = 1
+    mask[102, 23:27] = 1
+    mask[103, ::3] = 1
+    original_mask = mask.clone()
+    positions = torch.arange(100, device=device).expand(mask.shape[0], -1)
+    cpu_before = torch.random.get_rng_state().clone()
+    gpu_before = torch.cuda.get_rng_state(device).clone() if device.type == 'cuda' else None
+    order = _terminal_pair_exchange(mask)
+    assert torch.equal(torch.random.get_rng_state(), cpu_before)
+    if gpu_before is not None:
+        assert torch.equal(torch.cuda.get_rng_state(device), gpu_before)
+    assert torch.equal(mask, original_mask)
+    assert torch.equal(order.sort(dim=1).values, positions)
+    assert torch.equal(order.gather(1, order), positions)
+    assert torch.equal(mask.gather(1, order), mask)
+    assert torch.equal(order[~mask.bool()], positions[~mask.bool()])
+    assert torch.equal(order % 10, positions % 10)
+    # A Python oracle is independent of the vectorized top-two construction.
+    for row in range(mask.shape[0]):
+        full = [b for b in range(10) if bool(mask[row, b*10:b*10+10].bool().all())]
+        expected = list(range(100))
+        if len(full) >= 2:
+            lo, hi = full[-2:]
+            for offset in range(10):
+                expected[10*lo+offset] = 10*hi+offset
+                expected[10*hi+offset] = 10*lo+offset
+        assert order[row].tolist() == expected
+    # Effective exchange is deliberate whenever two full blocks exist.
+    assert int((order[100] != positions[100]).sum()) == 20
+    assert int((order[101] != positions[101]).sum()) == 20
+    fields = ('item_id','cate_id','campaign_id','customer_id','brand','price_bucket','action')
+    item = {name: torch.cat(((positions+1)*(k+2)+k,
+            torch.full((mask.shape[0],1), 2000+k, device=device)),dim=1)
+            for k,name in enumerate(fields)}
+    item['action'][:,-1] = 0
+    transformed = _gather_history_item(item,order)
+    restored = _gather_history_item(transformed,order)
+    for name in fields:
+        assert torch.equal(restored[name],item[name])
+        assert torch.equal(transformed[name][:,-1],item[name][:,-1])
+    for k in range(4):
+        memberships = ((positions % (k+2)) == 0).float() * mask
+        moved = memberships.gather(1,order)
+        assert torch.equal(moved.gather(1,order),memberships)
+        assert torch.equal(moved.sum(dim=1),memberships.sum(dim=1))
+    for mode, weight in (('symmetric',0.5),('supplied',1.0)):
+        left = torch.arange(15,device=device,dtype=torch.float64).reshape(3,5).requires_grad_()
+        right = (23.0-left.detach()).requires_grad_()
+        result = _combine_terminal_pair_summaries((left,)*5,(right,)*5,mode)
+        assert torch.equal(result[0], weight*left+(1-weight)*right)
+        if mode == 'symmetric':
+            reverse = _combine_terminal_pair_summaries((right,)*5,(left,)*5,mode)
+            assert torch.equal(result[0],reverse[0])
+        gradient = torch.autograd.grad(sum(x.sum() for x in result),(left,right))
+        assert torch.equal(gradient[0],torch.full_like(left,5*weight))
+        assert torch.equal(gradient[1],torch.full_like(right,5*(1-weight)))
+    return {'pair_exchange':'passed','blend_gradient':'passed',
+            'full_model_parity':'host prerequisite, not measured',
+            'population_strength':'host prerequisite, not measured'}
