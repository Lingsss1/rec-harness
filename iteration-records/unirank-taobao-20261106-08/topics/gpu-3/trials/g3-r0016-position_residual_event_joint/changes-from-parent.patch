+    def _transfer_position_route(self, private_logits, mask):
+        """Use click as an auxiliary prior; private auxiliary rows keep learning.
+
+        Invoked inside the inherited FP32 gate context. Shapes are [B,L,T]
+        and [B,L]. Compute both donors in every factorial cell. A mean donor
+        is a signed masked mean, not coefficient-mass or variance matching.
+        'none' is an executable identity bridge to the prior task/joint
+        reference for host checks, and is not a fifth proposed trial.
+        """
+        valid = mask.bool().unsqueeze(-1)
+        private_logits = private_logits.masked_fill(~valid, 0)
+        click = (private_logits * self._primary_channel).sum(dim=-1, keepdim=True)
+        count = valid.float().sum(dim=1, keepdim=True).clamp_min(1.0)
+        mean_click = click.sum(dim=1, keepdim=True) / count
+        mean_click = mean_click.expand_as(click).masked_fill(~valid, 0)
+        if self.position_aux_donor == 'none':
+            return private_logits
+        donor = click if self.position_aux_donor == 'event' else mean_click
+        if self.position_donor_gradient == 'primary':
+            # Block only auxiliary-to-click positional feedback. The residual
+            # itself is never detached, and its corresponding task still learns.
+            donor = donor.detach()
+        auxiliary = private_logits + donor
+        result = torch.where(self._primary_channel, private_logits, auxiliary)
+        return result.masked_fill(~valid, 0)
 
