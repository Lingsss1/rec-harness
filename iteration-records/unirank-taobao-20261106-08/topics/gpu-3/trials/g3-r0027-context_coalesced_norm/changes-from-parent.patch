+    @staticmethod
+    def _project_auxiliary(primary, auxiliary, dimensions):
+        """One-sided Euclidean projection; both inputs are detached FP32 VJPs."""
+        dot = (primary * auxiliary).sum(dim=dimensions, keepdim=True)
+        primary_mass = primary.square().sum(dim=dimensions, keepdim=True)
+        safe_mass = torch.where(primary_mass > 0, primary_mass,
+                                torch.ones_like(primary_mass))
+        coefficient = dot.clamp_max(0.0) / safe_mass
+        return auxiliary - coefficient * primary
+
+    def _coalesced_corrections(self, primary, auxiliary, context_ids):
+        """Compute per-table geometry using only IDs present in this batch.
+
+        P[v] = sum_i p[i] and A[v] = sum_i a[i] for matching categorical
+        codes. Missing/OOV codes are ordinary learned rows unless explicitly
+        declared padding. Fixed padding rows never enter table statistics.
+        Coefficients are detached. Applying -c*p[i] at occurrences sums to
+        exactly -c*P[v]; no dense vocabulary-sized gradient is materialized.
+        """
+        projected_corrections, norm_corrections = [], []
+        for field, padding_idx in enumerate(self.context_padding):
+            ids = context_ids[:, field]
+            active = torch.ones_like(ids, dtype=torch.bool)
+            if padding_idx is not None:
+                active = ids.ne(padding_idx)
+            p = primary[:, field].masked_fill(~active.unsqueeze(-1), 0)
+            a = auxiliary[:, field].masked_fill(~active.unsqueeze(-1), 0)
+            unique_ids, inverse = torch.unique(ids, sorted=True, return_inverse=True)
+            shape = (unique_ids.shape[0], primary.shape[-1])
+            p_table = p.new_zeros(shape).index_add(0, inverse, p)
+            a_table = a.new_zeros(shape).index_add(0, inverse, a)
+            dot = (p_table * a_table).sum()
+            primary_mass = p_table.square().sum()
+            safe_mass = torch.where(primary_mass > 0, primary_mass,
+                                    torch.ones_like(primary_mass))
+            coefficient = dot.clamp_max(0.0) / safe_mass
+            projected_table = a_table - coefficient * p_table
+            original_norm = a_table.square().sum().sqrt()
+            projected_norm = projected_table.square().sum().sqrt()
+            safe_norm = torch.where(original_norm > 0, original_norm,
+                                    torch.ones_like(original_norm))
+            scale = (projected_norm / safe_norm).clamp(0.0, 1.0)
+            projected_corrections.append(-coefficient * p)
+            norm_corrections.append((scale - 1.0) * a)
+        return (torch.stack(projected_corrections, dim=1),
+                torch.stack(norm_corrections, dim=1))
+
+    def training_loss(self, inputs, probabilities, train_labels):
+        """Four BCE values; replace only aggregate auxiliary context gradients.
+
+        Two retained-graph VJPs and all coalescing/control calculations execute
+        in every variant, with no forward replay, optimizer access or .grad
+        mutation. Other parameters retain the joint-BCE derivative before host
+        dense clipping. There is no guarantee after adaptive Adagrad scaling,
+        across steps, on individual auxiliary tasks, or on validation AUC.
+        """
+        context = self._context_gradient_input
+        context_ids = self._context_gradient_ids
+        self._context_gradient_input = None
+        self._context_gradient_ids = None
+        if (not self.training or not torch.is_grad_enabled()
+                or context is None or context_ids is None):
+            raise RuntimeError('training_loss requires one matching training forward')
+        if (probabilities.ndim != 2 or probabilities.shape != train_labels.shape
+                or probabilities.shape[1] != len(self.towers)):
+            raise ValueError('Expected aligned [B,4] probabilities and labels')
+        if (context.ndim != 2 or context.shape[0] != probabilities.shape[0]
+                or context.shape[1] != self.context_field_count * self.context_field_width
+                or context_ids.shape != (context.shape[0], self.context_field_count)
+                or not context.requires_grad):
+            raise RuntimeError('Differentiable equal-width context fields are required')
+        with torch.autocast(device_type=probabilities.device.type, enabled=False):
+            # Identical to the r0026 suite; retain a numerical bridge control
+            # rather than assume equality with the original host BCE path.
+            prediction = probabilities.float().clamp(1e-7, 1.0 - 1e-7)
+            losses = torch.nn.functional.binary_cross_entropy(
+                prediction, train_labels.detach().float(), reduction='none')
+            task_losses = losses.mean(dim=0)
+            primary_loss = task_losses[self.primary_task_index]
+            auxiliary_loss = task_losses[self.context_aux_indices].sum()
+            objective = task_losses.sum()
+            primary_vjp, = torch.autograd.grad(
+                primary_loss, context, retain_graph=True,
+                create_graph=False, allow_unused=False)
+            auxiliary_vjp, = torch.autograd.grad(
+                auxiliary_loss, context, retain_graph=True,
+                create_graph=False, allow_unused=False)
+            shape = (context.shape[0], self.context_field_count,
+                     self.context_field_width)
+            primary = primary_vjp.detach().float().reshape(shape)
+            auxiliary = auxiliary_vjp.detach().float().reshape(shape)
