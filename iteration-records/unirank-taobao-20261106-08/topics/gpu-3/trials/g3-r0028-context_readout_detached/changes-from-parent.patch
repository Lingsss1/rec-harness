+    def _context_event_exchange(self, context, channels, matches, mask):
+        """Return identical event logits and their masked mean in every cell.
+
+        All normalization is within an example, without learned affine terms.
+        Task rows follow FeatureMap label order. Detachment on auxiliary rows
+        blocks only the NEW path into shared context; the task projection and
+        the inherited context-to-tower path still train. No cache or VJP probe.
+        Raw event logits are bounded by sqrt(gate_width); empty/masked events
+        contribute exactly zero, including to the readout alternative.
+        """
+        if context.ndim != 2 or context.shape[-1] != self.context_exchange_width:
+            raise ValueError('Context exchange width differs from inherited tower width')
+        with torch.autocast(device_type=mask.device.type, enabled=False):
+            valid = mask.bool().unsqueeze(-1)
+            features = (channels.unsqueeze(-1) * matches.unsqueeze(-2)).flatten(2)
+            features = features.float().masked_fill(~valid, 0)
+            normalized = torch.nn.functional.layer_norm(
+                context.float(), (self.context_exchange_width,), eps=1e-5)
+            event_logits = []
+            for index, label in enumerate(self.feature_map.labels):
+                task_context = normalized
+                if label != 'is_click' and self.context_exchange_aux_gradient == 'detached':
+                    task_context = task_context.detach()
+                query = torch.tanh(torch.nn.functional.linear(
+                    task_context, self.context_exchange_weight[index])
+                    / math.sqrt(self.context_exchange_width))
+                event_logits.append((features * query[:, None, :]).sum(dim=-1)
+                                    / math.sqrt(self.gate_width))
+            event_logits = torch.stack(event_logits, dim=-1).masked_fill(~valid, 0)
+            count = valid.float().sum(dim=1).clamp_min(1.0)
+            mean_logits = event_logits.sum(dim=1) / count
+            return event_logits, mean_logits
+
