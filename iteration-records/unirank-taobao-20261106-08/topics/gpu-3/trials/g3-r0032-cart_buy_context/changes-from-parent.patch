+class _ContextGradientScale(torch.autograd.Function):
+    """Exact forward identity with a declared context-only backward multiplier.
+
+    No state_dict entries, RNG, saved tensor copies or private-module changes.
+    Check backward against the intended scaled derivative, not finite differences
+    of the identity forward (which deliberately has a different derivative).
+    """
+    @staticmethod
+    def forward(ctx, context, scale):
+        ctx.scale = scale
+        return context.view_as(context)
+
+    @staticmethod
+    def backward(ctx, grad_output):
+        return grad_output * ctx.scale, None
 
 
