+def _click_bit_nuisance(click_gradient, occupied, nuisance_canonical):
+    """Replace s(Q) by s(K), with no new gate, state, RNG or magnitude.
+
+    K is the occupied-row-centered click-only cotangent, in FP64. Apply
+    the inherited first-max-absolute pivot convention. Zero K uses +1,
+    retaining the old line's zero support instead of imposing a new gate.
+    Empty rows and zero nuisance lines remain zero. At fixed click/state
+    the bit has no auxiliary input; auxiliary radius/line/gates remain.
+    Sign frequencies, near ties, zero-K rate and agreement with s(Q)
+    require host measurement. This does not match bit marginals or make
+    the full replacement statistically independent of auxiliary labels.
+    """
+    with torch.autocast(device_type=click_gradient.device.type, enabled=False):
+        click = torch.where(occupied, click_gradient.to(dtype=torch.float64), 0.0)
+        count = occupied.to(dtype=torch.float64).sum().clamp_min(1.0)
+        reference = torch.where(
+            occupied, click - click.sum(dim=0, keepdim=True) / count, 0.0)
+        flat = reference.reshape(-1)
+        pivot_index = flat.abs().argmax().reshape(1)
+        pivot = torch.gather(flat, dim=0, index=pivot_index).squeeze(0)
+        sign = torch.where(pivot < 0, -torch.ones_like(pivot), torch.ones_like(pivot))
+        return nuisance_canonical * sign
+
