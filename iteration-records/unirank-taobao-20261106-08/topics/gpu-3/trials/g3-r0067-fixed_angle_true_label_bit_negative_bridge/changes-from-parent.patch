+def _occupied_mean_label_targets(train_labels, occupied):
+    """Mean targets for a training-only source VJP; never used in forward.
+
+    For each task t and occupied row i, ybar_it = sum_j m_j*y_jt / sum_j m_j.
+    Empty rows keep their own true labels, matching the old permutation's
+    domain. All-empty and singleton-occupied batches therefore keep labels.
+    No labels, statistics, parameters or RNG state persist across batches.
+
+    At fixed probabilities and recipient graph, BCE's VJP is affine in its
+    target, so this is the uniform-permutation-average auxiliary VJP before
+    nonlinear Q/pivot extraction (up to arithmetic rounding). It is NOT the
+    average orientation bit. Batch prevalence, empty-row labels, true native
+    radius/support and learned state still carry auxiliary-label information.
+    Float32 matches the inherited BCE path; source precision is not altered.
+    """
+    if train_labels.ndim != 2:
+        raise ValueError('Expected training labels [B,T]')
+    if (occupied.shape != (train_labels.shape[0], 1)
+            or occupied.dtype != torch.bool):
+        raise ValueError('Expected history occupancy bool[B,1]')
+    with torch.autocast(device_type=train_labels.device.type, enabled=False):
+        truth = train_labels.detach().to(dtype=torch.float32)
+        count = occupied.to(dtype=torch.float32).sum().clamp_min(1.0)
+        totals = torch.where(occupied, truth, torch.zeros_like(truth)).sum(
+            dim=0, keepdim=True)
+        means = totals / count
+        return torch.where(occupied, means.expand_as(truth), truth)
+
