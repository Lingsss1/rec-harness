+def _pooled_auxiliary_source_targets(truth, labels):
+    """Training-only detached FP32 pooled cart/fav/buy prevalence.
+
+    All rows, including empty histories, participate because Dice couples
+    rows. Click labels never enter the pool. The same scalar fills every
+    column; its click column is never used in a source loss. Preserve total
+    auxiliary soft-label mass up to FP32 reduction roundoff, removing only
+    per-task ratios. No persistent statistics, RNG or extra forward. True
+    labels still determine private learning and native transfer geometry.
+    """
+    if (truth.ndim != 2 or truth.shape[0] < 2
+            or truth.shape[1] != len(labels) or len(labels) != 4
+            or set(labels) != {'is_click', 'cart', 'fav', 'buy'}):
+        raise ValueError('Expected named four-task training labels [B,4]')
+    auxiliary_columns = [list(labels).index(name) for name in ('cart', 'fav', 'buy')]
+    detached = truth.detach().to(dtype=torch.float32)
+    pooled = detached[:, auxiliary_columns].mean()
+    return pooled.expand_as(detached)
 
 
