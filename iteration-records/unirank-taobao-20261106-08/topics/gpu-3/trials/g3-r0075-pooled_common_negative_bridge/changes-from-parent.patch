+def common_scale_bit_diagnostics(click_gradient, true_gradients,
+                                 pooled_gradients, fixed_gradients,
+                                 occupied, pooled_prevalence):
+    """Optional detached same-state host probe, NOT automatically collected.
+
+    Supply BCE(source)-BCE(0) context cotangents through the same recipient
+    graph, before the source surrogate/cast. The host must obtain those
+    VJPs through an authorized diagnostic interface; this helper never runs
+    additional forwards or gradients. It returns tensors, changes no state,
+    and never logs or accesses labels, files, sample IDs or network.
+    In exact arithmetic pooled = (256 * prevalence) * fixed. A zero pooled
+    target has no such positive-scale equivalence. Include empty histories,
+    all-zero sources, ties and degeneracy in the report, not just valid rows.
+    Geometry diagnostics precede repeated-ID scatter/adaptive optimization.
+    """
+    with torch.no_grad(), torch.autocast(device_type=click_gradient.device.type,
+                                        enabled=False):
+        if len(pooled_gradients) != 3 or len(fixed_gradients) != 3:
+            raise ValueError('Expected named-order cart/fav/buy source triples')
+        prevalence = torch.as_tensor(pooled_prevalence,
+                                     device=click_gradient.device,
+                                     dtype=torch.float64).reshape(())
+        scale = prevalence * 256.0
+        numerator = torch.zeros_like(prevalence)
+        denominator = torch.zeros_like(prevalence)
+        for pooled, fixed in zip(pooled_gradients, fixed_gradients):
+            reference = fixed.detach().to(dtype=torch.float64) * scale
+            numerator = numerator + (pooled.detach().to(dtype=torch.float64)
+                                     - reference).square().sum()
+            denominator = denominator + reference.square().sum()
+        tiny = torch.finfo(torch.float64).tiny
+
+        def pivot_summary(gradients):
+            _, _, orthogonal = _click_relative_components(
+                click_gradient, gradients, occupied)
+            replacement = _reassign_orthogonal(click_gradient, orthogonal, occupied)
+            tangent = _tangent_orthogonal(
+                click_gradient, orthogonal, occupied, replacement)
+            flat = tangent.reshape(-1)
+            index = flat.abs().argmax().reshape(1)
+            pivot = torch.gather(flat, dim=0, index=index).squeeze(0)
+            top = flat.abs().topk(min(2, flat.numel())).values
+            margin = top[0] - top[-1]
+            relative_margin = margin / top[0].clamp_min(tiny)
+            ties = (flat.abs() == top[0]).to(dtype=torch.int64).sum()
+            return {'bit': torch.where(pivot < 0, -torch.ones_like(pivot),
+                                       torch.ones_like(pivot)),
+                    'zero_tangent': top[0] == 0,
+                    'pivot_margin_relative': relative_margin,
+                    'max_abs_ties': ties}
+
+        pooled_summary = pivot_summary(pooled_gradients)
+        fixed_summary = pivot_summary(fixed_gradients)
+        output = {
+            'pooled_prevalence': prevalence,
+            'zero_pooled_target': prevalence == 0,
+            'ideal_positive_scale': scale,
+            'source_scale_l2_residual': numerator.sqrt(),
+            'source_scale_relative_l2_residual':
+                numerator.sqrt() / denominator.sqrt().clamp_min(tiny),
+            'reference_source_l2': denominator.sqrt(),
+            'bit_disagreement': pooled_summary['bit'] != fixed_summary['bit'],
+            'occupied_rows': occupied.to(dtype=torch.int64).sum(),
+        }
+        for name, summary in [('pooled', pooled_summary), ('fixed', fixed_summary)]:
+            for key, value in summary.items():
+                output[name + '_' + key] = value
+        for orientation in ('aligned', 'reversed'):
+            pooled_total = _reduce_context_transfer(
+                click_gradient, true_gradients, occupied, 'aligned', orientation,
+                'orthogonal_native', 'nuisance_line_fixed_angle_decomposed_label_bit',
+                pooled_gradients)
+            fixed_total = _reduce_context_transfer(
+                click_gradient, true_gradients, occupied, 'aligned', orientation,
+                'orthogonal_native', 'nuisance_line_fixed_angle_decomposed_label_bit',
+                fixed_gradients)
+            pooled_transfer = pooled_total.to(dtype=torch.float64) - click_gradient.to(dtype=torch.float64)
+            fixed_transfer = fixed_total.to(dtype=torch.float64) - click_gradient.to(dtype=torch.float64)
+            output[orientation + '_pooled_transfer_active'] = pooled_transfer.abs().amax() > 0
+            output[orientation + '_fixed_transfer_active'] = fixed_transfer.abs().amax() > 0
+            output[orientation + '_pooled_transfer_radius_after_cast'] = pooled_transfer.square().sum().sqrt()
+            output[orientation + '_fixed_transfer_radius_after_cast'] = fixed_transfer.square().sum().sqrt()
+            output[orientation + '_context_vjp_l2_difference'] = (
+                pooled_total.to(dtype=torch.float64) - fixed_total.to(dtype=torch.float64)
+            ).square().sum().sqrt()
+        return output
+
