+def _fixed_common_source_targets(probabilities):
+    """Detached FP32 constant 1/256 on EVERY row and task column.
+
+    The click column is never used in a source loss. The value is a predeclared
+    dyadic design constant; no search over this constant is performed. It is
+    positive even when a batch has no auxiliary positives. That difference
+    from pooled prevalence must be counted separately. At fixed state and
+    positive pooled prevalence, the ideal BCE-difference source cotangents
+    differ only by a positive scalar, which cannot change the tangent bit
+    away from degeneracy. Actual BCE/cast/reduction numerics can break this
+    equivalence. Private updates and native true-label geometry are retained.
+    """
+    return torch.full_like(probabilities.detach(), 1.0 / 256.0,
+                           dtype=torch.float32)
 
 
