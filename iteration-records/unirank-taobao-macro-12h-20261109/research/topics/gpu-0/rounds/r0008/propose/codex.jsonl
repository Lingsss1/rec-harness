item_dict, mask, multi_masks\\n375: \\n376:     def get_labels(self, inputs):\\n377:         \\\"\\\"\\\" Please override get_labels() when using multiple labels!\\n378:         \\\"\\\"\\\"\\n379:         labels = self.feature_map.labels\\n380:         y = inputs[labels[0]].to(self.device)\\n381:         return y.float().view(-1, 1)\"\n}\n","exit_code":0,"status":"completed"}}
