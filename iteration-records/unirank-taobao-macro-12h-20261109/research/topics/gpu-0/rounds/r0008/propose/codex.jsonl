{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport ast,json,math,random,time,types\nfrom pathlib import Path\nstart=time.monotonic();p=Path('/workspace/proposal.json');proposal=json.loads(p.read_text())\ntry:\n class Tensor:\n  dtype='float64-shim'\n  def __init__(self,data):self.data=data\n  def mean(self,dim,keepdim):\n   assert dim==0 and keepdim\n   g=len(self.data);v=len(self.data[0]);d=len(self.data[0][0])\n   return Tensor([[[sum(self.data[k][i][j] for k in range(g))/g for j in range(d)] for i in range(v)]])\n  def expand(self,count,a,b):\n   assert a==b==-1 and len(self.data)==1\n   return Tensor([self.data[0] for _ in range(count)])\n  def __getitem__(self,routes):return Tensor([[self.data[r] for r in row] for row in routes])\n  def to(self,dtype):assert dtype==self.dtype;return self\n  def __mul__(self,scale):\n   def f(x):return [f(y) for y in x] if isinstance(x,list) else x*scale\n   return Tensor(f(self.data))\n def einsum(spec,moments,routed):\n  assert spec=='btgv,tgvd->btgd'\n  m=moments.data;w=routed.data\n  batch=len(m);bins=len(m[0]);groups=len(m[0][0]);v=len(m[0][0][0]);d=len(w[0][0][0])\n  assert bins==5 and groups==7\n  return Tensor([[[[sum(m[b][t][g][i]*w[t][g][i][j] for i in range(v)) for j in range(d)] for g in range(groups)] for t in range(bins)] for b in range(batch)])\n tree=ast.parse(Path('/workspace/candidate.py').read_text())\n model=next(x for x in tree.body if isinstance(x,ast.ClassDef) and x.name=='Model')\n helper_ast=ast.Module(body=[x for x in model.body if isinstance(x,ast.FunctionDef) and x.name in ['_bank_assignments','_project_relation_bank']],type_ignores=[])\n ns={'torch':types.SimpleNamespace(einsum=einsum)};exec(compile(helper_ast,'actual-bank-helpers','exec'),ns)\n rng=random.Random(7041)\n def bank_data(v,d,kind='random'):\n  a=[[[rng.uniform(-1,1) if kind=='random' else 0.0 for j in range(d)] for i in range(v)] for g in range(7)]\n  if kind=='tied':\n   z=[[rng.uniform(-1,1) for j in range(d)] for i in range(v)];a=[[row[:] for row in z] for _ in range(7)]\n  return a\n def moments_data(b,v,kind='random'):\n  return [[[[rng.uniform(-2,2) if kind=='random' else 0.0 for i in range(v)] for g in range(7)] for t in range(5)] for k in range(b)]\n def make(mode,bank):\n  obj=types.SimpleNamespace(bank_mode=mode,group_count=7,relation_bank=Tensor(bank))\n  obj.bank_routes=ns['_bank_assignments'](obj)\n  return obj\n def project(mode,m,b):return ns['_project_relation_bank'](make(mode,b),Tensor(m)).data\n def flatten(x):\n  if isinstance(x,list):\n   for y in x:yield from flatten(y)\n  else:yield x\n def close(x,y,tol=1e-10):\n  a=list(flatten(x));b=list(flatten(y));assert len(a)==len(b)\n  assert all(abs(i-j)<=tol for i,j in zip(a,b)),max(abs(i-j) for i,j in zip(a,b))\n def oracle(mode,m,w):\n  b=len(m);v=len(w[0]);d=len(w[0][0])\n  out=[]\n  for k in range(b):\n   windows=[]\n   for t in range(5):\n    row=[]\n    for r in range(7):\n     z=[]\n     for j in range(d):\n      total=0.0\n      for i in range(v):\n       weight=(sum(w[g][i][j] for g in range(7))/7 if mode=='shared' else w[((r+t)%7 if mode=='rotated' else r)][i][j])\n       total+=m[k][t][r][i]*weight\n      z.append(0.0 if mode=='zero' else total)\n     row.append(z)\n    windows.append(row)\n   out.append(windows)\n  return out\n cases=0\n for b,v,d in [(1,1,1),(2,2,3),(3,4,2),(1,112,32)]:\n  for kind in ['random','zero','tied']:\n   w=bank_data(v,d,kind);m=moments_data(b,v)\n   for mode in ['relation','rotated','shared','zero']:\n    obj=make(mode,w);flat=[g for row in obj.bank_routes for g in row]\n    assert all(flat.count(g)==5 for g in range(7))\n    close(project(mode,m,w),oracle(mode,m,w));cases+=1\n   if kind in ['zero','tied']:close(project('relation',m,w),project('rotated',m,w))\n   if kind=='zero':\n    assert all(x==0 for x in flatten(project('relation',m,w)))\n   z=moments_data(b,v,'zero')\n   for mode in ['relation','rotated','shared','zero']:\n    assert all(x==0 for x in flatten(project(mode,z,w)));cases+=1\n # A fixed relabeling would have to be identity at t=0 and a nonidentity at t=1.\n routes=make('rotated',bank_data(1,1)).bank_routes\n assert routes[0]==tuple(range(7)) and routes[1]\"'!=routes[0]\n # One nonzero relation/window demonstrates routing without any token movement.\n m=moments_data(1,1,'\"'zero');m[0][3][2][0]=2.0\n w=[[[float(g+1)]] for g in range(7)]\n for mode,expected in [('relation',6.0),('rotated',12.0),('shared',8.0),('zero',0.0)]:\n  out=project(mode,m,w);assert out[0][3][2][0]==expected\n  assert sum(x\"'!=0 for x in flatten(out))==(0 if mode=='\"'zero' else 1)\n # Finite differences check mathematical bank gradient routing, not Torch autograd.\n b,v,d=2,2,3;w=bank_data(v,d);m=moments_data(b,v)\n q=[[[[rng.uniform(-1,1) for _ in range(d)] for _ in range(7)] for _ in range(5)] for _ in range(b)]\n def loss(mode):return sum(x*y for x,y in zip(flatten(project(mode,m,w)),flatten(q)))\n gradients=0\n for mode in ['relation','rotated','shared','zero']:\n  for g in range(7):\n   for i in range(v):\n    for j in range(d):\n     old=w[g][i][j];eps=1e-5;w[g][i][j]=old+eps;hi=loss(mode);w[g][i][j]=old-eps;lo=loss(mode);w[g][i][j]=old\n     expected=0.0\n     for k in range(b):\n      for t in range(5):\n       for r in range(7):\n        if mode=='zero':coef=0.0\n        elif mode=='shared':coef=1/7\n        else:coef=float(((r+t)%7 if mode=='rotated' else r)==g)\n        expected+=coef*m[k][t][r][i]*q[k][t][r][j]\n     assert abs((hi-lo)/(2*eps)-expected)<1e-7,(mode,g,i,j)\n     gradients+=1\n record={'kind':'bank_helper_oracles','status':'passed','elapsed_seconds':time.monotonic()-start,'projection_and_zero_cases':cases,'finite_difference_gradient_cases':gradients,'checks':['Executed actual _bank_assignments/_project_relation_bank AST using an explicit standard-library tensor/einsum shim','Four modes agree with independent dense-loop reference at B1/2/3 and dimensions1x1,2x3,4x2,112x32','Each of seven banks has exactly five nominal assignments; rotated grouping cannot be reduced to a global relabeling','Zero new banks reproduce zero residual; zero moments give zero residual; identical banks give equal relation/rotated results','Single active relation/window stays at its original token and uses expected bank','Analytical gradient routing agrees with finite differences for all168 small-tensor bank entries/modes'],'limits':'Checks verify algebra, shape indexing and selector implementation, not actual Torch numerical execution, autograd, GPU cost or whole-model masking. No scientific outcome or performance was measured.'}\n proposal['preflight_records'].append(record);p.write_text(json.dumps(proposal,indent=2,ensure_ascii=False)+'\\\\n');print(json.dumps(record,indent=2))\nexcept BaseException as e:\n proposal['preflight_records'].append({'kind':'bank_helper_oracles','status':'failed','elapsed_seconds':time.monotonic()-start,'error':type(e).__name__+': '+str(e),'cost_policy':'Retain this failed local check; no training attempt or scientific outcome.'});p.write_text(json.dumps(proposal,indent=2,ensure_ascii=False)+'\\\\n');raise\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
