  num_heads=2,\\n42:                  qkv_rank=256,\\n43:                  net_dropout=0,\\n44:                  accumulation_steps=1,\\n45:                  attention_activation_type=\\\"SoftMax\\\",\\n46:                  **kwargs):\\n47:         super(HiFormer, self).__init__(feature_map,\\n48:                                        model_id=model_id,\\n49:                                        gpu=gpu,\\n50:                                        **kwargs)\\n51:         self.num_tasks = num_tasks\\n52:         self.feature_map = feature_map\\n53:         self.embedding_dim = embedding_dim\\n54:         self.token_dim = token_dim\\n55:         self.accumulation_steps = accumulation_steps\\n56:         self.num_field = feature_map.get_num_fields()\\n57:         # Track item and non-item feature dimensions\\n58:         self.item_info_dim = 0\\n59:         self.non_item_dim = 0\\n60:         for feat, spec in self.feature_map.features.items():\\n61:             if feat in self.feature_map.labels:\\n62:                 continue\\n63:             if spec.get(\\\"type\\\") == \\\"meta\\\":\\n64:                 continue\\n65:             emb_dim = spec.get(\\\"embedding_dim\\\", embedding_dim)\\n66:             if spec.get(\\\"source\\\") in [\\\"item\\\", \\\"action\\\"]:\\n67:                 self.item_info_dim += emb_dim\\n68:                 self.num_field += 1\\n69:             else:\\n70:                 self.non_item_dim += emb_dim\\n71: \\n72:         self.embedding_layer = FeatureEmbedding(feature_map, embedding_dim)\\n73:         self.unified_tokenizer_layer = HiFormerTokenizer(\\n74:             input_dim=embedding_dim,\\n75:             token_dim=token_dim,\\n76:             num_tokens=self.num_field,\\n77:             num_tasks=num_tasks\\n78:         )\\n79: \\n80:         self.attention_layers = MultiHeadTargetAttention(\\n81:             input_dim=self.item_info_dim,\\n82:             attention_dim=token_dim if attention_dim is None else attention_dim,\\n83:             dropout_rate=attention_dropout,\\n84:             attention_activation_type=attention_activation_type,\\n85:         )\\n86: \\n87:         self.unified_interaction_layers = HiFormerBlocks(token_dim=token_dim,\\n88:                                        num_token=num_tasks + self.num_field,\\n89:                                        num_layers=num_layers,\\n90:                                        expand=expansion_factor,\\n91:                                        num_heads=num_heads,\\n92:                                        qkv_rank=qkv_rank,\\n93:                                        net_dropout=net_dropout)\\n94:         self.tower = nn.ModuleList([MLP_Block(input_dim=token_dim,\\n95:                                               output_dim=1,\\n96:                                               hidden_units=tower_hidden_units,\\n97:                                               hidden_activations=tower_activations,\\n98:                                               output_activation=None,\\n99:                                               dropout_rates=net_dropout)\\n100:                                     for _ in range(num_tasks)])\\n101:         if isinstance(task, list):\\n102:             assert len(task) == num_tasks, \\\"the number of tasks must equal the length of \\\\\\\"task\\\\\\\"\\\"\"\n}\n","exit_code":0,"status":"completed"}}
