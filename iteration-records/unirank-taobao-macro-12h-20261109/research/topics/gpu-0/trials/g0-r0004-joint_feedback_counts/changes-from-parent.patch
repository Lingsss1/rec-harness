+    def _feedback_count_features(self, relation_masks, task_masks, valid):
+        """Return [B,5,7,4] log-counts using only visible historical feedback.
+
+        independent: n(temporal, relation) * n(temporal, feedback) / n(temporal).
+        This preserves both marginals but removes their within-bin association.
+        The four feedback sets need not partition the history.
+        """
+        batch, periods, groups, length = relation_masks.shape
+        feedback = torch.stack([m.bool() & valid for m in task_masks], dim=-1)
+        # Keep integer-valued joint sums and fractional expectations in FP32.
+        with torch.autocast(device_type=valid.device.type, enabled=False):
+            if length:
+                joint = torch.bmm(relation_masks.flatten(1, 2).float(), feedback.float())
+                joint = joint.reshape(batch, periods, groups, 4)
+            else:
+                joint = torch.zeros((batch, periods, groups, 4),
+                                    dtype=torch.float32, device=valid.device)
+            marginal = joint[:, :, :1, :]
+            relation_count = relation_masks.sum(dim=-1).float().unsqueeze(-1)
+            temporal_count = relation_count[:, :, :1, :].clamp_min(1.0)
+            if self.feedback_count_mode == 'joint':
+                raw = joint
+            elif self.feedback_count_mode == 'independent':
+                raw = relation_count * marginal / temporal_count
+            elif self.feedback_count_mode == 'marginal':
+                raw = marginal.expand_as(joint)
+            else:
+                raw = torch.zeros_like(joint)
+            return torch.log1p(raw) / math.log(101.0)
 
