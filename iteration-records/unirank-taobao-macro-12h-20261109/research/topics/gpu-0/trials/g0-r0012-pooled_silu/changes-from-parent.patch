+class MemoryComposition(nn.Module):
+    """Compose fields before compression, with a mass-matched pooled control.
+
+For signed coefficients a_i, C=sum_i a_i*x_i and m=sum_i |a_i|.
+The event path is sum_i a_i*h(x_i); the pooled path is m*h(C/m).
+There are no biases, so h(0)=0. With linear h these paths are identical
+in exact arithmetic. The safe denominator only handles zero/tiny mass;
+both paths use that same denominator and coefficient rescaling.
+"""
+
+    def __init__(self, item_width, hidden, placement, activation):
+        super().__init__()
+        self.placement = placement
+        self.activation = activation
+        self.input = nn.Linear(item_width, hidden, bias=False)
+        self.output = nn.Linear(hidden, item_width, bias=False)
+        nn.init.zeros_(self.output.weight)
+
+    def _transform(self, content):
+        hidden = self.input(content)
+        if self.activation == 'silu':
+            hidden = torch.nn.functional.silu(hidden)
+        return self.output(hidden)
+
+    def forward(self, items, weighted, feedback_fraction):
+        # The caller disables autocast: sums and MLPs here are FP32.
+        coefficients = (weighted * feedback_fraction[:, None, :]
+                        / math.sqrt(7.0))
+        mass = coefficients.abs().sum(dim=-1, keepdim=True)
+        safe_mass = mass.clamp_min(1e-12)
+        normalized = coefficients / safe_mass
+        pooled_items = torch.bmm(normalized, items)
+        event_features = self._transform(items)
+        pooled_features = self._transform(pooled_items)
+        # Execute both paths in every cell. Only the selected branch has
+        # backward work; nominal capacity and forward work are matched.
+        event_update = safe_mass * torch.bmm(normalized, event_features)
+        pooled_update = safe_mass * pooled_features
+        if self.placement == 'event':
+            return event_update
+        return pooled_update
 
 
