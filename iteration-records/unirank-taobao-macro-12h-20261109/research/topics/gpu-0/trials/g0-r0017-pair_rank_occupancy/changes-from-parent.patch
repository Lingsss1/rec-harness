+    def _select_pair_rank_component(self, moment, content, pair_mask, coefficients):
+        """M=W+O on joint pair support, without signed normalization.
+
+        mu is the unweighted pair centroid in the original temporal basis.
+        Empty support yields zero; a singleton has W=0 in exact arithmetic.
+        W also vanishes for constant weighted content on the pair support.
+        All cells compute both components; full returns the original tensor.
+        Called inside the inherited FP32 autocast-disabled summary block.
+        """
+        count = pair_mask.sum(dim=-1, keepdim=True).float()
+        centroid = (pair_mask * coefficients[:, :, None, :]).sum(
+            dim=-1, keepdim=True) / count.clamp_min(1.0)
+        occupancy = centroid * content
+        within = moment - occupancy
+        if self.pair_rank_component == 'within':
+            return within
+        if self.pair_rank_component == 'occupancy':
+            return occupancy
