    {
      "knowledge_id": "unirank-method-infnet",
      "decision": "used",
      "rationale": "Current search found the nearest behavior-mask/task-aware alternative after the local input audit. The pinned benchmark forward and original v1 sections 3.1-3.2 were inspected; their results do not establish local effectiveness. Original sum-pooled behavior proxies and pinned average-pooled hubs also differ from one another.",
      "transformed_mechanism": "Use supplied overlapping action masks for repeated task-query-specific retrieval and a separately switched log-count input inside the local static-memory field/task stack, with matched R x C controls.",
      "variant_names": [
        "routing_counts",
        "routing_only",
        "counts_only",
        "routing_counts_off"
      ],
      "nearest_work_difference": "No INFNet proxy aggregation/broadcast or PGU backbone; task-subset attention restrictions persist through two internal reads and final pooling, with static history keys and a 1:1 global fallback. Novelty unverified. Primary paper https://arxiv.org/html/2508.11565v1 lines 121-174 and unirank-code:INFNet lines 123-255.",
      "falsifier": "No positive conditional routing effect, a counts-only explanation, failure of padding/endpoint checks, or future count-preserving wrong-mask/readout-only controls matching the gain.",
      "source_refs": [
        "unirank-benchmark-v2",
        "unirank-code:INFNet",
        "paper:infnet"
