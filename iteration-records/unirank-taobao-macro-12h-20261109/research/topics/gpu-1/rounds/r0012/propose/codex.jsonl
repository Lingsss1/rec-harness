{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport difflib\nx=Path('history_g0_r0017_pair_rank_occupancy.py').read_text().splitlines()\ny=Path('history_g1_r0009_compact_mean.py').read_text().splitlines()\nprint('\\\\n'.join(difflib.unified_diff(x,y,fromfile='g0',tofile='g1',n=3)))\nPY\"","aggregated_output":"/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n--- g0\n\n+++ g1\n\n@@ -1,13 +1,20 @@\n\n-\"\"\"Decompose pair-rank information into placement and within-pair variation.\n-\n-All inherited paths remain unchanged. Replace only the input of the existing\n-zero-start pair-rank bank: W=M-mu*S, O=mu*S, or full M. The unweighted pair\n-centroid mu uses the parent's temporal rank basis and valid pair support.\n-This is a prospective local mechanism test, not an originality claim.\n+\"\"\"Pruned mean-history residual on the frozen g0 representation.\n+\n+Local evidence: g1-r0008-mean_residual marginally exceeded adaptive retrieval\n+at one seed. Its uniform wide-value weights have no dependence on queries,\n+event keys, task mixing or token content. Remove that dead forward/backward\n+path, retaining the original low-rank normalized zero-start residual.\n+The DIN-summary arm is an equal-active-capacity replacement control.\n+\n+The historical constructor is replayed before deleting unused modules, solely\n+to preserve active tensor initialization and the caller CPU RNG stream. No\n+retired module remains registered with the optimizer. Numerical equivalence\n+and actual runtime must be checked by the host; no bitwise claim is made.\n \"\"\"\n import math\n import torch\n from torch import nn\n+from torch.nn import functional as F\n from unirank.pytorch.models import MultiTaskModel\n from unirank.pytorch.layers import FeatureEmbeddingDict\n from unirank.pytorch.layers.activations import Dice\n@@ -30,12 +37,193 @@\n\n     'content_bank_mode': 'relation',\n     'feedback_content_mode': 'factorized',\n     'memory_source': 'joint',\n-    'memory_layout': 'collapsed',\n-    'pair_content_source': 'joint',\n-    'pair_count_source': 'joint',\n-    'pair_rank_source': 'joint',\n-    'pair_rank_component': 'occupancy',\n+    'memory_layout': 'separate',\n+    'terminal_prior': 'none',\n+    'query_memory': 'state_uniform',\n+    'retrieval_state': 'content',\n+    'retrieval_summary': 'uniform',\n }\n+\n+\n+class TaskRead(nn.Module):\n+    \"\"\"Shared g1-style Q/K for narrow reads and terminal wide-value pooling.\"\"\"\n+\n+    def __init__(self, width, heads, prior):\n+        super().__init__()\n+        self.heads = heads\n+        self.head_width = width // heads\n+        self.prior = prior\n+        self.query_norm = nn.LayerNorm(width)\n+        self.memory_norm = nn.LayerNorm(width)\n+        self.query = nn.Linear(width, width, bias=False)\n+        self.key = nn.Linear(width, width, bias=False)\n+        self.value = nn.Linear(width, width, bias=False)\n+        self.output = nn.Linear(width, width, bias=False)\n+\n+    def _project(self, tensor, layer):\n+        batch, count, width = tensor.shape\n+        return layer(tensor).reshape(\n+            batch, count, self.heads, self.head_width).transpose(1, 2)\n+\n+    def _memory(self, memory, valid):\n+        # Append null AFTER normalization, avoiding learned LN bias evidence.\n+        memory = self.memory_norm(memory)\n+        memory = torch.where(valid.unsqueeze(-1), memory, torch.zeros_like(memory))\n+        memory = torch.cat([memory, memory.new_zeros(memory.shape[0], 1,\n+                                                    memory.shape[-1])], dim=1)\n+        valid = torch.cat([valid, ~valid.any(dim=1, keepdim=True)], dim=1)\n+        return memory, valid\n+\n+    def forward(self, query, memory, valid):\n+        batch, count, width = query.shape\n+        query = self._project(self.query_norm(query), self.query)\n+        memory, valid = self._memory(memory, valid)\n+        key = self._project(memory, self.key)\n+        value = self._project(memory, self.value)\n+        mixed = F.scaled_dot_product_attention(\n+            query, key, value, attn_mask=valid[:, None, None, :],\n+            dropout_p=0.0, is_causal=False)\n+        mixed = mixed.transpose(1, 2).contiguous().reshape(batch, count, width)\n+        return self.output(mixed)\n+\n+    def read_state(self, query, memory, valid, uniform=False):\n+        \"\"\"Read intact g0 tokens using shared Q/K/V and exact key masks.\n+\n+        Both arms calculate learned and uniform weights. Uniform is over\n+        valid tokens, never padded tokens; the null is used only if empty.\n+        Q/K remain active in terminal pooling and task mixing in every arm.\n+        FP32 logits/softmax are common to both structured-memory controls.\n+        \"\"\"\n+        batch, count, width = query.shape\n+        query = self._project(self.query_norm(query), self.query)\n+        memory, extended_valid = self._memory(memory, valid)\n+        key = self._project(memory, self.key)\n+        value = self._project(memory, self.value)\n+        with torch.autocast(device_type=query.device.type, enabled=False):\n+            logits = torch.matmul(query.float(), key.float().transpose(-2, -1))\n+            logits = logits / math.sqrt(self.head_width)\n+            logits = logits.masked_fill(~extended_valid[:, None, None, :], float('-inf'))\n+            adaptive = torch.softmax(logits, dim=-1)\n+            key_weights = extended_valid.float()\n+            key_weights = key_weights / key_weights.sum(dim=-1, keepdim=True).clamp_min(1.0)\n+            uniform_weights = adaptive * 0.0 + key_weights[:, None, None, :]\n+            weights = uniform_weights if uniform else adaptive\n+        mixed = torch.matmul(weights.to(value.dtype), value)\n+        mixed = mixed.transpose(1, 2).contiguous().reshape(batch, count, width)\n+        return self.output(mixed)\n+\n+    def _match_bias(self, query, match_fields, matches):\n+        field_keys = self._project(self.memory_norm(match_fields), self.key)\n+        # All routes are calculated in all arms, including the no-prior arm.\n+        with torch.autocast(device_type=query.device.type, enabled=False):\n+            scores = torch.matmul(query.float(), field_keys.float().transpose(-2, -1))\n+            adaptive = torch.softmax(scores / math.sqrt(self.head_width), dim=-1)\n+            uniform = adaptive * 0.0 + 1.0 / matches.shape[-1]\n+            rotated = torch.roll(adaptive, shifts=1, dims=-1)\n+            evidence = matches.float().transpose(1, 2).unsqueeze(1)\n+            adaptive_bias = 2.0 * torch.matmul(adaptive, evidence)\n+            uniform_bias = 2.0 * torch.matmul(uniform, evidence)\n+            rotated_bias = 2.0 * torch.matmul(rotated, evidence)\n+            if self.prior == 'adaptive':\n+                bias = adaptive_bias\n+            elif self.prior == 'uniform':\n+                bias = uniform_bias\n+            elif self.prior == 'rotated':\n+                bias = rotated_bias\n+            else:\n+                bias = adaptive_bias * 0.0\n+        return torch.cat([bias, bias.new_zeros(*bias.shape[:-1], 1)], dim=-1)\n+\n+    def pool_values(self, query, memory, values, valid, match_fields, matches,\n+                    pooling='adaptive'):\n+        query = self._project(self.query_norm(query), self.query)\n+        memory, extended_valid = self._memory(memory, valid)\n+        key = self._project(memory, self.key)\n+        values = torch.where(valid.unsqueeze(-1), values, torch.zeros_like(values))\n+        values = torch.cat([values, values.new_zeros(values.shape[0], 1,\n+                                                    values.shape[-1])], dim=1)\n+        bias = self._match_bias(query, match_fields, matches)\n+        with torch.autocast(device_type=query.device.type, enabled=False):\n+            logits = torch.matmul(query.float(), key.float().transpose(-2, -1))\n+            logits = logits / math.sqrt(self.head_width) + bias\n+            logits = logits.masked_fill(~extended_valid[:, None, None, :], float('-inf'))\n+            adaptive = torch.softmax(logits, dim=-1)\n+            # The null is valid only for empty history and carries zero value.\n+            # Preserve adaptive computation/graph in the replacement control.\n+            uniform = extended_valid.float()\n+            uniform = uniform / uniform.sum(dim=-1, keepdim=True).clamp_min(1.0)\n+            uniform = adaptive * 0.0 + uniform[:, None, None, :]\n+            weights = (uniform if pooling == 'uniform' else adaptive).mean(dim=1)\n+        return torch.bmm(weights.to(values.dtype), values)\n+\n+\n+class TaskMixer(nn.Module):\n+    def __init__(self, width, heads):\n+        super().__init__()\n+        self.attention = TaskRead(width, heads, 'none')\n+        self.ffn_norm = nn.LayerNorm(width)\n+        self.ffn = nn.Sequential(nn.Linear(width, 2 * width), nn.GELU(),\n+                                 nn.Linear(2 * width, width))\n+\n+    def forward(self, states):\n+        valid = torch.ones(states.shape[:2], dtype=torch.bool, device=states.device)\n+        states = states + 0.5 * self.attention(states, states, valid)\n+        return states + 0.5 * self.ffn(self.ffn_norm(states))\n+\n+\n+class TerminalRetrieval(nn.Module):\n+    \"\"\"Initialize as the ancestor, then retain only the active residual maps.\"\"\"\n+\n+    def __init__(self, value_width, width, heads, tasks, prior, query_memory,\n+                 summary_mode):\n+        super().__init__()\n+        self.query_memory = query_memory\n+        self.summary_mode = summary_mode\n+        self.event_projection = nn.Linear(value_width, width, bias=False)\n+        self.history_position = nn.Parameter(torch.empty(101, width))\n+        self.task_identity = nn.Parameter(torch.empty(1, tasks, width))\n+        self.read = TaskRead(width, heads, prior)\n+        self.after_read = nn.ModuleList([TaskMixer(width, heads) for _ in range(2)])\n+        self.final_norm = nn.LayerNorm(width)\n+        self.value_down = nn.Linear(value_width, width, bias=False)\n+        self.value_up = nn.Linear(width, value_width, bias=False)\n+        self.value_norm = nn.LayerNorm(value_width, elementwise_affine=False)\n+        self.output = nn.Linear(value_width, value_width, bias=False)\n+        nn.init.normal_(self.history_position, std=0.02)\n+        nn.init.normal_(self.task_identity, std=0.02)\n+        nn.init.zeros_(self.output.weight)\n+\n+        # Replay precisely the ancestor initialization above, then prune.\n+        # These modules cannot influence either replacement summary. Deletion\n+        # also removes their parameters from dense clipping and AdamW groups.\n+        for name in ('event_projection', 'history_position', 'task_identity',\n+                     'read', 'after_read', 'final_norm'):\n+            delattr(self, name)\n+        self.tasks = tasks\n+\n+    def forward(self, values, valid, din_summary):\n+        # Keep the ancestor's [B,4,V] residual operation shapes. Each task\n+        # receives the same input, but this avoids an additional numerical\n+        # change from collapsing four identical linear/LayerNorm operations.\n+        if self.summary_mode == 'din':\n+            summary = din_summary[:, None, :].expand(-1, self.tasks, -1)\n+        else:\n+            # Append a zero null value; it is valid only for empty histories.\n+            # FP32 weights and BF16 bmm mirror the historical pooling route.\n+            values = torch.where(valid.unsqueeze(-1), values,\n+                                 torch.zeros_like(values))\n+            values = torch.cat([values, values.new_zeros(\n+                values.shape[0], 1, values.shape[-1])], dim=1)\n+            extended_valid = torch.cat([valid, ~valid.any(dim=1, keepdim=True)], dim=1)\n+            with torch.autocast(device_type=values.device.type, enabled=False):\n+                weights = extended_valid.float()\n+                weights = weights / weights.sum(dim=-1, keepdim=True).clamp_min(1.0)\n+                weights = weights[:, None, :].expand(-1, self.tasks, -1).contiguous()\n+            summary = torch.bmm(weights.to(values.dtype), values)\n+        summary = self.value_norm(self.value_up(self.value_down(summary)))\n+        update = self.output(summary)\n+        return torch.where(valid.any(dim=1)[:, None, None], update,\n+                           torch.zeros_like(update))\n \n \n class FeedbackMemory(nn.Module):\n@@ -173,9 +361,11 @@\n\n                  content_mode='relation', count_mode='relation', moment_mode='linear',\n                  moment_component='full', residual_mode='copy', bank_mode='relation',\n                  content_bank_mode='relation', feedback_content_mode='factorized',\n-                 memory_source='joint', memory_layout='collapsed',\n-                 pair_content_source='joint', pair_count_source='joint',\n-                 pair_rank_source='joint', pair_rank_component='occupancy',\n+                 memory_source='joint', memory_layout='separate',\n+                 terminal_prior=CONFIG['terminal_prior'],\n+                 query_memory=CONFIG['query_memory'],\n+                 retrieval_state=CONFIG['retrieval_state'],\n+                 retrieval_summary=CONFIG['retrieval_summary'],\n                  num_tasks=None,\n                  task='binary_classification', **kwargs):\n         if num_tasks is not None and num_tasks != len(feature_map.labels):\n@@ -222,20 +412,19 @@\n\n             raise ValueError('Unknown memory source')\n         if memory_layout not in ('separate', 'collapsed'):\n             raise ValueError('Unknown memory layout')\n-        if pair_content_source not in ('joint', 'factorized'):\n-            raise ValueError('Unknown pair content source')\n-        if pair_cou