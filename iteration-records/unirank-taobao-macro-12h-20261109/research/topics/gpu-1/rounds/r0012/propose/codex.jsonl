r-task-macro-auc-v1\",\n      \"split\": \"validation\",\n      \"tasks\": [\n        \"is_click\",\n        \"cart\",\n        \"fav\",\n        \"buy\"\n      ],\n      \"weights\": {\n        \"is_click\": 0.25,\n        \"cart\": 0.25,\n        \"fav\": 0.25,\n        \"buy\": 0.25\n      },\n      \"primary\": \"macro_auc\",\n      \"direction\": \"maximize\",\n      \"tie_breakers\": [\n        \"macro_logloss ascending\",\n        \"parameters ascending\",\n        \"trial_id ascending\"\n      ],\n      \"missing_task\": \"invalid; never average only the available tasks\",\n      \"regression_policy\": \"Report each task's AUC and Logloss change against the reference and entry model; explain trade-offs in topic decisions. No undeclared per-task veto threshold.\",\n      \"test_policy\": \"Selection uses validation only; freeze before a single held-out assessment. Historical completed test suites remain unchanged.\"\n    },\n    \"final_assessment_scope\": \"validation only; no test scores or predictions are supplied\"\n  },\n  \"study_schema\": {\n    \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n    \"title\": \"Task-independent prospective mechanism study\",\n    \"type\": \"object\",\n    \"additionalProperties\": false,\n    \"required\": [\n      \"id\",\n      \"protocol_ref\",\n      \"evidence_refs\",\n      \"question\",\n      \"hypothesis\",\n      \"nearest_work\",\n      \"inherited_components\",\n      \"proposed_difference\",\n      \"predictions\",\n      \"falsifiers\",\n      \"alternative_explanations\",\n      \"contrasts\",\n      \"cost_plan\"\n    ],\n    \"properties\": {\n      \"id\": {\n        \"type\": \"string\",\n        \"minLength\": 1\n      },\n      \"protocol_ref\": {\n        \"type\": \"string\",\n        \"minLength\": 1\n      },\n      \"evidence_refs\": {\n        \"type\": \"array\",\n        \"minItems\": 1,\n        \"items\": {\n          \"type\": \"string\"\n        }\n      },\n      \"question\": {\n        \"type\": \"string\",\n        \"minLength\": 1\n      },\n      \"hypothesis\": {\n        \"type\": \"string\",\n        \"minLength\": 1\n      },\n      \"nearest_work\": {\n        \"type\": \"array\",\n        \"minItems\": 1,\n        \"items\": {\n          \"type\": \"object\",\n          \"additionalProperties\": false,\n          \"required\": [\n            \"source_ref\",\n            \"verification\",\n            \"difference\"\n          ],\n          \"properties\": {\n            \"source_ref\": {\n              \"type\": \"string\"\n            },\n            \"verification\": {\n              \"enum\": [\n                \"discovered\",\n                \"read\",\n                \"archived\",\n                \"implementation_checked\"\n              ]\n            },\n            \"difference\": {\n              \"type\": \"string\",\n              \"minLength\": 1\n            }\n          }\n        }\n      },\n      \"inherited_components\": {\n        \"type\": \"array\",\n        \"items\": {\n          \"type\": \"string\"\n        }\n      },\n      \"proposed_difference\": {\n        \"type\": \"string\",\n        \"minLength\": 1\n      },\n      \"predictions\": {\n        \"type\": \"array\",\n        \"minItems\": 1,\n        \"items\": {\n          \"type\": \"string\"\n        }\n      },\n      \"falsifiers\": {\n        \"type\": \"array\",\n        \"minItems\": 1,\n        \"items\": {\n          \"type\": \"string\"\n        }\n      },\n      \"alternative_explanations\": {\n        \"type\": \"array\",\n        \"minItems\": 1,\n        \"items\": {\n          \"type\": \"string\"\n        }\n      },\n      \"contrasts\": {\n        \"type\": \"array\",\n        \"minItems\": 1,\n        \"items\": {\n          \"type\": \"object\",\n          \"additionalProperties\": false,\n          \"required\": [\n            \"parent_ref\",\n            \"intervention\",\n            \"control\",\n            \"held_fixed\",\n            \"remaining_confounds\",\n            \"decision_if_supported\",\n            \"decision_if_not_supported\"\n          ],\n          \"properties\": {\n            \"parent_ref\": {\n              \"type\": \"string\"\n            },\n            \"intervention\": {\n              \"type\": \"string\"\n            },\n            \"control\": {\n              \"type\": \"string\"\n            },\n            \"held_fixed\": {\n              \"type\": \"array\",\n              \"items\": {\n                \"type\": \"string\"\n              }\n            },\n            \"remaining_confounds\": {\n              \"type\": \"array\",\n              \"items\": {\n                \"type\": \"string\"\n              }\n            },\n            \"decision_if_supported\": {\n              \"type\": \"string\"\n            },\n            \"decision_if_not_supported\": {\n              \"type\": \"string\"\n            }\n          }\n        }\n      },\n      \"cost_plan\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\n          \"estimate_ref\",\n          \"all_variants_counted\",\n          \"attribution_reserve\",\n          \"assessment_reserve\",\n          \"stop_rule\"\n        ],\n        \"properties\": {\n          \"estimate_ref\": {\n            \"type\": \"string\"\n          },\n          \"all_variants_counted\": {\n            \"const\": true\n          },\n          \"attribution_reserve\": {\n            \"type\": \"string\"\n          },\n          \"assessment_reserve\": {\n            \"type\": \"string\"\n          },\n          \"stop_rule\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  },\n  \"required_study_protocol_ref\": \"427fc51900560816321ba9bbc170639eb26625972df75b22e3c47d523c363748\",\n  \"reference_format\": \"Use allowed_observation_ids verbatim for local evidence. Descriptive references are accepted when they contain a complete known ID. Correct any previous_runtime_error before submitting; its failed costs remain charged.\",\n  \"action\": \"Read candidate.py and baseline_reference.py, diagnose an observed limitation, check primary nearest work, and implement a feasible candidate. Write proposal.json containing study (matching study_schema), parent_trial (existing trial ID), and variants (1-4 objects with distinct name, file basename ending .py, role candidate/control, config object, and note). At least one candidate is required. Add key ablations or matched controls for the claimed mechanism when feasible; reference existing matched trials as controls where justified. Each variant is a standalone module. Do not run training. New architecture choices come from evidence; industry cards do not mandate them.\",\n  \"candidate_api\": {\n    \"Model\": \"Model(feature_map, model_id=..., gpu=0, **kwargs) -> torch.nn.Module; optional MultiTaskModel utilities. forward(inputs) returns {label+\\\"_pred\\\": probability [B,1]} for all four tasks. Host places the module on the assigned GPU.\",\n    \"architecture_scope\": \"Whole-model design for unified modeling. Model need not inherit the initial reference, retain its pooling, or use separate task towers; representations, interactions, routing and readout can all be replaced.\",\n    \"lineage\": \"parent_trial records the empirical comparison and evidence lineage. A complete rewrite may have no inherited architectural components.\",\n    \"proposal_unit\": \"Coordinated structural changes implementing one coherent mechanism are allowed; isolate their effects through planned replacement, component or factorial controls.\",\n    \"meta\": \"Read-only UniRank FeatureMap: features (ordered specs, sources, vocab_size), labels, data_dir. Full framework reference files are available through tools.py.\",\n    \"batch\": [\n      \"inputs=(batch_dict,item_dict,history_mask,multi_task_history_masks)\",\n      \"batch_dict: categorical user/context features int64[B]; current labels and lookup metadata are removed by host\",\n      \"item_dict: item_id,cate_id,campaign_id,customer_id,brand,price_bucket,action, each int64[B,101]; last position is current target, preceding100 are pre-padded history\",\n      \"history_mask: float 0/1 [B,100]; four task masks: [B,100]; use only masked history\",\n      \"Target action is always zero (unknown/padding), never a current label. Historical feedback policy is frozen in protocol.history_policy.\",\n      \"Historical item_id is a previous advertisement ID. Shopping events used to create auxiliary labels are only matched by user/category/brand.\",\n      \"No raw timestamps, event-time deltas, raw user IDs, full future histories, current labels or global sample indexes are supplied to forward.\"\n    ],\n    \"task_labels\": [\n      \"is_click\",\n      \"cart\",\n      \"fav\",\n      \"buy\"\n    ],\n    \"primary\": \"Validation macro AUC = (is_click AUC + cart AUC + fav AUC + buy AUC)/4. Checkpoint, incumbent, topic gains and final selection all use this rule. Exact ties prefer lower mean Logloss, then fewer parameters, then trial ID. Report every task change; explain trade-offs.\",\n    \"optional\": [\n      \"Literal CONFIG dict for model architecture only; all frozen host parameters are rejected.\",\n      \"Model.training_loss(inputs, probabilities[B,4], train_labels[B,4]) -> finite differentiable scalar; labels supplied only during training. Default is sum of four unweighted BCEs.\"\n    ],\n    \"ownership\": \"Edit candidate modules/proposal only. No filesystem/network operations in model source. Imports: torch,numpy,math,typing,copy,functools,collections,itertools,dataclasses,contextlib,unirank,model_zoo. Host owns training, input filtering and scoring.\",\n    \"local_checks\": \"Coding jail has no torch; check syntax/source there. Host trains and scores. Do not install or train inside coding jail.\",\n    \"training\": \"From scratch; same frozen data, seed, epochs, batch, history limit and dense AdamW / embedding Adagrad. Architecture may be rewritten completely. Retain causal controls and account for added parameters/computation.\"\n  }\n}\n","exit_code":0,"status":"completed"}}
