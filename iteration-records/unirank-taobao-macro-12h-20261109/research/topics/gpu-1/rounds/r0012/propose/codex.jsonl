pression; binary probabilities for four tasks\",\n    \"history\": \"Previous ad exposures, real advertisement/category/campaign/customer/brand/price fields and feedback action tokens; fixed visibility protocol.\",\n    \"auxiliary_label_semantics\": \"Any cart/fav/buy of the same user/category/brand within 24h after impression; not advertisement-specific conversion attribution.\",\n    \"split\": \"Official 2017-05-06..11 train / May12 validation / May13 held out, Asia/Shanghai\",\n    \"limitations\": [\n      \"Official whole-window filtering/vocabularies and publisher static snapshots are inherited benchmark assumptions. Their production point-in-time validity is not established.\"\n    ],\n    \"history_policy\": \"official_offline\"\n  },\n  \"agent_binding\": {\n    \"fixed_instructions\": \"../../agent/instructions.txt\",\n    \"task_specific_prompt_overrides\": false,\n    \"delivery\": \"resolve the task reference on demand; materialize only the current task, experiment and evidence in temporary working context\",\n    \"context_snapshot\": [\n      \"task_version\",\n      \"protocol_hash\",\n      \"runtime_budget_state\",\n      \"selected_artifact_refs\",\n      \"retrieval_queries_and_hits\",\n      \"knowledge_versions\"\n    ],\n    \"recovery\": \"Reuse accepted outputs only with matching input, protocol and source hashes; retain unfinished-call and failed-experiment costs.\"\n  },\n  \"fixed_agent_boundary_audit\": {\n    \"forbidden_terms\": [\n      \"Taobao\",\n      \"Tencent\",\n      \"CTR\",\n      \"pCVR\",\n      \"ROC-AUC\",\n      \"Logloss\",\n      \"CRAFT\",\n      \"UniDAC\",\n      \"UniTokenFormer\",\n      \"QueryFormer\",\n      \"UniDot\",\n      \"pv\",\n      \"cart\",\n      \"fav\",\n      \"buy\",\n      \"品牌\",\n      \"类目\",\n      \"淘宝\",\n      \"腾讯\"\n    ],\n    \"scope\": \"all fixed agent artifacts, not transient task/tool responses\",\n    \"limitation\": \"Structural and lexical boundary checks do not prove freedom from every possible semantic bias.\"\n  },\n  \"knowledge\": {\n    \"papers\": {\n      \"mode\": \"evidence-driven primary-source search\",\n      \"source_ref\": \"paper_sources.json\",\n      \"seed_refs\": [\n        \"paper:din\",\n        \"paper:dmr\"\n      ],\n      \"rules\": [\n        \"Find nearest methods before asserting novelty\",\n        \"A retrieved citation verifies provenance, not scientific truth\"\n      ]\n    },\n    \"industry\": {\n      \"selection\": \"user-requested fifteen methods compared in UniRank v2\",\n      \"source_ref\": \"industry/sources.json\",\n      \"cards_ref\": \"industry/cards.jsonl\",\n      \"members\": [\n        \"HiFormer\",\n        \"RankMixer\",\n        \"INFNet\",\n        \"LONGER\",\n        \"OneTrans\",\n        \"Zenith\",\n        \"HyFormer\",\n        \"MixFormer\",\n        \"TokenMixer\",\n        \"EST\",\n        \"HeMix\",\n        \"UniMixer\",\n        \"TokenFormer\",\n        \"UltraHSTU\",\n        \"SSR\"\n      ],\n      \"scientific_status\": \"external method descriptions and benchmark source; no local effectiveness claim\",\n      \"task_mismatch\": \"Original paper tasks and benchmark reimplementations may differ from this unified-modeling task. Respect the frozen fields, histories, labels and costs.\",\n      \"not_a_mandatory_architecture\": true,\n      \"knowledge_bundle_identity\": \"3dc5bcd1b86ee39e8ec95d76644921d4115091246269a125c9e0b7c08a45a826\",\n      \"delivery\": \"15 UniRank comparison-method cards, available on demand through tools.py. Inclusion is external knowledge, not another baseline or a local result.\"\n    },\n    \"personal\": {\n      \"enabled\": false,\n      \"source_ref\": null,\n      \"writer\": \"human_only\",\n      \"create_empty_personal_file\": false,\n      \"future_updates\": \"Human edits create new read-only versions. New versions enter the next working context; conflicts generate agent-memory records and revision suggestions, never edits to