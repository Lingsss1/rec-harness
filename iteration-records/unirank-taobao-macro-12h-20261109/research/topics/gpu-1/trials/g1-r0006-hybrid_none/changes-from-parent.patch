+class TaskRead(nn.Module):
+    """Shared g1-style Q/K for narrow reads and terminal wide-value pooling."""
+
+    def __init__(self, width, heads, prior):
+        super().__init__()
+        self.heads = heads
+        self.head_width = width // heads
+        self.prior = prior
+        self.query_norm = nn.LayerNorm(width)
+        self.memory_norm = nn.LayerNorm(width)
+        self.query = nn.Linear(width, width, bias=False)
+        self.key = nn.Linear(width, width, bias=False)
+        self.value = nn.Linear(width, width, bias=False)
+        self.output = nn.Linear(width, width, bias=False)
+
+    def _project(self, tensor, layer):
+        batch, count, width = tensor.shape
+        return layer(tensor).reshape(
+            batch, count, self.heads, self.head_width).transpose(1, 2)
+
+    def _memory(self, memory, valid):
+        # Append null AFTER normalization, avoiding learned LN bias evidence.
+        memory = self.memory_norm(memory)
+        memory = torch.where(valid.unsqueeze(-1), memory, torch.zeros_like(memory))
+        memory = torch.cat([memory, memory.new_zeros(memory.shape[0], 1,
+                                                    memory.shape[-1])], dim=1)
+        valid = torch.cat([valid, ~valid.any(dim=1, keepdim=True)], dim=1)
+        return memory, valid
+
+    def forward(self, query, memory, valid):
+        batch, count, width = query.shape
+        query = self._project(self.query_norm(query), self.query)
+        memory, valid = self._memory(memory, valid)
+        key = self._project(memory, self.key)
+        value = self._project(memory, self.value)
+        mixed = F.scaled_dot_product_attention(
+            query, key, value, attn_mask=valid[:, None, None, :],
+            dropout_p=0.0, is_causal=False)
+        mixed = mixed.transpose(1, 2).contiguous().reshape(batch, count, width)
+        return self.output(mixed)
+
+    def _match_bias(self, query, match_fields, matches):
+        field_keys = self._project(self.memory_norm(match_fields), self.key)
+        # All routes are calculated in all arms, including the no-prior arm.
+        with torch.autocast(device_type=query.device.type, enabled=False):
+            scores = torch.matmul(query.float(), field_keys.float().transpose(-2, -1))
+            adaptive = torch.softmax(scores / math.sqrt(self.head_width), dim=-1)
+            uniform = adaptive * 0.0 + 1.0 / matches.shape[-1]
+            rotated = torch.roll(adaptive, shifts=1, dims=-1)
+            evidence = matches.float().transpose(1, 2).unsqueeze(1)
+            adaptive_bias = 2.0 * torch.matmul(adaptive, evidence)
+            uniform_bias = 2.0 * torch.matmul(uniform, evidence)
+            rotated_bias = 2.0 * torch.matmul(rotated, evidence)
+            if self.prior == 'adaptive':
+                bias = adaptive_bias
+            elif self.prior == 'uniform':
+                bias = uniform_bias
+            elif self.prior == 'rotated':
+                bias = rotated_bias
+            else:
+                bias = adaptive_bias * 0.0
+        return torch.cat([bias, bias.new_zeros(*bias.shape[:-1], 1)], dim=-1)
+
+    def pool_values(self, query, memory, values, valid, match_fields, matches):
+        query = self._project(self.query_norm(query), self.query)
+        memory, extended_valid = self._memory(memory, valid)
+        key = self._project(memory, self.key)
+        values = torch.where(valid.unsqueeze(-1), values, torch.zeros_like(values))
+        values = torch.cat([values, values.new_zeros(values.shape[0], 1,
+                                                    values.shape[-1])], dim=1)
+        bias = self._match_bias(query, match_fields, matches)
+        with torch.autocast(device_type=query.device.type, enabled=False):
+            logits = torch.matmul(query.float(), key.float().transpose(-2, -1))
+            logits = logits / math.sqrt(self.head_width) + bias
+            logits = logits.masked_fill(~extended_valid[:, None, None, :], float('-inf'))
+            weights = torch.softmax(logits, dim=-1).mean(dim=1)
+        return torch.bmm(weights.to(values.dtype), values)
+
+
+class TaskMixer(nn.Module):
+    def __init__(self, width, heads):
+        super().__init__()
+        self.attention = TaskRead(width, heads, 'none')
+        self.ffn_norm = nn.LayerNorm(width)
+        self.ffn = nn.Sequential(nn.Linear(width, 2 * width), nn.GELU(),
+                                 nn.Linear(2 * width, width))
+
+    def forward(self, states):
+        valid = torch.ones(states.shape[:2], dtype=torch.bool, device=states.device)
+        states = states + 0.5 * self.attention(states, states, valid)
+        return states + 0.5 * self.ffn(self.ffn_norm(states))
+
