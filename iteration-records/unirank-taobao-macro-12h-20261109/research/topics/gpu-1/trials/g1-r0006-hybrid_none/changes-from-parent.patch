+class TerminalRetrieval(nn.Module):
+    """Only four task queries retain sequence-wide reads within the cost cap.
+
+    Queries derive from the g0 final valid-token mean, rather than reproducing
+    g1's full field stream. Events are read-only as in g1's committed setting.
+    The low-rank value path and nonaffine normalization follow g1; an extra
+    zero-start residual output preserves the exact g0 starting function.
+    """
+
+    def __init__(self, value_width, width, heads, tasks, prior):
+        super().__init__()
+        self.event_projection = nn.Linear(value_width, width, bias=False)
+        self.history_position = nn.Parameter(torch.empty(101, width))
+        self.task_identity = nn.Parameter(torch.empty(1, tasks, width))
+        self.read = TaskRead(width, heads, prior)
+        self.after_read = nn.ModuleList([TaskMixer(width, heads) for _ in range(2)])
+        self.final_norm = nn.LayerNorm(width)
+        self.value_down = nn.Linear(value_width, width, bias=False)
+        self.value_up = nn.Linear(width, value_width, bias=False)
+        self.value_norm = nn.LayerNorm(value_width, elementwise_affine=False)
+        self.output = nn.Linear(value_width, value_width, bias=False)
+        nn.init.normal_(self.history_position, std=0.02)
+        nn.init.normal_(self.task_identity, std=0.02)
+        nn.init.zeros_(self.output.weight)
+
+    def forward(self, tokens, token_valid, values, valid, match_fields, matches):
+        denominator = token_valid.sum(dim=1, keepdim=True).clamp_min(1)
+        seed = (tokens * token_valid.unsqueeze(-1).to(tokens.dtype)).sum(dim=1)
+        seed = seed / denominator.to(tokens.dtype)
+        states = seed[:, None, :] + self.task_identity.to(seed.dtype)
+        rank = valid.long().cumsum(dim=1)
+        events = self.event_projection(values) + self.history_position[rank]
+        events = torch.where(valid.unsqueeze(-1), events, torch.zeros_like(events))
+        for mixer in self.after_read:
+            states = mixer(states + 0.5 * self.read(states, events, valid))
+        states = self.final_norm(states)
+        summary = self.read.pool_values(states, events, values, valid,
+                                        match_fields, matches)
+        summary = self.value_norm(self.value_up(self.value_down(summary)))
+        update = self.output(summary)
+        return torch.where(valid.any(dim=1)[:, None, None], update,
+                           torch.zeros_like(update))
 
 
