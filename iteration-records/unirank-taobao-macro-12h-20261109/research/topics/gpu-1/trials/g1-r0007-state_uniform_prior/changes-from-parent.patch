+    def read_state(self, query, memory, valid, uniform=False):
+        """Read intact g0 tokens using shared Q/K/V and exact key masks.
+
+        Both arms calculate learned and uniform weights. Uniform is over
+        valid tokens, never padded tokens; the null is used only if empty.
+        Q/K remain active in terminal pooling and task mixing in every arm.
+        FP32 logits/softmax are common to both structured-memory controls.
+        """
+        batch, count, width = query.shape
+        query = self._project(self.query_norm(query), self.query)
+        memory, extended_valid = self._memory(memory, valid)
+        key = self._project(memory, self.key)
+        value = self._project(memory, self.value)
+        with torch.autocast(device_type=query.device.type, enabled=False):
+            logits = torch.matmul(query.float(), key.float().transpose(-2, -1))
+            logits = logits / math.sqrt(self.head_width)
+            logits = logits.masked_fill(~extended_valid[:, None, None, :], float('-inf'))
+            adaptive = torch.softmax(logits, dim=-1)
+            key_weights = extended_valid.float()
+            key_weights = key_weights / key_weights.sum(dim=-1, keepdim=True).clamp_min(1.0)
+            uniform_weights = adaptive * 0.0 + key_weights[:, None, None, :]
+            weights = uniform_weights if uniform else adaptive
+        mixed = torch.matmul(weights.to(value.dtype), value)
         mixed = mixed.transpose(1, 2).contiguous().reshape(batch, count, width)
         return self.output(mixed)
 
