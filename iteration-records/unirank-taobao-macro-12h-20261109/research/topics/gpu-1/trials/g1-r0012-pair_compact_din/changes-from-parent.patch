+class TaskRead(nn.Module):
+    """Shared g1-style Q/K for narrow reads and terminal wide-value pooling."""
+
+    def __init__(self, width, heads, prior):
+        super().__init__()
+        self.heads = heads
+        self.head_width = width // heads
+        self.prior = prior
+        self.query_norm = nn.LayerNorm(width)
+        self.memory_norm = nn.LayerNorm(width)
+        self.query = nn.Linear(width, width, bias=False)
+        self.key = nn.Linear(width, width, bias=False)
+        self.value = nn.Linear(width, width, bias=False)
+        self.output = nn.Linear(width, width, bias=False)
+
+    def _project(self, tensor, layer):
+        batch, count, width = tensor.shape
+        return layer(tensor).reshape(
+            batch, count, self.heads, self.head_width).transpose(1, 2)
+
+    def _memory(self, memory, valid):
+        # Append null AFTER normalization, avoiding learned LN bias evidence.
+        memory = self.memory_norm(memory)
+        memory = torch.where(valid.unsqueeze(-1), memory, torch.zeros_like(memory))
+        memory = torch.cat([memory, memory.new_zeros(memory.shape[0], 1,
+                                                    memory.shape[-1])], dim=1)
+        valid = torch.cat([valid, ~valid.any(dim=1, keepdim=True)], dim=1)
+        return memory, valid
+
+    def forward(self, query, memory, valid):
+        batch, count, width = query.shape
+        query = self._project(self.query_norm(query), self.query)
+        memory, valid = self._memory(memory, valid)
+        key = self._project(memory, self.key)
+        value = self._project(memory, self.value)
+        mixed = F.scaled_dot_product_attention(
+            query, key, value, attn_mask=valid[:, None, None, :],
+            dropout_p=0.0, is_causal=False)
+        mixed = mixed.transpose(1, 2).contiguous().reshape(batch, count, width)
+        return self.output(mixed)
+
+    def read_state(self, query, memory, valid, uniform=False):
+        """Read intact g0 tokens using shared Q/K/V and exact key masks.
+
+        Both arms calculate learned and uniform weights. Uniform is over
+        valid tokens, never padded tokens; the null is used only if empty.
+        Q/K remain active in terminal pooling and task mixing in every arm.
+        FP32 logits/softmax are common to both structured-memory controls.
+        """
+        batch, count, width = query.shape
+        query = self._project(self.query_norm(query), self.query)
+        memory, extended_valid = self._memory(memory, valid)
+        key = self._project(memory, self.key)
+        value = self._project(memory, self.value)
+        with torch.autocast(device_type=query.device.type, enabled=False):
+            logits = torch.matmul(query.float(), key.float().transpose(-2, -1))
+            logits = logits / math.sqrt(self.head_width)
+            logits = logits.masked_fill(~extended_valid[:, None, None, :], float('-inf'))
+            adaptive = torch.softmax(logits, dim=-1)
+            key_weights = extended_valid.float()
+            key_weights = key_weights / key_weights.sum(dim=-1, keepdim=True).clamp_min(1.0)
+            uniform_weights = adaptive * 0.0 + key_weights[:, None, None, :]
+            weights = uniform_weights if uniform else adaptive
+        mixed = torch.matmul(weights.to(value.dtype), value)
+        mixed = mixed.transpose(1, 2).contiguous().reshape(batch, count, width)
+        return self.output(mixed)
+
+    def _match_bias(self, query, match_fields, matches):
+        field_keys = self._project(self.memory_norm(match_fields), self.key)
+        # All routes are calculated in all arms, including the no-prior arm.
+        with torch.autocast(device_type=query.device.type, enabled=False):
+            scores = torch.matmul(query.float(), field_keys.float().transpose(-2, -1))
+            adaptive = torch.softmax(scores / math.sqrt(self.head_width), dim=-1)
+            uniform = adaptive * 0.0 + 1.0 / matches.shape[-1]
+            rotated = torch.roll(adaptive, shifts=1, dims=-1)
+            evidence = matches.float().transpose(1, 2).unsqueeze(1)
+            adaptive_bias = 2.0 * torch.matmul(adaptive, evidence)
+            uniform_bias = 2.0 * torch.matmul(uniform, evidence)
+            rotated_bias = 2.0 * torch.matmul(rotated, evidence)
+            if self.prior == 'adaptive':
+                bias = adaptive_bias
+            elif self.prior == 'uniform':
+                bias = uniform_bias
+            elif self.prior == 'rotated':
+                bias = rotated_bias
+            else:
+                bias = adaptive_bias * 0.0
+        return torch.cat([bias, bias.new_zeros(*bias.shape[:-1], 1)], dim=-1)
+
+    def pool_values(self, query, memory, values, valid, match_fields, matches,
+                    pooling='adaptive'):
+        query = self._project(self.query_norm(query), self.query)
+        memory, extended_valid = self._memory(memory, valid)
+        key = self._project(memory, self.key)
+        values = torch.where(valid.unsqueeze(-1), values, torch.zeros_like(values))
+        values = torch.cat([values, values.new_zeros(values.shape[0], 1,
+                                                    values.shape[-1])], dim=1)
+        bias = self._match_bias(query, match_fields, matches)
+        with torch.autocast(device_type=query.device.type, enabled=False):
+            logits = torch.matmul(query.float(), key.float().transpose(-2, -1))
+            logits = logits / math.sqrt(self.head_width) + bias
+            logits = logits.masked_fill(~extended_valid[:, None, None, :], float('-inf'))
+            adaptive = torch.softmax(logits, dim=-1)
+            # The null is valid only for empty history and carries zero value.
+            # Preserve adaptive computation/graph in the replacement control.
+            uniform = extended_valid.float()
+            uniform = uniform / uniform.sum(dim=-1, keepdim=True).clamp_min(1.0)
+            uniform = adaptive * 0.0 + uniform[:, None, None, :]
+            weights = (uniform if pooling == 'uniform' else adaptive).mean(dim=1)
+        return torch.bmm(weights.to(values.dtype), values)
+
+
+class TaskMixer(nn.Module):
+    def __init__(self, width, heads):
+        super().__init__()
+        self.attention = TaskRead(width, heads, 'none')
+        self.ffn_norm = nn.LayerNorm(width)
+        self.ffn = nn.Sequential(nn.Linear(width, 2 * width), nn.GELU(),
+                                 nn.Linear(2 * width, width))
+
+    def forward(self, states):
+        valid = torch.ones(states.shape[:2], dtype=torch.bool, device=states.device)
+        states = states + 0.5 * self.attention(states, states, valid)
+        return states + 0.5 * self.ffn(self.ffn_norm(states))
+
+
+class TerminalRetrieval(nn.Module):
+    """Initialize as the ancestor, then retain only the active residual maps."""
+
+    def __init__(self, value_width, width, heads, tasks, prior, query_memory,
+                 summary_mode):
+        super().__init__()
+        self.query_memory = query_memory
+        self.summary_mode = summary_mode
+        self.event_projection = nn.Linear(value_width, width, bias=False)
+        self.history_position = nn.Parameter(torch.empty(101, width))
+        self.task_identity = nn.Parameter(torch.empty(1, tasks, width))
+        self.read = TaskRead(width, heads, prior)
+        self.after_read = nn.ModuleList([TaskMixer(width, heads) for _ in range(2)])
+        self.final_norm = nn.LayerNorm(width)
+        self.value_down = nn.Linear(value_width, width, bias=False)
+        self.value_up = nn.Linear(width, value_width, bias=False)
+        self.value_norm = nn.LayerNorm(value_width, elementwise_affine=False)
+        self.output = nn.Linear(value_width, value_width, bias=False)
+        nn.init.normal_(self.history_position, std=0.02)
+        nn.init.normal_(self.task_identity, std=0.02)
+        nn.init.zeros_(self.output.weight)
+
+        # Replay precisely the ancestor initialization above, then prune.
+        # These modules cannot influence either replacement summary. Deletion
+        # also removes their parameters from dense clipping and AdamW groups.
+        for name in ('event_projection', 'history_position', 'task_identity',
+                     'read', 'after_read', 'final_norm'):
+            delattr(self, name)
+        self.tasks = tasks
+
+    def forward(self, values, valid, din_summary):
+        # Keep the ancestor's [B,4,V] residual operation shapes. Each task
+        # receives the same input, but this avoids an additional numerical
+        # change from collapsing four identical linear/LayerNorm operations.
+        if self.summary_mode == 'din':
+            summary = din_summary[:, None, :].expand(-1, self.tasks, -1)
+        else:
+            # Append a zero null value; it is valid only for empty histories.
+            # FP32 weights and BF16 bmm mirror the historical pooling route.
+            values = torch.where(valid.unsqueeze(-1), values,
+                                 torch.zeros_like(values))
+            values = torch.cat([values, values.new_zeros(
+                values.shape[0], 1, values.shape[-1])], dim=1)
+            extended_valid = torch.cat([valid, ~valid.any(dim=1, keepdim=True)], dim=1)
+            with torch.autocast(device_type=values.device.type, enabled=False):
+                weights = extended_valid.float()
+                weights = weights / weights.sum(dim=-1, keepdim=True).clamp_min(1.0)
+                weights = weights[:, None, :].expand(-1, self.tasks, -1).contiguous()
+            summary = torch.bmm(weights.to(values.dtype), values)
+        summary = self.value_norm(self.value_up(self.value_down(summary)))
+        update = self.output(summary)
+        return torch.where(valid.any(dim=1)[:, None, None], update,
+                           torch.zeros_like(update))
+
 
 
