  "assessments": [
    {
      "knowledge_id": "unirank-method-hemix",
      "decision": "used",
      "rationale": "Used the prior idea of keeping recent and earlier representations distinct, with explicit comparison against target-blind grouping. Primary v3 and pinned benchmark paths inspected; no local effectiveness is imported.",
      "transformed_mechanism": "Use a shared fixed last16 ordinal split and deterministic category/brand-match groups, rather than mixed learned queries or HeteroMixer. Test moving local nonlinear scoring across group means.",
      "variant_names": [
        "target_early",
        "position_early",
        "target_late",
        "position_late"
      ],
      "nearest_work_difference": "No fixed/dynamic query attention, real-time day boundary or heterogeneous low-rank token mixer. Exact fixed100 visibility and four task readouts remain shared. This is a prospective adaptation, not novelty or a HeMix reproduction.",
      "falsifier": "No positive factorial interaction or no measured quality-cost benefit; gains from counts alone would not establish the proposed retention explanation.",
      "source_refs": [
        "unirank-benchmark-v2",
        "unirank-code:HeMix",
        "paper:hemix"
      ],
