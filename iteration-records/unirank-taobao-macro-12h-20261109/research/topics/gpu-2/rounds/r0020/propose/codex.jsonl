\"source_sha256\": \"1ec68734ad73ccf5df47b8f7d6e2c55a24b12e228e1f5e0a910b55077b531795\",\n              \"status\": \"success\"\n            },\n            {\n              \"trial_id\": \"g2-r0019-product_counts\",\n              \"source_sha256\": \"e67097e571dff1ce9dfd5b67db6982433600df26879caf24aa6669e480fe2b46\",\n              \"status\": \"success\"\n            },\n            {\n              \"trial_id\": \"g2-r0019-content_counts\",\n              \"source_sha256\": \"12f24afc6935d50a611c3f5309e00aa783fc26b7fca10ebb2f7d29d3f37d9a87\",\n              \"status\": \"success\"\n            }\n          ],\n          \"evidence_class\": \"agent-declared usage; not mechanism confirmation\"\n        },\n        {\n          \"knowledge_id\": \"unirank-method-est\",\n          \"decision\": \"considered\",\n          \"rationale\": \"Read industry card and pinned benchmark forward lines198-233; original paper paper:est is link/provenance only in authorized archive.\",\n          \"transformed_mechanism\": \"None; no EST-specific modules added.\",\n          \"variant_names\": [],\n          \"nearest_work_difference\": \"Fixed g0 stack and terminal residual replacement differ from its iterative cross-attention/feature-specific transformations; original-method priority unverified.\",\n          \"falsifier\": \"A later original-paper audit could reveal closer prior art; any novelty claim remains unverified.\",\n          \"source_refs\": [\n            \"unirank-benchmark-v2\",\n            \"unirank-code:EST\",\n            \"paper:est\"\n          ],\n          \"executed_refs\": [],\n          \"evidence_class\": \"agent-declared usage; not mechanism confirmation\"\n        },\n        {\n          \"knowledge_id\": \"unirank-method-onetrans\",\n          \"decision\": \"considered\",\n          \"rationale\": \"Search returned its card. Progressive token reduction/repeated sequence interaction is outside the narrow residual-attribution question and would confound this comparison. Original primary text not read here.\",\n          \"transformed_mechanism\": \"None.\",\n          \"variant_names\": [],\n          \"nearest_work_difference\": \"No change to tokens, attention depth or sequence reduction; no original-method reproduction claim.\",\n          \"falsifier\": \"If the frozen compressed representation prevents all residual gains, token-level alternatives may merit a new budgeted question, not automatic adoption.\",\n          \"source_refs\": [\n            \"unirank-benchmark-v2\",\n            \"unirank-code:OneTrans\",\n            \"paper:onetrans\"\n          ],\n          \"executed_refs\": [],\n          \"evidence_class\": \"agent-declared usage; not mechanism confirmation\"\n        },\n        {\n          \"knowledge_id\": \"unirank-method-hiformer\",\n          \"decision\": \"considered\",\n          \"rationale\": \"Search returned its card. Existing g0 already supplies target-aware pooling and token interaction; adding hierarchical interaction would change a second mechanism and cost. Original primary text not read here.\",\n          \"transformed_mechanism\": \"None.\",\n          \"variant_names\": [],\n          \"nearest_work_difference\": \"Only the terminal residual input is replaced; no hierarchical field interaction is introduced.\",\n          \"falsifier\": \"A residual-null outcome does not refute hierarchical interaction and cannot be used as local evidence about this external method.\",\n          \"source_refs\": [\n            \"unirank-benchmark-v2\",\n            \"unirank-code:HiFormer\",\n            \"paper:hiformer\"\n          ],\n          \"executed_refs\": [],\n          \"evidence_class\": \"agent-declared usage; not mechanism confirmation\"\n        }\n      ],\n      \"undocumented_industry_ids\": [],\n      \"status\": \"documented\",\n      \"executed_variants\": [\n        {\n          \"trial_id\": \"g2-r0019-content_rates\",\n          \"variant_name\": \"content_r