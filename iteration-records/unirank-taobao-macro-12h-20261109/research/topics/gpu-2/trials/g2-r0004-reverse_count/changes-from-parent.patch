+    def _interpolate_rates(self, fractions, counts, feedback, mask):
+        """Convex mixture using only the contracted masked prefix.
+
+        n/(n+4) trusts high-occupancy local rates more. The fixed control
+        uses 1/2 everywhere; reverse uses 4/(n+4). Strength four is fixed
+        prospectively, not fitted to validation. The global rate includes
+        the current slot; this is shrinkage, not an independent prior.
+        Empty slots contribute zero after the existing content mask.
+        """
+        total = (mask > 0).sum(dim=-1).clamp(min=1)
+        global_rate = feedback.sum(dim=-1) / total[:, None]
+        strength = self.shrinkage_strength
+        # Execute the same small slot-sized arithmetic in all replacements.
+        weight = counts / (counts + strength)
+        if self.rate_interpolation == 'fixed':
+            weight = weight * 0.0 + 0.5
+        elif self.rate_interpolation == 'reverse':
+            weight = 1.0 - weight
+        return (weight[:, :, None] * fractions
+                + (1.0 - weight[:, :, None]) * global_rate[:, None, :])
+
