+    def _feedback_membership(self, clean_item, valid):
+        """Eight disjoint category/brand match x ordinal recency slots.
+
+        Recent means the last sixteen positions of the supplied prefix,
+        exactly the source's positional convention, never a time interval.
+        Zero/padding IDs cannot supply equality evidence. Holey masks are
+        allowed and never change the position convention.
+        """
+        length = valid.shape[1]
+        pos = torch.arange(length, device=valid.device)[None, :]
+        recent = pos >= max(length - self.recent_window, 0)
+        matches = []
+        for name in ('cate_id', 'brand'):
+            history = clean_item[name][:, :-1]
+            target = clean_item[name][:, -1:]
+            equal = (history == target) & (history > 0) & (target > 0)
+            padding = self.match_padding[name]
+            if padding is not None:
+                equal = equal & (history != padding) & (target != padding)
+            matches.append(equal)
+        category, brand = matches
+        groups = [(~category & ~brand), (~category & brand),
+                  (category & ~brand), (category & brand)]
+        members = [(group & ~recent & valid) for group in groups]
+        members += [(group & recent & valid) for group in groups]
+        return torch.stack(members, dim=1).float()
+
+    def _interpolate_rates(self, fractions, counts, feedback, valid):
+        """Local weight n/(n+4), or its capacity-matched fixed 1/2 control.
+
+        Background is the same user's entire visible prefix including this
+        slot, not an independent prior. Both arms retain raw local fractions.
+        Empty slots' products vanish through zero content.
+        """
+        total = valid.sum(dim=-1).clamp_min(1)
+        global_rate = feedback.sum(dim=-1) / total[:, None]
+        weight = counts / (counts + self.shrinkage_strength)
+        if self.rate_interpolation == 'fixed':
+            weight = weight * 0.0 + 0.5
+        return (weight[:, :, None] * fractions
+                + (1.0 - weight[:, :, None]) * global_rate[:, None, :])
+
+    def _feedback_features(self, clean_item, valid, task_masks, keys, values):
+        members = self._feedback_membership(clean_item, valid)
+        counts = members.sum(dim=-1)
+        divisor = counts.clamp_min(1).unsqueeze(-1)
+        batch, length = valid.shape
+        if length:
+            mean_keys = torch.bmm(members.to(keys.dtype), keys) / divisor
+            mean_values = torch.bmm(members.to(values.dtype), values) / divisor
+        else:
+            mean_keys = keys.new_zeros((batch, self.feedback_slots, self.key_width))
+            mean_values = values.new_zeros((batch, self.feedback_slots, self.value_width))
+        occupied = (counts > 0).unsqueeze(-1)
+        mean_keys = mean_keys * occupied.to(mean_keys.dtype)
+        mean_values = mean_values * occupied.to(mean_values.dtype)
+        slots = self.feedback_slot_projection(mean_values)
+        slots = slots * occupied.to(slots.dtype)
+        feedback = torch.stack([(m > 0) & valid for m in task_masks], dim=1).float()
+        if length:
+            fractions = torch.bmm(members, feedback.transpose(1, 2)) / divisor
+        else:
+            fractions = members.new_zeros((batch, self.feedback_slots, self.feedback_tasks))
+        projected = self.feedback_projection(mean_keys)
+        projected = projected * occupied.to(projected.dtype)
+        gate = self._interpolate_rates(fractions, counts, feedback, valid)
+        moments = projected[:, :, None, :] * gate[:, :, :, None]
+        return torch.cat([slots.flatten(1), counts / 100.0,
+                          moments.flatten(1), fractions.flatten(1)], dim=-1)
 
