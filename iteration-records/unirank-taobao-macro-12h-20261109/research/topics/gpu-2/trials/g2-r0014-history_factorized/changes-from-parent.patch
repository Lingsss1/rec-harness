+    def _condition_keys(self, keys, target, valid):
+        """Bounded diagonal conditioning before the existing bias-free map.
+
+        For each sample, z_i = W diag(1 + tanh(q)) x_i. Target and history
+        arms select q from the current item or the masked history mean.
+        The history control adds the same nonlinear scaling without looking
+        at the target. Both references and both gates are always computed.
+        No new parameters or random draws; no detached embedding gradients.
+        'none' is an unscored calibration mode for archived-source parity.
+        """
+        divisor = valid.sum(dim=-1, keepdim=True).clamp_min(1)
+        # Forward already masks keys; repeat masking so this helper's reference
+        # and output are independently invariant to finite padding payloads.
+        clean_keys = keys.masked_fill(~valid.unsqueeze(-1), 0)
+        history = clean_keys.sum(dim=1) / divisor.to(keys.dtype)
+        target_gate = torch.tanh(target.float()).to(keys.dtype)
+        history_gate = torch.tanh(history.float()).to(keys.dtype)
