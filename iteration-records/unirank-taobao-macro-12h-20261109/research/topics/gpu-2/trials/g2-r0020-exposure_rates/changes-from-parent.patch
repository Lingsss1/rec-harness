+    def _select_residual_rates(self, fractions, support, feedback, valid, occupied):
+        """Same-width rate replacement with no additional learned parameters.
+
+        All modes compute both summaries. The inherited interpolation uses
+        support/(support+4), with the same visible-user background including
+        the slot itself. Empty slots are exactly zero in every mode, so a
+        background rate cannot create content in an unoccupied group.
+        Raw mode preserves the archived content_rates input. Feedback was
+        already intersected with valid; overlapping task masks are allowed.
+        """
+        with torch.autocast(device_type=fractions.device.type, enabled=False):
+            total = valid.sum(dim=-1).clamp_min(1)
+            background = feedback.float().sum(dim=-1) / total[:, None]
+            background = background[:, None, :].expand_as(fractions)
+            smoothed = self._residual_rates(
+                fractions.float(), support.float(), feedback.float(), valid)
+            if self.rate_summary == 'smoothed':
+                selected = smoothed
+            elif self.rate_summary == 'background':
+                selected = background
+            else:
+                selected = fractions.float()
+            return selected * occupied.to(selected.dtype)
+
