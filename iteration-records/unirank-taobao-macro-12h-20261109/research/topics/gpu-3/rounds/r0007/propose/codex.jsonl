le.split('.')[0] in allowed\n  if isinstance(n,ast.Call) and isinstance(n.func,ast.Name):assert n.func.id not in {'open','eval','exec','__import__','compile','input'}\n digest=hashlib.sha256(f.read_bytes()).hexdigest()\n assert digest in v['note']\n print(v['name'],cfg['block_click_score_grad'],cfg['block_aux_score_grad'],digest)\nassert (root/'control_click_stop.py').read_bytes()==(root/'history_g3_r0006_linear_private.py').read_bytes()\nassert {(v['config']['block_click_score_grad'],v['config']['block_aux_score_grad']) for v in p['variants']}=={(False,False),(True,False),(False,True),(True,True)}\nprint('PASS: study schema; local evidence/protocol; standalone syntax; defaults/CONFIG/proposal alignment; complete factorial; allowed imports/no direct IO; parent AST equality except documented flags; byte-identical replay.')\nprint('NOT RUN: model instantiation, tensors, numerical parity, autograd, optimizer registration, BF16, training, scoring or held-out access.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
