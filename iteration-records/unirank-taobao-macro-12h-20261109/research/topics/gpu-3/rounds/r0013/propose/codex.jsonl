ank-benchmark-v2\",\n  \"access_scope\": \"Link and provenance only. Read original primary paper before a stronger novelty or reproduction claim.\",\n  \"scientific_status\": \"external_reference\",\n  \"local_reproduction\": false\n}\n{\n  \"id\": \"paper:din\",\n  \"title\": \"Deep Interest Network for Click-Through Rate Prediction\",\n  \"url\": \"https://arxiv.org/abs/1706.06978v4\",\n  \"status\": \"abstract_read; inspect full mechanism and author implementation before a detailed reproduction claim\",\n  \"scientific_status\": \"external_reference\",\n  \"local_reproduction\": false,\n  \"cached_unix\": 1793799695.3575318,\n  \"text_sha256\": \"83fb9eeca31e2fa3c557b6f08b893ad0018cefb33da6e00952136b9ce17e607e\",\n  \"content_sha256\": \"5fee25f33f375e51b3ee9417d376ff9dbe2ea3628c932a7679ddfeb0feaaade2\",\n  \"retrieved_url\": \"https://arxiv.org/html/1706.06978v4\",\n  \"access_scope\": \"archived exact-version primary text; caching does not establish a local mechanism result\",\n  \"version\": \"content-sha256:5fee25f33f375e51b3ee9417d376ff9dbe2ea3628c932a7679ddfeb0feaaade2\",\n  \"text_ref\": \"source-text://paper:din\",\n  \"text_lines\": 831\n}\n{\n  \"id\": \"unirank-code:INFNet\",\n  \"title\": \"INFNet benchmark implementation\",\n  \"kind\": \"benchmark_reimplementation\",\n  \"url\": \"https://github.com/salmon1802/UniRank/blob/90bb99a60724e975ec565836266fd86dcad0039d/model_zoo/INFNet.py\",\n  \"version\": \"git:90bb99a60724e975ec565836266fd86dcad0039d\",\n  \"content_read\": true,\n  \"read_scope\": \"Representative forward paths and structural definitions; no end-to-end reproduction of this method.\",\n  \"access_scope\": \"Full pinned benchmark source for inspection; not proof of equivalence to the original author method.\",\n  \"locators\": [\n    {\n      \"symbol\": \"INFNet.forward\",\n      \"line\": 123,\n      \"end_line\": 170\n    },\n    {\n      \"symbol\": \"INFNetCategoricalTokenizer.forward\",\n      \"line\": 180,\n      \"end_line\": 185\n    },\n    {\n      \"symbol\": \"INFNetBlocks.forward\",\n      \"line\": 204,\n      \"end_line\": 219\n    },\n    {\n      \"symbol\": \"Aggregation.forward\",\n      \"line\": 241,\n      \"end_line\": 255\n    },\n    {\n      \"symbol\": \"HubSpecificAggregator.forward\",\n      \"line\": 266,\n      \"end_line\": 273\n    },\n    {\n      \"symbol\": \"Broadcast.forward\",\n      \"line\": 284,\n      \"end_line\": 288\n    },\n    {\n      \"symbol\": \"BroadcastGatedUnit.forward\",\n      \"line\": 303,\n      \"end_line\": 313\n    }\n  ],\n  \"scientific_status\": \"external_reference\",\n  \"local_reproduction\": false,\n  \"text_sha256\": \"e3750a73af1ceb6b2be4bf9355b70a9ad356985a3c465ef27238ef7e0f28fb4c\",\n  \"content_sha256\": \"e3750a73af1ceb6b2be4bf9355b70a9ad356985a3c465ef27238ef7e0f28fb4c\",\n  \"text_ref\": \"source-text://unirank-code:INFNet\",\n  \"text_lines\": 313\n}\n","exit_code":0,"status":"completed"}}
