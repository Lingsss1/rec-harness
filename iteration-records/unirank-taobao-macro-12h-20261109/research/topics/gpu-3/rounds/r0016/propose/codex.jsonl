{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport ast,json,subprocess,hashlib,copy\nfrom pathlib import Path\nruntime=json.loads(subprocess.check_output(['python3','/workspace/tools.py','resolve','run://r-001']))\np=json.loads(Path('proposal.json').read_text())\ndef validate(value,schema,path='study'):\n typ=schema.get('type')\n if typ=='object':\n  assert isinstance(value,dict),path\n  assert set(schema.get('required',[]))<=value.keys(),(path,'missing required')\n  props=schema.get('properties',{})\n  if schema.get('additionalProperties') is False:assert value.keys()<=props.keys(),(path,'extra keys')\n  for k,v in value.items():\n   if k in props:validate(v,props[k],path+'.'+k)\n elif typ=='array':\n  assert isinstance(value,list) and len(value)>=schema.get('minItems',0),path\n  for i,v in enumerate(value):validate(v,schema.get('items',{}),path+f'[{i}]')\n elif typ=='string':assert isinstance(value,str) and len(value)>=schema.get('minLength',0),path\n if 'enum' in schema:assert value in schema['enum'],path\n if 'const' in schema:assert value==schema['const'] and type(value)==type(schema['const']),path\nvalidate(p['study'],runtime['study_schema'])\nassert p['study']['protocol_ref']==runtime['required_study_protocol_ref']\nallowed=set(runtime['context']['allowed_observation_ids'])\nassert set(p['study']['evidence_refs'])<=allowed\nassert p['parent_trial'] in allowed\nassert 1<=len(p['variants'])<=4 and any(v['role']=='candidate' for v in p['variants'])\nassert len({v['name'] for v in p['variants']})==len(p['variants'])\nassert len({v['file'] for v in p['variants']})==len(p['variants'])\ntrees=[]\nfor v in p['variants']:\n assert Path(v['file']).name==v['file'] and v['file'].endswith('.py')\n assert v['role'] in ['candidate','control']\n s=Path(v['file']).read_text();compile(s,v['file'],'exec');t=ast.parse(s)\n cfg=next(n for n in t.body if isinstance(n,ast.Assign) and any(isinstance(z,ast.Name) and z.id=='CONFIG' for z in n.targets))\n assert ast.literal_eval(cfg.value)==v['config']\n model=next(n for n in t.body if isinstance(n,ast.ClassDef) and n.name=='Model')\n init=next(n for n in model.body if isinstance(n,ast.FunctionDef) and n.name=='__init__')\n defaults={a.arg:ast.literal_eval(d) for a,d in zip(init.args.args[-len(init.args.defaults):],init.args.defaults)}\n for k,val in v['config'].items():\n  default=defaults[k]\n  if isinstance(default,tuple):default=list(default)\n  assert val==default,(v['name'],k)\n assert v['config']['task_routing']=='private'\n assert hashlib.sha256(s.encode()).hexdigest() in v['note']\n for n in ast.walk(t):\n  if isinstance(n,ast.Import):assert all(a.name.split('.')[0] in {'math','torch'} for a in n.names)\n  if isinstance(n,ast.ImportFrom):assert n.module.split('.')[0] in {'torch','unirank'}\n  if isinstance(n,ast.Call) and isinstance(n.func,ast.Name):assert n.func.id not in {'open','eval','exec','__import__','compile'}\n # Normalized source must differ only in CONFIG and the exchange-source default.\n cfg.value=ast.Constant(value=None)\n ix=[a.arg for a in init.args.args].index('exchange_source')-(len(init.args.args)-len(init.args.defaults))\n init.args.defaults[ix]=ast.Constant(value=None)\n trees.append(t)\nassert ast.dump(trees[0])==ast.dump(trees[1])\n# Reconstruct entry source in memory by reversing exactly the declared changes.\ns=Path('candidate.py').read_text()\nold_doc='''\\\"\\\"\\\"Prospective compatibility study: g0 memory representation plus g3 task readout.\n\nKeep the complete committed memory-joint/collapsed g0 representation, its\nmasking, initialization, and shared history paths. Append the committed g3\nresidual task-content scorer and shared extra-summary projection. Each head\nreceives its shared DIN sum plus C_t + P(M_t). Cross private/mean routing\nwith linear/copy extra basis as active, parameter/operator-matched controls.\nAll added score outputs and P start at zero, preserving the initial g0\nfunction and CPU RNG stream. Host numerical checks and evaluation are pending.\nThis is an integration of two local sources, with no novelty/result claim.\n\\\"\\\"\\\"'''\nend=s.index('\\\"\\\"\\\"',3)+3;s=old_doc+s[end:]\na=ast.parse(s);cfg=next(n for n in a.body if isinstance(n,ast.Assign) and any(isinstance(z,ast.Name) and z.id=='CONFIG' for z in n.targets))\nc=ast.literal_eval(cfg.value);del c['exchange_source'];lines=s.splitlines(keepends=True);lines[cfg.lineno-1:cfg.end_lineno]=['CONFIG = '+repr(c)+'\\\\n'];s=''.join(lines)\nstart=s.index('class TaskSummaryExchange(nn.Module):');end=s.index('class Model(MultiTaskModel):',start);s=s[:start]+s[end:]\ns=s.replace(\\\"                 task_extra_basis='linear', exchange_source='private',\\\\n\\\",\\\"                 task_extra_basis='linear',\\\\n\\\",1)\ns=s.replace(\\\"        if exchange_source not in ('private', 'mean'):\\\\n            raise ValueError('Unknown task-summary exchange source')\\\\n\\\",'',1)\ns=s.replace('''        # Append after every inherited initialization and preserve CPU RNG.\n        with torch.random.fork_rng(devices=[]):\n            self.task_exchange = TaskSummaryExchange(\n                self.value_width, token_dim, num_heads, exchange_source)\n''','',1)\ns=s.replace('''        # The direct tower readouts remain private in BOTH exchange arms.\n        task_pooled = pooled[:, 0:1] + self._task_pool(target, keys, action, values, valid)\n''','''        tokens = self.interaction(tokens, token_valid)\n        task_pooled = pooled[:, 0:1] + self._task_pool(target, keys, action, values, valid)\n''',1)\ns=s.replace('''        tokens = self.task_exchange(tokens, token_valid, task_pooled,\n                                    valid.any(dim=-1))\n        tokens = self.interaction(tokens, token_valid)\n''','',1)\nreceipt=next(t for t in runtime['context']['history'] if t['id']==p['parent_trial'])\nassert hashlib.sha256(s.encode()).hexdigest()==receipt['source_sha256'],('entry reconstruction differs',hashlib.sha256(s.encode()).hexdigest())\n# An exact reconstruction hash covers every inherited helper and init statement.\nfor name,ref in [('baseline_reference.py','f4b473cbacf60d72cff90f3721ad754dd617ee6065fe3fca2fc9cd4be2b25c36'),('history_g0_r0011_memory_joint_collapsed.py','20e3a3378483d39cea5679650a73e3ce829a53f988a52f910bfcd5209c7b1cf0'),('history_g3_r0010_content_plus_linear_private.py','77c0d1afc63e2ffdc4730c0c333eb4b6eeae8260b4b16678535218a6c9074cdf')]:assert hashlib.sha256(Path(name).read_bytes()).hexdigest()==ref\nassert {a['knowledge_id'] for a in p['knowledge_assessments']} >= {'unirank-method-ultrahstu','unirank-method-est','unirank-method-tokenformer','unirank-method-infnet'}\nfor a in p['knowledge_assessments']:\n assert a['decision'] in ['used','considered','rejected','unresolved']\n assert set(a['variant_names']) <= {v['name'] for v in p['variants']}\nprint('PASS strict supplied study schema, protocol/evidence/parent IDs and two-variant structure')\nprint('PASS literal CONFIG/proposal/default agreement, approved imports, source-hash binding')\nprint('PASS normalized variant ASTs differ only in source switch/default')\nprint('PASS exact reversal reproduces committed R12 entry source SHA256 '+receipt['source_sha256'])\nprint('PASS read-only DIN/g0/g3 source hashes unchanged and retrieved-card assessments covered')\nprint('Torch unavailable; no numerical or training checks performed')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
