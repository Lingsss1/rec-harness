3af1ceb6b2be4bf9355b70a9ad356985a3c465ef27238ef7e0f28fb4c\",\n  \"text_ref\": \"source-text://unirank-code:INFNet\",\n  \"text_lines\": 313\n}\n{\n  \"id\": \"unirank-code:INFNet\",\n  \"url\": \"https://github.com/salmon1802/UniRank/blob/90bb99a60724e975ec565836266fd86dcad0039d/model_zoo/INFNet.py\",\n  \"version\": \"git:90bb99a60724e975ec565836266fd86dcad0039d\",\n  \"access_scope\": \"Full pinned benchmark source for inspection; not proof of equivalence to the original author method.\",\n  \"text_sha256\": \"e3750a73af1ceb6b2be4bf9355b70a9ad356985a3c465ef27238ef7e0f28fb4c\",\n  \"total_lines\": 313,\n  \"start_line\": 17,\n  \"next_line\": 82,\n  \"truncated\": false,\n  \"text\": \"17: import torch\\n18: from torch import nn\\n19: from unirank.pytorch.models import MultiTaskModel\\n20: from unirank.pytorch.layers import FeatureEmbedding, MLP_Block, MaskedAveragePooling, ScaledDotProductAttention\\n21: from unirank.utils import not_in_whitelist\\n22: from unirank.pytorch.layers.tokenization import AutoSplitTokenizer, FieldWiseTokenizer\\n23: \\n24: \\n25: class INFNet(MultiTaskModel):\\n26:     def __init__(self,\\n27:                  feature_map,\\n28:                  model_id=\\\"INFNet\\\",\\n29:                  task=[\\\"binary_classification\\\"],\\n30:                  gpu=-1,\\n31:                  tower_activations=\\\"ReLU\\\",\\n32:                  tower_hidden_units=[128, 64],\\n33:                  embedding_dim=10,\\n34:                  num_layers=3,\\n35:                  expansion_factor=4,\\n36:                  num_tasks=4,\\n37:                  token_dim=64,\\n38:                  num_c_hub_token=4,\\n39:                  num_t_hub_token=2,\\n40:                  net_dropout=0,\\n41:                  accumulation_steps=1,\\n42:                  **kwargs):\\n43:         super(INFNet, self).__init__(feature_map,\\n44:                                      model_id=model_id,\\n45:                                      gpu=gpu,\\n46:                                      **kwargs)\\n47:         self.num_tasks = num_tasks\\n48:         self.feature_map = feature_map\\n49:         self.embedding_dim = embedding_dim\\n50:         self.token_dim = token_dim\\n51:         self.num_c_hub_token = num_c_hub_token\\n52:         self.num_t_shared_hub = num_t_hub_token\\n53:         self.num_s_hub_token = num_tasks  # Each behavior type in the paper has a hub. Here, the types are divided by tasks.\\n54:         self.accumulation_steps = accumulation_steps\\n55:         self.num_field = feature_map.get_num_fields()\\n56: \\n57:         # Track item and non-item feature dimensions\\n58:         self.item_info_dim = 0\\n59:         self.non_item_dim = 0\\n60:         for feat, spec in self.feature_map.features.items():\\n61:             if feat in self.feature_map.labels:\\n62:                 continue\\n63:             if spec.get(\\\"type\\\") == \\\"meta\\\":\\n64:                 continue\\n65:             emb_dim = spec.get(\\\"embedding_dim\\\", embedding_dim)\\n66:             if spec.get(\\\"source\\\") in [\\\"item\\\", \\\"action\\\"]:\\n67:                 self.item_info_dim += emb_dim\\n68:             else:\\n69:                 self.non_item_dim += emb_dim\\n70: \\n71:         self.embedding_layer = FeatureEmbedding(feature_map, embedding_dim)\\n72: \\n73:         # 1. Categorical Tokenization\\n74:         self.unified_tokenizer_layer = INFNetCategoricalTokenizer(\\n75:             embedding_dim=embedding_dim,\\n76:             token_dim=token_dim,\\n77:             num_c_hub_token=num_c_hub_token,\\n78:             num_field=self.num_field,\\n79:             expansion_factor=expansion_factor\\n80:         )\\n81: \"\n}\n","exit_code":0,"status":"completed"}}
