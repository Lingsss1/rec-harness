{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport ast,hashlib\nbase=Path('candidate.py').read_text()\nPath('/tmp/research_r12_original.py').write_text(base)\nassert hashlib.sha256(base.encode()).hexdigest()=='32b0c84cf45766aba1ea0196e550baaa63faf798c86863477f4f9484ef36730f'\nend=base.index('\\\"\\\"\\\"',3)+3\nheader='''\\\"\\\"\\\"Prospective task-contrast rank residual study on the committed R12 model.\n\nPreserve all inherited memory, task scoring, shared rank projection and towers.\nAdd four zero-initialized bias-free maps at the final task-history readout:\ncontrast arm maps M_t - mean(M); common control maps mean(M) for every task.\nBoth arms execute the same source construction and batched contraction, own\nthe same parameters, and start at the inherited initial function. This is a\nlocal architectural contrast, with no trained improvement or novelty claim.\nNumerical, masking, gradient and cost checks require the authorized host.\n\\\"\\\"\\\"'''\ncommon=header+base[end:]\nconfig=next(ast.literal_eval(n.value) for n in ast.parse(base).body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets))\nold_config_line=next(line for line in common.splitlines() if line.startswith('CONFIG = '))\ncommon=common.replace(\\\"                 task_extra_basis='linear',\\\\n\\\", \\\"                 task_extra_basis='linear', rank_residual_source='SOURCE_MODE',\\\\n\\\",1)\nneedle=\\\"        self.task_extra_basis = task_extra_basis\\\\n\\\"\nassert common.count(needle)==1\ncommon=common.replace(needle,needle+\\\"        if rank_residual_source not in ('contrast', 'common'):\\\\n            raise ValueError('Rank residual source must be contrast or common')\\\\n        self.rank_residual_source = rank_residual_source\\\\n\\\",1)\nneedle=\\\"        self.model_to_device()\\\\n\\\"\nassert common.count(needle)==1\ncommon=common.replace(needle,\\\"\\\"\\\"        # Appended after every inherited initialization. Zeros consume no RNG;\n        # bias-free maps preserve the exact empty-history zero. The shared P\n        # remains untouched; each head receives only its own bank output.\n        self.task_rank_bank = nn.Parameter(torch.zeros(\n            self.num_tasks, self.value_width, self.value_width))\n\\\"\\\"\\\"+needle,1)\nneedle=\\\"            result = content + self.task_extra_projection(extra)\\\\n\\\"\nassert common.count(needle)==1\ncommon=common.replace(needle,needle+\\\"            result = result + self._rank_residual(extra)\\\\n\\\",1)\nneedle=\\\"    def _feedback_source(self, joint, factorized, total):\\\\n\\\"\nmethod='''    def _rank_residual(self, extra):\n        \\\"\\\"\\\"Map task contrasts or an active task-independent rank summary.\n\n        Input is the existing [B,4,V] signed-rank summary, before projection.\n        Compute both sources in FP32 in both arms; identical contiguous shape\n        prevents a broadcasted contraction from changing the forward operator.\n        Source choice never changes the inherited private content/rank path.\n        Zero banks preserve the parent; initially zero scorer outputs delay\n        bank gradients until those outputs open, just as for the shared P.\n        \\\"\\\"\\\"\n        with torch.autocast(device_type=extra.device.type, enabled=False):\n            extra = extra.float()\n            mean = extra.mean(dim=1, keepdim=True)\n            contrast = (extra - mean).contiguous()\n            common = mean.expand_as(extra).contiguous()\n            source = contrast if self.rank_residual_source == 'contrast' else common\n            return torch.einsum('btv,tvw->btw', source, self.task_rank_bank.float())\n\n'''\nassert common.count(needle)==1\ncommon=common.replace(needle,method+needle,1)\nfor name,mode in [('candidate.py','contrast'),('control_common_rank.py','common')]:\n cfg=dict(config,rank_residual_source=mode)\n text=common.replace('SOURCE_MODE',mode).replace(old_config_line,'CONFIG = '+repr(cfg),1)\n Path(name).write_text(text)\n print(name,'sha256',hashlib.sha256(text.encode()).hexdigest(),'lines',len(text.splitlines()))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
