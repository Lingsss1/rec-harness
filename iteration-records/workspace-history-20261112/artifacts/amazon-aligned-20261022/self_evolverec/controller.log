  "pseudocode": "import math\nimport torch\nfrom torch import nn\nimport torch.nn.functional as F\n\nclass CausalHistoryResidual(nn.Module):\n    def __init__(self, dim, mode='learned', initial_decay=0.9):\n        super().__init__()\n        if mode not in {'learned', 'uniform', 'last', 'fixed'}:\n            raise ValueError(mode)\n        self.mode = mode\n        self.alpha = nn.Parameter(torch.tensor(0.01))\n        self.norm = nn.LayerNorm(dim, elementwise_affine=False)\n        if mode == 'learned':\n            if not 0.0 < initial_decay < 1.0:\n                raise ValueError('Learned retention must initialize inside (0, 1)')\n            self.decay_logit = nn.Parameter(torch.tensor(\n                math.log(initial_decay / (1.0 - initial_decay))))\n        else:\n            decay = {'uniform': 1.0, 'last': 0.0, 'fixed': initial_decay}[mode]\n            if not 0.0 <= decay <= 1.0:\n                raise ValueError('Retention must lie in [0, 1]')\n            self.register_buffer('fixed_decay', torch.tensor(decay))\n\n    def forward(self, features, history_embeddings, sequence):\n        # B x L x D features/embeddings; B x L item IDs.\n        # history_embeddings are scaled backbone embeddings BEFORE positions/dropout.\n        if sequence.shape[1] == 0:\n            return features\n        use_double = (features.dtype == torch.float64 or\n                      history_embeddings.dtype == torch.float64)\n        work_dtype = torch.float64 if use_double else torch.float32\n        x = history_embeddings.to(work_dtype)\n        valid_positions = sequence.ne(0)\n        x = x.masked_fill(~valid_positions.unsqueeze(-1), 0.0)\n        if self.mode == 'learned':\n            decay = self.decay_logit.to(work_dtype).sigmoid()\n        else:\n            decay = self.fixed_decay.to(work_dtype)\n        total = x.new_zeros((x.shape[0], x.shape[2]))\n        mass = x.new_zeros((x.shape[0], 1))\n        summaries = []\n        for t in range(x.shape[1]):\n            valid = valid_positions[:, t:t+1]\n            total = torch.where(valid, decay * total + x[:, t], total)\n            mass = torch.where(valid, decay * mass + 1.0, mass)\n            pooled = total / mass.clamp_min(1.0)\n            summaries.append(torch.where(valid, pooled, torch.zeros_like(pooled)))\n        pooled = torch.stack(summaries, dim=1)\n        # Explicit floating-point computation preserves float64 numerical tests.\n        normalized = F.layer_norm(pooled, self.norm.normalized_shape,\n                                  weight=None, bias=None, eps=self.norm.eps)\n        result = features.to(work_dtype) + self.alpha.to(work_dtype) * normalized\n        result = result.masked_fill(~valid_positions.unsqueeze(-1), 0.0)\n        return result.to(features.dtype)\n\n# Integrate after the original SASRec encoder's final normalization:\n# return self.history_residual(features, scaled_item_embeddings, sequence)\n# Keep the baseline path unchanged when no branch is configured.\n# Supervise every baseline-valid position against its original next-item target.\n# Copy shared backbone weights across variants and reproduce data/negative streams.\n# Generated predictor must instantiate the saved mode/configuration and load all weights.\n# Run reference, gradient, causality, padding, and per-category reload-parity checks.\n# Select the routed four-category system by the unchanged pinned macro HR@10.",
