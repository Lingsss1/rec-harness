        import math
        import re
        import time
        import unicodedata

        token_pattern = re.compile(r"(?u)\b\w\w+\b")
        ids, documents = [], []
        document_frequency, term_frequency = Counter(), Counter()
        for item in sorted(observed):
            if time.monotonic() >= deadline:
                raise TimeoutError
            info = self.meta_data.get(str(item), self.meta_data.get(item, {}))
            info = info if isinstance(info, dict) else {}
            fields = []
            for name in ("title", "description"):
                value = info.get(name, "")
                if isinstance(value, str):
                    fields.append(value)
                elif isinstance(value, list):
                    fields.extend(v for v in value if isinstance(v, str))
            text = unicodedata.normalize("NFKD", " ".join(fields).lower())
            text = "".join(c for c in text if not unicodedata.combining(c))
            counts = Counter(token_pattern.findall(text))
            ids.append(item)
            documents.append(counts)
            document_frequency.update(counts.keys())
            term_frequency.update(counts)

        if not term_frequency:
            return (
                {},
