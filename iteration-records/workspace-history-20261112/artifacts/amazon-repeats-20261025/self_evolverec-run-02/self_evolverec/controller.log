            sorted(term_frequency, key=lambda term: (-term_frequency[term], term))[
                :20000
            ]
        )
        document_count = len(documents)
        inverse_frequency = {
            term: math.log((1.0 + document_count) /
                           (1.0 + document_frequency[term])) + 1.0
            for term in vocabulary
        }
        matrix = []
