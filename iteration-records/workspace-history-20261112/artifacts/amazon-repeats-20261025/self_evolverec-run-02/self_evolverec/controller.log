            if time.monotonic() >= deadline:
                raise TimeoutError
            weights = {
                term: count * inverse_frequency[term]
                for term, count in counts.items()
                if term in vocabulary
            }
            norm = math.sqrt(sum(value * value for value in weights.values()))
            matrix.append(
                {term: value / norm for term, value in weights.items()}
                if norm else {}
            )
        return (
            {item: row for row, item in enumerate(ids)},
            matrix,
            {
                "available": True,
                "vocabulary_size": len(vocabulary),
                "training_observed_items": len(ids),
                "items_with_lexical_vectors": sum(bool(row) for row in matrix),
                "implementation": "stdlib_sparse_smoothed_tfidf",
                "feature_frequency_ties": "ascending lexical order",
            },
        )
