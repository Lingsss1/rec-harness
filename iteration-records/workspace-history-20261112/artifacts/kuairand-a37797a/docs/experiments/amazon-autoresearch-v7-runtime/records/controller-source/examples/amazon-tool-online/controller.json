{
  "adapter": "amazon-nextitnet-v1",
  "study": "/path/to/frozen-source-study",
  "base_model_id": "legacy_incumbent",
  "max_rounds": 1,
  "role_call_limit": 6,
  "diagnostic_budget": 2,
  "rescore_recipe": {
    "runtime_dirs": [
      "/path/to/runtime"
    ],
    "runtime_files": [
      "/path/to/python3"
    ]
  },
  "uid_registry": "/path/to/rescore-uids",
  "agent_backend": {
    "kind": "jailed_codex",
    "model": "REPLACE_WITH_CONFIGURED_MODEL",
    "template": "/path/to/prepared-codex-jail",
    "runtime_root": "/path/to/private-codex-runtime"
  }
}
