{
  "task_id": "toy-preference-interaction",
  "source": ".",
  "model_files": ["model.py"],
  "evaluator_files": ["evaluate.py"],
  "budget": 24,
  "max_rounds": 1,
  "codex": {"executable": "codex", "timeout": 180},
  "protocol": {
    "data_version": "generated-preferences-v1",
    "split": "independent-public-train-and-validation",
    "seeds": [11, 29],
    "metric": "quality",
    "direction": "maximize",
    "minimum_effect": 0.02,
    "guardrails": {"parameters": 16},
    "check_command": ["{python}", "{evaluator}/evaluate.py", "--model", "{model}", "--output", "{output}", "--seed", "{seed}", "--check"],
    "evaluate_command": ["{python}", "{evaluator}/evaluate.py", "--model", "{model}", "--output", "{output}", "--seed", "{seed}"],
    "timeout_seconds": 30,
    "evaluation_cost": 1,
    "agent_cost": 1
  }
}
