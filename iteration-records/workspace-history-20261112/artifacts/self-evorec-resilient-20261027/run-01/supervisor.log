  "pseudocode": "declare_training_checkpoint_protocol_grid_controls_ties_and_budget()\nfor category in FOUR_DATASETS:\n    model = unchanged_per_dataset_SASRec(training_seed=42)\n    train_with_original_protocol(preprocessing_seed=0, default_epochs=200)\n    freeze_baseline_selected_checkpoint_using_only_pinned_validation()\n    counts, row_totals = adjacent_counts(training_histories_only)\n    for window in [1, 5]:\n        prefixes, candidates = fixed_training_calibration_sample(seed=42)\n        neural, transition = score_same_candidates_in_eval_mode(\n            prefixes, candidates, window, decay=0.5, tau=10)\n        scales[window] = pooled_within_query_centered_RMS(neural, transition)\n    save_under_trial(model, counts, row_totals, scales, complete_config)\n\n# Exact sparse correction; j=0 denotes newest retained source.\ndef transition_score(prefix, candidates, window, counts, N):\n    sources = newest_first(prefix)[0:window]\n    if not sources:\n        return zeros_like_candidates(candidates)\n    weights = normalize([0.5**j for j in range(len(sources))])\n    return sum(w * log1p(N * counts.lookup(source, candidates) / 10.0)\n               for w, source in zip(weights, sources))\n\nfor configuration in predeclared_grid_and_controls:\n    for category in FOUR_DATASETS:\n        # Generated predictor supplies scores; host owns evaluation/candidates.\n        neural = frozen_model.score(prefix, candidates)\n        transition = transition_score(prefix, candidates, configuration.window,\n                                      counts, nonpadding_catalog_size)\n        if scales_invalid_or_zero:\n            fused = neural  # Record explicit reason; nonfinite scales trigger diagnosis.\n        else:\n            fused = neural + alpha * frozen_scale_ratio * transition\n        supply_configured_scores_to_existing_host_protocol()\n    record_host_macro_HR10_category_results_and_cost()\nselect_shared_configuration_with_declared_tie_breaks()\nwrite_predictor_with_exact_category_artifacts_and_scoring()\nverify_baseline_parity_sparse_formula_and_candidate_chunk_invariance()\nrun_compatible_measured_diagnostics_with_occurrence_aware_count_subtraction()\nretain_native_twenty_training_user_full_catalog_unseen_recommendations()\nif_existing_evaluator_exposes_paired_hits_then_report_conditional_paired_bootstrap()\nfreeze_configuration_before_independent_held_out_evaluation()\n# Enforce aggregate charged GPU-second budget throughout; never access test labels.",
