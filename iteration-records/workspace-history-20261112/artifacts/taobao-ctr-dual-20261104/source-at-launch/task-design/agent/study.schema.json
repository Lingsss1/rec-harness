{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task-independent prospective mechanism study",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "protocol_ref", "evidence_refs", "question", "hypothesis", "nearest_work", "inherited_components", "proposed_difference", "predictions", "falsifiers", "alternative_explanations", "contrasts", "cost_plan"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "protocol_ref": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "question": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "nearest_work": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_ref", "verification", "difference"],
        "properties": {
          "source_ref": {"type": "string"},
          "verification": {"enum": ["discovered", "read", "archived", "implementation_checked"]},
          "difference": {"type": "string", "minLength": 1}
        }
      }
    },
    "inherited_components": {"type": "array", "items": {"type": "string"}},
    "proposed_difference": {"type": "string", "minLength": 1},
    "predictions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "falsifiers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "alternative_explanations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "contrasts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parent_ref", "intervention", "control", "held_fixed", "remaining_confounds", "decision_if_supported", "decision_if_not_supported"],
        "properties": {
          "parent_ref": {"type": "string"},
          "intervention": {"type": "string"},
          "control": {"type": "string"},
          "held_fixed": {"type": "array", "items": {"type": "string"}},
          "remaining_confounds": {"type": "array", "items": {"type": "string"}},
          "decision_if_supported": {"type": "string"},
          "decision_if_not_supported": {"type": "string"}
        }
      }
    },
    "cost_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimate_ref", "all_variants_counted", "attribution_reserve", "assessment_reserve", "stop_rule"],
      "properties": {
        "estimate_ref": {"type": "string"},
        "all_variants_counted": {"const": true},
        "attribution_reserve": {"type": "string"},
        "assessment_reserve": {"type": "string"},
        "stop_rule": {"type": "string"}
      }
    }
  }
}
