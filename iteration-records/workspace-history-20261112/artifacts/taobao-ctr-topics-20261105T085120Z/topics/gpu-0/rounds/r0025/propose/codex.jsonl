nsition = self.transition_head(self._transition_features(tables)).squeeze(-1)\n1386:         exchangeable = parent + transition\n1387:         alternatives = self._compact_alternatives(batch, semantic)\n1388:         selected = self._compact_select(alternatives)\n1389:         compact = self._compact_readout(selected, context)[0]\n1390:         return exchangeable + compact, exchangeable, compact, context, alternatives, parent_features\n1391: \n1392:     def _histogram_forward(self, batch):\n1393:         return self._combined_parts(batch)[0]\n1394: \n\nLINES 1555 1631\n1555:     def _fusion_select(self, alternatives, mode=None):\n1556:         mode = self.fusion_mode if mode is None else mode\n1557:         return alternatives[{'continuous': 0, 'coarsened': 1,\n1558:                              'histogram': 2, 'zero': 3}[mode]]\n1559: \n1560:     def _fusion_readout(self, inputs, context):\n1561:         preactivation = (self.fusion_correction[0](inputs[:, :32]) +\n1562:                          self.fusion_moment_projection(inputs[:, 32:48]) +\n1563:                          self.fusion_extreme_projection(inputs[:, 48:64]))\n1564:         hidden = self.fusion_correction[1](preactivation)\n1565:         raw = self.fusion_context_projection(context)\n1566:         scale = (raw.square().mean(-1, keepdim=True) + 1e-6).sqrt()\n1567:         modulation = torch.tanh(raw / scale)\n1568:         mixed = hidden * (1.0 + modulation)\n1569:         return self.fusion_correction[2](mixed).squeeze(-1), hidden, modulation\n1570: \n1571:     def _previous_fusion_parts(self, batch):\n1572:         # Exactly one embedding/table pass through the incumbent. All four\n1573:         # alternatives were already computed by the first compact head.\n1574:         prior = self._combined_parts(batch)\n1575:         context, alternatives = prior[3], prior[4]\n1576:         inputs = self._fusion_select(alternatives)\n1577:         added, hidden, modulation = self._fusion_readout(inputs, context)\n1578:         return prior[0] + added, prior, added, hidden, modulation\n1579: \n1580:     def _conditional_forward(self, batch):\n1581:         return self._fusion_parts(batch)[0]\n1582: \n1583:     def _innovation_alternatives(self, batch):\n1584:         \"\"\"All four 64-cell maps on identical valid-event support.\n1585: \n1586:         Each cell is target-match group x action x frozen coarse age bin.\n1587:         The signed coordinate removes a FIXED midpoint count component;\n1588:         it is not fitted orthogonalization or independence from the counts.\n1589:         All alternatives execute for every mode, including the zero control.\n1590:         \"\"\"\n1591:         mask = batch['history_mask']\n1592:         _, semantic, _ = self._membership(batch)\n1593:         age = torch.where(mask, batch['history_age_seconds'],\n1594:                           torch.zeros_like(batch['history_age_seconds'])).clamp_min(0.0)\n1595:         age_bin = ((age >= 3600.0).long() + (age >= 86400.0).long() +\n1596:                    (age >= 604800.0).long())\n1597:         lower = age.new_tensor([0.0, 3600.0, 86400.0, 604800.0])[age_bin]\n1598:         # Fourth upper endpoint is a finite placeholder, discarded by where.\n1599:         upper = age.new_tensor([3600.0, 86400.0, 604800.0, 1209600.0])[age_bin]\n1600:         log_fraction = ((torch.log1p(age) - torch.log1p(lower)) /\n1601:                         (torch.log1p(upper) - torch.log1p(lower)))\n1602:         tail_fraction = (age - 604800.0).clamp_min(0.0) / age.clamp_min(604800.0)\n1603:         fraction = torch.where(age_bin == 3, tail_fraction, log_fraction).clamp(0.0, 1.0)\n1604:         action = (batch['history_type'] - 1).clamp(0, 3)\n1605:         cell = (4 * action + age_bin)[:, None, :].expand(-1, 4, -1)\n1606:         counts = semantic.new_zeros((mask.shape[0], 4, 16)).scatter_add(\n1607:             2, cell, semantic)\n1608:         sums = torch.zeros_like(counts).scatter_add(\n1609:             2,