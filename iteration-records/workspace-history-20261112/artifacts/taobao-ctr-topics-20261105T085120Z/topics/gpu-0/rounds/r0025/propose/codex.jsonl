{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/check_merge_semantics.py <<'PY'\nimport collections,itertools,json,math,random,struct\nrng=random.Random(20261106)\nscale=math.log(129)\ndef f32(x):return struct.unpack('f',struct.pack('f',x))[0]\ndef valid_events(events,target):\n out=[]\n for c,b,a,t,m in events:\n  if not m:continue\n  g=int(c>0 and target[0]>0 and c==target[0])+2*int(b>0 and target[1]>0 and b==target[1])\n  bin=sum(t>=v for v in (3600,86400,604800))\n  lo=[0,3600,86400,604800][bin]\n  hi=[3600,86400,604800,1209600][bin]\n  frac=((math.log1p(t)-math.log1p(lo))/(math.log1p(hi)-math.log1p(lo)) if bin<3 else (t-604800)/max(t,604800))\n  out.append((c,b,a,t,g,bin,min(1,max(0,frac))))\n return out\ndef production_analogue(events,target):\n ev=valid_events(events,target);counts=[0]*64;sums=[0.]*64\n for c,b,a,t,g,k,f in ev:\n  j=16*g+4*(a-1)+k;counts[j]+=1;sums[j]+=f\n means=[s/max(n,1) for s,n in zip(sums,counts)]\n v=[0.]*64;t3=[0.]*64\n for c,b,a,t,g,k,f in ev:\n  j=16*g+4*(a-1)+k;d=f-means[j];v[j]+=d*d;t3[j]+=d*d*d\n v=[s/max(n,1) if n>1 else 0 for s,n in zip(v,counts)]\n t3=[s/max(n,1) if n>2 else 0 for s,n in zip(t3,counts)]\n bm=[sum(sums[k::4])/max(sum(counts[k::4]),1) for k in range(4)]\n h=[math.log1p(n)/scale for n in counts]\n return tuple(h),tuple(2*h[j]*(means[j]-bm[j%4]) for j in range(64)),tuple(4*h[j]*v[j] for j in range(64)),tuple(abs(6*math.sqrt(3)*h[j]*t3[j]) for j in range(64))\ndef direct_oracle(events,target):\n ev=valid_events(events,target);cells=[]\n for g,a,k in itertools.product(range(4),range(1,5),range(4)):\n  cells.append([e[6] for e in ev if e[4:6]==(g,k) and e[2]==a])\n out=[[] for _ in range(4)]\n for j,x in enumerate(cells):\n  n=len(x);mu=sum(x)/max(n,1);binx=[f for i,y in enumerate(cells) if i%4==j%4 for f in y];bm=sum(binx)/max(len(binx),1)\n  # Independent pairwise variance and raw-moment third identity.\n  var=sum((a-b)**2 for a in x for b in x)/(2*n*n) if n>1 else 0\n  third=sum(a**3 for a in x)/n-3*mu*sum(a*a for a in x)/n+2*mu**3 if n>2 else 0\n  h=math.log1p(n)/scale\n  for dest,val in zip(out,(h,2*h*(mu-bm),4*h*var,abs(6*math.sqrt(3)*h*third))):dest.append(val)\n return tuple(tuple(x) for x in out)\ndef support(events,target):\n ev=valid_events(events,target);counts=collections.Counter(e[3] for e in ev if e[0]>0 and e[1]>0)\n return [e for e in ev if e[0]>0 and e[1]>0 and counts[e[3]]==1]\ndef gap(t):return sum(t>x for x in (60,3600,86400))\ndef timing_sparse(events,target):\n ev=sorted(support(events,target),key=lambda e:-e[3]);h=[0]*16\n for x,y in zip(ev,ev[1:]):h[4*gap(x[3]-y[3])+y[5]]+=1\n return h\ndef timing_oracle(events,target):\n ev=support(events,target);h=[0]*16\n rank=[sum(y[3]>x[3] for y in ev) for x in ev]\n for i,x in enumerate(ev):\n  for j,y in enumerate(ev):\n   if rank[j]==rank[i]+1:h[4*gap(x[3]-y[3])+y[5]]+=1\n return h\ndef ex_grouped(events,target):\n ev=support(events,target);n=len(ev);maps=[]\n for mode in range(4):\n  groups=collections.defaultdict(collections.Counter)\n  for c,b,a,t,g,k,f in ev:groups[0 if mode==0 else c if mode==1 else b if mode==2 else (c,b)][4*g+a-1]+=1\n  raw=[0.]*256\n  for cell_counts in groups.values():\n   for i,ni in cell_counts.items():\n    for j,nj in cell_counts.items():raw[16*i+j]+=(ni*nj-(ni if i==j else 0))/max(n,1)\n  maps+=raw\n return maps\ndef ex_pairs(events,target):\n ev=support(events,target);n=len(ev);raw=[0.]*1024\n for i,x in enumerate(ev):\n  for j,y in enumerate(ev):\n   if i==j:continue\n   p=16*(4*x[4]+x[2]-1)+(4*y[4]+y[2]-1)\n   for mode,ok in enumerate((True,x[0]==y[0],x[1]==y[1],x[:2]==y[:2])):\n    if ok:raw[256*mode+p]+=1/max(n,1)\n return raw\ndef delta(a,b):return max((abs(x-y) for xx,yy in zip(a,b) for x,y in zip(xx,yy)),default=0)\nworst=0.;exworst=0.;cases=0\nboundaries=[0.,1.,60.,61.,3599.,3600.,3601.,86399.,86400.,86401.,604799.,604800.,604801.,1e8]\nfor trial in range(450):\n length=trial if trial<=128 else rng.randrange(129);target=(rng.randrange(5),rng.randrange(5));events=[]\n for i in range(length):\n  t=rng.choice(boundaries) if rng.random()<.4 else f32(10**rng.uniform(0,8))\n  events.append((rng.randrange(5),rng.randrange(5),rng.randrange(1,5),t,rng.random()>.2))\n maps=production_analogue(events,target);oracle=direct_oracle(events,target);err=delta(maps,oracle);worst=max(worst,err);assert err<1e-11\n assert timing_sparse(events,target)==timing_oracle(events,target)\n ee=max((abs(a-b) for a,b in zip(ex_grouped(events,target),ex_pairs(events,target))),default=0);exworst=max(exworst,ee);assert ee<1e-10\n reverse=list(reversed(events));assert delta(maps,production_analogue(reverse,target))<1e-12\n padding=events+[(9999,9999,4,float('nan'),False)]*3\n assert maps==production_analogue(padding,target)\n assert timing_sparse(events,target)==timing_sparse(padding,target)\n assert sum(maps[0][j]>0 for j in range(64))<=sum(e[4] for e in events)\n assert all(abs(v)<=h+1e-12 for h,v in zip(maps[0],maps[3]))\n if length==0:assert all(v==0 for row in maps for v in row)\n cases+=1\nwa=[(1,1,a,t,True) for a,t in zip([1,1,2,2],[40000.,45000.,50000.,55000.])];wb=list(wa);wb[0]=(1,1,1,41000.,True)\nma,mb=production_analogue(wa,(1,1)),production_analogue(wb,(1,1))\nassert ma[0]==mb[0]\nassert timing_sparse(wa,(1,1))==timing_sparse(wb,(1,1))\nassert ex_grouped(wa,(1,1))==ex_grouped(wb,(1,1))\nassert [int(math.log2(e[3]+1))+1 for e in wa]==[int(math.log2(e[3]+1))+1 for e in wb]\ngaps=[max(abs(x-y) for x,y in zip(a,b)) for a,b in zip(ma,mb)]\nassert gaps[1]>0 and gaps[2]>0\nresult={'cases':cases,'seed':20261106,'compact_raw_moment_oracle_max_error':worst,'exchangeable_pair_oracle_max_error':exworst,'timing_counts_exact':True,'reversal_padding_empty_checks':True,'witness_histogram_mean_variance_magnitude_gaps':gaps,'witness_timing_exchangeable_log2_inputs_equal':True,'torch_execution':False,'scope':'Separate standard-library scalar analogues on synthetic histories; not production tensor execution, backw