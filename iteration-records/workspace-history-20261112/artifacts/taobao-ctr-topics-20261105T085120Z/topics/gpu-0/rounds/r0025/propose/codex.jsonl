172: \n173:     def _match_counts(self, batch):\n\nLINES 428 486\n428:     def _shared_features(self, batch, scope=None, layout=None, direction=None):\n429:         scope = self.field_scope if scope is None else scope\n430:         layout = self.field_layout if layout is None else layout\n431:         direction = self.global_direction if direction is None else direction\n432:         fields = [embedding(batch['static'][:, i])\n433:                   for i, embedding in enumerate(self.embeddings)]\n434:         static = torch.cat(fields, dim=-1)\n435:         _, semantic, sizes = self._membership(batch)\n436:         mask = batch['history_mask']\n437:         dim = self.config['embedding_dim']\n438:         if mask.shape[1] == 0:\n439:             pools = static.new_zeros((static.shape[0], 4, dim))\n440:             moments = torch.zeros_like(pools)\n441:             means = static.new_zeros((static.shape[0], 4 if scope == 'rank' else 1, 4, dim))\n442:         else:\n443:             ages = (torch.log2(batch['history_age_seconds'] + 1).long() + 1).clamp(0, 32)\n444:             # Each history field is embedded exactly once in forward. Static\n445:             # target embeddings are separate lookup consumers, as in ancestor.\n446:             cv = self.embeddings[self.category](batch['history_category'])\n447:             bv = self.embeddings[self.brand](batch['history_brand'])\n448:             av = self.action(batch['history_type'])\n449:             rv = self.recency(ages)\n450:             history = cv + bv + av + rv\n451:             denominator = sizes.clamp_min(1).unsqueeze(-1)\n452:             pools = torch.bmm(semantic, history) / denominator\n453:             # Keep the parent's operation ordering for both marginal means.\n454:             content_mean = torch.bmm(semantic, cv + bv) / denominator\n455:             context_mean = torch.bmm(semantic, av + rv) / denominator\n456:             moments = 0.5 * (content_mean * context_mean)\n457:             values = torch.cat([cv, bv, av, rv], dim=-1)\n458:             if scope == 'rank':\n459:                 rank = mask.long().cumsum(-1) - 1\n460:                 upper = sizes.long().cumsum(-1)\n461:                 lower = upper - sizes.long()\n462:                 membership = ((rank[:, None, :] >= lower[:, :, None]) &\n463:                               (rank[:, None, :] < upper[:, :, None]) &\n464:                               mask[:, None, :]).float()\n465:                 field_means = torch.bmm(membership, values) / denominator\n466:                 means = field_means.reshape(static.shape[0], 4, 4, dim)\n467:             else:\n468:                 membership = mask[:, None, :].float()\n469:                 denominator = mask.float().sum(-1).clamp_min(1)[:, None, None]\n470:                 field_means = torch.bmm(membership, values) / denominator\n471:                 means = field_means.reshape(static.shape[0], 1, 4, dim)\n472:         counts = self._match_counts(batch)\n473:         statistics = self._statistics(counts)\n474:         histogram = self._histogram(batch, semantic, sizes)[0]\n475:         full, collapsed = self._contrast_blocks(means)\n476:         selected = full if direction == 'contrast' else collapsed\n477:         if scope == 'global' and layout == 'wide':\n478:             # Isometry R^48 -> R^192: four copies scaled by 1/sqrt(4).\n479:             # All columns are used, but effective input rank remains <=48.\n480:             extra = selected.expand(-1, 4, -1, -1) * 0.5\n481:         else:\n482:             extra = selected\n483:         features = torch.cat([static, pools.flatten(1), statistics, histogram,\n484:                               moments.flatten(1), extra.flatten(1)], dim=-1)\n485:         return features, extra, means, full, collapsed, semantic, sizes\n486: \n\nLINES 1060 1075\n1060: \n1061:     def _transition_features(self, tables, order_mode=None, pairing=None):\n1062:         order_mode = self.transition_order if order_mode is None else order_mode\n1063:         pairing = self.transition_pairing if pairing is None else pairing\n1064:         observed = tables[0] if order_mode == 'chronological' else tables[1]\n1065:         replacement = tables[2] if order_mode == 'chronological' else tables[3]\n1066:         last = observed[3] if pairing == 'observed' else replacement\n1067:         counts = torch.stack([observed[0], observed[1], observed[2], last], dim=1)\n1068:         return torch.log1p(counts.flatten(1)) / math.log(129.0)\n1069: \n1070:     def forward(self, batch):\n1071:         parent = self._parent_forward(batch)\n1072:         tables = self._transition_tables(batch)\n1073:         residual = self.transition_head(self._transition_features(tables)).squeeze(-1)\n1074:         return parent + residual\n1075: \n\nLINES 1831 1933\n1831: class _CompactGapHead(nn.Module):\n1832:     \"\"\"Remove duplicate columns; preserve initialization and expose Adam control.\n1833: \n1834:     x_j is repeated r=256 times as x_j/16 in the old head. Write\n1835:     U_hj=mean_i W_hji, so its effective weight is A=16U. Every old W_hji\n1836:     receives the same gradient g*x_j/16. For elementwise Adam with zero\n1837:     initial state, no weight decay, no parameter-dependent clipping, and\n1838:     exact arithmetic, all duplicate W columns have identical updates.\n1839:     Their mean U therefore follows Adam on that SAME gradient. Calibrated\n1840:     mode stores U, uses A=16U, and scales its derivative to 1/16. This also\n1841:     preserves Adam's epsilon effect. Native mode stores A and uses ordinary\n1842:     gradients: its effective Adam step is about 16 times smaller. These are\n1843:     explicit parameterization controls; neither adds an input statistic.\n1844:     Float reductions/kernel choices can still change a full training path.\n1845:     \"\"\"\n1846:     def __init__(self, lifted, mode):\n1847:         super().__init__()\n1848:         self.mode = mode\n1849:         mean = lifted[0].weight.detach().reshape(16, 4, 4, 256).mean(-1).reshape(16, 16)\n1850:         self.weight = nn.Parameter(mean.clone() if mode == 'calibrated' else (16.0 * mean).clone())\n1851:         # Reuse the exact allocated zero-initialized last layer, with no new RNG.\n1852:         self.last = lifted[2]\n1853: \n1854:     def effective_weight(self):\n1855:         return 16.0 * self.weight if self.mode == 'calibrated' else self.weight\n1856: \n1857:     def forward(self, compact):\n1858:         if self.mode == 'calibrated':\n1859:             # Value =16U; derivative =1/16. This reparameterizes only the\n1860:             # first gap layer. Host Adam/loss/lr and every other gradient stay fixed.\n1861:             detached = self.weight.detach()\n1862:             weight = 16.0 * (detached + (self.weight - detached) / 256.0)\n1863:         else:\n1864:             weight = self.weight\n1865:         hidden = torch.relu(torch.nn.functional.linear(compact, weight))\n1866:         return self.last(hidden)\n1867: \n1868: \n1869: class _GapTimingParentModel(_LiftedParentModel):\n1870:     \"\"\"Actual pooled execution plus controlled removal of a redundant lift.\n1871: \n1872:     The entire pre-gap model is inherited, including its expensive tables.\n1873:     Only the final gap branch is optimized. Dense diagnostics are excluded\n1874:     from forward and cannot supply labels, events, or additional inputs.\n1875:     \"\"\"\n1876:     def __init__(self, meta, config=None):\n1877:         super().__init__(meta, config)\n1878:         self.gap_execution = self.config.get('gap_execution', 'direct')\n1879:         self.gap_parameterization = self.config.get('gap_parameterization', 'calibrated')\n1880:         if self.gap_execution not in ('dense', 'direct'):\n1881:             raise ValueError('Unknown gap_execution')\n1882:         if self.gap_parameterization not in ('lifted', 'calibrated', 'native'):\n1883:             raise ValueError('Unknown gap_parameterization')\n1884:         if (self.product_scope, self.gap_association) != ('pooled', 'observed'):\n1885:             raise ValueError('Fix the pooled/observed incumbent information')\n1886:         if self.gap_execution == 'dense' and self.gap_parameterization != 'lifted':\n1887:             raise ValueError('The dense arm is the exact lifted reference')\n1888:         # Parent allocation consumes all original seeded draws first. Replacing\n1889:         # the module deregisters the redundant matrix; it is not kept in a buffer.\n1890:         if self.gap_parameterization != 'lifted':\n1891:             self.gap_head = _CompactGapHead(self.gap_head, self.gap_parameterization)\n1892: \n1893:     def _direct_gap_counts(self, batch):\n1894:         \"\"\"Compute pooled N,C,B histograms directly, then their pooled product.\n1895: \n1896:         Exact same complete-pair/singleton support and adjacent subsequence as\n1897:         the ancestor. Target match and action partitions disappear only in\n1898:         this branch because sum_e raw[k,g,e] ignores them. Never compute a\n1899:         product before pooling. Storage O(BL+B*16), independent of context cells.\n1900:         \"\"\"\n1901:         eligible, order, _, _ = self._transition_support(batch)\n1902:         c, b = batch['history_category'], batch['history_brand']\n1903:         age = batch['history_age_seconds']\n1904:         batch_size, length = c.shape\n1905:         if length < 2:\n1906:             return age.new_zeros((batch_size, 4, 4, 1))\n1907:         valid = eligible.gather(1, order)\n1908:         ordered_c, ordered_b = c.gather(1, order), b.gather(1, order)\n1909:         ordered_age = age.gather(1, order)\n1910:         edge = valid[:, :-1] & valid[:, 1:]\n1911:         gap = self._gap_bin(ordered_age[:, :-1] - ordered_age[:, 1:])\n1912:         same_c = ordered_c[:, :-1] == ordered_c[:, 1:]\n1913:         same_b = ordered_b[:, :-1] == ordered_b[:, 1:]\n1914:         common = []\n1915:         for match in (torch.ones_like(edge), same_c, same_b):\n1916:             common.append(age.new_zeros((batch_size, 4)).scatter_add(\n1917:                 1, gap, (edge & match).float()))\n1918:         total, category, brand = common\n1919:         product = category * brand / self._positive_denominator(total)\n1920:         return torch.stack([total, category, brand, product], dim=1).unsqueeze(-1)\n1921: \n1922:     def _selected_gap_features(self, batch):\n1923:         if self.gap_execution == 'dense':\n1924:             return _LiftedParentModel._gap_features(self, self._gap_tables(batch))\n1925:         counts = self._direct_gap_counts(batch)\n1926:         if self.gap_parameterization == 'lifted':\n1927:             return self._gap_lift(counts)\n1928:         return (torch.log1p(counts) / math.log(129.0)).flatten(1)\n1929: \n1930:     def forward(self, batch):\n1931:         parent = _ParentModel.forward(self, batch)\n1932:         return parent + self.gap_head(self._selected_gap_features(batch)).squeeze(-1)\n1933: \n\nLINES 2005 2078\n2005: class Model(_GapTimingParentModel):\n2006:     \"\"\"Gap/endpoint-recency association, with identical-execution replacements.\n2007: \n2008:     The whole incumbent is preserved. Only this final class is new. H[g,a]\n2009:     counts supported adjacent edges by elapsed gap g and newer endpoint age a.\n2010:     Absolute age is relative to the impression, never wall-clock time.\n2011:     No extra events, labels, target fields or learned identities enter H.\n2012:     \"\"\"\n2013:     def __init__(self, meta, config=None):\n2014:         super().__init__(meta, config)\n2015:         if (self.gap_execution, self.gap_parameterization) != ('direct', 'lifted'):\n2016:             raise ValueError('Fix exact direct/lifted incumbent')\n2017:         self.timing_mode = self.config.get('timing_mode', 'joint')\n2018:         if self.timing_mode not in ('joint', 'marginal', 'gap_only', 'zero'):\n2019:             raise ValueError('Unknown timing_mode')\n2020:         # Allocate strictly after every incumbent parameter and RNG draw.\n2021:         # Bias-free zero-input cell stays identically zero at any checkpoint.\n2022:         self.timing_head = nn.Sequential(\n2023:             nn.Linear(16, 16, bias=False), nn.ReLU(),\n2024:             nn.Linear(16, 1, bias=False))\n2025:         nn.init.zeros_(self.timing_head[-1].weight)\n2026: \n2027:     @staticmethod\n2028:     def _endpoint_age_bin(age):\n2029:         # Reuse pre-existing event-histogram thresholds, including equality.\n2030:         return ((age >= 3600.0).long() + (age >= 86400.0).long() +\n2031:                 (age >= 604800.0).long())\n2032: \n2033:     def _timing_counts(self, batch):\n2034:         \"\"\"O(BL+B*16) storage; exact inherited singleton timestamp support.\n2035: \n2036:         Filtering can bridge missing/tied events. This is adjacency on the\n2037:         supported subsequence, not an assertion of adjacency in raw logs.\n2038:         \"\"\"\n2039:         age = batch['history_age_seconds']\n2040:         batch_size, length = age.shape\n2041:         if length < 2:\n2042:             return age.new_zeros((batch_size, 4, 4))\n2043:         eligible, order, _, _ = self._transition_support(batch)\n2044:         valid = eligible.gather(1, order)\n2045:         ordered_age = age.gather(1, order)\n2046:         edge = valid[:, :-1] & valid[:, 1:]\n2047:         gap = self._gap_bin(ordered_age[:, :-1] - ordered_age[:, 1:])\n2048:         recency = self._endpoint_age_bin(ordered_age[:, 1:])\n2049:         # First coordinate gap, second coordinate endpoint recency.\n2050:         cell = 4 * gap + recency\n2051:         counts = age.new_zeros((batch_size, 16)).scatter_add(\n2052:             1, cell, edge.float())\n2053:         return counts.reshape(batch_size, 4, 4)\n2054: \n2055:     def _timing_tables(self, counts):\n2056:         row = counts.sum(-1, keepdim=True)\n2057:         column = counts.sum(-2, keepdim=True)\n2058:         total = row.sum(-2, keepdim=True)\n2059:         # Each impression is replaced independently, without fitted statistics.\n2060:         # Preserve RAW margins; this is not a population-independence claim\n2061:         # and need not be a realizable event sequence.\n2062:         marginal = row * column / self._positive_denominator(total)\n2063:         gap_only = row.expand_as(counts) / 4.0\n2064:         return {'joint': counts, 'marginal': marginal,\n2065:                 'gap_only': gap_only, 'zero': torch.zeros_like(counts)}\n2066: \n2067:     def _timing_views(self, counts):\n2068:         # Every registered variant executes all replacements and transforms.\n2069:         # Norms/post-log margins need not match: stated interpretation limit.\n2070:         return {key: (torch.log1p(value) / math.log(129.0)).flatten(1)\n2071:                 for key, value in self._timing_tables(counts).items()}\n2072: \n2073:     def forward(self, batch):\n2074:         parent = _GapTimingParentModel.forward(self, batch)\n2075:         counts = self._timing_counts(batch)\n2076:         feature = self._timing_views(counts)[self.timing_mode]\n2077:         return parent + self.timing_head(feature).squeeze(-1)\n2078: \n{\n  \"id\": \"paper:din\",\n  \"url\": \"https://arxiv.org/abs/1706.06978v4\",\n  \"version\": \"content-sha256:5fee25f33f375e51b3ee9417d376ff9dbe2ea3628c932a7679ddfeb0feaaade2\",\n  \"access_scope\": \"archived exact-version primary text; caching does not establish a local mechanism result\",\n  \"text_sha256\": \"83fb9eeca31e2fa3c557b6f08b893ad0018cefb33da6e00952136b9ce17e607e\",\n  \"total_lines\": 831,\n  \"start_line\": 29,\n  \"next_line\": 74,\n  \"truncated\": false,\n  \"text\": \"29: 5 Training Techniques\\n30: 5.1 Mini-batch Aware Regularization\\n31: 5.2 Data Adaptive Activation Function\\n32: 6 Experiments\\n33: 6.1 Datasets and Experimental Setup\\n34: 6.2 Competitors\\n35: 6.3 Metrics\\n36: 6.4 Result from model comparison on Amazon Dataset and MovieLens Dataset\\n37: 6.5 Performance of regularization\\n38: 6.6 Result from model comparison on Alibaba Dataset\\n39: 6.7 Result from online A/B testing\\n40: 6.8 Visualization of DIN\\n41: 7 Conclusions\\n42: References\\n43: License: arXiv.org perpetual non-exclusive license\\n44: arXiv:1706.06978v4 [stat.ML] 13 Sep 2018\\n45: Deep Interest Network for Click-Through Rate Prediction\\n46: Conference: KDD’18; ; August 19–23, 2018, London, United Kingdom.CCS: Information systems Display advertisingCCS: Information systems Recommender systems\\n47: Guorui Zhou, Chengru Song, Xiaoqiang Zhu\\n48: Ying Fan, Han Zhu, Xiao Ma, Yanghui Yan, Junqi Jin, Han Li, Kun Gai\\n49: Affiliation: Alibaba Group\\n50: email: guorui.xgr, chengru.scr, xiaoqiang.zxq, zhuhan.zh, fanying.fy, maxiao.ma, yanghui.yyh, junqi.jjq, lihan.hl,jingshi.gk@alibaba-inc.com\\n51: © acmcopyright\\n52: Abstract.\\n53: Click-through rate prediction is an essential task in industrial applications, such as online advertising.\\n54: Recently deep learning based models have been proposed, which follow a similar Embedding&MLP paradigm.\\n55: In these methods large scale sparse input features are first mapped into low dimensional embedding vectors, and then transformed into fixed-length vectors in a group-wise manner, finally concatenated together to fed into a multilayer perceptron (MLP) to learn the nonlinear relations among features.\\n56: In this way, user features are compressed into a fixed-length representation vector, in regardless of what candidate ads are.\\n57: The use of fixed-length vector will be a bottleneck, which brings difficulty for Embedding&MLP methods to capture user’s diverse interests effectively from rich historical behaviors.\\n58: In this paper, we propose a novel model: Deep Interest Network (DIN) which tackles this challenge by designing a local activation unit to adaptively learn the representation of user interests from historical behaviors with respect to a certain ad.\\n59: This representation vector varies over different ads, improving the expressive ability of model greatly.\\n60: Besides, we develop two techniques: mini-batch aware regularization and data adaptive activation function which can help training industrial deep networks with hundreds of millions of parameters.\\n61: Experiments on two public datasets as well as an Alibaba real production dataset with over 2 billion samples demonstrate the effectiveness of proposed approaches, which achieve superior performance compared with state-of-the-art methods.\\n62: DIN now has been successfully deployed in the online display advertising system in Alibaba, serving the main traffic.\\n63: Keywords: Click-Through Rate Prediction, Display Advertising, E-commerce\\n64: 1. Introduction\\n65: In cost-per-click (CPC) advertising system, advertisements are ranked by the eCPM (effective cost per mille), which is the product of the bid price and CTR (click-through rate), and CTR needs to be predicted by the system. Hence, the performance of CTR prediction model has a direct impact on the final revenue and plays a key role in the advertising system. Modeling CTR prediction has received much attention from both research and industry community.\\n66: Recently, inspired by the success of deep learning in computer vision (Huang\\n67: et al., ) and natural language processing (Bahdanau\\n68: et al., 2015), deep learning based methods have been proposed for CTR prediction task (Shan\\n69: et al., ; Covington\\n70: et al., 2016; Zhai\\n71: et al., 2016; et al., 2016a).\\n72: These methods follow a similar Embedding&MLP paradigm: large scale sparse input features are first mapped into low dimensional embedding vectors, and then transformed into fixed-length vectors in a group-wise manner, finally concatenated together to fed into fully connected layers (also known as multilayer perceptron, MLP) to learn the nonlinear relations among features.\\n73: Compared with commonly used logistic regression model (Mcmahan\"\n}\n{\n  \"id\": \"paper:dmr\",\n  \"url\": \"https://ojs.aaai.org/index.php/AAAI/article/view/5346\",\n  \"version\": \"content-sha256:656c9e5eec79c9843e907a555ede2bf0a66a0db3515916af3d655080057c5a75\",\n  \"access_scope\": \"author README only, not the blocked publisher paper\",\n  \"text_sha256\": \"656c9e5eec79c9843e907a555ede2bf0a66a0db3515916af3d655080057c5a75\",\n  \"total_lines\": 9,\n  \"start_line\": 1,\n  \"next_line\": 10,\n  \"truncated\": false,\n  \"text\": \"1: # DMR\\n2: Deep Match to Rank Model for Personalized Click-Through Rate Prediction\\n3: \\n4: This code for DMR is implemented based on the Alimama Dataset (https://tianchi.aliyun.com/dataset/dataDetail?dataId=56), references the codes of DIEN (https://github.com/mouna99/dien).\\n5: \\n6: \\\"alimama_sampled.txt\\\" is a sampled dataset for testing the code.\\n7: \\n8: Notice that, the user behavior data in this dataset contains only category, brand and behavior type, but no item.\\n9: \"\n}\n","exit_code":0,"status":"completed"}}
