982:                  (ordered_age[:, 1:] == ordered_age[:, :-1]))\n983:         tied[:, 1:] |= equal\n984:         tied[:, :-1] |= equal\n985:         singleton = valid & ~tied\n986:         eligible = torch.zeros_like(complete).scatter(1, order, singleton)\n987:         # Compact singleton events while retaining their chronological order.\n988:         position = torch.arange(length, device=c.device)[None, :].expand(batch_size, -1)\n989:         compact = torch.where(singleton, position, position + length).argsort(dim=-1)\n990:         order = order.gather(1, compact)\n991:         return eligible, order, eligible.long().sum(-1), complete\n992: \n993:     @staticmethod\n994:     def _exchangeable_equal(identity, cell, eligible, mass, n):\n995:         \"\"\"Expected equal-identity adjacent counts under a uniform permutation.\n996: \n997:         For a distinct ordered pair of events, adjacency probability is 1/n.\n998:         Sum identity-cell histogram outer products, remove self-event terms,\n999:         divide by n. Self pairs are excluded even when source cell equals\n1000:         destination cell. This is an exact finite empirical expectation.\n1001:         Sort BL keys and use BL16 storage, never BL squared or vocabulary size.\n1002:         \"\"\"\n1003:         batch_size, length = identity.shape\n1004:         if length == 0:\n1005:             return mass.new_zeros((batch_size, 16, 16))\n1006:         key = torch.where(eligible, 16 * identity + cell,\n1007:                           torch.full_like(identity, -1))\n1008:         ordered, order = key.sort(dim=-1)\n1009:         valid = ordered >= 0\n1010:         identity_key = ordered.div(16, rounding_mode='floor')\n1011:         start = valid.clone()\n1012:         start[:, 1:] = valid[:, 1:] & (identity_key[:, 1:] != identity_key[:, :-1])\n1013:         run = (start.long().cumsum(-1) - 1).clamp_min(0)\n1014:         sorted_cell = cell.gather(1, order)\n1015:         counts = mass.new_zeros((batch_size, length * 16)).scatter_add(\n1016:             1, 16 * run + sorted_cell, valid.float()).reshape(batch_size, length, 16)\n1017:         gram = torch.bmm(counts.transpose(1, 2), counts)\n1018:         return (gram - torch.diag_embed(mass)).clamp_min(0) / n.clamp_min(1)[:, None, None]\n1019: \n1020:     def _transition_tables(self, batch):\n1021:         \"\"\"Four raw count tables for chronology and exchangeable chronology.\n1022: \n1023:         Each tuple is (total edges, category-equal, brand-equal, pair-equal).\n1024:         u=4*match_group+action-1. Parent support and outputs are unmodified.\n1025:         Every variant computes both tuples and both product replacements.\n1026:         \"\"\"\n1027:         eligible, order, n_int, complete = self._transition_support(batch)\n1028:         c, b = batch['history_category'], batch['history_brand']\n1029:         group = self._membership(batch)[1].argmax(dim=1)\n1030:         cell = 4 * group + (batch['history_type'] - 1).clamp(0, 3)\n1031:         batch_size, length = c.shape\n1032:         n = batch['history_age_seconds'].new_zeros((batch_size,)) + n_int.float()\n1033:         mass = n.new_zeros((batch_size, 16)).scatter_add(1, cell, eligible.float())\n1034:         temporal = []\n1035:         if length < 2:\n1036:             temporal = [n.new_zeros((batch_size, 16, 16)) for _ in range(4)]\n1037:         else:\n1038:             valid = eligible.gather(1, order)\n1039:             ordered_cell = cell.gather(1, order)\n1040:             ordered_c, ordered_b = c.gather(1, order), b.gather(1, order)\n1041:             edge = valid[:, :-1] & valid[:, 1:]\n1042:             same_c = ordered_c[:, :-1] == ordered_c[:, 1:]\n1043:             same_b = ordered_b[:, :-1] == ordered_b[:, 1:]\n1044:             destination = 16 * ordered_cell[:, :-1] + ordered_cell[:, 1:]\n1045:             for match in (torch.ones_like(edge), same_c, same_b, same_c & same_b):\n1046:                 counts = n.new_zeros((batch_size, 256)).scatter_add(\n1047:                     1, destination, (edge & match).float())\n1048:                 temporal.append(counts.reshape(batch_size, 16, 16))\n1049:         total = (mass.unsqueeze(-1) * mass.unsqueeze(-2) -\n1050:                  torch.diag_embed(mass)).clamp_min(0) / n.clamp_min(1)[:, None, None]\n1051:         exchangeable = [total]\n1052:         for identity in (c, b, c * self.brand_vocab + b):\n1053:             exchangeable.append(self._exchangeable_equal(identity, cell, eligible, mass, n))\n1054:         temporal_product = temporal[1] * temporal[2] / temporal[0].clamp_min(1)\n1055:         # Fractional exchangeable masses can be <1: use the positive mass,\n1056:         # not clamp_min(1), for an exact conditional product replacement.\n1057:         denominator = torch.where(total > 0, total, torch.ones_like(total))\n1058:         exchangeable_product = exchangeable[1] * exchangeable[2] / denominator\n1059:         return tuple(temporal), tuple(exchangeable), temporal_product, exchangeable_product, n, complete, eligible\n1060: \n\nLINES 202 226\n202:         mask = batch['history_mask']\n203:         target_c = batch['static'][:, self.category:self.category + 1]\n204:         target_b = batch['static'][:, self.brand:self.brand + 1]\n205:         hc, hb = batch['history_category'], batch['history_brand']\n206:         cm = mask & (target_c > 0) & (hc > 0) & (hc == target_c)\n207:         bm = mask & (target_b > 0) & (hb > 0) & (hb == target_b)\n208:         semantic = torch.stack([\n209:             mask & ~cm & ~bm, cm & ~bm, bm & ~cm, cm & bm\n210:         ], dim=1).float()  # [B,4,L]\n211:         sizes = semantic.sum(-1)\n212:         if self.grouping_mode == 'rank':\n213:             # Assign in supplied input order, counting only valid positions.\n214:             # Prefix thresholds reproduce true cardinalities even with gaps.\n215:             # This is a positional replacement, not a randomized control.\n216:             rank = mask.long().cumsum(-1) - 1\n217:             upper = sizes.long().cumsum(-1)\n218:             lower = upper - sizes.long()\n219:             membership = ((rank[:, None, :] >= lower[:, :, None]) &\n220:                           (rank[:, None, :] < upper[:, :, None]) &\n221:                           mask[:, None, :]).float()\n222:         else:\n223:             membership = semantic\n224:         return membership, semantic, sizes\n225: \n226:     def _represent(self, batch):\n{\n  \"revision\": \"knowledge-access-v3\",\n  \"ranking\": \"BM25 over bounded scientific fields; separate recall by knowledge family\",\n  \"query\": \"compact\",\n  \"requested_ids\": [],\n  \"selected_ids\": [],\n  \"candidates_by_source\": {\n    \"paper\": [],\n    \"industry\": [],\n    \"agent\": []\n  },\n  \"industry_relevance\": \"no positive industry match; no architecture forced\",\n  \"adoption_policy\": \"Retrieval is not adoption. Accept, reject or retain uncertainty with reasons; external reports do not establish local effects.\",\n  \"matches\": []\n}\n{\n  \"revision\": \"knowledge-access-v3\",\n  \"ranking\": \"BM25 over bounded scientific fields; separate recall by knowledge family\",\n  \"query\": \"timing\",\n  \"requested_ids\": [],\n  \"selected_ids\": [],\n  \"candidates_by_source\": {\n    \"paper\": [],\n    \"industry\": [],\n    \"agent\": []\n  },\n  \"industry_relevance\": \"no positive industry match; no architecture forced\",\n  \"adoption_policy\": \"Retrieval is not adoption. Accept, reject or retain uncertainty with reasons; external reports do not establish local effects.\",\n  \"matches\": []\n}\n{\n  \"id\": \"paper:din\",\n  \"url\": \"https://arxiv.org/abs/1706.06978v4\",\n  \"version\": \"content-sha256:5fee25f33f375e51b3ee9417d376ff9dbe2ea3628c932a7679ddfeb0feaaade2\",\n  \"access_scope\": \"archived exact-version primary text; caching does not establish a local mechanism result\",\n  \"text_sha256\": \"83fb9eeca31e2fa3c557b6f08b893ad0018cefb33da6e00952136b9ce17e607e\",\n  \"total_lines\": 831,\n  \"start_line\": 217,\n  \"next_line\": 282,\n  \"truncated\": false,\n  \"text\": \"217: …\\n218: …\\n219: Figure 2. Network Architecture. The left part illustrates the network of base model (Embedding&MLP). Embeddings of cate_id, shop_id and goods_id belong to one goods are concatenated to represent one visited goods in user’s behaviors. Right part is our proposed DIN model. It introduces a local activation unit, with which the representation of user interests varies adaptively given different candidate ads.\\n220: 4.2. Base Model(Embedding&MLP)\\n221: Most of the popular model structures (Shan\\n222: et al., ; et al., 2016a; Covington\\n223: et al., 2016) share a similar Embedding&MLP paradigm, which we refer to as base model, as shown in the left of Fig.2. It consists of several parts:\\n224: Embedding layer\\n225: As the inputs are high dimensional binary vectors, embedding layer is used to transform them into low dimensional dense representations.\\n226: For the i-th feature group of 𝒕i\\\\bm{t}_{i}, let Wi=[w1i,…,wji,…,wKii]∈ℝD×Ki\\\\mathrm{W}^{i}=[w_{1}^{i},...,w_{j}^{i},...,w_{K_{i}}^{i}]\\\\in\\\\mathbb{R}^{D\\\\times K_{i}} represent the i-th embedding dictionary, where wji∈RDw_{j}^{i}\\\\in R^{D} is an embedding vector with dimensionality of DD.\\n227: Embedding operation follows the table lookup mechanism, as illustrated in Fig.2.\\n228: •\\n229: If 𝒕i\\\\bm{t}_{i} is one-hot vector with j-th element 𝒕i​[j]=1\\\\bm{t}_{i}[j]=1, the embedded representation of 𝒕i\\\\bm{t}_{i} is a single embedding vector 𝒆i=wji\\\\bm{e}_{i}=w_{j}^{i}.\\n230: •\\n231: If 𝒕i\\\\bm{t}_{i} is multi-hot vector with 𝒕i​[j]=1​for​j∈{i1,i2,…,ik}\\\\bm{t}_{i}[j]=1\\\\penalty\\\\ \\\\text{for}\\\\penalty\\\\ j\\\\in\\\\{i_{1},i_{2},...,i_{k}\\\\}, the embedded representation of 𝒕i\\\\bm{t}_{i} is a list of embedding vectors: {𝒆i1,𝒆i2,…​𝒆ik}={wi1i,wi2i,…​wiki}\\\\{\\\\bm{e}_{i_{1}},\\\\bm{e}_{i_{2}},...\\\\bm{e}_{i_{k}}\\\\}=\\\\{w_{i_{1}}^{i},w_{i_{2}}^{i},...w_{i_{k}}^{i}\\\\}.\\n232: Pooling layer and Concat layer\\n233: Notice that different users have different numbers of behaviors. Thus the number of non-zero values for multi-hot behavioral feature vector 𝒕i\\\\bm{t}_{i} varies across instances, causing the lengths of the corresponding list of embedding vectors to be variable.\\n234: As fully connected networks can only handle fixed-length inputs, it is a common practice (et al., 2016a; Covington\\n235: et al., 2016) to transform the list of embedding vectors via a pooling layer to get a fixed-length vector:\\n236: (1)\\n237: 𝒆i=pooling​(𝒆i1,𝒆i2,…​𝒆ik).\\\\bm{e}_{i}=\\\\text{pooling}(\\\\bm{e}_{i_{1}},\\\\bm{e}_{i_{2}},...\\\\bm{e}_{i_{k}}).\\n238: Two most commonly used pooling layers are sum pooling and average pooling, which apply element-wise sum/average operations to the list of embedding vectors.\\n239: Both embedding and pooling layers operate in a group-wise manner, mapping the original sparse features into multiple fixed-length representation vectors.\\n240: Then all the vectors are concatenated together to obtain the overall representation vector for the instance.\\n241: MLP\\n242: Given the concatenated dense representation vector, fully connected layers are used to learn the combination of features automatically.\\n243: Recently developed methods (et al., 2016a; Guo\\n244: et al., 2017; et al., 2016b) focus on designing structures of MLP for better information extraction.\\n245: Loss\\n246: The objective function used in base model is the negative log-likelihood function defined as:\\n247: (2)\\n248: L=−1N∑(𝒙,y)∈𝒮(ylogp(𝒙)+(1−y)log(1−p(𝒙))),L=-\\\\frac{1}{N}\\\\sum_{(\\\\bm{x},y)\\\\in\\\\mathcal{S}}(y\\\\log p(\\\\bm{x})+(1-y)\\\\log(1-p(\\\\bm{x}))),\\n249: where 𝒮\\\\mathcal{S} is the training set of size NN, with 𝒙\\\\bm{x} as the input of the network and y∈{0,1}y\\\\in\\\\{0,1\\\\} as the label, p⁡(𝒙)p(\\\\bm{x}) is the output of the network after the softmax layer, representing the predicted probability of sample 𝒙\\\\bm{x} being clicked.\\n250: 4.3. The structure of Deep Interest Network\\n251: Among all those features of Table 1, user behavior features are critically important and play key roles in modeling user interests in the scenario of e-commerce applications.\\n252: Base model obtains a fixed-length representation vector of user interests by pooling all the embedding vectors over the user behavior feature group, as Eq.(1). This representation vector stays the same for a given user, in regardless of what candidate ads are.\\n253: In this way, the user representation vector with a limited dimension will be a bottleneck to express user’s diverse interests.\\n254: To make it capable enough, an easy method is to expand the dimension of embedding vector, which unfortunately will increase the size of learning parameters heavily.\\n255: It will lead to overfitting under limited training data and add the burden of computation and storage, which may not be tolerated for an industrial online system.\\n256: Is there an elegant way to represent user’s diverse interests in one vector under limited dimension?\\n257: The local activation characteristic of user interests gives us inspiration to design a novel model named deep interest network(DIN).\\n258: Imagine when the young mother mentioned above in section 3 visits the e-commerce site, she finds the displayed new handbag cute and clicks it.\\n259: Let’s dissect the driving force of click action.\\n260: The displayed ad hits the related interests of this young mother by soft-searching her historical behaviors and finding that she had browsed similar goods of tote bag and leather handbag recently.\\n261: In other words, behaviors related to displayed ad greatly contribute to the click action.\\n262: DIN simulates this process by paying attention to the representation of locally activated interests w.r.t. given ad.\\n263: Instead of expressing all user’s diverse interests with the same vector, DIN adaptively calculate the representation vector of user interests by taking into consideration the relevance of historical behaviors w.r.t. candidate ad.\\n264: This representation vector varies over different ads.\\n265: The right part of Fig.2 illustrates the architecture of DIN.\\n266: Compared with base model, DIN introduces a novel designed local activation unit and maintains the other structures the same. Specifically, activation units are applied on the user behavior features, which performs as a weighted sum pooling to adaptively calculate user representation 𝒗U\\\\bm{v}_{U} given a candidate ad AA, as shown in Eq.(3)\\n267: (3)\\n268: 𝒗U(A)=f(𝒗A,𝒆1,𝒆2,..,𝒆H)=∑j=1Ha⁡(𝒆j,𝒗A)​𝒆j=∑j=1H𝒘j​𝒆j,\\\\displaystyle\\\\begin{split}\\\\bm{v}_{U}(A)=f(\\\\bm{v}_{A},\\\\bm{e}_{1},\\\\bm{e}_{2},..,\\\\bm{e}_{H})&=\\\\sum_{j=1}^{H}a(\\\\bm{e}_{j},\\\\bm{v}_{A})\\\\bm{e}_{j}=\\\\sum_{j=1}^{H}\\\\bm{w}_{j}\\\\bm{e}_{j},\\\\end{split}\\n269: where {𝒆1,𝒆2,…,𝒆H}\\\\{\\\\bm{e}_{1},\\\\bm{e}_{2},...,\\\\bm{e}_{H}\\\\} is the list of embedding vectors of behaviors of user UU with length of HH, 𝒗A\\\\bm{v}_{A} is the embedding vector of ad AA. In this way, 𝒗U​(A)\\\\bm{v}_{U}(A) varies over different ads. a⁡(⋅)a(\\\\cdot) is a feed-forward network with output as the activation weight, as illustrated in Fig.2. Apart from the two input embedding vectors, a⁡(⋅)a(\\\\cdot) adds the out product of them to feed into the subsequent network, which is an explicit knowledge to help relevance modeling.\\n270: Local activation unit of Eq.(3) shares similar ideas with attention methods which are developed in NMT task(Bahdanau\\n271: et al., 2015).\\n272: However different from traditional attention method, the constraint of ∑iwi=1\\\\sum_{i}w_{i}=1 is relaxed in Eq.(3), aiming to reserve the intensity of user interests.\\n273: That is, normalization with softmax on the output of a⁡(⋅)a(\\\\cdot) is abandoned.\\n274: Instead, value of ∑iwi\\\\sum_{i}w_{i} is treated as an approximation of the intensity of activated user interests to some degree.\\n275: For example, if one user’s historical behaviors contain 90% clothes and 10% electronics.\\n276: Given two candidate ads of T-shirt and phone, T-shirt activates most of the historical behaviors belonging to clothes and may get larger value of 𝒗U\\\\bm{v}_{U} (higher intensity of interest) than phone.\\n277: Traditional attention methods lose the resolution on the numerical scale of 𝒗U\\\\bm{v}_{U} by normalizing of the output of a⁡(⋅)a(\\\\cdot).\\n278: We have tried LSTM to model user historical behavior data in the sequential manner.\\n279: But it shows no improvement.\\n280: Different from text which is under the constraint of grammar in NLP task, the sequence of user historical behaviors may contain multiple concurrent interests.\\n281: Rapid jumping and sudden ending over these interests causes the sequence data of user behaviors to seem to be noisy.\"\n}\n","exit_code":0,"status":"completed"}}
