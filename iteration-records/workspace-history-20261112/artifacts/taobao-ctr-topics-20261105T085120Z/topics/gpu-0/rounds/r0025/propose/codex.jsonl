de']\n20:         if self.joint_mode not in ('observed', 'independent'):\n21:             raise ValueError('Unknown joint_mode')\n22:         if self.statistic_mode not in ('count', 'rate'):\n23:             raise ValueError('Unknown statistic_mode')\n24:         if self.grouping_mode not in ('match', 'rank', 'occupied_global'):\n25:             raise ValueError('Unknown grouping_mode')\n26:         # Parent means, histograms and independent moments stay fixed in\n27:         # true-match groups; only the appended field readout is intervened on.\n28:         if self.grouping_mode != 'match':\n29:             raise ValueError('This study fixes learned pooling to match')\n30:         self.histogram_grouping = self.config['histogram_grouping']\n31:         self.histogram_pairing = self.config['histogram_pairing']\n32:         if self.histogram_grouping not in ('match', 'rank'):\n33:             raise ValueError('Unknown histogram_grouping')\n34:         if self.histogram_pairing not in ('observed', 'independent'):\n35:             raise ValueError('Unknown histogram_pairing')\n36:         self.moment_grouping = self.config['moment_grouping']\n37:         self.moment_pairing = self.config['moment_pairing']\n38:         if self.moment_grouping not in ('match', 'rank'):\n39:             raise ValueError('Unknown moment_grouping')\n40:         if self.moment_pairing not in ('observed', 'independent'):\n41:             raise ValueError('Unknown moment_pairing')\n42:         if self.histogram_grouping != 'match' or self.histogram_pairing != 'observed':\n43:             raise ValueError('Incumbent histogram must remain observed/match')\n44:         self.field_mode = self.config['field_mode']\n45:         self.field_grouping = self.config['field_grouping']\n46:         if self.field_mode not in ('contrast', 'norm_collapsed'):\n47:             raise ValueError('Unknown field_mode')\n48:         if self.field_grouping not in ('match', 'rank'):\n49:             raise ValueError('Unknown field_grouping')\n50:         if self.moment_grouping != 'match' or self.moment_pairing != 'independent':\n51:             raise ValueError('This study fixes incumbent independent/match moments')\n52:         self.field_scope = self.config['field_scope']\n53:         self.field_layout = self.config['field_layout']\n54:         self.global_direction = self.config['global_direction']\n55:         if self.field_scope not in ('rank', 'global'):\n56:             raise ValueError('Unknown field_scope')\n57:         if self.field_layout not in ('wide', 'compact'):\n58:             raise ValueError('Unknown field_layout')\n59:         if self.global_direction not in ('contrast', 'norm_collapsed'):\n60:             raise ValueError('Unknown global_direction')\n61:         if self.field_scope == 'rank' and (self.field_layout != 'wide' or\n62:                                          self.global_direction != 'contrast'):\n63:             raise ValueError('Shared reference must retain original rank readout')\n64:         self.category = meta['category_field_index']\n65:         self.brand = meta['brand_field_index']\n66:         dim = self.config['embedding_dim']\n67:         # Exact ancestor allocation up to the wider output layer. Dormant\n68:         # attention is retained in every variant; it is never executed.\n69:         self.embeddings = nn.ModuleList([\n70:             nn.Embedding(size, dim, padding_idx=0) for size in meta['buckets']\n71:         ])\n72:         self.action = nn.Embedding(5, dim, padding_idx=0)\n73:         self.recency = nn.Embedding(33, dim, padding_idx=0)\n74:         self.attention = nn.Sequential(\n75:             nn.Linear(dim * 4, 64), nn.PReLU(), nn.Linear(64, 1)\n76:         )\n77:         layers = []\n78:         field_width = (12 if self.field_layout == 'wide' else 3) * dim\n79:         width = len(meta['fields']) * dim + 4 * dim + 4 + 64 + 4 * dim + field_width\n80:         for hidden in self.config['hidden']:\n81:             layers.extend([nn.Linear(width, hidden), nn.ReLU()])\n82:             width = hidden\n83:         layers.append(nn.Linear(width, 1))\n84:         self.output = nn.Sequential(*layers)\n85:         # Append allocation AFTER every incumbent parameter. The old parameter\n86:         # shapes, allocation order and scratch initialization are unchanged.\n87:         self.identity_mode = self.config['identity_mode']\n88:         if self.identity_mode not in ('joint', 'independent', 'marginal', 'zero'):\n89:             raise ValueError('Unknown identity_mode')\n90:         if (self.field_scope, self.field_layout, self.global_direction) != ('global', 'compact', 'norm_collapsed'):\n91:             raise ValueError('This study fixes the incumbent representation')\n92:         self.category_vocab = int(meta['buckets'][self.category])\n93:         self.brand_vocab = int(meta['buckets'][self.brand])\n94:         # Pair keys use the supplied categorical bucket identities, not raw\n95:         # products/items. Bound the packed int64 key before any tensor math.\n96:         if self.category_vocab * self.brand_vocab > (2**63 - 1) // 4:\n97:             raise ValueError('Packed identity key would overflow int64')\n98:         self.identity_head = nn.Sequential(\n99:             nn.Linear(28, 16, bias=False), nn.ReLU(),\n100:             nn.Linear(16, 1, bias=False)\n101:         )\n102:         # A zero final weight preserves the incumbent initial function. In the\n103:         # zero-input cell the whole bias-free branch stays identically zero.\n104:         nn.init.zeros_(self.identity_head[-1].weight)\n105:         # Allocate only AFTER every incumbent parameter. Each registered cell\n106:         # computes identical empirical and product alternatives before readout.\n107:         self.context_mode = self.config['context_mode']\n108:         if self.context_mode not in ('joint', 'independent', 'marginal', 'zero'):\n109:             raise ValueError('Unknown context_mode')\n110:         if self.identity_mode != 'joint':\n111:             raise ValueError('This study retains the joint-identity incumbent')\n112:         if self.category_vocab * self.brand_vocab > (2**63 - 1) // 64:\n113:             raise ValueError('Packed identity-context key would overflow int64')\n114:         self.context_head = nn.Sequential(\n115:             nn.Linear(28, 16, bias=False), nn.ReLU(),\n116:             nn.Linear(16, 1, bias=False)\n117:         )\n118:         nn.init.zeros_(self.context_head[-1].weight)\n119: \n120:         # Append after EVERY parent parameter so old shapes, allocation order\n121:         # and scratch initialization remain identical. Modes allocate equally.\n122:         self.repeat_mode = self.config['repeat_mode']\n123:         if self.repeat_mode not in ('joint', 'independent', 'unlabeled', 'zero'):\n124:             raise ValueError('Unknown repeat_mode')\n125:         if self.context_mode != 'joint':\n126:             raise ValueError('This study retains coupled_context exactly')\n127:         self.repeat_head = nn.Sequential(\n128:             nn.Linear(192, 16, bias=False), nn.ReLU(),\n129:             nn.Linear(16, 1, bias=False)\n130:         )\n131:         nn.init.zeros_(self.repeat_head[-1].weight)\n132: \n133:         # Allocate only after ALL parent parameters; every mode is identical.\n134:         self.overlap_mode = self.config['overlap_mode']\n135:         if self.overlap_mode not in ('observed', 'product', 'unlabeled', 'zero'):\n136:             raise ValueError('Unknown overlap_mode')\n137:         if self.repeat_mode != 'joint':\n138:             raise ValueError('Retain the localized-repeat parent in every cell')\n139:         self.overlap_head = nn.Sequential(\n140:             nn.Linear(480, 16, bias=False), nn.ReLU(),\n141:             nn.Linear(16, 1, bias=False)\n142:         )\n143:         nn.init.zeros_(self.overlap_head[-1].weight)\n144:         # Fixed upper-triangle readout: four groups times C(16,2) = 48