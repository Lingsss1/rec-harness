{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/build_merge.py <<'PY'\nimport ast,json,pathlib\nroot=pathlib.Path('/workspace')\ntiming=(root/'history_g1_r0022_timing_joint.py').read_text()\ncompact=(root/'history_g0_r0023_shape_magnitude.py').read_text()\ntree=ast.parse(compact); cls=next(n for n in tree.body if isinstance(n,ast.ClassDef))\nmethods={n.name:n for n in cls.body if isinstance(n,ast.FunctionDef)}\nlines=compact.splitlines()\ndef method(name):\n n=methods[name];start=min([n.lineno]+[d.lineno for d in n.decorator_list]);return '\\\\n'.join(lines[start-1:n.end_lineno])+'\\\\n'\ndef chunk(a,b):return '\\\\n'.join(lines[a-1:b])+'\\\\n'\nbase=timing.replace('class Model(_GapTimingParentModel):','class _FrozenTimingModel(_GapTimingParentModel):')\nctor='''\n\nclass Model(_FrozenTimingModel):\n    \\\"\\\"\\\"Shared-ancestor source merge with a 2x2 evidence-replacement study.\n\n    Entire timing source is retained. Added exchangeable-transition and four\n    compact residual heads share its pre-transition ancestor, not a second\n    embedding table. All four cells allocate/compute identically; only inputs\n    selected for NEW heads differ. Both source paths are trained from scratch.\n    \\\"\\\"\\\"\n    def __init__(self, meta, config=None):\n        super().__init__(meta, config)\n        if self.timing_mode \"'!= '\"'joint':\n            raise ValueError('Retain the frozen joint timing source')\n        self.merge_transition = self.config.get('merge_transition', 'exchangeable')\n        self.merge_evidence = self.config.get('merge_evidence', 'compact')\n        if self.merge_transition not in ('exchangeable', 'duplicate'):\n            raise ValueError('Unknown merge_transition')\n        if self.merge_evidence not in ('compact', 'histogram'):\n            raise ValueError('Unknown merge_evidence')\n        # All old allocations and RNG draws precede all five new heads.\n        self.merge_transition_head = nn.Sequential(\n            nn.Linear(1024, 16, bias=False), nn.ReLU(),\n            nn.Linear(16, 1, bias=False))\n        nn.init.zeros_(self.merge_transition_head[-1].weight)\n'''\nctor+=chunk(175,184)+chunk(194,203)+chunk(225,230)+chunk(240,245)\nparts='''\n    def _merge_feature_maps(self, batch, semantic=None):\n        # These four selected maps are exactly the frozen compact source's\n        # inputs: histogram, conditional mean, observed variance, |third|.\n        # Every source alternative executes in every registered cell.\n        old = self._compact_alternatives(batch, semantic)\n        association = self._association_alternatives(batch)\n        dispersion = self._dispersion_alternatives(batch)\n        shape = self._shape_alternatives(batch)\n        full = (old[2], association[2], dispersion[1], shape[1])\n        # All four readouts now see the SAME already-present ancestor histogram.\n        # This is extra active capacity without new evidence, not a null input.\n        redundant = (old[2], old[2], old[2], old[2])\n        return full, redundant, (old, association, dispersion, shape)\n\n    def _merge_readouts(self, inputs, context):\n        a = self._compact_readout(inputs[0], context)[0]\n        b = self._fusion_readout(inputs[1], context)[0]\n        c = self._dispersion_readout(inputs[2], context)[0]\n        d = self._shape_readout(inputs[3], context)[0]\n        return a, b, c, d\n\n    def _merge_parts(self, batch):\n        common, context, semantic, parent_features = self._merge_parent_context(batch)\n        tables = self._transition_tables(batch)\n        chronological = self._transition_features(tables, 'chronological', 'product')\n        exchangeable = self._transition_features(tables, 'exchangeable', 'observed')\n        # Same arithmetic order as the exact frozen timing source.\n        timing = common + self.transition_head(chronological).squeeze(-1)\n        timing = timing + self.gap_head(self._selected_gap_features(batch)).squeeze(-1)\n        timing_input = self._timing_views(self._timing_counts(batch))['joint']\n        timing = timing + self.timing_head(timing_input).squeeze(-1)\n        full, redundant, details = self._merge_feature_maps(batch, semantic)\n        selected_transition = (exchangeable if self.merge_transition == 'exchangeable'\n                               else chronological)\n        selected = full if self.merge_evidence == 'compact' else redundant\n        transition = self.merge_transition_head(selected_transition).squeeze(-1)\n        residuals = self._merge_readouts(selected, context)\n        added = transition\n        for residual in residuals:\n            added = added + residual\n        return (timing + added, timing, added, context, full, redundant,\n                transition, residuals, details, common, exchangeable, chronological)\n\n    def forward(self, batch):\n        return self._merge_parts(batch)[0]\n\n    @staticmethod\n    def _merge_max(x):\n        return x.abs().max() if x.numel() else x.new_zeros(())\n\n    @staticmethod\n    def _merge_rms(x):\n        return x.square().mean().sqrt() if x.numel() else x.new_zeros(())\n\n    def diagnostics(self, batch):\n        # Candidate-supplied probes, not independent host performance evidence.\n        # Only 8 rows enter direct float64 cell and dense timing oracles.\n        parts = self._merge_parts(batch)\n        logits, timing, added, context, full, redundant = parts[:6]\n        probe = {key: value[:8] for key, value in batch.items()}\n        small = self._merge_parts(probe)\n        sf, sr, detail = small[4], small[5], small[8]\n        disp_oracle = self._dispersion_oracle(probe)\n        shape_oracle = self._shape_oracle(probe)\n        original = _FrozenTimingModel.forward(self, probe)\n        timing_counts = self._timing_counts(probe)\n        timing_oracle = self._timing_dense_oracle(probe)\n        histogram = torch.log1p(disp_oracle[4]) / math.log(129.0)\n        zero = tuple(torch.zeros_like(value) for value in sf)\n        zero_readouts = self._merge_readouts(zero, small[3])\n        zero_transition = self.merge_transition_head(torch.zeros_like(small[10])).squeeze(-1)\n        zero_added = zero_transition\n        for value in zero_readouts:\n            zero_added = zero_added + value\n        flipped = {key: (value if key == 'static' else value.flip(1))\n                   for key, value in probe.items()}\n        flipped_maps = self._merge_feature_maps(flipped)[0]\n        flipped_transition = self._transition_features(\n            self._transition_tables(flipped), 'exchangeable', 'observed')\n        masked = {key: value.clone() for key, value in probe.items()}\n        mask = masked['history_mask']\n        masked['history_age_seconds'] = torch.where(\n            mask, masked['history_age_seconds'], torch.full_like(masked['history_age_seconds'], float('nan')))\n        masked['history_category'] = torch.where(mask, masked['history_category'], torch.zeros_like(masked['history_category']))\n        masked['history_brand'] = torch.where(mask, masked['history_brand'], torch.zeros_like(masked['history_brand']))\n        masked['history_type'] = torch.where(mask, masked['history_type'], torch.zeros_like(masked['history_type']))\n        masked_maps = self._merge_feature_maps(masked)[0]\n        empty = {key: value.clone() for key, value in probe.items()}\n        empty['history_mask'] = torch.zeros_like(empty['history_mask'])\n        empty_maps = self._merge_feature_maps(empty)[0]\n        empty_transition = self._transition_features(\n            self._transition_tables(empty), 'exchangeable', 'observed')\n        no_length = {key: (value if key == 'static' else value[:, :0])\n                     for key, value in probe.items()}\n        no_length_maps = self._merge_feature_maps(no_length)[0]\n        # The full zero-readout counterfactual equals timing at any checkpoint.\n        # This does NOT claim a trained nonzero merge reproduces a source score.\n        stats = {\n            'allocated_parameters': sum(p.numel() for p in self.parameters()),\n            'appended_parameters': sum(p.numel() for name,p in self.named_parameters()\n                if name.startswith(('merge_transition_head.', 'compact_', 'fusion_', 'dispersion_', 'shape_'))),\n            'exchangeable_input_enabled': float(self.merge_transition == 'exchangeable'),\n            'compact_evidence_enabled': float(self.merge_evidence == 'compact'),\n            'logits_finite_fraction': torch.isfinite(logits).float().mean(),\n            'features_finite_fraction': torch.stack([torch.isfinite(x).float().mean() for x in full]).mean(),\n            'timing_source_reproduction_error_max': self._merge_max(small[1] - original),\n            'additive_wiring_error_max': self._merge_max(logits - timing - added),\n            'zero_input_residual_error_max': self._merge_max(zero_added),\n            'zero_input_source_error_max': self._merge_max(small[1] + zero_added - original),\n            'diagnostic_oracle_impressions': probe['static'].shape[0],\n            'timing_dense_oracle_error_max': self._merge_max(timing_counts - timing_oracle),\n            'histogram_direct_error_max': self._merge_max(sf[0].double() - histogram),\n            'conditional_mean_direct_error_max': self._merge_max(sf[1].double() - disp_oracle[3]),\n            'variance_direct_error_max': self._merge_max(sf[2].double() - disp_oracle[1]),\n            'magnitude_direct_error_max': self._merge_max(sf[3].double() - shape_oracle[1]),\n            'count_conservation_error_max': self._merge_max(detail[3][4].sum((1,2)) - probe['history_mask'].sum(-1)),\n            'third_direct_error_max': self._merge_max(detail[3][5].flatten(1).double() - shape_oracle[5]),\n            'duplicate_histogram_error_max': torch.stack([self._merge_max(x-sr[0]) for x in sr]).max(),\n            'compact_reordering_error_max': torch.stack([self._merge_max(x-y) for x,y in zip(sf,flipped_maps)]).max(),\n            'exchangeable_reordering_error_max': self._merge_max(small[10] - flipped_transition),\n            'masked_padding_feature_error_max': torch.stack([self._merge_max(x-y) for x,y in zip(sf,masked_maps)]).max(),\n            'empty_feature_abs_max': torch.stack([self._merge_max(x) for x in empty_maps]).max(),\n            'empty_exchangeable_abs_max': self._merge_max(empty_transition),\n            'zero_length_feature_abs_max': torch.stack([self._merge_max(x) for x in no_length_maps]).max(),\n            'histogram_feature_rms': self._merge_rms(full[0]),\n            'conditional_mean_feature_rms': self._merge_rms(full[1]),\n            'variance_feature_rms': self._merge_rms(full[2]),\n            'magnitude_feature_rms': self._merge_rms(full[3]),\n            'exchangeable_vs_chronological_rms': self._merge_rms(parts[10]-parts[11]),\n            'total_new_residual_rms': self._merge_rms(added),\n            'new_transition_residual_rms': self._merge_rms(parts[6]),\n            'histogram_residual_rms': self._merge_rms(parts[7][0]),\n            'mean_residual_rms': self._merge_rms(parts[7][1]),\n            'variance_residual_rms': self._merge_rms(parts[7][2]),\n            'magnitude_residual_rms': self._merge_rms(parts[7][3]),\n            'occupied_cells_mean': detail[3][4].gt(0).float().sum((1,2)).mean(),\n            'three_event_cells_mean': detail[3][4].gt(2).float().sum((1,2)).mean(),\n        }\n        return {key: float(value) for key,value in stats.items()}\n'''\nnew=ctor\nnew+=method('_parent_forward_with_context').replace('def _parent_forward_with_context(', 'def _merge_parent_context(')\nfor name in ['_compact_encode','_compact_alternatives','_compact_readout',\n             '_fusion_readout','_innovation_alternatives','_association_alternatives',\n             '_dispersion_alternatives','_dispersion_readout','_shape_alternatives',\n             '_shape_readout','_dispersion_oracle','_shape_oracle']:\n