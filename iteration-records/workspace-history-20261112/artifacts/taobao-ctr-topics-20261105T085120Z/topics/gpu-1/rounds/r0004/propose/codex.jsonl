{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport ast\nimport hashlib\nimport json\nimport subprocess\nfrom pathlib import Path\n\nroot = Path('/workspace')\nproposal = json.loads((root / 'proposal.json').read_text())\nruntime = json.loads(subprocess.run(['python3', '/workspace/tools.py', 'resolve', 'run://r-001'], check=True, capture_output=True, text=True).stdout)\n\ndef validate(value, schema, at):\n    types = {'object': dict, 'array': list, 'string': str}\n    if 'type' in schema:\n        assert isinstance(value, types[schema['type']]), (at, schema['type'])\n    if 'const' in schema:\n        assert value == schema['const'], (at, 'const')\n    if 'enum' in schema:\n        assert value in schema['enum'], (at, 'enum')\n    if isinstance(value, dict):\n        assert set(schema.get('required', [])) <= value.keys(), (at, 'required')\n        if schema.get('additionalProperties') is False:\n            assert value.keys() <= schema.get('properties', {}).keys(), (at, 'extra keys')\n        for key, child in schema.get('properties', {}).items():\n            if key in value:\n                validate(value[key], child, at + '.' + key)\n    if isinstance(value, list):\n        assert len(value) >= schema.get('minItems', 0), (at, 'minItems')\n        for i, item in enumerate(value):\n            if 'items' in schema:\n                validate(item, schema['items'], at + '[' + str(i) + ']')\n    if isinstance(value, str):\n        assert len(value) >= schema.get('minLength', 0), (at, 'minLength')\n\nvalidate(proposal['study'], runtime['study_schema'], 'study')\nassert proposal['study']['protocol_ref'] == runtime['required_study_protocol_ref']\nallowed = set(runtime['context']['allowed_observation_ids'])\nassert proposal['parent_trial'] in allowed\nassert set(proposal['study']['evidence_refs']) <= allowed\nassert runtime['context']['previous_runtime_error'] is None\nassert 1 <= len(proposal['variants']) <= 4\nassert len({v['name'] for v in proposal['variants']}) == len(proposal['variants'])\nassert any(v['role'] == 'candidate' for v in proposal['variants'])\n\nancestor = ast.parse((root / 'history_g1_r0003_attention_activity.py').read_text())\ndef methods(tree):\n    cls = next(n for n in tree.body if isinstance(n, ast.ClassDef) and n.name == 'Model')\n    return {n.name: n for n in cls.body if isinstance(n, ast.FunctionDef)}\ndef dump(node):\n    return ast.dump(node, include_attributes=False)\ndef allocation_suffix(method):\n    body = method.body\n    start = next(i for i, node in enumerate(body) if isinstance(node, ast.Assign) and\n                 any(isinstance(t, ast.Attribute) and t.attr == 'embeddings' for t in node.targets))\n    return [dump(node) for node in body[start:]]\nreference_methods = methods(ancestor)\nclass_ast = None\nsummaries = []\nfor v in proposal['variants']:\n    assert set(v) == {'name','file','role','config','note'}\n    assert Path(v['file']).name == v['file'] and v['file'].endswith('.py')\n    assert v['role'] in ['candidate', 'control']\n    source = (root / v['file']).read_text()\n    compile(source, v['file'], 'exec')\n    tree = ast.parse(source)\n    literal = next(ast.literal_eval(n.value) for n in tree.body if isinstance(n, ast.Assign) and\n                   any(isinstance(t, ast.Name) and t.id == 'CONFIG' for t in n.targets))\n    assert literal == v['config'], (v['name'], 'config mismatch')\n    for n in ast.walk(tree):\n        if isinstance(n, ast.Import):\n            assert all(a.name in {'math','torch'} for a in n.names)\n        elif isinstance(n, ast.ImportFrom):\n            assert n.module == 'torch' and all(a.name == 'nn' for a in n.names)\n        elif isinstance(n, ast.Call) and isinstance(n.func, ast.Name):\n            assert n.func.id not in {'open','exec','eval','compile','__import__'}\n    m = methods(tree)\n    assert allocation_suffix(m['__init__']) == allocation_suffix(reference_methods['__init_