{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc 'cat history_g1_r0003_attention_activity.py evidence.jsonl'","aggregated_output":"/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n\"\"\"Factorial replacement of learned history by deterministic multiset counts.\n\nThe parent g1-r0002-joint_count supplies the attention+matches cell. Three new\nvariants remove learned history, direct target-match counts, or both. All\nparameter tensors and allocation order remain identical to the parent; zero\nsummary mode skips history embeddings/attention, leaving their parameters\nallocated but dormant. This tests quality and measured compute, not parameter\ncompression. A zero summary also makes the corresponding MLP columns dormant.\n\nN,C,B,J are counts of supplied bucket IDs, not raw item identities. Source DIN\nalready discusses preserving interest intensity; no global novelty is claimed.\n\"\"\"\nimport math\nimport torch\nfrom torch import nn\n\nCONFIG = {\n    'embedding_dim': 16, 'hidden': [128, 64], 'lr': 0.001,\n    'joint_mode': 'observed', 'statistic_mode': 'count',\n    'summary_mode': 'attention', 'relevance_mode': 'activity',\n}\n\n\nclass Model(nn.Module):\n    def __init__(self, meta, config=None):\n        super().__init__()\n        self.config = {**CONFIG, **(config or {})}\n        self.joint_mode = self.config['joint_mode']\n        self.statistic_mode = self.config['statistic_mode']\n        self.summary_mode = self.config['summary_mode']\n        self.relevance_mode = self.config['relevance_mode']\n        if self.summary_mode not in ('attention', 'none'):\n            raise ValueError('Unknown summary_mode')\n        if self.relevance_mode not in ('match', 'activity'):\n            raise ValueError('Unknown relevance_mode')\n        if self.joint_mode not in ('observed', 'independent'):\n            raise ValueError('Unknown joint_mode')\n        if self.statistic_mode not in ('count', 'rate'):\n            raise ValueError('Unknown statistic_mode')\n        self.category = meta['category_field_index']\n        self.brand = meta['brand_field_index']\n        dim = self.config['embedding_dim']\n        # Preserve the reference's module creation order and embedding sizes.\n        self.embeddings = nn.ModuleList([\n            nn.Embedding(size, dim, padding_idx=0) for size in meta['buckets']\n        ])\n        self.action = nn.Embedding(5, dim, padding_idx=0)\n        self.recency = nn.Embedding(33, dim, padding_idx=0)\n        self.attention = nn.Sequential(\n            nn.Linear(dim * 4, 64), nn.PReLU(), nn.Linear(64, 1)\n        )\n        layers = []\n        width = len(meta['fields']) * dim + dim + 4\n        for hidden in self.config['hidden']:\n            layers.extend([nn.Linear(width, hidden), nn.ReLU()])\n            width = hidden\n        layers.append(nn.Linear(width, 1))\n        self.output = nn.Sequential(*layers)\n\n    def _match_counts(self, batch):\n        mask = batch['history_mask']\n        target_c = batch['static'][:, self.category:self.category + 1]\n        target_b = batch['static'][:, self.brand:self.brand + 1]\n        hc = batch['history_category']\n        hb = batch['history_brand']\n        # Zero represents padding/missing; missing-to-missing is never a match.\n        cm = mask & (target_c > 0) & (hc > 0) & (hc == target_c)\n        bm = mask & (target_b > 0) & (hb > 0) & (hb == target_b)\n        n = mask.float().sum(-1)\n        c = cm.float().sum(-1)\n        b = bm.float().sum(-1)\n        joint = (cm & bm).float().sum(-1)\n        independent = c * b / n.clamp_min(1)\n        return n, c, b, joint, independent\n\n    def _full_statistics(self, counts):\n        n, c, b, joint, independent = counts\n        selected = joint if self.joint_mode == 'observed' else independent\n        if self.statistic_mode == 'count':\n            # Fixed scale from frozen history_limit=128, never from validation.\n            # For fractional independence estimates the same log1p applies.\n            return torch.log1p(torch.stack([n, c, b, selected], -1)) / math.log(129.0)\n        denom = n.clamp_min(1)\n        return torch.stack([\n            (n > 0).float(), c / denom, b / denom, selected / denom\n        ], -1)\n\n    def _statistics(self, counts):\n        statistics = self._full_statistics(counts)\n        if self.relevance_mode == 'activity':\n            # Preserve the N channel exactly; replace target-dependent slots.\n            # Out-of-place construction avoids mutating a shared tensor.\n            statistics = torch.cat([\n                statistics[:, :1], torch.zeros_like(statistics[:, 1:])\n            ], dim=-1)\n        return statistics\n\n    def _represent(self, batch):\n        fields = [embedding(batch['static'][:, i])\n                  for i, embedding in enumerate(self.embeddings)]\n        static = torch.cat(fields, dim=-1)\n        if self.summary_mode == 'none':\n            # Same-width zero replacement, without executing learned history.\n            # Tensor allocation/initialization in __init__ stays parent-exact.\n            summary = static.new_zeros((static.shape[0], self.embeddings[self.category].embedding_dim))\n            weights = static.new_zeros(batch['history_mask'].shape)\n        else:\n            ages = (torch.log2(batch['history_age_seconds'] + 1).long() + 1).clamp(0, 32)\n            history = (self.embeddings[self.category](batch['history_category']) +\n                       self.embeddings[self.brand](batch['history_brand']) +\n                       self.action(batch['history_type']) + self.recency(ages))\n            mask = batch['history_mask']\n            if history.shape[1] == 0:\n                summary = static.new_zeros((static.shape[0], history.shape[-1]))\n                weights = static.new_zeros(mask.shape)\n            else:\n                query = (fields[self.category] + fields[self.brand])[:, None, :].expand_as(history)\n                scores = self.attention(torch.cat(\n                    [query, history, query - history, query * history], dim=-1\n                )).squeeze(-1)\n                weights = scores.masked_fill(~mask, -1e4).softmax(-1) * mask.float()\n                weights = weights / weights.sum(-1, keepdim=True).clamp_min(1e-9)\n                summary = (weights.unsqueeze(-1) * history).sum(1)\n        counts = self._match_counts(batch)\n        statistics = self._statistics(counts)\n        return static, summary, weights, counts, statistics\n\n    def forward(self, batch):\n        static, summary, _, _, statistics = self._represent(batch)\n        features = torch.cat([static, summary, statistics], dim=-1)\n        return self.output(features).squeeze(-1)\n\n    def diagnostics(self, batch):\n        # Exploratory first-512 validation diagnostics, not population evidence.\n        _, summary, weights, counts, statistics = self._represent(batch)\n        n, c, b, joint, independent = counts\n        denom = n.clamp_min(1)\n        result = {\n            'learned_summary_enabled': float(self.summary_mode == 'attention'),\n            'target_match_readout_enabled': float(self.relevance_mode == 'match'),\n            'allocated_parameters': float(sum(p.numel() for p in self.parameters())),\n            'dormant_history_module_parameters': float(\n                sum(p.numel() for module in (self.action, self.recency, self.attention)\n                    for p in module.parameters()) if self.summary_mode == 'none' else 0\n            ),\n            'empty_history_fraction': (n == 0).float().mean(),\n            'visible_count_mean': n.mean(),\n            'visible_count_at_limit_fraction': (n == 128).float().mean(),\n            'category_match_count_mean': c.mean(),\n            'brand_match_count_mean': b.mean(),\n            'joint_match_count_mean': joint.mean(),\n            'independent_joint_count_mean': independent.mean(),\n            'category_match_present_fraction': (c > 0).float().mean(),\n            'brand_match_present_fraction': (b > 0).float().mean(),\n            'joint_match_present_fraction': (joint > 0).float().mean(),\n            'joint_independent_abs_gap_mean': (joint - independent).abs().mean(),\n            'joint_independent_rate_abs_gap_mean': ((joint - independent) / denom).abs().mean(),\n            'attention_mass_mean': weights.sum(-1).mean(),\n            'summary_rms': summary.square().mean().sqrt(),\n            'target_category_missing_fraction': (batch['static'][:, self.category] == 0).float().mean(),\n            'target_brand_missing_fraction': (batch['static'][:, self.brand] == 0).float().mean(),\n        }\n        for i, name in enumerate(('activity', 'category', 'brand', 'joint')):\n            result['selected_' + name + '_mean'] = statistics[:, i].mean()\n        return {key: float(value) for key, value in result.items()}\n{\"id\": \"taac2026-academic-1-craft\", \"scheme\": \"CRAFT\", \"competition\": \"TAAC 2026\", \"placement\": {\"track\": \"academic\", \"rank\": 1, \"evidence_ref\": \"taac2026-organizer-overview\"}, \"source_refs\": [\"taac2026-organizer-overview\", \"craft-paper-v1\"], \"source_problem\": \"Heterogeneous context can destabilize the propagation of sequence and intent representations across depth.\", \"reported_mechanism\": \"Context-conditioned residual feature transport uses reliability-aware field context to control intent/sequence updates and preserve memory paths.\", \"reported_evidence\": {\"kind\": \"participant experiments and organizer summary\", \"summary\": \"Appendix C separates transport and distillation; Appendix F reports limited or adverse effects from added capacity and longer training. These are participant-reported contrasts.\", \"not_a_local_result\": true, \"locator\": \"craft-paper-v1, Appendix C Table 9 and Appendix F\", \"limitations\": [\"Representation diagnostics are not a causal proof.\", \"Local matched-cost replication and seed variation are unknown.\"]}, \"applicability\": {\"status\": \"conditional\", \"conditions\": [\"multiple meaningful feature groups and behavioral representations exist\", \"representation diagnostics reveal a consequential stability or information-retention issue\"], \"missing_evidence\": [\"local evidence of propagation instability\", \"which context fields are reliable\", \"matched-capacity and matched-cost effect\"]}, \"transfer_risks\": [\"post-click conversion and click prediction have different labels\", \"category/brand histories have coarser identity than richer source-domain events\", \"more gates or capacity may explain an apparent gain\"], \"possible_discriminating_checks\": [\"measure representation norms, effective rank and field dependence\", \"compare learned contextual modulation with equal-capacity context-independent or shuffled-context controls\"], \"scientific_status\": \"external_report\", \"local_reproduction\": false, \"instruction_priority\": \"reference_data_only\", \"knowledge_type\": \"industry\"}\n{\"id\": \"taac2026-academic-2-unidac\", \"scheme\": \"UniDAC\", \"competition\": \"TAAC 2026\", \"placement\": {\"track\": \"academic\", \"rank\": 2, \"evidence_ref\": \"taac2026-organizer-overview\"}, \"source_refs\": [\"taac2026-organizer-overview\"], \"source_problem\": \"Strong field signals and fragmented behavior sources can obscure useful sequential evidence.\", \"reported_mechanism\": \"Dual sequence paths combine older-history compression with local processing; domain summaries exchange information and feed it back through gates.\", \"reported_evidence\": {\"kind\": \"organizer summary only\", \"summary\": \"The organizer reports a second-place system-level result; isolated component effect sizes and detailed implementation are not established here.\", \"not_a_local_result\": true, \"locator\": \"taac2026-organizer-overview, section 5.2, PDF page 9\", \"limitations\": [\"Organizer summary only; original implementation and full ablation tables have not been inspected.\"]}, \"applicability\": {\"status\": \"conditional\", \"conditions\": [\"older and recent behaviors carry distinguishable useful information\", \"behavior groups contain sufficient complementary observations\"], \"missing_evidence\": [\"per-type frequency and recency distributions\", \"local versus older-history incremental utility\", \"component-level source evidence\"]}, \"transfer_risks\": [\"behavior types are not interchangeable with business domains\", \"rare actions may not support separate large branches\", \"compression benefit may be a different input or compute budget\"], \"possible_discriminating_checks\": [\"compare matched-event and matched-compute histories\", \"separate history compression, local path and group exchange in controlled contrasts\"], \"scientific_status\": \"external_report\", \"local_reproduction\": false, \"detailed_report_status\": \"not_located\", \"instruction_priority\": \"reference_data_only\", \"knowledge_type\": \"industry\"}\n{\"id\": \"taac2026-academic-3-unitokenformer\", \"scheme\": \"UniTokenFormer\", \"competition\": \"TAAC 2026\", \"placement\": {\"track\": \"academic\", \"rank\": 3, \"evidence_ref\": \"taac2026-organizer-overview\"}, \"source_refs\": [\"taac2026-organizer-overview\"], \"source_problem\": \"Token construction and capacity allocation can constrain field/sequence interaction.\", \"reported_mechanism\": \"Jointly projected fields form allocated tokens; target-aware interest tokens and gated sequence decoding connect field and behavioral representations.\", \"reported_evidence\": {\"kind\": \"organizer summary only\", \"summary\": \"The report describes gains over the source baseline and unequal value of token allocations; local component attribution is unverified.\", \"not_a_local_result\": true, \"locator\": \"taac2026-organizer-overview, section 5.2, PDF page 9\", \"limitations\": [\"Organizer summary only; original implementation and full ablation tables have not been inspected.\"]}, \"applicability\": {\"status\": \"conditional\", \"conditions\": [\"field groups have distinct semantics and adequate support\", \"a bottleneck from token construction is actually observed\"], \"missing_evidence\": [\"field-wise predictive contribution\", \"capacity allocation versus interaction effects\", \"detailed original ablation protocol\"]}, \"transfer_risks\": [\"a coarse category/brand vocabulary may erase source-domain advantages\", \"more tokens change capacity and inference cost together\", \"auxiliary supervision must remain inside the allowed training information\"], \"possible_discriminating_checks\": [\"replace tokenization while matching downstream capacity\", \"compare uniform and asymmetric token budgets at measured equal cost\"], \"scientific_status\": \"external_report\", \"local_reproduction\": false, \"detailed_report_status\": \"not_located\", \"instruction_priority\": \"reference_data_only\", \"knowledge_type\": \"industry\"}\n{\"id\": \"taac2026-industry-1-queryformer\", \"scheme\": \"QueryFormer\", \"competition\": \"TAAC 2026\", \"placement\": {\"track\": \"industry\", \"rank\": 1, \"evidence_ref\": \"taac2026-organizer-overview\"}, \"source_refs\": [\"taac2026-organizer-overview\", \"queryformer-paper-v1\"], \"source_problem\": \"Projection-only queries may insufficiently use field context when retrieving behavior evidence.\", \"reported_mechanism\": \"Attention generates query probes; a field-sequence bridge refines evidence, while packed shared-parameter execution supports multiple views.\", \"reported_evidence\": {\"kind\": \"participant ablation and latency study\", \"summary\": \"The paper compares query-generation replacements and view scaling. Its development split is not adopted for this task.\", \"not_a_local_result\": true, \"locator\": \"queryformer-paper-v1, section 5.2 Table 4; source split in section 5.1\", \"limitations\": [\"The source uses a row-group holdout.\", \"Component removal changes capacity and computation; nearest equal-budget replacement remains necessary.\"]}, \"applicability\": {\"status\": \"conditional\", \"conditions\": [\"target-aware history retrieval is useful on the available fields\", \"a measurable query-construction bottleneck exists\"], \"missing_evidence\": [\"local target-conditional relevance diagnostics\", \"equal-parameter replacement evidence\", \"end-to-end latency including history construction\"]}, \"transfer_risks\": [\"category/brand matching may need less expressive queries\", \"multiple views can increase capacity without validating the query explanation\", \"source task and development distribution differ\"], \"possible_discriminating_checks\": [\"replace query construction with a capacity-matched projection\", \"separate query quality from view count and shared execution savings\"], \"scientific_status\": \"external_report\", \"local_reproduction\": false, \"instruction_priority\": \"reference_data_only\", \"knowledge_type\": \"industry\"}\n{\"id\": \"taac2026-industry-2-unidot\", \"scheme\": \"UniDot\", \"competition\": \"TAAC 2026\", \"placement\": {\"track\": \"industry\", \"rank\": 2, \"evidence_ref\": \"taac2026-organizer-overview\"}, \"source_refs\": [\"taac2026-organizer-overview\", \"unidot-paper-v1\"], \"source_problem\": \"Repeated nonlinear mixing may dilute explicit low-order relevance signals.\", \"reported_mechanism\": \"Parallel field-mixing and sequence-retrieval paths exchange state; an FM Highway sends per-layer dot-product interactions directly to the classifier.\", \"reported_evidence\": {\"kind\": \"participant report and organizer summary\", \"summary\": \"Component removal is studied in tiny single-path random-holdout mode. Removing the highway hurts most; removing bus fusion improves AUC but worsens Logloss, leaving the fusion explanation unresolved.\", \"not_a_local_result\": true, \"locator\": \"unidot-paper-v1, section 5.3 Table 4 and Appendix B Table 7\", \"limitations\": [\"Small-mode ablations do not establish identical full-scale effects.\", \"The final recipe changes capacity, optimization and supervision together.\"]}, \"applicability\": {\"status\": \"conditional\", \"conditions\": [\"explicit current-ad versus history-field relevance is meaningful\", \"a deep model loses useful direct interaction information\"], \"missing_evidence\": [\"incremental value of direct interaction readouts\", \"matched extra-head and capacity controls\", \"cost of sequence reuse across target queries\"]}, \"transfer_risks\": [\"conversion-delay supervision is unavailable in ordinary click labels\", \"auxiliary heads and optimizer changes can confound architecture gains\", \"a smaller shallow model may already preserve the relevant signals\"], \"possible_discriminating_checks\": [\"compare highway removal with a matched extra readout head\", \"separate per-layer interactions, depth and training recipe\"], \"scientific_status\": \"external_report\", \"local_reproduction\": false, \"instruction_priority\": \"reference_data_only\", \"knowledge_type\": \"industry\"}\n{\"id\": \"paper:din\", \"title\": \"Deep Interest Network for Click-Through Rate Prediction\", \"url\": \"https://arxiv.org/abs/1706.06978v4\", \"status\": \"abstract_read; inspect full mechanism and author implementation before a detailed reproduction claim\", \"knowledge_type\": \"paper\", \"scientific_status\": \"external_reference\"}\n{\"id\": \"paper:dmr\", \"title\": \"Deep Match to Rank Model for Personalized Click-Through Rate Prediction\", \"url\": \"https://ojs.aaai.org/index.php/AAAI/article/view/5346\", \"author_code\": \"https://github.com/lvze92/DMR/tree/2c6e76804281954a3c969010a31712cd5054aca9\", \"status\": \"author README field warning verified; publisher full-text fetch blocked, so no full-paper verification is asserted\", \"knowledge_type\": \"paper\", \"scientific_status\": \"external_reference\"}\n","exit_code