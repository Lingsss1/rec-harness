{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport ast,json\nsource=open('candidate.py').read()\na=ast.parse(source)\nmodel=next(n for n in a.body if isinstance(n,ast.ClassDef) and n.name=='Model')\nlines=source.splitlines(True)\nlines[model.lineno-1]=lines[model.lineno-1].replace('class Model(', 'class _RunParentModel(',1)\nbase=''.join(lines)\naddition='''\n\nclass Model(_RunParentModel):\n    \\\"\\\"\\\"Compact elapsed-gap / directed-behavior association on fixed support.\n\n    H[g,s,d] counts supported adjacent event pairs by gap and behavior types.\n    Product replacement preserves raw gap and behavior-pair margins within\n    each impression. It need not describe a realizable sequence; post-log\n    margins and norms need not match. All parent information is preserved.\n    \\\"\\\"\\\"\n    def __init__(self, meta, config=None):\n        super().__init__(meta, config)\n        if (self.serial_mode, self.run_mode) \"'!= ('\"'symmetric', 'zero'):\n            raise ValueError('Retain the whole run_zero incumbent')\n        self.action_gap_mode = self.config.get('action_gap_mode', 'joint')\n        if self.action_gap_mode not in ('joint', 'marginal'):\n            raise ValueError('Unknown action_gap_mode')\n        # Allocate strictly after every parent parameter and RNG draw. Both\n        # registered variants have the same head and initial parent function.\n        self.action_gap_head = nn.Sequential(\n            nn.Linear(64, 16, bias=False), nn.ReLU(),\n            nn.Linear(16, 1, bias=False))\n        nn.init.zeros_(self.action_gap_head[-1].weight)\n\n    def _action_gap_counts(self, batch):\n        \\\"\\\"\\\"O(BL log L) sorting, O(BL+B*64) memory; never an L-squared tensor.\n\n        Reuse complete-pair singleton timestamp support. Input position does\n        not define chronology, and filtering may bridge excluded events.\n        Target fields and positive identity values do not enter this branch.\n        \\\"\\\"\\\"\n        age = batch['history_age_seconds']\n        batch_size, length = age.shape\n        if length < 2:\n            return age.new_zeros((batch_size, 4, 4, 4))\n        eligible, order, _, _ = self._transition_support(batch)\n        valid = eligible.gather(1, order)\n        ordered_age = age.gather(1, order)\n        action = (batch['history_type'] - 1).clamp(0, 3).gather(1, order)\n        edge = valid[:, :-1] & valid[:, 1:]\n        gap = self._gap_bin(ordered_age[:, :-1] - ordered_age[:, 1:])\n        cell = 16 * gap + 4 * action[:, :-1] + action[:, 1:]\n        return age.new_zeros((batch_size, 64)).scatter_add(\n            1, cell, edge.float()).reshape(batch_size, 4, 4, 4)\n\n    def _action_gap_tables(self, counts):\n        gap = counts.sum((2, 3), keepdim=True)\n        pair = counts.sum(1, keepdim=True)\n        total = gap.sum(1, keepdim=True)\n        # Exact empirical product, INCLUDING fractional positive margins.\n        # No clamp-to-one denominator except when total is exactly zero.\n        marginal = gap * pair / self._positive_denominator(total)\n        return {'joint': counts, 'marginal': marginal}\n\n    def _action_gap_views(self, counts):\n        # Both alternatives and transforms are computed in every cell.\n        return {key: (torch.log1p(value) / math.log(129.0)).flatten(1)\n                for key, value in self._action_gap_tables(counts).items()}\n\n    def forward(self, batch):\n        parent = _RunParentModel.forward(self, batch)\n        features = self._action_gap_views(self._action_gap_counts(batch))\n        return parent + self.action_gap_head(features[self.action_gap_mode]).squeeze(-1)\n\n    def _action_gap_reference(self, batch):\n        \\\"\\\"\\\"Independent scalar rank oracle, <=8 rows in diagnostics only.\n\n        Explicit time multiplicities/ranks identify adjacent singleton times,\n        independently of the production sort/compaction/scatter algorithm.\n        No filesystem, labels or external state is accessed.\n        \\\"\\\"\\\"\n        age = batch['history_age_seconds']\n        result = []\n        rows = zip(age.tolist(), batch['history_category'].tolist(),\n                   batch['history_brand'].tolist(), batch['history_type'].tolist(),\n                   batch['history_mask'].tolist())\n        for ages, categories, brands, actions, masks in rows:\n            complete = [i for i in range(len(ages))\n                        if masks[i] and categories[i] > 0 and brands[i] > 0]\n            eligible = [i for i in complete\n                        if sum(ages[i] == ages[j] for j in complete) == 1]\n            rank = {i: sum(ages[j] > ages[i] for j in eligible) for i in eligible}\n            table = [[[0.0] * 4 for _ in range(4)] for _ in range(4)]\n            for i in eligible:\n                for j in eligible:\n                    if rank[j] \"'!= rank[i] + 1:\n                        continue\n                    delta = ages[i] - ages[j]\n                    gap = int(delta > 60.0) + int(delta > 3600.0) + int(delta > 86400.0)\n                    table[gap][actions[i] - 1][actions[j] - 1] += 1.0\n            result.append(table)\n        return age.new_tensor(result)\n\n    def _action_gap_witness(self, batch):\n        # Identical actions and coarse/log2 event-age bins. The two gap lists\n        # also preserve the FULL directed serial-gap table, gap margins and\n        # action transition table; only which action pair gets a gap changes.\n        ages = [[3000, 2990, 2890, 2880, 2780, 2770, 2760, 2750, 2740],\n                [3000, 2990, 2890, 2880, 2870, 2770, 2760, 2750, 2740]]\n        actions = [1, 1, 2, 2, 1, 2, 1, 1, 2]\n        device = batch['\"'static'].device\n        return {\n            'static': batch['static'][:1].expand(2, -1).clone(),\n            'history_category': torch.ones((2, 9), dtype=torch.long, device=device),\n            'history_brand': torch.ones((2, 9), dtype=torch.long, device=device),\n            'history_type': torch.tensor([actions, actions], dtype=torch.long, device=device),\n            'history_age_seconds': torch.tensor(ages, dtype=batch['history_age_seconds'].dtype, device=device),\n            'history_mask': torch.ones((2, 9), dtype=torch.bool, device=device),\n        }\n\n    def diagnostics(self, batch):\n        \\\"\\\"\\\"Candidate-supplied scope-limited checks, never evidence of efficacy.\n\n        Oracle/witness checks are outside timed inference. Parent-logit\n        equality on one witness demonstrates local aliasing only. Read this\n        source and matched controls before interpreting any measured scalar.\n        \\\"\\\"\\\"\n        counts = self._action_gap_counts(batch)\n        tables = self._action_gap_tables(counts)\n        views = self._action_gap_views(counts)\n        selected = views[self.action_gap_mode]\n        residual = self.action_gap_head(selected).squeeze(-1)\n        _, _, n, complete = self._transition_support(batch)\n        transition = self._transition_tables(batch)[0][0]\n        action_margin = transition.reshape(-1, 4, 4, 4, 4).sum((1, 3))\n        gap_margin = self._direct_gap_counts(batch)[:, 0, :, 0]\n        probe_size = min(8, batch['static'].shape[0])\n        probe = {key: value[:probe_size] for key, value in batch.items()}\n        marginal = tables['marginal']\n        total = counts.sum((1, 2, 3))\n        result = {\n            'allocated_parameters': float(sum(p.numel() for p in self.parameters())),\n            'action_gap_head_parameters': float(sum(p.numel() for p in self.action_gap_head.parameters())),\n            'action_gap_input_coordinates': float(selected.shape[-1]),\n            'mode_joint': float(self.action_gap_mode == 'joint'),\n            'mode_marginal': float(self.action_gap_mode == 'marginal'),\n            'scalar_oracle_impressions': float(probe_size),\n            'scalar_oracle_error_max': (counts[:probe_size] - self._action_gap_reference(probe)).abs().max(),\n            'edge_conservation_error_max': (total - (n - 1).clamp_min(0)).abs().max(),\n            'parent_gap_margin_error_max': (counts.sum((2, 3)) - gap_margin).abs().max(),\n            'parent_action_pair_margin_error_max': (counts.sum(1) - action_margin).abs().max(),\n            'product_gap_margin_error_max': (counts.sum((2, 3)) - marginal.sum((2, 3))).abs().max(),\n            'product_action_pair_margin_error_max': (counts.sum(1) - marginal.sum(1)).abs().max(),\n            'product_nonnegative_violation_max': (-marginal).clamp_min(0).max(),\n            'observed_product_raw_difference_mean': (counts - marginal).abs().mean(),\n            'observed_product_feature_difference_mean': (views['joint'] - views['marginal']).abs().mean(),\n            'joint_feature_norm_mean': views['joint'].square().sum(-1).sqrt().mean(),\n            'marginal_feature_norm_mean': views['marginal'].square().sum(-1).sqrt().mean(),\n            'selected_feature_rms': selected.square().mean().sqrt(),\n            'selected_residual_rms': residual.square().mean().sqrt(),\n            'zero_input_residual_abs_max': self.action_gap_head(torch.zeros_like(selected)).abs().max(),\n            'residual_finite_fraction': torch.isfinite(residual).float().mean(),\n            'supported_history_fraction': (n >= 2).float().mean(),\n            'complete_events_mean': complete.float().sum(-1).mean(),\n            'supported_events_mean': n.float().mean(),\n            'supported_edges_mean': total.mean(),\n            'non_pv_edge_fraction': (total - counts[:, :, 0, 0].sum(1)).sum() / total.sum().clamp_min(1),\n            'action_switch_edge_fraction': (total - counts.diagonal(dim1=2, dim2=3).sum((1, 2))).sum() / total.sum().clamp_min(1),\n        }\n        reverse, padded, zero_length, one_event = (dict(batch) for _ in range(4))\n        for key in ('history_category', 'history_brand', 'history_type', 'history_age_seconds', 'history_mask'):\n            reverse[key] = batch[key].flip(-1)\n            zero_length[key] = batch[key][:, :0]\n            one_event[key] = batch[key][:, :1]\n            fill = batch[key].new_zeros((batch[key].shape[0], 2))\n            if key \"'!= '\"'history_mask':\n                fill.fill_(1)\n            padded[key] = torch.cat([batch[key], fill], -1)\n        result['reordering_count_error_max'] = (counts - self._action_gap_counts(reverse)).abs().max()\n        result['padding_count_error_max'] = (counts - self._action_gap_counts(padded)).abs().max()\n        result['zero_length_count_abs_max'] = self._action_gap_counts(zero_length).abs().max()\n        result['single_event_count_abs_max'] = self._action_gap_counts(one_event).abs().max()\n        for label, key in (('empty', 'history_mask'), ('missing_category', 'history_category'),\n                           ('missing_brand', 'history_brand'), ('all_tied', 'history_age_seconds')):\n            altered = dict(batch)\n            altered[key] = torch.zeros_like(batch[key])\n            result[label + '_count_abs_max'] = self._action_gap_counts(altered).abs().max()\n        changed = dict(batch)\n        changed['static'] = torch.zeros_like(batch['static'])\n        result['target_invariance_error_max'] = (counts - self._action_gap_counts(changed)).abs().max()\n        renamed = dict(batch)\n        for key in ('history_category', 'history_brand'):\n            renamed[key] = (batch[key] > 0).long()\n        result['positive_identity_coarsening_error_max'] = (counts - self._action_gap_counts(renamed)).abs().max()\n        shifted = dict(batch)\n        shifted['history_age_seconds'] = batch['history_age_seconds'] + 1024.0\n        result['common_age_shift_count_error_max'] = (counts - self._action_gap_counts(shifted)).abs().max()\n        witness = self._action_gap_witness(batch)\n        wc = self._action_gap_counts(witness)\n        wv = self._action_gap_views(wc)\n        result['witness_scalar_oracle_error_max'] = (wc - self._action_gap_reference(witness)).abs().max()\n        result['witness_gap_margin_error_max'] = (wc[0].sum((1, 2)) - wc[1].sum((1, 2))).abs().max()\n        result['witness_action_pair_margin_error_max'] = (wc[0].sum(0) - wc[1].sum(0)).abs().max()\n        serial = self._serial_counts(witness)\n        timing = self._timing_counts(witness)\n        result['witness_directed_serial_error_max'] = (serial[0] - serial[1]).abs().max()\n        result['witness_timing_table_error_max'] = (timing[0] - timing[1]).abs().max()\n        result['witness_joint_feature_gap_max'] = (wv['joint'][0] - wv['joint'][1]).abs().max()\n        result['witness_marginal_feature_gap_max'] = (wv['marginal'][0] - wv['marginal'][1]).abs().max()\n        parent = _RunParentModel.forward(self, witness)\n        result['witness_whole_parent_logit_error_max'] = (parent[0] - parent[1]).abs()\n        wr = self.action_gap_head(wv[self.action_gap_mode]).squeeze(-1)\n        result['witness_selected_residual_gap'] = (wr[0] - wr[1]).abs()\n        if len(result) > 64:\n            raise ValueError('Diagnostic scalar budget exceeded')\n        return {key: float(value) for key, value in result.items()}\n'''\np=json.load(open('proposal.json'))\nconfig_assign=next(n for n in ast.parse(base).body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets))\nfor v in p['variants']:\n parts=base.splitlines(True)\n parts[config_assign.lineno-1]='CONFIG = '+repr(v['config'])+'\\\\n'\n open(v['file'],'w').write(''.join(parts)+addition)\n print(v['file'],'written')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport ast,json\nsource=open('candidate.py').read()\na=ast.parse(source)\nmodel=next(n for n in a.body if isinstance(n,ast.ClassDef) and n.name=='Model')\nlines=source.splitlines(True)\nlines[model.lineno-1]=lines[model.lineno-1].replace('class Model(', 'class _RunParentModel(',1)\nbase=''.join(lines)\naddition='''\n\nclass Model(_RunParentModel):\n    \\\"\\\"\\\"Compact elapsed-gap / directed-behavior association on fixed support.\n\n    H[g,s,d] counts supported adjacent event pairs by gap and behavior types.\n    Product replacement preserves raw gap and behavior-pair margins within\n    each impression. It need not describe a realizable sequence; post-log\n    margins and norms need not match. All parent information is preserved.\n    \\\"\\\"\\\"\n    def __init__(self, meta, config=None):\n        super().__init__(meta, config)\n        if (self.serial_mode, self.run_mode) \"'!= ('\"'symmetric', 'zero'):\n            raise ValueError('Retain the whole run_zero incumbent')\n        self.action_gap_mode = self.config.get('action_gap_mode', 'joint')\n        if self.action_gap_mode not in ('joint', 'marginal'):\n            raise ValueError('Unknown action_gap_mode')\n        # Allocate strictly after every parent parameter and RNG draw. Both\n        # registered variants have the same head and initial parent function.\n        self.action_gap_head = nn.Sequential(\n            nn.Linear(64, 16, bias=False), nn.ReLU(),\n            nn.Linear(16, 1, bias=False))\n        nn.init.zeros_(self.action_gap_head[-1].weight)\n\n    def _action_gap_counts(self, batch):\n        \\\"\\\"\\\"O(BL log L) sorting, O(BL+B*64) memory; never an L-squared tensor.\n\n        Reuse complete-pair singleton timestamp support. Input position does\n        not define chronology, and filtering may bridge excluded events.\n        Target fields and positive identity values do not enter this branch.\n        \\\"\\\"\\\"\n        age = batch['history_age_seconds']\n        batch_size, length = age.shape\n        if length < 2:\n            return age.new_zeros((batch_size, 4, 4, 4))\n        eligible, order, _, _ = self._transition_support(batch)\n        valid = eligible.gather(1, order)\n        ordered_age = age.gather(1, order)\n        action = (batch['history_type'] - 1).clamp(0, 3).gather(1, order)\n        edge = valid[:, :-1] & valid[:, 1:]\n        gap = self._gap_bin(ordered_age[:, :-1] - ordered_age[:, 1:])\n        cell = 16 * gap + 4 * action[:, :-1] + action[:, 1:]\n        return age.new_zeros((batch_size, 64)).scatter_add(\n            1, cell, edge.float()).reshape(batch_size, 4, 4, 4)\n\n    def _action_gap_tables(self, counts):\n        gap = counts.sum((2, 3), keepdim=True)\n        pair = counts.sum(1, keepdim=True)\n        total = gap.sum(1, keepdim=True)\n        # Exact empirical product, INCLUDING fractional positive margins.\n        # No clamp-to-one denominator except when total is exactly zero.\n        marginal = gap * pair / self._positive_denominator(total)\n        return {'joint': counts, 'marginal': marginal}\n\n    def _action_gap_views(self, counts):\n        # Both alternatives and transforms are computed in every cell.\n        return {key: (torch.log1p(value) / math.log(129.0)).flatten(1)\n                for key, value in self._action_gap_tables(counts).items()}\n\n    def forward(self, batch):\n        parent = _RunParentModel.forward(self, batch)\n        features = self._action_gap_views(self._action_gap_counts(batch))\n        return parent + self.action_gap_head(features[self.action_gap_mode]).squeeze(-1)\n\n    def _action_gap_reference(self, batch):\n        \\\"\\\"\\\"Independent scalar rank oracle, <=8 rows in diagnostics only.\n\n        Explicit time multiplicities/ranks identify adjacent singleton times,\n        independently of the production sort/compaction/scatter algori