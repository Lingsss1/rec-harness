_evidence\": {\n        \"kind\": \"participant report and organizer summary\",\n        \"summary\": \"Component removal is studied in tiny single-path random-holdout mode. Removing the highway hurts most; removing bus fusion improves AUC but worsens Logloss, leaving the fusion explanation unresolved.\",\n        \"not_a_local_result\": true,\n        \"locator\": \"unidot-paper-v1, section 5.3 Table 4 and Appendix B Table 7\",\n        \"limitations\": [\n          \"Small-mode ablations do not establish identical full-scale effects.\",\n          \"The final recipe changes capacity, optimization and supervision together.\"\n        ]\n      },\n      \"applicability\": {\n        \"status\": \"conditional\",\n        \"conditions\": [\n          \"explicit current-ad versus history-field relevance is meaningful\",\n          \"a deep model loses useful direct interaction information\"\n        ],\n        \"missing_evidence\": [\n          \"incremental value of direct interaction readouts\",\n          \"matched extra-head and capacity controls\",\n          \"cost of sequence reuse across target queries\"\n        ]\n      },\n      \"transfer_risks\": [\n        \"conversion-delay supervision is unavailable in ordinary click labels\",\n        \"auxiliary heads and optimizer changes can confound architecture gains\",\n        \"a smaller shallow model may already preserve the relevant signals\"\n      ],\n      \"possible_discriminating_checks\": [\n        \"compare highway removal with a matched extra readout head\",\n        \"separate per-layer interactions, depth and training recipe\"\n      ],\n      \"scientific_status\": \"external_report\",\n      \"local_reproduction\": false,\n      \"instruction_priority\": \"reference_data_only\",\n      \"knowledge_type\": \"industry\"\n    }\n  ],\n  \"scores\": [\n    {\n      \"id\": \"taac2026-academic-2-unidac\",\n      \"knowledge_type\": \"industry\",\n      \"score\": 1.2247809845718998,\n      \"indexed_