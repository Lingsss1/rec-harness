es=[[]]\n# Full support lengths0..128; missing fields,ties,padding and all actions.\nfor length in range(129):\n for family in range(4):\n  ages=[];age=0\n  for i in range(length):\n   age+=rng.choice([0,1,59,60,61,3599,3600,3601,86399,86400,86401])\n   ages.append(age)\n  e=[(a,rng.randrange(0,5) if family==0 else 1,rng.randrange(0,6) if family==1 else 2,rng.randrange(1,5),rng.random()>.15 if family==2 else True) for a in ages]\n  if family==3:e=[(1234,c,b,t,m) for a,c,b,t,m in e]\n  rng.shuffle(e);cases.append(e)\nfor delta in [1,59,60,61,3599,3600,3601,86399,86400,86401]:\n cases.append([(300000,1,2,1,True),(300000-delta,1,2,4,True)])\nmax_margin=0;transforms=0\nfor events in cases:\n h,support=scalar_twin(events)\n assert h==source_oracle(events)\n gap,pair=margins(h)\n assert sum(gap)==max(len(support)-1,0)\n assert sum(sum(row) for row in pair)==sum(gap)\n ph=product(h);pg,pp=margins(ph)\n max_margin=max(max_margin,max([abs(x-y) for x,y in zip(gap,pg)]+[abs(pair[s][d]-pp[s][d]) for s in range(4) for d in range(4)]))\n assert max_margin<1e-11\n changed=list(events);rng.shuffle(changed)\n transforms_list=[changed,events+[(999999,7,8,4,False),(0,1,1,1,False)],[(a+1024,c,b,t,m) for a,c,b,t,m in events],[(a,int(c>0),int(b>0),t,m) for a,c,b,t,m in events]]\n for e in transforms_list:\n  assert scalar_twin(e)[0]==h\n  transforms+=1\n# Independently enumerate the exact gap-label permutation expectation on\n# small histories with no ties. This tests replacement beyond row sums.\npermutation_cases=0;max_expectation=0\nfor edge_count in range(1,8):\n for rep in range(4):\n  gaps=[rng.randrange(4) for _ in range(edge_count)]\n  actions=[rng.randrange(4) for _ in range(edge_count+1)]\n  h=[[[0.0]*4 for _ in range(4)] for _ in range(4)]\n  for i,g in enumerate(gaps):h[g][actions[i]][actions[i+1]]+=1\n  expected=product(h)\n  acc=[[[0.0]*4 for _ in range(4)] for _ in range(4)];nperm=0\n  for perm in itertools.permutations(gaps):\n   nperm+=1\n   for i,g in enumerate(perm):acc[g][actions[i]][actions[i+1]]+=1\n  acc=[[[x/nperm for x in s] for s in g] for g in acc]\n  max_expectation=max(max_expectation,maxerr(acc,expected));permutation_cases+=1\nassert max_expectation<1e-12\n# Same-parent witness: parent neural event features and all temporal inputs\n# invariant; no use of checkpoint scores or labels here.\nages=[[3000,2990,2890,2880,2780,2770,2760,2750,2740],\n      [3000,2990,2890,2880,2870,2770,2760,2750,2740]]\nactions=[1,1,2,2,1,2,1,1,2]\nw=[[(a,1,1,t,True) for a,t in zip(row,actions)] for row in ages]\nwcounts=[scalar_twin(e)[0] for e in w]\nassert wcounts[0]\"'!=wcounts[1]\nassert margins(wcounts[0])==margins(wcounts[1])\nassert product(wcounts[0])==product(wcounts[1])\ndef parent_signature(events):\n times=sorted(events,reverse=True)\n gap=[sum(a[0]-b[0]>t for t in (60,3600,86400)) for a,b in zip(times,times[1:])]\n serial=collections.Counter(zip(gap,gap[1:]))\n timing=collections.Counter((g,sum(e[0]>=t for t in (3600,86400,604800))) for g,e in zip(gap,times[1:]))\n event_features=[(c,b,t,int(math.log2(a+1))+1,sum(a>=v for v in (3600,86400,604800))) for a,c,b,t,m in events]\n # Each identity/group is constant. These event features determine all\n # inherited non-temporal means,histograms,identity/context/repeat/overlap.\n return event_features,collections.Counter(gap),serial,timing,collections.Counter(zip(actions,actions[1:]))\nassert parent_signature(w[0])==parent_signature(w[1])\nfeatures=[list(map(lambda x:math.log1p(x)/math.log(129),flat(c))) for c in wcounts]\ngap=max(abs(a-b) for a,b in zip(*features))\nprint(json.dumps({'\"'histories_checked':len(cases),'transformed_histories_checked':transforms,'source_scalar_oracle_matches':len(cases),'raw_product_margin_max_error':max_margin,'enumerated_permutation_cases':permutation_cases,'permutation_expectation_max_error':max_expectation,'witness_parent_sufficient_statistics_equal':True,'witness_joint_feature_gap_max':gap,'witness_product_feature_gap_max':0.0,'scope':'pure Python scalar analogues and actual scalar oracle,not Torch/CUDA execution'},indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
