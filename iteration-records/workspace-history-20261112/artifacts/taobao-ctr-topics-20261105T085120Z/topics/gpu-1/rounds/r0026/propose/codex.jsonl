                      self._serial_views(inherited[3])[self.serial_mode])\n        for name, a, b in zip(names, new_features, old_features):\n            d[name + '_feature_error_max'] = maximum(a - b)\n        legacy_logit = _ExecutionParentModel.forward(self, batch)\n        shared_logit = self._shared_temporal_forward(batch)\n        d['same_checkpoint_logit_error_max'] = maximum(legacy_logit - shared_logit)\n        d['legacy_finite_fraction'] = torch.isfinite(legacy_logit).float().mean()\n        d['shared_finite_fraction'] = torch.isfinite(shared_logit).float().mean()\n        d['same_checkpoint_probability_error_max'] = maximum(legacy_logit.sigmoid() - shared_logit.sigmoid())\n        age = batch['history_age_seconds']\n        n = min(8, age.shape[0])\n        small = {k: v[:n] for k, v in batch.items()}\n        row_values = zip(small['history_age_seconds'].tolist(), small['history_category'].tolist(),\n                         small['history_brand'].tolist(), small['history_type'].tolist(),\n                         small['history_mask'].tolist(), small['static'][:, self.category].tolist(),\n                         small['static'][:, self.brand].tolist())\n        oracle = [self._scalar_temporal_row(*row) for row in row_values]\n        small_tables = self._temporal_trunk(small)\n        d['scalar_oracle_impressions'] = float(n)\n        for j, (name, value) in enumerate(zip(names, small_tables)):\n            reference = age.new_tensor([row[j] for row in oracle])\n            d[name + '_scalar_error_max'] = maximum(value.flatten(1) - reference)\n        keys = ('history_age_seconds', 'history_category', 'history_brand', 'history_type', 'history_mask')\n        reordered = dict(batch)\n        for key in keys:\n            reordered[key] = batch[key].flip(1)\n        d['reordering_raw_error_max'] = torch.stack([\n            maximum(a - b) for a, b in zip(shared, self._temporal_trunk(reordered))]).max()\n        padded = dict(batch)\n        for key in ke