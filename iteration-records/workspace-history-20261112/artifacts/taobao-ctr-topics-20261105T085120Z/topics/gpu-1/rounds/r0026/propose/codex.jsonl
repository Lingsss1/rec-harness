{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport ast\np=Path('/workspace/candidate.py')\ns=p.read_text(); t=ast.parse(s)\nlast=[n for n in t.body if isinstance(n,ast.ClassDef) and n.name=='Model'][0]\nlines=s.splitlines(keepends=True); lines[last.lineno-1]=lines[last.lineno-1].replace('class Model(', 'class _ExecutionParentModel(')\ns=''.join(lines)\nconfig=next(n for n in t.body if isinstance(n,ast.Assign) and any(isinstance(x,ast.Name) and x.id=='CONFIG' for x in n.targets))\ncfg=ast.literal_eval(config.value); cfg['temporal_execution']='shared'\nlines=s.splitlines(keepends=True); lines[config.lineno-1]='CONFIG = '+repr(cfg)+'\\\\n'; s=''.join(lines)\ns += '''\n\nclass Model(_ExecutionParentModel):\n    \\\"\\\"\\\"Exact selected temporal statistics from one ephemeral chronology.\n\n    Computational representation change only: all model parameters, selected\n    statistics, transforms and head addition order are inherited. Counterfactual\n    tables are unnecessary for the selected function. No cache, persistent\n    batch state, fitted statistics, new RNG draws or training recipe changes.\n    \\\"\\\"\\\"\n    def __init__(self, meta, config=None):\n        super().__init__(meta, config)\n        self.temporal_execution = self.config.get('temporal_execution', 'shared')\n        if self.temporal_execution not in ('shared', 'legacy'):\n            raise ValueError('Unknown temporal_execution')\n        expected = {\n            'transition_order': 'chronological', 'transition_pairing': 'product',\n            'gap_execution': 'direct', 'gap_parameterization': 'lifted',\n            'gap_resolution': 'global', 'gap_channels': 'all',\n            'product_scope': 'pooled', 'gap_association': 'observed',\n            'timing_mode': 'joint', 'serial_mode': 'symmetric', 'run_mode': 'zero'}\n        if any(self.config.get(k) \"'!= v for k, v in expected.items()):\n            raise ValueError('\"'Shared executor requires exact registered incumbent')\n\n    def _temporal_trunk(self, batch):\n        \\\"\\\"\\\"Return transition N,C,B; pooled gap N,C,B,product; timing; serial.\n\n        All counts use ONE invocation of the unchanged support procedure.\n        Separate scatter reductions retain the legacy binning and arithmetic;\n        no product is formed before pooling. Total memory O(BL+B*768).\n        Discrete statistics carry no parameter gradients in either executor.\n        \\\"\\\"\\\"\n        age = batch['history_age_seconds']\n        batch_size, length = age.shape\n        transition = age.new_zeros((batch_size, 3, 16, 16))\n        gap_counts = age.new_zeros((batch_size, 4, 4, 1))\n        timing = age.new_zeros((batch_size, 4, 4))\n        serial = age.new_zeros((batch_size, 4, 4))\n        if length < 2:\n            return transition, gap_counts, timing, serial\n        eligible, order, _, _ = self._transition_support(batch)\n        valid = eligible.gather(1, order)\n        ordered_age = age.gather(1, order)\n        ordered_c = batch['history_category'].gather(1, order)\n        ordered_b = batch['history_brand'].gather(1, order)\n        group = self._membership(batch)[1].argmax(dim=1)\n        cell = 4 * group + (batch['history_type'] - 1).clamp(0, 3)\n        ordered_cell = cell.gather(1, order)\n        edge = valid[:, :-1] & valid[:, 1:]\n        gap = self._gap_bin(ordered_age[:, :-1] - ordered_age[:, 1:])\n        destination = 16 * ordered_cell[:, :-1] + ordered_cell[:, 1:]\n        same_c = ordered_c[:, :-1] == ordered_c[:, 1:]\n        same_b = ordered_b[:, :-1] == ordered_b[:, 1:]\n        transitions, gaps = [], []\n        for match in (torch.ones_like(edge), same_c, same_b):\n            mass = (edge & match).float()\n            transitions.append(age.new_zeros((batch_size, 256)).scatter_add(\n                1, destination, mass).reshape(batch_size, 16, 16))\n            gaps.append(age.new_zeros((batch_size, 4)).scatter_add(1, gap, mass))\n        transition = torch.stack(transitions, dim=1)\n        total, category, brand = gaps\n        product = category * brand / self._positive_denominator(total)\n        gap_counts = torch.stack([total, category, brand, product], dim=1).unsqueeze(-1)\n        recency = self._endpoint_age_bin(ordered_age[:, 1:])\n        timing = age.new_zeros((batch_size, 16)).scatter_add(\n            1, 4 * gap + recency, edge.float()).reshape(batch_size, 4, 4)\n        if length >= 3:\n            triple = valid[:, :-2] & valid[:, 1:-1] & valid[:, 2:]\n            serial = age.new_zeros((batch_size, 16)).scatter_add(\n                1, 4 * gap[:, :-1] + gap[:, 1:], triple.float()).reshape(batch_size, 4, 4)\n        return transition, gap_counts, timing, serial\n\n    def _trunk_features(self, tables):\n        transition, gap, timing, serial = tables\n        # Same arithmetic/shape/order as the selected legacy readouts.\n        product = transition[:, 1] * transition[:, 2] / transition[:, 0].clamp_min(1)\n        t = torch.stack([transition[:, 0], transition[:, 1], transition[:, 2], product], dim=1)\n        t = torch.log1p(t.flatten(1)) / math.log(129.0)\n        g = self._gap_lift(gap)\n        a = (torch.log1p(timing) / math.log(129.0)).flatten(1)\n        symmetric = (serial + serial.transpose(-1, -2)) * 0.5\n        q = (torch.log1p(symmetric) / math.log(129.0)).flatten(1)\n        return t, g, a, q\n\n    def _shared_temporal_forward(self, batch):\n        # Preserve legacy left-to-right additions, including its zero head.\n        parent = self._parent_forward(batch)\n        t, g, a, q = self._trunk_features(self._temporal_trunk(batch))\n        result = parent + self.transition_head(t).squeeze(-1)\n        result = result + self.gap_head(g).squeeze(-1)\n        result = result + self.timing_head(a).squeeze(-1)\n        result = result + self.serial_head(q).squeeze(-1)\n        # Execute the same zero-input head, preserving zero gradient tensors\n        # and Adam state behavior. Only unused run extraction is removed.\n        zero = batch['history_age_seconds'].new_zeros((parent.shape[0], 24))\n        return result + self.run_head(zero).squeeze(-1)\n\n    def forward(self, batch):\n        if self.temporal_execution == 'legacy':\n            return _ExecutionParentModel.forward(self, batch)\n        return self._shared_temporal_forward(batch)\n\n    @staticmethod\n    def _scalar_temporal_row(ages, categories, brands, actions, masks, target_c, target_b):\n        \\\"\\\"\\\"Independent list/dictionary oracle; diagnostic use only.\n\n        Input values are supplied fields, no labels. Timestamp multiplicities\n        replace tensor neighbor-equality and compaction. Python arithmetic\n        double precision differs from float32 fractional products.\n        \\\"\\\"\\\"\n        events = [(a, c, b, h) for a, c, b, h, m in\n                  zip(ages, categories, brands, actions, masks) if m and c > 0 and b > 0]\n        multiplicity = {}\n        for a, _, _, _ in events:\n            multiplicity[a] = multiplicity.get(a, 0) + 1\n        events = sorted([e for e in events if multiplicity[e[0]] == 1], reverse=True)\n        transition = [[0.0] * 256 for _ in range(3)]\n        gap = [[0.0] * 4 for _ in range(3)]\n        timing, serial = [0.0] * 16, [0.0] * 16\n        gap_sequence = []\n        def cell(e):\n            cm = target_c > 0 and e[1] == target_c\n            bm = target_b > 0 and e[2] == target_b\n            return 4 * (int(cm) + 2 * int(bm)) + min(max(int(e[3]) - 1, 0), 3)\n        for old, new in zip(events, events[1:]):\n            delta = old[0] - new[0]\n            g = sum(delta > threshold for threshold in (60.0, 3600.0, 86400.0))\n            a = sum(new[0] >= threshold for threshold in (3600.0, 86400.0, 604800.0))\n            index = 16 * cell(old) + cell(new)\n            for k, yes in enumerate((True, old[1] == new[1], old[2] == new[2])):\n                if yes:\n                    transition[k][index] += 1.0\n                    gap[k][g] += 1.0\n            timing[4 * g + a] += 1.0\n            gap_sequence.append(g)\n        for old, new in zip(gap_sequence, gap_sequence[1:]):\n            serial[4 * old + new] += 1.0\n        gap.append([gap[1][i] * gap[2][i] / (gap[0][i] if gap[0][i] > 0 else 1.0)\n                    for i in range(4)])\n        return ([v for row in transition for v in row],\n                [v for row in gap for v in row], timing, serial)\n\n    def diagnostics(self, batch):\n        \\\"\\\"\\\"Bounded host-only checks; no timing or independent scoring claim.\n\n        All same-checkpoint comparisons use exactly the same parameter objects.\n        Full host training/validation still decides quality and actual cost.\n        \\\"\\\"\\\"\n        def maximum(x):\n            return x.abs().max() if x.numel() else x.new_zeros(())\n        names = ('transition', 'gap', 'timing', 'serial')\n        shared = self._temporal_trunk(batch)\n        old_transition = self._transition_tables(batch)\n        inherited = (torch.stack(old_transition[0][:3], dim=1),\n                     self._direct_gap_counts(batch), self._timing_counts(batch),\n                     self._serial_counts(batch))\n        d = {\n            'allocated_parameters': float(sum(p.numel() for p in self.parameters())),\n            'new_parameters': 0.0,\n            'mode_shared': float(self.temporal_execution == 'shared'),\n            'source_support_calls_shared_nontrivial': 1.0,\n            'source_support_calls_legacy_nontrivial': 5.0}\n        for name, a, b in zip(names, shared, inherited):\n            d[name + '_raw_error_max'] = maximum(a - b)\n        new_features = self._trunk_features(shared)\n        old_features = (self._transition_features(old_transition),\n                        self._selected_gap_features(batch),\n                        self._timing_views(inherited[2])[self.timing_mode],\n                        self._serial_views(inherited[3])[self.serial_mode])\n        for name, a, b in zip(names, new_features, old_features):\n            d[name + '_feature_error_max'] = maximum(a - b)\n        legacy_logit = _ExecutionParentModel.forward(self, batch)\n        shared_logit = self._shared_temporal_forward(batch)\n        d['same_checkpoint_logit_error_max'] = maximum(legacy_logit - shared_logit)\n        d['legacy_finite_fraction'] = torch.isfinite(legacy_logit).float().mean()\n        d['shared_finite_fraction'] = torch.isfinite(shared_logit).float().mean()\n        d['same_checkpoint_probability_error_max'] = maximum(legacy_logit.sigmoid() - shared_logit.sigmoid())\n        age = batch['history_age_seconds']\n        n = min(8, age.shape[0])\n        small = {k: v[:n] for k, v in batch.items()}\n        row_values = zip(small['history_age_seconds'].tolist(), small['history_category'].tolist(),\n                         small['history_brand'].tolist(), small['history_type'].tolist(),\n                         small['history_mask'].tolist(), small['static'][:, self.category].tolist(),\n                         small['static'][:, self.brand].tolist())\n        oracle = [self._scalar_temporal_row(*row) for row in row_values]\n        small_tables = self._temporal_trunk(small)\n        d['scalar_oracle_impressions'] = float(n)\n        for j, (name, value) in enumerate(zip(names, small_tables)):\n            reference = age.new_tensor([row[j] for row in oracle])\n            d[name + '_scalar_error_max'] = maximum(value.flatten(1) - reference)\n        keys = ('history_age_seconds', 'history_category', 'history_brand', 'history_type', 'history_mask')\n        reordered = dict(batch)\n        for key in keys:\n            reordered[key] = batch[key].flip(1)\n        d['reordering_raw_error_max'] = torch.stack([\n            maximum(a - b) for a, b in zip(shared, self._temporal_trunk(reordered))]).max()\n        padded = dict(batch)\n        for key in keys