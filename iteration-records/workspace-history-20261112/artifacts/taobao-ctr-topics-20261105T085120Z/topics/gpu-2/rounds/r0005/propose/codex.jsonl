{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport ast,hashlib,json,subprocess\nfrom pathlib import Path\nroot=Path('/workspace')\np=json.loads((root/'proposal.json').read_text())\nr=json.loads(subprocess.check_output(['python3','/workspace/tools.py','resolve','run://r-001']))\n\ndef validate(value,schema,path='\"'$'\"'):\n typ=schema.get('type')\n if typ=='object':\n  assert isinstance(value,dict),(path,'object')\n  assert set(schema.get('required',[]))<=set(value),(path,'required')\n  if schema.get('additionalProperties') is False:\n   assert set(value)<=set(schema.get('properties',{})),(path,'unexpected property')\n  for k,v in value.items():\n   if k in schema.get('properties',{}):validate(v,schema['properties'][k],path+'.'+k)\n elif typ=='array':\n  assert isinstance(value,list),(path,'array')\n  assert len(value)>=schema.get('minItems',0),(path,'minItems')\n  for i,v in enumerate(value):validate(v,schema.get('items',{}),path+'[%d]'%i)\n elif typ=='string':\n  assert isinstance(value,str) and len(value)>=schema.get('minLength',0),(path,'string/minLength')\n if 'enum' in schema:assert value in schema['enum'],(path,'enum')\n if 'const' in schema:assert value==schema['const'],(path,'const')\nvalidate(p['study'],r['study_schema'])\nassert p['study']['protocol_ref']==r['required_study_protocol_ref']\nassert p['parent_trial'] in r['context']['allowed_observation_ids']\nassert set(r['context']['allowed_observation_ids'])<=set(p['study']['evidence_refs'])\nassert 1<=len(p['variants'])<=4\nassert any(v['role']=='candidate' for v in p['variants'])\nassert len({v['name'] for v in p['variants']})==len(p['variants'])\nassert len({v['file'] for v in p['variants']})==len(p['variants'])\nparent_source=(root/'candidate.py').read_text()\nassert hashlib.sha256(parent_source.encode()).hexdigest()=='c20e1e85a306d704ca462b5e37851fff287848b4d958c22355da1c3b030fc8fa'\nparent_ast=ast.parse(parent_source)\ndef get_methods(tree):\n cls=next(n for n in tree.body if isinstance(n,ast.ClassDef) and n.name=='Model')\n return {n.name:n for n in cls.body if isinstance(n,ast.FunctionDef)}\nparent_methods=get_methods(parent_ast)\nnormalized_trees=[]\nfor v in p['variants']:\n assert Path(v['file']).name==v['file'] and v['file'].endswith('.py')\n source=(root/v['file']).read_text()\n compile(source,v['file'],'exec')\n tree=ast.parse(source)\n config_node=next(n for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets))\n assert ast.literal_eval(config_node.value)==v['config']\n methods=get_methods(tree)\n for name in ['_encode','_score','_weights','_match_norm','forward']:\n  assert ast.dump(methods[name])==ast.dump(parent_methods[name]),(v['name'],name,'inherited method altered')\n init=methods['__init__']\n init.body=[n for n in init.body if not(isinstance(n,ast.Assign) and any(isinstance(t,ast.Attribute) and t.attr=='semantic_keys' for t in n.targets))]\n assert ast.dump(init)==ast.dump(parent_methods['__init__']),(v['name'],'parameter construction changed')\n old_read=parent_methods['_read'].body\n new_read=methods['_read'].body\n # Everything from weight normalization through value pooling is unchanged.\n assert [ast.dump(n) for n in old_read[2:]]==[ast.dump(n) for n in new_read[5:]],(v['name'],'values/pooling changed')\n for n in ast.walk(tree):\n  if isinstance(n,ast.Import):assert all(a.name.split('.')[0] in ['torch','numpy','math','typing','copy','functools','collections','itertools','dataclasses','contextlib'] for a in n.names)\n  if isinstance(n,ast.ImportFrom):assert n.module.split('.')[0] in ['torch','numpy','math','typing','copy','functools','collections','itertools','dataclasses','contextlib']\n  if isinstance(n,ast.Call) and isinstance(n.func,ast.Name):assert n.func.id not in ['open','exec','eval','__import__','compile','input']\n assert len(methods['diagnostics'].body)>0\n sha=hashlib.sha256(source.encode()).hexdigest()\n assert sha in v['note']\n # Compare full implementation across cells after removing literal defaults.\n config_node.value=ast.Dict(keys=[],values=[])\n normalized_trees.append(ast.dump(tree))\n print(v['name'], 'syntax/config/import/lineage/hash checks passed',sha)\nassert len(set(normalized_trees))==1,'Factorial cells differ outside literal CONFIG'\nassert {a['knowledge_id'] for a in p['knowledge_assessments']}>=set(r['context']['latest_knowledge_usage']['retrieved_ids'])\nprint('Proposal matches runtime study schema, protocol, known local evidence IDs, and knowledge coverage.')\nprint('All four cells have identical parameter construction, inherited forward/encoding/norm code and event-value pooling.')\nprint('No model execution, training, package installation or assessment performed.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
