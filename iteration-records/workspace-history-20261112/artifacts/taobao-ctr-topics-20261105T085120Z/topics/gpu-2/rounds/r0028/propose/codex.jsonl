{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"cat >> candidate.py <<'PY'\n\n\n# Prospective sparse nested-run and collision-sufficiency study.\n# The registered full-reference prefix above remains byte-identical.\n_RecurrenceReference = Model\n\n\nclass Model(_RecurrenceReference):\n    \\\"\\\"\\\"Keep fine contexts; compare Shannon information with order-2 entropy.\n\n    All existing modules, shapes and RNG draws are inherited unchanged. Both\n    cells omit overlap information. Sparse counting is shared engineering;\n    only entropy_summary changes the information available to the classifier.\n    \\\"\\\"\\\"\n    def __init__(self, meta, config=None):\n        super().__init__(meta, config)\n        self.entropy_summary = self.config.get('entropy_summary', 'collision')\n        if self.entropy_summary not in ('shannon', 'collision'):\n            raise ValueError('Unknown entropy_summary')\n        if self.recurrence_context_mode \"'!= '\"'full' or self.state_mode \"'!= '\"'full':\n            raise ValueError('Retain all fine recurrence and transition states')\n        # No parameters, buffers, random draws, labels or mutable caches added.\n\n    @staticmethod\n    def _sparse_runs(ordered, valid):\n        \\\"\\\"\\\"Mass and representative key for each run; arrays are only BxL.\n\n        Invalid -1 padding sorts first and contributes zero even when its\n        clamped run index coincides with the first valid run. Unused slots\n        have zero mass and an arbitrary harmless zero representative key.\n        \\\"\\\"\\\"\n        start = valid.clone()\n        start[:, 1:] = valid[:, 1:] & (ordered[:, 1:] \"'!= ordered[:, :-1])\n        run = (start.long().cumsum(-1) - 1).clamp_min(0)\n        mass = valid.float().new_zeros(valid.shape).scatter_add(\n            1, run, valid.float())\n        keys = torch.zeros_like(ordered).scatter_add(\n            1, run, torch.where(start, ordered, torch.zeros_like(ordered)))\n        return mass, keys\n\n    @staticmethod\n    def _dispersion(square, xlogx, total, summary):\n        denominator = total.clamp_min(1)\n        collision = square / denominator.square()\n        if summary == '\"'collision':\n            # All occupied distributions have C>=1/128. The clamp affects only\n            # empty cells, whose output is explicitly zero, never positive mass.\n            entropy = torch.where(total > 0,\n                                  -collision.clamp_min(1e-12).log(),\n                                  torch.zeros_like(total)).clamp_min(0)\n        else:\n            entropy = torch.where(total > 0,\n                                  denominator.log() - xlogx / denominator,\n                                  torch.zeros_like(total)).clamp_min(0)\n        return entropy, collision\n\n    def _sparse_distribution(self, identity, group, eligible, total, summary):\n        key = torch.where(eligible, 4 * identity + group,\n                          torch.full_like(identity, -1))\n        ordered = key.sort(dim=-1).values\n        mass, tags = self._sparse_runs(ordered, ordered >= 0)\n        square = torch.zeros_like(total).scatter_add(1, tags.remainder(4), mass.square())\n        xlogx = None\n        if summary == 'shannon':\n            xlogx = torch.zeros_like(total).scatter_add(\n                1, tags.remainder(4), mass * mass.clamp_min(1).log())\n        return self._dispersion(square, xlogx, total, summary)\n\n    def _sparse_recurrence(self, batch, semantic, summary):\n        \\\"\\\"\\\"Nested X and (X,Y) runs replace the dense BxLx16 workspace.\n\n        X is a supplied category-brand bucket pair, conditional on match group;\n        Y is one of the original16 action-age contexts. Packing orders X/group\n        before Y. Dividing sorted keys by16 therefore yields sorted X/group\n        keys: one sort supplies both nested partitions. No event equality or\n        Gram matrix is built in forward, and no context labels are coarsened.\n        \\\"\\\"\\\"\n        c, b = batch['history_category'], batch['history_brand']\n        eligible = batch['history_mask'] & (c > 0) & (b > 0)\n        group = semantic.argmax(dim=1)\n        n = (semantic * eligible[:, None, :].float()).sum(-1)\n        context, _ = self._context_partition(batch, 'full')\n        hc, cc = self._sparse_distribution(c, group, eligible, n, summary)\n        hb, cb = self._sparse_distribution(b, group, eligible, n, summary)\n        identity = c * self.brand_vocab + b\n        packed = 64 * identity + 16 * group + context\n        key = torch.where(eligible, packed, torch.full_like(packed, -1))\n        ordered = key.sort(dim=-1).values\n        valid = ordered >= 0\n        pair_mass, pair_tags = self._sparse_runs(\n            ordered.div(16, rounding_mode='floor'), valid)\n        xy_mass, xy_tags = self._sparse_runs(ordered, valid)\n        pair_groups = pair_tags.remainder(4)\n        xy_groups = xy_tags.div(16, rounding_mode='floor').remainder(4)\n        xy_cells = 16 * xy_groups + xy_tags.remainder(16)\n        pair_square = torch.zeros_like(n).scatter_add(1, pair_groups, pair_mass.square())\n        pair_xlogx = None\n        if summary == 'shannon':\n            pair_xlogx = torch.zeros_like(n).scatter_add(\n                1, pair_groups, pair_mass * pair_mass.clamp_min(1).log())\n        hx, cx = self._dispersion(pair_square, pair_xlogx, n, summary)\n        context_mass = n.new_zeros((n.shape[0], 64)).scatter_add(\n            1, 16 * group + context, eligible.float()).reshape(n.shape[0], 4, 16)\n        context_xlogx = None\n        if summary == 'shannon':\n            context_xlogx = (context_mass * context_mass.clamp_min(1).log()).sum(-1)\n        hy, cy = self._dispersion(context_mass.square().sum(-1), context_xlogx, n, summary)\n        conditional_square = n.new_zeros((n.shape[0], 64)).scatter_add(\n            1, xy_cells, xy_mass.square()).reshape_as(context_mass)\n        conditional_xlogx = None\n        if summary == 'shannon':\n            conditional_xlogx = n.new_zeros((n.shape[0], 64)).scatter_add(\n                1, xy_cells, xy_mass * xy_mass.clamp_min(1).log()).reshape_as(context_mass)\n        hxy, cxy = self._dispersion(\n            conditional_square.sum(-1),\n            conditional_xlogx.sum(-1) if summary == 'shannon' else None, n, summary)\n        entropy, collision = self._dispersion(\n            conditional_square, conditional_xlogx, context_mass, summary)\n        scale = math.log(129.0)\n        identity_features = torch.stack([\n            torch.log1p(n) / scale, hc / scale, hb / scale, cc, cb, hx / scale, cx\n        ], -1).flatten(1)\n        context_features = torch.stack([\n            torch.log1p(n) / scale, hx / scale, hy / scale, cx, cy, hxy / scale, cxy\n        ], -1).flatten(1)\n        repeat_features = torch.stack([\n            torch.log1p(context_mass) / scale, entropy / scale, collision\n        ], -1).flatten(1)\n        zero_overlap = n.new_zeros((n.shape[0], 480))\n        blocks = (identity_features, context_features, repeat_features, zero_overlap)\n        pair_counted = torch.zeros_like(n).scatter_add(1, pair_groups, pair_mass)\n        xy_counted = n.new_zeros((n.shape[0], 64)).scatter_add(\n            1, xy_cells, xy_mass).reshape_as(context_mass)\n        return blocks, (n, context_mass, pair_counted, xy_counted)\n\n    def _shared_recurrence(self, batch, semantic, mode):\n        if mode \"'!= '\"'full':\n            raise ValueError('Sparse study preserves all16 contexts')\n        return self._sparse_recurrence(batch, semantic, self.entropy_summary)\n\n    def diagnostics(self, batch):\n        \\\"\\\"\\\"Label-free candidate probes; source review and host scoring required.\n\n        Quadratic independent oracles are restricted to at most8 impressions.\n        Diagnostics never run in forward or change parameters/normalization.\n        \\\"\\\"\\\"\n        probe = {key: value[:mi