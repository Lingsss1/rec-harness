e\",\n      \"DIN-style category/brand history attention\",\n      \"DMR-inspired relevance modeling with explicitly documented field substitutions\"\n    ],\n    \"question_selection\": \"Choose a concrete observed limitation after baseline and slice diagnostics. Do not preselect a winning mechanism from the industry cards.\",\n    \"proposal_schema\": \"../../agent/study.schema.json\",\n    \"nearest_work_check\": \"Record inherited components, mechanism difference, source version/locator and novelty uncertainty before execution.\",\n    \"attribution\": [\n      \"paired single-factor contrasts\",\n      \"replacement or capacity-matched controls\",\n      \"factorial controls for interacting changes\",\n      \"lineage-aware comparison of positive, null and failed trajectories\",\n      \"repetitions when a direction remains consequential\"\n    ],\n    \"continuation\": \"A direction may continue across multiple rounds when evidence justifies another diagnostic or implementation change; one failed implementation is not a mechanism refutation.\",\n    \"screening\": \"Optional fixed user-hash subsets and internal temporal folds are screening-only. Preserve prevalence and time boundaries; final candidates and controls use the frozen full protocol. Never compare a subset result to a full-data result as if matched.\",\n    \"novelty_score\": null,\n    \"routine_human_approval\": false\n  },\n  \"analysis\": {\n    \"primary\": \"full-population validation ROC-AUC\",\n    \"secondary\": [\n      \"unweighted Logloss\",\n      \"parameter counts\",\n      \"allocated GPU seconds\",\n      \"wall time\",\n      \"examples processed\",\n      \"peak memory\",\n      \"inference throughput and p50/p95 latency\"\n    ],\n    \"cost_views\": [\n      \"matched training recipe/data passes for mechanism isolation\",\n      \"measured equal-compute or quality-cost frontier for efficiency\"\n    ],\n    \"slices\": [\n      \"hour of day\",\n      \"history length including 