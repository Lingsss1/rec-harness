are used, but effective input rank remains <=48.\n480:             extra = selected.expand(-1, 4, -1, -1) * 0.5\n481:         else:\n482:             extra = selected\n483:         features = torch.cat([static, pools.flatten(1), statistics, histogram,\n484:                               moments.flatten(1), extra.flatten(1)], dim=-1)\n485:         return features, extra, means, full, collapsed, semantic, sizes\n\nLINES 498 524\n498:     def _sorted_distribution(identity, group, eligible, n):\n499:         \"\"\"Conditional Shannon entropy and with-replacement collision mass.\n500: \n501:         Sort BxL packed identity/group keys, then aggregate run counts in BxL\n502:         storage. This never builds a BxLxL training tensor or a vocabulary table.\n503:         Zero category/brand values are excluded from ALL three distributions.\n504:         \"\"\"\n505:         if identity.shape[1] == 0:\n506:             return torch.zeros_like(n), torch.zeros_like(n)\n507:         key = torch.where(eligible, identity * 4 + group,\n508:                           torch.full_like(identity, -1))\n509:         ordered = key.sort(dim=-1).values\n510:         valid = ordered >= 0\n511:         start = valid.clone()\n512:         start[:, 1:] = valid[:, 1:] & (ordered[:, 1:] != ordered[:, :-1])\n513:         run = (start.long().cumsum(-1) - 1).clamp_min(0)\n514:         mass = n.new_zeros(identity.shape).scatter_add(1, run, valid.float())\n515:         run_group = torch.zeros_like(identity).scatter_add(\n516:             1, run, torch.where(start, ordered.remainder(4), torch.zeros_like(ordered)))\n517:         sum_square = torch.zeros_like(n).scatter_add(1, run_group, mass.square())\n518:         sum_xlogx = torch.zeros_like(n).scatter_add(\n519:             1, run_group, mass * mass.clamp_min(1).log())\n520:         denom = n.clamp_min(1)\n521:         entropy = torch.where(n > 0, (denom.log() - sum_xlogx / denom).clamp_min(0),\n522:                               torch.zeros_like(n))\n523:         collision = sum_square / denom.square()\n524:         return entropy, collision\n\nLINES 2003 2154\n2003: \n2004: \n2005: _FrozenModel = Model\n2006: \n2007: \n2008: class Model(_FrozenModel):\n2009:     \"\"\"Selected execution and capacity-matched transition state replacement.\n2010: \n2011:     No new parameters, optimizer, labels, histories, or initialization draws.\n2012:     Full uses the exact ancestor selected representation. Action and rotated\n2013:     replace only the transition-state mapping before counting and product.\n2014:     The unchanged 1024-input head receives an isometric 64 -> 1024 lift.\n2015:     The gap branch retains the original lifted4096 parameterization.\n2016:     \"\"\"\n2017:     def __init__(self, meta, config=None):\n2018:         super().__init__(meta, config)\n2019:         self.state_mode = self.config.get('transition_state_mode', 'full')\n2020:         if self.state_mode not in ('full', 'action', 'rotated'):\n2021:             raise ValueError('Unknown transition_state_mode')\n2022:         if self.gap_parameterization != 'lifted' or self.gap_execution != 'direct':\n2023:             raise ValueError('Keep the frozen direct/lifted gap branch')\n2024: \n2025:     def _selected_repeat(self, batch, ids, ctx):\n2026:         # Exact observed conditional features; omit product/unlabeled controls.\n2027:         eligible, group = ids[5], ids[6]\n2028:         context, context_mass = ctx[5], ctx[6]\n2029:         batch_size, length = eligible.shape\n2030:         squared = context_mass.new_zeros((batch_size, 64))\n2031:         xlogx = torch.zeros_like(squared)\n2032:         if length:\n2033:             identity = batch['history_category'] * self.brand_vocab + batch['history_brand']\n2034:             packed = 64 * identity + 4 * context + group\n2035:             key = torch.where(eligible, packed, torch.full_like(packed, -1))\n2036:             ordered = key.sort(dim=-1).values\n2037:             valid = ordered >= 0\n2038:             start = valid.clone()\n2039:             start[:, 1:] = valid[:, 1:] & (ordered[:, 1:] != ordered[:, :-1])\n2040:             run = (start.long().cumsum(-1) - 1).clamp_min(0)\n2041:             mass = context_mass.new_zeros((batch_size, length)).scatter_add(1, run, valid.float())\n2042:             cell = 16 * ordered.remainder(4) + ordered.div(4, rounding_mode='floor').remainder(16)\n2043:             run_cell = torch.zeros_like(ordered).scatter_add(\n2044:                 1, run, torch.where(start, cell, torch.zeros_like(cell)))\n2045:             squared = squared.scatter_add(1, run_cell, mass.square())\n2046:             xlogx = xlogx.scatter_add(1, run_cell, mass * mass.clamp_min(1).log())\n2047:         squared = squared.reshape(batch_size, 4, 16)\n2048:         xlogx = xlogx.reshape(batch_size, 4, 16)\n2049:         denom = context_mass.clamp_min(1)\n2050:         entropy = torch.where(context_mass > 0, (denom.log() - xlogx / denom).clamp_min(0),\n2051:                               torch.zeros_like(context_mass))\n2052:         collision = squared / denom.square()\n2053:         return torch.stack([torch.log1p(context_mass) / math.log(129.0),\n2054:                             entropy / math.log(129.0), collision], -1).flatten(1)\n2055: \n2056:     def _selected_overlap(self, batch, ids, ctx):\n2057:         # Exact observed Gram features; omit product/unlabeled controls.\n2058:         eligible, group = ids[5], ids[6]\n2059:         context, context_mass = ctx[5], ctx[6]\n2060:         batch_size, length = eligible.shape\n2061:         raw = context_mass.new_zeros((batch_size, 4, 16, 16))\n2062:         if length:\n2063:             identity = batch['history_category'] * self.brand_vocab + batch['history_brand']\n2064:             packed = 4 * identity + group\n2065:             key = torch.where(eligible, packed, torch.full_like(packed, -1))\n2066:             ordered, order = key.sort(dim=-1)\n2067:             valid = ordered >= 0\n2068:             start = valid.clone()\n2069:             start[:, 1:] = valid[:, 1:] & (ordered[:, 1:] != ordered[:, :-1])\n2070:             run = (start.long().cumsum(-1) - 1).clamp_min(0)\n2071:             sorted_context = context.gather(1, order)\n2072:             counts = context_mass.new_zeros((batch_size, length * 16)).scatter_add(\n2073:                 1, 16 * run + sorted_context, valid.float()).reshape(batch_size, length, 16)\n2074:             run_group = torch.zeros_like(ordered).scatter_add(\n2075:                 1, run, torch.where(start, ordered.remainder(4), torch.zeros_like(ordered)))\n2076:             grams = []\n2077:             for g in range(4):\n2078:                 selected = counts * (run_group == g).unsqueeze(-1).float()\n2079:                 grams.append(torch.bmm(counts.transpose(1, 2), selected))\n2080:             raw = torch.stack(grams, dim=1)\n2081:         denominator = context_mass.unsqueeze(-1) * context_mass.unsqueeze(-2)\n2082:         gram = raw / denominator.clamp_min(1)\n2083:         return gram[:, :, self.overlap_rows, self.overlap_cols].flatten(1)\n2084: \n2085:     def _selected_parent(self, batch):\n2086:         features, _, _, _, _, semantic, _ = self._shared_features(batch)\n2087:         ids = self._identity_tables(batch, semantic)\n2088:         ctx = self._context_tables(batch, ids)\n2089:         # Preserve original addition order and all selected feature operations.\n2090:         parent = self.output(features).squeeze(-1)\n2091:         identity = self.identity_head(self._identity_features(ids)).squeeze(-1)\n2092:         context = self.context_head(self._context_features(ctx)).squeeze(-1)\n2093:         repeat = self.repeat_head(self._selected_repeat(batch, ids, ctx)).squeeze(-1)\n2094:         overlap = self.overlap_head(self._selected_overlap(batch, ids, ctx)).squeeze(-1)\n2095:         return parent + identity + context + repeat + overlap\n2096: \n2097:     def _state(self, batch, mode):\n2098:         action = (batch['history_type'] - 1).clamp(0, 3)\n2099:         if mode == 'action':\n2100:             return action, 4\n2101:         group = self._membership(batch)[1].argmax(dim=1)\n2102:         if mode == 'rotated':\n2103:             # Fixed balanced replacement; no data-dependent assignment.\n2104:             return (action + group).remainder(4), 4\n2105:         return 4 * group + action, 16\n2106: \n2107:     def _selected_counts(self, batch, support, mode):\n2108:         eligible, order = support[:2]\n2109:         c, b = batch['history_category'], batch['history_brand']\n2110:         age = batch['history_age_seconds']\n2111:         batch_size, length = c.shape\n2112:         state, states = self._state(batch, mode)\n2113:         temporal = [age.new_zeros((batch_size, states * states)) for _ in range(3)]\n2114:         gap_counts = [age.new_zeros((batch_size, 4)) for _ in range(3)]\n2115:         if length >= 2:\n2116:             valid = eligible.gather(1, order)\n2117:             ordered_state = state.gather(1, order)\n2118:             ordered_c, ordered_b = c.gather(1, order), b.gather(1, order)\n2119:             ordered_age = age.gather(1, order)\n2120:             edge = valid[:, :-1] & valid[:, 1:]\n2121:             same_c = ordered_c[:, :-1] == ordered_c[:, 1:]\n2122:             same_b = ordered_b[:, :-1] == ordered_b[:, 1:]\n2123:             destination = states * ordered_state[:, :-1] + ordered_state[:, 1:]\n2124:             gap = self._gap_bin(ordered_age[:, :-1] - ordered_age[:, 1:])\n2125:             for i, match in enumerate((torch.ones_like(edge), same_c, same_b)):\n2126:                 weights = (edge & match).float()\n2127:                 temporal[i] = temporal[i].scatter_add(1, destination, weights)\n2128:                 gap_counts[i] = gap_counts[i].scatter_add(1, gap, weights)\n2129:         # Factorize AFTER choosing the state mapping. Coarsening therefore\n2130:         # changes both labeled counts and the resolution of factorization.\n2131:         total, category, brand = temporal\n2132:         product = category * brand / total.clamp_min(1)\n2133:         transition = torch.stack([total, category, brand, product], 1).reshape(\n2134:             batch_size, 4, states, states)\n2135:         total, category, brand = gap_counts\n2136:         product = category * brand / self._positive_denominator(total)\n2137:         gap = torch.stack([total, category, brand, product], 1).unsqueeze(-1)\n2138:         return transition, gap\n2139: \n2140:     @staticmethod\n2141:     def _transition_lift(counts):\n2142:         features = torch.log1p(counts) / math.log(129.0)\n2143:         if counts.shape[-1] == 16:\n2144:             return features.flatten(1)\n2145:         # Old layout [channel, source_group, source_action, dest_group, dest_action].\n2146:         return (features.reshape(counts.shape[0], 4, 1, 4, 1, 4).expand(\n2147:             -1, -1, 4, -1, 4, -1).reshape(counts.shape[0], 1024) / 4.0)\n2148: \n2149:     def forward(self, batch):\n2150:         parent = self._selected_parent(batch)\n2151:         transition, gap = self._selected_counts(batch, self._transition_support(batch), self.state_mode)\n2152:         residual = self.transition_head(self._transition_lift(transition)).squeeze(-1)\n2153:         return parent + residual + self.gap_head(self._gap_lift(gap)).squeeze(-1)\n2154: \n\nLINES 2240 2306\n2240: \n2241: \n2242: _SelectedModel = Model\n2243: \n2244: \n2245: class Model(_SelectedModel):\n2246:     \"\"\"Share joint counts; replace recurrence-context resolution prospectively.\n2247: \n2248:     Full is an execution control. Action/rotated change three statistical\n2249:     readouts, retaining age information in all other inherited branches.\n2250:     No parameter is appended, removed, or reinitialized. All batch-dependent\n2251:     work is local to forward; no cross-batch or label cache exists.\n2252:     \"\"\"\n2253:     def __init__(self, meta, config=None):\n2254:         super().__init__(meta, config)\n2255:         self.recurrence_context_mode = self.config.get('recurrence_context_mode', 'action')\n2256:         if self.recurrence_context_mode not in ('full', 'action', 'rotated'):\n2257:             raise ValueError('Unknown recurrence_context_mode')\n2258:         if self.state_mode != 'full':\n2259:             raise ValueError('Hold chronological transition states fixed at full')\n2260: \n2261:     @staticmethod\n2262:     def _context_partition(batch, mode):\n2263:         action = (batch['history_type'] - 1).clamp(0, 3)\n2264:         if mode == 'action':\n2265:             return action, 4\n2266:         age = batch['history_age_seconds']\n2267:         age_bin = ((age >= 3600.0).long() + (age >= 86400.0).long() +\n2268:                    (age >= 604800.0).long())\n2269:         if mode == 'rotated':\n2270:             return (action + age_bin).remainder(4), 4\n2271:         return 4 * action + age_bin, 16\n2272: \n2273:     @staticmethod\n2274:     def _fine_to_coarse(mode, device):\n2275:         fine = torch.arange(16, device=device)\n2276:         action = fine.div(4, rounding_mode='floor')\n2277:         if mode == 'rotated':\n2278:             return (action + fine.remainder(4)).remainder(4)\n2279:         return action\n2280: \n2281:     def _repeat_lift(self, features, mode):\n2282:         if mode == 'full':\n2283:             return features.flatten(1)\n2284:         # [B,group,coarse_context,3] -> original [B,group,16,3].\n2285:         # Each coarse coordinate has four copies scaled by 1/sqrt(4).\n2286:         mapping = self._fine_to_coarse(mode, features.device)\n2287:         return (features.index_select(2, mapping) / 2.0).flatten(1)\n2288: \n2289:     def _overlap_lift(self, gram, mode):\n2290:         if mode == 'full':\n2291:             return gram[:, :, self.overlap_rows, self.overlap_cols].flatten(1)\n2292:         # Only cross-coarse-context pairs are retained. Each of six unordered\n2293:         # coarse pairs occurs in 4*4=16 fine upper-triangle slots. Within-state\n2294:         # fine pairs are zero, so diagonal collision is NOT added as new input.\n2295:         mapping = self._fine_to_coarse(mode, gram.device)\n2296:         row, col = mapping[self.overlap_rows], mapping[self.overlap_cols]\n2297:         return (gram[:, :, row, col] * (row != col).float() / 4.0).flatten(1)\n2298: \n2299:     @staticmethod\n2300:     def _entropy_collision(sum_xlogx, sum_square, mass):\n2301:         denom = mass.clamp_min(1)\n2302:         entropy = torch.where(mass > 0, (denom.log() - sum_xlogx / denom).clamp_min(0),\n2303:                               torch.zeros_like(mass))\n2304:         return entropy, sum_square / denom.square()\n2305: \n2306:     def _shared_recurrence(self, batch, semantic, mode):\n\nZERO APPEND\n\n\nCONFIG = {'embedding_dim': 16, 'hidden': [128, 64], 'lr': 0.001, 'joint_mode': 'observed', 'statistic_mode': 'count', 'grouping_mode': 'match', 'histogram_grouping': 'match', 'histogram_pairing': 'observed', 'moment_grouping': 'match', 'moment_pairing': 'independent', 'field_mode': 'contrast', 'field_grouping': 'rank', 'field_scope': 'global', 'field_layout': 'compact', 'global_direction': 'norm_collapsed', 'identity_mode': 'joint', 'context_mode': 'joint', 'repeat_mode': 'joint', 'overlap_mode': 'observed', 'transition_order': 'chronological', 'transition_pairing': 'product', 'gap_mode': 'observed', 'gap_pairing': 'product', 'gap_resolution': 'global', 'gap_channels': 'all', 'product_scope': 'pooled', 'gap_association': 'observed', 'gap_execution': 'direct', 'gap_parameterization': 'lifted', 'transition_state_mode': 'full', 'recurrence_context_mode': 'full'}\n\n\n# Prospective concentration-only overlap replacement.\n# The complete registered full-reference prefix above is preserved verbatim.\n_OverlapReference = Model\n\n\nclass Model(_OverlapReference):\n    \"\"\"Replace cross-context identity alignment while retaining concentration.\n\n    Direct and dense modes emit the same480 overlap coordinates. Dense mode\n    deliberately computes the unused exact Gram for an execution comparison.\n    Zero mode is a branch-information ablation with unchanged allocation.\n    \"\"\"\n    def __init__(self, meta, config=None):\n        super().__init__(meta, config)\n        self.overlap_replacement = self.config.get('overlap_replacement', 'concentration')\n        self.overlap_execution = self.config.get('overlap_execution', 'direct')\n        if self.overlap_replacement not in ('concentration', 'zero'):\n            raise ValueError('Unknown overlap_replacement')\n        if self.overlap_execution not in ('direct', 'dense'):\n            raise ValueError('Unknown overlap_execution')\n        if self.recurrence_context_mode != 'full' or self.state_mode != 'full':\n            raise ValueError('Keep full recurrence contexts and transition states')\n        # No modules, parameters, RNG draws or optimizer changes are added.\n\n    def _shared_recurrence(self, batch, semantic, mode):\n        if mode != 'full':\n            raise ValueError('This study fixes full16 recurrence contexts')\n        return self._recurrence_views(batch, semantic, self.overlap_replacement,\n                                      self.overlap_execution)\n\n    def _recurrence_views(self, batch, semantic, replacement, execution):\n        \"\"\"Exact first three recurrence blocks; replace only overlap features.\n\n        All contexts, identity keys, counts, entropy, collisions and scaling\n        through compact_repeat are byte-for-byte inherited operations. Mode is\n        fixed to full16. No labels, cross-batch state or extra events are used.\n        \"\"\"\n        mode = 'full'\n        c, b = batch['history_category'], batch['history_brand']\n        eligible = batch['history_mask'] & (c > 0) & (b > 0)\n        group = semantic.argmax(dim=1)\n        membership = semantic * eligible[:, None, :].float()\n        n = membership.sum(-1)\n        batch_size, length = c.shape\n        context, contexts = self._context_partition(batch, mode)\n        # Two unchanged marginal sorts. Joint counts from the third sort feed\n        # every remaining summary instead of repeating the same counting work.\n        hc, cc = self._sorted_distribution(c, group, eligible, n)\n        hb, cb = self._sorted_distribution(b, group, eligible, n)\n        counts = n.new_zeros((batch_size, length, contexts))\n        run_group = torch.zeros_like(c)\n        run_mass = n.new_zeros((batch_size, length))\n        if length:\n            identity = c * self.brand_vocab + b\n            packed = 4 * identity + group\n            key = torch.where(eligible, packed, torch.full_like(packed, -1))\n            ordered, order = key.sort(dim=-1)\n            valid = ordered >= 0\n            start = valid.clone()\n            start[:, 1:] = valid[:, 1:] & (ordered[:, 1:] != ordered[:, :-1])\n            run = (start.long().cumsum(-1) - 1).clamp_min(0)\n            run_mass = run_mass.scatter_add(1, run, valid.float())\n            run_group = run_group.scatter_add(\n                1, run, torch.where(start, ordered.remainder(4), torch.zeros_like(ordered)))\n            sorted_context = context.gather(1, order)\n            counts = n.new_zeros((batch_size, length * contexts)).scatter_add(\n                1, contexts * run + sorted_context, valid.float()).reshape(\n                    batch_size, length, contexts)\n        joint_square = torch.zeros_like(n).scatter_add(1, run_group, run_mass.square())\n        joint_xlogx = torch.zeros_like(n).scatter_add(\n            1, run_group, run_mass * run_mass.clamp_min(1).log())\n        hx, cx = self._entropy_collision(joint_xlogx, joint_square, n)\n        scale = math.log(129.0)\n        identity_features = torch.cat([\n            torch.stack([torch.log1p(n) / scale, hc / scale, hb / scale, cc, cb], -1),\n            torch.stack([hx / scale, cx], -1)\n        ], -1).flatten(1)\n        context_mass = n.new_zeros((batch_size, 4 * contexts)).scatter_add(\n            1, contexts * group + context, eligible.float()).reshape(\n                batch_size, 4, contexts)\n        hy, cy = self._entropy_collision(\n            (context_mass * context_mass.clamp_min(1).log()).sum(-1),\n            context_mass.square().sum(-1), n)\n        # Counts^2 and counts*log(counts) are shared by joint and conditional\n        # summaries. Integer count conservation itself is independently probed.\n        squared, xlogx = counts.square(), counts * counts.clamp_min(1).log()\n        hxy, cxy = self._entropy_collision(\n            torch.zeros_like(n).scatter_add(1, run_group, xlogx.sum(-1)),\n            torch.zeros_like(n).scatter_add(1, run_group, squared.sum(-1)), n)\n        context_features = torch.cat([\n            torch.stack([torch.log1p(n) / scale, hx / scale, hy / scale, cx, cy], -1),\n            torch.stack([hxy / scale, cxy], -1)\n        ], -1).flatten(1)\n        cell = contexts * run_group[:, :, None] + torch.arange(\n            contexts, device=c.device)[None, None, :]\n        conditional_square = n.new_zeros((batch_size, 4 * contexts)).scatter_add(\n            1, cell.flatten(1), squared.flatten(1)).reshape(batch_size, 4, contexts)\n        conditional_xlogx = n.new_zeros((batch_size, 4 * contexts)).scatter_add(\n            1, cell.flatten(1), xlogx.flatten(1)).reshape(batch_size, 4, contexts)\n        entropy, collision = self._entropy_collision(\n            conditional_xlogx, conditional_square, context_mass)\n        compact_repeat = torch.stack([\n            torch.log1p(context_mass) / scale, entropy / scale, collision], -1)\n        # C[g,k] is the with-replacement collision mass already calculated\n        # by the exact repeat branch. Empty contexts have exactly C=0.\n        # U_ij=sqrt(C_i)*sqrt(C_j) is a Cauchy-Schwarz upper bound on G_ij.\n        # This retains concentration but removes overlap-branch identity angle.\n        if replacement == 'concentration':\n            norms = collision.clamp_min(0).sqrt()\n            gram = norms.unsqueeze(-1) * norms.unsqueeze(-2)\n        else:\n            gram = n.new_zeros((batch_size, 4, contexts, contexts))\n        if execution == 'dense':\n            # Deliberately keep the ancestor's full Gram work in this control.\n            # Host eager execution is required for the intended timing contrast;\n            # a compiler could eliminate a zero dependency and invalidate it.\n            raw = n.new_zeros((batch_size, 4, contexts, contexts))\n            if length:\n                grams = []\n                for g in range(4):\n                    selected = counts * (run_group == g).unsqueeze(-1).float()\n                    grams.append(torch.bmm(counts.transpose(1, 2), selected))\n                raw = torch.stack(grams, dim=1)\n            denominator = context_mass.unsqueeze(-1) * context_mass.unsqueeze(-2)\n            observed_gram = raw / denominator.clamp_min(1)\n            # Exactly zero for finite count summaries, without leaking G to U.\n            gram = gram + observed_gram * 0.0\n        features = (identity_features, context_features,\n                    self._repeat_lift(compact_repeat, mode), self._overlap_lift(gram, mode))\n        # Compact summaries for label-free host diagnostics, not cached state.\n","exit_code":0,"status":"completed"}}
