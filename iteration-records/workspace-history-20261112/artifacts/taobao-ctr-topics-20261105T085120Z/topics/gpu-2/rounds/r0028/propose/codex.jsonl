{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\ns=Path('candidate.py').read_text().splitlines()\nprint('\\\\n'.join(s[959:991]))\nPY\"","aggregated_output":"/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n    def _transition_support(self, batch):\n        \"\"\"Singleton timestamps on complete-pair support, oldest first.\n\n        Remove every member of each time tie, never choose an ordering by\n        input index or bucket magnitude. Reorder input events with their ages\n        and the result is unchanged. Filtering can bridge excluded events;\n        adjacency is explicitly on this supported subsequence, not raw logs.\n        All intermediates here are BxL. Ages must obey the host contract >=0.\n        \"\"\"\n        c, b = batch['history_category'], batch['history_brand']\n        age = batch['history_age_seconds']\n        complete = batch['history_mask'] & (c > 0) & (b > 0)\n        batch_size, length = complete.shape\n        if length == 0:\n            order = torch.empty_like(c)\n            return complete, order, complete.long().sum(-1), complete\n        ordered_age, order = torch.where(\n            complete, age, torch.full_like(age, -1.0)).sort(dim=-1, descending=True)\n        valid = complete.gather(1, order)\n        # Adjacent-equality in sorted times identifies every tied member.\n        tied = torch.zeros_like(valid)\n        equal = (valid[:, 1:] & valid[:, :-1] &\n                 (ordered_age[:, 1:] == ordered_age[:, :-1]))\n        tied[:, 1:] |= equal\n        tied[:, :-1] |= equal\n        singleton = valid & ~tied\n        eligible = torch.zeros_like(complete).scatter(1, order, singleton)\n        # Compact singleton events while retaining their chronological order.\n        position = torch.arange(length, device=c.device)[None, :].expand(batch_size, -1)\n        compact = torch.where(singleton, position, position + length).argsort(dim=-1)\n        order = order.gather(1, compact)\n        return eligible, order, eligible.long().sum(-1), complete\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom collections import Counter\nfrom itertools import groupby\nimport math, random\nrng=random.Random(42)\nmax_error=0.; cases=0\nfor length in [0,1,2,6,16,64,128]:\n for repetition in range(40):\n  events=[]\n  for i in range(length):\n   c=rng.randrange(0,10); b=rng.randrange(0,13); g=rng.randrange(4); y=rng.randrange(16)\n   eligible=rng.random()>.2 and c>0 and b>0\n   events.append((c,b,g,y,eligible))\n  ordered=sorted(64*(c*13+b)+16*g+y if e else -1 for c,b,g,y,e in events)\n  def run_masses(keys):\n   masses=[]; tags=[]\n   for key,rows in groupby(keys):\n    count=len(list(rows))\n    if key>=0: masses.append(count); tags.append(key)\n   return masses,tags\n  pm,pt=run_masses([k//16 for k in ordered]); xm,xt=run_masses(ordered)\n  n=[0.]*4; cm=[[0.]*16 for _ in range(4)]\n  pc=Counter(); xc=Counter()\n  for c,b,g,y,e in events:\n   if e: n[g]+=1; cm[g][y]+=1; pc[(c,b,g)]+=1; xc[(c,b,g,y)]+=1\n  assert sum(pm)==sum(n)==sum(xm)\n  for g in range(4):\n   sq=sum(m*m for m,t in zip(pm,pt) if t%4==g)\n   logs=sum(m*math.log(m) for m,t in zip(pm,pt) if t%4==g)\n   assert sq==sum(m*m for (c,b,gg),m in pc.items() if gg==g)\n   h=math.log(max(n[g],1))-logs/max(n[g],1) if n[g] else 0.\n   probs=[m/n[g] for (c,b,gg),m in pc.items() if gg==g]\n   href=-sum(p*math.log(p) for p in probs)\n   max_error=max(max_error,abs(h-href))\n   for y in range(16):\n    qs=sum(m*m for m,t in zip(xm,xt) if (t//16)%4==g and t%16==y)\n    ql=sum(m*math.log(m) for m,t in zip(xm,xt) if (t//16)%4==g and t%16==y)\n    qc=sum(m for m,t in zip(xm,xt) if (t//16)%4==g and t%16==y)\n    assert qc==cm[g][y]\n    direct=[m for (c,b,gg,yy),m in xc.items() if gg==g and yy==y]\n    assert qs==sum(m*m for m in direct)\n    h=math.log(max(qc,1))-ql/max(qc,1) if qc else 0.\n    href=-sum(m/qc*math.log(m/qc) for m in direct)\n    h2=-math.log(qs/qc**2) if qc else 0.\n    assert h2<=h+1e-12\n    max_error=max(max_error,abs(h-href))\n  cases+=1\nprint('Independent scalar nested-run checks:', cases, 'cases; max Shannon error',max_error)\ncounts_a=(3,3); counts_b=(4,1,1)\ndef ent(c):\n n=sum(c); return -sum(m/n*math.log(m/n) for m in c),sum(m*m for m in c)/n**2\nha,ca=ent(counts_a); hb,cb=ent(counts_b)\nassert ca==cb==.5 and hb>ha\nprint('Information-loss witness: H_A',ha,'H_B',hb,'collision',ca,'H2',-math.log(ca))\nprint('These scalar checks do not execute torch, forward, gradients, GPU timings, or utility.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
