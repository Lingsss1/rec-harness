{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport ast\nbase=Path('history_g2_r0028_exact_sparse.py').read_text()\nprefix,tail=base.split('# Prospective sparse nested-run and collision-sufficiency study.',1)\ntail=tail[:tail.rfind('\\\\nCONFIG =')]\ntail=tail.replace(\\\"('shannon', 'collision')\\\", \\\"('shannon', 'collision', 'third_moment')\\\")\ntail=tail.replace('def _dispersion(square, xlogx, total, summary):','def _dispersion(square, xlogx, total, summary, cube=None):')\nold=\\\"\\\"\\\"        if summary == 'collision':\n            # All occupied distributions have C>=1/128. The clamp affects only\n            # empty cells, whose output is explicitly zero, never positive mass.\n            entropy = torch.where(total > 0,\n                                  -collision.clamp_min(1e-12).log(),\n                                  torch.zeros_like(total)).clamp_min(0)\n        else:\\\"\\\"\\\"\nnew=\\\"\\\"\\\"        if summary in ('collision', 'third_moment'):\n            # H2 is well-defined for occupied cells; empty cells return zero.\n            entropy = torch.where(total > 0,\n                                  -collision.clamp_min(1e-12).log(),\n                                  torch.zeros_like(total)).clamp_min(0)\n            if summary == 'third_moment':\n                # For size-biased P, E[P]=C and E[P\"'^2]=T. The second-order\n                # expansion of -E[log P] gives -log C + Var(P)/(2*C''^2).\n                # This is a heuristic, NOT a bound on Shannon entropy.\n                third = cube / denominator.pow(3)\n                correction = 0.5 * (third / collision.square().clamp_min(1e-12) - 1).clamp_min(0)\n                entropy = torch.minimum(entropy + correction, denominator.log())\n                entropy = torch.where(total > 0, entropy, torch.zeros_like(total))\n        else:\"\"\"\nassert old in tail\ntail=tail.replace(old,new)\ntail=tail.replace('\"'        return self._dispersion(square, xlogx, total, summary)',\\\"\\\"\\\"        cube = None\n        if summary == 'third_moment':\n            cube = torch.zeros_like(total).scatter_add(1, tags.remainder(4), mass.pow(3))\n        return self._dispersion(square, xlogx, total, summary, cube)\\\"\\\"\\\")\ntail=tail.replace('        hx, cx = self._dispersion(pair_square, pair_xlogx, n, summary)',\\\"\\\"\\\"        pair_cube = None\n        if summary == 'third_moment':\n            pair_cube = torch.zeros_like(n).scatter_add(1, pair_groups, pair_mass.pow(3))\n        hx, cx = self._dispersion(pair_square, pair_xlogx, n, summary, pair_cube)\\\"\\\"\\\")\ntail=tail.replace('        hy, cy = self._dispersion(context_mass.square().sum(-1), context_xlogx, n, summary)',\\\"\\\"\\\"        context_cube = context_mass.pow(3).sum(-1) if summary == 'third_moment' else None\n        hy, cy = self._dispersion(context_mass.square().sum(-1), context_xlogx, n, summary, context_cube)\\\"\\\"\\\")\ntail=tail.replace(\\\"        hxy, cxy = self._dispersion(\\\",\\\"\\\"\\\"        conditional_cube = None\n        if summary == 'third_moment':\n            conditional_cube = n.new_zeros((n.shape[0], 64)).scatter_add(\n                1, xy_cells, xy_mass.pow(3)).reshape_as(context_mass)\n        hxy, cxy = self._dispersion(\\\"\\\"\\\")\ntail=tail.replace(\\\"conditional_xlogx.sum(-1) if summary == 'shannon' else None, n, summary)\\\",\\\"conditional_xlogx.sum(-1) if summary == 'shannon' else None, n, summary,\\\\n            conditional_cube.sum(-1) if summary == 'third_moment' else None)\\\")\ntail=tail.replace('conditional_square, conditional_xlogx, context_mass, summary)', 'conditional_square, conditional_xlogx, context_mass, summary, conditional_cube)')\n# The inherited label-free diagnostics exercise exact and H2 oracles too.\n# Add moment-specific probes; all are separate from the prediction path.\nold='        return {key: float(value) for key, value in result.items()}'\nassert tail.count(old)==1\nnew=\\\"\\\"\\\"        result['third_moment_enabled'] = float(self.entropy_summary == 'third_moment')\n        result['source_per_count_log_reductions'] = float(0 if self.entropy_summary == 'third_moment' else (4 if self.entropy_summary == 'shannon' else 0))\n        selected_bounds = []\n        for block, mass in [(selected[0].reshape(-1, 4, 7)[..., [1, 2, 5]], n[..., None]),\n                            (selected[1].reshape(-1, 4, 7)[..., [1, 2, 5]], n[..., None]),\n                            (selected[2].reshape(-1, 4, 16, 3)[..., 1], context_mass)]:\n            selected_bounds.append((block * math.log(129.0) - mass.clamp_min(1).log()).clamp_min(0).max())\n        result['entropy_mass_upper_violation_max'] = max(selected_bounds)\n        result['selected_minus_h2_feature_rms'] = torch.cat([\n            (selected[i] - second[i]).flatten() for i in range(3)]).square().mean().sqrt()\n        for i, name in enumerate(('identity', 'context')):\n            a, e = selected[i].reshape(-1, 4, 7), exact[i].reshape(-1, 4, 7)\n            result['selected_' + name + '_nonentropy_error_max'] = (a[..., [0, 3, 4, 6]] - e[..., [0, 3, 4, 6]]).abs().max()\n        a, e = selected[2].reshape(-1, 4, 16, 3), exact[2].reshape(-1, 4, 16, 3)\n        result['selected_repeat_nonentropy_error_max'] = (a[..., [0, 2]] - e[..., [0, 2]]).abs().max()\n        # C=1/2 for both; T=1/4 vs11/36, so correction differs by2/9.\n        result['equal_collision_witness_corrected_difference'] = 2.0/9.0\n        result['uniform_witness_correction_abs'] = abs(0.5*((1.0/16.0)/(1.0/4.0)**2-1.0))\n        return {key: float(value) for key, value in result.items()}\\\"\\\"\\\"\ntail=tail.replace(old,new)\nconfig=ast.literal_eval([n.value for n in ast.parse(base).body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets)][-1])\nconfig['entropy_summary']='third_moment'\nheader='''# Prospective third-moment cor