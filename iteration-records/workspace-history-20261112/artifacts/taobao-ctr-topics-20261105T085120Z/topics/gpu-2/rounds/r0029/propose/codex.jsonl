{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport ast,json,hashlib\np=Path('candidate.py');s=p.read_text()\nmarker=\\\"    def diagnostics(self, batch):\\\\n        \\\\\\\"\\\\\\\"\\\\\\\"Label-free candidate probes; source review and host scoring required.\\\"\nassert s.count(marker)==1\nhelper='''    def _third_dense_oracle(self, batch):\n        \\\"\\\"\\\"Independent quadratic event-equality counter, diagnostics only.\n\n        An event in a run of mass m sees m equal eligible events. Summing\n        its m or m\"'^2 over events therefore yields sum(m''^2) or sum(m''^3).\n        Unlike forward, this oracle never sorts or builds sparse run tags.\n        \"\"\"\n        semantic = self._membership(batch)[1]\n        group = semantic.argmax(dim=1)\n        c, b = batch['\"'history_category'], batch['history_brand']\n        valid = batch['history_mask'] & (c > 0) & (b > 0)\n        context, _ = self._context_partition(batch, 'full')\n        n = (semantic * valid[:, None, :].float()).sum(-1)\n        cell = 16 * group + context\n        mass = n.new_zeros((n.shape[0], 64)).scatter_add(1, cell, valid.float())\n        pair = c * self.brand_vocab + b\n\n        def summarize(identity, cells, total):\n            equal = ((identity[:, :, None] == identity[:, None, :]) &\n                     (cells[:, :, None] == cells[:, None, :]) &\n                     valid[:, :, None] & valid[:, None, :])\n            per_event = equal.float().sum(-1)\n            square = torch.zeros_like(total).scatter_add(1, cells, per_event)\n            cube = torch.zeros_like(total).scatter_add(1, cells, per_event.square())\n            return self._dispersion(square, None, total, 'third_moment', cube)\n\n        hc, cc = summarize(c, group, n)\n        hb, cb = summarize(b, group, n)\n        hx, cx = summarize(pair, group, n)\n        hy, cy = summarize(context, group, n)\n        hxy