{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '2660,3150p' history_g2_r0028_exact_sparse.py\"","aggregated_output":"/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n        # in diagnostics and do not add work to the timed prediction path.\n        return blocks, (n, context_mass, pair_mass, pair_groups, xy_mass, xy_cells)\n\n    def _shared_recurrence(self, batch, semantic, mode):\n        if mode != 'full':\n            raise ValueError('Sparse study preserves all16 contexts')\n        return self._sparse_recurrence(batch, semantic, self.entropy_summary)\n\n    def diagnostics(self, batch):\n        \"\"\"Label-free candidate probes; source review and host scoring required.\n\n        Quadratic independent oracles are restricted to at most8 impressions.\n        Diagnostics never run in forward or change parameters/normalization.\n        \"\"\"\n        probe = {key: value[:min(8, value.shape[0])] for key, value in batch.items()}\n        semantic = self._membership(probe)[1]\n        selected, aux = self._sparse_recurrence(probe, semantic, self.entropy_summary)\n        exact, _ = self._sparse_recurrence(probe, semantic, 'shannon')\n        second, _ = self._sparse_recurrence(probe, semantic, 'collision')\n        full, _ = _RecurrenceReference._shared_recurrence(self, probe, semantic, 'full')\n        oracle = self._dense_recurrence_oracle(probe, 'full')\n        full_zero = full[:3] + (torch.zeros_like(full[3]),)\n        n, context_mass, pair_mass, pair_groups, xy_mass, xy_cells = aux\n        pair_counted = torch.zeros_like(n).scatter_add(1, pair_groups, pair_mass)\n        xy_counted = n.new_zeros((n.shape[0], 64)).scatter_add(\n            1, xy_cells, xy_mass).reshape_as(context_mass)\n        result = {\n            'allocated_parameters': float(sum(p.numel() for p in self.parameters())),\n            'oracle_impressions': float(probe['static'].shape[0]),\n            'source_recurrence_sort_calls': 3.0,\n            'source_dense_run_context_workspace': 0.0,\n            'source_grouped_overlap_bmm_calls': 0.0,\n            'recurrence_context_states': 16.0,\n            'history_embedding_width': float(self.config['embedding_dim']),\n            'collision_summary_enabled': float(self.entropy_summary == 'collision'),\n            'pair_count_error_max': (pair_counted - n).abs().max(),\n            'xy_context_count_error_max': (xy_counted - context_mass).abs().max(),\n            'context_margin_error_max': (context_mass.sum(-1) - n).abs().max(),\n            'zero_overlap_feature_abs_max': selected[3].abs().max(),\n            'zero_overlap_residual_abs_max': self.overlap_head(selected[3]).abs().max(),\n            'finite_probe_logits': torch.isfinite(self(probe)).all().float(),\n        }\n        for i, name in enumerate(('identity', 'context', 'repeat')):\n            result['exact_full_' + name + '_error_max'] = (exact[i] - full[i]).abs().max()\n            result['exact_dense_' + name + '_error_max'] = (exact[i] - oracle[i]).abs().max()\n            result['selected_' + name + '_delta_rms'] = (selected[i] - exact[i]).square().mean().sqrt()\n        for i, name in enumerate(('identity', 'context')):\n            a, e = second[i].reshape(-1, 4, 7), exact[i].reshape(-1, 4, 7)\n            result[name + '_nonentropy_error_max'] = (a[..., [0, 3, 4, 6]] - e[..., [0, 3, 4, 6]]).abs().max()\n            result[name + '_h2_above_shannon_max'] = (a[..., [1, 2, 5]] - e[..., [1, 2, 5]]).clamp_min(0).max()\n        a, e = second[2].reshape(-1, 4, 16, 3), exact[2].reshape(-1, 4, 16, 3)\n        result['repeat_nonentropy_error_max'] = (a[..., [0, 2]] - e[..., [0, 2]]).abs().max()\n        result['repeat_h2_above_shannon_max'] = (a[..., 1] - e[..., 1]).clamp_min(0).max()\n        main = self._shared_features(probe)[0]\n        result['exact_zero_parent_logit_error_max'] = (\n            self._parent_from_recurrence(main, exact) -\n            self._parent_from_recurrence(main, full_zero)).abs().max()\n        result['selected_parent_logit_delta_rms'] = (\n            self._parent_from_recurrence(main, selected) -\n            self._parent_from_recurrence(main, exact)).square().mean().sqrt()\n        keys = ('history_category', 'history_brand', 'history_type',\n                'history_age_seconds', 'history_mask')\n        reverse, padded, empty_length = dict(probe), dict(probe), dict(probe)\n        for key in keys:\n            reverse[key] = probe[key].flip(-1)\n            empty_length[key] = probe[key][:, :0]\n            fill = probe[key].new_zeros((probe[key].shape[0], 2))\n            if key != 'history_mask':\n                fill.fill_(1)\n            padded[key] = torch.cat([probe[key], fill], -1)\n        for label, altered in [('reverse', reverse), ('padding', padded)]:\n            changed, _ = self._sparse_recurrence(altered, self._membership(altered)[1], self.entropy_summary)\n            result[label + '_statistic_error_max'] = max((x-y).abs().max() for x, y in zip(selected, changed))\n        for label, altered in [('zero_length', empty_length), ('empty', dict(probe)), ('missing', dict(probe))]:\n            if label != 'zero_length':\n                key = 'history_mask' if label == 'empty' else 'history_brand'\n                altered[key] = torch.zeros_like(probe[key])\n            changed, _ = self._sparse_recurrence(altered, self._membership(altered)[1], self.entropy_summary)\n            result[label + '_statistic_abs_max'] = max(x.abs().max() for x in changed)\n            result[label + '_finite_logits'] = torch.isfinite(self(altered)).all().float()\n        # Equal count and collision, different Shannon: explicit lost information.\n        h_a = math.log(2.0)\n        h_b = -(4.0/6.0 * math.log(4.0/6.0) + 2.0/6.0 * math.log(1.0/6.0))\n        result['equal_collision_witness_collision_error'] = abs(18.0/36.0 - 18.0/36.0)\n        result['equal_collision_witness_shannon_difference'] = h_b - h_a\n        result['equal_collision_witness_h2_difference'] = 0.0\n        return {key: float(value) for key, value in result.items()}\n\n\nCONFIG = {'embedding_dim': 16, 'hidden': [128, 64], 'lr': 0.001, 'joint_mode': 'observed', 'statistic_mode': 'count', 'grouping_mode': 'match', 'histogram_grouping': 'match', 'histogram_pairing': 'observed', 'moment_grouping': 'match', 'moment_pairing': 'independent', 'field_mode': 'contrast', 'field_grouping': 'rank', 'field_scope': 'global', 'field_layout': 'compact', 'global_direction': 'norm_collapsed', 'identity_mode': 'joint', 'context_mode': 'joint', 'repeat_mode': 'joint', 'overlap_mode': 'observed', 'transition_order': 'chronological', 'transition_pairing': 'product', 'gap_mode': 'observed', 'gap_pairing': 'product', 'gap_resolution': 'global', 'gap_channels': 'all', 'product_scope': 'pooled', 'gap_association': 'observed', 'gap_execution': 'direct', 'gap_parameterization': 'lifted', 'transition_state_mode': 'full', 'recurrence_context_mode': 'full', 'entropy_summary': 'shannon'}\n","exit_code":0,"status":"completed"}}
