{"type":"item.completed","item":{"id":"item_29","type":"agent_message","text":"The sparse reference still sorts category, brand, and category–brand identities separately. I’ll test whether it can retain utility using only the joint summaries, omitting marginal entropy and collision features to remove two sorts. The comparison will use a fresh exact-Shannon control, preserve all 16 contexts and embedding dimensions, and leave roughly one trial’s budget in reserve. I’ll predeclare an AUC retention margin of 0.0005.\n"}}
{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport ast\nsource=Path('history_g2_r0028_exact_sparse.py').read_text()\nt=ast.parse(source)\ncls=[x for x in t.body if isinstance(x,ast.ClassDef)][-1]\nmethod=next(x for x in cls.body if isinstance(x,ast.FunctionDef) and x.name=='_sparse_recurrence')\nlines=source.splitlines(keepends=True)\nbody=''.join(lines[method.lineno-1:method.end_lineno])\nold=\\\"        hc, cc = self._sparse_distribution(c, group, eligible, n, summary)\\\\n        hb, cb = self._sparse_distribution(b, group, eligible, n, summary)\\\"\nnew=\\\"\\\"\\\"        # Representation intervention: omit marginal category/brand entropy\n        # and collision from identity_head. Main learned fields/matches remain.\n        # No marginal sort runs in this selected prediction path.\n        hc, cc = torch.zeros_like(n), torch.zeros_like(n)\n        hb, cb = torch.zeros_like(n), torch.zeros_like(n)\\\"\\\"\\\"\nassert body.count(old)==1\nbody=body.replace(old,new)\na=body.index('        \\\"\\\"\\\"Nested X')\nb=body.index('        c, b =',a)\nbody=body[:a]+'''        \\\"\\\"\\\"One joint sort; zero only four marginal coordinates per group.\n\n        Joint pair and pair/context counts and all downstream normalizations\n        remain the exact sparse Shannon ancestor. This discards information;\n        it is not an execution-only equivalence claim.\n        \\\"\\\"\\\"\n'''+body[b:]\nappend='''\n\n# Prospective joint-only recurrence study. The exact sparse source above is\n# retained byte-for-byte. Only the final class is selected by the host.\n_SparseAncestor = Model\n\n\nclass Model(_SparseAncestor):\n    \\\"\\\"\\\"Remove separate marginal summaries while retaining joint resolution.\n\n    Allocated modules, parameter order, shapes and initialization are unchanged.\n    Sixteen input coordinates of identity_head become zero, so 256 first-layer\n    weights receive no feature gradient. Equal allocation is not equal effective\n    capacity. No optimizer, loss, labels, external inputs or caches are added.\n    \\\"\\\"\\\"\n    def __init__(self, meta, config=None):\n        super().__init__(meta, config)\n        if self.entropy_summary \"'!= '\"'shannon':\n            raise ValueError('This contrast retains exact Shannon summaries')\n        if self.config.get('marginal_summary') \"'!= '\"'zero':\n            raise ValueError('This module implements the joint-only candidate')\n\n'''+body+'''\n\n    @staticmethod\n    def _erase_marginals(blocks):\n        \\\"\\\"\\\"Diagnostic-only dense execution of the identical intervention.\\\"\\\"\\\"\n        identity = blocks[0].reshape(-1, 4, 7).clone()\n        identity[..., 1:5] = 0\n        return (identity.flatten(1),) + tuple(blocks[1:])\n\n    def diagnostics(self, batch):\n        # Candidate-supplied, label-free measurements, never in timed forward.\n        # Quadratic oracle work is restricted to <=8 impressions.\n        probe = {key: value[:min(8, value.shape[0])] for key, value in batch.items()}\n        semantic = self._membership(probe)[1]\n        selected, aux = self._sparse_recurrence(probe, semantic, 'shannon')\n        exact, _ = _SparseAncestor._sparse_recurrence(self, probe, semantic, 'shannon')\n        masked = self._erase_marginals(exact)\n        oracle = self._dense_recurrence_oracle(probe, 'full')\n        n, context_mass, pair_mass, pair_groups, xy_mass, xy_cells = aux\n        pair_counted = torch.zeros_like(n).scatter_add(1, pair_groups, pair_mass)\n        xy_counted = n.new_zeros((n.shape[0], 64)).scatter_add(\n            1, xy_cells, xy_mass).reshape_as(context_mass)\n        main = self._shared_features(probe)[0]\n        result = {\n            'allocated_parameters': float(sum(p.numel() for p in self.parameters())),\n            'oracle_impressions': float(probe['static'].shape[0]),\n            'source_selected_recurrence_sort_calls': 1.0,\n            'source_exact_recurrence_sort_calls': 3.0,\n            'source_selected_marginal_sort_calls': 0.0,\n            'source_dense_run_context_workspace': 0.0,\n            'source_grouped_overlap_bmm_calls': 0.0,\n            'recurrence_context_states': 16.0,\n            'history_embedding_width': float(self.config['embedding_dim']),\n            'zeroed_identity_input_coordinates': 16.0,\n            'identity_weights_with_zero_feature_gradient': 256.0,\n            'pair_count_error_max': (pair_counted - n).abs().max(),\n            'xy_context_count_error_max': (xy_counted - context_mass).abs().max(),\n            'context_margin_error_max': (context_mass.sum(-1) - n).abs().max(),\n            'omitted_marginal_abs_max': selected[0].reshape(-1, 4, 7)[..., 1:5].abs().max(),\n            'exact_marginal_rms': exact[0].reshape(-1, 4, 7)[..., 1:5].square().mean().sqrt(),\n            'zero_overlap_feature_abs_max': selected[3].abs().max(),\n            'zero_overlap_residual_abs_max': self.overlap_head(selected[3]).abs().max(),\n            'masked_exact_parent_logit_error_max': (\n                self._parent_from_recurrence(main, selected) -\n                self._parent_from_recurrence(main, masked)).abs().max(),\n            'selected_exact_parent_logit_delta_rms': (\n                self._parent_from_recurrence(main, selected) -\n                self._parent_from_recurrence(main, exact)).square().mean().sqrt(),\n            'finite_probe_logits': torch.isfinite(self(probe)).all().float(),\n        }\n        for i, name in enumerate(('identity', 'context', 'repeat')):\n            result['masked_exact_' + name + '_error_max'] = (selected[i] - masked[i]).abs().max()\n            result['exact_dense_' + name + '_error_max'] = (exact[i] - oracle[i]).abs().max()\n        result['retained_identity_error_max'] = (\n            selected[0].reshape(-1, 4, 7)[..., [0, 5, 6]] -\n            exact[0].reshape(-1, 4, 7)[..., [0, 5, 6]]).abs().max()\n        keys = ('history_category', 'history_brand', 'history_type',\n                'history_age_seconds', 'history_mask')\n        reverse, padded, empty_length = dict(probe), dict(probe), dict(probe)\n        for key in keys:\n            reverse[key] = probe[key].flip(-1)\n            empty_length[key] = probe[key][:, :0]\n            fill = probe[key].new_zeros((probe[key].shape[0], 2))\n            if key \"'!= '\"'history_mask':\n                fill.fill_(1)\n            padded[key] = torch.cat([probe[key], fill], -1)\n        for label, altered in [('reverse', reverse), ('padding', padded)]:\n            changed, _ = self._sparse_recurrence(altered, self._membership(altered)[1], 'shannon')\n            result[label + '_statistic_error_max'] = max((x-y).abs().max() for x, y in zip(selected, changed))\n        for label, altered in [('zero_length', empty_length), ('empty', dict(probe)), ('missing', dict(probe))]:\n            if label \"'!= '\"'zero_length':\n                key = 'history_mask' if label == 'empty' else 'history_brand'\n                altered[key] = torch.zeros_like(probe[key])\n            changed, _ = self._sparse_recurrence(altered, self._membership(altered)[1], 'shannon')\n            result[label + '_statistic_abs_max'] = max(x.abs().max() for x in changed)\n            result[label + '_finite_logits'] = torch.isfinite(self(altered)).all().float()\n        # Two pairs, either sharing a category or not: identical joint entropy\n        # and collision, but different category marginals. This witnesses loss\n        # in this summary only; learned main features can still distinguish them.\n        result['lost_marginal_witness_joint_entropy_delta'] = 0.0\n        result['lost_marginal_witness_category_entropy_delta'] = math.log(2.0)\n        result['lost_marginal_witness_category_collision_delta'] = 0.5\n        return {key: float(value) for key, value in result.items()}\n'''\nconfig=ast.literal_eval([n.value for n in t.body if isinstance(n,ast.Assign) and any(isinstance(x,ast.Name) and x.id=='CONFIG' for x in n.targets)][-1])\nconfig['marginal_summary']='zero'\nPath('candidate.py').write_text(source+append+'\\\\n\\\\nCONFIG = '+repr(config)+'\\\\n')\nPath('shannon_control.py').write_text(source)\nfor f in ['candidate.py','shannon_control.py']:\n compile(Path(f).read_text(),f,'exec')\nprint('Wrote and syntax-checked two standalone modules; control is byte-identical:',Path('shannon_control.py').read_bytes()==Path('history_g2_r0028_exact_sparse.py').read_bytes())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
