,\n        \"minItems\": 1,\n        \"items\": {\n          \"type\": \"string\"\n        }\n      },\n      \"falsifiers\": {\n        \"type\": \"array\",\n        \"minItems\": 1,\n        \"items\": {\n          \"type\": \"string\"\n        }\n      },\n      \"alternative_explanations\": {\n        \"type\": \"array\",\n        \"minItems\": 1,\n        \"items\": {\n          \"type\": \"string\"\n        }\n      },\n      \"contrasts\": {\n        \"type\": \"array\",\n        \"minItems\": 1,\n        \"items\": {\n          \"type\": \"object\",\n          \"additionalProperties\": false,\n          \"required\": [\n            \"parent_ref\",\n            \"intervention\",\n            \"control\",\n            \"held_fixed\",\n            \"remaining_confounds\",\n            \"decision_if_supported\",\n            \"decision_if_not_supported\"\n          ],\n          \"properties\": {\n            \"parent_ref\": {\n              \"type\": \"string\"\n            },\n            \"intervention\": {\n              \"type\": \"string\"\n            },\n            \"control\": {\n              \"type\": \"string\"\n            },\n            \"held_fixed\": {\n              \"type\": \"array\",\n              \"items\": {\n                \"type\": \"string\"\n              }\n            },\n            \"remaining_confounds\": {\n              \"type\": \"array\",\n              \"items\": {\n                \"type\": \"string\"\n              }\n            },\n            \"decision_if_supported\": {\n              \"type\": \"string\"\n            },\n            \"decision_if_not_supported\": {\n              \"type\": \"string\"\n            }\n          }\n        }\n      },\n      \"cost_plan\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\n          \"estimate_ref\",\n          \"all_variants_counted\",\n          \"attribution_reserve\",\n          \"assessment_reserve\",\n          \"