rn raw,pooled,match(raw,pooled)\n\ncases=0;maxerr=0.0\nfor length in range(6):\n c,b,t=data(length); sc=[math.sin(i*3.1)*9 for i in range(length)]; sb=[math.cos(i*.7)*5 for i in range(length)]\n for layout in itertools.product(range(-1,4),repeat=length):\n  cases+=1; occupied=sorted(set(layout)-{-1}); active=float(bool(occupied)); wc=weights(sc,layout); wb=weights(sb,layout)\n  assert abs(sum(wc)-active)<1e-12 and abs(sum(wb)-active)<1e-12\n  assert all(wc[i]==0 and wb[i]==0 for i,g in enumerate(layout) if g<0)\n  for g in occupied: assert abs(sum(wc[i] for i,h in enumerate(layout) if h==g)-1/len(occupied))<1e-12\n  error=dist(wc,alternative_weights(sc,layout)); maxerr=max(error,maxerr); assert error<1e-12\n  # Independent group-wise score shifts must cancel under group balancing.\n  shifted=weights([sc[i]+100*(g+1) for i,g in enumerate(layout)],layout)\n  assert dist(wc,shifted)<1e-12\n  raw,pooled,summary=summarize(c,b,t,layout,wc,wb)\n  assert abs(norm(summary)-norm(pooled))<1e-10\n  uniform=weights([0.0]*length,layout)\n  uraw,upooled,usummary=summarize(c,b,t,layout,uniform,uniform)\n  group_means=[]\n  for g in occupied:\n   idx=[i for i,h in enumerate(layout) if h==g]\n   group_means.append([v/len(idx) for v in vecsum([[c[i][j]+b[i][j]+t[i][j] for j in range(3)] for i in idx])])\n  reconstructed=[v/max(1,len(occupied)) for v in vecsum(group_means)]\n  assert dist(uraw,reconstructed)<1e-12\n  assert dist(usummary,match(reconstructed,upooled))<1e-12\n  order=list(reversed(range(length)))\n  pc,pb,pt=([x[i] for i in order] for x in (c,b,t)); pg=[layout[i] for i in order]\n  altered=summarize(pc,pb,pt,pg,weights([sc[i] for i in order],pg),weights([sb[i] for i in order],pg))[2]\n  assert dist(summary,altered)<1e-10\n  padded=summarize(c+[[1e5]*3],b+[[-1e5]*3],t+[[42.0]*3],layout+(-1,),wc+[0.0],wb+[0.0])[2]\n  assert dist(summary,padded)<1e-10\n  if sum(g>=0 for g in layout)==1: assert dist(summary,pooled)<1e-12\n  # Partition cardinalities obey the exact count iden