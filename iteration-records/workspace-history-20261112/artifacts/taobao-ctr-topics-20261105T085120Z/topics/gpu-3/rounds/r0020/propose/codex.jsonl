{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport ast, hashlib, json, math, subprocess\nfrom pathlib import Path\np=json.loads(Path('proposal.json').read_text())\nr=json.loads(subprocess.check_output(['python3','/workspace/tools.py','resolve','run://r-001']))\n# Validate study against the actual exposed JSON schema, without dependencies.\ndef validate(value,schema,path='study'):\n typ=schema.get('type')\n if typ=='object':\n  assert isinstance(value,dict),path\n  assert all(k in value for k in schema.get('required',[])),path+' required'\n  if schema.get('additionalProperties') is False: assert set(value)<=set(schema.get('properties',{})),path+' extra'\n  for k,v in value.items():\n   if k in schema.get('properties',{}): validate(v,schema['properties'][k],path+'.'+k)\n elif typ=='array':\n  assert isinstance(value,list),path\n  assert len(value)>=schema.get('minItems',0),path\n  for i,v in enumerate(value): validate(v,schema.get('items',{}),path+'['+str(i)+']')\n elif typ=='string': assert isinstance(value,str) and len(value)>=schema.get('minLength',0),path\n if 'const' in schema: assert value==schema['const'],path\n if 'enum' in schema: assert value in schema['enum'],path\nvalidate(p['study'],r['study_schema'])\nassert p['parent_trial'] in r['context']['allowed_observation_ids']\nassert len({v['name'] for v in p['variants']})==len(p['variants'])\nassert any(v['role']=='candidate' for v in p['variants'])\nancestor=Path('history_g3_r0019_raw_target.py').read_text()\nassert hashlib.sha256(ancestor.encode()).hexdigest()=='69d54cf43272b07708cba124881581e39089523f068b90bf80b7f695648a2988'\nold=ast.parse(ancestor)\nchecks=[]\nfor v in p['variants']:\n source=Path(v['file']).read_text(); tree=ast.parse(source); compile(source,v['file'],'exec')\n cfg=next(n for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets))\n assert ast.literal_eval(cf