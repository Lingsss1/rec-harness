{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '1990,2700p' candidate.py\"","aggregated_output":"/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n        return {'summary': self._match_norm(raw, pooled), 'raw': raw,\n                'pooled': pooled, 'wc': wc, 'wb': wb, 'mask': mask}\n\n    def forward(self, batch):\n        parent, features = self._fusion_base(batch)\n        readout = self._retrieval(batch, features)['summary']\n        residual = self.fusion_head(torch.cat([features, readout], -1)).squeeze(-1)\n        return parent + residual\n\n    def _fusion_witness(self, batch):\n        # Both histories have unique category and brand identities and share\n        # every marginal mean, coarse action/age table and recurrence count.\n        # Only category versus fine log2-age association changes. All timestamps\n        # are distinct, under one hour, with identical gaps. Target 5 is absent.\n        device = batch['static'].device\n        witness = {\n            'static': batch['static'][:1].expand(2, -1).clone(),\n            'history_category': torch.tensor([[1, 2, 3, 4], [4, 3, 2, 1]], dtype=torch.long, device=device),\n            'history_brand': torch.tensor([[1, 2, 3, 4], [1, 2, 3, 4]], dtype=torch.long, device=device),\n            'history_type': torch.ones((2, 4), dtype=torch.long, device=device),\n            'history_age_seconds': torch.tensor([[100, 200, 300, 400]] * 2,\n                                               dtype=batch['history_age_seconds'].dtype, device=device),\n            'history_mask': torch.ones((2, 4), dtype=torch.bool, device=device),\n        }\n        witness['static'][:, self.category] = 5\n        witness['static'][:, self.brand] = 5\n        return witness\n\n    def diagnostics(self, batch):\n        \"\"\"Bounded label-free checks; predictive attribution needs host scores.\n\n        Run only on the host's fixed first-512 validation diagnostic batch.\n        Witnesses probe information and checkpoint sensitivity, never utility.\n        \"\"\"\n        def maximum(x):\n            return x.abs().max() if x.numel() else x.new_zeros(())\n\n        parent, features = self._fusion_base(batch)\n        original_parent = _PooledObservedModel.forward(self, batch)\n        reads = {mode: self._retrieval(batch, features, mode)\n                 for mode in ('target', 'context', 'uniform', 'pooled_duplicate')}\n        read = reads[self.fusion_mode]\n        summary = read['summary']\n        residual = self.fusion_head(torch.cat([features, summary], -1)).squeeze(-1)\n        mask = batch['history_mask']\n        n = mask.float().sum(-1)\n        _, semantic, sizes = self._membership(batch)\n        occupied = sizes > 0\n        prior = occupied.float() / occupied.sum(-1, keepdim=True).clamp_min(1)\n        mass = torch.stack([(semantic * reads['target'][k][:, None, :]).sum(-1)\n                            for k in ('wc', 'wb')])\n        dim = self.config['embedding_dim']\n        pools = features[:, self.static_width:self.static_width + 4 * dim].reshape(features.shape[0], 4, dim)\n        uniform_raw = (pools * prior.unsqueeze(-1)).sum(1)\n        uniform_summary = self._match_norm(uniform_raw, reads['uniform']['pooled'])\n        active = read['mask'].any(-1).float()\n        result = {\n            'allocated_parameters': float(sum(p.numel() for p in self.parameters())),\n            'appended_head_parameters': float(sum(p.numel() for p in self.fusion_head.parameters())),\n            'scorer_parameters': float(sum(p.numel() for p in self.attention.parameters())),\n            'scorer_active_by_design': float(self.fusion_mode != 'uniform'),\n            'target_query_mode': float(self.fusion_mode == 'target'),\n            'context_query_mode': float(self.fusion_mode == 'context'),\n            'uniform_mode': float(self.fusion_mode == 'uniform'),\n            'pooled_duplicate_mode': float(self.fusion_mode == 'pooled_duplicate'),\n            'inherited_feature_width': float(features.shape[-1]),\n            'appended_feature_width': float(summary.shape[-1]),\n            'parent_forward_reproduction_error_max': maximum(parent - original_parent),\n            'fusion_residual_rms': residual.square().mean().sqrt(),\n            'fusion_final_weight_norm': torch.linalg.vector_norm(self.fusion_head[-1].weight),\n            'selected_summary_rms': summary.square().mean().sqrt(),\n            'selected_norm_error_max': maximum(summary.norm(dim=-1) - read['pooled'].norm(dim=-1)),\n            'norm_fallback_fraction': (read['raw'].norm(dim=-1) <= 1e-6).float().mean(),\n            'weight_mass_error_max': maximum(torch.stack([read[k].sum(-1) - active for k in ('wc', 'wb')])),\n            'masked_weight_error_max': maximum(torch.stack([read[k] * (~read['mask']).float() for k in ('wc', 'wb')])),\n            'target_balanced_mass_error_max': maximum(mass - prior.unsqueeze(0)),\n            'uniform_existing_pool_reconstruction_error_max': maximum(reads['uniform']['summary'] - uniform_summary),\n            'target_context_summary_rms_delta_fixed_groups': (reads['target']['summary'] - reads['context']['summary']).square().mean().sqrt(),\n            'target_uniform_summary_rms_delta': (reads['target']['summary'] - reads['uniform']['summary']).square().mean().sqrt(),\n            'target_pooled_duplicate_summary_rms_delta': (reads['target']['summary'] - reads['pooled_duplicate']['summary']).square().mean().sqrt(),\n            'pooled_reference_reconstruction_error_max': maximum(reads['target']['pooled'] - reads['pooled_duplicate']['pooled']),\n            'nonempty_fraction': (n > 0).float().mean(),\n            'occupied_groups_mean': occupied.float().sum(-1).mean(),\n            'singleton_summary_error_max': maximum((summary - read['pooled']) * (n == 1).unsqueeze(-1)),\n            'history_feature_finite': float(torch.isfinite(features).all()),\n            'forward_finite': float(torch.isfinite(parent + residual).all()),\n        }\n        # Readouts ignore supplied event order; full parent instead reconstructs\n        # chronological transitions from ages. Ignore padding contents only.\n        reverse, padded, zero_length, empty = (dict(batch) for _ in range(4))\n        for field in ('history_category', 'history_brand', 'history_type', 'history_age_seconds', 'history_mask'):\n            reverse[field] = batch[field].flip(-1)\n            fill = batch[field].new_zeros((batch[field].shape[0], 2))\n            if field != 'history_mask':\n                fill.fill_(1)\n            padded[field] = torch.cat([batch[field], fill], -1)\n            zero_length[field] = batch[field][:, :0]\n        empty['history_mask'] = torch.zeros_like(mask)\n        for label, altered in (('reordering', reverse), ('padding', padded)):\n            altered_parent, altered_features = self._fusion_base(altered)\n            altered_summary = self._retrieval(altered, altered_features)['summary']\n            altered_residual = self.fusion_head(torch.cat([altered_features, altered_summary], -1)).squeeze(-1)\n            result[label + '_shared_feature_error_max'] = maximum(features - altered_features)\n            result[label + '_summary_error_max'] = maximum(summary - altered_summary)\n            result[label + '_logit_error_max'] = maximum(parent + residual - (altered_parent + altered_residual))\n        for label, altered in (('empty', empty), ('zero_length', zero_length)):\n            altered_parent, altered_features = self._fusion_base(altered)\n            altered_summary = self._retrieval(altered, altered_features)['summary']\n            result[label + '_summary_abs_max'] = maximum(altered_summary)\n            result[label + '_logits_finite'] = float(torch.isfinite(\n                altered_parent + self.fusion_head(torch.cat([altered_features, altered_summary], -1)).squeeze(-1)).all())\n        applicable = self.category_vocab > 5 and self.brand_vocab > 5\n        result['witness_applicable'] = float(applicable)\n        if applicable:\n            witness = self._fusion_witness(batch)\n            witness_parent, witness_features = self._fusion_base(witness)\n            result['witness_parent_logit_error_max'] = maximum(witness_parent[:1] - witness_parent[1:])\n            result['witness_shared_feature_error_max'] = maximum(witness_features[:1] - witness_features[1:])\n            for mode in ('target', 'context', 'uniform', 'pooled_duplicate'):\n                value = self._retrieval(witness, witness_features, mode)['summary']\n                result['witness_' + mode + '_summary_gap_max'] = maximum(value[:1] - value[1:])\n                added = self.fusion_head(torch.cat([witness_features, value], -1)).squeeze(-1)\n                result['witness_' + mode + '_added_logit_gap'] = maximum(added[:1] - added[1:])\n        return {name: float(value) for name, value in result.items()}\n\n\nclass Model(_NormalizedFusionModel):\n    \"\"\"Keep readout magnitude; only the post-pooling norm constraint changes.\n\n    The frozen normalized implementation above is retained verbatim except for\n    its class name and module CONFIG. All allocations, parameter names, random\n    draws, group masses, query construction, keys/values and optimizer defaults\n    are inherited. Forward still computes the normalized alternative, but the\n    head receives raw instead. Backward cost can differ and must be measured.\n    This does not remove group softmax or restore DIN's unnormalized weights.\n    \"\"\"\n    def __init__(self, meta, config=None):\n        super().__init__(meta, config)\n        if self.config['readout_scale_mode'] != 'raw':\n            raise ValueError('This registered study fixes raw readout magnitude')\n\n    def _retrieval(self, batch, features=None, mode=None):\n        read = super()._retrieval(batch, features, mode)\n        # No detach, fitted scale, extra parameter, cache, label or input.\n        # Dict replacement leaves the inherited raw calculation untouched.\n        read['summary'] = read['raw']\n        return read\n\n    def diagnostics(self, batch):\n        \"\"\"Label-free checks on the host's fixed first-512 checkpoint probe.\n\n        Norm intervention at one checkpoint is descriptive, not a substitute\n        for independently trained matched controls or population inference.\n        \"\"\"\n        def maximum(x):\n            return x.abs().max() if x.numel() else x.new_zeros(())\n\n        parent, features = self._fusion_base(batch)\n        reads = {mode: self._retrieval(batch, features, mode)\n                 for mode in ('target', 'context', 'uniform', 'pooled_duplicate')}\n        normalized = {mode: _NormalizedFusionModel._retrieval(self, batch, features, mode)\n                      for mode in reads}\n        selected = reads[self.fusion_mode]\n        summary = selected['summary']\n        residual = self.fusion_head(torch.cat([features, summary], -1)).squeeze(-1)\n        norm_residual = self.fusion_head(torch.cat([\n            features, normalized[self.fusion_mode]['summary']], -1)).squeeze(-1)\n        _, semantic, sizes = self._membership(batch)\n        occupied = sizes > 0\n        prior = occupied.float() / occupied.sum(-1, keepdim=True).clamp_min(1)\n        mass = torch.stack([(semantic * reads['target'][key][:, None, :]).sum(-1)\n                            for key in ('wc', 'wb')])\n        dim = self.config['embedding_dim']\n        pools = features[:, self.static_width:self.static_width + 4 * dim].reshape(\n            features.shape[0], 4, dim)\n        uniform_raw = (pools * prior.unsqueeze(-1)).sum(1)\n        n = batch['history_mask'].float().sum(-1)\n        active = selected['mask'].any(-1).float()\n        result = {\n            'allocated_parameters': float(sum(p.numel() for p in self.parameters())),\n            'appended_head_parameters': float(sum(p.numel() for p in self.fusion_head.parameters())),\n            'scorer_parameters': float(sum(p.numel() for p in self.attention.parameters())),\n            'scorer_active_by_design': float(self.fusion_mode != 'uniform'),\n            'raw_scale_mode': 1.0,\n            'target_query_mode': float(self.fusion_mode == 'target'),\n            'context_query_mode': float(self.fusion_mode == 'context'),\n            'uniform_mode': float(self.fusion_mode == 'uniform'),\n            'pooled_duplicate_mode': float(self.fusion_mode == 'pooled_duplicate'),\n            'inherited_feature_width': float(features.shape[-1]),\n            'appended_feature_width': float(summary.shape[-1]),\n            'parent_forward_reproduction_error_max': maximum(\n                parent - _PooledObservedModel.forward(self, batch)),\n            'raw_summary_selection_error_max': maximum(summary - selected['raw']),\n            'normalized_counterpart_reconstruction_error_max': maximum(\n                normalized[self.fusion_mode]['summary'] -\n                self._match_norm(selected['raw'], selected['pooled'])),\n            'uniform_existing_pool_reconstruction_error_max': maximum(\n                reads['uniform']['raw'] - uniform_raw),\n            'pooled_reference_reconstruction_error_max': maximum(\n                reads['target']['pooled'] - reads['pooled_duplicate']['pooled']),\n            'selected_raw_rms': summary.square().mean().sqrt(),\n            'selected_normalized_rms': normalized[self.fusion_mode]['summary'].square().mean().sqrt(),\n            'raw_vs_normalized_summary_rms_delta': (\n                summary - normalized[self.fusion_mode]['summary']).square().mean().sqrt(),\n            'raw_vs_reference_norm_abs_delta_mean': (\n                summary.norm(dim=-1) - selected['pooled'].norm(dim=-1)).abs().mean(),\n            'norm_fallback_fraction': (summary.norm(dim=-1) <= 1e-6).float().mean(),\n            'fusion_residual_rms': residual.square().mean().sqrt(),\n            'checkpoint_norm_intervention_logit_rms_delta': (\n                residual - norm_residual).square().mean().sqrt(),\n            'weight_mass_error_max': maximum(torch.stack([\n                selected[key].sum(-1) - active for key in ('wc', 'wb')])),\n            'masked_weight_error_max': maximum(torch.stack([\n                selected[key] * (~selected['mask']).float() for key in ('wc', 'wb')])),\n            'target_balanced_mass_error_max': maximum(mass - prior.unsqueeze(0)),\n            'target_context_raw_rms_delta_fixed_groups': (\n                reads['target']['raw'] - reads['context']['raw']).square().mean().sqrt(),\n            'target_uniform_raw_rms_delta': (\n                reads['target']['raw'] - reads['uniform']['raw']).square().mean().sqrt(),\n            'nonempty_fraction': (n > 0).float().mean(),\n            'singleton_raw_error_max': maximum(\n                (reads['target']['raw'] - reads['target']['pooled']) * (n == 1).unsqueeze(-1)),\n            'history_feature_finite': float(torch.isfinite(features).all()),\n            'forward_finite': float(torch.isfinite(parent + residual).all()),\n        }\n        reverse, padded, zero_length, empty = (dict(batch) for _ in range(4))\n        for field in ('history_category', 'history_brand', 'history_type',\n                      'history_age_seconds', 'history_mask'):\n            reverse[field] = batch[field].flip(-1)\n            fill = batch[field].new_zeros((batch[field].shape[0], 2))\n            if field != 'history_mask':\n                fill.fill_(1)\n            padded[field] = torch.cat([batch[field], fill], -1)\n            zero_length[field] = batch[field][:, :0]\n        empty['history_mask'] = torch.zeros_like(batch['history_mask'])\n        for label, altered in (('reordering', reverse), ('padding', padded)):\n            altered_parent, altered_features = self._fusion_base(altered)\n            altered_summary = self._retrieval(altered, altered_features)['summary']\n            altered_residual = self.fusion_head(torch.cat([\n                altered_features, altered_summary], -1)).squeeze(-1)\n            result[label + '_shared_feature_error_max'] = maximum(features - altered_features)\n            result[label + '_summary_error_max'] = maximum(summary - altered_summary)\n            result[label + '_logit_error_max'] = maximum(\n                parent + residual - altered_parent - altered_residual)\n        for label, altered in (('empty', empty), ('zero_length', zero_length)):\n            altered_parent, altered_features = self._fusion_base(altered)\n            altered_summary = self._retrieval(altered, altered_features)['summary']\n            result[label + '_summary_abs_max'] = maximum(altered_summary)\n            result[label + '_logits_finite'] = float(torch.isfinite(\n                altered_parent + self.fusion_head(torch.cat([\n                    altered_features, altered_summary], -1)).squeeze(-1)).all())\n        # Same realizable history-pair probe as the ancestor; sensitivity of\n        # a representation/logit is not evidence that it improves prediction.\n        applicable = self.category_vocab > 5 and self.brand_vocab > 5\n        result['witness_applicable'] = float(applicable)\n        if applicable:\n            witness = self._fusion_witness(batch)\n            witness_parent, witness_features = self._fusion_base(witness)\n            result['witness_parent_logit_error_max'] = maximum(witness_parent[:1] - witness_parent[1:])\n            result['witness_shared_feature_error_max'] = maximum(witness_features[:1] - witness_features[1:])\n            for mode in reads:\n                value = self._retrieval(witness, witness_features, mode)['summary']\n                result['witness_' + mode + '_raw_gap_max'] = maximum(value[:1] - value[1:])\n        return {name: float(value) for name, value in result.items()}\n","exit_code":0,"status":"completed"}}
