{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport ast,json\nfrom pathlib import Path\nproposal=json.loads(Path('proposal.json').read_text())\noriginal=Path('history_g3_r0019_raw_target.py').read_text()\nappend='''\n\nclass Model(_RawFusionModel):\n    \\\"\\\"\\\"Transmit raw retrieval radius on the inherited global pooled direction.\n\n    Target/context retrieval, all allocation and parent initialization remain\n    inherited. Pooled-reference computes the same radial path with zero output\n    influence: allocated capacity is matched, active scorer capacity is not.\n    No raw direction is used as a fallback when pooled direction is undefined.\n    \\\"\\\"\\\"\n    def __init__(self, meta, config=None):\n        super().__init__(meta, config)\n        self.geometry_mode = self.config['geometry_mode']\n        if self.geometry_mode not in ('radius', 'pooled'):\n            raise ValueError('Unknown geometry_mode')\n        if self.fusion_mode not in ('target', 'context'):\n            raise ValueError('Only target/context queries are registered here')\n\n    @staticmethod\n    def _radius_on_pool(raw, pooled):\n        raw_norm = raw.norm(dim=-1, keepdim=True)\n        pooled_norm = pooled.norm(dim=-1, keepdim=True)\n        radial = pooled * (raw_norm / pooled_norm.clamp_min(1e-6))\n        # All arithmetic is finite before selection, including empty histories.\n        # A zero or nearly cancelling pooled vector has no reliable direction.\n        radial = torch.where(pooled_norm > 1e-6, radial, torch.zeros_like(radial))\n        return radial, raw_norm, pooled_norm\n\n    def _retrieval(self, batch, features=None, mode=None):\n        read = super()._retrieval(batch, features, mode)\n        radial, raw_norm, pooled_norm = self._radius_on_pool(read['raw'], read['pooled'])\n        # Zero term retains the scorer path in the reference graph; its\n        # gradient is zero. Wall/allocated-GPU/inference cost still needs host\n        # measurement and is not guaranteed equal by this construction.\n        reference = read['pooled'] + 0.0 * radial\n        read['summary'] = radial if self.geometry_mode == 'radius' else reference\n        read['radial'] = radial\n        read['raw_norm'] = raw_norm\n        read['pooled_norm'] = pooled_norm\n        return read\n\n    def diagnostics(self, batch):\n        \\\"\\\"\\\"Candidate-supplied label-free implementation checks, <=64 scalars.\n\n        Same-checkpoint geometry substitutions are descriptive only; predictive\n        attribution requires independently trained cells and paired repeats.\n        \\\"\\\"\\\"\n        def maximum(value):\n            return value.abs().max() if value.numel() else value.new_zeros(())\n\n        def rms(value):\n            return value.square().mean().sqrt() if value.numel() else value.new_zeros(())\n\n        parent, features = self._fusion_base(batch)\n        read = self._retrieval(batch, features)\n        inherited = _RawFusionModel._retrieval(self, batch, features)\n        summary = read['summary']\n        raw, pooled = read['raw'], read['pooled']\n        raw_norm, pooled_norm = read['raw_norm'], read['pooled_norm']\n        supported = pooled_norm > 1e-6\n        nonempty = batch['history_mask'].any(-1)\n        residual = self.fusion_head(torch.cat([features, summary], -1)).squeeze(-1)\n        reference_residual = self.fusion_head(torch.cat([features, pooled], -1)).squeeze(-1)\n        full_residual = self.fusion_head(torch.cat([features, raw], -1)).squeeze(-1)\n        reconstructed = self._match_norm(pooled, raw)\n        # _match_norm(pooled,raw) falls back to raw when p is tiny. The new\n        # candidate deliberately returns zero instead, so compare supported\n        # cases only and separately report support/shortfall.\n        projection = ((read['radial'] * pooled).sum(-1, keepdim=True)\n                      / pooled.square().sum(-1, keepdim=True).clamp_min(1e-12)) * pooled\n        dim = self.config['embedding_dim']\n        pools = features[:, self.static_width:self.static_width+4*dim].reshape(\n            features.shape[0], 4, dim)\n        _, _, sizes = self._membership(batch)\n        pooled_oracle = (pools * sizes.unsqueeze(-1)).sum(1) / sizes.sum(-1, keepdim=True).clamp_min(1)\n        expected = read['radial'] if self.geometry_mode == 'radius' else pooled\n        result = {\n            'allocated_parameters': float(sum(p.numel() for p in self.parameters())),\n            'appended_head_parameters': float(sum(p.numel() for p in self.fusion_head.parameters())),\n            'scorer_parameters': float(sum(p.numel() for p in self.attention.parameters())),\n            'scorer_active_by_design': float(self.geometry_mode == 'radius'),\n            'radius_mode': float(self.geometry_mode == 'radius'),\n            'target_query_mode': float(self.fusion_mode == 'target'),\n            'context_query_mode': float(self.fusion_mode == 'context'),\n            'parent_forward_reproduction_error_max': maximum(parent - _PooledObservedModel.forward(self, batch)),\n            'inherited_raw_reproduction_error_max': maximum(raw - inherited['summary']),\n            'summary_selection_error_max': maximum(summary - expected),\n            'radius_swap_reconstruction_error_max': maximum((read['radial'] - reconstructed) * supported.to(raw.dtype)),\n            'radius_norm_error_supported_max': maximum((read['radial'].norm(dim=-1, keepdim=True) - raw_norm) * supported.to(raw.dtype)),\n            'radial_collinearity_error_max': maximum(read['radial'] - projection),\n            'pooled_existing_feature_reconstruction_error_max': maximum(pooled - pooled_oracle),\n            'unsupported_pooled_fraction': (~supported).float().mean(),\n            'unsupported_nonempty_fraction': ((~supported.squeeze(-1)) & nonempty).float().mean(),\n            'unsupported_raw_radius_max': maximum(raw_norm * (~supported).to(raw.dtype)),\n            'raw_radius_mean': raw_norm.mean(),\n            'pooled_radius_mean': pooled_norm.mean(),\n            'radial_vs_raw_rms_delta': rms(read['radial'] - raw),\n            'radial_vs_pooled_rms_delta': rms(read['radial'] - pooled),\n            'selected_summary_rms': rms(summary),\n            'fusion_residual_rms': rms(residual),\n            'checkpoint_summary_vs_pool_logit_rms_delta': rms(residual - reference_residual),\n            'checkpoint_summary_vs_raw_logit_rms_delta': rms(residual - full_residual),\n            'forward_finite': float(torch.isfinite(parent + residual).all()),\n            'summary_finite': float(torch.isfinite(summary).all()),\n            'nonempty_fraction': nonempty.float().mean(),\n        }\n        # These probes exercise only public batch fields and use no labels.\n        reverse, padded, empty, zero_length = (dict(batch) for _ in range(4))\n        for field in ('history_category', 'history_brand', 'history_type',\n                      'history_age_seconds', 'history_mask'):\n            reverse[field] = batch[field].flip(-1)\n            fill = batch[field].new_zeros((batch[field].shape[0], 2))\n            if field \"'!= '\"'history_mask':\n                fill.fill_(1)\n            padded[field] = torch.cat([batch[field], fill], -1)\n            zero_length[field] = batch[field][:, :0]\n        empty['history_mask'] = torch.zeros_like(batch['history_mask'])\n        for label, altered in (('reordering', reverse), ('padding', padded)):\n            ap, af = self._fusion_base(altered)\n            ar = self._retrieval(altered, af)\n            al = ap + self.fusion_head(torch.cat([af, ar['summary']], -1)).squeeze(-1)\n            result[label + '_shared_feature_error_max'] = maximum(features - af)\n            result[label + '_summary_error_max'] = maximum(summary - ar['summary'])\n            result[label + '_logit_error_max'] = maximum(parent + residual - al)\n        for label, altered in (('empty', empty), ('zero_length', zero_length)):\n            ap, af = self._fusion_base(altered)\n            ar = self._retrieval(altered, af)\n            al = ap + self.fusion_head(torch.cat([af, ar['summary']], -1)).squeeze(-1)\n            result[label + '_summary_abs_max'] = maximum(ar['summary'])\n            result[label + '_logits_finite'] = float(torch.isfinite(al).all())\n        singleton = (batch['history_mask'].sum(-1) == 1).to(raw.dtype).unsqueeze(-1)\n        result['singleton_radial_vs_pool_error_max'] = maximum((read['radial'] - pooled) * singleton)\n        applicable = self.category_vocab > 5 and self.brand_vocab > 5\n        result['witness_applicable'] = float(applicable)\n        if applicable:\n            witness = self._fusion_witness(batch)\n            wp, wf = self._fusion_base(witness)\n            wr = self._retrieval(witness, wf)\n            added = self.fusion_head(torch.cat([wf, wr['summary']], -1)).squeeze(-1)\n            result['witness_parent_logit_error_max'] = maximum(wp[:1] - wp[1:])\n            result['witness_shared_feature_error_max'] = maximum(wf[:1] - wf[1:])\n            result['witness_pooled_error_max'] = maximum(wr['pooled'][:1] - wr['pooled'][1:])\n            result['witness_raw_radius_gap_max'] = maximum(wr['raw_norm'][:1] - wr['raw_norm'][1:])\n            result['witness_selected_summary_gap_max'] = maximum(wr['summary'][:1] - wr['summary'][1:])\n            result['witness_added_logit_gap_max'] = maximum(added[:1] - added[1:])\n        return {name: float(value) for name, value in result.items()}\n'''\nfor v in proposal['variants']:\n base=original.replace('class Model(_NormalizedFusionModel):','class _RawFusionModel(_NormalizedFusionModel):',1)\n tree=ast.parse(base); assignment=next(n for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(x,ast.Name) and x.id=='CONFIG' for x in n.targets))\n lines=base.splitlines(); lines[assignment.lineno-1:assignment.end_lineno]=['CONFIG = '+repr(v['config'])]\n text='\\\\n'.join(lines)+'\\\\n'+append\n Path(v['file']).write_text(text)\n print(v['file'],len(text),'bytes')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
