gap_head(features).square().mean().sqrt(),\n            'zero_input_residual_abs_max': self.gap_head(torch.zeros_like(features)).abs().max(),\n        }\n        for scope in ('context', 'pooled'):\n            observed, marginal = counts[scope + '_observed'], counts[scope + '_marginal']\n            result[scope + '_channel_margin_error_max'] = (observed.sum(2) - marginal.sum(2)).abs().max()\n            result[scope + '_gap_total_error_max'] = (observed[:, 0] - marginal[:, 0]).abs().max()\n            result[scope + '_nonnegative_violation_max'] = (-marginal).clamp_min(0).max()\n            result[scope + '_subset_violation_max'] = (marginal[:, 1:] - marginal[:, :1]).clamp_min(0).max()\n        norms = []\n        for name, value in counts.items():\n            compact = torch.log1p(value) / math.log(129.0)\n            norms.append((views[name].square().sum(-1) - compact.square().sum((1, 2, 3))).abs().max())\n        result['isometric_lift_norm_error_max'] = torch.stack(norms).max()\n        # These are feature invariances. Full-model logits need not share them.\n        reverse, padded, zero_length = dict(batch), dict(batch), dict(batch)\n        for field in ('history_category', 'history_brand', 'history_type', 'history_age_seconds', 'history_mask'):\n            reverse[field] = batch[field].flip(-1)\n            zero_length[field] = batch[field][:, :0]\n            fill = batch[field].new_zeros((batch[field].shape[0], 2))\n            if field != 'history_mask':\n                fill.fill_(1)\n            padded[field] = torch.cat([batch[field], fill], -1)\n        for label, altered in (('reordering', reverse), ('padding', padded)):\n            result[label + '_feature_error_max'] = (features - self._gap_features(self._gap_tables(altered))).abs().max()\n        result['zero_length_feature_abs_max'] = self._gap_features(self._gap_tables(zero_length)).abs().max()\n        for label, field in (('empty', 'history_mask'), ('missing', 'history_brand'), ('tied', 'history_age_seconds')):\n            altered = dict(batch)\n            altered[field] = torch.zeros_like(batch[field])\n            result[label + '_feature_abs_max'] = self._gap_features(self._gap_tables(altered)).abs().max()\n        changed = dict(batch)\n        changed['static'] = torch.zeros_like(batch['static'])\n        # Constant action merges contexts; unlike a bijective action rename it\n        # can expose the inherited sum-of-products partition dependence.\n        changed['history_type'] = torch.ones_like(batch['history_type'])\n        changed_views = self._association_views(self._gap_tables(changed))\n        result['pooled_target_action_invariance_error_max'] = torch.stack([\n            (views['pooled_' + association] - changed_views['pooled_' + association]).abs().max()\n            for association in ('observed', 'marginal')]).max()\n        applicable = self.category_vocab > 4 and self.brand_vocab > 4\n        result['witness_applicable'] = float(applicable)\n        if applicable:\n            for kind in ('context', 'association'):\n                witness = self._association_witness(batch, kind)\n                witness_counts = self._association_counts(self._gap_tables(witness))\n                witness_views = {name: self._gap_lift(value) for name, value in witness_counts.items()}\n                for name, value in witness_views.items():\n                    result[kind + '_witness_' + name + '_gap_max'] = (value[0] - value[1]).abs().max()\n                added = self.gap_head(witness_views[key]).squeeze(-1)\n                result[kind + '_witness_added_logit_gap'] = (added[0] - added[1]).abs()\n                if kind == 'association':\n                    for scope in ('context', 'pooled'):\n                        margins = witness_counts[scope + '_observed'].sum(2)\n                        result[scope + '_witness_margin_error_max'] = (margins[0] - margins[1]).abs().max()\n                    parent = _ParentModel.forward(self, witness)\n                    result['association_witness_pre_gap_parent_logit_error_max'] = (parent[0] - parent[1]).abs()\n        return {name: float(value) for name, value in result.items()}\n\n\nclass _NormalizedFusionModel(_PooledObservedModel):\n    \"\"\"Complete pooled predictor plus a controlled history-readout residual.\n\n    Modes share all allocations and start with the exact parent's function.\n    Context replaces only query construction. Uniform duplicates inherited\n    evidence with an inactive scorer; pooled_duplicate is an active scorer\n    control using only pre-existing group means, sizes and target embeddings.\n    \"\"\"\n    def __init__(self, meta, config=None):\n        super().__init__(meta, config)\n        self.fusion_mode = self.config['fusion_mode']\n        if self.fusion_mode not in ('target', 'context', 'uniform', 'pooled_duplicate'):\n            raise ValueError('Unknown fusion_mode')\n        self.group_balanced = True\n        self.static_width = len(meta['fields']) * self.config['embedding_dim']\n        dim = self.config['embedding_dim']\n        # Parent attention is allocated in every inherited model but dormant.\n        # Reuse it with its original initialization: do not allocate a second\n        # scorer or consume any random draw before the complete parent exists.\n        # Existing first-layer shape fixes the exact inherited feature width.\n        width = self.output[0].in_features + dim\n        self.fusion_head = nn.Sequential(\n            nn.Linear(width, self.config['fusion_hidden'], bias=False), nn.ReLU(),\n            nn.Linear(self.config['fusion_hidden'], 1, bias=False)\n        )\n        nn.init.zeros_(self.fusion_head[-1].weight)\n\n    def _fusion_base(self, batch):\n        # Exact _ParentModel._parent_forward arithmetic, exposing its shared\n        # features without a cache or a repeated embedding pass. Then append\n        # the exact chronological transition and pooled observed gap residuals.\n        features, _, _, _, _, semantic, _ = self._shared_features(batch)\n        tables = self._identity_tables(batch, semantic)\n        context = self._context_tables(batch, tables)\n        parent = self.output(features).squeeze(-1)\n        identity = self.identity_head(self._identity_features(tables)).squeeze(-1)\n        extra = self.context_head(self._context_features(context)).squeeze(-1)\n        repeat_tables = self._conditional_tables(batch, tables, context)\n        repeat = self.repeat_head(self._repeat_features(repeat_tables)).squeeze(-1)\n        overlap_tables = self._overlap_tables(batch, tables, context)\n        overlap = self.overlap_head(self._overlap_features(overlap_tables)).squeeze(-1)\n        parent = parent + identity + extra + repeat + overlap\n        transition = self._transition_tables(batch)\n        parent = parent + self.transition_head(self._transition_features(transition)).squeeze(-1)\n        gap = self._gap_features(self._gap_tables(batch))\n        parent = parent + self.gap_head(gap).squeeze(-1)\n        return parent, features\n\n\n    def _encode(self, batch):\n        fields = [e(batch['static'][:, i]) for i, e in enumerate(self.embeddings)]\n        mask = batch['history_mask']\n        ages = (torch.log2(batch['history_age_seconds'].clamp_min(0) + 1).long()\n                + 1).clamp(0, 32)\n        category = self.embeddings[self.category](batch['history_category'])\n        brand = self.embeddings[self.brand](batch['history_brand'])\n        common = self.action(batch['history_type']) + self.recency(ages)\n        uniform = mask.float() / mask.sum(-1, keepdim=True).clamp_min(1)\n        context = torch.stack([\n            (uniform.unsqueeze(-1) * category).sum(1),\n            (uniform.unsqueeze(-1) * brand).sum(1),\n        ], dim=1)\n        target = torch.stack([fields[self.category], fields[self.brand]], dim=1)\n        pooled = (uniform.unsqueeze(-1) * (category + brand + common)).sum(1)\n        return fields, category, brand, common, mask, pooled, target, context\n\n    def _score(self, query, keys):\n        query = query[:, None, :].expand_as(keys)\n        relation = torch.cat([query, keys, query - keys, query * keys], dim=-1)\n        return self.attention(relation).squeeze(-1)\n\n    @staticmethod\n    def _weights(scores, mask):\n        weights = scores.masked_fill(~mask, -1e4).softmax(-1) * mask.float()\n        return weights / weights.sum(-1, keepdim=True).clamp_min(1e-9)\n\n    @staticmethod\n    def _group_weights(scores, membership):\n        \"\"\"Each occupied match group receives 1/K mass; empty groups receive 0.\n\n        A separate stable softmax is evaluated inside each group. This is a\n        change to event-weight allocation, not the original group features.\n        \"\"\"\n        valid = membership.bool()\n        expanded = scores[:, None, :].expand_as(membership)\n        # A finite minimum keeps an all-masked group finite before zeroing it.\n        weights = expanded.masked_fill(~valid, torch.finfo(scores.dtype).min).softmax(-1)\n        weights = weights * valid.to(weights.dtype)\n        weights = weights / weights.sum(-1, keepdim=True).clamp_min(1e-9)\n        occupied = valid.any(-1).to(weights.dtype)\n        prior = occupied / occupied.sum(-1, keepdim=True).clamp_min(1)\n        return (weights * prior.unsqueeze(-1)).sum(1)\n\n    @staticmethod\n    def _match_norm(raw, pooled):\n        raw_norm = raw.norm(dim=-1, keepdim=True)\n        reference_norm = pooled.norm(dim=-1, keepdim=True)\n        matched = raw * (reference_norm / raw_norm.clamp_min(1e-6))\n        # Degenerate vectors use the reference itself, including empty histories.\n        # Both branches are finite before where; no divisions by zero occur.\n        return torch.where(raw_norm > 1e-6, matched, pooled)\n\n    def _fusion_read(self, category, brand, common, mask, query, membership, learned=True):\n        if mask.shape[1] == 0:\n            zero = category.sum(1)\n            weights = mask.float()\n            return zero, weights, weights, weights, weights, weights, weights\n        # Zero scaling is the uniform control. It preserves the scorer's\n        # allocation and graph while giving its parameters exactly zero gradient.\n        # Every cell computes global and grouped weights, including zero-scaled\n        # backward paths. Measured host cost, not graph similarity, is decisive.\n        scale = float(learned)\n        category_score = self._score(query[:, 0], category + common) * scale\n        brand_score = self._score(query[:, 1], brand + common) * scale\n        global_c = self._weights(category_score, mask)\n        global_b = self._weights(brand_score, mask)\n        balanced_c = self._group_weights(category_score, membership)\n        balanced_b = self._group_weights(brand_score, membership)\n        alpha = float(self.group_balanced)\n        wc = alpha * balanced_c + (1.0 - alpha) * global_c\n        wb = alpha * balanced_b + (1.0 - alpha) * global_b\n        raw = (wc.unsqueeze(-1) * category + wb.unsqueeze(-1) * brand\n               + (0.5 * (wc + wb)).unsqueeze(-1) * common).sum(1)\n        return raw, wc, wb, global_c, global_b, balanced_c, balanced_b\n\n    def _pooled_retrieval(self, features, sizes):\n        \"\"\"Pure recombination of inherited shared features and group counts.\n\n        The four summed group means are already inputs to the parent MLP.\n        Their sizes are n-c-b+j, c-j, b-j, j from its match-count statistics.\n        These are sufficient to reconstruct the global reference mean, too.\n        Both target queries are slices of the existing static feature block.\n        This scorer is active; only its keys/values have been compressed.\n        Softmax is across occupied groups, rather than fixed group masses.\n        \"\"\"\n        dim = self.config['embedding_dim']\n        start = self.static_width\n        pools = features[:, start:start + 4 * dim].reshape(features.shape[0], 4, dim)\n        target_c = features[:, self.category * dim:(self.category + 1) * dim]\n        target_b = features[:, self.brand * dim:(self.brand + 1) * dim]\n        mask = sizes > 0\n        membership = mask[:, None, :].to(pools.dtype)\n        wc = self._group_weights(self._score(target_c, pools), membership)\n        wb = self._group_weights(self._score(target_b, pools), membership)\n        raw = (0.5 * (wc + wb).unsqueeze(-1) * pools).sum(1)\n        pooled = (pools * sizes.unsqueeze(-1)).sum(1) / sizes.sum(-1, keepdim=True).clamp_min(1)\n        return {'summary': self._match_norm(raw, pooled), 'raw': raw,\n                'pooled': pooled, 'wc': wc, 'wb': wb, 'mask': mask}\n\n    def _retrieval(self, batch, features=None, mode=None):\n        mode = self.fusion_mode if mode is None else mode\n        if mode == 'pooled_duplicate':\n            if features is None:\n                features = self._shared_features(batch)[0]\n            sizes = self._membership(batch)[2]\n            return self._pooled_retrieval(features, sizes)\n        _, category, brand, common, mask, pooled, target, context = self._encode(batch)\n        semantic = self._membership(batch)[1]\n        query = context if mode == 'context' else target\n        raw, wc, wb, _, _, _, _ = self._fusion_read(\n            category, brand, common, mask, query, semantic, learned=(mode != 'uniform'))\n        return {'summary': self._match_norm(raw, pooled), 'raw': raw,\n                'pooled': pooled, 'wc': wc, 'wb': wb, 'mask': mask}\n\n    def forward(self, batch):\n        parent, features = self._fusion_base(batch)\n        readout = self._retrieval(batch, features)['summary']\n        residual = self.fusion_head(torch.cat([features, readout], -1)).squeeze(-1)\n        return parent + residual\n\n    def _fusion_witness(self, batch):\n        # Both histories have unique category and brand identities and share\n","exit_code":0,"status":"completed"}}
