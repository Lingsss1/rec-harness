{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport ast\nsource=Path('candidate.py').read_text()\ntree=ast.parse(source)\nconfig=next(n for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets))\nsettings=ast.literal_eval(config.value)\nsettings.pop('geometry_mode')\nsettings['group_prior']='empirical'\nfinal=next(n for n in tree.body if isinstance(n,ast.ClassDef) and n.name=='Model')\nlines=source.splitlines(keepends=True)\nprefix=''.join(lines[:final.lineno-1])\nprefix=prefix.replace(lines[config.lineno-1], 'CONFIG = '+repr(settings)+'\\\\n',1)\nprefix=prefix.replace('# Frozen full pooled source below; final Model appends the controlled fusion.','# Frozen pooled and raw-fusion ancestors; final Model changes only group mass.',1)\nnew=r'''class Model(_RawFusionModel):\n    \\\"\\\"\\\"Retain empirical match-group masses during learned within-group retrieval.\n\n    w_i = (n_g / N) * softmax_g(score_i). Every occupied group retains its\n    observed event fraction. With constant scores this is exactly 1/N for\n    every valid event, hence the readout equals the existing global mean.\n    Target/context modes differ only in the query; uniform disables scoring.\n    All parameter allocations and initialization are the raw-fusion ancestor's.\n    This is a controlled replacement, with no new input, loss or optimizer.\n    \\\"\\\"\\\"\n    def __init__(self, meta, config=None):\n        super().__init__(meta, config)\n        if self.config['group_prior'] \"'!= '\"'empirical':\n            raise ValueError('This module fixes empirical group masses')\n        if self.fusion_mode not in ('target', 'context', 'uniform'):\n            raise ValueError('Only target/context/uniform are registered')\n\n    @staticmethod\n    def _group_weights(scores, membership):\n        if scores.shape[-1] == 0:\n            return torch.zeros_like(scores)\n        valid = membership.bool()\n        expanded = scores[:, None, :].expand_as(membership)\n        within = expanded.masked_fill(\n            ~valid, torch.finfo(scores.dtype).min).softmax(-1)\n        within = within * valid.to(within.dtype)\n        within = within / within.sum(-1, keepdim=True).clamp_min(1e-9)\n        sizes = valid.to(within.dtype).sum(-1)\n        prior = sizes / sizes.sum(-1, keepdim=True).clamp_min(1)\n        return (within * prior.unsqueeze(-1)).sum(1)\n\n    def diagnostics(self, batch):\n        \\\"\\\"\\\"Label-free source checks, not independent predictive evidence.\n\n        The loop oracle uses separate one-group global softmaxes instead of\n        the vectorized grouped production path. Same-checkpoint replacements\n        describe sensitivity; independently trained controls establish utility.\n        \\\"\\\"\\\"\n        def maximum(value):\n            return value.abs().max() if value.numel() else value.new_zeros(())\n\n        def rms(value):\n            return value.square().mean().sqrt() if value.numel() else value.new_zeros(())\n\n        parent, features = self._fusion_base(batch)\n        reads = {mode: self._retrieval(batch, features, mode)\n                 for mode in ('target', 'context', 'uniform')}\n        selected = reads[self.fusion_mode]\n        summary, pooled = selected['summary'], selected['pooled']\n        _, category, brand, common, mask, _, target, context = self._encode(batch)\n        _, membership, sizes = self._membership(batch)\n        prior = sizes / sizes.sum(-1, keepdim=True).clamp_min(1)\n        occupied = sizes > 0\n        balanced_prior = occupied.float() / occupied.sum(-1, keepdim=True).clamp_min(1)\n        residual = self.fusion_head(torch.cat([features, summary], -1)).squeeze(-1)\n        pooled_residual = self.fusion_head(torch.cat([features, pooled], -1)).squeeze(-1)\n        oracle_weights, balanced_weights = [], []\n        query = context if self.fusion_mode == 'context' else target\n        for field, values in enumerate((category, brand)):\n            if mask.shape[1] == 0:\n                oracle_weights.append(mask.float())\n                balanced_weights.append(mask.float())\n                continue\n            scores = self._score(query[:, field], values + common)\n            scores = scores * float(self.fusion_mode \"'!= '\"'uniform')\n            oracle = torch.zeros_like(scores)\n            for group in range(4):\n                oracle = oracle + self._weights(\n                    scores, membership[:, group].bool()) * prior[:, group:group+1]\n            oracle_weights.append(oracle)\n            balanced_weights.append(_NormalizedFusionModel._group_weights(scores, membership))\n        oc, ob = oracle_weights\n        bc, bb = balanced_weights\n        oracle_raw = (oc.unsqueeze(-1) * category + ob.unsqueeze(-1) * brand\n                      + (0.5 * (oc + ob)).unsqueeze(-1) * common).sum(1)\n        balanced_raw = (bc.unsqueeze(-1) * category + bb.unsqueeze(-1) * brand\n                        + (0.5 * (bc + bb)).unsqueeze(-1) * common).sum(1)\n        mass = torch.stack([(membership * selected[key][:, None, :]).sum(-1)\n                            for key in ('wc', 'wb')])\n        active = mask.any(-1).float()\n        weights_error = torch.stack([\n            maximum(selected[key] - value)\n            for key, value in zip(('wc', 'wb'), oracle_weights)]).max()\n        dim = self.config['embedding_dim']\n        pools = features[:, self.static_width:self.static_width+4*dim].reshape(\n            features.shape[0], 4, dim)\n        pooled_oracle = (pools * sizes.unsqueeze(-1)).sum(1) / sizes.sum(-1, keepdim=True).clamp_min(1)\n        result = {\n            'allocated_parameters': float(sum(p.numel() for p in self.parameters())),\n            'appended_head_parameters': float(sum(p.numel() for p in self.fusion_head.parameters())),\n            'scorer_parameters': float(sum(p.numel() for p in self.attention.parameters())),\n            'scorer_active_by_design': float(self.fusion_mode \"'!= '\"'uniform'),\n            'empirical_group_prior_mode': 1.0,\n            'target_query_mode': float(self.fusion_mode == 'target'),\n            'context_query_mode': float(self.fusion_mode == 'context'),\n            'uniform_mode': float(self.fusion_mode == 'uniform'),\n            'parent_forward_reproduction_error_max': maximum(parent - _PooledObservedModel.forward(self, batch)),\n            'group_loop_weight_oracle_error_max': weights_error,\n            'readout_loop_oracle_error_max': maximum(summary - oracle_raw),\n            'empirical_group_mass_error_max': maximum(mass - prior.unsqueeze(0)),\n            'total_weight_mass_error_max': maximum(torch.stack([\n                selected[key].sum(-1) - active for key in ('wc', 'wb')])),\n            'masked_weight_error_max': maximum(torch.stack([\n                selected[key] * (~mask).float() for key in ('wc', 'wb')])),\n            'uniform_equals_global_pool_error_max': maximum(reads['uniform']['summary'] - pooled),\n            'pool_reconstruction_from_existing_features_error_max': maximum(pooled - pooled_oracle),\n            'raw_summary_selection_error_max': maximum(summary - selected['raw']),\n            'empirical_vs_balanced_prior_l1_mean': (prior - balanced_prior).abs().sum(-1).mean(),\n            'empirical_vs_balanced_summary_rms_delta': rms(summary - balanced_raw),\n            'target_context_summary_rms_delta': rms(reads['target']['summary'] - reads['context']['summary']),\n            'selected_vs_pool_summary_rms_delta': rms(summary - pooled),\n            'fusion_residual_rms': rms(residual),\n            'checkpoint_summary_vs_pool_logit_rms_delta': rms(residual - pooled_residual),\n            'forward_finite': float(torch.isfinite(parent + residual).all()),\n            'summary_finite': float(torch.isfinite(summary).all()),\n            'nonempty_fraction': active.mean(),\n            'occupied_groups_mean': occupied.float().sum(-1).mean(),\n            'singleton_summary_vs_pool_error_max': maximum(\n                (summary - pooled) * (mask.sum(-1) == 1).unsqueeze(-1)),\n        }\n        reverse, padded, empty, zero_length = (dict(batch) for _ in range(4))\n        for field in ('history_category', 'history_brand', 'history_type',\n                      'history_age_seconds', 'history_mask'):\n            reverse[field] = batch[field].flip(-1)\n            fill = batch[field].new_zeros((batch[field].shape[0], 2))\n            if field \"'!= '\"'history_mask':\n                fill.fill_(1)\n            padded[field] = torch.cat([batch[field], fill], -1)\n            zero_length[field] = batch[field][:, :0]\n        empty['history_mask'] = torch.zeros_like(mask)\n        for label, altered in (('reordering', reverse), ('padding', padded)):\n            ap, af = self._fusion_base(altered)\n            ar = self._retrieval(altered, af)\n            al = ap + self.fusion_head(torch.cat([af, ar['summary']], -1)).squeeze(-1)\n            result[label + '_shared_feature_error_max'] = maximum(features - af)\n            result[label + '_summary_error_max'] = maximum(summary - ar['summary'])\n            result[label + '_logit_error_max'] = maximum(parent + residual - al)\n        for label, altered in (('empty', empty), ('zero_length', zero_length)):\n            ap, af = self._fusion_base(altered)\n            ar = self._retrieval(altered, af)\n            al = ap + self.fusion_head(torch.cat([af, ar['summary']], -1)).squeeze(-1)\n            result[label + '_summary_abs_max'] = maximum(ar['summary'])\n            result[label + '_logits_finite'] = float(torch.isfinite(al).all())\n        applicable = self.category_vocab > 5 and self.brand_vocab > 5\n        result['witness_applicable'] = float(applicable)\n        if applicable:\n            witness = self._fusion_witness(batch)\n            wp, wf = self._fusion_base(witness)\n            wr = self._retrieval(witness, wf)\n            wu = self._retrieval(witness, wf, 'uniform')\n            added = self.fusion_head(torch.cat([wf, wr['summary']], -1)).squeeze(-1)\n            result['witness_parent_logit_error_max'] = maximum(wp[:1] - wp[1:])\n            result['witness_shared_feature_error_max'] = maximum(wf[:1] - wf[1:])\n            result['witness_pooled_error_max'] = maximum(wr['pooled'][:1] - wr['pooled'][1:])\n            result['witness_uniform_error_max'] = maximum(wu['summary'][:1] - wu['summary'][1:])\n            result['witness_selected_summary_gap_max'] = maximum(wr['summary'][:1] - wr['summary'][1:])\n            result['witness_added_logit_gap_max'] = maximum(added[:1] - added[1:])\n        return {name: float(value) for name, value in result.items()}\n'''\nfor mode,file in [('target','candidate.py'),('context','candidate_context.py'),('uniform','candidate_uniform.py')]:\n cfg=dict(settings,fusion_mode=mode)\n version=prefix.replace('CONFIG = '+repr(settings)+'\\\\n','CONFIG = '+repr(cfg)+'\\\\n',1)+new\n Path(file).write_text(version)\n print(file,len(version.splitlines()))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
