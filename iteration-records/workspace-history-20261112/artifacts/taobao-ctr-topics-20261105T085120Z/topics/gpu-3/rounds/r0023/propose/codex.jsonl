int(v['file'],'syntax, inherited class ASTs, literal config, allowed imports and no new allocations: PASS')\n assert len([n for n in ast.walk(new) if isinstance(n,ast.Constant) and isinstance(n.value,str) and n.value.endswith('_max')])<64\n# Apart from literal CONFIG, the two model modules must be exactly identical.\na,b=all_trees\nfor tree in (a,b):\n tree.body=[n for n in tree.body if not (isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets))]\nassert ast.dump(a)==ast.dump(b)\nprint('Target/context AST equality excluding CONFIG: PASS')\n# Validate required study schema recursively without requiring a package.\ndef check(value,schema,path):\n typ=schema.get('type')\n if typ=='object':\n  assert isinstance(value,dict),path\n  assert set(schema.get('required',[]))<=set(value),(path,'required')\n  if schema.get('additionalProperties') is False:assert set(value)<=set(schema.get('properties',{})),(path,'extra')\n  for k,v in value.items():\n   if k in schema.get('properties',{}):check(v,schema['properties'][k],path+'.'+k)\n elif typ=='array':\n  assert isinstance(value,list) and len(value)>=schema.get('minItems',0),path\n  for i,v in enumerate(value):check(v,schema.get('items',{}),path+'.'+str(i))\n elif typ=='string':assert isinstance(value,str) and len(value)>=schema.get('minLength',0),path\n if 'enum' in schema:assert value in schema['enum'],path\n if 'const' in schema:assert value==schema['const'],path\ncheck(p['study'],runtime['study_schema'],'study')\nassert p['study']['protocol_ref']==runtime['required_study_protocol_ref']\nallowed_ids=set(runtime['context']['allowed_observation_ids'])\nassert set(p['study']['evidence_refs'])<=allowed_ids\nassert p['parent_trial'] in allowed_ids\nassert len(p['variants'])==2 and len({v['file'] for v in p['variants']})==2\nassert any(v['role']=='candidate' for v in p['variants'])\nprint('Proposal schema, protocol and evidence IDs: PASS')\n# An independent scalar oracle compares full head s