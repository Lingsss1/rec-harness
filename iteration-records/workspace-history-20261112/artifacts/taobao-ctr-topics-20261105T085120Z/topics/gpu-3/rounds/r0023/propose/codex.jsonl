N retain group softmax. New intervention is tied logit subtraction, not a source-specific reproduction.'),\n ('paper:dmr','unresolved','Read pinned author README lines 1-9, respecting absence of item identities. Publisher full text unavailable; no detailed mechanism attribution.')]\nfor kid,decision,reason in items:\n proposal['knowledge_assessments'].append({'knowledge_id':kid,'decision':decision,'rationale':reason,'transformed_mechanism':'Inherited target-aware scorer with tied nonlinear readout subtraction; no newly adopted industry mechanism.' if kid=='paper:din' else 'No new architecture adopted from this source.','variant_names':['tied_target','tied_context'] if kid=='paper:din' else [],'nearest_work_difference':'Same centered history correction and capacity as g3-r0022-centered_target; subtract a tied pooled-reference head to eliminate its standalone output. General novelty unverified.','falsifier':'Target fails against active history-query replacement or strongest pooled_reference, null does not cancel, or later matched duplication/repetition reproduces the gain.'})\nPath('/workspace/proposal.json').write_text(json.dumps(proposal,indent=2)+'\\\\n')\nprint('Wrote prospective proposal.json with two variants, controls, source provenance, failed directions and reserve.')\nPY\"","aggregated_output":"/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\nWrote prospective proposal.json with two variants, controls, source provenance, failed directions and reserve.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport ast,json\nfrom pathlib import Path\nroot=Path('/workspace')\nsource=(root/'history_g3_r0022_centered_target.py').read_text()\nsource=source.replace('class Model(_RawFusionModel):','class _CenteredFusionModel(_RawFusionModel):',1)\naddition='''\n\nclass Model(_CenteredFusionModel):\n    \\\"\\\"\\\"Tied readout contrast, preserving the centered source's full allocation.\n\n    With X the inherited features, p the global history mean and d the\n    within-group attention correction, predict parent+h(X,p+d)-h(X,p).\n    Both calls share W, ReLU and V. The efficient implementation contracts\n    W's summary columns with d, avoiding a second wide feature matrix product.\n    Its equivalence is in real arithmetic; diagnostics measure float error.\n    A zero correction gives an exactly zero new branch, for all head weights.\n    The branch can still learn extra interactions conditional on X and d.\n\n    Context mode replaces the scorer query only. Target-dependent match groups\n    and static features are inherited, so this is not total target removal.\n    No labels, filesystem, external data, new parameters or detach operations.\n    \\\"\\\"\\\"\n    def __init__(self, meta, config=None):\n        super().__init__(meta, config)\n        if self.config['readout_head_mode'] \"'!= '\"'tied_contrast':\n            raise ValueError('This study fixes tied contrast')\n        if self.fusion_mode not in ('target', 'context'):\n            raise ValueError('Registered contrasts use active target/context scorers')\n        if self.fusion_head[0].bias is not None or self.fusion_head[2].bias is not None:\n            raise ValueError('Inherited tied head must remain bias-free')\n\n    def _contrast(self, features, pooled, delta):\n        # All terms participate in autograd. In particular, the reference arm\n        # is not detached: shared feature-only effects cancel in the difference.\n        baseline = self.fusion_head[0](torch.cat([features, pooled], dim=-1))\n        dim = self.config['embedding_dim']\n        shift = torch.nn.functional.linear(\n            delta, self.fusion_head[0].weight[:, -dim:])\n        change = self.fusion_head[1](baseline + shift) - self.fusion_head[1](baseline)\n        residual = self.fusion_head[2](change).squeeze(-1)\n        return residual, baseline, shift, change\n\n    def forward(self, batch):\n        parent, features = self._fusion_base(batch)\n        read = self._retrieval(batch, features)\n        residual = self._contrast(features, read['pooled'], read['delta'])[0]\n        return parent + residual\n\n    def diagnostics(self, batch):\n        \\\"\\\"\\\"Candidate-supplied label-free checks on host's first-512 probe.\n\n        Direct head subtraction, independent group-loop centering, zero-delta\n        cancellation and invariances check implementation only. Checkpoint\n        substitutions do not replace independently trained controls or repeats.\n        \\\"\\\"\\\"\n        def maximum(value):\n            return value.abs().max() if value.numel() else value.new_zeros(())\n\n        def rms(value):\n            return value.square().mean().sqrt() if value.numel() else value.new_zeros(())\n\n        parent, features = self._fusion_base(batch)\n        reads = {mode: self._centered_read(batch, mode)\n                 for mode in ('target', 'context', 'uniform')}\n        read = reads[self.fusion_mode]\n        pooled, delta = read['pooled'], read['delta']\n        residual, baseline, shift, change = self._contrast(features, pooled, delta)\n        logits = parent + residual\n        null_residual = self._contrast(features, pooled, torch.zeros_like(delta))[0]\n        # Independent arithmetic oracle: two full head calls, then subtraction.\n        additive = self.fusion_head(torch.cat([features, pooled + delta], -1)).squeeze(-1)\n        reference = self.fusion_head(torch.cat([features, pooled], -1)).squeeze(-1)\n        query_residuals = {mode: self._contrast(features, value['pooled'], value['delta'])[0]\n                           for mode, value in reads.items()}\n        membership = read['membership']\n        sizes = membership.sum(-1)\n        occupied = sizes > 0\n        prior = occupied.to(pooled.dtype) / occupied.sum(-1, keepdim=True).clamp_min(1)\n        mass = torch.stack([(membership * read[key][:, None, :]).sum(-1)\n                            for key in ('wc', 'wb')])\n        centered_mass = torch.stack([(membership * read[key][:, None, :]).sum(-1)\n                                     for key in ('dc', 'db')])\n        oracle = torch.zeros_like(delta)\n        for index, field in enumerate(('category', 'brand')):\n            values = read[field] + 0.5 * read['common']\n            if read['mask'].shape[1] == 0:\n                continue\n            scores = self._score(read['query'][:, index], read[field] + read['common'])\n            for group in range(4):\n                valid = membership[:, group].bool()\n                weights = scores.masked_fill(~valid, torch.finfo(scores.dtype).min).softmax(-1)\n                weights = weights * valid.to(weights.dtype)\n                weights = weights / weights.sum(-1, keepdim=True).clamp_min(1e-9)\n                mean = (values * valid.unsqueeze(-1)).sum(1) / sizes[:, group:group+1].clamp_min(1)\n                oracle = oracle + prior[:, group:group+1] * (\n                    weights.unsqueeze(-1) * (values - mean[:, None, :])).sum(1)\n        dim = self.config['embedding_dim']\n        pools = features[:, self.static_width:self.static_width + 4*dim].reshape(\n            features.shape[0], 4, dim)\n        pool_oracle = (pools * sizes.unsqueeze(-1)).sum(1) / sizes.sum(-1, keepdim=True).clamp_min(1)\n        result = {\n            'allocated_parameters': float(sum(p.numel() for p in self.parameters())),\n            'appended_head_parameters': float(sum(p.numel() for p in self.fusion_head.parameters())),\n            'scorer_parameters': float(sum(p.numel() for p in self.attention.parameters())),\n            'target_query_mode': float(self.fusion_mode == 'target'),\n            'context_query_mode': float(self.fusion_mode == 'context'),\n            'parent_forward_reproduction_error_max': maximum(parent - _PooledObservedModel.forward(self, batch)),\n            'explicit_tied_head_oracle_error_max': maximum(residual - (additive - reference)),\n            'forward_reproduction_error_max': maximum(logits - self.forward(batch)),\n            'zero_delta_residual_abs_max': maximum(null_residual),\n            'zero_delta_logits_parent_error_max': maximum(parent + null_residual - parent),\n            'uniform_query_residual_abs_max': maximum(query_residuals['uniform']),\n            'uniform_delta_abs_max': maximum(reads['uniform']['delta']),\n            'group_centered_value_oracle_error_max': maximum(delta - oracle),\n            'pool_from_existing_features_error_max': maximum(pooled - pool_oracle),\n            'balanced_group_mass_error_max': maximum(mass - prior.unsqueeze(0)),\n            'centered_group_mass_error_max': maximum(centered_mass),\n            'masked_delta_weight_error_max': maximum(torch.stack([\n                read[key] * (~read['mask']).to(pooled.dtype) for key in ('dc', 'db')])),\n            'correction_rms': rms(delta),\n            'preactivation_reference_rms': rms(baseline),\n            'preactivation_shift_rms': rms(shift),\n            'hidden_activation_difference_rms': rms(change),\n            'tied_residual_rms': rms(residual),\n            'subtracted_reference_head_rms': rms(reference),\n            'target_context_delta_rms': rms(reads['target']['delta'] - reads['context']['delta']),\n            'checkpoint_query_replacement_logit_rms': rms(query_residuals['target'] - query_residuals['context']),\n            'nonempty_fraction': read['mask'].any(-1).float().mean(),\n            'occupied_groups_mean': occupied.float().sum(-1).mean(),\n            'singleton_correction_abs_max': maximum(delta * (read['mask'].sum(-1) == 1).unsqueeze(-1)),\n            'forward_finite': float(torch.isfinite(logits).all()),\n        }\n        reverse, padded, empty, zero_length = (dict(batch) for _ in range(4))\n        for field in ('history_category', 'history_brand', 'history_type',\n                      'history_age_seconds', 'history_mask'):\n            reverse[field] = batch[field].flip(-1)\n            fill = batch[field].new_zeros((batch[field].shape[0], 2))\n            if field \"'!= '\"'history_mask':\n                fill.fill_(1)\n            padded[field] = torch.cat([batch[field], fill], -1)\n            zero_length[field] = batch[field][:, :0]\n        empty['history_mask'] = torch.zeros_like(batch['history_mask'])\n        for label, altered in (('reordering', reverse), ('padding', padded)):\n            ap, af = self._fusion_base(altered)\n            ar = self._retrieval(altered, af)\n            correction = self._contrast(af, ar['pooled'], ar['delta'])[0]\n            result[label + '_delta_error_max'] = maximum(delta - ar['delta'])\n            result[label + '_residual_error_max'] = maximum(residual - correction)\n            result[label + '_logit_error_max'] = maximum(logits - (ap + correction))\n        for label, altered in (('empty', empty), ('zero_length', zero_length)):\n            ap, af = self._fusion_base(altered)\n            ar = self._retrieval(altered, af)\n            correction = self._contrast(af, ar['pooled'], ar['delta'])[0]\n            result[label + '_delta_abs_max'] = maximum(ar['delta'])\n            result[label + '_residual_abs_max'] = maximum(correction)\n            result[label + '_logits_finite'] = float(torch.isfinite(ap + correction).all())\n        applicable = self.category_vocab > 5 and self.brand_vocab > 5\n        result['witness_applicable'] = float(applicable)\n        if applicable:\n            witness = self._fusion_witness(batch)\n            wp, wf = self._fusion_base(witness)\n            wr = self._retrieval(witness, wf)\n            wa = self._contrast(wf, wr['pooled'], wr['delta'])[0]\n            result['witness_shared_feature_gap_max'] = maximum(wf[:1] - wf[1:])\n            result['witness_parent_logit_gap_max'] = maximum(wp[:1] - wp[1:])\n            result['witness_correction_gap_max'] = maximum(wr['delta'][:1] - wr['delta'][1:])\n            result['witness_added_logit_gap_max'] = maximum(wa[:1] - wa[1:])\n        return {name: float(value) for name, value in result.items()}\n'''\np=json.loads((root/'proposal.json').read_text())\nfor variant in p['variants']:\n lines=source.splitlines()\n for i,l in enumerate(lines):\n  if l.startswith('CONFIG = '):\n   lines[i]='CONFIG = '+repr(variant['config'])\n   break\n text='\\\\n'.join(lines)+'\\\\n'+addition\n (root/variant['file']).write_text(text)\n print('Created',variant['file'],'lines',len(text.splitlines()))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
