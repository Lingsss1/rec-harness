{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport ast\nfor fn in ['candidate.py','history_g3_r0022_centered_target.py','history_g3_r0021_empirical_uniform.py']:\n s=open('/workspace/'+fn).read();t=ast.parse(s)\n print(fn,'LINES',len(s.splitlines()))\n for node in t.body:\n  if isinstance(node,ast.ClassDef) and node.lineno>2390: print(ast.get_source_segment(s,node).split('    def diagnostics',1)[0])\nPY\"","aggregated_output":"/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\ncandidate.py LINES 2399\nhistory_g3_r0022_centered_target.py LINES 2565\nclass Model(_RawFusionModel):\n    \"\"\"Global pooled input plus only within-group attention redistribution.\n\n    If u is the occupied-group-balanced uniform weight and w is the inherited\n    learned weight, use p + sum((w-u)*value), separately for category/brand.\n    Group masses, existing parent, scorer, fusion-head allocation and scratch\n    initialization are preserved. This is a signed correction, not a convex\n    pooled vector, a new source of events, or DIN's unnormalized activation.\n    Context mode removes the target embedding from the query only; match\n    partitions and the full predictor still depend on the target.\n    \"\"\"\n    def __init__(self, meta, config=None):\n        super().__init__(meta, config)\n        if self.config['centering_mode'] != 'balanced_delta':\n            raise ValueError('This study fixes balanced-delta centering')\n        if self.fusion_mode not in ('target', 'context', 'uniform'):\n            raise ValueError('Unknown centered readout mode')\n\n    def _centered_read(self, batch, mode):\n        _, category, brand, common, mask, pooled, target, context = self._encode(batch)\n        membership = self._membership(batch)[1]\n        query = context if mode == 'context' else target\n        raw, wc, wb, _, _, _, _ = self._fusion_read(\n            category, brand, common, mask, query, membership,\n            learned=(mode != 'uniform'))\n        if mask.shape[1] == 0:\n            uniform = mask.to(category.dtype)\n        else:\n            uniform = self._group_weights(torch.zeros_like(wc), membership)\n        dc, db = wc - uniform, wb - uniform\n        delta = (dc.unsqueeze(-1) * category + db.unsqueeze(-1) * brand\n                 + (0.5 * (dc + db)).unsqueeze(-1) * common).sum(1)\n        summary = pooled + delta\n        return {'summary': summary, 'delta': delta, 'raw': raw, 'pooled': pooled,\n                'wc': wc, 'wb': wb, 'uniform': uniform, 'dc': dc, 'db': db,\n                'mask': mask, 'membership': membership,\n                'category': category, 'brand': brand, 'common': common,\n                'query': query}\n\n    def _retrieval(self, batch, features=None, mode=None):\n        return self._centered_read(batch, self.fusion_mode if mode is None else mode)\n\n\nhistory_g3_r0021_empirical_uniform.py LINES 2413\n","exit_code":0,"status":"completed"}}
