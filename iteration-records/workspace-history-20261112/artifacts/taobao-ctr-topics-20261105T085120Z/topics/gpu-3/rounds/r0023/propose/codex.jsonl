p_min(1)\n1975:         return {'summary': self._match_norm(raw, pooled), 'raw': raw,\n1976:                 'pooled': pooled, 'wc': wc, 'wb': wb, 'mask': mask}\n1977: \n1978:     def _retrieval(self, batch, features=None, mode=None):\n1979:         mode = self.fusion_mode if mode is None else mode\n1980:         if mode == 'pooled_duplicate':\n1981:             if features is None:\n1982:                 features = self._shared_features(batch)[0]\n1983:             sizes = self._membership(batch)[2]\n1984:             return self._pooled_retrieval(features, sizes)\n1985:         _, category, brand, common, mask, pooled, target, context = self._encode(batch)\n1986:         semantic = self._membership(batch)[1]\n1987:         query = context if mode == 'context' else target\n1988:         raw, wc, wb, _, _, _, _ = self._fusion_read(\n1989:             category, brand, common, mask, query, semantic, learned=(mode != 'uniform'))\n1990:         return {'summary': self._match_norm(raw, pooled), 'raw': raw,\n1991:                 'pooled': pooled, 'wc': wc, 'wb': wb, 'mask': mask}\n1992: \n1993:     def forward(self, batch):\n1994:         parent, features = self._fusion_base(batch)\n1995:         readout = self._retrieval(batch, features)['summary']\n1996:         residual = self.fusion_head(torch.cat([features, readout], -1)).squeeze(-1)\n1997:         return parent + residual\n1998: \n1999:     def _fusion_witness(self, batch):\n2116: class _RawFusionModel(_NormalizedFusionModel):\n2117:     \"\"\"Keep readout magnitude; only the post-pooling norm constraint changes.\n2118: \n2119:     The frozen normalized implementation above is retained verbatim except for\n2120:     its class name and module CONFIG. All allocations, parameter names, random\n2121:     draws, group masses, query construction, keys/values and optimizer defaults\n2122:     are inherited. Forward still computes the normalized alternative, but the\n2123:     head receives raw instead. Backward cost can differ and must be measured.\n2124:     This does not remove group softmax or restore DIN's unnormalized weights.\n2125:     \"\"\"\n2126:     def __init__(self, meta, config=None):\n2127:         super().__init__(meta, config)\n2128:         if self.config['readout_scale_mode'] != 'raw':\n2129:             raise ValueError('This registered study fixes raw readout magnitude')\n2130: \n2131:     def _retrieval(self, batch, features=None, mode=None):\n2132:         read = super()._retrieval(batch, features, mode)\n2133:         # No detach, fitted scale, extra parameter, cache, label or input.\n2134:         # Dict replacement leaves the inherited raw calculation untouched.\n2135:         read['summary'] = read['raw']\n2136:         return read\n2137: \n2138:     def diagnostics(self, batch):\n2139:         \"\"\"Label-free checks on the host's fixed first-512 checkpoint probe.\n2140: \n2141:         Norm intervention at one checkpoint is descriptive, not a substitute\n2142:         for independently trained matched controls or population inference.\n2143:         \"\"\"\n2144:         def maximum(x):\n2145:             return x.abs().max() if x.numel() else x.new_zeros(())\n2146: \n2147:         parent, features = self._fusion_base(batch)\n2148:         reads = {mode: self._retrieval(batch, features, mode)\n2149:                  for mode in ('target', 'context', 'uniform', 'pooled_duplicate')}\n2150:         normalized = {mode: _NormalizedFusionModel._retrieval(self, batch, features, mode)\n2256: class Model(_RawFusionModel):\n2257:     \"\"\"Transmit raw retrieval radius on the inherited global pooled direction.\n2258: \n2259:     Target/context retrieval, all allocation and parent initialization remain\n2260:     inherited. Pooled-reference computes the same radial path with zero output\n2261:     influence: allocated capacity is matched, active scorer capacity is not.\n2262:     No raw direction is used as a fallback when pooled direction is undefined.\n2263:     \"\"\"\n2264:     def __init__(self, meta, config=None):\n2265:         super().__init__(meta, config)\n2266:         self.geometry_mode = self.config['geometry_mode']\n2267:         if self.geometry_mode not in ('radius', 'pooled'):\n2268:             raise ValueError('Unknown geometry_mode')\n2269:         if self.fusion_mode not in ('target', 'context'):\n2270:             raise ValueError('Only target/context queries are registered here')\n2271: \n2272:     @staticmethod\n2273:     def _radius_on_pool(raw, pooled):\n2274:         raw_norm = raw.norm(dim=-1, keepdim=True)\n2275:         pooled_norm = pooled.norm(dim=-1, keepdim=True)\n2276:         radial = pooled * (raw_norm / pooled_norm.clamp_min(1e-6))\n2277:         # All arithmetic is finite before selection, including empty histories.\n2278:         # A zero or nearly cancelling pooled vector has no reliable direction.\n2279:         radial = torch.where(pooled_norm > 1e-6, radial, torch.zeros_like(radial))\n2280:         return radial, raw_norm, pooled_norm\n2281: \n2282:     def _retrieval(self, batch, features=None, mode=None):\n2283:         read = super()._retrieval(batch, features, mode)\n2284:         radial, raw_norm, pooled_norm = self._radius_on_pool(read['raw'], read['pooled'])\n2285:         # Zero term retains the scorer path in the reference graph; its\n2286:         # gradient is zero. Wall/allocated-GPU/inference cost still needs host\n2287:         # measurement and is not guaranteed equal by this construction.\n2288:         reference = read['pooled'] + 0.0 * radial\n2289:         read['summary'] = radial if self.geometry_mode == 'radius' else reference\n2290:         read['radial'] = radial\n2291:         read['raw_norm'] = raw_norm\n2292:         read['pooled_norm'] = pooled_norm\n2293:         return read\n2294: \n2295:     def diagnostics(self, batch):\n2296:         \"\"\"Candidate-supplied label-free implementation checks, <=64 scalars.\n2297: \n2298:         Same-checkpoint geometry substitutions are descriptive only; predictive\n2299:         attribution requires independently trained cells and paired repeats.\n2300:         \"\"\"\n2301:         def maximum(value):\n2302:             return value.abs().max() if value.numel() else value.new_zeros(())\n2303: \n2304:         def rms(value):\n2305:             return value.square().mean().sqrt() if value.numel() else value.new_zeros(())\n2306: \n2307:         parent, features = self._fusion_base(batch)\n2308:         read = self._retrieval(batch, features)\n2309:         inherited = _RawFusionModel._retrieval(self, batch, features)\n2310:         summary = read['summary']\n","exit_code":0,"status":"completed"}}
