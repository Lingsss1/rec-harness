   'balanced_group_mass_error_max': maximum(mass - prior.unsqueeze(0)),\n2515:             'centered_group_mass_error_max': maximum(delta_mass),\n2516:             'masked_delta_weight_error_max': maximum(torch.stack([\n2517:                 read[key] * (~read['mask']).to(summary.dtype) for key in ('dc', 'db')])),\n2518:             'correction_rms': rms(read['delta']),\n2519:             'selected_summary_rms': rms(summary),\n2520:             'balanced_uniform_vs_pool_rms': rms(uniform_balanced - pooled),\n2521:             'target_context_delta_rms': rms(reads['target']['delta'] - reads['context']['delta']),\n2522:             'checkpoint_centering_vs_pool_logit_rms': rms(residual - null_residual),\n2523:             'fusion_residual_rms': rms(residual),\n2524:             'nonempty_fraction': read['mask'].any(-1).float().mean(),\n2525:             'occupied_groups_mean': occupied.float().sum(-1).mean(),\n2526:             'singleton_correction_abs_max': maximum(read['delta'] * (\n2527:                 read['mask'].sum(-1) == 1).unsqueeze(-1)),\n2528:             'summary_finite': float(torch.isfinite(summary).all()),\n2529:             'forward_finite': float(torch.isfinite(parent + residual).all()),\n2530:         }\n2531:         reverse, padded, empty, zero_length = (dict(batch) for _ in range(4))\n2532:         for field in ('history_category', 'history_brand', 'history_type',\n2533:                       'history_age_seconds', 'history_mask'):\n2534:             reverse[field] = batch[field].flip(-1)\n2535:             fill = batch[field].new_zeros((batch[field].shape[0], 2))\n2536:             if field != 'history_mask':\n2537:                 fill.fill_(1)\n2538:             padded[field] = torch.cat([batch[field], fill], -1)\n2539:             zero_length[field] = batch[field][:, :0]\n2540:         empty['history_mask'] = torch.zeros_like(batch['history_mask'])\n2541:         for label, altered in (('reordering', reverse), ('padding', padded)):\n2542:             ap, af = self._fusion_base(altered)\n2543:             ar = self._retrieval(altered, af)\n2544:             al = ap + self.fusion_head(torch.cat([af, ar['summary']], -1)).squeeze(-1)\n2545:             result[label + '_summary_error_max'] = maximum(summary - ar['summary'])\n2546:             result[label + '_correction_error_max'] = maximum(read['delta'] - ar['delta'])\n2547:             result[label + '_logit_error_max'] = maximum(parent + residual - al)\n2548:         for label, altered in (('empty', empty), ('zero_length', zero_length)):\n2549:             ap, af = self._fusion_base(altered)\n2550:             ar = self._retrieval(altered, af)\n2551:             al = ap + self.fusion_head(torch.cat([af, ar['summary']], -1)).squeeze(-1)\n2552:             result[label + '_summary_abs_max'] = maximum(ar['summary'])\n2553:             result[label + '_logits_finite'] = float(torch.isfinite(al).all())\n2554:         applicable = self.category_vocab > 5 and self.brand_vocab > 5\n2555:         result['witness_applicable'] = float(applicable)\n2556:         if applicable:\n2557:             witness = self._fusion_witness(batch)\n2558:             wp, wf = self._fusion_base(witness)\n2559:             wr = self._retrieval(witness, wf)\n2560:             wa = self.fusion_head(torch.cat([wf, wr['summary']], -1)).squeeze(-1)\n2561:             result['witness_shared_feature_gap_max'] = maximum(wf[:1] - wf[1:])\n2562:             result['witness_parent_logit_gap_max'] = maximum(wp[:1] - wp[1:])\n2563:             result['witness_correction_gap_max'] = maximum(wr['delta'][:1] - wr['delta'][1:])\n2564:             result['witness_added_logit_gap_max'] = maximum(wa[:1] - wa[1:])\n2565:         return {name: float(value) for name, value in result.items()}\n","exit_code":0,"status":"completed"}}
