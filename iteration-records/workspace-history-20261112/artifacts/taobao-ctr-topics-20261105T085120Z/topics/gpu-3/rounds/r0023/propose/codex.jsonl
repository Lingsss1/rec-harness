ree branch stays identically zero.\n110:         nn.init.zeros_(self.identity_head[-1].weight)\n111:         # Allocate only AFTER every incumbent parameter. Each registered cell\n112:         # computes identical empirical and product alternatives before readout.\n113:         self.context_mode = self.config['context_mode']\n114:         if self.context_mode not in ('joint', 'independent', 'marginal', 'zero'):\n115:             raise ValueError('Unknown context_mode')\n116:         if self.identity_mode != 'joint':\n117:             raise ValueError('This study retains the joint-identity incumbent')\n118:         if self.category_vocab * self.brand_vocab > (2**63 - 1) // 64:\n119:             raise ValueError('Packed identity-context key would overflow int64')\n120:         self.context_head = nn.Sequential(\n121:             nn.Linear(28, 16, bias=False), nn.ReLU(),\n122:             nn.Linear(16, 1, bias=False)\n123:         )\n124:         nn.init.zeros_(self.context_head[-1].weight)\n125: \n126:         # Append after EVERY parent parameter so old shapes, allocation order\n127:         # and scratch initialization remain identical. Modes allocate equally.\n128:         self.repeat_mode = self.config['repeat_mode']\n129:         if self.repeat_mode not in ('joint', 'independent', 'unlabeled', 'zero'):\n130:             raise ValueError('Unknown repeat_mode')\n1652: class _PooledObservedModel(_ResolutionParentModel):\n1653:     \"\"\"Global recurrence factorization: pool/product order x gap association.\n1654: \n1655:     Only the gap-head input changes. All inherited representations, allocations,\n1656:     initialization draws and optimization are untouched. Every cell computes\n1657:     every replacement so the study isolates information rather than speed.\n1658:     \"\"\"\n1659:     def __init__(self, meta, config=None):\n1660:         super().__init__(meta, config)\n1661:         if (self.gap_resolution, self.gap_channels) != ('global', 'all'):\n1662:             raise ValueError('Fix the global/all incumbent')\n1663:         self.product_scope = self.config.get('product_scope', 'pooled')\n1664:         self.gap_association = self.config.get('gap_association', 'observed')\n1665:         if self.product_scope not in ('context', 'pooled'):\n1666:             raise ValueError('Unknown product_scope')\n1667:         if self.gap_association not in ('observed', 'marginal'):\n1668:             raise ValueError('Unknown gap_association')\n1669: \n1670:     def _association_counts(self, tables):\n1671:         # raw[b,k,g,e], k=(N,C,B,actual-pair), g=fixed gap, e=directed state.\n1672:         # Original fourth channel is sum_e C_ge*B_ge/N_ge. Pooling first\n1673:         # instead yields (sum_e C_ge)*(sum_e B_ge)/(sum_e N_ge).\n1674:         # The latter is independent of action/target partition in THIS branch.\n1675:         raw = tables[0]\n1676:         common = raw[:, :3].sum(-1, keepdim=True)\n1677:         total, category, brand = common[:, 0:1], common[:, 1:2], common[:, 2:3]\n1678:         context_product = tables[2].sum(-1, keepdim=True)[:, None]\n1679:         pooled_product = category * brand / self._positive_denominator(total)\n1680:         observed = {\n1681:             'context': torch.cat([common, context_product], dim=1),\n1682:             'pooled': torch.cat([common, pooled_product], dim=1),\n1683:         }\n1684:         result = {}\n1685:         for scope, counts in observed.items():\n1686:             # Apply AFTER selecting product scope. Preserve every selected\n1687:             # channel total and every gap's N; remove their association only.\n1688:             # This is a deterministic fractional replacement, not a claim of\n1689:             # population independence and not a newly sampled event sequence.\n1690:             margin = counts[:, 1:].sum(2, keepdim=True)\n1691:             denominator = self._positive_denominator(total.sum(2, keepdim=True))\n1692:             marginal = torch.cat([total, total * margin / denominator], dim=1)\n1693:             result[scope + '_observed'] = counts\n1694:             result[scope + '_marginal'] = marginal\n1695:         return result\n1696: \n1697:     def _association_views(self, tables):\n1698:         # All modes execute these exact four lifts and the inherited tables.\n1699:         return {name: self._gap_lift(value)\n1700:                 for name, value in self._association_counts(tables).items()}\n1701: \n1702:     def _gap_features(self, tables, mode=None, pairing=None):\n1703:         if mode not in (None, 'observed') or pairing not in (None, 'product'):\n1704:             raise ValueError('This factorial fixes the inherited table modes')\n1705:         return self._association_views(tables)[\n1706:             self.product_scope + '_' + self.gap_association]\n1707: \n1708:     def _association_witness(self, batch, kind):\n1709:         # Realizable causal histories. Target 4 is outside history identities.\n1710:         # Context: N,C,B by gap agree, but product before pooling differs.\n1711:         # Association: same N by gap and all channel totals in both scopes,\n1712:         # with recurrence placed entirely in opposite, equally sized gap bins.\n1713:         if kind == 'context':\n1714:             c = [[1, 1, 2, 2, 3]] * 2\n1715:             b = [[1, 2, 2, 3, 3]] * 2\n1716:             action = [[1, 1, 1, 1, 1], [1, 1, 2, 2, 3]]\n1717:             age = [[15000, 14999, 14998, 14997, 14996]] * 2\n1718:         elif kind == 'association':\n1719:             c = b = [[1, 1, 1, 2, 3]] * 2\n1720:             action = [[1, 1, 1, 1, 1]] * 2\n1721:             age = [[15000, 14999, 14998, 14898, 14798],\n1722:                    [15000, 14900, 14800, 14799, 14798]]\n1723:         else:\n1724:             raise ValueError('Unknown witness')\n1725:         device = batch['static'].device\n1726:         witness = {\n1727:             'static': batch['static'][:1].expand(2, -1).clone(),\n1728:             'history_category': torch.tensor(c, dtype=torch.long, device=device),\n1729:             'history_brand': torch.tensor(b, dtype=torch.long, device=device),\n1730:             'history_type': torch.tensor(action, dtype=torch.long, device=device),\n1731:             'history_age_seconds': torch.tensor(\n1732:                 age, dtype=batch['history_age_seconds'].dtype, device=device),\n1733:             'history_mask': torch.ones((2, 5), dtype=torch.bool, device=device),\n1734:         }\n1735:         witness['static'][:, self.category] = 4\n1736:         witness['static'][:, self.brand] = 4\n1737:         return witness\n1738: \n1739:     def diagnostics(self, batch):\n1740:         \"\"\"At most64 label-free scalars; host executes at its fixed checkpoint.\n1829: class _NormalizedFusionModel(_PooledObservedModel):\n1830:     \"\"\"Complete pooled predictor plus a controlled history-readout residual.\n1831: \n1832:     Modes share all allocations and start with the exact parent's function.\n1833:     Context replaces only query construction. Uniform duplicates inherited\n1834:     evidence with an inactive scorer; pooled_duplicate is an active scorer\n1835:     control using only pre-existing group means, sizes and target embeddings.\n1836:     \"\"\"\n1837:     def __init__(self, meta, config=None):\n1838:         super().__init__(meta, config)\n1839:         self.fusion_mode = self.config['fusion_mode']\n1840:         if self.fusion_mode not in ('target', 'context', 'uniform', 'pooled_duplicate'):\n1841:             raise ValueError('Unknown fusion_mode')\n1842:         self.group_balanced = True\n1843:         self.static_width = len(meta['fields']) * self.config['embedding_dim']\n1844:         dim = self.config['embedding_dim']\n1845:         # Parent attention is allocated in every inherited model but dormant.\n1846:         # Reuse it with its original initialization: do not allocate a second\n1847:         # scorer or consume any random draw before the complete parent exists.\n1848:         # Existing first-layer shape fixes the exact inherited feature width.\n1849:         width = self.output[0].in_features + dim\n1850:         self.fusion_head = nn.Sequential(\n1851:             nn.Linear(width, self.config['fusion_hidden'], bias=False), nn.ReLU(),\n1852:             nn.Linear(self.config['fusion_hidden'], 1, bias=False)\n1853:         )\n1854:         nn.init.zeros_(self.fusion_head[-1].weight)\n1855: \n1856:     def _fusion_base(self, batch):\n1857:         # Exact _ParentModel._parent_forward arithmetic, exposing its shared\n1858:         # features without a cache or a repeated embedding pass. Then append\n1859:         # the exact chronological transition and pooled observed gap residuals.\n1860:         features, _, _, _, _, semantic, _ = self._shared_features(batch)\n1861:         tables = self._identity_tables(batch, semantic)\n1862:         context = self._context_tables(batch, tables)\n1863:         parent = self.output(features).squeeze(-1)\n1864:         identity = self.identity_head(self._identity_features(tables)).squeeze(-1)\n1865:         extra = self.context_head(self._context_features(context)).squeeze(-1)\n1866:         repeat_tables = self._conditional_tables(batch, tables, context)\n1867:         repeat = self.repeat_head(self._repeat_features(repeat_tables)).squeeze(-1)\n1868:         overlap_tables = self._overlap_tables(batch, tables, context)\n1869:         overlap = self.overlap_head(self._overlap_features(overlap_tables)).squeeze(-1)\n1870:         parent = parent + identity + extra + repeat + overlap\n1871:         transition = self._transition_tables(batch)\n1872:         parent = parent + self.transition_head(self._transition_features(transition)).squeeze(-1)\n1873:         gap = self._gap_features(self._gap_tables(batch))\n1874:         parent = parent + self.gap_head(gap).squeeze(-1)\n1875:         return parent, features\n1876: \n1877: \n1878:     def _encode(self, batch):\n1879:         fields = [e(batch['static'][:, i]) for i, e in enumerate(self.embeddings)]\n1880:         mask = batch['history_mask']\n1881:         ages = (torch.log2(batch['history_age_seconds'].clamp_min(0) + 1).long()\n1882:                 + 1).clamp(0, 32)\n1883:         category = self.embeddings[self.category](batch['history_category'])\n1884:         brand = self.embeddings[self.brand](batch['history_brand'])\n1885:         common = self.action(batch['history_type']) + self.recency(ages)\n1886:         uniform = mask.float() / mask.sum(-1, keepdim=True).clamp_min(1)\n1887:         context = torch.stack([\n1888:             (uniform.unsqueeze(-1) * category).sum(1),\n1889:             (uniform.unsqueeze(-1) * brand).sum(1),\n1890:         ], dim=1)\n1891:         target = torch.stack([fields[self.category], fields[self.brand]], dim=1)\n1892:         pooled = (uniform.unsqueeze(-1) * (category + brand + common)).sum(1)\n1893:         return fields, category, brand, common, mask, pooled, target, context\n1894: \n1895:     def _score(self, query, keys):\n1896:         query = query[:, None, :].expand_as(keys)\n1897:         relation = torch.cat([query, keys, query - keys, query * keys], dim=-1)\n1898:         return self.attention(relation).squeeze(-1)\n1899: \n1900:     @staticmethod\n1901:     def _weights(scores, mask):\n1902:         weights = scores.masked_fill(~mask, -1e4).softmax(-1) * mask.float()\n1903:         return weights / weights.sum(-1, keepdim=True).clamp_min(1e-9)\n1904: \n1905:     @staticmethod\n1906:     def _group_weights(scores, membership):\n1907:         \"\"\"Each occupied match group receives 1/K mass; empty groups receive 0.\n1908: \n1909:         A separate stable softmax is evaluated inside each group. This is a\n1910:         change to event-weight allocation, not the original group features.\n1911:         \"\"\"\n1912:         valid = membership.bool()\n1913:         expanded = scores[:, None, :].expand_as(membership)\n1914:         # A finite minimum keeps an all-masked group finite before zeroing it.\n1915:         weights = expanded.masked_fill(~valid, torch.finfo(scores.dtype).min).softmax(-1)\n1916:         weights = weights * valid.to(weights.dtype)\n1917:         weights = weights / weights.sum(-1, keepdim=True).clamp_min(1e-9)\n1918:         occupied = valid.any(-1).to(weights.dtype)\n1919:         prior = occupied / occupied.sum(-1, keepdim=True).clamp_min(1)\n1920:         return (weights * prior.unsqueeze(-1)).sum(1)\n1921: \n1922:     @staticmethod\n1923:     def _match_norm(raw, pooled):\n1924:         raw_norm = raw.norm(dim=-1, keepdim=True)\n1925:         reference_norm = pooled.norm(dim=-1, keepdim=True)\n1926:         matched = raw * (reference_norm / raw_norm.clamp_min(1e-6))\n1927:         # Degenerate vectors use the reference itself, including empty histories.\n1928:         # Both branches are finite before where; no divisions by zero occur.\n1929:         return torch.where(raw_norm > 1e-6, matched, pooled)\n1930: \n1931:     def _fusion_read(self, category, brand, common, mask, query, membership, learned=True):\n1932:         if mask.shape[1] == 0:\n1933:             zero = category.sum(1)\n1934:             weights = mask.float()\n1935:             return zero, weights, weights, weights, weights, weights, weights\n1936:         # Zero scaling is the uniform control. It preserves the scorer's\n1937:         # allocation and graph while giving its parameters exactly zero gradient.\n1938:         # Every cell computes global and grouped weights, including zero-scaled\n1939:         # backward paths. Measured host cost, not graph similarity, is decisive.\n1940:         scale = float(learned)\n1941:         category_score = self._score(query[:, 0], category + common) * scale\n1942:         brand_score = self._score(query[:, 1], brand + common) * scale\n1943:         global_c = self._weights(category_score, mask)\n1944:         global_b = self._weights(brand_score, mask)\n1945