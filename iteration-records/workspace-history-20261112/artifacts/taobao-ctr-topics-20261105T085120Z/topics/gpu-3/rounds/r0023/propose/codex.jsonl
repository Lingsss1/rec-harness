{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\ns=open('/workspace/history_g3_r0022_centered_target.py').read().splitlines()\nfor i,l in enumerate(s,1):\n if i>2399:print(f'{i}: {l}')\nPY\"","aggregated_output":"/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n2400: \n2401: \n2402: class Model(_RawFusionModel):\n2403:     \"\"\"Global pooled input plus only within-group attention redistribution.\n2404: \n2405:     If u is the occupied-group-balanced uniform weight and w is the inherited\n2406:     learned weight, use p + sum((w-u)*value), separately for category/brand.\n2407:     Group masses, existing parent, scorer, fusion-head allocation and scratch\n2408:     initialization are preserved. This is a signed correction, not a convex\n2409:     pooled vector, a new source of events, or DIN's unnormalized activation.\n2410:     Context mode removes the target embedding from the query only; match\n2411:     partitions and the full predictor still depend on the target.\n2412:     \"\"\"\n2413:     def __init__(self, meta, config=None):\n2414:         super().__init__(meta, config)\n2415:         if self.config['centering_mode'] != 'balanced_delta':\n2416:             raise ValueError('This study fixes balanced-delta centering')\n2417:         if self.fusion_mode not in ('target', 'context', 'uniform'):\n2418:             raise ValueError('Unknown centered readout mode')\n2419: \n2420:     def _centered_read(self, batch, mode):\n2421:         _, category, brand, common, mask, pooled, target, context = self._encode(batch)\n2422:         membership = self._membership(batch)[1]\n2423:         query = context if mode == 'context' else target\n2424:         raw, wc, wb, _, _, _, _ = self._fusion_read(\n2425:             category, brand, common, mask, query, membership,\n2426:             learned=(mode != 'uniform'))\n2427:         if mask.shape[1] == 0:\n2428:             uniform = mask.to(category.dtype)\n2429:         else:\n2430:             uniform = self._group_weights(torch.zeros_like(wc), membership)\n2431:         dc, db = wc - uniform, wb - uniform\n2432:         delta = (dc.unsqueeze(-1) * category + db.unsqueeze(-1) * brand\n2433:                  + (0.5 * (dc + db)).unsqueeze(-1) * common).sum(1)\n2434:         summary = pooled + delta\n2435:         return {'summary': summary, 'delta': delta, 'raw': raw, 'pooled': pooled,\n2436:                 'wc': wc, 'wb': wb, 'uniform': uniform, 'dc': dc, 'db': db,\n2437:                 'mask': mask, 'membership': membership,\n2438:                 'category': category, 'brand': brand, 'common': common,\n2439:                 'query': query}\n2440: \n2441:     def _retrieval(self, batch, features=None, mode=None):\n2442:         return self._centered_read(batch, self.fusion_mode if mode is None else mode)\n2443: \n2444:     def diagnostics(self, batch):\n2445:         \"\"\"Label-free source checks only; predictive evidence comes from host.\n2446: \n2447:         Loop oracle computes each group's softmax and centered values directly.\n2448:         Null, history-query and target diagnostics share one frozen checkpoint;\n2449:         substitutions here do not replace independently trained controls.\n2450:         \"\"\"\n2451:         def maximum(value):\n2452:             return value.abs().max() if value.numel() else value.new_zeros(())\n2453: \n2454:         def rms(value):\n2455:             return value.square().mean().sqrt() if value.numel() else value.new_zeros(())\n2456: \n2457:         parent, features = self._fusion_base(batch)\n2458:         reads = {mode: self._centered_read(batch, mode)\n2459:                  for mode in ('target', 'context', 'uniform')}\n2460:         read = reads[self.fusion_mode]\n2461:         summary, pooled = read['summary'], read['pooled']\n2462:         residual = self.fusion_head(torch.cat([features, summary], -1)).squeeze(-1)\n2463:         null_residual = self.fusion_head(torch.cat([features, pooled], -1)).squeeze(-1)\n2464:         membership = read['membership']\n2465:         sizes = membership.sum(-1)\n2466:         occupied = sizes > 0\n2467:         prior = occupied.to(summary.dtype) / occupied.sum(-1, keepdim=True).clamp_min(1)\n2468:         mass = torch.stack([(membership * read[key][:, None, :]).sum(-1)\n2469:                             for key in ('wc', 'wb')])\n2470:         delta_mass = torch.stack([(membership * read[key][:, None, :]).sum(-1)\n2471:                                   for key in ('dc', 'db')])\n2472:         # Independent group loop: center VALUES before aggregation, whereas\n2473:         # forward subtracts WEIGHTS then contracts. Finite minimum masks empty\n2474:         # groups, including the zero-length case, without injecting an event.\n2475:         oracle = torch.zeros_like(summary)\n2476:         for index, field in enumerate(('category', 'brand')):\n2477:             values = read[field] + 0.5 * read['common']\n2478:             if read['mask'].shape[1] == 0:\n2479:                 continue\n2480:             scores = self._score(read['query'][:, index], read[field] + read['common'])\n2481:             scores = scores * float(self.fusion_mode != 'uniform')\n2482:             for group in range(4):\n2483:                 valid = membership[:, group].bool()\n2484:                 weights = scores.masked_fill(~valid, torch.finfo(scores.dtype).min).softmax(-1)\n2485:                 weights = weights * valid.to(weights.dtype)\n2486:                 weights = weights / weights.sum(-1, keepdim=True).clamp_min(1e-9)\n2487:                 mean = (values * valid.unsqueeze(-1)).sum(1) / sizes[:, group:group+1].clamp_min(1)\n2488:                 oracle = oracle + prior[:, group:group+1] * (\n2489:                     weights.unsqueeze(-1) * (values - mean[:, None, :])).sum(1)\n2490:         dim = self.config['