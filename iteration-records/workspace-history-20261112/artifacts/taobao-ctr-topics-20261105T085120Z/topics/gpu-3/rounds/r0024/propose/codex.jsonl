{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport ast,json\nfrom pathlib import Path\nsource=Path('/workspace/candidate.py').read_text()\ntree=ast.parse(source)\nconfig_node=next(n for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets))\nconfig=ast.literal_eval(config_node.value)\nconfig['execution_mode']='skip_inactive'\nlines=source.splitlines(keepends=True)\nlines[config_node.lineno-1:config_node.end_lineno]=['CONFIG = '+repr(config)+'\\\\n']\npreserved=''.join(lines).replace('class Model(_RawFusionModel):','class _ExecutedPooledReference(_RawFusionModel):',1)\nsuffix='''\n\nclass Model(_ExecutedPooledReference):\n    \\\"\\\"\\\"Same pooled predictor; bypass the zero-influence attention computation.\n\n    No parameter, module name, RNG draw, optimizer or loss is changed. The\n    original source remains above for a same-checkpoint oracle. The direct\n    global mean below preserves _encode's exact arithmetic, including its\n    age clamp and common-field addition order; it does not reconstruct the\n    pool from grouped sufficient statistics, which would change reductions.\n\n    The original computes pooled + 0*radial, with a zero gradient through the\n    scorer and its embedding consumers. Here every scorer parameter retains\n    an explicit zero-valued graph dependency. Removing the wide zero-gradient\n    graph may still change GPU accumulation/optimizer execution and hence a\n    trained trajectory. Checkpoint equivalence is not seed-level replication.\n    \\\"\\\"\\\"\n    def __init__(self, meta, config=None):\n        super().__init__(meta, config)\n        if self.config['execution_mode'] \"'!= '\"'skip_inactive':\n            raise ValueError('This module fixes inactive-path elimination')\n        if self.geometry_mode \"'!= '\"'pooled' or self.fusion_mode \"'!= '\"'target':\n            raise ValueError('Only the frozen pooled-reference control is supported')\n\n    def _fast_pool(self, batch):\n        mask = batch['history_mask']\n        ages = (torch.log2(batch['history_age_seconds'].clamp_min(0) + 1).long()\n                + 1).clamp(0, 32)\n        category = self.embeddings[self.category](batch['history_category'])\n        brand = self.embeddings[self.brand](batch['history_brand'])\n        common = self.action(batch['history_type']) + self.recency(ages)\n        uniform = mask.float() / mask.sum(-1, keepdim=True).clamp_min(1)\n        pooled = (uniform.unsqueeze(-1) * (category + brand + common)).sum(1)\n        # Allocated attention and zero-gradient optimizer membership remain.\n        # This sums only 4226 parameters, not any B x L attention activations.\n        # There are no detach operations, hooks, state updates or label reads.\n        zero = pooled.new_zeros(())\n        for parameter in self.attention.parameters():\n            zero = zero + 0.0 * parameter.sum()\n        return pooled + zero, zero\n\n    def forward(self, batch):\n        parent, features = self._fusion_base(batch)\n        pooled, _ = self._fast_pool(batch)\n        residual = self.fusion_head(torch.cat([features, pooled], -1)).squeeze(-1)\n        return parent + residual\n\n    def diagnostics(self, batch):\n        \\\"\\\"\\\"Label-free source checks on the host's fixed checkpoint probe.\n\n        These are candidate-supplied checks. The original computation executes\n        only for diagnostics, and its cost must be charged. The host times the\n        ordinary forward separately. No label, filesystem or network access.\n        The forward comparisons do not test gradient or training equivalence.\n        \\\"\\\"\\\"\n        def maximum(value):\n            return value.abs().max() if value.numel() else value.new_zeros(())\n\n        def rms(value):\n            return value.square().mean().sqrt() if value.numel() else value.new_zeros(())\n\n        parent, features = self._fusion_base(batch)\n        pooled, zero = self._fast_pool(batch)\n        residual = self.fusion_head(torch.cat([features, pooled], -1)).squeeze(-1)\n        logits = parent + residual\n        # _retrieval is deliberately not overridden: it executes the original\n        # scorer, grouped softmax and zero-influence radial branch.\n        executed_read = self._retrieval(batch, features)\n        original_logits = _ExecutedPooledReference.forward(self, batch)\n        encoded_pool = self._encode(batch)[5]\n        dim = self.config['embedding_dim']\n        sizes = self._membership(batch)[2]\n        pools = features[:, self.static_width:self.static_width+4*dim].reshape(\n            features.shape[0], 4, dim)\n        group_pool = (pools * sizes.unsqueeze(-1)).sum(1) / sizes.sum(-1, keepdim=True).clamp_min(1)\n        result = {\n            'allocated_parameters': float(sum(p.numel() for p in self.parameters())),\n            'appended_head_parameters': float(sum(p.numel() for p in self.fusion_head.parameters())),\n            'scorer_parameters': float(sum(p.numel() for p in self.attention.parameters())),\n            'inactive_scorer_skipped_by_design': 1.0,\n            'explicit_zero_parameter_dependency_abs': zero.abs(),\n            'parent_forward_reproduction_error_max': maximum(\n                parent - _PooledObservedModel.forward(self, batch)),\n            'pooled_encode_oracle_error_max': maximum(pooled - encoded_pool),\n            'executed_summary_oracle_error_max': maximum(pooled - executed_read['summary']),\n            'original_forward_oracle_error_max': maximum(logits - original_logits),\n            'forward_reproduction_error_max': maximum(logits - self.forward(batch)),\n            'existing_group_pool_recombination_error_max': maximum(pooled - group_pool),\n            'pooled_rms': rms(pooled),\n            'fusion_residual_rms': rms(residual),\n            'nonempty_fraction': batch['history_mask'].any(-1).float().mean(),\n            'forward_finite': float(torch.isfinite(logits).all()),\n            'pooled_finite': float(torch.isfinite(pooled).all()),\n        }\n        reverse, padded, empty, zero_length = (dict(batch) for _ in range(4))\n        for field in ('history_category', 'history_brand', 'history_type',\n                      'history_age_seconds', 'history_mask'):\n            reverse[field] = batch[field].flip(-1)\n            fill = batch[field].new_zeros((batch[field].shape[0], 2))\n            if field \"'!= '\"'history_mask':\n                fill.fill_(1)\n            padded[field] = torch.cat([batch[field], fill], -1)\n            zero_length[field] = batch[field][:, :0]\n        empty['history_mask'] = torch.zeros_like(batch['history_mask'])\n        for label, altered in (('reordering', reverse), ('padding', padded)):\n            ap, af = self._fusion_base(altered)\n            pool, _ = self._fast_pool(altered)\n            altered_logits = ap + self.fusion_head(torch.cat([af, pool], -1)).squeeze(-1)\n            result[label + '_pool_error_max'] = maximum(pooled - pool)\n            result[label + '_logit_error_max'] = maximum(logits - altered_logits)\n            result[label + '_original_forward_error_max'] = maximum(\n                altered_logits - _ExecutedPooledReference.forward(self, altered))\n        for label, altered in (('empty', empty), ('zero_length', zero_length)):\n            ap, af = self._fusion_base(altered)\n            pool, _ = self._fast_pool(altered)\n            altered_logits = ap + self.fusion_head(torch.cat([af, pool], -1)).squeeze(-1)\n            result[label + '_pool_abs_max'] = maximum(pool)\n            result[label + '_logits_finite'] = float(torch.isfinite(altered_logits).all())\n            result[label + '_original_forward_error_max'] = maximum(\n                altered_logits - _ExecutedPooledReference.forward(self, altered))\n        applicable = self.category_vocab > 5 and self.brand_vocab > 5\n        result['witness_applicable'] = float(applicable)\n        if applicable:\n            witness = self._fusion_witness(batch)\n            wp, wf = self._fusion_base(witness)\n            pool, _ = self._fast_pool(witness)\n            added = self.fusion_head(torch.cat([wf, pool], -1)).squeeze(-1)\n            witness_logits = wp + added\n            result['witness_shared_feature_gap_max'] = maximum(wf[:1] - wf[1:])\n            result['witness_parent_logit_gap_max'] = maximum(wp[:1] - wp[1:])\n            result['witness_pooled_gap_max'] = maximum(pool[:1] - pool[1:])\n            result['witness_added_logit_gap_max'] = maximum(added[:1] - added[1:])\n            result['witness_original_forward_error_max'] = maximum(\n                witness_logits - _ExecutedPooledReference.forward(self, witness))\n        return {name: float(value) for name, value in result.items()}\n'''\nPath('/workspace/pooled_fast.py').write_text(preserved+suffix)\nprint('Created standalone pooled_fast.py; inherited source preserved.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
