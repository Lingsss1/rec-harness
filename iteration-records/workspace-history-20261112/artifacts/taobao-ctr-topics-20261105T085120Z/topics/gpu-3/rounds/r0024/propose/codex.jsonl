{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"grep -n '\"'^class'\"\\\\|\"'^CONFIG'\"\\\\|def _retrieval\\\\|def _fusion_base' history_g3_r0023_tied_target.py candidate.py\nsed -n '1,50p' candidate.py\n tail -n 255 history_g3_r0023_tied_target.py\"","aggregated_output":"/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n/bin/bash: line 1: grep: command not found\n# Frozen full pooled source below; final Model appends the controlled fusion.\n# Standalone resolution-factorial module. The original gap-parent source\n# below is preserved (class renamed); the final Model supplies the new readout.\n\"\"\"Elapsed-time localization of adjacent category/brand recurrence.\n\nThe exact chronological-product parent is retained as _ParentModel. A new\nzero-initialized residual reads gap-conditioned transition counts. The 2x2\nstudy replaces gap/recurrence association and category/brand joint equality\nseparately. All modes execute the same tables and allocate equal parameters.\nHistories are host-supplied causal prefixes; no items or extra events exist.\n\"\"\"\nimport math\nimport torch\nfrom torch import nn\n\nCONFIG = {'embedding_dim': 16, 'hidden': [128, 64], 'lr': 0.001, 'joint_mode': 'observed', 'statistic_mode': 'count', 'grouping_mode': 'match', 'histogram_grouping': 'match', 'histogram_pairing': 'observed', 'moment_grouping': 'match', 'moment_pairing': 'independent', 'field_mode': 'contrast', 'field_grouping': 'rank', 'field_scope': 'global', 'field_layout': 'compact', 'global_direction': 'norm_collapsed', 'identity_mode': 'joint', 'context_mode': 'joint', 'repeat_mode': 'joint', 'overlap_mode': 'observed', 'transition_order': 'chronological', 'transition_pairing': 'product', 'gap_mode': 'observed', 'gap_pairing': 'product', 'gap_resolution': 'global', 'gap_channels': 'all', 'product_scope': 'pooled', 'gap_association': 'observed', 'fusion_mode': 'target', 'fusion_hidden': 32, 'readout_scale_mode': 'raw', 'geometry_mode': 'pooled'}\n\n\nclass _ParentModel(nn.Module):\n    def __init__(self, meta, config=None):\n        super().__init__()\n        self.config = {**CONFIG, **(config or {})}\n        self.joint_mode = self.config['joint_mode']\n        self.statistic_mode = self.config['statistic_mode']\n        self.grouping_mode = self.config['grouping_mode']\n        if self.joint_mode not in ('observed', 'independent'):\n            raise ValueError('Unknown joint_mode')\n        if self.statistic_mode not in ('count', 'rate'):\n            raise ValueError('Unknown statistic_mode')\n        if self.grouping_mode not in ('match', 'rank', 'occupied_global'):\n            raise ValueError('Unknown grouping_mode')\n        # Parent means, histograms and independent moments stay fixed in\n        # true-match groups; only the appended field readout is intervened on.\n        if self.grouping_mode != 'match':\n            raise ValueError('This study fixes learned pooling to match')\n        self.histogram_grouping = self.config['histogram_grouping']\n        self.histogram_pairing = self.config['histogram_pairing']\n        if self.histogram_grouping not in ('match', 'rank'):\n            raise ValueError('Unknown histogram_grouping')\n        if self.histogram_pairing not in ('observed', 'independent'):\n            raise ValueError('Unknown histogram_pairing')\n        self.moment_grouping = self.config['moment_grouping']\n        self.moment_pairing = self.config['moment_pairing']\n        if self.moment_grouping not in ('match', 'rank'):\n            raise ValueError('Unknown moment_grouping')\n        if self.moment_pairing not in ('observed', 'independent'):\n            raise ValueError('Unknown moment_pairing')\n        if self.histogram_grouping != 'match' or self.histogram_pairing != 'observed':\n            raise ValueError('Incumbent histogram must remain observed/match')\n        self.field_mode = self.config['field_mode']\n        # groups, including the zero-length case, without injecting an event.\n        oracle = torch.zeros_like(summary)\n        for index, field in enumerate(('category', 'brand')):\n            values = read[field] + 0.5 * read['common']\n            if read['mask'].shape[1] == 0:\n                continue\n            scores = self._score(read['query'][:, index], read[field] + read['common'])\n            scores = scores * float(self.fusion_mode != 'uniform')\n            for group in range(4):\n                valid = membership[:, group].bool()\n                weights = scores.masked_fill(~valid, torch.finfo(scores.dtype).min).softmax(-1)\n                weights = weights * valid.to(weights.dtype)\n                weights = weights / weights.sum(-1, keepdim=True).clamp_min(1e-9)\n                mean = (values * valid.unsqueeze(-1)).sum(1) / sizes[:, group:group+1].clamp_min(1)\n                oracle = oracle + prior[:, group:group+1] * (\n                    weights.unsqueeze(-1) * (values - mean[:, None, :])).sum(1)\n        dim = self.config['embedding_dim']\n        pools = features[:, self.static_width:self.static_width + 4*dim].reshape(\n            features.shape[0], 4, dim)\n        pool_oracle = (pools * sizes.unsqueeze(-1)).sum(1) / sizes.sum(-1, keepdim=True).clamp_min(1)\n        uniform_balanced = (read['uniform'].unsqueeze(-1) * (\n            read['category'] + read['brand'] + read['common'])).sum(1)\n        result = {\n            'allocated_parameters': float(sum(p.numel() for p in self.parameters())),\n            'appended_head_parameters': float(sum(p.numel() for p in self.fusion_head.parameters())),\n            'scorer_parameters': float(sum(p.numel() for p in self.attention.parameters())),\n            'scorer_active_by_design': float(self.fusion_mode != 'uniform'),\n            'target_query_mode': float(self.fusion_mode == 'target'),\n            'context_query_mode': float(self.fusion_mode == 'context'),\n            'null_mode': float(self.fusion_mode == 'uniform'),\n            'parent_forward_reproduction_error_max': maximum(parent - _PooledObservedModel.forward(self, batch)),\n            'group_centered_value_oracle_error_max': maximum(read['delta'] - oracle),\n            'raw_minus_uniform_delta_error_max': maximum(read['delta'] - (read['raw'] - uniform_balanced)),\n            'summary_reconstruction_error_max': maximum(summary - pooled - read['delta']),\n            'null_summary_equals_pool_error_max': maximum(reads['uniform']['summary'] - pooled),\n            'null_delta_abs_max': maximum(reads['uniform']['delta']),\n            'null_predictor_reconstruction_error_max': maximum(\n                parent + self.fusion_head(torch.cat([features, reads['uniform']['summary']], -1)).squeeze(-1)\n                - (parent + null_residual)),\n            'pool_from_existing_features_error_max': maximum(pooled - pool_oracle),\n            'balanced_group_mass_error_max': maximum(mass - prior.unsqueeze(0)),\n            'centered_group_mass_error_max': maximum(delta_mass),\n            'masked_delta_weight_error_max': maximum(torch.stack([\n                read[key] * (~read['mask']).to(summary.dtype) for key in ('dc', 'db')])),\n            'correction_rms': rms(read['delta']),\n            'selected_summary_rms': rms(summary),\n            'balanced_uniform_vs_pool_rms': rms(uniform_balanced - pooled),\n            'target_context_delta_rms': rms(reads['target']['delta'] - reads['context']['delta']),\n            'checkpoint_centering_vs_pool_logit_rms': rms(residual - null_residual),\n            'fusion_residual_rms': rms(residual),\n            'nonempty_fraction': read['mask'].any(-1).float().mean(),\n            'occupied_groups_mean': occupied.float().sum(-1).mean(),\n            'singleton_correction_abs_max': maximum(read['delta'] * (\n                read['mask'].sum(-1) == 1).unsqueeze(-1)),\n            'summary_finite': float(torch.isfinite(summary).all()),\n            'forward_finite': float(torch.isfinite(parent + residual).all()),\n        }\n        reverse, padded, empty, zero_length = (dict(batch) for _ in range(4))\n        for field in ('history_category', 'history_brand', 'history_type',\n                      'history_age_seconds', 'history_mask'):\n            reverse[field] = batch[field].flip(-1)\n            fill = batch[field].new_zeros((batch[field].shape[0], 2))\n            if field != 'history_mask':\n                fill.fill_(1)\n            padded[field] = torch.cat([batch[field], fill], -1)\n            zero_length[field] = batch[field][:, :0]\n        empty['history_mask'] = torch.zeros_like(batch['history_mask'])\n        for label, altered in (('reordering', reverse), ('padding', padded)):\n            ap, af = self._fusion_base(altered)\n            ar = self._retrieval(altered, af)\n            al = ap + self.fusion_head(torch.cat([af, ar['summary']], -1)).squeeze(-1)\n            result[label + '_summary_error_max'] = maximum(summary - ar['summary'])\n            result[label + '_correction_error_max'] = maximum(read['delta'] - ar['delta'])\n            result[label + '_logit_error_max'] = maximum(parent + residual - al)\n        for label, altered in (('empty', empty), ('zero_length', zero_length)):\n            ap, af = self._fusion_base(altered)\n            ar = self._retrieval(altered, af)\n            al = ap + self.fusion_head(torch.cat([af, ar['summary']], -1)).squeeze(-1)\n            result[label + '_summary_abs_max'] = maximum(ar['summary'])\n            result[label + '_logits_finite'] = float(torch.isfinite(al).all())\n        applicable = self.category_vocab > 5 and self.brand_vocab > 5\n        result['witness_applicable'] = float(applicable)\n        if applicable:\n            witness = self._fusion_witness(batch)\n            wp, wf = self._fusion_base(witness)\n            wr = self._retrieval(witness, wf)\n            wa = self.fusion_head(torch.cat([wf, wr['summary']], -1)).squeeze(-1)\n            result['witness_shared_feature_gap_max'] = maximum(wf[:1] - wf[1:])\n            result['witness_parent_logit_gap_max'] = maximum(wp[:1] - wp[1:])\n            result['witness_correction_gap_max'] = maximum(wr['delta'][:1] - wr['delta'][1:])\n            result['witness_added_logit_gap_max'] = maximum(wa[:1] - wa[1:])\n        return {name: float(value) for name, value in result.items()}\n\n\nclass Model(_CenteredFusionModel):\n    \"\"\"Tied readout contrast, preserving the centered source's full allocation.\n\n    With X the inherited features, p the global history mean and d the\n    within-group attention correction, predict parent+h(X,p+d)-h(X,p).\n    Both calls share W, ReLU and V. The efficient implementation contracts\n    W's summary columns with d, avoiding a second wide feature matrix product.\n    Its equivalence is in real arithmetic; diagnostics measure float error.\n    A zero correction gives an exactly zero new branch, for all head weights.\n    The branch can still learn extra interactions conditional on X and d.\n\n    Context mode replaces the scorer query only. Target-dependent match groups\n    and static features are inherited, so this is not total target removal.\n    No labels, filesystem, external data, new parameters or detach operations.\n    \"\"\"\n    def __init__(self, meta, config=None):\n        super().__init__(meta, config)\n        if self.config['readout_head_mode'] != 'tied_contrast':\n            raise ValueError('This study fixes tied contrast')\n        if self.fusion_mode not in ('target', 'context'):\n            raise ValueError('Registered contrasts use active target/context scorers')\n        if self.fusion_head[0].bias is not None or self.fusion_head[2].bias is not None:\n            raise ValueError('Inherited tied head must remain bias-free')\n\n    def _contrast(self, features, pooled, delta):\n        # All terms participate in autograd. In particular, the reference arm\n        # is not detached: shared feature-only effects cancel in the difference.\n        baseline = self.fusion_head[0](torch.cat([features, pooled], dim=-1))\n        dim = self.config['embedding_dim']\n        shift = torch.nn.functional.linear(\n            delta, self.fusion_head[0].weight[:, -dim:])\n        change = self.fusion_head[1](baseline + shift) - self.fusion_head[1](baseline)\n        residual = self.fusion_head[2](change).squeeze(-1)\n        return residual, baseline, shift, change\n\n    def forward(self, batch):\n        parent, features = self._fusion_base(batch)\n        read = self._retrieval(batch, features)\n        residual = self._contrast(features, read['pooled'], read['delta'])[0]\n        return parent + residual\n\n    def diagnostics(self, batch):\n        \"\"\"Candidate-supplied label-free checks on host's first-512 probe.\n\n        Direct head subtraction, independent group-loop centering, zero-delta\n        cancellation and invariances check implementation only. Checkpoint\n        substitutions do not replace independently trained controls or repeats.\n        \"\"\"\n        def maximum(value):\n            return value.abs().max() if value.numel() else value.new_zeros(())\n\n        def rms(value):\n            return value.square().mean().sqrt() if value.numel() else value.new_zeros(())\n\n        parent, features = self._fusion_base(batch)\n        reads = {mode: self._centered_read(batch, mode)\n                 for mode in ('target', 'context', 'uniform')}\n        read = reads[self.fusion_mode]\n        pooled, delta = read['pooled'], read['delta']\n        residual, baseline, shift, change = self._contrast(features, pooled, delta)\n        logits = parent + residual\n        null_residual = self._contrast(features, pooled, torch.zeros_like(delta))[0]\n        # Independent arithmetic oracle: two full head calls, then subtraction.\n        additive = self.fusion_head(torch.cat([features, pooled + delta], -1)).squeeze(-1)\n        reference = self.fusion_head(torch.cat([features, pooled], -1)).squeeze(-1)\n        query_residuals = {mode: self._contrast(features, value['pooled'], value['delta'])[0]\n                           for mode, value in reads.items()}\n        membership = read['membership']\n        sizes = membership.sum(-1)\n        occupied = sizes > 0\n        prior = occupied.to(pooled.dtype) / occupied.sum(-1, keepdim=True).clamp_min(1)\n        mass = torch.stack([(membership * read[key][:, None, :]).sum(-1)\n                            for key in ('wc', 'wb')])\n        centered_mass = torch.stack([(membership * read[key][:, None, :]).sum(-1)\n                                     for key in ('dc', 'db')])\n        oracle = torch.zeros_like(delta)\n        for index, field in enumerate(('category', 'brand')):\n            values = read[field] + 0.5 * read['common']\n            if read['mask'].shape[1] == 0:\n                continue\n            scores = self._score(read['query'][:, index], read[field] + read['common'])\n            for group in range(4):\n                valid = membership[:, group].bool()\n                weights = scores.masked_fill(~valid, torch.finfo(scores.dtype).min).softmax(-1)\n                weights = weights * valid.to(weights.dtype)\n                weights = weights / weights.sum(-1, keepdim=True).clamp_min(1e-9)\n                mean = (values * valid.unsqueeze(-1)).sum(1) / sizes[:, group:group+1].clamp_min(1)\n                oracle = oracle + prior[:, group:group+1] * (\n                    weights.unsqueeze(-1) * (values - mean[:, None, :])).sum(1)\n        dim = self.config['embedding_dim']\n        pools = features[:, self.static_width:self.static_width + 4*dim].reshape(\n            features.shape[0], 4, dim)\n        pool_oracle = (pools * sizes.unsqueeze(-1)).sum(1) / sizes.sum(-1, keepdim=True).clamp_min(1)\n        result = {\n            'allocated_parameters': float(sum(p.numel() for p in self.parameters())),\n            'appended_head_parameters': float(sum(p.numel() for p in self.fusion_head.parameters())),\n            'scorer_parameters': float(sum(p.numel() for p in self.attention.parameters())),\n            'target_query_mode': float(self.fusion_mode == 'target'),\n            'context_query_mode': float(self.fusion_mode == 'context'),\n            'parent_forward_reproduction_error_max': maximum(parent - _PooledObservedModel.forward(self, batch)),\n            'explicit_tied_head_oracle_error_max': maximum(residual - (additive - reference)),\n            'forward_reproduction_error_max': maximum(logits - self.forward(batch)),\n            'zero_delta_residual_abs_max': maximum(null_residual),\n            'zero_delta_logits_parent_error_max': maximum(parent + null_residual - parent),\n            'uniform_query_residual_abs_max': maximum(query_residuals['uniform']),\n            'uniform_delta_abs_max': maximum(reads['uniform']['delta']),\n            'group_centered_value_oracle_error_max': maximum(delta - oracle),\n            'pool_from_existing_features_error_max': maximum(pooled - pool_oracle),\n            'balanced_group_mass_error_max': maximum(mass - prior.unsqueeze(0)),\n            'centered_group_mass_error_max': maximum(centered_mass),\n            'masked_delta_weight_error_max': maximum(torch.stack([\n                read[key] * (~read['mask']).to(pooled.dtype) for key in ('dc', 'db')])),\n            'correction_rms': rms(delta),\n            'preactivation_reference_rms': rms(baseline),\n            'preactivation_shift_rms': rms(shift),\n            'hidden_activation_difference_rms': rms(change),\n            'tied_residual_rms': rms(residual),\n            'subtracted_reference_head_rms': rms(reference),\n            'target_context_delta_rms': rms(reads['target']['delta'] - reads['context']['delta']),\n            'checkpoint_query_replacement_logit_rms': rms(query_residuals['target'] - query_residuals['context']),\n            'nonempty_fraction': read['mask'].any(-1).float().mean(),\n            'occupied_groups_mean': occupied.float().sum(-1).mean(),\n            'singleton_correction_abs_max': maximum(delta * (read['mask'].sum(-1) == 1).unsqueeze(-1)),\n            'forward_finite': float(torch.isfinite(logits).all()),\n        }\n        reverse, padded, empty, zero_length = (dict(batch) for _ in range(4))\n        for field in ('history_category', 'history_brand', 'history_type',\n                      'history_age_seconds', 'history_mask'):\n            reverse[field] = batch[field].flip(-1)\n            fill = batch[field].new_zeros((batch[field].shape[0], 2))\n            if field != 'history_mask':\n                fill.fill_(1)\n            padded[field] = torch.cat([batch[field], fill], -1)\n            zero_length[field] = batch[field][:, :0]\n        empty['history_mask'] = torch.zeros_like(batch['history_mask'])\n        for label, altered in (('reordering', reverse), ('padding', padded)):\n            ap, af = self._fusion_base(altered)\n            ar = self._retrieval(altered, af)\n            correction = self._contrast(af, ar['pooled'], ar['delta'])[0]\n            result[label + '_delta_error_max'] = maximum(delta - ar['delta'])\n            result[label + '_residual_error_max'] = maximum(residual - correction)\n            result[label + '_logit_error_max'] = maximum(logits - (ap + correction))\n        for label, altered in (('empty', empty), ('zero_length', zero_length)):\n            ap, af = self._fusion_base(altered)\n            ar = self._retrieval(altered, af)\n            correction = self._contrast(af, ar['pooled'], ar['delta'])[0]\n            result[label + '_delta_abs_max'] = maximum(ar['delta'])\n            result[label + '_residual_abs_max'] = maximum(correction)\n            result[label + '_logits_finite'] = float(torch.isfinite(ap + correction).all())\n        applicable = self.category_vocab > 5 and self.brand_vocab > 5\n        result['witness_applicable'] = float(applicable)\n        if applicable:\n            witness = self._fusion_witness(batch)\n            wp, wf = self._fusion_base(witness)\n            wr = self._retrieval(witness, wf)\n            wa = self._contrast(wf, wr['pooled'], wr['delta'])[0]\n            result['witness_shared_feature_gap_max'] = maximum(wf[:1] - wf[1:])\n            result['witness_parent_logit_gap_max'] = maximum(wp[:1] - wp[1:])\n            result['witness_correction_gap_max'] = maximum(wr['delta'][:1] - wr['delta'][1:])\n            result['witness_added_logit_gap_max'] = maximum(wa[:1] - wa[1:])\n        return {name: float(value) for name, value in result.items()}\n","exit_code":0,"status":"completed"}}
