le'] = float(applicable)\n        if applicable:\n            witness = self._fusion_witness(batch)\n            wp, wf = self._fusion_base(witness)\n            pool, _ = self._fast_pool(witness)\n            added = self.fusion_head(torch.cat([wf, pool], -1)).squeeze(-1)\n            witness_logits = wp + added\n            result['witness_shared_feature_gap_max'] = maximum(wf[:1] - wf[1:])\n            result['witness_parent_logit_gap_max'] = maximum(wp[:1] - wp[1:])\n            result['witness_pooled_gap_max'] = maximum(pool[:1] - pool[1:])\n            result['witness_added_logit_gap_max'] = maximum(added[:1] - added[1:])\n            result['witness_original_forward_error_max'] = maximum(\n                witness_logits - _ExecutedPooledReference.forward(self, witness))\n        return {name: float(value) for name, value in result.items()}\n'''\nPath('/workspace/pooled_fast.py').write_text(preserved+suffix)\nprint('Created standalone pooled_fast.py; inherited source preserved.')\nPY\"","aggregated_output":"/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\nCreated standalone pooled_fast.py; inherited source preserved.\n","exit_code":0,"status":"completed"}}
