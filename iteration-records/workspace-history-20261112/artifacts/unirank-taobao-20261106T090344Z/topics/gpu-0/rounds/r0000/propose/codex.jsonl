{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport ast, hashlib, importlib.util, json\nfrom pathlib import Path\np=json.loads(Path('proposal.json').read_text())\nr=json.loads(Path('runtime.json').read_text())\nschema=r['study_schema']\ndef validate(value, s, loc):\n    types={'object':dict,'array':list,'string':str,'boolean':bool}\n    if 'type' in s: assert isinstance(value,types[s['type']]),loc\n    if 'const' in s: assert value==s['const'],loc\n    if 'enum' in s: assert value in s['enum'],loc\n    if isinstance(value,dict):\n        assert set(s.get('required',[]))<=set(value),loc\n        props=s.get('properties',{})\n        if s.get('additionalProperties') is False: assert set(value)<=set(props),loc\n        for k,v in value.items():\n            if k in props:validate(v,props[k],loc+'.'+k)\n    if isinstance(value,list):\n        assert len(value)>=s.get('minItems',0),loc\n        for i,v in enumerate(value):validate(v,s.get('items',{}),loc+f'[{i}]')\n    if isinstance(value,str):assert len(value)>=s.get('minLength',0),loc\nvalidate(p['study'],schema,'study')\nassert p['study']['protocol_ref']==r['required_study_protocol_ref']\nassert p['parent_trial'] in r['context']['allowed_observation_ids']\nassert len(p['variants'])==4\nassert len({v['name'] for v in p['variants']})==4\nassert len({v['file'] for v in p['variants']})==4\nnormalized=[]\nfor v in p['variants']:\n    path=Path(v['file'])\n    assert path.name==str(path) and path.suffix=='.py'\n    source=path.read_text()\n    compile(source,str(path),'exec')\n    tree=ast.parse(source)\n    cfg=next(ast.literal_eval(n.value) for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets))\n    assert cfg==v['config']\n    digest=hashlib.sha256(source.encode()).hexdigest()\n    assert digest in v['note']\n    imports=[]\n    for node in ast.walk(tree):\n        if isinstance(node,ast