{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc 'python3 /workspace/tools.py read unirank-code:EST --start-line 1 --lines 220'","aggregated_output":"/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n{\n  \"id\": \"unirank-code:EST\",\n  \"url\": \"https://github.com/salmon1802/UniRank/blob/90bb99a60724e975ec565836266fd86dcad0039d/model_zoo/EST.py\",\n  \"version\": \"git:90bb99a60724e975ec565836266fd86dcad0039d\",\n  \"access_scope\": \"Full pinned benchmark source for inspection; not proof of equivalence to the original author method.\",\n  \"text_sha256\": \"94bb0d53a42c6da8f83012db39fc43fb65a1af2f51ee9dbfd1773185d5f9dd09\",\n  \"total_lines\": 331,\n  \"start_line\": 1,\n  \"next_line\": 161,\n  \"truncated\": false,\n  \"text\": \"1: # =========================================================================\\n2: # Copyright (C) 2026. UniRank Authors. All rights reserved.\\n3: # \\n4: # Licensed under the Apache License, Version 2.0 (the \\\"License\\\");\\n5: # you may not use this file except in compliance with the License.\\n6: # You may obtain a copy of the License at\\n7: #\\n8: #     http://www.apache.org/licenses/LICENSE-2.0\\n9: #\\n10: # Unless required by applicable law or agreed to in writing, software\\n11: # distributed under the License is distributed on an \\\"AS IS\\\" BASIS,\\n12: # WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\\n13: # See the License for the specific language governing permissions and\\n14: # limitations under the License.\\n15: # =========================================================================\\n16: \\n17: import torch\\n18: from torch import nn\\n19: from unirank.pytorch.models import MultiTaskModel\\n20: from unirank.pytorch.layers import (\\n21:     FeatureEmbedding,\\n22:     MLP_Block,\\n23:     MaskedAveragePooling,\\n24:     MultiHeadTokenMixing,\\n25:     PerTokenSwiGLU,\\n26:     ScaledDotProductAttention,\\n27:     SwiGLU,\\n28: )\\n29: from unirank.pytorch.torch_utils import get_activation\\n30: from unirank.utils import not_in_whitelist\\n31: from unirank.pytorch.layers.tokenization import FieldWiseTokenizer\\n32: \\n33: \\n34: class EST(MultiTaskModel):\\n35:     def __init__(self,\\n36:                  feature_map,\\n37:                  model_id=\\\"EST\\\",\\n38:                  task=[\\\"binary_classification\\\"],\\n39:                  gpu=-1,\\n40:                  tower_activations=\\\"ReLU\\\",\\n41:                  dnn_activations=\\\"ReLU\\\",\\n42:                  tower_hidden_units=[128, 64],\\n43:                  embedding_dim=10,\\n44:                  num_layers=3,\\n45:                  num_heads=2,\\n46:                  expansion_factor=4,\\n47:                  num_tasks=4,\\n48:                  token_dim=64,\\n49:                  net_dropout=0,\\n50:                  accumulation_steps=1,\\n51:                  **kwargs):\\n52:         super(EST, self).__init__(feature_map,\\n53:                                        model_id=model_id,\\n54:                                        gpu=gpu,\\n55:                                        **kwargs)\\n56:         self.num_tasks = num_tasks\\n57:         self.feature_map = feature_map\\n58:         self.embedding_dim = embedding_dim\\n59:         self.token_dim = token_dim\\n60:         self.accumulation_steps = accumulation_steps\\n61:         self.masked_avg_pooling = MaskedAveragePooling()\\n62:         self.num_field = feature_map.get_num_fields()\\n63:         # Track item and non-item feature dimensions\\n64:         self.item_info_dim = 0\\n65:         self.non_item_dim = 0\\n66:         for feat, spec in self.feature_map.features.items():\\n67:             if feat in self.feature_map.labels:\\n68:                 continue\\n69:             if spec.get(\\\"type\\\") == \\\"meta\\\":\\n70:                 continue\\n71:             emb_dim = spec.get(\\\"embedding_dim\\\", embedding_dim)\\n72:             if spec.get(\\\"source\\\") in [\\\"item\\\", \\\"action\\\"]:\\n73:                 self.item_info_dim += emb_dim\\n74:             else:\\n75:                 self.non_item_dim += emb_dim\\n76: \\n77:         self.embedding_layer = FeatureEmbedding(feature_map, embedding_dim)\\n78:         self.num_ns_token = self.num_field\\n79:         self.unified_tokenizer_layer = FieldWiseTokenizer(\\n80:             input_dim=embedding_dim,\\n81:             token_dim=token_dim,\\n82:             num_tokens=self.num_field\\n83:         )\\n84: \\n85:         # Project sequence and target items to token_dim\\n86:         if self.item_info_dim != token_dim:\\n87:             self.item_token_proj = nn.Linear(self.item_info_dim, token_dim)\\n88:         else:\\n89:             self.item_token_proj = nn.Identity()\\n90: \\n91:         self.unified_interaction_layers = ESTBlocks(\\n92:             input_dim=token_dim,\\n93:             num_heads=num_heads,\\n94:             num_ns_token=self.num_ns_token,\\n95:             num_layers=num_layers,\\n96:             dnn_activations=dnn_activations,\\n97:             expansion_factor=expansion_factor\\n98:         )\\n99: \\n100:         self.tower = nn.ModuleList([MLP_Block(input_dim=token_dim * self.num_field + token_dim,\\n101:                                               output_dim=1,\\n102:                                               hidden_units=tower_hidden_units,\\n103:                                               hidden_activations=tower_activations,\\n104:                                               output_activation=None,\\n105:                                               dropout_rates=net_dropout)\\n106:                                     for _ in range(num_tasks)])\\n107:         if isinstance(task, list):\\n108:             assert len(task) == num_tasks, \\\"the number of tasks must equal the length of \\\\\\\"task\\\\\\\"\\\"\\n109:             self.output_activation = nn.ModuleList([self.get_output_activation(str(t)) for t in task])\\n110:         else:\\n111:             self.output_activation = nn.ModuleList(\\n112:                 [self.get_output_activation(task) for _ in range(num_tasks)]\\n113:             )\\n114: \\n115:         self.compile(kwargs.get(\\\"dense_optimizer\\\"), kwargs[\\\"loss\\\"], kwargs.get(\\\"dense_learning_rate\\\"))\\n116:         self.reset_parameters()\\n117:         self.model_to_device()\\n118: \\n119:     def forward(self, inputs):\\n120:         batch_dict, item_dict, mask = self.get_inputs(inputs)\\n121:         batch_size = mask.shape[0]\\n122:         # item_dict contains [history_items..., target_item]\\n123:         # Reshape flattened embeddings to B x (T+1) x item_info_dim\\n124:         item_seq_emb = self.embedding_layer(item_dict, flatten_emb=True)\\n125:         item_seq_emb = item_seq_emb.view(batch_size, -1, self.item_info_dim)\\n126: \\n127:         target_emb = item_seq_emb[:, -1, :].view(batch_size, -1, self.embedding_dim)\\n128:         sequence_emb = item_seq_emb[:, 0:-1, :]  # B x T x item_info_dim\\n129: \\n130:         # S-tokens\\n131:         s_tokens = self.item_token_proj(sequence_emb)  # B x T x token_dim\\n132: \\n133:         # Other non-sequential features -> NS tokens\\n134:         user_context_emb = self.embedding_layer(batch_dict, flatten_emb=False)  # B x\\n135:         feature_embeddings = torch.cat([user_context_emb, target_emb], dim=1) # B x F x embeddding_dim\\n136:         unified_tokens = self.unified_tokenizer_layer(feature_embeddings)  # B x num_ns_token (F) x token_dim\\n137: \\n138:         # unified model\\n139:         s_tokens, unified_tokens = self.activation_checkpoint(\\n140:             self.unified_interaction_layers,\\n141:             s_tokens,\\n142:             unified_tokens,\\n143:             mask\\n144:         )\\n145: \\n146:         bottom_output = torch.cat([\\n147:             unified_tokens.flatten(start_dim=1),\\n148:             self.masked_avg_pooling(s_tokens, mask),\\n149:         ], dim=-1)\\n150:         tower_output = [self.tower[i](bottom_output) for i in range(self.num_tasks)]\\n151:         y_pred = [self.output_activation[i](tower_output[i]) for i in range(self.num_tasks)]\\n152:         return_dict = {}\\n153:         labels = self.feature_map.labels\\n154:         for i in range(self.num_tasks):\\n155:             return_dict[\\\"{}_pred\\\".format(labels[i])] = y_pred[i]\\n156:         return return_dict\\n157: \\n158: class ESTBlocks(nn.Module):\\n159:     \\\"\\\"\\\"\\n160:     Each layer applies:\"\n}\n","exit_code":0,"status":"completed"}}
