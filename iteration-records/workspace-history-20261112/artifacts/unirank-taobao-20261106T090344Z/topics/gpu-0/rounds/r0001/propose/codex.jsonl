{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport ast,json,hashlib\nfrom pathlib import Path\np=json.loads(Path('proposal.json').read_text())\nr=json.loads(Path('runtime_view.json').read_text())\nschema=r['study_schema']\ndef check(x,s,path):\n t=s.get('type')\n expected={'object':dict,'array':list,'string':str,'boolean':bool}\n if t in expected: assert isinstance(x,expected[t]), (path,t,type(x))\n if 'const' in s: assert x==s['const'],path\n if 'enum' in s: assert x in s['enum'],path\n if isinstance(x,dict):\n  assert all(k in x for k in s.get('required',[])),path\n  if s.get('additionalProperties') is False: assert set(x)<=set(s.get('properties',{})),path\n  for k,v in x.items():\n   if k in s.get('properties',{}): check(v,s['properties'][k],path+'.'+k)\n if isinstance(x,list):\n  assert len(x)>=s.get('minItems',0),path\n  for i,v in enumerate(x): check(v,s.get('items',{}),path+'['+str(i)+']')\n if isinstance(x,str): assert len(x)>=s.get('minLength',0),path\ncheck(p['study'],schema,'study')\nassert p['parent_trial'] in r['context']['allowed_observation_ids']\nassert set(p['study']['evidence_refs'])<=set(r['context']['allowed_observation_ids'])\nassert p['study']['protocol_ref']==r['required_study_protocol_ref']\nassert 1<=len(p['variants'])<=4 and any(v['role']=='candidate' for v in p['variants'])\nassert len({v['name'] for v in p['variants']})==len(p['variants'])\nparent=ast.parse(Path('history_g0_r0000_field_global.py').read_text())\nparent_model=next(n for n in parent.body if isinstance(n,ast.ClassDef) and n.name=='Model')\nparent_init=next(n for n in parent_model.body if isinstance(n,ast.FunctionDef) and n.name=='__init__')\nparent_forward=next(n for n in parent_model.body if isinstance(n,ast.FunctionDef) and n.name=='forward')\nparent_weights=next(n for n in parent_model.body if isinstance(n,ast.FunctionDef) and n.name=='_masked_weights')\n# Registered tensors and initialization must be declared in precisely the same\n# order. Compare the constructor suffix beginning at the first inherited field.\nstart=next(i for i,n in enumerate(parent_init.body) if isinstance(n,ast.Assign) and ast.unparse(n.targets[0])=='self.field_retrieval')\ninit_suffix=[ast.dump(n) for n in parent_init.body[start:]]\nnormalized=[]\nfor v in p['variants']:\n path=Path(v['file']); assert path.name==str(path) and path.suffix=='.py'\n src=path.read_text(); compile(src,str(path),'exec'); tree=ast.parse(src)\n config_node=next(n for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets))\n assert ast.literal_eval(config_node.value)==v['config']\n model=next(n for n in tree.body if isinstance(n,ast.ClassDef) and n.name=='Model')\n init=next(n for n in model.body if isinstance(n,ast.FunctionDef) and n.name=='__init__')\n start=next(i for i,n in enumerate(init.body) if isinstance(n,ast.Assign) and ast.unparse(n.targets[0])=='self.field_retrieval')\n assert [ast.dump(n) for n in init.body[start:]]==init_suffix,v['name']\n forward=next(n for n in model.body if isinstance(n,ast.FunctionDef) and n.name=='forward')\n assert ast.dump(forward)==ast.dump(parent_forward),v['name']\n weights=next(n for n in model.body if isinstance(n,ast.FunctionDef) and n.name=='_masked_weights')\n softmax=next(n for n in weights.body if isinstance(n,ast.If))\n assert [ast.dump(n) for n in softmax.body]==[ast.dump(n) for n in parent_weights.body[1:]],v['name']\n for n in ast.walk(tree):\n  if isinstance(n,(ast.Import,ast.ImportFrom)):\n   names=[a.name for a in n.names] if isinstance(n,ast.Import) else [n.module]\n   assert all(name.split('.')[0] in {'math','torch','unirank'} for name in names)\n  if isinstance(n,ast.Call) and isinstance(n.func,ast.Name): assert n.func.id not in {'open','exec','eval','__import__'}\n for arg,i in [(arg,i) for i,arg in enumerate(init.args.args) if arg.arg=='pooling_mode']:\n  offset=len(init.args.args)-len(init.args.de