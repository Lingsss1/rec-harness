{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc 'python3 /workspace/tools.py read unirank-code:HiFormer --start-line 1 --lines 220\npython3 /workspace/tools.py read paper:hiformer --lines 70\npython3 /workspace/tools.py read paper:tokenmixer --lines 70'","aggregated_output":"/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n{\n  \"id\": \"unirank-code:HiFormer\",\n  \"url\": \"https://github.com/salmon1802/UniRank/blob/90bb99a60724e975ec565836266fd86dcad0039d/model_zoo/HiFormer.py\",\n  \"version\": \"git:90bb99a60724e975ec565836266fd86dcad0039d\",\n  \"access_scope\": \"Full pinned benchmark source for inspection; not proof of equivalence to the original author method.\",\n  \"text_sha256\": \"ff8b2e9cf9112ff50a807e1b85b8236ecaa699f842b93b6209630cace8b454a3\",\n  \"total_lines\": 239,\n  \"start_line\": 1,\n  \"next_line\": 161,\n  \"truncated\": false,\n  \"text\": \"1: # =========================================================================\\n2: # Copyright (C) 2026. UniRank Authors. All rights reserved.\\n3: # \\n4: # Licensed under the Apache License, Version 2.0 (the \\\"License\\\");\\n5: # you may not use this file except in compliance with the License.\\n6: # You may obtain a copy of the License at\\n7: #\\n8: #     http://www.apache.org/licenses/LICENSE-2.0\\n9: #\\n10: # Unless required by applicable law or agreed to in writing, software\\n11: # distributed under the License is distributed on an \\\"AS IS\\\" BASIS,\\n12: # WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\\n13: # See the License for the specific language governing permissions and\\n14: # limitations under the License.\\n15: # =========================================================================\\n16: \\n17: import torch\\n18: from torch import nn\\n19: from unirank.pytorch.models import MultiTaskModel\\n20: from unirank.pytorch.layers import FeatureEmbedding, MLP_Block, MaskedAveragePooling, PerTokenFeedForward, MultiHeadTargetAttention, ScaledDotProductAttention\\n21: from unirank.pytorch.torch_utils import get_activation\\n22: from unirank.utils import not_in_whitelist\\n23: from unirank.pytorch.layers.tokenization import FieldWiseTokenizer\\n24: \\n25: \\n26: class HiFormer(MultiTaskModel):\\n27:     def __init__(self,\\n28:                  feature_map,\\n29:                  model_id=\\\"HiFormer\\\",\\n30:                  task=[\\\"binary_classification\\\"],\\n31:                  gpu=-1,\\n32:                  tower_activations=\\\"ReLU\\\",\\n33:                  tower_hidden_units=[128, 64],\\n34:                  embedding_dim=10,\\n35:                  num_layers=3,\\n36:                  attention_dropout=0,\\n37:                  expansion_factor=4,\\n38:                  num_tasks=4,\\n39:                  token_dim=64,\\n40:                  attention_dim=None,\\n41:                  num_heads=2,\\n42:                  qkv_rank=256,\\n43:                  net_dropout=0,\\n44:                  accumulation_steps=1,\\n45:                  attention_activation_type=\\\"SoftMax\\\",\\n46:                  **kwargs):\\n47:         super(HiFormer, self).__init__(feature_map,\\n48:                                        model_id=model_id,\\n49:                                        gpu=gpu,\\n50:                                        **kwargs)\\n51:         self.num_tasks = num_tasks\\n52:         self.feature_map = feature_map\\n53:         self.embedding_dim = embedding_dim\\n54:         self.token_dim = token_dim\\n55:         self.accumulation_steps = accumulation_steps\\n56:         self.num_field = feature_map.get_num_fields()\\n57:         # Track item and non-item feature dimensions\\n58:         self.item_info_dim = 0\\n59:         self.non_item_dim = 0\\n60:         for feat, spec in self.feature_map.features.items():\\n61:             if feat in self.feature_map.labels:\\n62:                 continue\\n63:             if spec.get(\\\"type\\\") == \\\"meta\\\":\\n64:                 continue\\n65:             emb_dim = spec.get(\\\"embedding_dim\\\", embedding_dim)\\n66:             if spec.get(\\\"source\\\") in [\\\"item\\\", \\\"action\\\"]:\\n67:                 self.item_info_dim += emb_dim\\n68:                 self.num_field += 1\\n69:             else:\\n70:                 self.non_item_dim += emb_dim\\n71: \\n72:         self.embedding_layer = FeatureEmbedding(feature_map, embedding_dim)\\n73:         self.unified_tokenizer_layer = HiFormerTokenizer(\\n74:             input_dim=embedding_dim,\\n75:             token_dim=token_dim,\\n76:             num_tokens=self.num_field,\\n77:             num_tasks=num_tasks\\n78:         )\\n79: \\n80:         self.attention_layers = MultiHeadTargetAttention(\\n81:             input_dim=self.item_info_dim,\\n82:             attention_dim=token_dim if attention_dim is None else attention_dim,\\n83:             dropout_rate=attention_dropout,\\n84:             attention_activation_type=attention_activation_type,\\n85:         )\\n86: \\n87:         self.unified_interaction_layers = HiFormerBlocks(token_dim=token_dim,\\n88:                                        num_token=num_tasks + self.num_field,\\n89:                                        num_layers=num_layers,\\n90:                                        expand=expansion_factor,\\n91:                                        num_heads=num_heads,\\n92:                                        qkv_rank=qkv_rank,\\n93:                                        net_dropout=net_dropout)\\n94:         self.tower = nn.ModuleList([MLP_Block(input_dim=token_dim,\\n95:                                               output_dim=1,\\n96:                                               hidden_units=tower_hidden_units,\\n97:                                               hidden_activations=tower_activations,\\n98:                                               output_activation=None,\\n99:                                               dropout_rates=net_dropout)\\n100:                                     for _ in range(num_tasks)])\\n101:         if isinstance(task, list):\\n102:             assert len(task) == num_tasks, \\\"the number of tasks must equal the length of \\\\\\\"task\\\\\\\"\\\"\\n103:             self.output_activation = nn.ModuleList([self.get_output_activation(str(t)) for t in task])\\n104:         else:\\n105:             self.output_activation = nn.ModuleList(\\n106:                 [self.get_output_activation(task) for _ in range(num_tasks)]\\n107:             )\\n108: \\n109:         self.compile(kwargs.get(\\\"dense_optimizer\\\"), kwargs[\\\"loss\\\"], kwargs.get(\\\"dense_learning_rate\\\"))\\n110:         self.reset_parameters()\\n111:         self.model_to_device()\\n112: \\n113:     def forward(self, inputs):\\n114:         batch_dict, item_dict, mask = self.get_inputs(inputs)\\n115:         batch_size = mask.shape[0]\\n116:         item_seq_emb = self.embedding_layer(item_dict, flatten_emb=True)\\n117:         item_seq_emb = item_seq_emb.view(batch_size, -1, self.item_info_dim)\\n118: \\n119:         target_emb = item_seq_emb[:, -1, :]      # B x item_info_dim\\n120:         sequence_emb = item_seq_emb[:, 0:-1, :]  # B x T x item_info_dim\\n121: \\n122:         seq_pooling_emb = self.attention_layers(target_emb, sequence_emb, mask)\\n123: \\n124:         # Other non-sequential features -> NS tokens\\n125:         user_context_emb = self.embedding_layer(batch_dict, flatten_emb=False)\\n126:         feature_embeddings = torch.cat([user_context_emb,\\n127:                                         target_emb.view(batch_size, -1, self.embedding_dim),\\n128:                                         seq_pooling_emb.view(batch_size, -1, self.embedding_dim)], dim=1)\\n129:         unified_tokens = self.unified_tokenizer_layer(feature_embeddings)\\n130: \\n131:         # unified model\\n132:         unified_tokens = self.activation_checkpoint(\\n133:             self.unified_interaction_layers,\\n134:             unified_tokens\\n135:         )\\n136: \\n137:         # use task tokens for task-specific towers\\n138:         task_tokens = unified_tokens[:, self.num_field:, :]  # [B, num_tasks, token_dim]\\n139:         tower_output = [self.tower[i](task_tokens[:, i, :]) for i in range(self.num_tasks)]\\n140:         y_pred = [self.output_activation[i](tower_output[i]) for i in range(self.num_tasks)]\\n141:         return_dict = {}\\n142:         labels = self.feature_map.labels\\n143:         for i in range(self.num_tasks):\\n144:             return_dict[\\\"{}_pred\\\".format(labels[i])] = y_pred[i]\\n145:         return return_dict\\n146: \\n147: \\n148: class HiFormerTokenizer(nn.Module):\\n149:     def __init__(self, input_dim, token_dim, num_tokens, num_tasks):\\n150:         super(HiFormerTokenizer, self).__init__()\\n151:         self.task_tokens = nn.init.xavier_uniform_(\\n152:             nn.Parameter(torch.empty(1, num_tasks, token_dim))\\n153:         )\\n154:         self.token_mlps = FieldWiseTokenizer(input_dim, token_dim, num_tokens)\\n155: \\n156:     def forward(self, feature_embeddings):\\n157:         tokens = self.token_mlps(feature_embeddings)\\n158:         task_tokens = self.task_tokens.expand(tokens.size(0), -1, -1)\\n159:         return torch.cat([tokens, task_tokens], dim=1)\\n160: \"\n}\n{\n  \"id\": \"paper:hiformer\",\n  \"status\": \"Detailed text unavailable; read the explicitly labeled fallback\",\n  \"fallback_ref\": \"unirank-benchmark-v2\",\n  \"access_scope\": \"Link and provenance only. Read original primary paper before a stronger novelty or reproduction claim.\"\n}\n{\n  \"id\": \"paper:tokenmixer\",\n  \"status\": \"Detailed text unavailable; read the explicitly labeled fallback\",\n  \"fallback_ref\": \"unirank-benchmark-v2\",\n  \"access_scope\": \"Link and provenance only. Read original primary paper befo