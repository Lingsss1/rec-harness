{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/check_proposal.py <<'PY'\nimport ast, copy, hashlib, json, math\nfrom pathlib import Path\nroot=Path('/workspace')\np=json.loads((root/'proposal.json').read_text())\nr=json.load(open('/tmp/r001-contract.json'))\ndef validate(x,s,path='\"'$'\"'):\n typ=s.get('type')\n if typ=='object':\n  assert isinstance(x,dict),(path,'object')\n  assert not set(s.get('required',[]))-set(x),(path,'missing',set(s.get('required',[]))-set(x))\n  if s.get('additionalProperties') is False: assert not set(x)-set(s.get('properties',{})),(path,'extra')\n  for k,v in x.items():\n   if k in s.get('properties',{}):validate(v,s['properties'][k],path+'.'+k)\n elif typ=='array':\n  assert isinstance(x,list),(path,'array')\n  assert len(x)>=s.get('minItems',0),(path,'minItems')\n  for i,v in enumerate(x):validate(v,s.get('items',{}),path+'['+str(i)+']')\n elif typ=='string':\n  assert isinstance(x,str),(path,'string')\n  assert len(x)>=s.get('minLength',0),(path,'minLength')\n if 'enum' in s:assert x in s['enum'],(path,'enum')\n if 'const' in s:assert x==s['const'],(path,'const')\nvalidate(p['study'],r['study_schema'])\nassert p['study']['protocol_ref']==r['required_study_protocol_ref']\nassert p['parent_trial'] in r['context']['allowed_observation_ids']\nassert set(p['study']['evidence_refs'])<=set(r['context']['allowed_observation_ids'])\nassert 1<=len(p['variants'])<=4\nassert any(v['role']=='candidate' for v in p['variants'])\nassert len({v['name'] for v in p['variants']})==len(p['variants'])\nassert len({v['file'] for v in p['variants']})==len(p['variants'])\nallowed={'torch','numpy','math','typing','copy','functools','collections','itertools','dataclasses','contextlib','unirank','model_zoo'}\nreference=None\nfor v in p['variants']:\n name=v['file'];assert name==Path(name).name and name.endswith('.py')\n source=(root/name).read_text()\n compile(source,name,'exec')\n tree=ast.parse(source)\n config_node=next(n for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets))\n config=ast.literal_eval(config_node.value)\n assert config==v['config']\n model=next(n for n in tree.body if isinstance(n,ast.ClassDef) and n.name=='Model')\n init=next(n for n in model.body if isinstance(n,ast.FunctionDef) and n.name=='__init__')\n defaults={a.arg:ast.literal_eval(d) for a,d in zip(init.args.args[-len(init.args.defaults):],init.args.defaults)}\n for k,val in config.items():\n  default=defaults[k]\n  assert val==default or isinstance(val,list) and tuple(val)==default,(name,k,val,default)\n for node in ast.walk(tree):\n  if isinstance(node,ast.Import):\n   for a in node.names:assert a.name.split('.')[0] in allowed\n  elif isinstance(node,ast.ImportFrom):assert node.module.split('.')[0] in allowed\n  elif isinstance(node,ast.Call) and isinstance(node.func,ast.Name):assert node.func.id not in {'open','eval','exec','compile','__import__','input'}\n # Normalize only the allowed arm-specific literal config and default.\n config_node.value=ast.parse(repr(dict(config,representation_mode='split')),mode='eval').body\n i=next(i for i,a in enumerate(init.args.args) if a.arg=='representation_mode')\n init.args.defaults[i-(len(init.args.args)-len(init.args.defaults))]=ast.Constant(value='split')\n normalized=ast.dump(tree,include_attributes=False)\n if reference is None:reference=normalized\n else:assert normalized==reference,(name,'Unexpected architecture/body difference')\n assert hashlib.sha256((root/name).read_bytes()).hexdigest() in v['note']\n print(name,': syntax, config/defaults, imports, equal architecture/initialization PASS')\n# Scalar algebra only, NOT PyTorch model execution. Verify the proposed views\n# at empty, one-event, n=2 equal-scale, and maximum history boundaries.\nfor n in [0,1,2,16,64,100]:\n scores=[0.2*(-1)**i for i in range(n)]\n gates=[1/(1+math.exp(-s)) for s in scores]\n weights=[g/max(sum(gates),1e-9) for g in gates]\n u=sum(w*(i+1) for i,w in enumerate(weights))\n scaled=0.5*n*u\n fused=0.5*(u+scaled)\n assert all(math.isfinite(v) for v in [u,scaled,fused])\n assert n or u==scaled==fused==0\n if n==2:assert u==scaled==fused\n# Verify symbolic additional trainable parameters in the paired constructor.\nf,d,t,h,tasks=6,16,32,128,4\nextra=((f+1)*d+1)*t+5*t+tasks*(5*t)*h\nassert extra==85696\nfor name in ['baseline_reference.py','history_baseline_din.py']:\n assert hashlib.sha256((root/name).read_bytes()).hexdigest()==r['context']['history'][0]['source_sha256']\nprint('Study schema, lineage/evidence IDs, variant contract, source hashes: PASS')\nprint('Scalar boundary algebra: PASS (not a tensor/masking/gradient check)')\nprint('Analytic added parameters for six item fields:',extra,'; host count pending')\nprint('No torch import, training, installation, assessment or test scoring executed.')\nPY\npython3 /tmp/check_proposal.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
