                  save_best_only=save_best_only,\\n53:                                              monitor_mode=monitor_mode,\\n54:                                              early_stop_patience=early_stop_patience,\\n55:                                              eval_steps=eval_steps,\\n56:                                              reduce_lr_on_plateau=reduce_lr_on_plateau,\\n57:                                              **kwargs)\\n58:         self.device = get_device(gpu)\\n59:         self.num_tasks = num_tasks\\n60:         self.loss_weight = loss_weight\\n61:         if isinstance(task, list):\\n62:             assert len(task) == num_tasks, \\\"the number of tasks must equal the length of \\\\\\\"task\\\\\\\"\\\"\\n63:             self.output_activation = nn.ModuleList([self.get_output_activation(str(t)) for t in task])\\n64:         else:\\n65:             self.output_activation = nn.ModuleList(\\n66:                 [self.get_output_activation(task) for _ in range(num_tasks)]\\n67:             )\\n68: \\n69:     def compile(self, optimizer, loss, lr):\\n70:         self._compile_optimizers(optimizer, lr)\\n71:         if isinstance(loss, list):\\n72:             self.loss_fn = [get_loss(l) for l in loss]\\n73:         else:\\n74:             self.loss_fn = [get_loss(loss) for _ in range(self.num_tasks)]\\n75:         self._maybe_enable_torch_compile()\\n76: \\n77:     def get_labels(self, inputs):\\n78:         \\\"\\\"\\\" Override get_labels() to use multiple labels \\\"\\\"\\\"\\n79:         labels = self.feature_map.labels\\n80:         batch_dict = inputs[0]\\n81:         y = [batch_dict[label].to(self.device).float().view(-1, 1)\\n82:              for label in labels]\\n83:         return y\\n84: \\n85:     def add_loss(self, return_dict, y_true):\\n86:         labels = self.feature_map.labels\\n87:         loss = [self.loss_fn[i](return_dict[\\\"{}_pred\\\".format(labels[i])], y_true[i], reduction='mean')\\n88:                 for i in range(len(labels))]\\n89:         if self.loss_weight == 'EQ':\\n90:             # Default: All losses are weighted equally\\n91:             loss = torch.sum(torch.stack(loss))\\n92:         return loss\\n93: \\n94:     def compute_loss(self, return_dict, y_true):\\n95:         return self.add_loss(return_dict, y_true)\\n96: \\n97:     def evaluate(self, data_generator, metrics=None):\\n98:         self.eval()  # set to evaluation mode\\n99:         with torch.no_grad():\\n100:             raw_generator = data_generator\\n101:             y_pred_all = defaultdict(list)\\n102:             y_true_all = defaultdict(list)\\n103:             labels = self.feature_map.labels\\n104:             group_id = []\\n105:             if self._verbose > 0:\\n106:                 data_generator = tqdm(\\n107:                     data_generator,\\n108:                     disable=False,\\n109:                     file=sys.stdout,\\n110:                     desc=f\\\"Rank {self.rank} | Eval\\\",\\n111:                     position=self.rank,\\n112:                     leave=(self.rank == 0),\\n113:                     dynamic_ncols=True\\n114:                 )\\n115: \\n116:             amp_ctx = self._get_amp_context()\\n117:             with amp_ctx:\\n118:                 for batch_data in data_generator:\\n119:                     return_dict = self.forward(batch_data)\\n120:                     batch_y_true = self.get_labels(batch_data)\\n121:                     for i in range(len(labels)):\\n122:                         y_pred_all[labels[i]].extend(\\n123:                             return_dict[\\\"{}_pred\\\".format(labels[i])].float().data.cpu().numpy().reshape(-1))\\n124:                         y_true_all[labels[i]].extend(batch_y_true[i].data.cpu().numpy().reshape(-1))\\n125:                     if self.feature_map.group_id is not None:\"\n}\n","exit_code":0,"status":"completed"}}
