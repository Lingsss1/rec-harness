       self.compile(kwargs.get(\\\"dense_optimizer\\\"), kwargs[\\\"loss\\\"], kwargs.get(\\\"dense_learning_rate\\\"))\\n146:         self.reset_parameters()\\n147:         self.model_to_device()\\n148: \\n149:     def get_current_tau(self):\\n150:         return self.unified_interaction_layers.get_current_tau()\\n151: \\n152:     @disable_torch_compile\\n153:     def update_tau(self, step=None):\\n154:         if step is None:\\n155:             step = getattr(self, \\\"_total_steps\\\", 0)\\n156:         return self.unified_interaction_layers.update_tau(step)\\n157: \\n158:     def train_step(self, batch_data):\\n159:         \\\"\\\"\\\"Update the Sinkhorn temperature before each training forward pass.\\\"\\\"\\\"\\n160:         self.update_tau(step=self._total_steps)\\n161:         return super().train_step(batch_data)\\n162: \\n163:     def _sync_tau_before_eval(self):\\n164:         \\\"\\\"\\\"Use one shared temperature when blocked DDP ranks have uneven batches.\\\"\\\"\\\"\\n165:         if self._is_distributed():\\n166:             total_steps = torch.tensor([self._total_steps], dtype=torch.int64, device=self.device)\\n167:             torch.distributed.all_reduce(total_steps, op=torch.distributed.ReduceOp.MAX)\\n168:             self._total_steps = int(total_steps.item())\\n169:         self.update_tau(step=self._total_steps)\\n170: \\n171:     def eval_step(self):\\n172:         self._sync_tau_before_eval()\\n173:         return super().eval_step()\\n174: \\n175:     def forward(self, inputs):\\n176:         batch_dict, item_dict, mask = self.get_inputs(inputs)\\n177:         batch_size = mask.shape[0]\\n178:         item_seq_emb = self.embedding_layer(item_dict, flatten_emb=True)\\n179:         item_seq_emb = item_seq_emb.view(batch_size, -1)\\n180: \\n181:         user_context_emb = self.embedding_layer(batch_dict, flatten_emb=True)\\n182: \\n183:         feature_embeddings = torch.cat([user_context_emb, item_seq_emb], dim=-1)\\n184: \\n185:         unified_tokens = self.unified_tokenizer_layer(feature_embeddings)\\n186: \\n187:         unified_tokens = self.activation_checkpoint(\\n188:             self.unified_interaction_layers,\\n189:             unified_tokens\\n190:         )\\n191: \\n192:         bottom_output = unified_tokens.flatten(start_dim=1)\\n193:         tower_output = [self.tower[i](bottom_output) for i in range(self.num_tasks)]\\n194:         y_pred = [self.output_activation[i](tower_output[i]) for i in range(self.num_tasks)]\\n195: \\n196:         return_dict = {}\\n197:         labels = self.feature_map.labels\\n198:         for i in range(self.num_tasks):\\n199:             return_dict[f\\\"{labels[i]}_pred\\\"] = y_pred[i]\\n200:         return return_dict\\n201: \\n202: \\n203: class UniMixingLiteBlocks(nn.Module):\\n204:     def __init__(self,\"\n}\n{\n  \"id\": \"unirank-benchmark-v2\",\n  \"title\": \"UniRank: Benchmarking Ranking Models for Unified Sequential Modeling and Feature Interaction\",\n  \"url\": \"https://arxiv.org/html/2607.19987v2\",\n  \"version\": \"arxiv:2607.19987v2\",\n  \"kind\": \"benchmark_paper\",\n  \"content_read\": true,\n  \"read_scope\": \"Section2.3 representative models; protocol and efficiency checked separately during adapter setup.\",\n  \"access_scope\": \"Cached section2.3 method descriptions; not an original-method full-paper audit.\",\n  \"retrieved_on\": \"2026-11-06\",\n  \"scientific_status\": \"external_reference\",\n  \"local_reproduction\": false,\n  \"text_sha256\": \"34ff9c412b35f3118aae377faca5f658d7bffac0b4ef1c12a4eb0c7937372789\",\n  \"content_sha256\": \"a5a9d5475c2e09fc89caa6a9b4b5d2da0f48aef28fea78549278f6388ebfb5d4\",\n  \"text_ref\": \"source-text://unirank-benchmark-v2\",\n  \"text_lines\": 39\n}\n{\n  \"id\": \"unirank-benchmark-v2\",\n  \"url\": \"https://arxiv.org/html/2607.19987v2\",\n  \"version\": \"arxiv:2607.19987v2\",\n  \"access_scope\": \"Cached section2.3 method descriptions; not an original-method full-paper audit.\",\n  \"text_sha256\": \"34ff9c412b35f3118aae377faca5f658d7bffac0b4ef1c12a4eb0c7937372789\",\n  \"total_lines\": 39,\n  \"start_line\": 35,\n  \"next_line\": 40,\n  \"truncated\": false,\n  \"text\": \"35: TokenFormer (Zhou et al., 2026) represents fields, histories, and targets as tokens with full interaction and sliding-window Flex Attention.\\n36: •\\n37: LONGER (Chai et al., 2025) encodes local groups with inner Transformers and joins compressed long-term history with recent queries.\\n38: •\\n39: UltraHSTU (Ding et al., 2026) extends HSTU-style sequential transduction (Zhai et al., 2024) with hybrid attention that combines sparse and full attention in each interaction layer.\"\n}\n","exit_code":0,"status":"completed"}}
