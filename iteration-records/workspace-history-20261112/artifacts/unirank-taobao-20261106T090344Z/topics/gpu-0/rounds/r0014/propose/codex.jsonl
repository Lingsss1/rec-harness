{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/check_curvature.py <<'PY'\nimport ast,hashlib,json,math,random\nfrom pathlib import Path\np=json.loads(Path('/workspace/proposal.json').read_text())\nr=json.load(open('/tmp/research_runtime.json'))\ndef schema_check(x,s,path='study'):\n types={'object':dict,'array':list,'string':str,'boolean':bool,'integer':int,'number':(int,float)}\n if 'type' in s:assert isinstance(x,types[s['type']]),path\n if 'enum' in s:assert x in s['enum'],path\n if 'const' in s:assert x==s['const'],path\n if isinstance(x,dict):\n  assert set(s.get('required',[]))<=set(x),(path,'missing')\n  props=s.get('properties',{})\n  if s.get('additionalProperties') is False:assert set(x)<=set(props),(path,'extra')\n  for k,v in x.items():\n   if k in props:schema_check(v,props[k],path+'.'+k)\n if isinstance(x,list):\n  assert len(x)>=s.get('minItems',0),path\n  if 'items' in s:\n   for i,v in enumerate(x):schema_check(v,s['items'],path+str(i))\n if isinstance(x,str):assert len(x)>=s.get('minLength',0),path\nschema_check(p['study'],r['study_schema'])\nassert p['parent_trial'] in r['context']['allowed_observation_ids']\nassert set(p['study']['evidence_refs'])<=set(r['context']['allowed_observation_ids'])\nassert 1<=len(p['variants'])<=4\nallowed={'torch','numpy','math','typing','copy','functools','collections','itertools','dataclasses','contextlib','unirank','model_zoo'}\nnormalized=[]\nfor v in p['variants']:\n f=Path('/workspace',v['file']);s=f.read_text();t=ast.parse(s);compile(s,str(f),'exec')\n assert f.name==v['file'] and f.suffix=='.py'\n for n in ast.walk(t):\n  if isinstance(n,ast.Import):assert all(a.name.split('.')[0] in allowed for a in n.names)\n  if isinstance(n,ast.ImportFrom):assert n.module.split('.')[0] in allowed\n  if isinstance(n,ast.Call) and isinstance(n.func,ast.Name):assert n.func.id not in {'open','eval','exec','compile','__import__'}\n cfg=next(ast.literal_eval(n.value) for n in t.body if isinstance(n,ast.Assign) and any(isinstance(a,ast.Name) and a.id=='CONFIG' for a in n.targets))\n assert cfg==v['config']\n normalized.append('\\\\n'.join(line for line in s.splitlines() if not line.startswith('CONFIG =')))\nassert len(set(normalized))==1\nperm=[0,7,2,9,4,1,8,3,6,5]\ndef dot(a,b):return sum(x*y for x,y in zip(a,b))\ndef reference(mask):\n n=max(sum(mask),1)\n ranks=[(i//10)/9 for i in range(100)]\n mean=dot(mask,ranks)/n\n linear=[m*(b-mean) for m,b in zip(mask,ranks)]\n local=[]\n for b in range(10):\n  count=sum(mask[10*b:10*b+10]);avg=sum(mask[10*b+i]*i/9 for i in range(10))/max(count,1)\n  local.extend(mask[10*b+i]*(i/9-avg) for i in range(10))\n ln=dot(linear,linear);loc=dot(local,local)\n coarse=[v*math.sqrt(loc/max(ln,1e-12))*(ln>1e-12) for v in linear]\n def residual(raw):\n  avg=dot(mask,raw)/n\n  z=[m*(x-avg) for m,x in zip(mask,raw)]\n  slope=dot(z,linear)/max(ln,1e-12)\n  z=[m*(x-slope*l) for m,x,l in zip(mask,z,linear)]\n  avg=sum(z)/n\n  z=[m*(x-avg) for m,x in zip(mask,z)]\n  return z,dot(z,z)\n q,qn=residual([(b-mean)**2 for b in ranks])\n s,sn=residual([(perm[i//10]/9)**2 for i in range(100)])\n occupied=sum(any(mask[10*b:10*b+10]) for b in range(10))\n support=occupied>=3 and qn>1e-10 and sn>1e-10\n target=dot(coarse,coarse)\n q=[x*math.sqrt(target/max(qn,1e-10))*support for x in q]\n s=[x*math.sqrt(target/max(sn,1e-10))*support for x in s]\n d=[x*support for x in coarse]\n for x in [q,s,d]:\n  assert all(math.isfinite(a) for a in x)\n  assert all(a==0 for a,m in zip(x,mask) if not m)\n  assert abs(sum(x))<1e-9\n  assert abs(dot(x,x)-target*support)<1e-8\n  if occupied<3:assert max(map(abs,x))==0\n for x in [q,s]:\n  assert abs(dot(x,linear))<1e-9\n  assert abs(dot(x,local))<1e-9\n  affine=[3+2*b for b in ranks]\n  assert abs(dot(x,affine))<1e-8\n return q,s,d,coarse\nmasks=[[int(i>=100-n) for i in range(100)] for n in range(101)]\nmasks += [[int((bits>>(i//10))&1) for i in range(100)] for bits in range(1024)]\nrng=random.Random(90514)\nfor _ in range(5000):\n probability=rng.random();masks.append([int(rng.random()<probability) for _ in range(100)])\nfor m in masks:reference(m)\nq,s,d,coarse=reference([1]*100)\n# Construct a block-constant value perturbation invisible to mean and both\n# local/coarse linear coefficient contractions; quadratic contraction changes.\nassert abs(sum(q))<1e-9 and abs(dot(q,coarse))<1e-9 and dot(q,q)>0\n# Scrambled control supplies a distinct direction in the full-history case.\ncorrelation=dot(q,s)/math.sqrt(dot(q,q)*dot(s,s))\nassert abs(correlation)<0.99\nprint(json.dumps({'schema':'pass','syntax_config_imports':'pass','identical_source_except_CONFIG':True,'scalar_reference_masks':len(masks),'scalar_properties':['finite','masked_zero','common_support','norm_matched','constant_cancellation','linear_cancellation','local_moment_orthogonality'],'full_history_quadratic_scrambled_cosine':correlation,'scope':'Python scalar specification checks only; no torch/forward/backward/BF16 or training execution.'},indent=2))\nPY\npython3 /tmp/check_curvature.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
