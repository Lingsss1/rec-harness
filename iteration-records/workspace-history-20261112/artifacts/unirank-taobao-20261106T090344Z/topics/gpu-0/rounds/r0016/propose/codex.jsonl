{"type":"item.completed","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc 'python3 /workspace/tools.py read unirank-code:HeMix --start-line 215 --lines 60'","aggregated_output":"/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n{\n  \"id\": \"unirank-code:HeMix\",\n  \"url\": \"https://github.com/salmon1802/UniRank/blob/90bb99a60724e975ec565836266fd86dcad0039d/model_zoo/HeMix.py\",\n  \"version\": \"git:90bb99a60724e975ec565836266fd86dcad0039d\",\n  \"access_scope\": \"Full pinned benchmark source for inspection; not proof of equivalence to the original author method.\",\n  \"text_sha256\": \"c93117a7cbbc11f58944a872601be16f2b7385cf0b1000141d53a1460bca545a\",\n  \"total_lines\": 380,\n  \"start_line\": 215,\n  \"next_line\": 275,\n  \"truncated\": false,\n  \"text\": \"215:     def forward(self, feature_embeddings, real_sequence_emb, glocal_sequence_emb):\\n216:         if feature_embeddings.dim() > 2:\\n217:             feature_embeddings = torch.flatten(feature_embeddings, start_dim=1)\\n218:         B = feature_embeddings.size(0)\\n219:         ns_tokens = self.token_mlps(feature_embeddings)\\n220:         ns_tokens_glocal = ns_tokens[:, :self.num_glocal_token, :]\\n221:         ns_tokens_real = ns_tokens[:, self.num_glocal_token:, :]\\n222: \\n223:         fixed_real = self.cls_tokens_real.expand(B, -1, -1)\\n224:         fixed_glocal = self.cls_tokens_glocal.expand(B, -1, -1)\\n225:         real_queries = torch.cat([ns_tokens_real, fixed_real], dim=1)\\n226:         glocal_queries = torch.cat([ns_tokens_glocal, fixed_glocal], dim=1)\\n227: \\n228:         tokens_real = self.mha_real(\\n229:             s_tokens=real_sequence_emb,\\n230:             ns_tokens=real_queries\\n231:         )\\n232:         tokens_glocal = self.mha_glocal(\\n233:             s_tokens=glocal_sequence_emb,\\n234:             ns_tokens=glocal_queries\\n235:         )\\n236:         seq_tokens = torch.cat([tokens_real, tokens_glocal], dim=1)\\n237:         return torch.cat([seq_tokens, ns_tokens], dim=1)\\n238: \\n239: \\n240: class MixedHeteroAttention(nn.Module):\\n241:     def __init__(self, input_dim, num_heads, num_ns_token):\\n242:         super(MixedHeteroAttention, self).__init__()\\n243:         assert input_dim % num_heads == 0, \\\"input_dim must be divisible by num_heads\\\"\\n244:         self.num_heads = num_heads\\n245:         self.head_dim = input_dim // num_heads\\n246:         self.W_q_ns = nn.Parameter(torch.empty(num_ns_token, input_dim, input_dim))\\n247:         self.W_k_s = nn.Linear(input_dim, input_dim, bias=False)\\n248:         self.W_v_s = nn.Linear(input_dim, input_dim, bias=False)\\n249:         self.W_o = nn.Linear(input_dim, input_dim, bias=False)\\n250:         self.dot_attention = ScaledDotProductAttention()\\n251:         self.reset_parameters()\\n252: \\n253:     def reset_parameters(self):\\n254:         nn.init.xavier_uniform_(self.W_q_ns)\\n255:         nn.init.xavier_uniform_(self.W_k_s.weight)\\n256:         nn.init.xavier_uniform_(self.W_v_s.weight)\\n257:         nn.init.xavier_uniform_(self.W_o.weight)\\n258: \\n259:     def forward(self, s_tokens, ns_tokens):\\n260:         B, Ls, D = s_tokens.shape\\n261:         _, Lns, _ = ns_tokens.shape\\n262:         if Ls == 0:\\n263:             return ns_tokens\\n264: \\n265:         q_weight = self.W_q_ns[:Lns]\\n266:         q_ns = torch.einsum(\\\"bld,ldh->blh\\\", ns_tokens, q_weight)\\n267:         k_s = self.W_k_s(s_tokens)\\n268:         v_s = self.W_v_s(s_tokens)\\n269:         q = q_ns.view(B, Lns, self.num_heads, self.head_dim).transpose(1, 2)\\n270:         k = k_s.view(B, Ls, self.num_heads, self.head_dim).transpose(1, 2)\\n271:         v = v_s.view(B, Ls, self.num_heads, self.head_dim).transpose(1, 2)\\n272:         output, _ = self.dot_attention(q, k, v, scale=self.head_dim ** 0.5)\\n273:         output = output.transpose(1, 2).co