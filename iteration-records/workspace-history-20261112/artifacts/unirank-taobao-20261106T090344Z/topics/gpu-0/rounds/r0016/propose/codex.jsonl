d','scrambled','duplicate_match','duplicate_curvature'}: pass\n for n in tree.body:\n  if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets):\n   for k,val in zip(n.value.keys,n.value.values):\n    if k.value=='joint_detail': val.value='NORMALIZED'\n  if isinstance(n,ast.ClassDef):\n   init=next(m for m in n.body if isinstance(m,ast.FunctionDef) and m.name=='__init__')\n   for a,d in zip(init.args.args[-len(init.args.defaults):],init.args.defaults):\n    if a.arg=='joint_detail': d.value='NORMALIZED'\n return ast.dump(tree,include_attributes=False)\nassert len({canonical(ast.parse(Path('/workspace',v['file']).read_text())) for v in proposal['variants']})==1\nold=ast.parse(Path('/workspace/history_g0_r0014_scrambled_curvature_task.py').read_text())\nnew=ast.parse(s)\ndef methods(t):\n return {n.name:ast.dump(n,include_attributes=False) for n in ast.walk(t) if isinstance(n,ast.FunctionDef)}\nfor method in ['_compress_both','_interactions','_auxiliary_activation','_pool','_orthogonal_block_residual']:\n assert methods(old)[method]==methods(new)[method],method\nprint('Normalized entire-module AST parity passed; inherited compression, interaction, scorer, pooling and coarse-residual methods unchanged.')\nprint('No torch imports or runtime tensor execution attempted.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
