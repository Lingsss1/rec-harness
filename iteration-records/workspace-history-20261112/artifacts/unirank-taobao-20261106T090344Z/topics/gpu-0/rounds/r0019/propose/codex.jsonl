{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport ast,hashlib,inspect,json,math,random\nfrom pathlib import Path\nfiles=['candidate.py','coarse_scrambled.py','coarse_duplicate.py','coarse_bridge.py']\nold=ast.parse(Path('history_g0_r0017_joint_raw.py').read_text())\ndef methods(tree):\n return {n.name:n for c in tree.body if isinstance(c,ast.ClassDef) and c.name=='Model' for n in c.body if isinstance(n,ast.FunctionDef)}\noldm=methods(old)\nnormalized=[]\nfor f in files:\n s=Path(f).read_text();tree=ast.parse(s);m=methods(tree)\n config=next(ast.literal_eval(n.value) for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets))\n defaults=dict(zip([x.arg for x in m['__init__'].args.args][-len(m['__init__'].args.defaults):],m['__init__'].args.defaults))\n for k,v in config.items():\n  assert k in defaults,(f,k)\n  d=ast.literal_eval(defaults[k]);assert list(d) == v if isinstance(d,tuple) else d==v,(f,k,v,d)\n for k in oldm:\n  if k not in ['__init__','_target_match_summary']:\n   assert ast.dump(m[k])==ast.dump(oldm[k]),(f,k)\n def allocations(method):\n  return [ast.dump(n) for n in ast.walk(method) if isinstance(n,ast.Call) and ((isinstance(n.func,ast.Attribute) and isinstance(n.func.value,ast.Name) and n.func.value.id in ['nn','torch']) or isinstance(n.func,ast.Name) and n.func.id in ['FeatureEmbeddingDict','Dice'])]\n assert allocations(m['__init__'])==allocations(oldm['__init__'])\n for n in ast.walk(tree):\n  if isinstance(n,ast.Import): assert all(a.name.split('.')[0] in ['torch','unirank'] for a in n.names)\n  if isinstance(n,ast.ImportFrom):assert n.module.split('.')[0] in ['torch','unirank']\n  if isinstance(n,ast.Call) and isinstance(n.func,ast.Name): assert n.func.id not in ['open','exec','eval','compile','__import__']\n # Normalize only config mode and constructor default, never branch literals.\n for n in tree.body:\n  if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets):\n   for i,k in enumerate(n.value.keys):\n    if ast.literal_eval(k)=='coarse_extension': n.value.values[i]=ast.Constant(value='MODE')\n idx=[x.arg for x in m['__init__'].args.args].index('coarse_extension')-(len(m['__init__'].args.args)-len(m['__init__'].args.defaults))\n m['__init__'].args.defaults[idx]=ast.Constant(value='MODE')\n normalized.append(ast.dump(tree))\n print(f,hashlib.sha256(s.encode()).hexdigest(),config['coarse_extension'])\nassert len(set(normalized))==1\nprint('STATIC PASS: syntax, config/default parity, identical module allocations/core methods, imports, normalized entire-module equality')\n\n# Independent scalar FP64 specification. No tensor execution or model emulation.\nrng=random.Random(71203)\ndef dot(a,b):return sum(x*y for x,y in zip(a,b))\ndef norm(a):return dot(a,a)\ndef residual(raw,l,q,v):\n total=max(sum(v),1);a=[x*z for x,z in zip(raw,v)]\n for _ in range(2):\n  mean=sum(a)/total;a=[z*(x-mean) for x,z in zip(a,v)]\n  for basis in [l,q]:\n   slope=dot(a,basis)/max(norm(basis),1e-12)\n   a=[z*(x-slope*y) for x,y,z in zip(a,basis,v)]\n mean=sum(a)/total\n return [z*(x-mean) for x,z in zip(a,v)]\ndef inherited(v,aff):\n counts=[sum(v[10*k:10*k+10]) for k in range(10)]\n total=max(sum(v),1);rank=[(i//10)/9 for i in range(100)]\n perm=[0,7,2,9,4,1,8,3,6,5];scr=[perm[i//10]/9 for i in range(100)]\n pos=[];match=[]\n for k,c in enumerate(counts):\n  z=v[10*k:10*k+10];a=aff[10*k:10*k+10]\n  pm=sum(j/9*x for j,x in enumerate(z))/max(c,1);am=sum(a)/max(c,1)\n  pos += [x*(j/9-pm) for j,x in enumerate(z)]\n  match += [x-y*am for x,y in zip(a,z)]\n mean=dot(rank,v)/total;l=[z*(x-mean) for z,x in zip(v,rank)]\n # Mimic inherited fourth: constant/linear residual and common availability.\n def fourth(raw):\n  mu=dot(raw,v)/total;a=[z*(x-mu) for x,z in zip(raw,v)]\n  slope=dot(a,l)/max(norm(l),1e-12);a=[z*(x-slope*y) for x,y,z in zip(a,l,v)]\n  mu=sum(a)/total;return [z*(x-mu) for x,z in zip(a,v)]\n q=fourth([(x-mean)**2 for x in rank]);qs=fourth([x*x for x in scr])\n g=sum(c>0 for c in counts)>=3 and norm(q)>1e-10 and norm(qs)>1e-10\n scale=math.sqrt(norm(pos)/max(norm(q),1e-10)) if g else 0\n q=[x*scale for x in q]\n available=norm(pos)>1e-10 and norm(match)>1e-10\n inc=[x*math.sqrt(norm(pos)/max(norm(match),1e-10))*(1 if available else 0) for x in match]\n return counts,rank,scr,l,q,pos,match,inc\nmasks=[[int(i>=100-n) for i in range(100)] for n in range(101)]\nfor bits in range(1024):\n v=[]\n for k in range(10):\n  n=rng.randrange(1,11) if bits>>k&1 else 0\n  v += [int(j>=10-n) for j in range(10)]\n masks.append(v)\nfor _ in range(400):masks.append([int(rng.random()<rng.random()) for i in range(100)])\nmaxdot=maxnorm=0.;eligible=noncollinear=cases=0\nfor v in masks:\n for kind in range(3):\n  aff=[z*(0 if kind==0 else 1 if kind==1 else rng.randrange(4)/3) for z in v]\n  counts,rank,scr,l,q,pos,match,inc=inherited(v,aff)\n  cubic=residual([x*x*x for x in rank],l,q,v)\n  scrambled=residual([x*x*x for x in scr],l,q,v)\n  g=(sum(c>0 for c in counts)>=4 and norm(cubic)>1e-10 and norm(scrambled)>1e-10 and norm(inc)>1e-10 and norm(pos)>1e-10)\n  a=[x*math.sqrt(norm(pos)/max(norm(cubic),1e-10))*g for x in cubic]\n  b=[x*math.sqrt(norm(pos)/max(norm(scrambled),1e-10))*g for x in scrambled]\n  dup=[x*g for x in inc]\n  for coeff in [a,b,dup,inc]:\n   assert all(math.isfinite(x) and (z or x==0) for x,z in zip(coeff,v))\n  for coeff in [a,b]:\n   for basis in [v,l,q,pos,match]:\n    e=abs(dot(coeff,basis));maxdot=max(maxdot,e);assert e<1e-8,e\n  for coeff in [a,b,dup]:\n   e=abs(norm(coeff)-(norm(pos) if g else 0));maxnorm=max(maxnorm,e);assert e<1e-8,e\n  if g:\n   eligible+=1\n   rho=dot(a,b)/math.sqrt(norm(a)*norm(b))\n   noncollinear+=abs(rho)<0.999\n  cases+=1\nprint(json.dumps(dict(scalar_specification_cases=cases,eligible=eligible,noncollinear=noncollinear,max_basis_dot=maxdot,max_norm2_error=maxnorm)))\n# Explicit information witness: perturb values along cubic; prior coefficient\n# contractions are zero but the new fifth responds. This is algebra, not data.\nv=[1]*100;aff=[(i%4)/3 for i in range(100)]\nc,r,s,l,q,p,m,inc=inherited(v,aff);a=residual([x*x*x for x in r],l,q,v)\nprint('WITNESS',dict(new_response=norm(a),prior_response=[dot(a,x) for x in [v,l,q,p,m,inc]]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
