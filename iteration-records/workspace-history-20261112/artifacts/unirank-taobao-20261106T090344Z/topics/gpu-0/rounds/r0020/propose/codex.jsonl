{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport ast, hashlib\nsource = Path('candidate.py').read_text()\nancestor = Path('history_g0_r0019_cubic_gated_duplicate.py').read_text()\nassert source == ancestor\nprint('Incumbent source verified:', hashlib.sha256(source.encode()).hexdigest())\nsource = source.replace(source[:source.index('import torch')], '''\\\"\\\"\\\"Feedback/value alignment as a capacity-fixed fifth summary replacement.\n\nOnly released masked historical feedback is used. Within each ten-event\nblock, center the union-feedback indicator and remove local-position and\ntarget-match directions. Compare the aligned contraction with a deterministic\nvalid-rank rotation, a common-gate duplicate and the exact incumbent bridge.\nEvery cell builds all alternatives, modules and inherited coefficients.\nOriginal-method novelty and predictive improvement remain unverified.\n\\\"\\\"\\\"\n''', 1)\nsource = source.replace(\\\"'coarse_extension': 'duplicate'}\\\", \\\"'coarse_extension': 'duplicate', 'feedback_extension': 'aligned'}\\\", 1)\nsource = source.replace(\\\"match_support='available', match_scaling='norm', coarse_extension='duplicate',\\\", \\\"match_support='available', match_scaling='norm', coarse_extension='duplicate',\\\\n                 feedback_extension='aligned',\\\", 1)\nsource = source.replace('        self.coarse_extension = coarse_extension\\\\n', '''        if coarse_extension \"'!= '\"'duplicate':\n            raise ValueError('The inherited fifth must be the gated match duplicate')\n        self.coarse_extension = coarse_extension\n        if feedback_extension not in ('aligned', 'rotated', 'duplicate', 'bridge'):\n            raise ValueError('Unknown feedback-alignment replacement')\n        self.feedback_extension = feedback_extension\n''', 1)\nsource = source.replace('            item, values, mask)\\\\n', '            item, values, mask, auxiliary)\\\\n', 1)\nsource = source.replace('    def _target_match_summary(self, item, values, mask):\\\\n', '    def _target_match_summary(self, item, values, mask, auxiliary):\\\\n', 1)\nstart = source.index('        \\\"\\\"\\\"Five masked value summaries; only the fifth direction/gate varies.')\nend = source.index('        matches = []', start)\nsource = source[:start] + '''        \\\"\\\"\\\"Retain four summaries; replace only the redundant fifth channel.\n\n        Coefficients are FP32, parameter-free and masked before contraction.\n        All summaries keep the inherited sqrt(valid-event-count) denominator.\n        \\\"\\\"\\\"\n''' + source[end:]\nneedle = '''        coefficients = torch.stack(\n            (centered, centered_position, block_coefficients, fourth, fifth), dim=-2)'''\nassert source.count(needle) == 1\nsource = source.replace(needle, '''        fifth = self._feedback_extension_coefficients(\n            fifth, centered, centered_position, auxiliary, valid, counts)\n        coefficients = torch.stack(\n            (centered, centered_position, block_coefficients, fourth, fifth), dim=-2)''', 1)\ninsert = source.index('    def _coarse_extension_coefficients(')\nsource = source[:insert] + '''    def _feedback_extension_coefficients(self, incumbent, affinity, position,\n                                         auxiliary, valid, counts):\n        \\\"\\\"\\\"Residual feedback/value covariance with common support and scale.\n\n        Rotation acts on the ordered VALID positions of each block, so it\n        preserves each block's feedback count even with noncontiguous masks.\n        It rearranges indicator/value alignment; it is not a new random seed\n        or a claim that all feedback information has been destroyed.\n\n        Block centering removes every block-constant direction. Removing\n        local position and residual target match then excludes all four\n        inherited coefficient directions. The fifth incumbent is collinear\n        with target match. New summaries can still overlap information in\n        the inherited feedback-stratified pooling path.\n        \\\"\\\"\\\"\n        feedback = auxiliary.reshape_as(valid).to(torch.float32) * valid\n        valid_rank = valid.to(torch.int64).cumsum(dim=-1) - 1\n        count_int = counts.to(torch.int64)\n        # Gather only valid positions, ordered by their array ordinal.\n        ordinal = torch.arange(10, device=valid.device, dtype=torch.int64).view(1, 1, 10)\n        valid_order = (ordinal + (1 - valid.to(torch.int64)) * 10).argsort(dim=-1)\n        source_rank = (valid_rank + count_int // 2).remainder(count_int.clamp_min(1))\n        source_index = valid_order.gather(-1, source_rank)\n        rotated_feedback = feedback.gather(-1, source_index) * valid\n\n        position_norm2 = position.square().sum(dim=(1, 2), keepdim=True)\n        basis = self._joint_residual(\n            affinity, position, position_norm2, torch.zeros_like(affinity),\n            torch.zeros_like(position_norm2), valid, counts)\n        basis_norm2 = basis.square().sum(dim=(1, 2), keepdim=True)\n        basis = basis * (basis_norm2 > 1e-10).to(valid.dtype)\n        basis_norm2 = basis.square().sum(dim=(1, 2), keepdim=True)\n        aligned = self._joint_residual(\n            feedback, position, position_norm2, basis, basis_norm2, valid, counts)\n        rotated = self._joint_residual(\n            rotated_feedback, position, position_norm2, basis, basis_norm2, valid, counts)\n        aligned_norm2 = aligned.square().sum(dim=(1, 2), keepdim=True)\n        rotated_norm2 = rotated.square().sum(dim=(1, 2), keepdim=True)\n        incumbent_norm2 = incumbent.square().sum(dim=(1, 2), keepdim=True)\n        # Fixed threshold rejects tiny residuals before normalization. Gate\n        # construction and both normalizations execute in every study cell.\n        support = ((incumbent_norm2 > 1e-10) & (position_norm2 > 1e-10)\n                   & (aligned_norm2 > 1e-8) & (rotated_norm2 > 1e-8)).to(valid.dtype)\n        aligned = (aligned * (incumbent_norm2 / aligned_norm2.clamp_min(1e-8)).sqrt()\n                   * support)\n        rotated = (rotated * (incumbent_norm2 / rotated_norm2.clamp_min(1e-8)).sqrt()\n                   * support)\n        duplicate = incumbent * support\n        if self.feedback_extension == 'aligned':\n            return aligned\n        if self.feedback_extension == 'rotated':\n            return rotated\n        if self.feedback_extension == 'duplicate':\n            return duplicate\n        return incumbent\n\n''' + source[insert:]\nfiles = [('candidate.py','aligned'), ('feedback_rotated.py','rotated'),\n         ('feedback_gated_duplicate.py','duplicate'), ('feedback_bridge.py','bridge')]\nfor filename, mode in files:\n    text = source.replace(\\\"'feedback_extension': 'aligned'\\\", \\\"'feedback_extension': '\\\" + mode + \\\"'\\\", 1)\n    text = text.replace(\\\"feedback_extension='aligned'\\\", \\\"feedback_extension='\\\" + mode + \\\"'\\\", 1)\n    ast.parse(text)\n    Path(filename).write_text(text)\n    print(filename, hashlib.sha256(text.encode()).hexdigest())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
