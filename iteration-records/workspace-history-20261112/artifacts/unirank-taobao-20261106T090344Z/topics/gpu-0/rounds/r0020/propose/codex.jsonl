{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport math, random\nrng=random.Random(20261106)\nN=100\n\ndef dot(a,b):return sum(x*y for x,y in zip(a,b))\ndef sub(a,b,s):return [x-s*y for x,y in zip(a,b)]\ndef center(x,m):\n    out=[0.]*N\n    for k in range(10):\n        ids=[i for i in range(k*10,k*10+10) if m[i]]\n        mean=sum(x[i] for i in ids)/max(len(ids),1)\n        for i in ids:out[i]=x[i]-mean\n    return out\n\ndef residual(raw,pos,basis,m):\n    x=center(raw,m)\n    for _ in range(2):\n        x=sub(x,pos,dot(x,pos)/max(dot(pos,pos),1e-10))\n        x=sub(x,basis,dot(x,basis)/max(dot(basis,basis),1e-10))\n        x=center(x,m)\n    return x\n\ndef rotate(feedback,m):\n    out=[0.]*N\n    for k in range(10):\n        ids=[i for i in range(k*10,k*10+10) if m[i]]\n        for r,i in enumerate(ids):out[i]=feedback[ids[(r+len(ids)//2)%len(ids)]]\n    return out\n\ndef gather_rotate(feedback,m):\n    out=[]\n    for k in range(10):\n        mm=m[k*10:k*10+10]; ff=feedback[k*10:k*10+10]\n        count=sum(mm); rank=-1\n        order=sorted(range(10),key=lambda i:i+(1-mm[i])*10)\n        for i in range(10):\n            rank+=mm[i]\n            source_rank=(rank+count//2)%max(count,1)\n            out.append(ff[order[source_rank]]*mm[i])\n    return out\n\ndef coefficients(feedback,m,affinity,pos,incumbent):\n    feedback=[x*v for x,v in zip(feedback,m)]\n    rotated=gather_rotate(feedback,m)\n    basis=residual(affinity,pos,[0.]*N,m)\n    if dot(basis,basis)<=1e-10:basis=[0.]*N\n    a=residual(feedback,pos,basis,m); r=residual(rotated,pos,basis,m)\n    an=dot(a,a);rn=dot(r,r);tn=dot(incumbent,incumbent)\n    gate=tn>1e-10 and dot(pos,pos)>1e-10 and an>1e-8 and rn>1e-8\n    aa=[x*math.sqrt(tn/max(an,1e-8))*gate for x in a]\n    rr=[x*math.sqrt(tn/max(rn,1e-8))*gate for x in r]\n    dd=[x*gate for x in incumbent]\n    return aa,rr,dd,list(incumbent),gate\n\ncases=[]\nfor length in [0,1,2,3,9,10,11,16,29,30,31,40,64,90,99,100]:\n    mask=[int(i>=100-length) for i in range(100)]\n    for pattern in ('none','all','alternating','sparse','random'):\n        feedback=[int(pattern=='all' or pattern=='alternating' and i%2==0 or pattern=='sparse' and i%11==0 or pattern=='random' and rng.random()<.3) for i in range(100)]\n        cases.append((mask,feedback))\nfor _ in range(2200):\n    mask=[int(rng.random()<rng.choice([.05,.25,.5,.9,1.])) for i in range(N)]\n    probability=rng.choice([0.,.01,.05,.2,.5,.8,1.])\n    cases.append((mask,[int(rng.random()<probability) for i in range(N)]))\nmax_dot=max_norm=0.;eligible=noncollinear=0;witness=0.\nfor case,(m,f) in enumerate(cases):\n    p=center([i%10/9 for i in range(N)],m)\n    raw=[rng.randrange(4)/3 for i in range(N)]\n    affinity=center(raw,m)\n    pn=dot(p,p);mn=dot(affinity,affinity)\n    oldgate=sum(any(m[i] for i in range(k*10,k*10+10)) for k in range(10))>=4\n    incumbent=[x*math.sqrt(pn/max(mn,1e-10))*oldgate*int(pn>1e-10 and mn>1e-10) for x in affinity]\n    a,r,d,b,g=coefficients(f,m,affinity,p,incumbent)\n    assert gather_rotate([x*v for x,v in zip(f,m)],m)==rotate([x*v for x,v in zip(f,m)],m)\n    rot=rotate([x*v for x,v in zip(f,m)],m)\n    for k in range(10):\n        assert sum(rot[k*10:k*10+10])==sum(f[i]*m[i] for i in range(k*10,k*10+10))\n    assert b==incumbent\n    assert d==[x*g for x in incumbent]\n    for out in (a,r,d,b):\n        assert all(math.isfinite(x) for x in out)\n        assert all(x==0 for x,v in zip(out,m) if not v)\n    for out in (a,r):\n        for k in range(10):assert abs(sum(out[k*10:k*10+10]))<1e-9\n        max_dot=max(max_dot,abs(dot(out,p)),abs(dot(out,affinity)))\n        assert abs(dot(out,p))<1e-8 and abs(dot(out,affinity))<1e-8\n        max_norm=max(max_norm,abs(dot(out,out)-dot(d,d)))\n        assert abs(dot(out,out)-dot(d,d))<1e-8\n    perturbed=[x if m[i] else 37.+i for i,x in enumerate(f)]\n    assert coefficients(perturbed,m,affinity,p,incumbent)==(a,r,d,b,g)\n    if g:\n        eligible+=1\n        cosine=dot(a,r)/max(dot(a,a),1e-10)\n        if abs(cosine)<.999999:noncollinear+=1\n        # Witness concerns four old coefficient directions, not the full network.\n        if witness==0 and abs(cosine)<.9:\n            witness=dot(a,a)\n            for rankfn in (lambda k:1.,lambda k:k/9,lambda k:(k/9)**2):\n                assert abs(dot(a,[m[i]*rankfn(i//10) for i in range(N)]))<1e-8\n        complement=[1-x for x in f]\n        aa,rr,dd,bb,gg=coefficients(complement,m,affinity,p,incumbent)\n        assert gg==g\n        assert max(abs(x+y) for x,y in zip(a,aa))<1e-8\n        assert max(abs(x+y) for x,y in zip(r,rr))<1e-8\nprint('Independent scalar FP64 specification cases:',len(cases))\nprint('Common-gate eligible:',eligible,'aligned/rotated noncollinear:',noncollinear)\nprint('Maximum old-direction dot:',format(max_dot,'.4g'))\nprint('Maximum matched norm2 error:',format(max_norm,'.4g'))\nprint('Old coefficient-span null witness / new response:',format(witness,'.6g'))\nprint('Finite/zero-padding/block-centering/norm/rotation-count/bridge/padded-perturbation/complement checks passed.')\nprint('Specification checks only: no torch, BF16, model gradients, data execution, training or scoring.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
