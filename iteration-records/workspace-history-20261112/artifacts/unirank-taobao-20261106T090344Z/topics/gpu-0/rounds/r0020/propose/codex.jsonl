{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport ast, hashlib, json, subprocess\nfrom pathlib import Path\nr=json.loads(subprocess.check_output(['python3','/workspace/tools.py','resolve','run://r-001'],text=True))\np=json.loads(Path('proposal.json').read_text())\n\ndef validate(value,schema,path='\"'$'\"'):\n    typ=schema.get('type')\n    if typ:\n        types={'object':dict,'array':list,'string':str,'boolean':bool,'integer':int,'number':(int,float)}\n        assert isinstance(value,types[typ]),(path,typ,type(value).__name__)\n    if 'enum' in schema:assert value in schema['enum'],(path,'enum')\n    if 'const' in schema:assert value==schema['const'],(path,'const')\n    if isinstance(value,str):assert len(value)>=schema.get('minLength',0),(path,'minLength')\n    if isinstance(value,list):\n        assert len(value)>=schema.get('minItems',0),(path,'minItems')\n        for i,x in enumerate(value):validate(x,schema.get('items',{}),path+'['+str(i)+']')\n    if isinstance(value,dict):\n        assert all(k in value for k in schema.get('required',[])),(path,'required')\n        if schema.get('additionalProperties') is False:assert set(value)<=set(schema.get('properties',{})),(path,'additionalProperties')\n        for k,v in value.items():\n            if k in schema.get('properties',{}):validate(v,schema['properties'][k],path+'.'+k)\nvalidate(p['study'],r['study_schema'])\nassert p['study']['protocol_ref']==r['required_study_protocol_ref']\nallowed=set(r['context']['allowed_observation_ids'])\nassert p['parent_trial'] in allowed\nassert set(p['study']['evidence_refs'])<=allowed\nassert r['phase']=='propose' and 'proposal.json' in r['expected_files']\nvariants=p['variants']\nassert 1<=len(variants)<=4 and any(v['role']=='candidate' for v in variants)\nassert len({v['name'] for v in variants})==len(variants)\nassert len({v['file'] for v in variants})==len(variants)\nfor v in variants:\n    assert set(v)=={'name','file','role','config','note'}\n    assert v['role'] in ('candidate','control')\n    assert Path(v['file']).name==v['file'] and v['file'].endswith('.py')\n    src=Path(v['file']).read_text();tree=ast.parse(src)\n    compile(src,v['file'],'exec')\n    cfg=ast.literal_eval(next(n.value for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets)))\n    assert cfg==v['config']\n    digest=hashlib.sha256(src.encode()).hexdigest()\n    assert digest in v['note']\n    print(v['name'],v['role'],v['file'],digest)\nfor a in p['knowledge_assessments']:\n    assert a['decision'] in ('used','considered','rejected','unresolved')\n    assert set(a['variant_names'])<=set(v['name'] for v in variants)\nprint('Study schema, protocol, evidence IDs, parent lineage, variant interface/config/hash and knowledge-assessment checks passed.')\nprint('Remaining host budget seconds:',r['context']['remaining_seconds'])\nprint('proposal.json SHA256:',hashlib.sha256(Path('proposal.json').read_bytes()).hexdigest())\nprint('Protected baseline hash:',hashlib.sha256(Path('baseline_reference.py').read_bytes()).hexdigest())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
