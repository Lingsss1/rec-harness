s\",\n      \"evidence-linked agent knowledge\"\n    ],\n    \"host_owned\": [\n      \"raw data identities\",\n      \"causal feature construction and split policy\",\n      \"labels and scorers\",\n      \"resource ledger\",\n      \"held-out execution\",\n      \"read-only knowledge snapshots\"\n    ],\n    \"candidate_interface\": \"Defined by the task adapter at freeze time; must return prediction logits/probabilities with fixed sample identity and information boundary.\",\n    \"protocol_change\": \"Requires a new version and rerun of affected references before any new comparison; no silent changes during search.\"\n  },\n  \"final_assessment\": {\n    \"selection\": \"validation only\",\n    \"freeze\": [\n      \"candidate source/config/checkpoint hashes\",\n      \"selected candidates\",\n      \"closest references\",\n      \"key ablations and matched controls\",\n      \"repetition seeds\",\n      \"assessment commands\"\n    ],\n    \"repetitions\": \"Target three paired seeds for the final candidate and closest controls when budget permits; record omitted repetitions and retain single-seed conclusions as preliminary.\",\n    \"test\": \"Closed during autonomous research. A final suite must be frozen before any held-out scoring; no automatic test access from research loop.\",\n    \"failure\": \"Retain failed assessment receipts; unknown execution state does not authorize automatic duplicate testing.\"\n  },\n  \"deliverables\": [\n    \"best supported model code/configuration and executable reproduction commands\",\n    \"problem and mechanism hypothesis\",\n    \"closest-work difference and inherited parts\",\n    \"baseline/candidate/ablation/cost tables\",\n    \"all experiment records including failures\",\n    \"updated scene-scoped agent knowledge\",\n    \"boundaries, unresolved questions and next hypotheses\"\n  ],\n  \"readiness_gates\": [\n    \"Verify pinned released parquet digests\",\n    \"Audit actual loader fields/labels/prefix semantics