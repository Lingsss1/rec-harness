{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport ast, copy, hashlib, importlib.util\nfrom pathlib import Path\nfiles=['candidate.py','feedback_rotated.py','feedback_gated_duplicate.py','feedback_bridge.py']\nancestor=ast.parse(Path('history_g0_r0019_cubic_gated_duplicate.py').read_text())\ndef methods(tree):\n    cls=next(n for n in tree.body if isinstance(n,ast.ClassDef) and n.name=='Model')\n    return {n.name:n for n in cls.body if isinstance(n,ast.FunctionDef)}\nold=methods(ancestor)\nnormalized=[]\nfor f in files:\n    text=Path(f).read_text(); tree=ast.parse(text); compile(text,f,'exec')\n    config=ast.literal_eval(next(n.value for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets)))\n    new=methods(tree)\n    init=new['__init__']; args=init.args.args\n    defaults=dict(zip([a.arg for a in args[-len(init.args.defaults):]],init.args.defaults))\n    for k,v in config.items():\n        assert k in defaults, (f,k)\n        value=ast.literal_eval(defaults[k])\n        assert v==value or isinstance(v,list) and tuple(v)==value, (f,k,v,value)\n    for name,method in old.items():\n        if name not in ('__init__','_represent','_target_match_summary'):\n            assert ast.dump(method)==ast.dump(new[name]), (f,name)\n    # Allocation, initialization order and forwards have no source changes.\n    oi=copy.deepcopy(old['__init__']); ni=copy.deepcopy(new['__init__'])\n    os=next(i for i,n in enumerate(oi.body) if isinstance(n,ast.Assign) and any(isinstance(t,ast.Attribute) and t.attr=='embedding_layer' for t in n.targets))\n    ns=next(i for i,n in enumerate(ni.body) if isinstance(n,ast.Assign) and any(isinstance(t,ast.Attribute) and t.attr=='embedding_layer' for t in n.targets))\n    assert [ast.dump(n) for n in oi.body[os:]]==[ast.dump(n) for n in ni.body[ns:]]\n    imports=[]\n    for n in ast.walk(tree):\n        if isinstanc