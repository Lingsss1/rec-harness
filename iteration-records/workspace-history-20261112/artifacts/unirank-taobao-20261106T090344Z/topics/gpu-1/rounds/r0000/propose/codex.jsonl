c_hub_mlps(c_hubs_flat)\\n185:         return c_orgs, c_hubs\\n186: \\n187: \\n188: class INFNetBlocks(nn.Module):\\n189:     \\\"\\\"\\\"INFNet core module that manages multi-layer stacking: including Phase 1 (Aggregation) and Phase 2 (Broadcast)\\\"\\\"\\\"\\n190: \\n191:     def __init__(self, num_layers, token_dim, num_c_hubs, num_s_hubs, num_t_hubs, expansion_factor=4):\\n192:         super(INFNetBlocks, self).__init__()\\n193:         self.num_layers = num_layers\\n194: \\n195:         # Use nn.ModuleList to stack multiple layers of Aggregation and Broadcast respectively\\n196:         self.aggregation_layers = nn.ModuleList([\\n197:             Aggregation(token_dim) for _ in range(num_layers)\\n198:         ])\\n199:         self.broadcast_layers = nn.ModuleList([\\n200:             Broadcast(token_dim, num_c_hubs, num_s_hubs, num_t_hubs, expansion_factor)\\n201:             for _ in range(num_layers)\\n202:         ])\\n203: \\n204:     def forward(self, c_orgs, s_orgs, t_orgs, c_hubs, s_hubs, t_shared, s_mask=None):\\n205:         # Equation (4): Task Hubs are composed of Specific and Shared\\n206:         t_hubs = torch.cat([t_orgs, t_shared], dim=1)\\n207:         # Iterative update layer by layer\\n208:         for i in range(self.num_layers):\\n209:             # Phase 1: Multi-View Global Aggregation\\n210:             c_hubs, s_hubs, t_hubs = self.aggregation_layers[i](\\n211:                 c_hubs, s_hubs, t_hubs, c_orgs, s_orgs, t_orgs, s_mask\\n212:             )\\n213: \\n214:             # Phase 2: Global-to-Local Affine Broadcast\\n215:             c_orgs, s_orgs, t_orgs = self.broadcast_layers[i](\\n216:                 c_orgs, s_orgs, t_orgs, c_hubs, s_hubs, t_hubs\\n217:             )\\n218: \\n219:         return t_orgs\\n220: \\n221: \\n222: class Aggregation(nn.Module):\\n223:     \\\"\\\"\\\" Multi-View Global Aggregation\\n224:     Keep SDPA mask-free to preserve FlashAttention eligibility, accepting minor attention leakage.\\n225:     \\\"\\\"\\\"\\n226:     def __init__(self, token_dim):\\n227:         super(Aggregation, self).__init__()\\n228:         # Shared Keys/Values projection to reduce calculations\\n229:         self.k_proj_c = nn.Linear(token_dim, token_dim)\\n230:         self.v_proj_c = nn.Linear(token_dim, token_dim)\\n231:         self.k_proj_s = nn.Linear(token_dim, token_dim)\\n232:         self.v_proj_s = nn.Linear(token_dim, token_dim)\\n233:         self.k_proj_t = nn.Linear(token_dim, token_dim)\\n234:         self.v_proj_t = nn.Linear(token_dim, token_dim)\\n235: \\n236:         # Independent Hub aggregator for each group\\n237:         self.c_agg = HubSpecificAggregator(token_dim)\\n238:         self.s_agg = HubSpecificAggregator(token_dim)\\n239:         self.t_agg = HubSpecificAggregator(token_dim)\\n240: \"\n}\n","exit_code":0,"status":"completed"}}
