u(s_orgs, s_hubs)\\n287:         t_orgs_out = self.t_bgu(t_orgs, t_hubs)\\n288:         return c_orgs_out, s_orgs_out, t_orgs_out\\n289: \\n290: \\n291: class BroadcastGatedUnit(nn.Module):\\n292:     \\\"\\\"\\\"The BGU (Broadcast Gated Unit) mechanism in the paper\\\"\\\"\\\"\\n293: \\n294:     def __init__(self, token_dim, num_hubs, expansion_factor=4):\\n295:         super(BroadcastGatedUnit, self).__init__()\\n296:         self.mlp = nn.Sequential(\\n297:             nn.Linear(num_hubs * token_dim, token_dim * expansion_factor),\\n298:             nn.ReLU(),\\n299:             nn.Linear(token_dim * expansion_factor, token_dim * 2)\\n300:         )\\n301:         self.norm = nn.LayerNorm(token_dim)\\n302: \\n303:     def forward(self, orgs, hubs):\\n304:         B = hubs.size(0)\\n305:         hubs_flat = hubs.view(B, -1)\\n306: \\n307:         hyper_params = self.mlp(hubs_flat)\\n308:         alpha, beta = hyper_params.chunk(2, dim=-1)\\n309:         alpha = alpha.unsqueeze(1)  # B x 1 x token_dim\\n310:         beta = beta.unsqueeze(1)  # B x 1 x token_dim\\n311: \\n312:         bgu_out = orgs * torch.sigmoid(alpha) + beta\\n313:         return self.norm(orgs + bgu_out)\"\n}\n","exit_code":0,"status":"completed"}}
