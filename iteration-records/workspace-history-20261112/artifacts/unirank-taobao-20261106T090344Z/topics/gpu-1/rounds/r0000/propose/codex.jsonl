{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport ast, json, hashlib, importlib.util\nfrom pathlib import Path\np=json.loads(Path('proposal.json').read_text())\nr=json.loads(Path('runtime.json').read_text())\nassert p['parent_trial'] in r['context']['allowed_observation_ids']\nassert p['study']['protocol_ref']==r['required_study_protocol_ref']\nassert len(p['variants'])==4\nassert len({v['name'] for v in p['variants']})==4\nassert len({v['file'] for v in p['variants']})==4\nassert any(v['role']=='candidate' for v in p['variants'])\nfor v in p['variants']:\n    path=Path(v['file'])\n    assert path.name==v['file'] and path.suffix=='.py'\n    source=path.read_text()\n    tree=ast.parse(source, filename=str(path))\n    compile(source,str(path),'exec')\n    config=next(ast.literal_eval(n.value) for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets))\n    assert config==v['config']\n    model=next(n for n in tree.body if isinstance(n,ast.ClassDef) and n.name=='Model')\n    init=next(n for n in model.body if isinstance(n,ast.FunctionDef) and n.name=='__init__')\n    defaults=dict(zip([a.arg for a in init.args.args][-len(init.args.defaults):],[ast.literal_eval(n) for n in init.args.defaults]))\n    for key,value in config.items(): assert defaults[key]==value\n    for n in ast.walk(tree):\n        if isinstance(n,ast.ImportFrom): assert n.module.split('.')[0] in {'torch','unirank'}\n        if isinstance(n,ast.Import): assert all(x.name.split('.')[0] in {'torch','math'} for x in n.names)\n    print(v['name'], 'syntax/config/API structure OK', hashlib.sha256(source.encode()).hexdigest())\nif importlib.util.find_spec('jsonschema'):\n    import jsonschema\n    jsonschema.validate(p['study'],r['study_schema'])\n    print('Study JSON schema: PASS')\nelse:\n    schema=r['study_schema']\n    assert set(p['study'])==set(schema['required'])\n    pr