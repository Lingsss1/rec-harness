{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport ast, json, hashlib, math\nfrom pathlib import Path\np=json.load(open('proposal.json')); runtime=json.load(open('runtime_context.json'))\n# Validate the supplied study schema using only the installed standard library.\ndef validate(x,s,path='\"'$'\"'):\n typ=s.get('type')\n types={'object':dict,'array':list,'string':str,'boolean':bool}\n if typ: assert isinstance(x,types[typ]),(path,typ)\n if 'const' in s: assert x==s['const'],(path,'const')\n if 'enum' in s: assert x in s['enum'],(path,'enum')\n if isinstance(x,str): assert len(x)>=s.get('minLength',0),path\n if isinstance(x,list):\n  assert len(x)>=s.get('minItems',0),path\n  for i,v in enumerate(x): validate(v,s.get('items',{}),path+f'[{i}]')\n if isinstance(x,dict):\n  assert all(k in x for k in s.get('required',[])),(path,'required')\n  props=s.get('properties',{})\n  if s.get('additionalProperties') is False: assert set(x)<=set(props),(path,'extra')\n  for k,v in x.items():\n   if k in props: validate(v,props[k],path+'.'+k)\nvalidate(p['study'],runtime['study_schema'])\nassert p['study']['protocol_ref']==runtime['required_study_protocol_ref']\nassert set(p['study']['evidence_refs'])<=set(runtime['context']['allowed_observation_ids'])\nassert p['parent_trial'] in runtime['context']['allowed_observation_ids']\nassert 1<=len(p['variants'])<=4\nassert len({v['name'] for v in p['variants']})==len(p['variants'])\nassert len({v['file'] for v in p['variants']})==len(p['variants'])\nallowed={'torch','numpy','math','typing','copy','functools','collections','itertools','dataclasses','contextlib','unirank','model_zoo'}\ntrees=[]\nfor v in p['variants']:\n path=Path(v['file']);assert path.name==v['file'] and path.suffix=='.py'\n source=path.read_text();tree=ast.parse(source,filename=str(path));compile(tree,str(path),'exec')\n for node in ast.walk(tree):\n  if isinstance(node,ast.Import): assert all(n.name.split('.')[0] in allowed for n in node.names)\n  if isinstance(node,ast.ImportFrom): assert node.module.split('.')[0] in allowed\n  if isinstance(node,ast.Call) and isinstance(node.func,ast.Name): assert node.func.id not in {'open','exec','eval','compile','__import__'}\n cfg=next(n for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets))\n assert ast.literal_eval(cfg.value)==v['config']\n sha=hashlib.sha256(path.read_bytes()).hexdigest();assert sha in v['note']\n # All source ASTs must differ only in CONFIG; actual model branches use config.\n tree.body.remove(cfg);trees.append(ast.dump(tree,include_attributes=False))\nassert len(set(trees))==1\n# Confirm accepted ancestor provenance before relying on receipts.\nfor t in runtime['context']['history']:\n name='history_'+t['id'].replace('-','_')+'.py'\n assert hashlib.sha256(Path(name).read_bytes()).hexdigest()==t['source_sha256'],name\nassert hashlib.sha256(Path('baseline_reference.py').read_bytes()).hexdigest()==runtime['context']['history'][0]['source_sha256']\n# Scalar equation checks only: not a torch forward/backward test.\nfor n in (0,1,7,100):\n scores=[math.sin(i) for i in range(n)]\n base=[math.exp(x-max(scores)) for x in scores] if n else []\n weights=[x/sum(base) for x in base]\n for mass in (False,True):\n  scale=math.sqrt(n) if mass else 1\n  actual=sum(w*scale for w in weights)\n  expected=(math.sqrt(n) if mass else 1) if n else 0\n  assert abs(actual-expected)<1e-10\nprint('PASS: study schema, protocol/evidence IDs, four distinct standalone modules, syntax/import boundary, literal configs, source hashes, ancestor provenance, factorial source identity and scalar attention-sum equations.')\nprint('NOT EXECUTED: PyTorch forward/backward, host masking perturbation tests, training, validation or withheld assessment.')\nprint('Artifacts:', ', '.join([v['file'] for v in p['variants']]+['proposal.json']))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
