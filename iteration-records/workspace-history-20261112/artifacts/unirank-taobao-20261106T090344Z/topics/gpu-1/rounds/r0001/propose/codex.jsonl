elf.head_dim).transpose(1, 2) # B x H x Ls x h\\n269: \\n270:         # unified causal attention\\n271:         output, _ = self.dot_attention(\\n272:             q,\\n273:             k,\\n274:             v,\\n275:             scale=self.head_dim ** 0.5,\\n276:         )  # B x H x Lns x h\\n277: \\n278:         # concat heads\\n279:         output = output.transpose(1, 2).contiguous().view(B, Lns, D)\\n280:         output = torch.einsum(\\\"bld,ldh->blh\\\", output, self.W_o)\\n281: \\n282:         return output\\n283: \\n284: \\n285: class MixedFFN(nn.Module):\\n286:     def __init__(self, input_dim, num_ns_token, dnn_activations, expansion_factor=4):\\n287:         super(MixedFFN, self).__init__()\\n288:         hidden_dim = input_dim * expansion_factor\\n289:         self.num_ns_token = num_ns_token\\n290:         self.input_dim = input_dim\\n291:         self.hidden_dim = hidden_dim\\n292:         self.activation = get_activation(dnn_activations)\\n293: \\n294:         # shared FFN for S-tokens\\n295:         self.ffn_s = nn.Sequential(\\n296:             nn.Linear(input_dim, hidden_dim),\\n297:             get_activation(dnn_activations),\\n298:             nn.Linear(hidden_dim, input_dim)\\n299:         )\\n300: \\n301:         # token-specific FFN for NS-tokens using einsum-style parameters\\n302:         self.W1_ns = nn.Parameter(torch.empty(num_ns_token, input_dim, hidden_dim))\\n303:         self.b1_ns = nn.Parameter(torch.zeros(num_ns_token, hidden_dim))\\n304:         self.W2_ns = nn.Parameter(torch.empty(num_ns_token, hidden_dim, input_dim))\\n305:         self.b2_ns = nn.Parameter(torch.zeros(num_ns_token, input_dim))\\n306: \\n307:         self.reset_parameters()\"\n}\n{\n  \"id\": \"g1-r0000-exchange_q1_w1\",\n  \"parent\": \"baseline-din\",\n  \"role\": \"candidate\",\n  \"source_sha256\": \"961679a9ace3b2e134914a57fe615f077483e50fb62ec7385e14e914e78cddc3\",\n  \"config\": {\n    \"embedding_dim\": 16,\n    \"token_dim\": 32,\n    \"refresh_query