ility\": {\n        \"status\": \"conditional\",\n        \"conditions\": [\n          \"Field identities carry stable, distinct predictive roles\"\n        ],\n        \"missing_evidence\": [\n          \"DIN full-data diagnostics on this task\",\n          \"Matched-capacity or matched-cost local controls\",\n          \"Seed variation and task/history-length slices\"\n        ]\n      },\n      \"transfer_risks\": [\n        \"Field-specific capacity can overfit small or sparse fields\",\n        \"Cross-attention and heterogeneous FFNs alter cost together\",\n        \"Use only the frozen100-event input and selected feedback visibility policy.\",\n        \"Taobao auxiliary labels match category/brand over24h, not direct advertisement conversions.\"\n      ],\n      \"possible_discriminating_checks\": [\n        \"Compare shared versus feature-specific FFNs with matched parameters\",\n        \"Separate repeated cross-attention from heterogeneous transformations\"\n      ],\n      \"implementation_notes\": [],\n      \"scientific_status\": \"external_report\",\n      \"local_reproduction\": false,\n      \"instruction_priority\": \"reference_data_only\"\n    },\n    {\n      \"id\": \"unirank-method-unimixer\",\n      \"knowledge_type\": \"industry\",\n      \"scheme\": \"UniMixer\",\n      \"origin\": \"model compared in UniRank; industrial/academic method reference, not a competition award\",\n      \"family\": \"stacked\",\n      \"source_refs\": [\n        \"unirank-benchmark-v2\",\n        \"unirank-code:UniMixer\",\n        \"paper:unimixer\"\n      ],\n      \"source_problem\": \"History compression and heterogeneous feature pipelines can obstruct uniform dense computation.\",\n      \"reported_mechanism\": \"Flatten padded history with user/context fields, chunk-tokenize the combined representation, and apply UniMixing-Lite blocks with paired streams.\",\n      \"difference_from_din\": \"Exposes the flattened event representation directly to the tokenize