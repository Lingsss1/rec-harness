{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc 'python3 /workspace/tools.py read unirank-code:INFNet --start-line 241 --lines 73'","aggregated_output":"/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n{\n  \"id\": \"unirank-code:INFNet\",\n  \"url\": \"https://github.com/salmon1802/UniRank/blob/90bb99a60724e975ec565836266fd86dcad0039d/model_zoo/INFNet.py\",\n  \"version\": \"git:90bb99a60724e975ec565836266fd86dcad0039d\",\n  \"access_scope\": \"Full pinned benchmark source for inspection; not proof of equivalence to the original author method.\",\n  \"text_sha256\": \"e3750a73af1ceb6b2be4bf9355b70a9ad356985a3c465ef27238ef7e0f28fb4c\",\n  \"total_lines\": 313,\n  \"start_line\": 241,\n  \"next_line\": 314,\n  \"truncated\": false,\n  \"text\": \"241:     def forward(self, c_hubs, s_hubs, t_hubs, c_orgs, s_orgs, t_orgs, s_mask=None):\\n242:         K_c, V_c = self.k_proj_c(c_orgs), self.v_proj_c(c_orgs)\\n243:         K_s, V_s = self.k_proj_s(s_orgs), self.v_proj_s(s_orgs)\\n244:         K_t, V_t = self.k_proj_t(t_orgs), self.v_proj_t(t_orgs)\\n245: \\n246:         # Processing sequence Mask broadcast dimensions (B, 1, T)\\n247:         if s_mask is not None:\\n248:             K_s = K_s * s_mask.unsqueeze(-1).float()\\n249:             V_s = V_s * s_mask.unsqueeze(-1).float()\\n250: \\n251:         c_hubs_out = self.c_agg(c_hubs, K_c, V_c, K_s, V_s, K_t, V_t)\\n252:         s_hubs_out = self.s_agg(s_hubs, K_c, V_c, K_s, V_s, K_t, V_t)\\n253:         t_hubs_out = self.t_agg(t_hubs, K_c, V_c, K_s, V_s, K_t, V_t)\\n254: \\n255:         return c_hubs_out, s_hubs_out, t_hubs_out\\n256: \\n257: class HubSpecificAggregator(nn.Module):\\n258:     # Keep SDPA mask-free to preserve FlashAttention eligibility, accepting minor attention leakage.\\n259:     def __init__(self, token_dim):\\n260:         super(HubSpecificAggregator, self).__init__()\\n261:         self.q_proj = nn.Linear(token_dim, token_dim)\\n262:         self.fuse = nn.Linear(token_dim * 3, token_dim)\\n263:         self.norm = nn.LayerNorm(token_dim)\\n264:         self.dot_attention = ScaledDotProductAttention()\\n265: \\n266:     def forward(self, hubs, K_c, V_c, K_s, V_s, K_t, V_t):\\n267:         Q = self.q_proj(hubs)\\n268:         scale = Q.size(-1) ** 0.5\\n269:         Z_c, _ = self.dot_attention(Q, K_c, V_c, scale=scale)\\n270:         Z_s, _ = self.dot_attention(Q, K_s, V_s, scale=scale)\\n271:         Z_t, _ = self.dot_attention(Q, K_t, V_t, scale=scale)\\n272:         Z_fused = self.fuse(torch.cat([Z_c, Z_s, Z_t], dim=-1))\\n273:         return self.norm(hubs + Z_fused)\\n274: \\n275: class Broadcast(nn.Module):\\n276:     \\\"\\\"\\\"Implements Section 3.2.2: Global-to-Local Affine Broadcast\\\"\\\"\\\"\\n277: \\n278:     def __init__(self, token_dim, num_c_hubs, num_s_hubs, num_t_hubs, expansion_factor=4):\\n279:         super(Broadcast, self).__init__()\\n280:         self.c_bgu = BroadcastGatedUnit(token_dim, num_c_hubs, expansion_factor)\\n281:         self.s_bgu = BroadcastGatedUnit(token_dim, num_s_hubs, expansion_factor)\\n282:         self.t_bgu = BroadcastGatedUnit(token_dim, num_t_hubs, expansion_factor)\\n283: \\n284:     def forward(self, c_orgs, s_orgs, t_orgs, c_hubs, s_hubs, t_hubs):\\n285:         c_orgs_out = self.c_bgu(c_orgs, c_hubs)\\n286:         s_orgs_out = self.s_bgu(s_orgs, s_hubs)\\n287:         t_orgs_out = self.t_bgu(t_orgs, t_hubs)\\n288:         return c_orgs_out, s_orgs_out, t_orgs_out\\n289: \\n290: \\n291: class BroadcastGatedUnit(nn.Module):\\n292:     \\\"\\\"\\\"The BGU (Broadcast Gated Unit) mechanism in the paper\\\"\\\"\\\"\\n293: \\n294:     def __init__(self, token_dim, num_hubs, expansion_factor=4):\\n295:         super(BroadcastGatedUnit, self).__init__()\\n296:         self.mlp = nn.Sequential(\\n297:             nn.Linear(num_hubs * token_dim, token_dim * expansion_factor),\\n298:             nn.ReLU(),\\n299:             nn.Linear(token_dim * expansion_factor, token_dim * 2)\\n300:         )\\n301:         self.norm = nn.LayerNorm(token_dim)\\n302: \\n303:     def forward(self, orgs, hubs):\\n304:         B = hubs.size(0)\\n305:         hubs_flat = hubs.view(B, -1)\\n306: \\n307:         hyper_params = self.mlp(hubs_flat)\\n308:         alpha, beta = hyper_params.chunk(2, dim=-1)\\n309:         alpha = alpha.unsqueeze(1)  # B x 1 x token_dim\\n310:         beta = beta.unsqueeze(1)  # B x 1 x token_dim\\n311: \\n312:         bgu_out = orgs * torch.sigmoid(alpha) + beta\\n313:         return self.norm(orgs + bgu_out)\"\n}\n","exit_code":0,"status":"completed"}}
