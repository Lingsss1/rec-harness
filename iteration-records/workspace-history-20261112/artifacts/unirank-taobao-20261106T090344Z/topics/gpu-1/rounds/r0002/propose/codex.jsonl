  continue\\n349:             if feature_source and not_in_whitelist(feature_spec[\\\"source\\\"], feature_source):\\n350:                 continue\\n351:             X_dict[feature] = value.to(self.device)\\n352: \\n353:         for item, value in item_dict.items():\\n354:             item_dict[item] = value.to(self.device)\\n355: \\n356:         mask = mask.to(self.device)\\n357: \\n358:         if not return_multi_masks:\\n359:             return X_dict, item_dict, mask\\n360: \\n361:         if multi_masks is None:\\n362:             multi_masks = [mask for _ in range(self.num_tasks)]\\n363:         else:\\n364:             if isinstance(multi_masks, (list, tuple)):\\n365:                 multi_masks = [m.to(self.device) for m in multi_masks]\\n366:             elif torch.is_tensor(multi_masks):\\n367:                 multi_masks = multi_masks.to(self.device)\\n368:                 if multi_masks.dim() == 3 and multi_masks.size(0) == self.num_tasks:\\n369:                     multi_masks = [multi_masks[i] for i in range(self.num_tasks)]\\n370:                 else:\\n371:                     multi_masks = [multi_masks for _ in range(self.num_tasks)]\\n372:             else:\\n373:                 multi_masks = [mask for _ in range(self.num_tasks)]\\n374:         return X_dict, item_dict, mask, multi_masks\\n375: \\n376:     def get_labels(self, inputs):\\n377:         \\\"\\\"\\\" Please override get_labels() when using multiple labels!\\n378:         \\\"\\\"\\\"\\n379:         labels = self.feature_map.labels\\n380:         y = inputs[labels[0]].to(self.device)\\n381:         return y.float().view(-1, 1)\\n382: \"\n}\n","exit_code":0,"status":"completed"}}
