{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc 'python3 /workspace/tools.py read unirank-code:EST --start-line 198 --lines 85'","aggregated_output":"/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n{\n  \"id\": \"unirank-code:EST\",\n  \"url\": \"https://github.com/salmon1802/UniRank/blob/90bb99a60724e975ec565836266fd86dcad0039d/model_zoo/EST.py\",\n  \"version\": \"git:90bb99a60724e975ec565836266fd86dcad0039d\",\n  \"access_scope\": \"Full pinned benchmark source for inspection; not proof of equivalence to the original author method.\",\n  \"text_sha256\": \"94bb0d53a42c6da8f83012db39fc43fb65a1af2f51ee9dbfd1773185d5f9dd09\",\n  \"total_lines\": 331,\n  \"start_line\": 198,\n  \"next_line\": 283,\n  \"truncated\": false,\n  \"text\": \"198:     def forward(self, s_tokens, ns_tokens, mask=None):\\n199:         for i in range(self.num_layers):\\n200:             if mask is not None:\\n201:                 s_tokens = s_tokens * mask.unsqueeze(-1).float()\\n202: \\n203:             norm_s = self.attention_norms[i](s_tokens)\\n204:             norm_ns = self.attention_norms[i](ns_tokens)\\n205:             ns_tokens = self.lca_layers[i](norm_s, norm_ns, mask) + ns_tokens\\n206: \\n207:             norm_s = self.ffn_norms[i](s_tokens)\\n208:             norm_ns = self.ffn_norms[i](ns_tokens)\\n209:             norm_s, norm_ns = self.ffn_layers[i](norm_s, norm_ns, mask)\\n210:             s_tokens = s_tokens + norm_s\\n211:             ns_tokens = ns_tokens + norm_ns\\n212: \\n213:             if mask is not None:\\n214:                 s_tokens = s_tokens * mask.unsqueeze(-1).float()\\n215: \\n216:         return s_tokens, ns_tokens\\n217: \\n218: \\n219: class LightweightCrossAttention(nn.Module):\\n220:     def __init__(self, input_dim, num_heads, num_ns_token):\\n221:         super(LightweightCrossAttention, self).__init__()\\n222:         assert input_dim % num_heads == 0, \\\\\\n223:             \\\"attention_dim={} is not divisible by num_heads={}\\\".format(input_dim, num_heads)\\n224:         self.input_dim = input_dim\\n225:         self.num_heads = num_heads\\n226:         self.num_ns_token = num_ns_token\\n227:         self.head_dim = input_dim // num_heads\\n228: \\n229:         # shared projections for S-tokens\\n230:         self.W_k_s = nn.Linear(input_dim, input_dim, bias=False)\\n231:         self.W_v_s = nn.Linear(input_dim, input_dim, bias=False)\\n232: \\n233:         # token-specific projections for NS-tokens\\n234:         # shape: [num_ns_token, input_dim, input_dim]\\n235:         self.W_q_ns = nn.Parameter(torch.empty(num_ns_token, input_dim, input_dim))\\n236:         self.W_o = nn.Parameter(torch.empty(num_ns_token, input_dim, input_dim))\\n237:         self.dot_attention = ScaledDotProductAttention()\\n238:         self.reset_parameters()\\n239: \\n240:     def reset_parameters(self):\\n241:         nn.init.xavier_uniform_(self.W_q_ns)\\n242:         nn.init.xavier_uniform_(self.W_o)\\n243: \\n244:     def forward(self, s_tokens, ns_tokens, mask=None):\\n245:         \\\"\\\"\\\"\\n246:         s_tokens:  B x Ls x D\\n247:         ns_tokens: B x Lns x D\\n248:         mask:      B x Ls, 1 for valid positions\\n249:         \\\"\\\"\\\"\\n250:         B, Ls, D = s_tokens.shape\\n251:         _, Lns, _ = ns_tokens.shape\\n252: \\n253:         if mask is not None:\\n254:             s_tokens = s_tokens * mask.unsqueeze(-1).float()\\n255: \\n256:         # shared KV for S-tokens\\n257:         k_s = self.W_k_s(s_tokens)  # B x Ls x D\\n258:         v_s = self.W_v_s(s_tokens)  # B x Ls x D\\n259: \\n260:         # token-specific QKV for NS-tokens using einsum\\n261:         # ns_tokens: B x Lns x D\\n262:         # output:    B x Lns x D\\n263:         q_ns = torch.einsum(\\\"bld,ldh->blh\\\", ns_tokens, self.W_q_ns)\\n264: \\n265:         # split heads\\n266:         q = q_ns.view(B, Lns, self.num_heads, self.head_dim).transpose(1, 2)  # B x H x Lns x h\\n267:         k = k_s.view(B, Ls, self.num_heads, self.head_dim).transpose(1, 2) # B x H x Ls x h\\n268:         v = v_s.view(B, Ls, self.num_heads, self.head_dim).transpose(1, 2) # B x H x Ls x h\\n269: \\n270:         # unified causal attention\\n271:         output, _ = self.dot_attention(\\n272:             q,\\n273:             k,\\n274:             v,\\n275:             scale=self.head_dim ** 0.5,\\n276:         )  # B x H x Lns x h\\n277: \\n278:         # concat heads\\n279:         output = output.transpose(1, 2).contiguous().view(B, Lns, D)\\n280:         output = torch.einsum(\\\"bld,ldh->blh\\\", output, self.W_o)\\n281: \\n282:         return output\"\n}\n","exit_code":0,"status":"completed"}}
