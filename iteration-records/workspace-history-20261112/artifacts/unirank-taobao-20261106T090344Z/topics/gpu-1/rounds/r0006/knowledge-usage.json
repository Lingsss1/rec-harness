      "evidence_class": "agent-declared usage; not mechanism confirmation"
    },
    {
      "knowledge_id": "unirank-method-est",
      "decision": "rejected",
      "rationale": "Cross-attention and feature-specific FFNs would introduce new operators and confound this initial capacity attribution. The local evidence identifies parameter/cost uncertainty, not a demonstrated need for repeated retrieval. Rejection applies to this study only; no negative transfer was measured.",
      "transformed_mechanism": "None adopted: no iterative cross-attention or feature-specific FFNs.",
      "variant_names": [],
      "nearest_work_difference": "This source uses fixed compressed DIN readout and four towers; the EST card describes cross-attention plus feature-specific FFNs. Original EST full-paper audit is unavailable, so no broader claim is made.",
      "falsifier": "If simple reductions cannot retain quality, a later retrieval/interaction replacement with matched capacity and cost could test whether a different allocation is useful.",
