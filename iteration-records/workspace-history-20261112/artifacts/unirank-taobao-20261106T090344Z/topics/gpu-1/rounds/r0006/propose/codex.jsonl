ec','__import__'}\n    if v['file']\"'!='\"'source_control.py':\n        norm=copy.deepcopy(cls)\n        ni=next(n for n in norm.body if isinstance(n,ast.FunctionDef) and n.name=='__init__')\n        ni.args.defaults=[]\n        normalized_classes.append(ast.dump(norm,include_attributes=False))\n    print(v['name']+': syntax, CONFIG/defaults, unchanged numerical methods and import boundaries passed; SHA256 '+hashlib.sha256(src.encode()).hexdigest())\nassert len(set(normalized_classes))==1\nassert {(v['config']['embedding_dim'],tuple(v['config']['attention_hidden_units']),tuple(v['config']['tower_hidden_units'])) for v in p['variants']}=={(e,a,t) for e in (16,8) for a,t in [((64,32),(128,64)),((32,16),(64,32))]}\nassert {x['knowledge_id'] for x in p['knowledge_assessments']} >= {'unirank-method-zenith','unirank-method-est'}\np['preparation']['static_validation']={\n    'status':'passed',\n    'checks':['Study conforms to the runtime-resolved study schema; protocol and parent IDs match.', 'Four distinct standalone modules form the full declared 2x2; all literal CONFIG values match constructor defaults.', 'source_control.py byte-identical to accepted source hash; original read-only sources not edited.', 'Every numerical method outside constructor AST-identical to the accepted source; reduced cells have identical class AST after constructor-default normalization.', 'Candidate imports restricted to copy, torch and unirank; no model file/network access or training calls added.', 'Knowledge assessments cover both retrieved industry cards.'],\n    'not_run':['torch import/instantiation','forward/backward and gradient audits','actual FeatureMap width and sharing audit','masking and Dice buffer checks','training','validation or held-out scoring','parameter-count or latency measurement'],\n    'host_required':'All numerical and empirical gates remain pending. Static checks are not evidence of retention, speedup, gradient correctness or causal mechanism support.'\n}\n(root/'pr