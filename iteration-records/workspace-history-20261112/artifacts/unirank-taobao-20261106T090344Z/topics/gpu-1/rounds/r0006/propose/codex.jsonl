d emb\\n30:         self.dataset_id = dataset_id\\n31:         self.num_fields = 0\\n32:         self.total_features = 0\\n33:         self.input_length = 0\\n34:         self.features = OrderedDict()\\n35:         self.labels = []\\n36:         self.column_index = dict()\\n37:         self.group_id = None\\n38:         self.default_emb_dim = None\\n39: \\n40:     def load(self, json_file, params):\\n41:         logging.info(\\\"Load feature_map from json: \\\" + json_file)\\n42:         with io.open(json_file, \\\"r\\\", encoding=\\\"utf-8\\\") as fd:\\n43:             feature_map = json.load(fd) #, object_pairs_hook=OrderedDict\\n44:         if feature_map[\\\"dataset_id\\\"] != self.dataset_id:\\n45:             raise RuntimeError(\\\"dataset_id={} does not match feature_map!\\\".format(self.dataset_id))\\n46:         self.labels = feature_map.get(\\\"labels\\\", [])\\n47:         self.total_features = feature_map.get(\\\"total_features\\\", 0)\\n48:         self.input_length = feature_map.get(\\\"input_length\\\", 0)\\n49:         self.group_id = params.get(\\\"group_id\\\", None)\\n50:         self.default_emb_dim = params.get(\\\"embedding_dim\\\", None)\\n51:         self.features = OrderedDict((k, v) for x in feature_map[\\\"features\\\"] for k, v in x.items())\\n52:         self.num_fields = self.get_num_fields()\\n53:         if params.get(\\\"use_features\\\", None):\\n54:             self.features = OrderedDict((x, self.features[x]) for x in params[\\\"use_features\\\"])\\n55:         if params.get(\\\"feature_specs\\\", None):\\n56:             self.update_feature_specs(params[\\\"feature_specs\\\"])\\n57:         self.set_column_index()\\n58: \\n59:     def update_feature_specs(self, feature_specs):\\n60:         for col in feature_specs:\\n61:             namelist = col[\\\"name\\\"]\\n62:             if type(namelist) != list:\\n63:                 namelist = [namelist]\\n64:             for name in namelist:\\n65:                 for k, v in col.items():\\n66:                     if k != \\\"name\\\":\\n67:                         self.features[name][k] = v\\n68: \\n69:     def save(self, json_file):\\n70:         logging.info(\\\"Save feature_map to json: \\\" + json_file)\\n71:         os.makedirs(os.path.dirname(json_file), exist_ok=True)\\n72:         feature_map = OrderedDict()\\n73:         feature_map[\\\"dataset_id\\\"] = self.dataset_id\\n74:         feature_map[\\\"num_fields\\\"] = self.num_fields\\n75:         feature_map[\\\"total_features\\\"] = self.total_features\\n76:         feature_map[\\\"input_length\\\"] = self.input_length\\n77:         feature_map[\\\"labels\\\"] = self.labels\\n78:         feature_map[\\\"features\\\"] = [{k: v} for k, v in self.features.items()]\\n79:         with open(json_file, \\\"w\\\") as fd:\\n80:             json.dump(feature_map, fd, indent=4)\\n81: \\n82:     def get_num_fields(self, feature_source=[]):\\n83:         if type(feature_source) != list:\\n84:             feature_source = [feature_source]\\n85:         num_fields = 0\\n86:         for feature, feature_spec in self.features.items():\\n87:             if feature_spec[\\\"type\\\"] == \\\"meta\\\":\\n88:                 continue\\n89:             if len(feature_source) == 0 or feature_spec.get(\\\"source\\\") in feature_source:\\n90:                 num_fields += 1\\n91:         return num_fields\\n92: \\n93:     def sum_emb_out_dim(self, feature_source=[]):\\n94:         if type(feature_source) != list:\\n95:             feature_source = [feature_source]\\n96:         total_dim = 0\\n97:         for feature, feature_spec in self.features.items():\\n98:             if feature_spec[\\\"type\\\"] == \\\"meta\\\":\\n99:                 continue\\n100:             if len(feature_source) == 0 or feature_spec.get(\\\"source\\\") in feature_source:\\n101:                 total_dim += feature_spec.get(\\\"emb_output_dim\\\",\\n102:                                               feature_spec.get(\\\"embedding_dim\\\", \\n103:                                                                self.default_emb_dim))\\n104:         return total_dim\\n105: \\n106:     def set_column_index(self):\\n107:         logging.info(\\\"Set column index...\\\")\\n108:         idx = 0\\n109:         for feature, feature_spec in self.features.items():\\n110:             if \\\"max_len\\\" in feature_spec:\\n111:                 col_indexes = [i + idx for i in range(feature_spec[\\\"max_len\\\"])]\\n112:                 self.column_index[feature] = col_indexes\\n113:                 idx += feature_spec[\\\"max_len\\\"]\\n114:             else:\\n115:                 self.column_index[feature] = idx\\n116:                 idx += 1\\n117:         self.input_length = idx\\n118:         for label in self.labels:\\n119:             self.column_index[label] = idx\\n120:             idx += 1\\n121: \\n122:     def get_column_index(self, feature):\\n123:         if feature not in self.column_index:\\n124:             self.set_column_index()\\n125:         return self.column_index[feature]\\n126: \\n127:         \"\n}\n","exit_code":0,"status":"completed"}}
