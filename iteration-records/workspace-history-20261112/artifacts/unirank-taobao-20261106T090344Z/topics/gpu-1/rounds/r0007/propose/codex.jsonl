{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport ast, hashlib, json\nfrom pathlib import Path\np=Path('proposal.json'); proposal=json.loads(p.read_text()); runtime=json.load(open('runtime_resolved.json'))\ndef check(v,s,path):\n t=s.get('type')\n types={'object':dict,'array':list,'string':str,'boolean':bool}\n if t in types: assert isinstance(v,types[t]),(path,t)\n if 'const' in s: assert v==s['const'],path\n if 'enum' in s: assert v in s['enum'],path\n if isinstance(v,str): assert len(v)>=s.get('minLength',0),path\n if isinstance(v,list):\n  assert len(v)>=s.get('minItems',0),path\n  for i,x in enumerate(v): check(x,s.get('items',{}),f'{path}[{i}]')\n if isinstance(v,dict):\n  assert set(s.get('required',[]))<=v.keys(),path\n  props=s.get('properties',{})\n  if s.get('additionalProperties') is False: assert not v.keys()-props.keys(),path\n  for k,x in v.items():\n   if k in props: check(x,props[k],path+'.'+k)\ncheck(proposal['study'],runtime['study_schema'],'study')\nassert proposal['study']['protocol_ref']==runtime['required_study_protocol_ref']\nassert proposal['parent_trial'] in runtime['context']['allowed_observation_ids']\nassert set(proposal['study']['evidence_refs'])<=set(runtime['context']['allowed_observation_ids'])\nvariants=proposal['variants']; assert 1<=len(variants)<=4\nassert len({v['name'] for v in variants})==len(variants)\nassert any(v['role']=='candidate' for v in variants)\nsource=ast.parse(Path('candidate.py').read_text()); base_class=next(n for n in source.body if isinstance(n,ast.ClassDef))\nbase_methods={n.name:ast.dump(n,include_attributes=False) for n in base_class.body if isinstance(n,ast.FunctionDef)}\nchecks=[]\nfor v in variants:\n f=Path(v['file']); assert f.name==v['file'] and f.suffix=='.py'\n text=f.read_text(); tree=ast.parse(text); compile(text,str(f),'exec')\n cfg=next(ast.literal_eval(n.value) for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets))\n assert cfg==v['config'],f\n cls=next(n for n in tree.body if isinstance(n,ast.ClassDef) and n.name=='Model')\n methods={n.name:n for n in cls.body if isinstance(n,ast.FunctionDef)}\n for name in ['_represent','_compress_both','_interactions','_auxiliary_activation','_pool']:\n  assert ast.dump(methods[name],include_attributes=False)==base_methods[name],(f,name)\n sig=methods['__init__'].args\n defaults=dict(zip([a.arg for a in sig.args][-len(sig.defaults):],sig.defaults))\n for key in cfg:\n  if key in defaults:\n   expected=ast.literal_eval(defaults[key]); assert expected==cfg[key] or isinstance(expected,tuple) and list(expected)==cfg[key],(f,key)\n for n in ast.walk(tree):\n  if isinstance(n,ast.Import): assert all(a.name.split('.')[0] in {'math','torch'} for a in n.names)\n  if isinstance(n,ast.ImportFrom): assert n.module.split('.')[0] in {'torch','unirank'}\n  if isinstance(n,ast.Call) and isinstance(n.func,ast.Name): assert n.func.id not in {'open','exec','eval','__import__'}\n digest=hashlib.sha256(text.encode()).hexdigest(); v['source_sha256']=digest\n checks.append({'file':str(f),'sha256':digest,'config_match':True,'source_methods_preserved':True})\nexpected={'candidate.py':'34b3524b7998610f609b7c73a5c454cbe3c4d0d9f9a16370de99d00b1c8231a2','baseline_reference.py':'f4b473cbacf60d72cff90f3721ad754dd617ee6065fe3fca2fc9cd4be2b25c36'}\nfor file,digest in expected.items(): assert hashlib.sha256(Path(file).read_bytes()).hexdigest()==digest,file\nproposal['local_validation']['source_hashes_verified']=expected\nproposal['local_validation']['variant_checks']=checks\nproposal['local_validation']['study_schema']='Passed recursive validation against the resolved runtime study_schema, including required keys, types, additionalProperties, enum and const constraints.'\nproposal['local_validation']['checks'].append('Source _represent, _compress_both, _interactions, _auxiliary_activation and _pool are AST-identical to imported source; original source/baseline hashes verified')\np.write_text(json.dumps(proposal,indent=2)+'\\\\n')\nprint(json.dumps({'study_schema':'passed','variant_checks':checks,'original_hashes':'verified','training':'not run'},indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
