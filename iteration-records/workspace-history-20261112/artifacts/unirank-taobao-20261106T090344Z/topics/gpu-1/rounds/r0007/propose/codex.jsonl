s import defaultdict, OrderedDict\\n29: \\n30: \\n31: class MultiTaskModel(BaseModel):\\n32:     def __init__(self,\\n33:                  feature_map,\\n34:                  model_id=\\\"MultiTaskModel\\\",\\n35:                  task=[\\\"binary_classification\\\"],\\n36:                  num_tasks=1,\\n37:                  loss_weight='EQ',\\n38:                  gpu=-1,\\n39:                  monitor=\\\"AUC\\\",\\n40:                  save_best_only=True,\\n41:                  monitor_mode=\\\"max\\\",\\n42:                  early_stop_patience=2,\\n43:                  eval_steps=None,\\n44:                  reduce_lr_on_plateau=True,\\n45:                  **kwargs):\\n46:         super(MultiTaskModel, self).__init__(feature_map=feature_map,\\n47:                                              model_id=model_id,\\n48:                                              task=\\\"binary_classification\\\",\\n49:                                              gpu=gpu,\\n50:                                              loss_weight=loss_weight,\\n51:                                              monitor=monitor,\\n52:                                              save_best_only=save_best_only,\\n53:                                              monitor_mode=monitor_mode,\\n54:                                              early_stop_patience=early_stop_patience,\\n55:                                              eval_steps=eval_steps,\\n56:                                              reduce_lr_on_plateau=reduce_lr_on_plateau,\\n57:                                              **kwargs)\\n58:         self.device = get_device(gpu)\\n59:         self.num_tasks = num_tasks\\n60:         self.loss_weight = loss_weight\\n61:         if isinstance(task, list):\\n62:             assert len(task) == num_tasks, \\\"the number of tasks must equal the length of \\\\\\\"task\\\\\\\"\\\"\\n63:             self.output_activation = nn.ModuleList([self.get_output_activation(str(t)) for t in task])\\n64:         else:\\n65:             self.output_activation = nn.ModuleList(\\n66:                 [self.get_output_activation(task) for _ in range(num_tasks)]\\n67:             )\\n68: \\n69:     def compile(self, optimizer, loss, lr):\\n70:         self._compile_optimizers(optimizer, lr)\\n71:         if isinstance(loss, list):\\n72:             self.loss_fn = [get_loss(l) for l in loss]\\n73:         else:\\n74:             self.loss_fn = [get_loss(loss) for _ in range(self.num_tasks)]\\n75:         self._maybe_enable_torch_compile()\\n76: \\n77:     def get_labels(self, inputs):\\n78:         \\\"\\\"\\\" Override get_labels() to use multiple labels \\\"\\\"\\\"\\n79:         labels = self.feature_map.labels\\n80:         batch_dict = inputs[0]\\n81:         y = [batch_dict[label].to(self.device).float().view(-1, 1)\\n82:              for label in labels]\\n83:         return y\\n84: \\n85:     def add_loss(self, return_dict, y_true):\\n86:         labels = self.feature_map.labels\\n87:         loss = [self.loss_fn[i](return_dict[\\\"{}_pred\\\".format(labels[i])], y_true[i], reduction='mean')\\n88:                 for i in range(len(labels))]\\n89:         if self.loss_weight == 'EQ':\\n90:             # Default: All losses are weighted equally\\n91:             loss = torch.sum(torch.stack(loss))\\n92:         return loss\\n93: \\n94:     def compute_loss(self, return_dict, y_true):\\n95:         return self.add_loss(return_dict, y_true)\\n96: \\n97:     def evaluate(self, data_generator, metrics=None):\\n98:         self.eval()  # set to evaluation mode\\n99:         with torch.no_grad():\\n100:             raw_generator = data_generator\\n101:             y_pred_all = defaultdict(list)\\n102:             y_true_all = defaultdict(list)\\n103:             labels = self.feature_map.labels\\n104:             group_id = []\\n105:             if self._verbose > 0:\\n106:                 data_generator = tqdm(\\n107:                     data_generator,\\n108:                     disable=False,\\n109:                     file=sys.stdout,\\n110:                     desc=f\\\"Rank {self.rank} | Eval\\\",\\n111:                     position=self.rank,\\n112:                     leave=(self.rank == 0),\\n113:                     dynamic_ncols=True\\n114:                 )\\n115: \\n116:             amp_ctx = self._get_amp_context()\\n117:             with amp_ctx:\\n118:                 for batch_data in data_generator:\\n119:                     return_dict = self.forward(batch_data)\\n120:                     batch_y_true = self.get_labels(batch_data)\\n121:                     for i in range(len(labels)):\\n122:                         y_pred_all[labels[i]].extend(\\n123:                             return_dict[\\\"{}_pred\\\".format(labels[i])].float().data.cpu().numpy().reshape(-1))\\n124:                         y_true_all[labels[i]].extend(batch_y_true[i].data.cpu().numpy().reshape(-1))\\n125:                     if self.feature_map.group_id is not None:\\n126:                         group_id.extend(self.get_group_id(batch_data).numpy().reshape(-1))\\n127: \\n128:             all_val_logs = {}\\n129:             mean_val_logs = defaultdict(list)\\n130:             group_id = np.array(group_id) if len(group_id) > 0 else None\\n131: \\n132:             # ---- Distributed consistency check: All ranks must agree on \\\"whether to perform distributed evaluation aggregation\\\" ----\\n133:             _distributed_eval = False\\n134:             _is_sampler_distributed_eval = False\\n135:             _is_blocked_distributed_eval = False\\n136:             total_samples = None\\n137: \\n138:             if self._is_distributed():\\n139:                 _is_sampler_distributed_eval = bool(\\n140:                     hasattr(raw_generator, \\\"sampler\\\")\\n141:                     and isinstance(raw_generator.sampler, DistributedSampler)\\n142:                 )\\n143: \\n144:                 _is_blocked_distributed_eval = bool(\\n145:                     getattr(raw_generator, \\\"blocked\\\", False)\\n146:                     and hasattr(raw_generator, \\\"dataset\\\")\\n147:                     and getattr(raw_generator.dataset, \\\"distributed\\\", False)\\n148:                 )\\n149: \\n150:                 local_flag = int(_is_sampler_distributed_eval or _is_blocked_distributed_eval)\\n151:                 flag_t = torch.tensor([local_flag], dtype=torch.int32, device=self.device)\\n152:                 gathered_flags = [torch.zeros_like(flag_t) for _ in range(self.world_size)]\\n153:                 dist.all_gather(gathered_flags, flag_t)\\n154:                 flags = [int(x.item()) for x in gathered_flags]\\n155: \\n156:                 if len(set(flags)) != 1:\\n157:                     raise RuntimeError(\\n158:                         f\\\"[Rank {self.rank}] Inconsistent distributed-eval flags across ranks: {flags}. \\\"\\n159:                         \\\"This can cause a collective deadlock. Please ensure that the validation DataLoader configuration of each rank is consistent.\\\"\\n160:                     )\"\n}\n","exit_code":0,"status":"completed"}}
