{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport ast, copy, hashlib, importlib.util, json\nfrom pathlib import Path\nfrom types import SimpleNamespace\nroot=Path('/workspace')\np=json.loads((root/'proposal.json').read_text())\nr=json.load(open('/tmp/r001-public.json'))\nassert p['study']['protocol_ref']==r['required_study_protocol_ref']\nassert set(p['study']['evidence_refs']) <= set(r['context']['allowed_observation_ids'])\nassert p['parent_trial'] in r['context']['allowed_observation_ids']\nif importlib.util.find_spec('jsonschema'):\n import jsonschema\n jsonschema.validate(p['study'],r['study_schema'])\n print('Study validated against runtime JSON Schema.')\nelse:\n def validate(obj,schema):\n  typ=schema.get('type')\n  assert typ is None or {'object':isinstance(obj,dict),'array':isinstance(obj,list),'string':isinstance(obj,str)}[typ]\n  if typ=='object':\n   assert set(schema.get('required',[]))<=set(obj)\n   if schema.get('additionalProperties') is False: assert set(obj)<=set(schema['properties'])\n   for k,v in obj.items():\n    if k in schema.get('properties',{}): validate(v,schema['properties'][k])\n  elif typ=='array':\n   assert len(obj)>=schema.get('minItems',0)\n   for v in obj: validate(v,schema['items'])\n  elif typ=='string': assert len(obj)>=schema.get('minLength',0)\n  if 'enum' in schema: assert obj in schema['enum']\n  if 'const' in schema: assert obj==schema['const']\n validate(p['study'],r['study_schema'])\n print('Study validated with recursive runtime-schema checks (jsonschema unavailable).')\nancestor_tree=ast.parse((root/'history_g1_r0013_id8_attr8.py').read_text())\nancestor_cls=next(n for n in ancestor_tree.body if isinstance(n,ast.ClassDef))\nancestor_methods={n.name:ast.dump(n) for n in ancestor_cls.body if isinstance(n,ast.FunctionDef) and n.name\"'!='\"'__init__'}\nallowed={'copy','torch','unirank'}\nseen_files=set(); seen_names=set()\nfor v in p['variants']:\n assert v['file']==Path(v['file']).name and v['file'].endswith('.py')\n assert v['file'] not in seen_files and v['name'] not in seen_names\n seen_files.add(v['file']);seen_names.add(v['name'])\n src=(root/v['file']).read_text();tree=ast.parse(src);compile(tree,v['file'],'exec')\n for n in ast.walk(tree):\n  if isinstance(n,ast.Import): assert all(x.name.split('.')[0] in allowed for x in n.names)\n  if isinstance(n,ast.ImportFrom): assert n.module.split('.')[0] in allowed\n  if isinstance(n,ast.Call) and isinstance(n.func,ast.Name): assert n.func.id not in {'open','eval','exec','compile','__import__'}\n cfg=next(ast.literal_eval(n.value) for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets))\n assert cfg==v['config']\n cls=next(n for n in tree.body if isinstance(n,ast.ClassDef))\n methods={n.name:ast.dump(n) for n in cls.body if isinstance(n,ast.FunctionDef) and n.name\"'!='\"'__init__'}\n assert methods==ancestor_methods\n helper=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='_capacity_layout')\n ns={'copy':copy}\n exec(compile(ast.Module(body=[helper],type_ignores=[]),'<metadata helper>','exec'),ns)\n layout=ns['_capacity_layout']\n fields={\n  'context':{'source':'user','type':'categorical','vocab_size':100},\n  'item_id':{'source':'item','type':'categorical','vocab_size':200},\n  'cate_id':{'source':'item','type':'categorical','vocab_size':30},\n  'brand':{'source':'item','type':'categorical','vocab_size':40},\n  'action':{'source':'action','type':'categorical','vocab_size':6},\n  'metadata':{'source':'item','type':'meta'}}\n fm=SimpleNamespace(features=copy.deepcopy(fields),labels=['is_click','cart','fav','buy'])\n iw=cfg['item_embedding_dim'];aw=cfg['action_embedding_dim']\n local,widths=layout(fm,iw,aw)\n assert fm.features==fields and local is not fm and local.features is not fm.features\n assert widths=={'context':16,'item_id':iw,'cate_id':iw,'brand':iw,'action':aw}\n assert 'embedding_dim' not in local.features['metadata']\n # Ordered aliases including chains follow the actual upstream ownership rule.\n aliases=copy.deepcopy(fields)\n aliases['brand']['share_embedding']='cate_id'\n aliases['action']['share_embedding']='brand'\n aliased=SimpleNamespace(features=aliases)\n before=copy.deepcopy(aliases)\n _,actual=layout(aliased,iw,aw)\n assert actual['cate_id']==actual['brand']==actual['action']==max(iw,aw)\n assert aliased.features==before\n # Cross-source context alias is protected rather than silently narrowed.\n aliases['item_id']['share_embedding']='context'\n _,actual=layout(SimpleNamespace(features=aliases),iw,aw)\n assert actual['context']==actual['item_id']==16\n # Unsupported encoded/pretrained/numeric features fail before module construction.\n for bad in [{'type':'numeric'},{'feature_encoder':'arbitrary'},{'pretrained_emb':'forbidden'}]:\n  invalid=copy.deepcopy(fields);invalid['context'].update(bad)\n  try: layout(SimpleNamespace(features=invalid),iw,aw)\n  except ValueError: pass\n  else: raise AssertionError('unsupported feature was not rejected')\n for invalid_width in [0,4,12,32]:\n  try:layout(fm,invalid_width,aw)\n  except ValueError:pass\n  else:raise AssertionError('invalid width accepted')\n # Native widths implied by six frozen item fields and context16: scorer/tower inputs.\n print(v['name'], 'syntax/import/CONFIG/forward-AST/layout/alias/nonmutation checks PASS', 'sha256='+hashlib.sha256(src.encode()).hexdigest())\n assert all(k not in cfg for k in ['train_seed','epochs','batch_size','learning_rate','history_limit'])\nassert len(p['variants'])==4 and any(v['role']=='candidate' for v in p['variants'])\nprint('All static checks passed. No torch import, model execution, training or scoring performed.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
