from collections import defaultdict, OrderedDict\\n29: \\n30: \\n31: class MultiTaskModel(BaseModel):\\n32:     def __init__(self,\\n33:                  feature_map,\\n34:                  model_id=\\\"MultiTaskModel\\\",\\n35:                  task=[\\\"binary_classification\\\"],\\n36:                  num_tasks=1,\\n37:                  loss_weight='EQ',\\n38:                  gpu=-1,\\n39:                  monitor=\\\"AUC\\\",\\n40:                  save_best_only=True,\\n41:                  monitor_mode=\\\"max\\\",\\n42:                  early_stop_patience=2,\\n43:                  eval_steps=None,\\n44:                  reduce_lr_on_plateau=True,\\n45:                  **kwargs):\\n46:         super(MultiTaskModel, self).__init__(feature_map=feature_map,\\n47:                                              model_id=model_id,\\n48:                                              task=\\\"binary_classification\\\",\\n49:                                              gpu=gpu,\\n50:                                              loss_weight=loss_weight,\\n51:                                              monitor=monitor,\\n52:                                              save_best_only=save_best_only,\\n53:                                              monitor_mode=monitor_mode,\\n54:                                              early_stop_patience=early_stop_patience,\\n55:                                              eval_steps=eval_steps,\\n56:                                              reduce_lr_on_plateau=reduce_lr_on_plateau,\\n57:                                              **kwargs)\\n58:         self.device = get_device(gpu)\\n59:         self.num_tasks = num_tasks\\n60:         self.loss_weight = loss_weight\\n61:         if isinstance(task, list):\\n62:             assert len(task) == num_tasks, \\\"the number of tasks must equal the length of \\\\\\\"task\\\\\\\"\\\"\\n63:             self.output_activation = nn.ModuleList([self.get_output_activation(str(