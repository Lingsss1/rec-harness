nerator,\\n108:                     disable=False,\\n109:                     file=sys.stdout,\\n110:                     desc=f\\\"Rank {self.rank} | Eval\\\",\\n111:                     position=self.rank,\\n112:                     leave=(self.rank == 0),\\n113:                     dynamic_ncols=True\\n114:                 )\\n115: \\n116:             amp_ctx = self._get_amp_context()\\n117:             with amp_ctx:\\n118:                 for batch_data in data_generator:\\n119:                     return_dict = self.forward(batch_data)\\n120:                     batch_y_true = self.get_labels(batch_data)\"\n}\n","exit_code":0,"status":"completed"}}
