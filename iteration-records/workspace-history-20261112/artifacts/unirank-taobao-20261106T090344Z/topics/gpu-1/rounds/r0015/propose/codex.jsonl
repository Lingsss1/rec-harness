{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"python3 /workspace/tools.py read framework:unirank/pytorch/models/rank_model.py --find 'reset_parameters' --lines 90\"","aggregated_output":"/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n{\n  \"id\": null,\n  \"url\": null,\n  \"version\": \"90bb99a60724e975ec565836266fd86dcad0039d\",\n  \"access_scope\": null,\n  \"text_sha256\": \"c729cd9d20b22a4a2f0120325ddff9a1528206519f514e5e02387e6b1b3dfb9f\",\n  \"total_lines\": 890,\n  \"start_line\": 307,\n  \"next_line\": 397,\n  \"truncated\": false,\n  \"text\": \"307:         return self.add_loss(return_dict, y_true)\\n308: \\n309:     def reset_parameters(self):\\n310:         def default_reset_params(m):\\n311:             # initialize nn.Linear/nn.Conv1d layers by default\\n312:             if type(m) in [nn.Linear, nn.Conv1d]:\\n313:                 nn.init.xavier_normal_(m.weight)\\n314:                 if m.bias is not None:\\n315:                     m.bias.data.fill_(0)\\n316: \\n317:         def custom_reset_params(m):\\n318:             # initialize layers with customized init_weights()\\n319:             if hasattr(m, 'init_weights'):\\n320:                 m.init_weights()\\n321: \\n322:         self.apply(default_reset_params)\\n323:         self.apply(custom_reset_params)\\n324: \\n325:     def get_inputs(self, inputs, feature_source=None, return_multi_masks=False):\\n326:         \\\"\\\"\\\"\\n327:         Args:\\n328:             inputs: (batch_dict, item_dict, mask) or (batch_dict, item_dict, mask, multi_masks)\\n329:             feature_source: optional feature source filtering\\n330:             return_multi_masks: bool, default False\\n331:                 - False: Return (X_dict, item_dict, mask)\\n332:                 - True : Returns (X_dict, item_dict, mask, multi_masks)\\n333:         \\\"\\\"\\\"\\n