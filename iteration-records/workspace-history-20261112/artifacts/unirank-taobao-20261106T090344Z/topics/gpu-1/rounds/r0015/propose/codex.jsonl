{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport ast\nsource=Path('history_g1_r0014_item16_action16_control.py').read_text()\nsource=source[source.index('import copy'):]\nnode=next(n for n in ast.parse(source).body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets))\nlines=source.splitlines(keepends=True)\nsource=''.join(lines[:node.lineno-1]+lines[node.end_lineno:])\nsource=source.replace('class Model(MultiTaskModel):','class _NativeModel(MultiTaskModel):',1)\nheader='''\\\"\\\"\\\"Prospective item/action capacity factorial with source-coupled initialization.\n\nThe native operator is inherited without forward changes. Each model starts\nfrom an untrained full16 CPU reference drawn using the host RNG state; all\nretained field coordinates, dense input columns, hidden parameters and buffers\nare copied exactly. The temporary reference is never registered or trained.\nReduced construction is inside a CPU RNG fork, so the final CPU RNG state is\nthat of one full16 source construction in every cell. No seed is changed.\n\nThis is an initialization-confound diagnostic, not a new architecture claim.\nIt removes shape-driven reassignment of shared random draws, but not capacity,\nfan-in variance, optimization or functional differences from omitted columns.\nStatic preparation only; numerical and measured cost gates remain host-owned.\n\\\"\\\"\\\"\n'''\naddon='''\n\ndef _source_columns(item_field_count, context_field_count, item_width, action_width):\n    \\\"\\\"\\\"Map native input coordinates to semantic full16 field/block positions.\\\"\\\"\\\"\n    if item_width not in (8, 16) or action_width not in (8, 16):\n        raise ValueError('Factor widths must be eight or sixteen')\n    if item_field_count <= 0 or context_field_count < 0:\n        raise ValueError('Invalid supplied field counts')\n    full_key = 16 * item_field_count\n    full_context = 16 * context_field_count\n    key_columns = [16 * field + coordinate\n                   for field in range(item_field_count)\n                   for coordinate in range(item_width)]\n    scorer_columns = [block * full_key + column\n                      for block in range(4) for column in key_columns]\n    scorer_columns += [4 * full_key + coordinate for coordinate in range(action_width)]\n    tower_columns = list(range(full_context))\n    tower_columns += [full_context + column for column in key_columns]\n    tower_columns += [full_context + full_key + column for column in key_columns]\n    tower_columns += [full_context + 2 * full_key + coordinate\n                      for coordinate in range(action_width)]\n    return scorer_columns, tower_columns\n\n\nclass Model(_NativeModel):\n    def __init__(self, feature_map, model_id='SourceCoupledCapacity', gpu=-1,\n                 item_embedding_dim=8, action_embedding_dim=8, **kwargs):\n        # This scratch reference receives no data or checkpoint. It is drawn\n        # at the incoming host RNG state with the original full-width recipe.\n        # Native construction uses only CPU random initialization; moving a\n        # model to its assigned device does not initialize new parameters.\n        reference = _NativeModel(\n            feature_map, model_id=model_id, gpu=-1,\n            item_embedding_dim=16, action_embedding_dim=16, **kwargs)\n        # Preserve the reference's ending CPU RNG state, including for any\n        # later host sampler. Do not reseed or touch the GPU RNG stream.\n        with torch.random.fork_rng(devices=[]):\n            super().__init__(\n                feature_map, model_id=model_id, gpu=gpu,\n                item_embedding_dim=item_embedding_dim,\n                action_embedding_dim=action_embedding_dim, **kwargs)\n        self._copy_source_initialization(reference)\n        # No scratch tensors become model state or optimizer parameters.\n        del reference\n\n    def _copy_source_initialization(self, reference):\n        scorer_columns, tower_columns = _source_columns(\n            len(self.item_fields), len(self.user_fields),\n            self.table_widths[self.item_fields[0]], self.action_width)\n        source_state = reference.state_dict()\n        target_state = self.state_dict()\n        if set(source_state) \"'!= set(target_state):\n            raise ValueError('\"'Source and candidate state names differ')\n        tower_inputs = {'towers.' + str(index) + '.0.weight'\n                        for index in range(self.num_tasks)}\n        with torch.no_grad():\n            for name, target in target_state.items():\n                value = source_state[name]\n                if name.startswith('embedding_layer.embedding_layers.') and name.endswith('.weight'):\n                    if value.ndim \"'!= 2 or target.ndim != 2:\n                        raise ValueError('\"'Expected categorical embedding matrices')\n                    value = value[:, :target.shape[1]]\n                elif name == 'local_activation.0.weight':\n                    value = value[:, scorer_columns]\n                elif name in tower_inputs:\n                    value = value[:, tower_columns]\n                if value.shape \"'!= target.shape:\n                    raise ValueError('\"'Unmapped source tensor shape: ' + name)\n                target.copy_(value)\n'''\nbase_config={'embedding_dim':16,'attention_hidden_units':[64,32],'tower_hidden_units':[128,64],'attention_normalization':'none','compression_routes':'uf','block_aux_scorer_grad':True,'block_aux_context_grad':False,'block_aux_item_grad':True}\nvariants=[('coupled_item8_action8','candidate.py',8,8),('coupled_item16_action8','coupled_item16_action8.py',16,8),('coupled_item8_action16','coupled_item8_action16.py',8,16),('coupled_item16_action16','coupled_item16_action16.py',16,16)]\nfor name,filename,item_width,action_width in variants:\n config=dict(base_config,item_embed