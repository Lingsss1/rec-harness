{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport ast\nfrom types import SimpleNamespace\nfrom contextlib import nullcontext\n\nclass Tensor:\n def __init__(self, data):\n  self.data=data\n  self.ndim=2 if isinstance(data,list) and data and isinstance(data[0],list) else (1 if isinstance(data,list) else 0)\n  self.shape=(len(data),len(data[0])) if self.ndim==2 else ((len(data),) if self.ndim==1 else ())\n def __getitem__(self,key):\n  rows,cols=key\n  assert isinstance(rows,slice)\n  indexes=list(range(self.shape[1]))[cols] if isinstance(cols,slice) else cols\n  return Tensor([[row[c] for c in indexes] for row in self.data[rows]])\n def copy_(self,other):\n  assert self.shape==other.shape\n  import copy\n  self.data=copy.deepcopy(other.data)\n\ndef matrix(tag,rows,cols):\n return Tensor([[tag+10000*r+c for c in range(cols)] for r in range(rows)])\n\ntree=ast.parse(Path('candidate.py').read_text())\nhelper=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='_source_columns')\nmodel=next(n for n in tree.body if isinstance(n,ast.ClassDef) and n.name=='Model')\ncopy_method=next(n for n in model.body if isinstance(n,ast.FunctionDef) and n.name=='_copy_source_initialization')\nnamespace={'torch':SimpleNamespace(no_grad=nullcontext)}\nexec(compile(ast.Module(body=[helper,copy_method],type_ignores=[]),'<tensor-selection-check>','exec'),namespace)\nitems=['item_id','cate_id']; contexts=['user']; full_key=32; full_context=16\nfor iw in (8,16):\n for aw in (8,16):\n  source={\n   'embedding_layer.embedding_layers.item_id.weight':matrix(100,3,16),\n   'embedding_layer.embedding_layers.history_item.weight':matrix(100,3,16),\n   'embedding_layer.embedding_layers.cate_id.weight':matrix(200,3,16),\n   'embedding_layer.embedding_layers.user.weight':matrix(300,3,16),\n   'embedding_layer.embedding_layers.action.weight':matrix(400,3,16),\n   'local_activation.0.weight':matrix(500,2,4*full_key+16),\n   'local_activation.0.bias':Tensor([0,1]),\n   'local_activation.1.alpha':Tensor([0,0]),\n   'local_activation.1.bn.running_mean':Tensor([0,0]),\n   'local_activation.1.bn.running_var':Tensor([1,1]),\n   'local_activation.1.bn.num_batches_tracked':Tensor(0),\n   'local_activation.2.weight':matrix(600,2,2)}\n  target={}\n  for name,value in source.items():\n   if name.startswith('embedding_layer'):\n    width=16 if '.user.' in name else (aw if '.action.' in name else iw)\n    target[name]=matrix(-100000,3,width)\n   elif name=='local_activation.0.weight': target[name]=matrix(-100000,2,4*len(items)*iw+aw)\n   elif value.ndim==2: target[name]=matrix(-100000,*value.shape)\n   else: target[name]=Tensor([-1]*value.shape[0] if value.ndim else -1)\n  # Preserve actual tied storage in the mock candidate.\n  target['embedding_layer.embedding_layers.history_item.weight']=target['embedding_layer.embedding_layers.item_id.weight']\n  for task_index in range(4):\n   source[f'towers.{task_index}.0.weight']=matrix(1000+task_index*100,2,full_context+2*full_key+16)\n   target[f'towers.{task_index}.0.weight']=matrix(-100000,2,full_context+2*len(items)*iw+aw)\n  obj=SimpleNamespace(item_fields=items,user_fields=contexts,table_widths={name:iw for name in items},action_width=aw,num_tasks=4,state_dict=lambda:target)\n  ref=SimpleNamespace(state_dict=lambda:source)\n  namespace['_copy_source_initialization'](obj,ref)\n  # Independent semantic expectations, rather than reusing the tested helper.\n  attention=[block*32+field*16+c for block in range(4) for field in range(2) for c in range(iw)]+[128+c for c in range(aw)]\n  tower=list(range(16))+[16+block*32+field*16+c for block in range(2) for field in range(2) for c in range(iw)]+[80+c for c in range(aw)]\n  assert target['local_activation.0.weight'].data==[[row[c] for c in attention] for row in source['local_activation.0.weight'].data]\n  for task_index in range(4):\n   name=f'towers.{task_index}.0.weight'\n   assert target[name].data==[[row[c] for c in tower] for row in source[name].data]\n  for name in target:\n   if name.startswith('embedding_layer'):\n    assert target[name].data==[row[:target[name].shape[1]] for row in source[name].data]\n   elif name\"'!='\"'local_activation.0.weight' and not name.startswith('towers.'):\n    assert target[name].data==source[name].data\n  if iw==aw==16:\n   assert all(target[k].data==v.data for k,v in source.items())\n  print(f'PASS mock tensor mapping item{iw}/action{aw}: embeddings, tied aliases, scorer, four towers, biases, Dice parameters/buffers, scalar state')\nprint('Mock checks exercise Python dispatch and mapping only; they are not numerical torch verification.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
