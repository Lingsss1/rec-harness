{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc 'python3 /workspace/tools.py read framework:unirank/pytorch/layers/embeddings/feature_embedding.py --start-line 40 --lines 135'","aggregated_output":"/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n{\n  \"id\": null,\n  \"url\": null,\n  \"version\": \"90bb99a60724e975ec565836266fd86dcad0039d\",\n  \"access_scope\": null,\n  \"text_sha256\": \"6bf3ca96076a86d28a3ebfbb02416baa5f18d085347e67d2e65431ba1075d732\",\n  \"total_lines\": 200,\n  \"start_line\": 40,\n  \"next_line\": 175,\n  \"truncated\": false,\n  \"text\": \"40:         super(FeatureEmbedding, self).__init__()\\n41:         self.embedding_layer = FeatureEmbeddingDict(feature_map, \\n42:                                                     embedding_dim,\\n43:                                                     embedding_initializer=embedding_initializer,\\n44:                                                     required_feature_columns=required_feature_columns,\\n45:                                                     not_required_feature_columns=not_required_feature_columns,\\n46:                                                     use_pretrain=use_pretrain,\\n47:                                                     use_sharing=use_sharing)\\n48: \\n49:     def forward(self, X, feature_source=[], feature_type=[], flatten_emb=False):\\n50:         feature_emb_dict = self.embedding_layer(X, feature_source=feature_source, feature_type=feature_type)\\n51:         feature_emb = self.embedding_layer.dict2tensor(feature_emb_dict, flatten_emb=flatten_emb)\\n52:         return feature_emb\\n53: \\n54: \\n55: class FeatureEmbeddingDict(nn.Module):\\n56:     def __init__(self, \\n57:                  feature_map, \\n58:                  embedding_dim, \\n59:                  embedding_initializer=\\\"partial(nn.init.normal_, std=1e-4)\\\",\\n60:                  required_feature_columns=None,\\n61:                  not_required_feature_columns=None,\\n62:                  use_pretrain=True,\\n63:                  use_sharing=True):\\n64:         super(FeatureEmbeddingDict, self).__init__()\\n65:         self._feature_map = feature_map\\n66:         self.required_feature_columns = required_feature_columns\\n67:         self.not_required_feature_columns = not_required_feature_columns\\n68:         self.use_pretrain = use_pretrain\\n69:         self.embedding_initializer = get_initializer(embedding_initializer)\\n70:         self.embedding_layers = nn.ModuleDict()\\n71:         self.feature_encoders = nn.ModuleDict()\\n72:         for feature, feature_spec in self._feature_map.features.items():\\n73:             if self.is_required(feature):\\n74:                 if not (use_pretrain and use_sharing) and embedding_dim == 1:\\n75:                     feat_dim = 1 # in case for LR\\n76:                     if feature_spec[\\\"type\\\"] == \\\"sequence\\\":\\n77:                         self.feature_encoders[feature] = layers.MaskedSumPooling()\\n78:                 else:\\n79:                     feat_dim = feature_spec.get(\\\"embedding_dim\\\", embedding_dim)\\n80:                     if feature_spec.get(\\\"feature_encoder\\\", None):\\n81:                         self.feature_encoders[feature] = self.get_feature_encoder(feature_spec[\\\"feature_encoder\\\"])\\n82:                     else:\\n83:                         if feature_spec[\\\"type\\\"] == \\\"embedding\\\": # add embedding projection\\n84:                             pretrain_dim = feature_spec.get(\\\"pretrain_dim\\\", feat_dim)\\n85:                             self.feature_encoders[feature] = nn.Linear(pretrain_dim, feat_dim, bias=False)\\n86: \\n87:                 # Set embedding_layer according to share_embedding\\n88:                 if use_sharing and feature_spec.get(\\\"share_embedding\\\") in self.embedding_layers:\\n89:                     self.embedding_layers[feature] = self.embedding_layers[feature_spec[\\\"share_embedding\\\"]]\\n90:                     continue\\n91: \\n92:                 if feature_spec[\\\"type\\\"] == \\\"numeric\\\":\\n93:                     self.embedding_layers[feature] = nn.Linear(1, feat_dim, bias=False)\\n94:                 elif feature_spec[\\\"type\\\"] in [\\\"categorical\\\", \\\"sequence\\\"]:\\n95:                     if use_pretrain and \\\"pretrained_emb\\\" in feature_spec:\\n96:                         pretrain_path = os.path.join(feature_map.data_dir,\\n97:                                                      feature_spec[\\\"pretrained_emb\\\"])\\n98:                         vocab_path = os.path.join(feature_map.data_dir, \\n99:                                                   \\\"feature_vocab.json\\\")\\n100:                         pretrain_dim = feature_spec.get(\\\"pretrain_dim\\\", feat_dim)\\n101:                         pretrain_usage = feature_spec.get(\\\"pretrain_usage\\\", \\\"init\\\")\\n102:                         self.embedding_layers[feature] = PretrainedEmbedding(feature,\\n103:                                                                              feature_spec,\\n104:                                                                              pretrain_path,\\n105:                                                                              vocab_path,\\n106:                                                                              feat_dim,\\n107:                                                                              pretrain_dim,\\n108:                                                                              pretrain_usage,\\n109:                                                                              embedding_initializer)\\n110:                     else:\\n111:                         padding_idx = feature_spec.get(\\\"padding_idx\\\", None)\\n112:                         self.embedding_layers[feature] = nn.Embedding(feature_spec[\\\"vocab_size\\\"],\\n113:                                                                       feat_dim, \\n114:                                                                       padding_idx=padding_idx)\\n115:                 elif feature_spec[\\\"type\\\"] == \\\"embedding\\\":\\n116:                     self.embedding_layers[feature] = nn.Identity()\\n117:         self.init_weights()\\n118: \\n119:     def get_feature_encoder(self, encoder):\\n120:         try:\\n121:             if type(encoder) == list:\\n122:                 encoder_list = []\\n123:                 for enc in encoder:\\n124:                     encoder_list.append(eval(enc))\\n125:                 encoder_layer = nn.Sequential(*encoder_list)\\n126:             else:\\n127:                 encoder_layer = eval(encoder)\\n128:             return encoder_layer\\n129:         except:\\n130:             raise ValueError(\\\"feature_encoder={} is not supported.\\\".format(encoder))\\n131:         \\n132:     def init_weights(self):\\n133:         for k, v in self.embedding_layers.items():\\n134:             if \\\"share_embedding\\\" in self._feature_map.features[k]:\\n135:                 continue\\n136:             if type(v) == PretrainedEmbedding: # skip pretrained\\n137:                 v.init_weights()\\n138:             elif type(v) == nn.Embedding:\\n139:                 if v.padding_idx is not None:\\n140:                     self.embedding_initializer(v.weight[1:, :]) # set padding_idx to zero\\n141:                 else:\\n142:                     self.embedding_initializer(v.weight)\\n143:                        \\n144:     def is_required(self, feature):\\n145:         \\\"\\\"\\\" Check whether feature is required for embedding \\\"\\\"\\\"\\n146:         feature_spec = self._feature_map.features[feature]\\n147:         if feature_spec[\\\"type\\\"] == \\\"meta\\\":\\n148:             return False\\n149:         elif self.required_feature_columns and (feature not in self.required_feature_columns):\\n150:             return False\\n151:         elif self.not_required_feature_columns and (feature in self.not_required_feature_columns):\\n152:             return False\\n153:         else:\\n154:             return True\\n155: \\n156:     def dict2tensor(self, embedding_dict, flatten_emb=False, feature_list=[], feature_source=[],\\n157:                     feature_type=[]):\\n158:         feature_emb_list = []\\n159:         for feature, feature_spec in self._feature_map.features.items():\\n160:             if feature_list and not_in_whitelist(feature, feature_list):\\n161:                 continue\\n162:             if feature_source and not_in_whitelist(feature_spec[\\\"source\\\"], feature_source):\\n163:                 continue\\n164:             if feature_type and not_in_whitelist(feature_spec[\\\"type\\\"], feature_type):\\n165:                 continue\\n166:             if feature in embedding_dict:\\n167:                 feature_emb_list.append(embedding_dict[feature])\\n168:         if flatten_emb:\\n169:             feature_emb = torch.cat(feature_emb_list, dim=-1)\\n170:         else:\\n171:             feature_emb = torch.stack(feature_emb_list, dim=1)\\n172:         return feature_emb\\n173: \\n174:     def forward(self, inputs, feature_source=[], feature_type=[]):\"\n}\n","exit_code":0,"status":"completed"}}
