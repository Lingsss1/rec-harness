stance(n,ast.FunctionDef) and n.name=='_item_coordinates')\n     oldenv={};exec(compile(ast.Module(body=[oldcoords,oldcol],type_ignores=[]),'ancestor','exec'),oldenv)\n     assert (sc,tw)==oldenv['_source_columns'](len(names),2,idw,16,'prefix')\n for args in [(14,16,16),(16,14,16),(15,16,8)]:\n  try:layout(types.SimpleNamespace(features={}),*args)\n  except ValueError:pass\n  else:raise AssertionError('invalid capacity accepted')\n # Ordered aliases mirror upstream: earlier references alias, forward references do not.\n specs={'item_id':{'type':'categorical','source':'item','vocab_size':8},'attr':{'type':'categorical','source':'item','vocab_size':8,'share_embedding':'item_id'},'context':{'type':'categorical','source':'user','vocab_size':8,'share_embedding':'attr'},'action':{'type':'categorical','source':'action','vocab_size':5}}\n lm,w=layout(types.SimpleNamespace(features=specs),15,15,16)\n assert w=={'item_id':16,'attr':16,'context':16,'action':16}\n specs={'item_id':{'type':'categorical','source':'item','vocab_size':8,'share_embedding':'later'},'later':{'type':'categorical','source':'item','vocab_size':8},'again':{'type':'categorical','source':'item','vocab_size':8,'share_embedding':'item_id'}}\n lm,w=layout(types.SimpleNamespace(features=specs),15,16,16)\n assert w=={'item_id':16,'later':16,'again':16}\n print('PASS:',file,'syntax/import boundary, unchanged forward AST, metadata nonmutation/aliases, semantic column mapping and uniform ancestor parity')\nprint('No tensor execution, training, scoring, installations or agents were used.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
