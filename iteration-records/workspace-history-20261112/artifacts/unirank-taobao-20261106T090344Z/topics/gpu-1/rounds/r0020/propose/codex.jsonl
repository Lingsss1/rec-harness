=env['_source_columns']([widths[n] for n in fields],2)\n  for key,oldwidth,newwidth,columns in [('local_activation.0.weight',4*fullkey+16,4*nativekey+16,sc)]+[('towers.'+str(i)+'.0.weight',ctx+2*fullkey+16,ctx+2*nativekey+16,tc) for i in range(4)]:\n   source[key]=matrix(2,oldwidth,key);target[key]=matrix(2,newwidth,'unset')\n   expected[key]=[[row[c] for c in columns] for row in source[key].data]\n  for key,data in [('local_activation.0.bias',[1,2]),('local_activation.1.bn.running_mean',[3,4]),('local_activation.1.bn.running_var',[5,6]),('local_activation.1.bn.num_batches_tracked',7),('towers.2.3.weight',[[8,9],[10,11]])]:\n   source[key]=Tensor(data);target[key]=Tensor(data);expected[key]=copy.deepcopy(data)\n  original=copy.deepcopy({k:v.data for k,v in source.items()})\n  obj=types.SimpleNamespace(item_fields=fields,user_fields=['context0','context1'],table_widths=widths,action_width=16,num_tasks=4,state_dict=lambda:target)\n  ref=types.SimpleNamespace(state_dict=lambda:source)\n  env['_copy_source_initialization'](obj,ref)\n  assert {k:v.data for k,v in target.items()}==expected\n  assert {k:v.data for k,v in source.items()}==original\n  if idw==aw==16:assert {k:v.data for k,v in target.items()}==original\n  # Fail closed for unexpected names and unhandled tensor shape changes.\n  bad=dict(source);bad['unknown']=Tensor(1)\n  try:env['_copy_source_initialization'](obj,types.SimpleNamespace(state_dict=lambda:bad))\n  except ValueError:pass\n  else:raise AssertionError('state mismatch accepted')\n  source['local_activation.0.bias']=Tensor([1,2,3])\n  try:env['_copy_source_initialization'](obj,ref)\n  except ValueError:pass\n  else:raise AssertionError('unmapped shape accepted')\n print('PASS:',file,'mock source-copy dispatch across all four width cells, full16 identity and fail-closed state/shape handling')\nprint('Mocks check dispatch only; they do not validate PyTorch tensor/device/RNG/gradient behavior.')\nPY\"","aggregated_output":"","exit_code":null,"status":