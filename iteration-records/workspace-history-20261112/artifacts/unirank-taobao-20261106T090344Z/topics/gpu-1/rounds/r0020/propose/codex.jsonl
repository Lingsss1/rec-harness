 from unirank.pytorch.torch_utils import get_activation\\n22: from unirank.utils import not_in_whitelist\\n23: from unirank.pytorch.layers.tokenization import ChunkTokenizer\\n24: \\n25: \\n26: class Zenith(MultiTaskModel):\\n27:     def __init__(self,\\n28:                  feature_map,\\n29:                  model_id=\\\"Zenith\\\",\\n30:                  task=[\\\"binary_classification\\\"],\\n31:                  gpu=-1,\\n32:                  tower_activations=\\\"ReLU\\\",\\n33:                  tower_hidden_units=[128, 64],\\n34:                  attention_dropout=0,\\n35:                  embedding_dim=10,\\n36:                  num_layers=3,\\n37:                  expansion_factor=4,\\n38:                  num_tasks=4,\\n39:                  id_dim=64,\\n40:                  token_dim=64,\\n41:                  attention_dim=None,\\n42:                  num_token=4,\\n43:                  net_dropout=0,\\n44:                  accumulation_steps=1,\\n45:                  attention_activation_type=\\\"SoftMax\\\",\\n46:                  **kwargs):\\n47:         super(Zenith, self).__init__(feature_map,\\n48:                                        model_id=model_id,\\n49:                                        gpu=gpu,\\n50:                                        **kwargs)\\n51:         self.num_tasks = num_tasks\\n52:         self.feature_map = feature_map\\n53:         self.embedding_dim = embedding_dim\\n54:         self.token_dim = token_dim\\n55:         self.num_token = num_token\\n56:         self.accumulation_steps = accumulation_steps\\n57:         self.id_dim = id_dim\\n58: \\n59:         # Track item and non-item feature dimensions\\n60:         self.item_info_dim = 0\\n61:         self.non_item_dim = 0\\n62:         for feat, spec in self.feature_map.features.items():\\n63:             if feat in self.feature_map.labels:\\n64:                 continue\\n65:             if spec.get(\\\"type\\\") == \\\"meta\\\":\\n66:                 continue\\n67:             emb_dim = spec.get(\\\"embedding_dim\\\", embedding_dim)\\n68:             if spec.get(\\\"source\\\") in [\\\"item\\\", \\\"action\\\"]:\\n69:                 if feat in [\\\"item_id\\\"]:\\n70:                     self.item_info_dim += id_dim\\n71:                 else:\\n72:                     self.item_info_dim += emb_dim\\n73:             else:\\n74:                 if feat in [\\\"user_id\\\"]:\\n75:                     continue\\n76:                 self.non_item_dim += emb_dim\\n77: \\n78:         self.user_id_embedding_layer = FeatureEmbedding(feature_map, id_dim, required_feature_columns=['user_id'])\\n79:         self.item_id_embedding_layer = FeatureEmbedding(feature_map, id_dim, required_feature_columns=['item_id'])\\n80: \\n81:         self.feature_embedding_layer = FeatureEmbedding(\\n82:             feature_map, embedding_dim,\\n83:             not_required_feature_columns=['user_id', 'item_id']\\n84:         )\\n85: \\n86:         user_context_dim = self.non_item_dim\\n87:         item_attribute_dim = self.item_info_dim * 2\\n88:         self.unified_tokenizer_layer = ZenithTokenizer(\\n89:             id_dim,\\n90:             user_context_dim,\\n91:             item_attribute_dim,\\n92:             token_dim,\\n93:             num_token\\n94:         )\\n95: \\n96:         self.attention_layers = MultiHeadTargetAttention(\\n97:             input_dim=self.item_info_dim,\\n98:             attention_dim=token_dim if attention_dim is None else attention_dim,\\n99:             dropout_rate=attention_dropout,\\n100:             attention_activation_type=attention_activation_type,\\n101:         )\\n102: \\n103:         # Final number of tokens = user_id(1) + item_id(1) + user_context_tokens(num_ns) + item_attribute_tokens(num_ns)\\n104:         self.num_prime_tokens = 2 + 2 * num_token\\n105: \\n106:         self.unified_interaction_layers = ZenithBlock(input_dim=token_dim,\\n107:                                          num_token=self.num_prime_tokens,\\n108:                                          num_layers=num_layers,\\n109:                                          expand=expansion_factor,\\n110:                                          net_dropout=net_dropout)\\n111: \\n112:         self.tower = nn.ModuleList([MLP_Block(input_dim=token_dim,\\n113:                                               output_dim=1,\\n114:                                               hidden_units=tower_hidden_units,\\n115:                                               hidden_activations=tower_activations,\\n116:                                               output_activation=None,\\n117:                                               dropout_rates=net_dropout)\\n118:                                     for _ in range(num_tasks)])\\n119:         if isinstance(task, list):\\n120:             assert len(task) == num_tasks, \\\"the number of tasks must equal the length of \\\\\\\"task\\\\\\\"\\\"\\n121:             self.output_activation = nn.ModuleList([self.get_output_activation(str(t)) for t in task])\\n122:         else:\\n123:             self.output_activation = nn.ModuleList(\\n124:                 [self.get_output_activation(task) for _ in range(num_tasks)]\\n125:             )\\n126: \\n127:         self.compile(kwargs.get(\\\"dense_optimizer\\\"), kwargs[\\\"loss\\\"], kwargs.get(\\\"dense_learning_rate\\\"))\\n128:         self.reset_parameters()\\n129:         self.model_to_device()\\n130: \\n131:     def forward(self, inputs):\\n132:         batch_dict, item_dict, mask = self.get_inputs(inputs)\\n133:         batch_size = mask.shape[0]\\n134:         # item_dict contains [history_items..., target_item]\\n135:         # Reshape flattened embeddings to B x (T+1) x item_info_dim\\n136:         item_attri_emb = self.feature_embedding_layer(item_dict, flatten_emb=True)\\n137:         item_attri_emb = item_attri_emb.view(batch_size, -1, self.item_info_dim - self.id_dim)\\n138:         item_id_emb = self.item_id_embedding_layer(item_dict, flatten_emb=True)\\n139:         item_id_emb = item_id_emb.view(batch_size, -1, self.id_dim)\\n140: \\n141:         item_seq_emb = torch.cat([item_attri_emb, item_id_emb], dim=-1)\\n142:         target_emb = item_seq_emb[:, -1, :]      # B x item_info_dim\\n143:         sequence_emb = item_seq_emb[:, 0:-1, :]  # B x T x item_info_dim\\n144: \\n145:         # Other non-sequential features -> NS tokens\\n146:         user_context_emb = self.feature_embedding_layer(batch_dict, flatten_emb=True)\\n147:         user_id_emb = self.user_id_embedding_layer(batch_dict, flatten_emb=True)\\n148:         item_attribute = self.attention_layers(target_emb, sequence_emb, mask)\\n149:         item_attribute = torch.cat([target_emb, item_attribute], dim=-1)\\n150:         unified_tokens = self.unified_tokenizer_layer(user_id_emb.unsqueeze(1), item_id_emb[:, -1, :].unsqueeze(1), user_context_emb, item_attribute)\\n151: \\n152:         # unified model\\n153:         unified_tokens = self.activation_checkpoint(\\n154:             self.unified_interaction_layers,\\n155:             unified_tokens\\n156:         )\\n157: \\n158:         bottom_output = unified_tokens.mean(dim=1)\\n159:         tower_output = [self.tower[i](bottom_output) for i in range(self.num_tasks)]\\n160:         y_pred = [self.output_activation[i](tower_output[i]) for i in range(self.num_tasks)]\"\n}\n","exit_code":0,"status":"completed"}}
