{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python3 /workspace/tools.py read framework:unirank/pytorch/models/rank_model.py --find 'def reset_parameters' --lines 65\"","aggregated_output":"/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n{\n  \"id\": null,\n  \"url\": null,\n  \"version\": \"90bb99a60724e975ec565836266fd86dcad0039d\",\n  \"access_scope\": null,\n  \"text_sha256\": \"c729cd9d20b22a4a2f0120325ddff9a1528206519f514e5e02387e6b1b3dfb9f\",\n  \"total_lines\": 890,\n  \"start_line\": 307,\n  \"next_line\": 372,\n  \"truncated\": false,\n  \"text\": \"307:         return self.add_loss(return_dict, y_true)\\n308: \\n309:     def reset_parameters(self):\\n310:         def default_reset_params(m):\\n311:             # initialize nn.Linear/nn.Conv1d layers by default\\n312:             if type(m) in [nn.Linear, nn.Conv1d]:\\n313:                 nn.init.xavier_normal_(m.weight)\\n314:                 if m.bias is not None:\\n315:                     m.bias.data.fill_(0)\\n316: \\n317:         def custom_reset_params(m):\\n318:             # initialize layers with customized init_weights()\\n319:             if hasattr(m, 'init_weights'):\\n320:                 m.init_weights()\\n321: \\n322:         self.apply(default_reset_params)\\n323:         self.apply(custom_reset_params)\\n324: \\n325:     def get_inputs(self, inputs, feature_source=None, return_multi_masks=False):\\n326:         \\\"\\\"\\\"\\n327:         Args:\\n328:             inputs: (batch_dict, item_dict, mask) or (batch_dict, item_dict, mask, multi_masks)\\n329:             feature_source: optional feature source filtering\\n330:             return_multi_masks: bool, default False\\n331:                 - False: Return (X_dict, item_dict, mask)\\n332:                 - True : Returns (X_dict, item_dict, mask, multi_masks)\\n333:         \\\"\\\"\\\"\\n334:         if len(inputs) == 4:\\n335:             batch_dict, item_dict, mask, multi_masks = inputs\\n336:         elif len(inputs) == 3:\\n337:             batch_dict, item_dict, mask = inputs\\n338:             multi_masks = None\\n339:         else:\\n340:             raise ValueError(f\\\"Unexpected inputs length: {len(inputs)}. Expected 3 or 4.\\\")\\n341: \\n342:         X_dict = dict()\\n343:         for feature, value in batch_dict.items():\\n344:             if feature in self.feature_map.labels:\\n345:                 continue\\n346:             feature_spec = self.feature_map.features[feature]\\n347:             if feature_spec[\\\"type\\\"] == \\\"meta\\\":\\n348:                 continue\\n349:             if feature_source and not_in_whitelist(feature_spec[\\\"source\\\"], feature_source):\\n350:                 continue\\n351:             X_dict[feature] = value.to(self.device)\\n352: \\n353:         for item, value in item_dict.items():\\n354:             item_dict[item] = value.to(self.device)\\n355: \\n356:         mask = mask.to(self.device)\\n357: \\n358:         if not return_multi_masks:\\n359:             return X_dict, item_dict, mask\\n360: \\n361:         if multi_masks is None:\\n362:             multi_masks = [mask for _ in range(self.num_tasks)]\\n363:         else:\\n364:             if isinstance(multi_masks, (list, tuple)):\\n365:                 multi_masks = [m.to(self.device) for m in multi_masks]\\n366:             elif torch.is_tensor(multi_masks):\\n367:                 multi_masks = multi_masks.to(self.device)\\n368:                 if multi_masks.dim() == 3 and multi_masks.size(0) == self.num_tasks:\\n369:                     multi_masks = [multi_masks[i] for i in range(self.num_tasks)]\\n370:                 else:\\n371:                     multi_masks = [multi_masks for _ in range(self.num_tasks)]\"\n}\n","exit_code":0,"status":"completed"}}
