ower[i](bottom_output) for i in range(self.num_tasks)]\\n152:         y_pred = [self.output_activation[i](tower_output[i]) for i in range(self.num_tasks)]\\n153: \\n154:         return_dict = {}\\n155:         labels = self.feature_map.labels\\n156:         for i in range(self.num_tasks):\\n157:             return_dict[\\\"{}_pred\\\".format(labels[i])] = y_pred[i]\\n158:         return return_dict\"\n}\n","exit_code":0,"status":"completed"}}
