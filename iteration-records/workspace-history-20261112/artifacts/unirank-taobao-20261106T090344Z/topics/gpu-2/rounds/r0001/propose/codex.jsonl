  continue\\n403:             parts = set(str(action_name).split(\\\"|\\\"))\\n404:             for t_idx, aliases in enumerate(task_alias_sets):\\n405:                 if len(parts.intersection(aliases)) > 0:\\n406:                     action_task_table[action_id, t_idx] = 1.0\\n407: \\n408:         return torch.from_numpy(action_task_table)\\n409: \\n410:     def _load_block_side_info(self, user_info_file, item_info_file):\\n411:         cache_key = (str(user_info_file), str(item_info_file))\\n412:         if cache_key in self.side_cache:\\n413:             value = self.side_cache.pop(cache_key)\\n414:             self.side_cache[cache_key] = value\\n415:             return value\\n416: \\n417:         need_user_cols = [\\\"user_index\\\", \\\"full_item_seq\\\", \\\"full_action_seq\\\"]\\n418:         user_df = pd.read_parquet(user_info_file, columns=need_user_cols)\\n419:         user_df = user_df.set_index(\\\"user_index\\\").sort_index()\\n420: \\n421:         if len(user_df) == 0:\\n422:             raise ValueError(f\\\"Empty blocked user_info file: {user_info_file}\\\")\\n423: \\n424:         user_indices = user_df.index.to_numpy(dtype=np.int64)\\n425:         user_index_min = int(user_indices.min())\\n426:         user_index_max = int(user_indices.max())\\n427: \\n428:         user_row_lookup = torch.full(\\n429:             (user_index_max - user_index_min + 1,),\\n430:             -1,\\n431:             dtype=torch.long\\n432:         )\\n433:         user_row_lookup[user_indices - user_index_min] = torch.arange(\\n434:             len(user_df), dtype=torch.long\\n435:         )\\n436: \\n437:         user_item_seqs = user_df[\\\"full_item_seq\\\"].to_numpy()\\n438:         user_action_seqs = user_df[\\\"full_action_seq\\\"].to_numpy()\\n439: \\n440:         item_schema = get_parquet_schema_names(item_info_file)\\n441:         item_cols = [\\\"item_index\\\"] + [col for col in self.all_cols if col not in {\\\"action\\\", \\\"item_index\\\"}]\\n442:         item_cols = [c for c in item_cols if c in item_schema]\\n443: \\n444:         if \\\"item_index\\\" not in item_cols:\\n445:             raise ValueError(f\\\"item_index column missing in blocked item_info: {item_info_file}\\\")\\n446: \\n447:         item_df = pd.read_parquet(item_info_file, columns=item_cols).set_index(\\\"item_index\\\").sort_index()\\n448: \\n449:         if 0 not in item_df.index:\"\n}\n","exit_code":0,"status":"completed"}}
