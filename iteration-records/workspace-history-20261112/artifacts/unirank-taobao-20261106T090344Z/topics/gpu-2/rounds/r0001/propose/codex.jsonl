{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport ast, copy, hashlib, importlib.util, json\nfrom fractions import Fraction\nfrom itertools import product\nfrom pathlib import Path\nr=json.load(open('runtime_resolved.json'))\np=json.load(open('proposal.json'))\nassert set(p)=={'study','parent_trial','variants','knowledge_assessments'}\nassert p['parent_trial'] in r['context']['allowed_observation_ids']\nassert p['study']['protocol_ref']==r['required_study_protocol_ref']\nassert set(p['study']['evidence_refs'])<=set(r['context']['allowed_observation_ids'])\nassert len(p['variants'])==4 and any(v['role']=='candidate' for v in p['variants'])\nassert len({v['name'] for v in p['variants']})==4\nassert len({v['file'] for v in p['variants']})==4\nassert importlib.util.find_spec('torch') is None\nif importlib.util.find_spec('jsonschema'):\n import jsonschema\n jsonschema.Draft202012Validator(r['study_schema']).validate(p['study'])\n print('PASS: study JSON schema')\nelse:\n # Exhaustive type/required/additionalProperties traversal for this schema.\n def check(value,schema,path='study'):\n  types={'object':dict,'array':list,'string':str,'boolean':bool}\n  if 'type' in schema: assert isinstance(value,types[schema['type']]),path\n  if 'const' in schema: assert value==schema['const'],path\n  if 'enum' in schema: assert value in schema['enum'],path\n  if isinstance(value,dict):\n   assert set(schema.get('required',[]))<=set(value),path\n   if schema.get('additionalProperties') is False: assert set(value)<=set(schema['properties']),path\n   for k,v in value.items(): check(v,schema['properties'][k],path+'.'+k)\n  if isinstance(value,list):\n   assert len(value)>=schema.get('minItems',0),path\n   for i,v in enumerate(value): check(v,schema['items'],path+'.'+str(i))\n  if isinstance(value,str): assert len(value)>=schema.get('minLength',0),path\n check(p['study'],r['study_schema'])\n print('PASS: complete study schema traversal (jsonschema unavailable)')\nnormalized=[]\nfor v in p['variants']:\n path=Path(v['file']); assert path.name==v['file'] and path.suffix=='.py'\n source=path.read_text(); tree=ast.parse(source,filename=v['file']); compile(source,v['file'],'exec')\n cfg_node=next(n for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets))\n cfg=ast.literal_eval(cfg_node.value); assert cfg==v['config']\n model=next(n for n in tree.body if isinstance(n,ast.ClassDef) and n.name=='Model')\n init=next(n for n in model.body if isinstance(n,ast.FunctionDef) and n.name=='__init__')\n defaults={a.arg:ast.literal_eval(d) for a,d in zip(init.args.args[-len(init.args.defaults):],init.args.defaults)}\n assert defaults['routing_mode']==cfg['routing_mode']\n assert defaults['action_conditioning']==cfg['action_conditioning']\n for n in ast.walk(tree):\n  if isinstance(n,ast.Import): assert all(x.name.split('.')[0] in ('torch','unirank') for x in n.names)\n  if isinstance(n,ast.ImportFrom): assert n.module.split('.')[0] in ('torch','unirank')\n  if isinstance(n,ast.Call) and isinstance(n.func,ast.Name): assert n.func.id not in ('open','exec','eval','__import__','compile')\n cfg_node.value=ast.parse('None',mode='eval').body\n for a,d in zip(init.args.args[-len(init.args.defaults):],init.args.defaults):\n  if a.arg in ('routing_mode','action_conditioning'): d.value=None\n normalized.append(ast.dump(tree,include_attributes=False))\n print('PASS: syntax, CONFIG/default parity, allowed imports',v['file'],hashlib.sha256(source.encode()).hexdigest())\nassert len(set(normalized))==1\nassert {(v['config']['routing_mode'],v['config']['action_conditioning']) for v in p['variants']}==set(product(('feedback','rotated'),(False,True)))\nprint('PASS: complete 2x2 with identical implementation except config/defaults')\n# Exact mathematical reference, not torch execution: all possible membership\n# patterns at every valid suffix length in a ten-position block.\ncases=0; changed=0\nfor n in range(11):\n valid=[j>=10-n for j in range(10)]\n for labels in product((False,True),repeat=n):\n  membership=[False]*(10-n)+list(labels)\n  rotated=[]\n  rank=-1\n  for j in range(10):\n   if valid[j]:rank+=1\n   src=(10-n)+(rank+n//2)%max(n,1)\n   src=max(0,min(9,src))\n   rotated.append(membership[src] and valid[j])\n  assert sum(rotated)==sum(membership)\n  assert all(not rotated[j] for j in range(10) if not valid[j])\n  changed+=rotated\"'!=membership\n  for routed in (membership,rotated):\n   assignments=[[valid[j] and not routed[j] for j in range(10)],routed]\n   assert all(sum(int(a[j]) for a in assignments)==int(valid[j]) for j in range(10))\n   counts=[sum(a) for a in assignments]\n   assert sum(counts)==n\n   # Coordinate-specific finite padding contamination must be excluded;\n   # weighted means recover the exact original item/action sum.\n   for coordinate in range(3):\n    vals=[(j-4)*(coordinate+2) if valid[j] else 100000+j for j in range(10)]\n    means=[Fraction(sum(x for x,take in zip(vals,a) if take),max(1,count)) for a,count in zip(assignments,counts)]\n    pooled=sum(count*mean for count,mean in zip(counts,means))\n    assert pooled==sum(x for x,take in zip(vals,valid) if take)\n    if n==0:assert pooled==0 and means==[0,0]\n  cases+=1\nprint('\"'PASS: exact routing, count preservation, masked-value exclusion, constant-gate sum and empty-history invariants:',cases,'membership cases;',changed,'changed by rotation')\n# Preserve the supplied ancestor artifacts byte-for-byte.\nfor h in r['context']['history']:\n filename='history_'+h['id'].replace('-','_')+'.py'\n digest=hashlib.sha256(Path(filename).read_bytes()).hexdigest()\n assert digest==h['source_sha256'],filename\nassert hashlib.sha256(Path('baseline_reference.py').read_bytes()).hexdigest()==r['context']['history'][0]['source_sha256']\nprint('PASS: all five ancestor hashes and baseline_reference unchanged')\nassert all(a['variant_names']==[] or set(a['variant_names'])<=set(v['name'] for v in p['variants']) for a in p['knowledge_assessments'])\nprint('PASS: knowledge assessment variant references')\nprint('LIMIT: no torch forward/backward, numerical BF16 or performance execution; host checks required')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
