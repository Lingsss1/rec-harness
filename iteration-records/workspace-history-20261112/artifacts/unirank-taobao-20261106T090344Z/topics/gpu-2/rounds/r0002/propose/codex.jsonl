re_map.labels:\\n345:                 continue\\n346:             feature_spec = self.feature_map.features[feature]\\n347:             if feature_spec[\\\"type\\\"] == \\\"meta\\\":\\n348:                 continue\\n349:             if feature_source and not_in_whitelist(feature_spec[\\\"source\\\"], feature_source):\\n350:                 continue\\n351:             X_dict[feature] = value.to(self.device)\\n352: \\n353:         for item, value in item_dict.items():\\n354:             item_dict[item] = value.to(self.device)\\n355: \\n356:         mask = mask.to(self.device)\\n357: \\n358:         if not return_multi_masks:\\n359:             return X_dict, item_dict, mask\\n360: \\n361:         if multi_masks is None:\\n362:             multi_masks = [mask for _ in range(self.num_tasks)]\\n363:         else:\\n364:             if isinstance(multi_masks, (list, tuple)):\\n365:                 multi_masks = [m.to(self.device) for m in multi_masks]\\n366:             elif torch.is_tensor(multi_masks):\\n367:                 multi_masks = multi_masks.to(self.device)\\n368:                 if multi_masks.dim() == 3 and multi_masks.size(0) == self.num_tasks:\\n369:                     multi_masks = [multi_masks[i] for i in range(self.num_tasks)]\\n370:                 else:\\n371:                     multi_masks = [multi_masks for _ in range(self.num_tasks)]\\n372:             else:\\n373:                 multi_masks = [mask for _ in range(self.num_tasks)]\\n374:         return X_dict, item_dict, mask, multi_masks\\n375: \\n376:     def get_labels(self, inputs):\\n377:         \\\"\\\"\\\" Please override get_labels() when using multiple labels!\\n378:         \\\"\\\"\\\"\\n379:         labels = self.feature_map.labels\\n380:         y = inputs[labels[0]].to(self.device)\\n381:         return y.float().view(-1, 1)\\n382: \\n383:     def get_group_id(self, inputs):\\n384:         return inputs[0][self.feature_map.group_id]\\n385: \\n386:     def model_to_device(self):\\n387:         self.to(device=self.device)\\n388:         self._optimizer_to_device()\\n389: \\n390:     def _optimizer_to_device(self):\\n391:         if not getattr(self, \\\"optimizers\\\", None):\\n392:             return\\n393:         for optimizer in self._iter_optimizers():\\n394:             for param, state in optimizer.state.items():\\n395:                 param_device = param.device\\n396:                 for key, value in state.items():\\n397:                     if torch.is_tensor(value):\"\n}\n{\n  \"id\": null,\n  \"url\": null,\n  \"version\": \"90bb99a60724e975ec565836266fd86dcad0039d\",\n  \"access_scope\": null,\n  \"text_sha256\": \"6bf3ca96076a86d28a3ebfbb02416baa5f18d085347e67d2e65431ba1075d732\",\n  \"total_lines\": 200,\n  \"start_line\": 138,\n  \"next_line\": 201,\n  \"truncated\": false,\n  \"text\": \"138:             elif type(v) == nn.Embedding:\\n139:                 if v.padding_idx is not None:\\n140:                     self.embedding_initializer(v.weight[1:, :]) # set padding_idx to zero\\n141:                 else:\\n142:                     self.embedding_initializer(v.weight)\\n143:                        \\n144:     def is_required(self, feature):\\n145:         \\\"\\\"\\\" Check whether feature is required for embedding \\\"\\\"\\\"\\n146:         feature_spec = self._feature_map.features[feature]\\n147:         if feature_spec[\\\"type\\\"] == \\\"meta\\\":\\n148:             return False\\n149:         elif self.required_feature_columns and (feature not in self.required_feature_columns):\\n150:             return False\\n151:         elif self.not_required_feature_columns and (feature in self.not_required_feature_columns):\\n152:             return False\\n153:         else:\\n154:             return True\\n155: \\n156:     def dict2tensor(self, embedding_dict, flatten_emb=False, feature_list=[], feature_source=[],\\n157:                     feature_type=[]):\\n158:         feature_emb_list = []\\n159:         for feature, feature_spec in self._feature_map.features.items():\\n160:             if feature_list and not_in_whitelist(feature, feature_list):\\n161:                 continue\\n162:             if feature_source and not_in_whitelist(feature_spec[\\\"source\\\"], feature_source):\\n163:                 continue\\n164:             if feature_type and not_in_whitelist(feature_spec[\\\"type\\\"], feature_type):\\n165:                 continue\\n166:             if feature in embedding_dict:\\n167:                 feature_emb_list.append(embedding_dict[feature])\\n168:         if flatten_emb:\\n169:             feature_emb = torch.cat(feature_emb_list, dim=-1)\\n170:         else:\\n171:             feature_emb = torch.stack(feature_emb_list, dim=1)\\n172:         return feature_emb\\n173: \\n174:     def forward(self, inputs, feature_source=[], feature_type=[]):\\n175:         feature_emb_dict = OrderedDict()\\n176:         for feature in inputs.keys():\\n177:             feature_spec = self._feature_map.features[feature]\\n178:             if feature_source and not_in_whitelist(feature_spec[\\\"source\\\"], feature_source):\\n179:                 continue\\n180:             if feature_type and not_in_whitelist(feature_spec[\\\"type\\\"], feature_type):\\n181:                 continue\\n182:             if feature in self.embedding_layers:\\n183:                 if feature_spec[\\\"type\\\"] == \\\"numeric\\\":\\n184:                     inp = inputs[feature].float().view(-1, 1)\\n185:                     embeddings = self.embedding_layers[feature](inp)\\n186:                 elif feature_spec[\\\"type\\\"] == \\\"categorical\\\":\\n187:                     inp = inputs[feature].long()\\n188:                     embeddings = self.embedding_layers[feature](inp)\\n189:                 elif feature_spec[\\\"type\\\"] == \\\"sequence\\\":\\n190:                     inp = inputs[feature].long()\\n191:                     embeddings = self.embedding_layers[feature](inp)\\n192:                 elif feature_spec[\\\"type\\\"] == \\\"embedding\\\":\\n193:                     inp = inputs[feature].float()\\n194:                     embeddings = self.embedding_layers[feature](inp)\\n195:                 else:\\n196:                     raise NotImplementedError\\n197:                 if feature in self.feature_encoders:\\n198:                     embeddings = self.feature_encoders[feature](embeddings)\\n199:                 feature_emb_dict[feature] = embeddings\\n200:         return feature_emb_dict\"\n}\n{\n  \"id\": \"paper:din\",\n  \"url\": \"https://arxiv.org/abs/1706.06978v4\",\n  \"version\": \"content-sha256:5fee25f33f375e51b3ee9417d376ff9dbe2ea3628c932a7679ddfeb0feaaade2\",\n  \"access_scope\": \"archived exact-version primary text; caching does not establish a local mechanism result\",\n  \"text_sha256\": \"83fb9eeca31e2fa3c557b6f08b893ad0018cefb33da6e00952136b9ce17e607e\",\n  \"total_lines\": 831,\n  \"start_line\": 285,\n  \"next_line\": 375,\n  \"truncated\": false,\n  \"text\": \"285: In the advertising system in Alibaba, numbers of goods and users scale up to hundreds of millions.\\n286: Practically, training industrial deep networks with large scale sparse input features is of great challenge.\\n287: In this section, we introduce two important techniques which are proven to be helpful in practice.\\n288: 5.1. Mini-batch Aware Regularization\\n289: Overfitting is a critical challenge for training industrial networks.\\n290: For example, with addition of fine-grained features, such as features of goods_ids with dimensionality of 0.6 billion (including v​i​s​i​t​e​d​_​g​o​o​d​s​_​i​d​svisited\\\\_goods\\\\_ids of user and g​o​o​d​s​_​i​dgoods\\\\_id of ad as described in Table 1), model performance falls rapidly after the first epoch during training without regularization, as the dark green line shown in Fig.4 in later section 6.5.\\n291: It is not practical to directly apply traditional regularization methods, such as ℓ2\\\\ell_{2} and ℓ1\\\\ell_{1} regularization, on training networks with sparse inputs and hundreds of millions of parameters.\\n292: Take ℓ2\\\\ell_{2} regularization as an example.\\n293: Only parameters of non-zero sparse features appearing in each mini-batch needs to be updated in the scenario of SGD based optimization methods without regularization.\\n294: However, when adding ℓ2\\\\ell_{2} regularization it needs to calculate L2-norm over the whole parameters for each mini-batch, which leads to extremely heavy computations and is unacceptable with parameters scaling up to hundreds of millions.\\n295: Figure 3. Control function of PReLU and Dice.\\n296: In this paper, we introduce an efficient mini-batch aware regularizer, which only calculates the L2-norm over the parameters of sparse features appearing in each mini-batch and makes the computation possible.\\n297: In fact, it is the embedding dictionary that contributes most of the parameters for CTR networks and arises the difficulty of heavy computation.\\n298: Let 𝐖∈ℝD×K\\\\bm{\\\\mathrm{W}}\\\\in\\\\mathbb{R}^{D\\\\times K} denote parameters of the whole embedding dictionary, with DD as the dimensionality of the embedding vector and KK as the dimensionality of feature space.\\n299: Expand the ℓ2\\\\ell_{2} regularization on 𝐖\\\\bm{\\\\mathrm{W}} over samples\\n300: (4)\\n301: L2​(𝐖)=‖𝐖‖22=∑j=1K‖𝒘j‖22=∑(𝒙,y)∈𝒮∑j=1KI⁡(𝒙j≠0)nj​‖𝒘j‖22,\\\\displaystyle\\\\begin{split}L_{2}(\\\\bm{\\\\mathrm{W}})&=\\\\|\\\\bm{\\\\mathrm{W}}\\\\|_{2}^{2}=\\\\sum_{j=1}^{K}\\\\|\\\\bm{w}_{j}\\\\|_{2}^{2}=\\\\sum_{(\\\\bm{x},y)\\\\in\\\\mathcal{S}}\\\\sum_{j=1}^{K}\\\\frac{I(\\\\bm{x}_{j}\\\\neq 0)}{n_{j}}\\\\|\\\\bm{w}_{j}\\\\|_{2}^{2},\\\\end{split}\\n302: where 𝒘j∈ℝD\\\\bm{w}_{j}\\\\in\\\\mathbb{R}^{D} is the jj-th embedding vector,\\n303: I⁡(𝒙j≠0)I(\\\\bm{x}_{j}\\\\neq 0) denotes if the instance 𝒙\\\\bm{x} has the feature id jj, and njn_{j} denotes the number of occurrence for feature id jj in all samples. Eq.(4) can be transformed into Eq.(5) in the mini-batch aware manner\\n304: (5)\\n305: L2​(𝐖)=∑j=1K∑m=1B∑(𝒙,y)∈ℬmI⁡(𝒙j≠0)nj​‖𝒘j‖22,L_{2}(\\\\bm{\\\\mathrm{W}})=\\\\sum_{j=1}^{K}\\\\sum_{m=1}^{B}\\\\sum_{(\\\\bm{x},y)\\\\in\\\\mathcal{B}_{m}}\\\\frac{I(\\\\bm{x}_{j}\\\\neq 0)}{n_{j}}\\\\|\\\\bm{w}_{j}\\\\|_{2}^{2},\\n306: where BB denotes the number of mini-batches, ℬm\\\\mathcal{B}_{m} denotes the mm-th mini-batch.\\n307: Let αm​j=max(𝒙,y)∈ℬm⁡I⁡(𝒙j≠0)\\\\alpha_{mj}=\\\\max_{(\\\\bm{x},y)\\\\in\\\\mathcal{B}_{m}}I(\\\\bm{x}_{j}\\\\neq 0)\\n308: denote if there is at least one instance having the feature id jj in mini-batch ℬm\\\\mathcal{B}_{m}.\\n309: Then Eq.(5) can be approximated by\\n310: (6)\\n311: L2​(𝐖)≈∑j=1K∑m=1Bαm​jnj​‖𝒘j‖22.L_{2}(\\\\bm{\\\\mathrm{W}})\\\\approx\\\\sum_{j=1}^{K}\\\\sum_{m=1}^{B}\\\\frac{\\\\alpha_{mj}}{n_{j}}\\\\|\\\\bm{w}_{j}\\\\|_{2}^{2}.\\n312: In this way, we derive an approximated mini-batch aware version of ℓ2\\\\ell_{2} regularization.\\n313: For the mm-th mini-batch, the gradient w.r.t. the embedding weights of feature jj is\\n314: (7)\\n315: 𝒘j←𝒘j−η⁡[1|ℬm|​∑(𝒙,y)∈ℬm∂L⁡(p⁡(𝒙),y)∂𝒘j+λ​αm​jnj​𝒘j],\\\\bm{w}_{j}\\\\leftarrow\\\\bm{w}_{j}-\\\\eta\\\\left[\\\\frac{1}{|\\\\mathcal{B}_{m}|}\\\\sum_{(\\\\bm{x},y)\\\\in\\\\mathcal{B}_{m}}{\\\\frac{\\\\partial L(p(\\\\bm{x}),y)}{\\\\partial\\\\bm{w}_{j}}+\\\\lambda\\\\frac{\\\\alpha_{mj}}{n_{j}}\\\\bm{w}_{j}}\\\\right],\\n316: in which only parameters of features appearing in mm-th mini-batch participate in the computation of regularization.\\n317: 5.2. Data Adaptive Activation Function\\n318: PReLU (He\\n319: et al., 2015) is a commonly used activation function\\n320: (8)\\n321: f⁡(s)={s if ​s>0α​s if ​s≤0.=p⁡(s)⋅s+(1−p⁡(s))⋅α​s,f(s)=\\\\begin{cases}s&\\\\text{ if }s>0\\\\\\\\\\n322: \\\\alpha s&\\\\text{ if }s\\\\leq 0.\\\\end{cases}=\\\\penalty\\\\ p(s)\\\\cdot s+(1-p(s))\\\\cdot\\\\alpha s,\\n323: where ss is one dimension of the input of activation function f⁡(⋅)f(\\\\cdot) and p⁡(s)=I⁡(s>0)p(s)=I(s>0) is an indicator function which controls f⁡(s)f(s) to switch between two channels of f⁡(s)=sf(s)=s and f⁡(s)=α​sf(s)=\\\\alpha s. α\\\\alpha in the second channel is a learning parameter.\\n324: Here we refer to p⁡(s)p(s) as the control function. The left part of Fig.3 plots the control function of PReLU.\\n325: PReLU takes a hard rectified point with value of 00, which may be not suitable when the inputs of each layer follow different distributions.\\n326: Take this into consideration, we design a novel data adaptive activation function named Dice,\\n327: (9)\\n328: f⁡(s)=p⁡(s)⋅s+(1−p⁡(s))⋅α​s,p⁡(s)=11+e−s−E⁡[s]V​a​r​[s]+ϵf(s)=p(s)\\\\cdot s+(1-p(s))\\\\cdot\\\\alpha s,\\\\ \\\\ p(s)=\\\\frac{1}{1+e^{-\\\\frac{s-E[s]}{\\\\sqrt{Var[s]+\\\\epsilon}}}}\\n329: with the control function to be plotted in the right part of Fig.3.\\n330: In the training phrase, E⁡[s]E[s] and V​a​r​[s]Var[s] is the mean and variance of input in each mini-batch.\\n331: In the testing phrase, E⁡[s]E[s] and V​a​r​[s]Var[s] is calculated by moving averages E⁡[s]E[s] and V​a​r​[s]Var[s] over data.\\n332: ϵ\\\\epsilon is a small constant which is set to be 10−810^{-8} in our practice.\\n333: Dice can be viewed as a generalization of PReLu.\\n334: The key idea of Dice is to adaptively adjust the rectified point according to distribution of input data, whose value is set to be the mean of input.\\n335: Besides, Dice controls smoothly to switch between the two channels.\\n336: When E⁡(s)=0E(s)=0 and V​a​r​[s]=0Var[s]=0, Dice degenerates into PReLU.\\n337: 6. Experiments\\n338: In this section, we present our experiments in detail, including datasets, evaluation metric, experimental setup, model comparison and the corresponding analysis.\\n339: Experiments on two public datasets with user behaviors as well as a dataset collected from the display advertising system in Alibaba demonstrate the effectiveness of proposed approach which outperforms state-of-the-art methods on the CTR prediction task.\\n340: Both the public datasets and experiment codes are made available1.\\n341: 6.1. Datasets and Experimental Setup\\n342: Amazon Dataset22\\n343: 2\\n344: http://jmcauley.ucsd.edu/data/amazon/.\\n345: Amazon Dataset contains product reviews and metadata from Amazon, which is used as benchmark dataset(He and McAuley, 2016; Mcauley\\n346: et al., ; Veit\\n347: et al., 2015). We conduct experiments on a subset named Electronics, which contains 192,403 users, 63,001 goods, 801 categories and 1,689,188 samples. User behaviors in this dataset are rich, with more than 5 reviews for each users and goods. Features include goods_id, cate_id, user reviewed goods_id_list and cate_id_list. Let all behaviors of a user be (b1,b2,…,bk,…,bnb_{1},b_{2},\\\\ldots,b_{k},\\\\ldots,b_{n}), the task is to predict the (k+1)-th reviewed goods by making use of the first k reviewed goods.\\n348: Training dataset is generated with k=1,2,…,n−2k=1,2,\\\\ldots,n-2 for each user. In the test set, we predict the last one given the first n−1n-1 reviewed goods.\\n349: For all models, we use SGD as the optimizer with exponential decay, in which learning rate starts at 1 and decay rate is set to 0.1. The mini-batch size is set to be 3232.\\n350: MovieLens Dataset33\\n351: 3\\n352: https://grouplens.org/datasets/movielens/20m/. MovieLens data(Harper and\\n353: Konstan, 2015) contains 138,493 users, 27,278 movies, 21 categories and 20,000,263 samples. To make it suitable for CTR prediction task, we transform it into a binary classification data. Original user rating of the movies is continuous value ranging from 0 to 5. We label the samples with rating of 4 and 5 to be positive and the rest to be negative. We segment the data into training and testing dataset based on userID. Among all 138,493 users, of which 100,000 are randomly selected into training set (about 14,470,000 samples) and the rest 38,493 into the test set (about 5,530,000 samples). The task is to predict whether user will rate a given movie to be above 3(positive label) based on historical behaviors. Features include movie_id, movie_cate_id and user rated movie_id_list, movie_cate_id_list. We use the same optimizer, learning rate and mini-batch size as described on Amazon Dataset.\\n354: Alibaba Dataset. We collected traffic logs from the online display advertising system in Alibaba, of which two weeks’ samples are used for training and samples of the following day for testing. The size of training and testing set is about 2 billions and 0.14 billion respectively. For all the deep models, the dimensionality of embedding vector is 12 for the whole 16 groups of features. Layers of MLP is set by 192×200×80×2192\\\\times 200\\\\times 80\\\\times 2. Due to the huge size of data, we set the mini-batch size to be 5000 and use Adam(Kingma and Ba, 2015) as the optimizer. We apply exponential decay, in which learning rate starts at 0.001 and decay rate is set to 0.9.\\n355: The statistics of all the above datasets is shown in Table 2.\\n356: Volume of Alibaba Dataset is much larger than both Amazon and MovieLens, which brings more challenges.\\n357: Table 2. Statistics of datasets used in this paper.\\n358: Dataset\\n359: Users\\n360: Goodsa\\n361: Categories\\n362: Samples\\n363: Amazon(Electro).\\n364: 192,403\\n365: 63,001\\n366: 801\\n367: 1,689,188\\n368: MovieLens.\\n369: 138,493\\n370: 27,278\\n371: 21\\n372: 20,000,263\\n373: Alibaba.\\n374: 60 million\"\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_15","type":"agent_message","text":"I’ll make this a 2×2 study: click and auxiliary tasks each use either uniform or feedback-stratified summaries. All four variants will have identical parameter shapes and score the same 30 summary slots, so the comparison isolates task routing. The design retains historical feedback masks and target-conditioned scoring; novelty and performance benefits remain unverified."}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"cat > /workspace/candidate.py <<'PY'\n\\\"\\\"\\\"Task-selective compression through one shared target/action scorer.\n\nProspective factorial: click and auxiliary heads independently select uniform\nor feedback-stratified summaries. Every cell constructs and scores the same\n30 slots in one call, including unused branches, to match capacity, forward\ncost, and Dice's normalization population. No effectiveness/novelty claim.\n\\\"\\\"\\\"\nimport torch\nfrom torch import nn\nfrom unirank.pytorch.models import MultiTaskModel\nfrom unirank.pytorch.layers import FeatureEmbeddingDict\nfrom unirank.pytorch.layers.activations import Dice\n\n\nCONFIG = {\n    'embedding_dim': 16,\n    'attention_hidden_units': [64, 32],\n    'tower_hidden_units': [128, 64],\n    'attention_normalization': 'none',\n    'compression_routes': 'uf',\n}\n\n\nclass Model(MultiTaskModel):\n    def __init__(self, feature_map, model_id='TaskSelectiveCompression', gpu=-1,\n                 embedding_dim=16, attention_hidden_units=(64, 32),\n                 tower_hidden_units=(128, 64), attention_normalization='none',\n                 compression_routes='uf', num_tasks=None,\n                 task='binary_classification', **kwargs):\n        if num_tasks is not None and num_tasks \"'!= len(feature_map.labels):\n            raise ValueError('\"'Task count mismatch')\n        if set(feature_map.labels) \"'!= {'\"'is_click', 'cart', 'fav', 'buy'}:\n            raise ValueError('This study requires the frozen four-task schema')\n        if attention_normalization \"'!= '\"'none':\n            raise ValueError('Unnormalized DIN activation is required')\n        if compression_routes not in ('uu', 'uf', 'fu', 'ff'):\n            raise ValueError('Routes must select uniform or feedback for click/auxiliary tasks')\n        super().__init__(feature_map, model_id=model_id, gpu=gpu,\n                         num_tasks=len(feature_map.labels), task=task, **kwargs)\n        self.compression_routes = compression_routes\n        self.embedding_layer = FeatureEmbeddingDict(feature_map, embedding_dim)\n        self.item_fields = [name for name, spec in feature_map.features.items()\n                            if spec.get('source') == 'item' and spec['type'] \"'!= '\"'meta']\n        self.user_fields = [name for name, spec in feature_map.features.items()\n                            if spec.get('source') not in ('item', 'action')\n                            and spec['type'] \"'!= '\"'meta']\n        self.action_field = next((name for name, spec in feature_map.features.items()\n                                  if spec.get('source') == 'action'), None)\n        if self.action_field is None:\n            raise ValueError('Historical action field is required')\n        self.auxiliary_indices = [list(feature_map.labels).index(label)\n                                  for label in ('cart', 'fav', 'buy')]\n        self.key_width = len(self.item_fields) * embedding_dim\n        self.value_width = self.key_width + embedding_dim\n\n        # Inherit the action-aware scorer and towers from the previous factorial.\n        # All cells instantiate exactly the same modules in exactly this order.\n        layers = []\n        width = 4 * self.key_width + embedding_dim\n        for hidden in attention_hidden_units:\n            layers.extend([nn.Linear(width, hidden), Dice(hidden)])\n            width = hidden\n        layers.append(nn.Linear(width, 1))\n        self.local_activation = nn.Sequential(*layers)\n        input_width = len(self.user_fields) * embedding_dim + self.key_width + self.value_width\n        self.towers = nn.ModuleList()\n        for _ in feature_map.labels:\n            tower = []\n            width = input_width\n            for hidden in tower_hidden_units:\n                tower.extend([nn.Linear(width, hidden), Dice(hidden)])\n                width = hidden\n            tower.append(nn.Linear(width, 1))\n            self.towers.append(nn.Sequential(*tower))\n        self.reset_parameters()\n        self.model_to_device()\n\n    def _represent(self, inputs):\n        # Do not allow the framework fallback that treats every event as\n        # positive for every task when historical masks are missing.\n        if len(inputs) \"'!= 4:\n            raise ValueError('\"'Released historical task masks are required')\n        supplied = inputs[3]\n        if isinstance(supplied, (list, tuple)):\n            if len(supplied) \"'!= self.num_tasks:\n                raise ValueError('\"'Wrong number of historical task masks')\n        elif torch.is_tensor(supplied):\n            if supplied.ndim \"'!= 3 or supplied.shape[0] != self.num_tasks:\n                raise ValueError('\"'Expected historical masks with shape [4,B,100]')\n        else:\n            raise ValueError('Released historical task masks are required')\n        user, item, mask, task_masks = self.get_inputs(inputs, return_multi_masks=True)\n        if mask.ndim \"'!= 2 or mask.shape[1] != 100:\n            raise ValueError('\"'Frozen protocol requires 100 history positions')\n        auxiliary = torch.zeros_like(mask, dtype=torch.bool)\n        for index in self.auxiliary_indices:\n            if task_masks[index].shape \"'!= mask.shape:\n                raise ValueError('\"'Historical task mask shape mismatch')\n            auxiliary = auxiliary | (task_masks[index] > 0)\n        auxiliary = auxiliary & mask.bool()\n        user_emb = self.embedding_layer(user)\n        item_emb = self.embedding_layer(item)\n        target = torch.cat([item_emb[name][:, -1] for name in self.item_fields], dim=-1)\n        keys = torch.cat([item_emb[name][:, :-1] for name in self.item_fields], dim=-1)\n        # Current action is unknown and never enters either summary or scorer.\n        values = torch.cat([keys, item_emb[self.action_field][:, :-1]], dim=-1)\n        context = torch.cat([user_emb[name] for name in self.user_fields], dim=-1)\n        return context, target, values, mask, auxiliary\n\n    def _compress_both(self, values, mask, auxiliary):\n        batch, length, width = values.shape\n        if length \"'!= 100:\n            raise ValueError('\"'Frozen protocol requires 100 history positions')\n        groups, block_size = 10, 10\n        valid = mask.bool().reshape(batch, groups, block_size)\n        membership = auxiliary.reshape(batch, groups, block_size) & valid\n        # Per temporal block: one uniform slot and two feedback strata.\n        # Each branch independently covers every valid event exactly once.\n        assignment = torch.stack((valid, valid & ~membership, membership), dim=-2)\n        assignment = assignment.to(values.dtype).reshape(batch * groups, 3, block_size)\n        counts = assignment.sum(-1)\n        grouped = values.reshape(batch * groups, block_size, width)\n        sums = torch.bmm(assignment, grouped)\n        means = sums / counts.clamp_min(1).unsqueeze(-1)\n        return means.reshape(batch, groups * 3, width), counts.reshape(batch, groups * 3)\n\n    def forward(self, inputs):\n        context, target, values, mask, auxiliary = self._represent(inputs)\n        values, counts = self._compress_both(values, mask, auxiliary)\n        keys = values[:, :, :self.key_width]\n        action = values[:, :, self.key_width:]\n        batch, slots, _ = keys.shape\n        query = target[:, None, :].expand(-1, slots, -1)\n        interactions = torch.cat([query, keys, query - keys, query * keys, action], dim=-1)\n        # One common call avoids route-dependent Dice running-stat updates.\n        weights = self.local_activation(interactions.reshape(batch * slots, -1)).reshape(batch, slots)\n        weights = weights * counts.to(weights.dtype)\n        weighted = (weights.unsqueeze(-1) * values).reshape(batch, 10, 3, self.value_width)\n        pooled_strata = weighted.sum(dim=1)\n        uniform = pooled_strata[:, 0,