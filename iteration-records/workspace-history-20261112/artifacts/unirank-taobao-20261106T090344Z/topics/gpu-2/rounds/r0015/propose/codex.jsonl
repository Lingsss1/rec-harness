{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc 'python3 /workspace/tools.py read unirank-code:INFNet --start-line 110 --lines 65'","aggregated_output":"/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n{\n  \"id\": \"unirank-code:INFNet\",\n  \"url\": \"https://github.com/salmon1802/UniRank/blob/90bb99a60724e975ec565836266fd86dcad0039d/model_zoo/INFNet.py\",\n  \"version\": \"git:90bb99a60724e975ec565836266fd86dcad0039d\",\n  \"access_scope\": \"Full pinned benchmark source for inspection; not proof of equivalence to the original author method.\",\n  \"text_sha256\": \"e3750a73af1ceb6b2be4bf9355b70a9ad356985a3c465ef27238ef7e0f28fb4c\",\n  \"total_lines\": 313,\n  \"start_line\": 110,\n  \"next_line\": 175,\n  \"truncated\": false,\n  \"text\": \"110: \\n111:         if isinstance(task, list):\\n112:             assert len(task) == num_tasks, \\\"the number of tasks must equal the length of \\\\\\\"task\\\\\\\"\\\"\\n113:             self.output_activation = nn.ModuleList([self.get_output_activation(str(t)) for t in task])\\n114:         else:\\n115:             self.output_activation = nn.ModuleList(\\n116:                 [self.get_output_activation(task) for _ in range(num_tasks)]\\n117:             )\\n118: \\n119:         self.compile(kwargs.get(\\\"dense_optimizer\\\"), kwargs[\\\"loss\\\"], kwargs.get(\\\"dense_learning_rate\\\"))\\n120:         self.reset_parameters()\\n121:         self.model_to_device()\\n122: \\n123:     def forward(self, inputs):\\n124:         batch_dict, item_dict, mask, multi_masks = self.get_inputs(inputs, return_multi_masks=True)\\n125:         batch_size = mask.shape[0]\\n126: \\n127:         item_seq_emb = self.embedding_layer(item_dict, flatten_emb=True)\\n128:         item_seq_emb = item_seq_emb.view(batch_size, -1, self.item_info_dim)\\n129: \\n130:         target_emb = item_seq_emb[:, -1, :]  # B x item_info_dim\\n131:         seq_orgs_raw = item_seq_emb[:, 0:-1, :]  # B x S x item_info_dim\\n132: \\n133:         # --- Group 1: Sequence Tokens ---\\n134:         s_orgs = self.seq_org_proj(seq_orgs_raw)  # B x S x token_dim\\n135:         s_hubs = []\\n136:         for i in range(self.num_tasks):\\n137:             hub_i = self.masked_avg_pooling(self.seq_hub_projs[i](seq_orgs_raw), multi_masks[i])\\n138:             s_hubs.append(hub_i)\\n139:         s_hubs = torch.stack(s_hubs, dim=1)  # B x num_tasks x token_dim\\n140: \\n141:         # --- Group 2: Categorical Tokens ---\\n142:         ns_emb = self.embedding_layer(batch_dict, flatten_emb=False)\\n143:         c_orgs_raw = torch.cat([ns_emb, target_emb.view(batch_size, -1, self.embedding_dim)], dim=1)\\n144:         c_orgs, c_hubs = self.unified_tokenizer_layer(c_orgs_raw)\\n145: \\n146:         # --- Group 3: Task Tokens ---\\n147:         t_orgs = self.task_orgs.expand(batch_size, -1, -1)\\n148:         t_shared = self.task_shared_hubs.expand(batch_size, -1, -1)\\n149: \\n150:         # Update Tokens and Hubs through multi-layer stacked INFNetBlocks\\n151:         t_orgs = self.activation_checkpoint(\\n152:             self.unified_interaction_layers,\\n153:             c_orgs,\\n154:             s_orgs,\\n155:             t_orgs,\\n156:             c_hubs,\\n157:             s_hubs,\\n158:             t_shared,\\n159:             mask\\n160:         )\\n161: \\n162:         # --- Multi-Task Prediction ---\\n163:         tower_output = [self.tower[i](t_orgs[:, i, :]) for i in range(self.num_tasks)]\\n164:         y_pred = [self.output_activation[i](tower_output[i]) for i in range(self.num_tasks)]\\n165: \\n166:         return_dict = {}\\n167:         labels = self.feature_map.labels\\n168:         for i in range(self.num_tasks):\\n169:             return_dict[\\\"{}_pred\\\".format(labels[i])] = y_pred[i]\\n170:         return return_dict\\n171: \\n172: \\n173: class INFNetCategoricalTokenizer(nn.Module):\\n174:     def __init__(self, embedding_dim, token_dim, num_c_hub_token, num_field, expansion_factor=4):\"\n}\n","exit_code":0,"status":"completed"}}
