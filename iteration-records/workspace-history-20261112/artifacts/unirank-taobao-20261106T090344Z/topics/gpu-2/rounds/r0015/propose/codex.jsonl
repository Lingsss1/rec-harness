{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport ast, random, math\nfrom pathlib import Path\nfiles=['candidate.py','task_centroid.py','task_union.py']\ntrees={f:ast.parse((Path('/workspace')/f).read_text()) for f in files}\nbase=ast.parse(Path('/workspace/history_g2_r0014_age_behavior.py').read_text())\ndef methods(tree,cls):\n return {m.name:m for c in tree.body if isinstance(c,ast.ClassDef) and c.name==cls for m in c.body if isinstance(m,ast.FunctionDef)}\nbm=methods(base,'Model'); nm=methods(trees['candidate.py'],'Model')\nfor name in ['_content_permutation','_compress_both','_interactions','_auxiliary_activation','_pool']:\n assert ast.dump(bm[name])==ast.dump(nm[name]),name\nassert ast.dump(methods(base,'PopulationScorer')['forward'])==ast.dump(methods(trees['candidate.py'],'PopulationScorer')['forward'])\nfor f,t in trees.items():\n compile(t,f,'exec')\n cfg=next(ast.literal_eval(n.value) for n in t.body if isinstance(n,ast.Assign) and any(isinstance(x,ast.Name) and x.id=='CONFIG' for x in n.targets))\n init=methods(t,'Model')['__init__']; defs=dict(zip([a.arg for a in init.args.args][-len(init.args.defaults):],init.args.defaults))\n for k,v in cfg.items():\n  d=ast.literal_eval(defs[k]); assert v==d or (isinstance(v,list) and tuple(v)==d),(f,k)\n # Normalize the only allowed cell difference and compare all AST structure.\n class Normalize(ast.NodeTransformer):\n  def visit_Constant(self,node):\n   if isinstance(node.value,str) and node.value in ('exact','centroid','union'):\n    return ast.copy_location(ast.Constant(value='REPLACEMENT'),node)\n   return node\n norm=ast.dump(Normalize().visit(t))\n if f==files[0]: reference=norm\n else: assert norm==reference,f\nprint('Syntax, CONFIG/defaults, allowed cell parity and inherited-method AST identity: PASS')\n# Independent scalar algebra, not a tensor execution test.\nrng=random.Random(20261106)\nwidths=[20,20,20,20,10,5,2,1,1,1]; edges=[0]\nfor w in widths: edges.append(edges[-1]+w)\nnontrivial=0\nfor case in range(250):\n valid=[(rng.random()>.3) if case>1 else (case==1) for i in range(100)]\n tasks=[[valid[i] and rng.random()<(.1+.15*t) for i in range(100)] for t in range(3)]\n union=[any(t[i] for t in tasks) for i in range(100)]\n values=[rng.uniform(-3,3) for i in range(100)]; weights=[rng.uniform(-2,2) for _ in widths]\n for t in range(3):\n  totaldelta=agedelta=0.\n  for j,(l,r) in enumerate(zip(edges[:-1],edges[1:])):\n   ui=[i for i in range(l,r) if union[i]]; ti=[i for i in range(l,r) if tasks[t][i]]\n   mean=sum(values[i] for i in ui)/max(1,len(ui))\n   exact=sum(values[i] for i in ti); centroid=len(ti)*mean\n   residual=sum(values[i]-mean for i in ti)\n   assert math.isclose(exact-centroid,residual,abs_tol=1e-12)\n   assert len(ti)<=len(ui)\n   assert not ti or ui\n   if ti==ui: assert math.isclose(exact,centroid,abs_tol=1e-12)\n   nontrivial+=abs(residual)>1e-8\n   sign=1 if l>=90 else -1\n   totaldelta+=weights[j]*(exact-centroid); agedelta+=sign*weights[j]*(exact-centroid)\n   # Masked values and masks cannot contribute to counts or sums.\n   perturbed=[values[i] if valid[i] else 1e9 for i in range(100)]\n   assert exact==sum(perturbed[i] for i in ti)\n  assert math.isfinite(totaldelta+agedelta)\nassert nontrivial>0\nprint('250 independent scalar cases: overlap, holes, empty/full, centroid residual identity and masking: PASS')\nprint('Tensor/device/gradient/BF16 tests: NOT RUN (no torch; host prerequisite)')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
