{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport ast,hashlib,json\nfrom pathlib import Path\nroot=Path('/workspace'); runtime=json.load(open(root/'runtime_context.json')); proposal=json.load(open(root/'proposal.json'))\ndef validate(value,schema,path='study'):\n typ=schema.get('type')\n types={'object':dict,'array':list,'string':str,'boolean':bool,'integer':int,'number':(int,float)}\n if typ: assert isinstance(value,types[typ]),(path,typ)\n if 'const' in schema: assert value==schema['const'],path\n if 'enum' in schema: assert value in schema['enum'],path\n if isinstance(value,dict):\n  assert all(k in value for k in schema.get('required',[])),path\n  props=schema.get('properties',{})\n  if schema.get('additionalProperties') is False: assert set(value)<=set(props),path\n  for key,entry in value.items():\n   if key in props: validate(entry,props[key],path+'.'+key)\n if isinstance(value,list):\n  assert len(value)>=schema.get('minItems',0),path\n  for i,item in enumerate(value): validate(item,schema.get('items',{}),path+f'[{i}]')\n if isinstance(value,str): assert len(value)>=schema.get('minLength',0),path\nvalidate(proposal['study'],runtime['study_schema'])\nassert proposal['study']['protocol_ref']==runtime['required_study_protocol_ref']\nallowed=set(runtime['context']['allowed_observation_ids'])\nassert set(proposal['study']['evidence_refs'])<=allowed\nassert proposal['parent_trial'] in allowed\nvs=proposal['variants']; assert 1<=len(vs)<=4\nassert len({v['name'] for v in vs})==len(vs)\nassert len({v['file'] for v in vs})==len(vs)\nassert any(v['role']=='candidate' for v in vs)\nnormalized=[]\nfor v in vs:\n assert v['role'] in ('candidate','control')\n assert Path(v['file']).name==v['file'] and v['file'].endswith('.py')\n p=root/v['file']; t=ast.parse(p.read_text()); compile(t,v['file'],'exec')\n cfg=next(ast.literal_eval(n.value) for n in t.body if isinstance(n,ast.Assign) and any(isinstance(x,ast.Name) and x.id=='CONFIG' for x in n.targets))\n assert cfg==v['config']\n cls=next(n for n in t.body if isinstance(n,ast.ClassDef) and n.name=='Model')\n init=next(n for n in cls.body if isinstance(n,ast.FunctionDef) and n.name=='__init__')\n defaults=dict(zip([a.arg for a in init.args.args][-len(init.args.defaults):],init.args.defaults))\n for k,val in cfg.items():\n  d=ast.literal_eval(defaults[k]); assert val==d or (isinstance(val,list) and tuple(val)==d)\n sha=hashlib.sha256(p.read_bytes()).hexdigest(); assert 'Source SHA256='+sha in v['note']\n for n in ast.walk(t):\n  if isinstance(n,ast.Import): assert all(x.name.split('.')[0] in ('torch','unirank') for x in n.names)\n  if isinstance(n,ast.ImportFrom): assert n.module.split('.')[0] in ('torch','unirank')\n  if isinstance(n,ast.Call) and isinstance(n.func,ast.Name): assert n.func.id not in ('open','exec','eval','compile','__import__')\n class Norm(ast.NodeTransformer):\n  def visit_Constant(self,n):\n   if isinstance(n.value,str) and n.value in ('exact','centroid','union'): return ast.copy_location(ast.Constant(value='CELL'),n)\n   return n\n normalized.append(ast.dump(Norm().visit(t)))\n print(v['name'],v['file'],sha)\nassert len(set(normalized))==1\nfor k in proposal['knowledge_assessments']:\n assert k['decision'] in ('used','considered','rejected','unresolved')\n assert set(k['variant_names'])<={v['name'] for v in vs}\nprint('PASS: exact study schema, protocol/evidence references, standalone sources, CONFIG/defaults, source hashes, imports and replacement parity')\nprint('No training, tensor execution, installation, additional agents or withheld assessment performed.')\n(root/'runtime_context.json').unlink()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
