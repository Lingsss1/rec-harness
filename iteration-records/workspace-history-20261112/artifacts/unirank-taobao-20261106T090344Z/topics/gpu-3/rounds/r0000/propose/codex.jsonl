{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport ast, hashlib, json\nfrom pathlib import Path\np=json.loads(Path('proposal.json').read_text())\nr=json.loads(Path('runtime.json').read_text())\nschema=r['study_schema']\ntry:\n import jsonschema\n jsonschema.validate(p['study'],schema)\n print('Study JSON schema: PASS (jsonschema)')\nexcept ImportError:\n def validate(x,s,path='study'):\n  types={'object':dict,'array':list,'string':str,'boolean':bool}\n  if s.get('type') in types: assert isinstance(x,types[s['type']]),path\n  if isinstance(x,dict):\n   assert not set(s.get('required',[]))-set(x),path+' required'\n   if s.get('additionalProperties') is False: assert not set(x)-set(s.get('properties',{})),path+' unknown'\n   for k,v in x.items():\n    if k in s.get('properties',{}):validate(v,s['properties'][k],path+'.'+k)\n  if isinstance(x,list):\n   assert len(x)>=s.get('minItems',0),path\n   for i,v in enumerate(x):validate(v,s.get('items',{}),path+str(i))\n  if isinstance(x,str):assert len(x)>=s.get('minLength',0),path\n  if 'const' in s:assert x==s['const'],path\n  if 'enum' in s:assert x in s['enum'],path\n validate(p['study'],schema)\n print('Study JSON schema: PASS (stdlib recursive validation)')\nassert p['parent_trial'] in r['context']['allowed_observation_ids']\nassert p['study']['protocol_ref']==r['required_study_protocol_ref']\nassert 1 <= len(p['variants']) <= 4\nassert len({v['name'] for v in p['variants']})==len(p['variants'])\nallowed={'torch','unirank','numpy','math','typing','copy','functools','collections','itertools','dataclasses','contextlib','model_zoo'}\nfor v in p['variants']:\n path=Path(v['file']); assert path.name==v['file'] and path.suffix=='.py'\n src=path.read_text();tree=ast.parse(src);compile(src,str(path),'exec')\n for node in ast.walk(tree):\n  if isinstance(node,ast.Import):assert all(a.name.split('.')[0] in allowed for a in node.names)\n  if isinstance(node,ast.ImportFrom):assert node.module.split('.')[0] in allowed\n config=next(ast.literal_eval(n.value) for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets))\n assert config==v['config']\n model=next(n for n in tree.body if isinstance(n,ast.ClassDef) and n.name=='Model')\n init=next(n for n in model.body if isinstance(n,ast.FunctionDef) and n.name=='__init__')\n defaults=dict(zip([a.arg for a in init.args.args][-len(init.args.defaults):],init.args.defaults))\n assert ast.literal_eval(defaults['routing'])==config['routing']\n assert ast.literal_eval(defaults['feedback_in_score'])==config['feedback_in_score']\n assert hashlib.sha256(path.read_bytes()).hexdigest()==p['preflight']['source_hashes'][v['file']]\n print(v['name']+': syntax, imports, configuration/default agreement, hash PASS')\nassert p['preflight']['baseline_hash_matches_runtime']\nprint('Baseline digest and protocol/lineage: PASS')\nprint('Torch available:',p['preflight']['torch_available'])\np['preflight']['local_checks_passed']=['Study schema validation','All four module syntax and allowed imports','CONFIG/proposal/default agreement','Unique variant names and standalone filenames','Source hashes and baseline digest','Frozen protocol identity and allowed parent lineage']\nPath('proposal.json').write_text(json.dumps(p,indent=2,ensure_ascii=False)+'\\\\n')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
