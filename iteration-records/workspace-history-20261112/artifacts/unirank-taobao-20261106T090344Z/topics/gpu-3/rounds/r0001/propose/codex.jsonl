{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport ast,hashlib\nparent=Path('history_g3_r0000_task_item_retrieval.py').read_text()\nassert hashlib.sha256(parent.encode()).hexdigest()=='ae477f9fe116d5cd17f2a46f7cf4ce19a4aa106283d2dae566d3162586a94235'\nsource=parent.replace(parent[:parent.index('import torch')], '''\\\"\\\"\\\"Prospective primary-anchored history-selector gradient routing.\n\nParent: g3-r0000-task_item_retrieval (same embeddings, pooling and towers).\nOnly the selector's backward information flow is changed. Auxiliary tasks\nretain trainable score rows and shared value/context/target embedding paths.\nRelated stop-gradient precedent: STEM, arXiv:2308.13537v2, Method Eq. (4).\nThis is a local adaptation study; no original mechanism claim is made.\n\\\"\\\"\\\"\n''',1)\nsource=source.replace(\\\"model_id='TaskFeedbackRetrieval'\\\", \\\"model_id='SelectorGradientRouting'\\\")\nsource=source.replace(\\\"feedback_in_score=False, num_tasks=None,\\\", \\\"feedback_in_score=FEEDBACK_DEFAULT, selector_gradient=GRADIENT_DEFAULT, num_tasks=None,\\\")\nsource=source.replace(\\\"        self.routing = routing\\\\n\\\", \\\"\\\"\\\"        if selector_gradient not in ('joint', 'primary'):\n            raise ValueError('selector_gradient must be joint or primary')\n        if selector_gradient == 'primary' and routing \"'!= '\"'task':\n            raise ValueError('Primary selector gradients require task routing')\n        if 'is_click' not in labels:\n            raise ValueError('The primary task is_click is required')\n        self.selector_gradient = selector_gradient\n        self.register_buffer('_primary_channel', torch.tensor(\n            [label == 'is_click' for label in labels], dtype=torch.bool).view(1, -1),\n            persistent=False)\n        self.routing = routing\n\\\"\\\"\\\")\nsource=source.replace(\\\"    def forward(self, inputs):\\\\n\\\", \\\"\\\"\\\"    def _history_scores(self, hidden):\n        scores = self.score_readout(hidden)\n        if self.selector_gradient == 'primary' and torch.is_grad_enabled():\n            # Identical forward values. Auxiliary score rows still learn, but\n            # their losses cannot update the shared trunk or its input paths.\n            # Values, target and context remain differentiable for every task.\n            auxiliary_scores = self.score_readout(hidden.detach())\n            scores = torch.where(self._primary_channel, scores, auxiliary_scores)\n        return scores\n\n    def forward(self, inputs):\n\\\"\\\"\\\")\nsource=source.replace('scores = self.score_readout(hidden).reshape(batch, length, -1)',\n                      'scores = self._history_scores(hidden).reshape(batch, length, -1)')\nvariants=[('candidate.py',True,'primary'),('primary_item.py',False,'primary'),\n          ('joint_feedback.py',True,'joint'),('joint_item.py',False,'joint')]\nfor filename,feedback,gradient in variants:\n config={'embedding_dim':16,'attention_hidden_units':[64,32],\n         'tower_hidden_units':[128,64],'routing':'task',\n         'feedback_in_score':feedback,'selector_gradient':gradient}\n tree=ast.parse(source.replace('FEEDBACK_DEFAULT',repr(feedback)).replace('GRADIENT_DEFAULT',repr(gradient)))\n config_node=next(n for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets))\n lines=source.replace('FEEDBACK_DEFAULT',repr(feedback)).replace('GRADIENT_DEFAULT',repr(gradient)).splitlines()\n lines[config_node.lineno-1:config_node.end_lineno]=['CONFIG = '+repr(config)]\n result='\\\\n'.join(lines)+'\\\\n'\n ast.parse(result)\n compile(result,filename,'exec')\n Path(filename).write_text(result)\n print(filename,hashlib.sha256(result.encode()).hexdigest())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
