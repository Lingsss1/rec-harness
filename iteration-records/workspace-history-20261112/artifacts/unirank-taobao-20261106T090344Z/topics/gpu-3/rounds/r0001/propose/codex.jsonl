{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport difflib\nprint(''.join(difflib.unified_diff(Path('history_g3_r0000_task_item_retrieval.py').read_text().splitlines(True),Path('candidate.py').read_text().splitlines(True),fromfile='parent',tofile='candidate.py')))\nPY\"","aggregated_output":"/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n--- parent\n+++ candidate.py\n@@ -1,8 +1,10 @@\n-\"\"\"Prospective task-conditioned, feedback-aware local history retrieval.\n+\"\"\"Prospective primary-anchored history-selector gradient routing.\n \n-Inherits field embeddings, DIN interaction features, Dice and four prediction\n-heads from baseline-din. Not a claim of a new attention primitive or INFNet\n-reproduction. Shared controls constrain retrieval rank, not effective capacity.\n+Parent: g3-r0000-task_item_retrieval (same embeddings, pooling and towers).\n+Only the selector's backward information flow is changed. Auxiliary tasks\n+retain trainable score rows and shared value/context/target embedding paths.\n+Related stop-gradient precedent: STEM, arXiv:2308.13537v2, Method Eq. (4).\n+This is a local adaptation study; no original mechanism claim is made.\n \"\"\"\n import torch\n from torch import nn\n@@ -10,14 +12,14 @@\n from unirank.pytorch.layers import FeatureEmbeddingDict\n from unirank.pytorch.layers.activations import Dice\n \n-CONFIG = {'embedding_dim': 16, 'attention_hidden_units': [64, 32], 'tower_hidden_units': [128, 64], 'routing': 'task', 'feedback_in_score': False}\n+CONFIG = {'embedding_dim': 16, 'attention_hidden_units': [64, 32], 'tower_hidden_units': [128, 64], 'routing': 'task', 'feedback_in_score': True, 'selector_gradient': 'primary'}\n \n \n class Model(MultiTaskModel):\n-    def __init__(self, feature_map, model_id='TaskFeedbackRetrieval', gpu=-1,\n+    def __init__(self, feature_map, model_id='SelectorGradientRouting', gpu=-1,\n                  embedding_dim=16, attention_hidden_units=(64, 32),\n                  tower_hidden_units=(128, 64), routing='task',\n-                 feedback_in_score=False, num_tasks=None,\n+                 feedback_in_score=True, selector_gradient='primary', num_tasks=None,\n                  task='binary_classification', **kwargs):\n         labels = list(feature_map.labels)\n         if num_tasks is not None and num_tasks != len(labels):\n@@ -26,6 +28,16 @@\n             raise ValueError('routing must be task or shared')\n         super().__init__(feature_map, model_id=model_id, gpu=gpu,\n                          num_tasks=len(labels), task=task, **kwargs)\n+        if selector_gradient not in ('joint', 'primary'):\n+            raise ValueError('selector_gradient must be joint or primary')\n+        if selector_gradient == 'primary' and routing != 'task':\n+            raise ValueError('Primary selector gradients require task routing')\n+        if 'is_click' not in labels:\n+            raise ValueError('The primary task is_click is required')\n+        self.selector_gradient = selector_gradient\n+        self.register_buffer('_primary_channel', torch.tensor(\n+            [label == 'is_click' for label in labels], dtype=torch.bool).view(1, -1),\n+            persistent=False)\n         self.routing = routing\n         self.feedback_in_score = feedback_in_score\n         self.embedding_layer = FeatureEmbeddingDict(feature_map, embedding_dim)\n@@ -66,6 +78,16 @@\n             self.score_readout.bias.copy_(initial_bias.expand_as(self.score_readout.bias))\n         self.model_to_device()\n \n+    def _history_scores(self, hidden):\n+        scores = self.score_readout(hidden)\n+        if self.selector_gradient == 'primary' and torch.is_grad_enabled():\n+            # Identical forward values. Auxiliary score rows still learn, but\n+            # their losses cannot update the shared trunk or its input paths.\n+            # Values, target and context remain differentiable for every task.\n+            auxiliary_scores = self.score_readout(hidden.detach())\n+            scores = torch.where(self._primary_channel, scores, auxiliary_scores)\n+        return scores\n+\n     def forward(self, inputs):\n         user, item, mask = self.get_inputs(inputs)\n         user_emb = self.embedding_layer(user)\n@@ -92,7 +114,7 @@\n             # cannot influence other rows through training-mode BatchNorm.\n             interactions = interactions.masked_fill(~valid, 0)\n             hidden = self.score_trunk(interactions.reshape(batch * length, -1))\n-            scores = self.score_readout(hidden).reshape(batch, length, -1)\n+            scores = self._history_scores(hidden).reshape(batch, length, -1)\n             if self.routing == 'shared':\n                 scores = scores.mean(dim=-1, keepdim=True).expand(-1, -1, len(self.towers))\n             scores = scores.masked_fill(~valid, 0)\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,ast,subprocess,hashlib\nfrom pathlib import Path\nproposal=json.loads(Path('proposal.json').read_text())\nruntime=json.loads(subprocess.check_output(['python3','/workspace/tools.py','resolve','run://r-001']))\nschema=runtime['study_schema']\ndef validate(value,s,path='\"'$'\"'):\n typ=s.get('type')\n if typ:\n  types={'object':dict,'array':list,'string':str}\n  assert isinstance(value,types[typ]),(path,typ)\n if 'enum' in s: assert value in s['enum'],path\n if 'const' in s: assert value==s['const'],path\n if isinstance(value,dict):\n  assert all(k in value for k in s.get('required',[])),path\n  props=s.get('properties',{})\n  if s.get('additionalProperties') is False: assert set(value)<=set(props),(path,set(value)-set(props))\n  for k,v in value.items():\n   if k in props: validate(v,props[k],path+'.'+k)\n if isinstance(value,list):\n  assert len(value)>=s.get('minItems',0),path\n  for i,v in enumerate(value): validate(v,s.get('items',{}),path+'['+str(i)+']')\n if isinstance(value,str): assert len(value)>=s.get('minLength',0),path\nvalidate(proposal['study'],schema)\nassert proposal['study']['protocol_ref']==runtime['required_study_protocol_ref']\nassert set(proposal['study']['evidence_refs']) <= set(runtime['context']['allowed_observation_ids'])\nassert proposal['parent_trial'] in runtime['context']['allowed_observation_ids']\nassert 1<=len(proposal['variants'])<=4\nassert len({v['name'] for v in proposal['variants']})==len(proposal['variants'])\nassert any(v['role']=='candidate' for v in proposal['variants'])\nnormalized=[]\nfor v in proposal['variants']:\n path=Path(v['file'])\n assert path.name==v['file'] and path.suffix=='.py'\n assert v['role'] in ('candidate','control') and isinstance(v['config'],dict) and isinstance(v['note'],str)\n src=path.read_text(); tree=ast.parse(src); compile(src,str(path),'exec')\n config_node=next(n for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets))\n assert ast.literal_eval(config_node.value)==v['config']\n cls=next(n for n in tree.body if isinstance(n,ast.ClassDef) and n.name=='Model')\n init=next(n for n in cls.body if isinstance(n,ast.FunctionDef) and n.name=='__init__')\n defaults={arg.arg:ast.literal_eval(default) for arg,default in zip(init.args.args[-len(init.args.defaults):],init.args.defaults)}\n for k,val in v['config'].items():\n  assert k in defaults and defaults[k]==val,(v['name'],k)\n imported=[]\n for n in ast.walk(tree):\n  if isinstance(n,ast.Import): imported.extend(a.name.split('.')[0] for a in n.names)\n  if isinstance(n,ast.ImportFrom): imported.append(n.module.split('.')[0])\n  if isinstance(n,ast.Call) and isinstance(n.func,ast.Name): assert n.func.id not in ('open','exec','eval','__import__'),(path,n.func.id)\n assert set(imported)<={'torch','unirank'}\n # All variant source differences must be CONFIG and two default values.\n config_node.value=ast.Constant(value='NORMALIZED_CONFIG')\n for i,arg in enumerate(init.args.args[-len(init.args.defaults):]):\n  if arg.arg in ('feedback_in_score','selector_gradient'):\n   init.args.defaults[i]=ast.Constant(value='NORMALIZED_DEFAULT')\n normalized.append(ast.dump(tree,include_attributes=False))\n print(v['name'],v['file'],'syntax/config/import checks passed',hashlib.sha256(src.encode()).hexdigest())\nassert len(set(normalized))==1\nassessed={a['knowledge_id'] for a in proposal['knowledge_assessments']}\nassert {'unirank-method-infnet','unirank-method-ssr'}<=assessed\nprint('Runtime study schema, evidence references, all variant defaults and source equivalence: passed.')\nprint('Numerical torch/host checks: not run; training: not run; withheld assessment: not requested.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
