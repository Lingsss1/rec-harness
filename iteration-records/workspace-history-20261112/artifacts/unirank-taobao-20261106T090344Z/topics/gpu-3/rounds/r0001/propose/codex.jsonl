\\\"\\\"\\\"    def _history_scores(self, hidden):\n        scores = self.score_readout(hidden)\n        if self.selector_gradient == 'primary' and torch.is_grad_enabled():\n            # Identical forward values. Auxiliary score rows still learn, but\n            # their losses cannot update the shared trunk or its input paths.\n            # Values, target and context remain differentiable for every task.\n            auxiliary_scores = self.score_readout(hidden.detach())\n            scores = torch.where(self._primary_channel, scores, auxiliary_scores)\n        return scores\n\n    def forward(self, inputs):\n\\\"\\\"\\\")\nsource=source.replace('scores = self.score_readout(hidden).reshape(batch, length, -1)',\n                      'scores = self._history_scores(hidden).reshape(batch, length, -1)')\nvariants=[('candidate.py',True,'primary'),('primary_item.py',False,'primary'),\n          ('joint_feedback.py',True,'joint'),('joint_item.py',False,'joint')]\nfor filename,feedback,gradient in variants:\n config={'embedding_dim':16,'attention_hidden_units':[64,32],\n         'tower_hidden_units':[128,64],'routing':'task',\n         'feedback_in_score':feedback,'selector_gradient':gradient}\n tree=ast.parse(source.replace('FEEDBACK_DEFAULT',repr(feedback)).replace('GRADIENT_DEFAULT',repr(gradient)))\n config_node=next(n for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets))\n lines=source.replace('FEEDBACK_DEFAULT',repr(feedback)).replace('GRADIENT_DEFAULT',repr(gradient)).splitlines()\n lines[config_node.lineno-1:config_node.end_lineno]=['CONFIG = '+repr(config)]\n result='\\\\n'.join(lines)+'\\\\n'\n ast.parse(result)\n compile(result,filename,'exec')\n Path(filename).write_text(result)\n print(filename,hashlib.sha256(result.encode()).hexdigest())\nPY\"","aggregated_output":"/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n/bin/bash: warning: setlocale: LC_ALL: cannot change locale 