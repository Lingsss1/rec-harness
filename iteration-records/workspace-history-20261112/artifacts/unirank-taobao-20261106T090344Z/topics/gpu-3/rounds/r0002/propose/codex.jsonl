dataset_revision\": \"fd01fb8edbfa58bb4b0d6556f1d5838074b0dbe5\", \"epochs\": 1, \"batch_size\": 8192, \"history_limit\": 100, \"train_seed\": 20262027, \"num_workers\": 0, \"tasks\": [\"is_click\", \"cart\", \"fav\", \"buy\"], \"primary\": \"is_click ROC-AUC\", \"secondary\": \"all four task AUC and unweighted Logloss; mean AUC reported separately\", \"dense_optimizer\": \"AdamW\", \"dense_learning_rate\": 0.0001, \"sparse_optimizer\": \"Adagrad\", \"sparse_learning_rate\": 0.05, \"gradient_clip\": 10.0, \"gradient_clip_scope\": \"dense parameters only, following upstream split optimizer training\", \"precision\": \"bf16 autocast; TF32 disabled; no torch.compile\", \"history_policy\": \"official_offline\", \"history_visibility\": \"Exact released prefix/action inputs. Delayed feedback may not be mature at prediction time; results only establish this offline benchmark.\", \"drop_last\": {\"train\": true, \"valid\": false}, \"full_validation_samples\": 2871767, \"training\": \"scratch; official single-pass recipe adapted to DIN; sum four BCE unless declared training-loss hook\", \"baseline\": \"Initial empirical reference: DIN local activation over item-field history with action values and four separate heads; field/task adaptation, not exact original DIN reproduction\", \"research_goal\": \"Explore and validate mechanism-distinct unified modeling of multi-field user/context/target features and multi-feedback behavior histories. Develop representations and information flow that jointly support sequence modeling, feature interaction and task prediction under the fixed data and compute protocol.\", \"architecture_search\": {\"scope\": \"Whole-model design, including replacement of the initial network and all internal representations.\", \"design_dimensions\": [\"Representation units: fields, events, behavior groups, learned slots and target/task tokens.\", \"Information flow: stacked interaction, layer-wise joint interaction, parallel exchange, learned routing or other