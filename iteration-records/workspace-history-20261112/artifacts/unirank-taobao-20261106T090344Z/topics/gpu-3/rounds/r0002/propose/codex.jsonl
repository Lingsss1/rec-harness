from collections import defaultdict, OrderedDict\\n29: \\n30: \\n31: class MultiTaskModel(BaseModel):\\n32:     def __init__(self,\\n33:                  feature_map,\\n34:                  model_id=\\\"MultiTaskModel\\\",\\n35:                  task=[\\\"binary_classification\\\"],\\n36:                  num_tasks=1,\\n37:                  loss_weight='EQ',\\n38:                  gpu=-1,\\n39:                  monitor=\\\"AUC\\\",\\n40:                  save_best_only=True,\\n41:                  monitor_mode=\\\"max\\\",\\n42:                  early_stop_patience=2,\\n43:                  eval_steps=None,\\n44:                  reduce_lr_on_plateau=True,\\n45:                  **kwargs):\\n46:         super(MultiTaskModel, self).__init__(feature_map=feature_map,\\n47:                                              model_id=model_id,\\n48:                                              task=\\\"binary_classification\\\",\\n49:                                              gpu=gpu,\\n50:                                              loss_weight=loss_weight,\\n51:                                              monitor=monitor,\\n52:                                              save_best_only=save_best_only,\\n53:                                              monitor_mode=monitor_mode,\\n54:                                              early_stop_patience=early_stop_patience,\\n55:                                              eval_steps=eval_steps,\\n56:                                              reduce_lr_on_plateau=reduce_lr_on_plateau,\\n57:                                              **kwargs)\\n58:         self.device = get_device(gpu)\\n59:         self.num_tasks = num_tasks\\n60:         self.loss_weight = loss_weight\\n61:         if isinstance(task, list):\\n62:             assert len(task) == num_tasks, \\\"the number of tasks must equal the length of \\\\\\\"task\\\\\\\"\\\"\\n63:             self.output_activation = nn.ModuleList([self.get_output_activation(str(t)) for t in task])\\n64:         else:\\n65:             self.output_activation = nn.ModuleList(\\n66:                 [self.get_output_activation(task) for _ in range(num_tasks)]\\n67:             )\\n68: \\n69:     def compile(self, optimizer, loss, lr):\\n70:         self._compile_optimizers(optimizer, lr)\\n71:         if isinstance(loss, list):\\n72:             self.loss_fn = [get_loss(l) for l in loss]\\n73:         else:\\n74:             self.loss_fn = [get_loss(loss) for _ in range(self.num_tasks)]\\n75:         self._maybe_enable_torch_compile()\\n76: \\n77:     def get_labels(self, inputs):\\n78:         \\\"\\\"\\\" Override get_labels() to use multiple labels \\\"\\\"\\\"\\n79:         labels = self.feature_map.labels\\n80:         batch_dict = inputs[0]\\n81:         y = [batch_dict[label].to(self.device).float().view(-1, 1)\\n82:              for label in labels]\\n83:         return y\\n84: \\n85:     def add_loss(self, return_dict, y_true):\\n86:         labels = self.feature_map.labels\\n87:         loss = [self.loss_fn[i](return_dict[\\\"{}_pred\\\".format(labels[i])], y_true[i], reduction='mean')\\n88:                 for i in range(len(labels))]\\n89:         if self.loss_weight == 'EQ':\\n90:             # Default: All losses are weighted equally\\n91:             loss = torch.sum(torch.stack(loss))\\n92:         return loss\\n93: \\n94:     def compute_loss(self, return_dict, y_true):\\n95:         return self.add_loss(return_dict, y_true)\\n96: \\n97:     def evaluate(self, data_generator, metrics=None):\\n98:         self.eval()  # set to evaluation mode\\n99:         with torch.no_grad():\\n100:             raw_generator = data_generator\"\n}\n","exit_code":0,"status":"completed"}}
