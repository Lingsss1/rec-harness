ion.\"}\nlatest_knowledge_usage {\"revision\": \"knowledge-access-v3\", \"retrieved_ids\": [\"unirank-method-infnet\", \"unirank-method-ssr\", \"paper:infnet\", \"paper:tokenformer\"], \"assessments\": [{\"knowledge_id\": \"unirank-method-infnet\", \"decision\": \"considered\", \"rationale\": \"Prior declared use produced executed task-score retrieval arms, but feedback-aware task routing did not improve click. This is mixed local evidence, not a confirmation of INFNet or a causal estimate of external knowledge value. Full token/hub replacement would confound the immediate selector backward-flow question.\", \"transformed_mechanism\": \"No new hub or token component adopted; prior task-score rows are retained while a separate gradient-routing adaptation is tested.\", \"variant_names\": [\"primary_feedback\", \"primary_item\", \"joint_feedback\", \"joint_item\"], \"nearest_work_difference\": \"Single local-activation pooling stage with selectively blocked backward paths versus stacked task/proxy token interactions and gated broadcasts. Original v1 text and pinned benchmark forward code checked separately.\", \"falsifier\": \"If the controlled backward intervention fails, do not credit INFNet-inspired task scoring for a nonexistent rescue; consider a separately controlled token/hub architecture only if new evidence justifies it.\", \"source_refs\": [\"unirank-benchmark-v2\", \"unirank-code:INFNet\", \"paper:infnet\"], \"executed_refs\": [{\"trial_id\": \"g3-r0001-primary_feedback\", \"source_sha256\": \"326619aa529dc14fc88372ab0b6bf7970ee8f253bb2c755e783ce080db429ebf\", \"status\": \"success\"}, {\"trial_id\": \"g3-r0001-primary_item\", \"source_sha256\": \"374482a0c33ac823d8b2a163fc3474b3bd65a6fdd605e2e56c4b64df1073f00b\", \"status\": \"success\"}, {\"trial_id\": \"g3-r0001-joint_feedback\", \"source_sha256\": \"4798255718c730c0b5fc2b02ec27078e7f8ae33adb9b98c85fadc6ea7639f519\", \"status\": \"success\"}, {\"trial_id\": \"g3-r0001-joint_item\", \"source_sha256\": \"98