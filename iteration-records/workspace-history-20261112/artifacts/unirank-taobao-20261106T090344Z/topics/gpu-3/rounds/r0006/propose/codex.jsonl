ce-text://framework:unirank/pytorch/layers/activations.py\nframework:unirank/pytorch/layers/attentions/target_attention.py\nunirank/pytorch/layers/attentions/target_attention.py\nsource-text://framework:unirank/pytorch/layers/attentions/target_attention.py\nframework:unirank/pytorch/dataloaders/unirank_dataloader.py\nunirank/pytorch/dataloaders/unirank_dataloader.py\nsource-text://framework:unirank/pytorch/dataloaders/unirank_dataloader.py\n{\n  \"id\": \"unirank-benchmark-v2\",\n  \"url\": \"https://arxiv.org/html/2607.19987v2\",\n  \"version\": \"arxiv:2607.19987v2\",\n  \"access_scope\": \"Cached section2.3 method descriptions; not an original-method full-paper audit.\",\n  \"text_sha256\": \"34ff9c412b35f3118aae377faca5f658d7bffac0b4ef1c12a4eb0c7937372789\",\n  \"total_lines\": 39,\n  \"start_line\": 29,\n  \"next_line\": 40,\n  \"truncated\": false,\n  \"text\": \"29: MixFormer (Huang et al., 2026a) mixes non-sequential queries, uses cross-attention to retrieve information from the updated sequence, and fuses the resulting representations.\\n30: •\\n31: INFNet (Li et al., 2025b) organizes categorical, sequential, and task tokens around a hub for layer-wise aggregation and broadcasting.\\n32: •\\n33: EST (Liu et al., 2026) uses cross-attention to sequence representations and feature-specific feed-forward layers.\\n34: •\\n35: TokenFormer (Zhou et al., 2026) represents fields, histories, and targets as tokens with full interaction and sliding-window Flex Attention.\\n36: •\\n37: LONGER (Chai et al., 2025) encodes local groups with inner Transformers and joins compressed long-term history with recent queries.\\n38: •\\n39: UltraHSTU (Ding et al., 2026) extends HSTU-style sequential transduction (Zhai et al., 2024) with hybrid attention that combines sparse and full attention in each interaction layer.\"\n}\n{\n  \"id\": \"unirank-code:INFNet\",\n  \"url\": \"https://github.com/salmon1802/UniRank/blob/90bb99a60724e975ec565836266fd86dcad0039d/model_zoo/INFNet.py\",\n  \"version\": \"git:90bb99a60724e975ec565836266fd86dcad0039d\",\n  \"access_scope\": \"Full pinned benchmark source for inspection; not proof of equivalence to the original author method.\",\n  \"text_sha256\": \"e3750a73af1ceb6b2be4bf9355b70a9ad356985a3c465ef27238ef7e0f28fb4c\",\n  \"total_lines\": 313,\n  \"start_line\": 1,\n  \"next_line\": 161,\n  \"truncated\": false,\n  \"text\": \"1: # =========================================================================\\n2: # Copyright (C) 2026. UniRank Authors. All rights reserved.\\n3: # \\n4: # Licensed under the Apache License, Version 2.0 (the \\\"License\\\");\\n5: # you may not use this file except in compliance with the License.\\n6: # You may obtain a copy of the License at\\n7: #\\n8: #     http://www.apache.org/licenses/LICENSE-2.0\\n9: #\\n10: # Unless required by applicable law or agreed to in writing, software\\n11: # distributed under the License is distributed on an \\\"AS IS\\\" BASIS,\\n12: # WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\\n13: # See the License for the specific language governing permissions and\\n14: # limitations under the License.\\n15: # =========================================================================\\n16: \\n17: import torch\\n18: from torch import nn\\n19: from unirank.pytorch.models import MultiTaskModel\\n20: from unirank.pytorch.layers import FeatureEmbedding, MLP_Block, MaskedAveragePooling, ScaledDotProductAttention\\n21: from unirank.utils import not_in_whitelist\\n22: from unirank.pytorch.layers.tokenization import AutoSplitTokenizer, FieldWiseTokenizer\\n23: \\n24: \\n25: class INFNet(MultiTaskModel):\\n26:     def __init__(self,\\n27:                  feature_map,\\n28:                  model_id=\\\"INFNet\\\",\\n29:                  task=[\\\"binary_classification\\\"],\\n30:                  gpu=-1,\\n31:                  tower_activations=\\\"ReLU\\\",\\n32:                  tower_hidden_units=[128, 64],\\n33:                  embedding_dim=10,\\n34:                  num_layers=3,\\n35:                  expansion_factor=4,\\n36:                  num_tasks=4,\\n37:                  token_dim=64,\\n38:                  num_c_hub_token=4,\\n39:                  num_t_hub_token=2,\\n40:                  net_dropout=0,\\n41:                  accumulation_steps=1,\\n42:                  **kwargs):\\n43:         super(INFNet, self).__init__(feature_map,\\n44:                                      model_id=model_id,\\n45:                                      gpu=gpu,\\n46:                                      **kwargs)\\n47:         self.num_tasks = num_tasks\\n48:         self.feature_map = feature_map\\n49:         self.embedding_dim = embedding_dim\\n50:         self.token_dim = token_dim\\n51:         self.num_c_hub_token = num_c_hub_token\\n52:         self.num_t_shared_hub = num_t_hub_token\\n53:         self.num_s_hub_token = num_tasks  # Each behavior type in the paper has a hub. Here, the types are divided by tasks.\\n54:         self.accumulation_steps = accumulation_steps\\n55:         self.num_field = feature_map.get_num_fields()\\n56: \\n57:         # Track item and non-item feature dimensions\\n58:         self.item_info_dim = 0\\n59:         self.non_item_dim = 0\\n60:         for feat, spec in self.feature_map.features.items():\\n61:             if feat in self.feature_map.labels:\\n62:                 continue\\n63:             if spec.get(\\\"type\\\") == \\\"meta\\\":\\n64:                 continue\\n65:             emb_dim = spec.get(\\\"embedding_dim\\\", embedding_dim)\\n66:             if spec.get(\\\"source\\\") in [\\\"item\\\", \\\"action\\\"]:\\n67:                 self.item_info_dim += emb_dim\\n68:             else:\\n69:                 self.non_item_dim += emb_dim\\n70: \\n71:         self.embedding_layer = FeatureEmbedding(feature_map, embedding_dim)\\n72: \\n73:         # 1. Categorical Tokenization\\n74:         self.unified_tokenizer_layer = INFNetCategoricalTokenizer(\\n75:             embedding_dim=embedding_dim,\\n76:             token_dim=token_dim,\\n77:             num_c_hub_token=num_c_hub_token,\\n78:             num_field=self.num_field,\\n79:             expansion_factor=expansion_factor\\n80:         )\\n81: \\n82:         # 2. Task Tokenization (Specific & Shared)\\n83:         self.task_orgs = nn.init.xavier_uniform_(nn.Parameter(torch.empty(1, self.num_tasks, token_dim)))\\n84:         self.task_shared_hubs = nn.init.xavier_uniform_(nn.Parameter(torch.empty(1, self.num_t_shared_hub, token_dim)))\\n85: \\n86:         # 3. Sequence Tokenization\\n87:         self.seq_org_proj = nn.Linear(self.item_info_dim, token_dim)\\n88:         self.seq_hub_projs = nn.ModuleList([\\n89:             nn.Linear(self.item_info_dim, token_dim) for _ in range(self.num_tasks)\\n90:         ])\\n91:         self.masked_avg_pooling = MaskedAveragePooling()\\n92: \\n93:         # INFNet Stacked Blocks (pass in num_layers to stack layer by layer)\\n94:         self.unified_interaction_layers = INFNetBlocks(\\n95:             num_layers=num_layers,\\n96:             token_dim=token_dim,\\n97:             num_c_hubs=self.num_c_hub_token,\\n98:             num_s_hubs=self.num_s_hub_token,\\n99:             num_t_hubs=self.num_tasks + self.num_t_shared_hub,\\n100:             expansion_factor=expansion_factor)\\n101: \\n102:         # Task Towers\\n103:         self.tower = nn.ModuleList([MLP_Block(input_dim=token_dim,\\n104:                                               output_dim=1,\\n105:                                               hidden_units=tower_hidden_units,\\n106:                                               hidden_activations=tower_activations,\\n107:                                               output_activation=None,\\n108:                                               dropout_rates=net_dropout)\\n109:                                     for _ in range(num_tasks)])\\n110: \\n111:         if isinstance(task, list):\\n112:             assert len(task) == num_tasks, \\\"the number of tasks must equal the length of \\\\\\\"task\\\\\\\"\\\"\\n113:             self.output_activation = nn.ModuleList([self.get_output_activation(str(t)) for t in task])\\n114:         else:\\n115:             self.output_activation = nn.ModuleList(\\n116:                 [self.get_output_activation(task) for _ in range(num_tasks)]\\n117:             )\\n118: \\n119:         self.compile(kwargs.get(\\\"dense_optimizer\\\"), kwargs[\\\"loss\\\"], kwargs.get(\\\"dense_learning_rate\\\"))\\n120:         self.reset_parameters()\\n121:         self.model_to_device()\\n122: \\n123:     def forward(self, inputs):\\n124:         batch_dict, item_dict, mask, multi_masks = self.get_inputs(inputs, return_multi_masks=True)\\n125:         batch_size = mask.shape[0]\\n126: \\n127:         item_seq_emb = self.embedding_layer(item_dict, flatten_emb=True)\\n128:         item_seq_emb = item_seq_emb.view(batch_size, -1, self.item_info_dim)\\n129: \\n130:         target_emb = item_seq_emb[:, -1, :]  # B x item_info_dim\\n131:         seq_orgs_raw = item_seq_emb[:, 0:-1, :]  # B x S x item_info_dim\\n132: \\n133:         # --- Group 1: Sequence Tokens ---\\n134:         s_orgs = self.seq_org_proj(seq_orgs_raw)  # B x S x token_dim\\n135:         s_hubs = []\\n136:         for i in range(self.num_tasks):\\n137:             hub_i = self.masked_avg_pooling(self.seq_hub_projs[i](seq_orgs_raw), multi_masks[i])\\n138:             s_hubs.append(hub_i)\\n139:         s_hubs = torch.stack(s_hubs, dim=1)  # B x num_tasks x token_dim\\n140: \\n141:         # --- Group 2: Categorical Tokens ---\\n142:         ns_emb = self.embedding_layer(batch_dict, flatten_emb=False)\\n143:         c_orgs_raw = torch.cat([ns_emb, target_emb.view(batch_size, -1, self.embedding_dim)], dim=1)\\n144:         c_orgs, c_hubs = self.unified_tokenizer_layer(c_orgs_raw)\\n145: \\n146:         # --- Group 3: Task Tokens ---\\n147:         t_orgs = self.task_orgs.expand(batch_size, -1, -1)\\n148:         t_shared = self.task_shared_hubs.expand(batch_size, -1, -1)\\n149: \\n150:         # Update Tokens and Hubs through multi-layer stacked INFNetBlocks\\n151:         t_orgs = self.activation_checkpoint(\\n152:             self.unified_interaction_layers,\\n153:             c_orgs,\\n154:             s_orgs,\\n155:             t_orgs,\\n156:             c_hubs,\\n157:             s_hubs,\\n158:             t_shared,\\n159:             mask\\n160:         )\"\n}\n","exit_code":0,"status":"completed"}}
