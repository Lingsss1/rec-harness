{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/check_proposal.py <<'PY'\nimport ast,copy,hashlib,json\nfrom pathlib import Path\nr=json.load(open('/tmp/current_runtime.json'))\np=json.load(open('/workspace/proposal.json'))\ndef check(value,schema,path):\n typ=schema.get('type')\n if typ:\n  ok={'object':lambda:isinstance(value,dict),'array':lambda:isinstance(value,list),'string':lambda:isinstance(value,str),'boolean':lambda:type(value)is bool,'integer':lambda:type(value)is int,'number':lambda:type(value)in (int,float),'null':lambda:value is None}[typ]()\n  assert ok,(path,'type',typ)\n if 'const' in schema: assert value==schema['const'],(path,'const')\n if 'enum' in schema: assert value in schema['enum'],(path,'enum')\n if isinstance(value,dict):\n  assert set(schema.get('required',[])) <= set(value),(path,'required')\n  props=schema.get('properties',{})\n  if schema.get('additionalProperties') is False: assert set(value)<=set(props),(path,'extra fields')\n  for key,sub in props.items():\n   if key in value: check(value[key],sub,path+'.'+key)\n if isinstance(value,list):\n  assert len(value)>=schema.get('minItems',0),(path,'minItems')\n  if 'maxItems' in schema: assert len(value)<=schema['maxItems'],(path,'maxItems')\n  if 'items' in schema:\n   for i,x in enumerate(value):check(x,schema['items'],path+f'[{i}]')\n if isinstance(value,str):assert len(value)>=schema.get('minLength',0),(path,'minLength')\ncheck(p['study'],r['study_schema'],'study')\nassert p['study']['protocol_ref']==r['required_study_protocol_ref']\nallowed=set(r['context']['allowed_observation_ids'])\nassert p['parent_trial'] in allowed\nassert set(p['study']['evidence_refs'])<=allowed\nassert 1<=len(p['variants'])<=4\nassert len({v['name'] for v in p['variants']})==len(p['variants'])\nassert len({v['file'] for v in p['variants']})==len(p['variants'])\nassert any(v['role']=='candidate' for v in p['variants'])\nnormalized=[]\nfor v in p['variants']:\n path=Path('/workspace',v['file'])\n assert path.name==v['file'] and path.suffix=='.py'\n source=path.read_text()\n compile(source,str(path),'exec')\n tree=ast.parse(source)\n cfg_node=next(n for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(x,ast.Name) and x.id=='CONFIG' for x in n.targets))\n assert ast.literal_eval(cfg_node.value)==v['config']\n cls=next(n for n in tree.body if isinstance(n,ast.ClassDef) and n.name=='Model')\n init=next(n for n in cls.body if isinstance(n,ast.FunctionDef) and n.name=='__init__')\n args=init.args.args\n defaults={a.arg:ast.literal_eval(default) for a,default in zip(args[-len(init.args.defaults):],init.args.defaults)}\n for key,val in v['config'].items():\n  dv=defaults[key]\n  assert (list(dv) if isinstance(dv,tuple) else dv)==val,(v['name'],key)\n for node in ast.walk(tree):\n  if isinstance(node,ast.Import):roots=[x.name.split('.')[0] for x in node.names]\n  elif isinstance(node,ast.ImportFrom):roots=[node.module.split('.')[0]]\n  else:continue\n  assert set(roots)<=set('torch numpy math typing copy functools collections itertools dataclasses contextlib unirank model_zoo'.split()),roots\n assert 'training_loss' not in {n.name for n in cls.body if isinstance(n,ast.FunctionDef)}\n assert 'donor.detach()' in source\n assert 'torch.zeros(output_width, input_width)' in source\n assert 'torch.sigmoid(tower[-1](hidden))' in source\n assert 'for layer_index in range(len(tower) - 1):' in source\n # All implementation ASTs match after removing literal per-cell defaults/config.\n tree.body.remove(cfg_node)\n for a,default in zip(args[-len(init.args.defaults):],init.args.defaults):\n  if a.arg in ('auxiliary_item_mode','transfer_source'): default.value='FACTOR'\n normalized.append(ast.dump(tree,include_attributes=False))\n print(v['name'], 'syntax/config/import checks passed;',hashlib.sha256(source.encode()).hexdigest())\nassert len(set(normalized))==1,'Unintended implementation differences between factorial cells'\nassert {(v['config']['auxiliary_item_mode'],v['config']['transfer_source']) for v in p['variants']}=={(m,s) for m in ('private','fixed') for s in ('auxiliary','self')}\nassert len({a['knowledge_id'] for a in p['knowledge_assessments']})==len(p['knowledge_assessments'])\nprint('Study schema, protocol/evidence references, four-cell factorial, standalone files, defaults and identical implementation checks passed.')\nprint('No Torch execution, training, installations or withheld assessment performed.')\nPY\npython3 /tmp/check_proposal.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
