n371:                     multi_masks = [multi_masks for _ in range(self.num_tasks)]\\n372:             else:\\n373:                 multi_masks = [mask for _ in range(self.num_tasks)]\\n374:         return X_dict, item_dict, mask, multi_masks\\n375: \\n376:     def get_labels(self, inputs):\\n377:         \\\"\\\"\\\" Please override get_labels() when using multiple labels!\\n378:         \\\"\\\"\\\"\\n379:         labels = self.feature_map.labels\\n380:         y = inputs[labels[0]].to(self.device)\\n381:         return y.float().view(-1, 1)\\n382: \\n383:     def get_group_id(self, inputs):\\n384:         return inputs[0][self.feature_map.group_id]\\n385: \\n386:     def model_to_device(self):\\n387:         self.to(device=self.device)\\n388:         self._optimizer_to_device()\\n389: \\n390:     def _optimizer_to_device(self):\\n391:         if not getattr(self, \\\"optimizers\\\", None):\\n392:             return\\n393:         for optimizer in self._iter_optimizers():\\n394:             for param, state in optimizer.state.items():\\n395:                 param_device = param.device\\n396:                 for key, value in state.items():\"\n}\n{\n  \"id\": null,\n  \"url\": null,\n  \"version\": \"90bb99a60724e975ec565836266fd86dcad0039d\",\n  \"access_scope\": null,\n  \"text_sha256\": \"a956a5b1836b3ba5552a910314960094be644d45112ffc0ab3e7799f701ddc3c\",\n  \"total_lines\": 42,\n  \"start_line\": 23,\n  \"next_line\": 43,\n  \"truncated\": false,\n  \"text\": \"23: \\n24: \\n25: class Dice(nn.Module):\\n26:     def __init__(self, input_dim, eps=1e-9):\\n27:         super(Dice, self).__init__()\\n28:         self.bn = nn.BatchNorm1d(input_dim, affine=False, eps=eps, momentum=0.01)\\n29:         self.alpha = nn.Parameter(torch.zeros(input_dim))\\n30: \\n31:     def forward(self, X):\\n32:         p = torch.sigmoid(self.bn(X))\\n33:         output = p * X + self.alpha * (1 - p) *  X\\n34:         return output\\n35: \\n36: \\n37: class GELU(nn.Module):\\n38:     def __init__(self):\\n39:         super(GELU, self).__init__()\\n40: \\n41:     def forward(self, x):\\n42:         return 0.5 * x * (1 + torch.tanh(np.sqrt(2 / np.pi) * ( x + 0.044715 * torch.pow(x, 3))))\"\n}\n{\n  \"id\": null,\n  \"url\": null,\n  \"version\": \"90bb99a60724e975ec565836266fd86dcad0039d\",\n  \"access_scope\": null,\n  \"text_sha256\": \"abe8fd1999fadf50bd641c1e52dde3e26200a1d4494b8fe0ffb44c26e2f0ef6f\",\n  \"total_lines\": 225,\n  \"start_line\": 1,\n  \"next_line\": 121,\n  \"truncated\": false,\n  \"text\": \"1: # =========================================================================\\n2: # Copyright (C) 2026. UniRank Authors. All rights reserved.\\n3: # Copyright (C) 2024. The FuxiCTR Library. All rights reserved.\\n4: #\\n5: # Licensed under the Apache License, Version 2.0 (the \\\"License\\\");\\n6: # you may not use this file except in compliance with the License.\\n7: # You may obtain a copy of the License at\\n8: #\\n9: #     http://www.apache.org/licenses/LICENSE-2.0\\n10: #\\n11: # Unless required by applicable law or agreed to in writing, software\\n12: # distributed under the License is distributed on an \\\"AS IS\\\" BASIS,\\n13: # WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\\n14: # See the License for the specific language governing permissions and\\n15: # limitations under the License.\\n16: # =========================================================================\\n17: \\n18: import torch\\n19: from torch import nn\\n20: import torch.distributed as dist\\n21: from torch.utils.data.distributed import DistributedSampler\\n22: import numpy as np\\n23: import os, sys\\n24: import logging\\n25: from unirank.pytorch.models import BaseModel\\n26: from unirank.pytorch.torch_utils import get_device, get_loss\\n27: from tqdm import tqdm\\n28: from collections import defaultdict, OrderedDict\\n29: \\n30: \\n31: class MultiTaskModel(BaseModel):\\n32:     def __init__(self,\\n33:                  feature_map,\\n34:                  model_id=\\\"MultiTaskModel\\\",\\n35:                  task=[\\\"binary_classification\\\"],\\n36:                  num_tasks=1,\\n37:                  loss_weight='EQ',\\n38:                  gpu=-1,\\n39:                  monitor=\\\"AUC\\\",\\n40:                  save_best_only=True,\\n41:                  monitor_mode=\\\"max\\\",\\n42:                  early_stop_patience=2,\\n43:                  eval_steps=None,\\n44:                  reduce_lr_on_plateau=True,\\n45:                  **kwargs):\\n46:         super(MultiTaskModel, self).__init__(feature_map=feature_map,\\n47:                                              model_id=model_id,\\n48:                                              task=\\\"binary_classification\\\",\\n49:                                              gpu=gpu,\\n50:                                              loss_weight=loss_weight,\\n51:                                              monitor=monitor,\\n52:                                              save_best_only=save_best_only,\\n53:                                              monitor_mode=monitor_mode,\\n54:                                              early_stop_patience=early_stop_patience,\\n55:                                              eval_steps=eval_steps,\\n56:                                              reduce_lr_on_plateau=reduce_lr_on_plateau,\\n57:                                              **kwargs)\\n58:         self.device = get_device(gpu)\\n59:         self.num_tasks = num_tasks\\n60:         self.loss_weight = loss_weight\\n61:         if isinstance(task, list):\\n62:             assert len(task) == num_tasks, \\\"the number of tasks must equal the length of \\\\\\\"task\\\\\\\"\\\"\\n63:             self.output_activation = nn.ModuleList([self.get_output_activation(str(t)) for t in task])\\n64:         else:\\n65:             self.output_activation = nn.ModuleList(\\n66:                 [self.get_output_activation(task) for _ in range(num_tasks)]\\n67:             )\\n68: \\n69:     def compile(self, optimizer, loss, lr):\\n70:         self._compile_optimizers(optimizer, lr)\\n71:         if isinstance(loss, list):\\n72:             self.loss_fn = [get_loss(l) for l in loss]\\n73:         else:\\n74:             self.loss_fn = [get_loss(loss) for _ in range(self.num_tasks)]\\n75:         self._maybe_enable_torch_compile()\\n76: \\n77:     def get_labels(self, inputs):\\n78:         \\\"\\\"\\\" Override get_labels() to use multiple labels \\\"\\\"\\\"\\n79:         labels = self.feature_map.labels\\n80:         batch_dict = inputs[0]\\n81:         y = [batch_dict[label].to(self.device).float().view(-1, 1)\\n82:              for label in labels]\\n83:         return y\\n84: \\n85:     def add_loss(self, return_dict, y_true):\\n86:         labels = self.feature_map.labels\\n87:         loss = [self.loss_fn[i](return_dict[\\\"{}_pred\\\".format(labels[i])], y_true[i], reduction='mean')\\n88:                 for i in range(len(labels))]\\n89:         if self.loss_weight == 'EQ':\\n90:             # Default: All losses are weighted equally\\n91:             loss = torch.sum(torch.stack(loss))\\n92:         return loss\\n93: \\n94:     def compute_loss(self, return_dict, y_true):\\n95:         return self.add_loss(return_dict, y_true)\\n96: \\n97:     def evaluate(self, data_generator, metrics=None):\\n98:         self.eval()  # set to evaluation mode\\n99:         with torch.no_grad():\\n100:             raw_generator = data_generator\\n101:             y_pred_all = defaultdict(list)\\n102:             y_true_all = defaultdict(list)\\n103:             labels = self.feature_map.labels\\n104:             group_id = []\\n105:             if self._verbose > 0:\\n106:                 data_generator = tqdm(\\n107:                     data_generator,\\n108:                     disable=False,\\n109:                     file=sys.stdout,\\n110:                     desc=f\\\"Rank {self.rank} | Eval\\\",\\n111:                     position=self.rank,\\n112:                     leave=(self.rank == 0),\\n113:                     dynamic_ncols=True\\n114:                 )\\n115: \\n116:             amp_ctx = self._get_amp_context()\\n117:             with amp_ctx:\\n118:                 for batch_data in data_generator:\\n119:                     return_dict = self.forward(batch_data)\\n120:                     batch_y_true = self.get_labels(batch_data)\"\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_21","type":"agent_message","text":"STEM already uses cross-task forward transfer with gradients stopped for other tasks’ experts, so this proposal adapts an established mechanism. Here, the donors will be the auxiliary towers’ history-conditioned representations, transferred into the click readout. The controls will test whether learned auxiliary embeddings make that transfer more useful. ([STEM](https://arxiv.org/html/2308.13537v2))\n"}}
{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/build_transfer.py <<'PY'\nfrom pathlib import Path\nimport ast\nbase=Path('/workspace/history_g3_r0005_private_aux_items.py').read_text()\nold_doc=ast.get_docstring(ast.parse(base))\nnew_doc='''Detached auxiliary-to-click representation transfer, with a factorial replacement suite.\n\nAdaptation of STEM's cross-task forward / task-owned backward principle\n(Su et al., AAAI 2024, arXiv:2308.13537v2, Method eq. 4), applied to the\narchived local history-conditioned auxiliary towers. This is not a new general\nstop-gradient principle or a STEM reproduction. AITM (arXiv:2105.08489v2)\nalso transfers tower representations; no ordered-conversion assumptions or\nprobability constraints are made here.\n\nFactors: learned versus fixed private item/action embeddings; auxiliary versus\nreceiver-self donor representations. All variants allocate and train the same\nzero-initialized, bias-free linear residual map. Self donors repeat the detached\nclick hidden state once per auxiliary, providing a receiver reparameterization\ncontrol. The auxiliary donors are detached penultimate states, never labels or\nobserved current outcomes. Each inherited tower executes once, retaining Dice\nstatistics. The residual is added only after the click tower's last Dice and\nbefore its original final linear prediction. No donor receives click gradients\nthrough this edge; shared context and primary-owned selector remain inherited.\n\nThe adapter is created after inherited initialization with zeros and no random\ndraws. Thus every variant starts with the parent's predictions and leaves the\ninherited RNG stream unchanged. Forward uses only frozen host inputs; masked\nhistory is zeroed and current target action is never consumed.\n'''\nbase=base.replace('\\\"\\\"\\\"'+old_doc+'\\\"\\\"\\\"','\\\"\\\"\\\"'+new_doc+'\\\"\\\"\\\"',1)\nbase=base.replace('\\\\n\\\\nclass Model(MultiTaskModel):','''\n\nclass DetachedResidualTransfer(nn.Module):\n    \\\"\\\"\\\"A zero-initialized read-only donor edge; parameters belong to click.\\\"\\\"\\\"\n    def __init__(self, input_width, output_width):\n        super().__init__()\n        # No random initialization: preserve the parent's downstream RNG state.\n        self.weight = nn.Parameter(torch.zeros(output_width, input_width))\n\n    def forward(self, donor):\n        return torch.nn.functional.linear(donor.detach(), self.weight)\n\n\nclass Model(MultiTaskModel):''',1)\nbase=base.replace(\\\"model_id='PrivateAuxiliaryItemRepresentation'\\\",\\\"model_id='DetachedAuxiliaryTowerTransfer'\\\",1)\nbase=base.replace(\\\"auxiliary_item_mode='private', num_tasks=None,\\\",\\\"auxiliary_item_mode='private', transfer_source='auxiliary', num_tasks=None,\\\",1)\nneedle='        self.auxiliary_item_mode = auxiliary_item_mode\\\\n'\nbase=base.replace(needle,\\\"\\\"\\\"        if transfer_source not in ('auxiliary', 'self'):\n            raise ValueError('transfer_source must be auxiliary or self')\n        if auxiliary_item_mode not in ('private', 'fixed'):\n            raise ValueError('Transfer study uses learned or fixed private items')\n        if not tower_hidden_units or any(int(width) <= 0 for width in tower_hidden_units):\n            raise ValueError('Transfer requires nonempty positive tower widths')\n        self.transfer_source = transfer_source\n        self.primary_index = labels.index('is_click')\n        self.auxiliary_indices = [index for index in range(len(labels))\n                                  if index \"'!= self.primary_index]\n        if not self.auxiliary_indices:\n            raise ValueError('\"'At least one auxiliary donor is required')\n\\\"\\\"\\\"+needle,1)\nneedle='        self.model_to_device()\\\\n'\nbase=base.replace(needle,\\\"\\\"\\\"        # Append after the inherited reset and exact embedding clones. No RNG\n        # draws, additional embedding tables, or extra normalization buffers.\n        readout_width = int(tower_hidden_units[-1])\n        self.transfer = DetachedResidualTransfer(\n            len(self.auxiliary_indices) * readout_width, readout_width)\n\\\"\\\"\\\"+needle,1)\nstart=base.index('        outputs = {}\\\\n',base.index('    def forward(self, inputs):'))\nbase=base[:start]+'''        task_hidden = []\n        for index, (label, tower) in enumerate(zip(self.feature_map.labels, self.towers)):\n            task_context, task_target = context, target\n            if label \"'!= '\"'is_click':\n                if self.block_aux_context_gradient:\n                    task_context = context.detach()\n                task_target = auxiliary_target\n            hidden = torch.cat([task_context, task_target, pooled[:, index]], dim=-1)\n            # Each original Dice/BatchNorm sees exactly one call per batch.\n            for layer_index in range(len(tower) - 1):\n                hidden = tower[layer_index](hidden)\n            task_hidden.append(hidden)\n        if self.transfer_source == 'auxiliary':\n            donor = torch.cat([task_hidden[index].detach()\n                               for index in self.auxiliary_indices], dim=-1)\n        else:\n            # Same adapter dimensions, dense active parameter count and matmul\n            # cost; only receiver information is available to this replacement.\n            receiver = task_hidden[self.primary_index].detach()\n            donor = torch.cat([receiver for _ in self.auxiliary_indices], dim=-1)\n        residual = self.transfer(donor)\n        outputs = {}\n        for index, (label, tower) in enumerate(zip(self.feature_map.labels, self.towers)):\n            hidden = task_hidden[index]\n            if index == self.primary_index:\n                hidden = hidden + residual\n            outputs[label + '_pred'] = torch.sigmoid(tower[-1](hidden))\n        return outputs\n'''\nconfig_node=next(n for n in ast.parse(base).body if isinstance(n,ast.Assign) and any(isinstance(x,ast.Name) and x.id=='CONFIG' for x in n.targets))\nold_config=ast.literal_eval(config_node.value)\nvariants=[('candidate.py','private','auxiliary'),('control_private_self.py','private','self'),('control_fixed_aux.py','fixed','auxiliary'),('control_fixed_self.py','fixed','self')]\nfor filename,mode,source in variants:\n cfg={**old_config,'auxiliary_item_mode':mode,'transfer_source':source}\n lines=base.splitlines()\n lines[config_node.lineno-1]='CONFIG = '+repr(cfg)\n code='\\\\n'.join(lines)+'\\\\n'\n code=code.replace(\\\"auxiliary_item_mode='private', transfer_source='auxiliary', num_tasks=None,\\\",f\\\"auxiliary_item_mode={mode\"'!r}, transfer_source={source!r}, num_tasks=None,\",1)\n ast.parse(code)\n Path('\"'/workspace',filename).write_text(code)\nprint('Created four standalone modules; no imports, training or installation performed.')\nPY\npython3 /tmp/build_transfer.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
