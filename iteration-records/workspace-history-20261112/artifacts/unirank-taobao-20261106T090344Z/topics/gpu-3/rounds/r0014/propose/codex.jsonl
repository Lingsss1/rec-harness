{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport math,random,itertools\nrng=random.Random(14)\ntaus=(1,4,16,64)\ndef make_features(actions,matches,identity):\n out=[]\n for acts,mt in zip(actions,matches):\n  channels=[1]+list(acts)\n  if not identity: channels=[1]+[sum(acts)/4]*4\n  out.append([x*y for x in channels for y in mt])\n return out\ndef routes(features,valid,w):\n count=sum(valid); seen=0; basis=[]\n for v in valid:\n  seen+=v; rank=count-seen\n  basis.append([math.exp(-rank/t) if v else 0 for t in taus])\n mean=[sum(b[k] for b in basis)/max(count,1) for k in range(4)]\n ordered=[];marginal=[]\n for f,v,b in zip(features,valid,basis):\n  z=[sum(f[d]*w[d][k] for d in range(20))/2 for k in range(4)]\n  ordered.append(sum(x*y for x,y in zip(z,b)) if v else 0)\n  marginal.append(sum(x*y for x,y in zip(z,mean)) if v else 0)\n return ordered,marginal\ncases=0\nfor n in (0,1,2,8,16,64,100):\n for identity in (True,False):\n  for _ in range(10):\n   a=[[rng.randrange(2) for _ in range(4)] for i in range(n)]\n   m=[]\n   for i in range(n):\n    c,b=rng.randrange(2),rng.randrange(2);m.append([1,c,b,c*b])\n   f=make_features(a,m,identity)\n   w=[[rng.uniform(-1,1) for _ in range(4)] for _ in range(20)]\n   o,h=routes(f,[1]*n,w)\n   zeros=[[0]*4 for _ in range(20)]\n   assert all(x==0 for r in routes(f,[1]*n,zeros) for x in r)\n   pad=3\n   fp=[[rng.random() for _ in range(20)] for _ in range(pad)]+f\n   op,hp=routes(fp,[0]*pad+[1]*n,w)\n   assert op[pad:]==o and hp[pad:]==h\n   # Preserve valid order while inserting invalid payloads in the middle.\n   mid=n//2;fh=f[:mid]+[[rng.random() for _ in range(20)]]+f[mid:]\n   oh,hh=routes(fh,[1]*mid+[0]+[1]*(n-mid),w)\n   assert oh[:mid]+oh[mid+1:]==o and hh[:mid]+hh[mid+1:]==h\n   perm=list(range(n));rng.shuffle(perm)\n   po,ph=routes([f[i] for i in perm],[1]*n,w)\n   assert all(abs(x-y)<1e-12 for x,y in zip(ph,[h[i] for i in perm]))\n   assert n\"'!=1 or o==h\n   # Inherited redistribution preserves signs and coefficient L1 mass.\n   base=[rng.uniform(-2,2) for i in range(n)]\n   gain=[1+math.tanh(x) for x in o]\n   bm=sum(abs(x) for x in base);g=[x*y for x,y in zip(base,gain)];gm=sum(abs(x) for x in g)\n   red=[x/gm*bm for x in g] if gm>0 else base\n   assert abs(sum(abs(x) for x in red)-bm)<1e-10\n   assert all(x*y>=0 for x,y in zip(base,red))\n   cases+=1\n# Constructed event swap changes a projected pool only for positional route.\nf=[[0]*20 for _ in range(2)];f[0][4]=1;f[1][4]=0\nw=[[0]*4 for _ in range(20)];w[4][0]=1\n(o,h)=routes(f,[1,1],w);(po,ph)=routes(list(reversed(f)),[1,1],w)\nassert o!=list(reversed(po)) and h==list(reversed(ph))\n# A controlled pooled readout with event features as values is order-sensitive.\npool=lambda feat,logits:sum(row[4]*(1+math.tanh(z)) for row,z in zip(feat,logits))\nassert abs(pool(f,o)-pool(list(reversed(f)),po))>1e-3\nassert abs(pool(f,h)-pool(list(reversed(f)),ph))<1e-12\n# Overlapping masks: collapse preserves sum and exposure, not union count.\nresolved=make_features([[1,1,0,0]],[[1,1,1,1]],True)[0]\ncollapsed=make_features([[1,1,0,0]],[[1,1,1,1]],False)[0]\nassert resolved[:4]==collapsed[:4]\nassert all(sum(resolved[j*4+k] for j in range(1,5))==sum(collapsed[j*4+k] for j in range(1,5)) for k in range(4))\nprint('\"'PASS',cases,'independent scalar cases: zero initialization, empty/single histories, padding payload/placement, marginal permutation invariance, L1 redistribution; constructed order-sensitive readout and overlapping-feedback collapse.')\nprint('No torch, BF16, host tensors, autograd, training or validation were executed; scalar checks do not establish model performance.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
