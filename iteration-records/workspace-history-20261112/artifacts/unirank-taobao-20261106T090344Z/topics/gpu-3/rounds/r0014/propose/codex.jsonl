" BASIS,\\n13: # WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\\n14: # See the License for the specific language governing permissions and\\n15: # limitations under the License.\\n16: # =========================================================================\\n17: \\n18: import json\\n19: import random\\n20: from collections import OrderedDict\\n21: \\n22: import numpy as np\\n23: import pandas as pd\\n24: import pyarrow.parquet as pq\\n25: import torch\\n26: from torch.utils.data import DataLoader, IterableDataset, get_worker_info\\n27: \\n28: from unirank.pytorch.torch_utils import build_batch_dict_from_tensor\\n29: from unirank.utils import (\\n30:     build_part_file_map,\\n31:     dataframe_to_darray,\\n32:     estimate_parquet_block_cost,\\n33:     find_meta_data_json,\\n34:     get_parquet_schema_names,\\n35:     resolve_side_info_path,\\n36: )\\n37: \\n38: \\n39: # ================================================================\\n40: # BlockedParquetBatchDataset\\n41: # ================================================================\\n42: \\n43: class BlockedParquetBatchDataset(IterableDataset):\\n44:     \\\"\\\"\\\"\\n45:     IterableDataset in blocked mode.\\n46: \\n47:     Features:\\n48:     - One block corresponds to a group:\\n49:         data/part-xxxxx.parquet\\n50:         user_info/part-xxxxx.parquet\\n51:         item_info/part-xxxxx.parquet\\n52:     - dataset reads data files in blocks\\n53:     - Yield an \\\"already batched\\\" payload each time to avoid mixing different blocks into the batch\\n54:     - The collator processes it based on the user/item side-info file in the payload.\\n55: \\n56:     DDP improvements:\\n57:     - Simple rank::world_size round-robin allocation is no longer used\\n58:     - Change to greedy balanced distribution based on block estimated load (cost) to reduce serious imbalances between ranks\\n59:     \\\"\\\"\\\"\\n60:     def __init__(self,\\n61:                  data_path,\\n62:                  user_info_path,\\n63:                  item_info_path,\\n64:                  columns=None,\\n65:                  batch_size=32,\\n66:                  shuffle=False,\\n67:                  distributed=False,\\n68:                  rank=0,\\n69:                  world_size=1,\\n70:                  drop_last=True):\\n71:         super().__init__()\\n72:         self.columns = columns\\n73:         self.batch_size = int(batch_size)\\n74:         self.shuffle = shuffle\\n75:         self.distributed = distributed\\n76:         self.rank = rank\\n77:         self.world_size = world_size\\n78:         self.drop_last = drop_last\\n79:         self.epoch = 0\\n80: \\n81:         self.data_part_map = build_part_file_map(data_path)\\n82:         self.user_part_map = build_part_file_map(user_info_path)\\n83:         self.item_part_map = build_part_file_map(item_info_path)\\n84: \\n85:         common_part_ids = sorted(\\n86:             set(self.data_part_map.keys())\\n87:             & set(self.user_part_map.keys())\\n88:             & set(self.item_part_map.keys())\\n89:         )\\n90:         if len(common_part_ids) == 0:\\n91:             raise ValueError(\\n92:                 \\\"No matched blocked parquet part ids across data/user_info/item_info.\\\\n\\\"\\n93:                 f\\\"data parts={sorted(self.data_part_map.keys())}\\\\n\\\"\\n94:                 f\\\"user parts={sorted(self.user_part_map.keys())}\\\\n\\\"\\n95:                 f\\\"item parts={sorted(self.item_part_map.keys())}\\\"\\n96:             )\\n97: \\n98:         self.blocks = []\\n99:         for pid in common_part_ids:\\n100:             data_file = self.data_part_map[pid]\\n101:             load_stat = estimate_parquet_block_cost(\\n102:                 data_file, seq_len_col=\\\"seq_len\\\", sample_rows=4096\\n103:             )\\n104: \\n105:             self.blocks.append(\\n106:                 {\\n107:                     \\\"part_id\\\": pid,\\n108:                     \\\"data_file\\\": data_file,\\n109:                     \\\"user_info_file\\\": self.user_part_map[pid],\\n110:                     \\\"item_info_file\\\": self.item_part_map[pid],\\n111:                     \\\"num_rows\\\": int(load_stat[\\\"num_rows\\\"]),\\n112:                     \\\"avg_seq_len\\\": load_stat[\\\"avg_seq_len\\\"],\\n113:                     \\\"cost\\\": float(load_stat[\\\"cost\\\"]),\\n114:                 }\\n115:             )\\n116: \\n117:         if self.distributed:\\n118:             self.rank_blocks, self.rank_loads = self._assign_blocks_greedily(self.blocks, self.world_size)\\n119:             self.rank_blocks = self.rank_blocks[self.rank]\\n120:             self.my_estimated_load = float(self.rank_loads[self.rank])\\n121:         else:\\n122:             self.rank_blocks = self.blocks\\n123:             self.rank_loads = [sum(float(blk[\\\"cost\\\"]) for blk in self.blocks)]\\n124:             self.my_estimated_load = float(self.rank_loads[0])\\n125: \\n126:         if len(self.rank_blocks) == 0:\\n127:             raise ValueError(\\n128:                 f\\\"No blocked parquet files assigned to rank={rank}. \\\"\\n129:                 f\\\"total_blocks={len(self.blocks)}, world_size={world_size}\\\"\\n130:             )\\n131: \\n132:         self.column_index = self._infer_column_index()\\n133:         self.block_row_counts = self._count_rows(self.rank_blocks)\\n134:         self.num_blocks = len(self.rank_blocks)\\n135:         self.num_samples = int(sum(self.block_row_counts.values()))\\n136:         self.num_batches = self._count_batches()\\n137: \\n138:         # Expose per-rank statistics for balance diagnostics.\\n139:         self.rank_num_rows = int(sum(int(blk[\\\"num_rows\\\"]) for blk in self.rank_blocks))\\n140:         self.rank_num_cost = float(sum(float(blk[\\\"cost\\\"]) for blk in self.rank_blocks))\\n141: \\n142:     def _assign_blocks_greedily(self, blocks, world_size):\\n143:         \\\"\\\"\\\"\\n144:         Sort by block cost from large to small, and then greedily assign it to the rank with the smallest current total load.\\n145:         \\\"\\\"\\\"\\n146:         sorted_blocks = sorted(blocks, key=lambda x: (x[\\\"cost\\\"], x[\\\"num_rows\\\"]), reverse=True)\\n147: \\n148:         rank_buckets = [[] for _ in range(world_size)]\\n149:         rank_loads = [0.0 for _ in range(world_size)]\\n150: \\n151:         for blk in sorted_blocks:\\n152:             target_rank = int(np.argmin(rank_loads))\\n153:             rank_buckets[target_rank].append(blk)\\n154:             rank_loads[target_rank] += float(blk[\\\"cost\\\"])\\n155: \\n156:         # Each rank is internally sorted by part_id to ensure stability.\\n157:         for r in range(world_size):\\n158:             rank_buckets[r] = sorted(rank_buckets[r], key=lambda x: x[\\\"part_id\\\"])\\n159: \\n160:         return rank_buckets, rank_loads\"\n}\n","exit_code":0,"status":"completed"}}
