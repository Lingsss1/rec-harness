n  \"version\": \"git:90bb99a60724e975ec565836266fd86dcad0039d\",\n  \"access_scope\": \"Full pinned benchmark source for inspection; not proof of equivalence to the original author method.\",\n  \"text_sha256\": \"3d9ba455a8b765bc778f1fa0dcd00d07680a0d9019e792371ef5346d90dd3e31\",\n  \"total_lines\": 467,\n  \"start_line\": 176,\n  \"next_line\": 266,\n  \"truncated\": false,\n  \"text\": \"176:         batch_dict, item_dict, mask = self.get_inputs(inputs)\\n177:         batch_size = mask.shape[0]\\n178:         item_seq_emb = self.embedding_layer(item_dict, flatten_emb=True)\\n179:         item_seq_emb = item_seq_emb.view(batch_size, -1)\\n180: \\n181:         user_context_emb = self.embedding_layer(batch_dict, flatten_emb=True)\\n182: \\n183:         feature_embeddings = torch.cat([user_context_emb, item_seq_emb], dim=-1)\\n184: \\n185:         unified_tokens = self.unified_tokenizer_layer(feature_embeddings)\\n186: \\n187:         unified_tokens = self.activation_checkpoint(\\n188:             self.unified_interaction_layers,\\n189:             unified_tokens\\n190:         )\\n191: \\n192:         bottom_output = unified_tokens.flatten(start_dim=1)\\n193:         tower_output = [self.tower[i](bottom_output) for i in range(self.num_tasks)]\\n194:         y_pred = [self.output_activation[i](tower_output[i]) for i in range(self.num_tasks)]\\n195: \\n196:         return_dict = {}\\n197:         labels = self.feature_map.labels\\n198:         for i in range(self.num_tasks):\\n199:             return_dict[f\\\"{labels[i]}_pred\\\"] = y_pred[i]\\n200:         return return_dict\\n201: \\n202: \\n203: class UniMixingLiteBlocks(nn.Module):\\n204:     def __init__(self,\\n205:                  token_dim,\\n206:                  num_token,\\n207:                  num_layers,\\n208:                  expand=2,\\n209:                  num_basis=4,\\n210:                  global_rank=4,\\n211:                  sinkhorn_iter=5,\\n212:                  sinkhorn_eps=1e-6,\\n213:                  tau_start=1.0,\\n214:                  tau_end=None,\\n215:                  tau_schedule=\\\"linear\\\",\\n216:                  tau_anneal_steps=None,\\n217:                  tau_warmup_steps=0,\\n218:                  use_out_proj=False,\\n219:                  use_local_coef_softmax=False,\\n220:                  use_tau_symmetry=True,\\n221:                  net_dropout=0.0):\\n222:         super(UniMixingLiteBlocks, self).__init__()\\n223:         self.num_token = int(num_token)\\n224:         self.token_dim = int(token_dim)\\n225:         self.num_layers = int(num_layers)\\n226: \\n227:         self.tau_start = float(tau_start)\\n228:         self.tau_end = float(tau_start if tau_end is None else tau_end)\\n229:         self.tau_schedule = str(tau_schedule).lower()\\n230:         self.tau_anneal_steps = None if tau_anneal_steps is None else int(tau_anneal_steps)\\n231:         self.tau_warmup_steps = int(tau_warmup_steps)\\n232: \\n233:         if self.tau_start <= 0 or self.tau_end <= 0:\\n234:             raise ValueError(\\\"tau_start and tau_end must be positive.\\\")\\n235: \\n236:         if self.tau_schedule not in [\\\"cosine\\\", \\\"linear\\\", \\\"exp\\\"]:\\n237:             raise ValueError(\\\"tau_schedule must be one of ['cosine', 'linear', 'exp'].\\\")\\n238: \\n239:         self.register_buffer(\\\"current_tau\\\", torch.tensor(self.tau_start, dtype=torch.float32))\\n240: \\n241:         self.mixers = nn.ModuleList([\\n242:             UniMixingLiteLayer(\\n243:                 token_dim=token_dim,\\n244:                 num_token=num_token,\\n245:                 num_basis=num_basis,\\n246:                 global_rank=global_rank,\\n247:                 sinkhorn_iter=sinkhorn_iter,\\n248:                 sinkhorn_eps=sinkhorn_eps,\\n249:                 tau=tau_start,\\n250:                 use_out_proj=use_out_proj,\\n251:                 use_local_coef_softmax=use_local_coef_softmax,\\n252:                 use_tau_symmetry=use_tau_symmetry,\\n253:                 net_dropout=net_dropout\\n254:             )\\n255:             for _ in range(num_layers)\\n256:         ])\\n257: \\n258:         self.pffns = nn.ModuleList([\\n259:             SiameseFeedForwardLayer(\\n260:                 token_dim=token_dim,\\n261:                 num_token=num_token,\\n262:                 expand=expand,\\n263:                 net_dropout=net_dropout\\n264:             )\\n265:             for _ in range(num_layers)\"\n}\n","exit_code":0,"status":"completed"}}
