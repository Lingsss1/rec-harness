SEP2)\\n182: \\n183:     def forward(self, user_context_emb, sequence_emb, target_emb, seq_mask=None):\\n184:         batch_size, T, _ = sequence_emb.shape\\n185:         device = sequence_emb.device\\n186:         F = self.user_feature_num\\n187: \\n188:         user_tokens = self.user_token_mlps(user_context_emb)\\n189:         seq_tokens = self.W_s(sequence_emb)\\n190:         target_tokens = self.W_i(target_emb)\\n191:         sep1 = self.SEP1.expand(batch_size, -1, -1)\\n192:         sep2 = self.SEP2.expand(batch_size, -1, -1)\\n193: \\n194:         tokens = torch.cat(\\n195:             [user_tokens, sep1, seq_tokens, sep2, target_tokens],\\n196:             dim=1,\\n197:         )\\n198: \\n199:         if seq_mask is None:\\n200:             seq_valid = torch.ones(batch_size, T, dtype=torch.bool, device=device)\\n201:         else:\\n202:             seq_valid = seq_mask.bool()\\n203:         valid_user = torch.ones(batch_size, F, dtype=torch.bool, device=device)\\n204:         valid_sep1 = torch.ones(batch_size, 1, dtype=torch.bool, device=device)\\n205:         valid_sep2 = torch.ones(batch_size, 1, dtype=torch.bool, device=device)\\n206:         valid_target = torch.ones(batch_size, 1, dtype=torch.bool, device=device)\\n207:         valid_mask = torch.cat(\\n208:             [valid_user, valid_sep1, seq_valid, valid_sep2, valid_target],\\n209:             dim=1,\\n210:         )\\n211:         return tokens, valid_mask\\n212: \\n213: \\n214: class UnifiedInteractionBlocks(nn.Module):\\n215:     def __init__(self,\\n216:                  token_dim,\\n217:                  num_full_layers,\\n218:                  window_size=[32, 16],\\n219:                  user_feature_num=0,\\n220:                  expand=2,\\n221:                  num_head=2,\\n222:                  net_dropout=0.0):\\n223:         super(UnifiedInteractionBlocks, self).__init__()\"\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport ast\nbase = Path('candidate.py').read_text()\nheader = '''\\\"\\\"\\\"Same-event target-field conjunctions, with a content/count 2x2 control.\n\nThe incumbent summarizes six item-field matches separately. Add summaries of\nall 15 unordered match pairs in the same five temporal bins. The joint source\nuses same-event intersections. The factorized source uses only the parent's\nmarginal counts and content sums. Content and count sources vary independently.\nEach pair has an equal-size zero-start projection and contributes to its two\nexisting relation tokens; no new downstream tokens or attention keys are added.\nAll inherited modules, initialization, masks, task heads and loss are retained.\nThis is an untested local representation hypothesis, not a novelty claim.\n\\\"\\\"\\\"'''\nbase = header + base[base.index('\\\\nimport math'):]\ndef replace_once(text, old, new):\n    assert text.count(old) == 1, (old[:80], text.count(old))\n    return text.replace(old, new, 1)\nbase = replace_once(base, \\\"    'memory_layout': 'collapsed',\\\\n}\\\", \\\"    'memory_layout': 'collapsed',\\\\n    'pair_content_source': 'joint',\\\\n    'pair_count_source': 'joint',\\\\n}\\\")\nbase = replace_once(base, \\\"                 memory_source='joint', memory_layout='collapsed',\\\\n                 num_tasks=None,\\\", \\\"                 memory_source='joint', memory_layout='collapsed',\\\\n                 pair_content_source='joint', pair_count_source='joint',\\\\n                 num_tasks=None,\\\")\nbase = replace_once(base, \\\"        self.feedback_content_mode = feedback_content_mode\\\", \\\"        if pair_content_source not in ('joint', 'factorized'):\\\\n            raise ValueError('Unknown pair content source')\\\\n        if pair_count_source not in ('joint', 'factorized'):\\\\n            raise ValueError('Unknown pair count source')\\\\n        self.pair_content_source = pair_content_source\\\\n        self.pair_count_source = pair_count_source\\\\n        self.feedback_content_mode = feedback_content_mode\\\")\nold = '''            self.feedback_memory = FeedbackMemory(\n                self.key_width, token_dim, num_heads, memory_source, memory_layout)\n        self.model_to_device()'''\nnew = '''            self.feedback_memory = FeedbackMemory(\n                self.key_width, token_dim, num_heads, memory_source, memory_layout)\n        # No constructor or random draw follows inherited initialization.\n        # Relation zero is global; pair indices address only the six fields.\n        pairs = [(left + 1, right + 1)\n                 for left in range(len(self.match_fields))\n                 for right in range(left + 1, len(self.match_fields))]\n        self.pair_bank = nn.Parameter(\n            torch.zeros(len(pairs), self.value_width + 1, token_dim))\n        self.register_buffer('pair_left', torch.tensor(\n            [left for left, right in pairs], dtype=torch.long))\n        self.register_buffer('pair_right', torch.tensor(\n            [right for left, right in pairs], dtype=torch.long))\n        routes = torch.zeros(len(pairs), self.group_count)\n        scale = 1.0 / math.sqrt(len(self.match_fields) - 1)\n        for index, (left, right) in enumerate(pairs):\n            routes[index, left] = scale\n            routes[index, right] = scale\n        self.register_buffer('pair_routes', routes)\n        self.model_to_device()'''\nbase = replace_once(base, old, new)\nmethod = '''    def _pair_tokens(self, values, weights, relation_masks, relation_counts,\n                     grouped):\n        \\\"\\\"\\\"Conjunctive content/counts versus symmetric marginal estimates.\n\n        Let n be temporal support, n_r a relation count, and S_r the parent's\n        signed content sum (scaled by sqrt(7)). The marginal estimates are\n        n_rs=n_r*n_s/n and S_rs=(n_s*S_r+n_r*S_s)/(2*n).\n        These controls use only information already in the parent. They are\n        approximations, not asserted data-generating independence models.\n        All arms compute both sources; parameters and contractions match.\n        \\\"\\\"\\\"\n        batch, length, _ = values.shape\n        if not length:\n            return values.new_zeros((batch, 5, self.group_count,\n                                     self.pair_bank.shape[-1]))\n        with torch.autocast(device_type=values.device.type, enabled=False):\n            left = relation_masks.index_select(2, self.pair_left)\n            right = relation_masks.index_select(2, self.pair_right)\n            joint_mask = left & right\n            joint_count = joint_mask.sum(dim=-1, keepdim=True).float()\n            pair_weights = joint_mask.float() * weights.float()[:, None, None, :]\n            joint_content = torch.bmm(pair_weights.flatten(1, 2), values.float())\n            joint_content = joint_content.reshape(\n                batch, 5, self.pair_bank.shape[0], self.value_width)\n            joint_content = joint_content / math.sqrt(self.group_count)\n            counts = relation_counts.float().unsqueeze(-1)\n            support = counts[:, :, :1, :].clamp_min(1.0)\n            left_count = counts.index_select(2, self.pair_left)\n            right_count = counts.index_select(2, self.pair_right)\n            factorized_count = left_count * right_count / support\n            left_content = grouped.float().index_select(2, self.pair_left)\n            right_content = grouped.float().index_select(2, self.pair_right)\n            factorized_content = 0.5 * (\n                (right_count / support) * left_content\n                + (left_count / support) * right_content)\n            content = (joint_content if self.pair_content_source == 'joint'\n                       else factorized_content)\n            count = (joint_count if self.pair_count_source == 'joint'\n                     else factorized_count)\n            log_count = torch.log1p(count) / math.log(101.0)\n            source = torch.cat([content, log_count], dim=-1)\n        # Summary accumulation is FP32. Projection follows host BF16 autocast,\n        # like the incumbent content banks. No signed denominator is used.\n        projected = torch.einsum('btpv,pvd->btpd', source, self.pair_bank)\n        return torch.einsum('btpd,pg->btgd', projected,\n                            self.pair_routes.to(projected.dtype))\n\n'''\nbase = replace_once(base, '    def _feedback_source(self, joint, factorized, total):', method + '    def _feedback_source(self, joint, factorized, total):')\nbase = replace_once(base, '''        slot_tokens = slot_tokens + feedback_tokens.to(slot_tokens.dtype)\n        slot_tokens = slot_tokens.flatten(1, 2)''', '''        slot_tokens = slot_tokens + feedback_tokens.to(slot_tokens.dtype)\n        pair_tokens = self._pair_tokens(values, weights, relation_masks,\n                                        relation_counts, grouped)\n        slot_tokens = slot_tokens + pair_tokens.to(slot_tokens.dtype)\n        slot_tokens = slot_tokens.flatten(1, 2)''')\nvariants = [\n    ('candidate.py', 'joint', 'joint'),\n    ('pair_joint_content.py', 'joint', 'factorized'),\n    ('pair_joint_counts.py', 'factorized', 'joint'),\n    ('pair_marginal_control.py', 'factorized', 'factorized'),\n]\nfor filename, content, count in variants:\n    source = base.replace(\\\"'pair_content_source': 'joint'\\\", f\\\"'pair_content_source': '{content}'\\\").replace(\\\"'pair_count_source': 'joint'\\\", f\\\"'pair_count_source': '{count}'\\\")\n    source = source.replace(\\\"pair_content_source='joint', pair_count_source='joint'\\\", f\\\"pair_content_source='{content}', pair_count_source='{count}'\\\")\n    ast.parse(source)\n    Path(filename).write_text(source)\n    print(filename, len(source), content, count)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
