ng_layer(batch_dict, flatten_emb=False)\\n143:         c_orgs_raw = torch.cat([ns_emb, target_emb.view(batch_size, -1, self.embedding_dim)], dim=1)\\n144:         c_orgs, c_hubs = self.unified_tokenizer_layer(c_orgs_raw)\\n145: \\n146:         # --- Group 3: Task Tokens ---\\n147:         t_orgs = self.task_orgs.expand(batch_size, -1, -1)\\n148:         t_shared = self.task_shared_hubs.expand(batch_size, -1, -1)\\n149: \\n150:         # Update Tokens and Hubs through multi-layer stacked INFNetBlocks\\n151:         t_orgs = self.activation_checkpoint(\\n152:             self.unified_interaction_layers,\\n153:             c_orgs,\\n154:             s_orgs,\\n155:             t_orgs,\\n156:             c_hubs,\\n157:             s_hubs,\\n158:             t_shared,\\n159:             mask\\n160:         )\\n161: \\n162:         # --- Multi-Task Prediction ---\\n163:         tower_output = [self.tower[i](t_orgs[:, i, :]) for i in range(self.num_tasks)]\\n164:         y_pred = [self.output_activation[i](tower_output[i]) for i in range(self.num_tasks)]\\n165: \\n166:         return_dict = {}\\n167:         labels = self.feature_map.labels\\n168:         for i in range(self.num_tasks):\\n169:             return_dict[\\\"{}_pred\\\".format(labels[i])] = y_pred[i]\\n170:         return return_dict\\n171: \\n172: \\n173: class INFNetCategoricalTokenizer(nn.Module):\\n174:     def __init__(self, embedding_dim, token_dim, num_c_hub_token, num_field, expansion_factor=4):\\n175:         super(INFNetCategoricalTokenizer, self).__init__()\\n176:         input_dim = num_field * embedding_dim\\n177:         self.c_hub_mlps = AutoSplitTokenizer(input_dim, token_dim, num_c_hub_token)\\n178:         self.c_org_mlps = FieldWiseTokenizer(embedding_dim, token_dim, num_field)\\n179: \\n180:     def forward(self, c_orgs_raw):\\n181:         B = c_orgs_raw.size(0)\\n182:         c_hubs_flat = c_orgs_raw.view(B, -1)\\n183:         c_orgs = self.c_org_mlps(c_orgs_raw)\\n184:         c_hubs = self.c_hub_mlps(c_hubs_flat)\\n185:         return c_orgs, c_hubs\\n186: \\n187: \\n188: class INFNetBlocks(nn.Module):\\n189:     \\\"\\\"\\\"INFNet core module that manages multi-layer stacking: including Phase 1 (Aggregation) and Phase 2 (Broadcast)\\\"\\\"\\\"\\n190: \\n191:     def __init__(self, num_layers, token_dim, num_c_hubs, num_s_hubs, num_t_hubs, expansion_factor=4):\\n192:         super(INFNetBlocks, self).__init__()\\n193:         self.num_layers = num_layers\\n194: \\n195:         # Use nn.ModuleList to stack multiple layers of Aggregation and Broadcast respectively\\n196:         self.aggregation_layers = nn.ModuleList([\\n197:             Aggregation(token_dim) for _ in range(num_layers)\\n198:         ])\\n199:         self.broadcast_layers = nn.ModuleList([\\n200:             Broadcast(token_dim, num_c_hubs, num_s_hubs, num_t_hubs, expansion_factor)\\n201:             for _ in range(num_layers)\\n202:         ])\\n203: \\n204:     def forward(self, c_orgs, s_orgs, t_orgs, c_hubs, s_hubs, t_shared, s_mask=None):\\n205:         # Equation (4): Task Hubs are composed of Specific and Shared\\n206:         t_hubs = torch.cat([t_orgs, t_shared], dim=1)\\n207:         # Iterative update layer by layer\\n208:         for i in range(self.num_layers):\\n209:             # Phase 1: Multi-View Global Aggregation\\n210:             c_hubs, s_hubs, t_hubs = self.aggregation_layers[i](\"\n}\n","exit_code":0,"status":"completed"}}
