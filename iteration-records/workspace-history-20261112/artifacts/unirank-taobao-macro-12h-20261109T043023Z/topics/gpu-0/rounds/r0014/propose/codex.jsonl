{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport ast, copy, hashlib, importlib.util, itertools, json, math, random, subprocess\nfrom pathlib import Path\nroot=Path('/workspace')\np=json.loads((root/'proposal.json').read_text())\nruntime=json.loads(subprocess.check_output(['python3','/workspace/tools.py','resolve','run://r-001'],text=True))\ndef validate(v,s,path='\"'$'\"'):\n    typ=s.get('type')\n    if typ=='object':\n        assert isinstance(v,dict),path\n        assert not set(s.get('required',[]))-v.keys(),path\n        if s.get('additionalProperties') is False: assert not v.keys()-s.get('properties',{}).keys(),path\n        for k,item in v.items():\n            if k in s.get('properties',{}): validate(item,s['properties'][k],path+'.'+k)\n    elif typ=='array':\n        assert isinstance(v,list) and len(v)>=s.get('minItems',0),path\n        for i,x in enumerate(v): validate(x,s['items'],path+'['+str(i)+']')\n    elif typ=='string': assert isinstance(v,str) and len(v)>=s.get('minLength',0),path\n    if 'enum' in s: assert v in s['enum'],path\n    if 'const' in s: assert v==s['const'],path\nvalidate(p['study'],runtime['study_schema'])\nassert p['study']['protocol_ref']==runtime['required_study_protocol_ref']\nallowed=runtime['context']['allowed_observation_ids']\nassert p['parent_trial'] in allowed\nassert set(p['study']['evidence_refs'])<=set(allowed)\nassert 1<=len(p['variants'])<=4\nassert any(v['role']=='candidate' for v in p['variants'])\nassert len({v['name'] for v in p['variants']})==len(p['variants'])\nassert len({v['file'] for v in p['variants']})==len(p['variants'])\ncovered={a['knowledge_id'] for a in p['knowledge_assessments']}\nprior_industry={a['knowledge_id'] for a in runtime['context']['latest_knowledge_usage']['assessments']}\nassert prior_industry<=covered\nfor a in p['knowledge_assessments']:\n    assert a['decision'] in ('used','considered','rejected','unresolved')\n    assert set(['knowledge_id','decision','rationale','transformed_mechanism','variant_names','nearest_work_difference','falsifier'])<=a.keys()\nassert hashlib.sha256((root/'baseline_reference.py').read_bytes()).hexdigest()=='f4b473cbacf60d72cff90f3721ad754dd617ee6065fe3fca2fc9cd4be2b25c36'\nancestor=(root/'history_g0_r0013_pair_joint_both.py').read_text()\nassert hashlib.sha256(ancestor.encode()).hexdigest()=='f966e51f5fb851dca64a3dd03bee4a69fce138a491ba8e96b7381d3d3db39578'\ndef methods(tree):\n    return {(c.name,m.name):m for c in tree.body if isinstance(c,ast.ClassDef) for m in c.body if isinstance(m,ast.FunctionDef)}\ndef config(tree):\n    return ast.literal_eval(next(n.value for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets)))\ndef dump(n): return ast.dump(n,include_attributes=False)\nold_methods=methods(ast.parse(ancestor))\nnormalized=[]\nfor v in p['variants']:\n    path=root/v['file']\n    assert Path(v['file']).name==v['file'] and path.suffix=='.py'\n    src=path.read_text()\n    tree=ast.parse(src)\n    compile(src,str(path),'exec')\n    assert config(tree)==v['config']\n    current=methods(tree)\n    ctor=current['Model','__init__']\n    defaults=dict(zip([a.arg for a in ctor.args.args][-len(ctor.args.defaults):],ctor.args.defaults))\n    for key,value in v['config'].items():\n        default=ast.literal_eval(defaults[key])\n        assert list(default) == value if isinstance(default,tuple) else default==value,(v['name'],key)\n    unchanged=[]\n    for key,node in old_methods.items():\n        if key not in [('Model','__init__'),('Model','_pair_tokens')]:\n            assert dump(node)==dump(current[key]),key\n            unchanged.append(key)\n    # No new parameter/module initializer call; only torch.zeros for the bool selector.\n    old_calls=[dump(n) for n in ast.walk(old_methods['Model','__init__']) if isinstance(n,ast.Call) and (isinstance(n.func,ast.Attribute) and (getattr(n.func.value,'id',None)=='nn' or n.func.attr in ['reset_parameters','fork_rng','normal_','zeros_']))]\n    new_calls=[dump(n) for n in ast.walk(ctor) if isinstance(n,ast.Call) and (isinstance(n.func,ast.Attribute) and (getattr(n.func.value,'id',None)=='nn' or n.func.attr in ['reset_parameters','fork_rng','normal_','zeros_']))]\n    assert old_calls==new_calls\n    for n in ast.walk(tree):\n        if isinstance(n,(ast.Import,ast.ImportFrom)):\n            names=[a.name for a in n.names] if isinstance(n,ast.Import) else [n.module]\n            assert all(name.split('.')[0] in ['math','torch','unirank'] for name in names)\n        if isinstance(n,ast.Call) and isinstance(n.func,ast.Name): assert n.func.id not in ['open','exec','eval','__import__']\n    assert 'torch.where(self.pair_defining_coordinates[None, None],' in src\n    normalized_tree=copy.deepcopy(tree)\n    for n in normalized_tree.body:\n        if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets): n.value=ast.Constant(value=None)\n    nm=methods(normalized_tree)['Model','__init__']\n    for i,a in enumerate(nm.args.args[-len(nm.args.defaults):]):\n        if a.arg in ['pair_defining_source','pair_other_source']: nm.args.defaults[i]=ast.Constant(value=None)\n    normalized.append(dump(normalized_tree))\n    print(v['name']+': syntax, CONFIG/signature, imports, '+str(len(unchanged))+' inherited methods and parameter/init-call structure PASS; SHA256 '+hashlib.sha256(src.encode()).hexdigest())\nassert len(set(normalized))==1\nassert {(v['config']['pair_defining_source'],v['config']['pair_other_source']) for v in p['variants']}==set(itertools.product(['joint','factorized'],repeat=2))\npairs=list(itertools.combinations(range(6),2))\n# Check coordinate slices at actual width and multiple legal embedding widths.\nfor emb in [1,2,3,16]:\n    width=7*emb\n    for left,right in pairs:\n        defining=[False]*width\n        for relation in (left+1,right+1):\n            start=(relation-1)*emb\n            defining[start:start+emb]=[True]*emb\n        assert sum(defining)==2*emb\n        assert not any(defining[6*emb:])\n        assert all(defining[k]==(k//emb in (left,right)) for k in range(width))\n# Independent scalar oracle of summaries and selector; this does not execute PyTorch.\nrng=random.Random(14027)\nchecks=0\nfor case in range(200):\n    length=case%13\n    emb=2\n    width=14\n    ids=[[rng.randrange(6) for f in range(6)] for i in range(length)]\n    target=[rng.randrange(6) for f in range(6)]\n    valid=[rng.random()>.25 for _ in range(length)]\n    weights=[rng.uniform(-3,3) if rng.random()>.1 else 0.0 for _ in range(length)]\n    table=[[[rng.uniform(-2,2) if code else 0.0 for d in range(emb)] for code in range(6)] for f in range(6)]\n    values=[sum([table[f][row[f]] for f in range(6)],[])+[rng.uniform(-2,2) for _ in range(emb)] for row in ids]\n    ranks=[]; count=0\n    for active in valid:\n        ranks.append(count)\n        count+=int(active)\n    bins=[valid]+[[v and min(3,4*r//max(1,count))==b for v,r in zip(valid,ranks)] for b in range(4)]\n    for temporal in bins:\n        support=sum(temporal)\n        for left,right in pairs:\n            ml=[v and target[left]>0 and row[left]==target[left] for v,row in zip(temporal,ids)]\n            mr=[v and target[right]>0 and row[right]==target[right] for v,row in zip(temporal,ids)]\n            mj=[a and b for a,b in zip(ml,mr)]\n            def weighted(mask): return [sum(w*val[k] for w,val,a in zip(weights,values,mask) if a)/math.sqrt(7) for k in range(width)]\n            joint=weighted(mj); sl=weighted(ml); sr=weighted(mr)\n            factor=[.5*(sum(mr)/max(1,support)*x+sum(ml)/max(1,support)*y) for x,y in zip(sl,sr)]\n            defining=[k//emb in (left,right) for k in range(width)]\n            outputs={}\n            for ds,os in itertools.product(['joint','factorized'],repeat=2):\n                dv=joint if ds=='joint' else factor\n                ov=joint if os=='joint' else factor\n                outputs[ds,os]=[dv[k] if defining[k] else ov[k] for k in range(width)]\n            assert outputs['joint','joint']==joint\n            assert outputs['factorized','factorized']==factor\n            for k in range(width):\n                assert math.isclose(outputs['joint','joint'][k]-outputs['joint','factorized'][k]-outputs['factorized','joint'][k]+outputs['factorized','factorized'][k],0,abs_tol=1e-12)\n            mass=sum(w for w,a in zip(weights,mj) if a)/math.sqrt(7)\n            for field in (left,right):\n                for d in range(emb):\n                    assert math.isclose(joint[field*emb+d],mass*table[field][target[field]][d],rel_tol=1e-10,abs_tol=1e-10)\n            if not support: assert joint==factor==[0.0]*width\n            checks+=1\n# Disjoint match masks must have zero joint content even with nonzero marginals.\nml=[1,0]; mr=[0,1]; vals=[[1,2],[3,4]]\nassert not any(a and b for a,b in zip(ml,mr))\nassert [.25*(a+b) for a,b in zip(vals[0],vals[1])]==[1,1.5]\nprint('Study schema, allowed evidence, six prior card assessments, frozen hashes, complete factorial and normalized source equality: PASS')\nprint('Independent scalar oracle: 200 cases / '+str(checks)+' pair-bin comparisons; empty/sparse/signed masks, coordinate partition, homogeneous corners and target-copy identity: PASS')\nprint('Torch installed:',importlib.util.find_spec('torch') is not None)\nprint('Actual tensor forward/backward, BF16, masking perturbations, checkpoint equivalence and measured cost remain HOST-PENDING; no training or installations performed.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
