1,\n  \"next_line\": 186,\n  \"truncated\": false,\n  \"text\": \"111:         self.model_to_device()\\n112: \\n113:     def forward(self, inputs):\\n114:         batch_dict, item_dict, mask = self.get_inputs(inputs)\\n115:         batch_size = mask.shape[0]\\n116:         item_seq_emb = self.embedding_layer(item_dict, flatten_emb=True)\\n117:         item_seq_emb = item_seq_emb.view(batch_size, -1, self.item_info_dim)\\n118: \\n119:         target_emb = item_seq_emb[:, -1, :]      # B x item_info_dim\\n120:         sequence_emb = item_seq_emb[:, 0:-1, :]  # B x T x item_info_dim\\n121: \\n122:         seq_pooling_emb = self.attention_layers(target_emb, sequence_emb, mask)\\n123: \\n124:         # Other non-sequential features -> NS tokens\\n125:         user_context_emb = self.embedding_layer(batch_dict, flatten_emb=False)\\n126:         feature_embeddings = torch.cat([user_context_emb,\\n127:                                         target_emb.view(batch_size, -1, self.embedding_dim),\\n128:                                         seq_pooling_emb.view(batch_size, -1, self.embedding_dim)], dim=1)\\n129:         unified_tokens = self.unified_tokenizer_layer(feature_embeddings)\\n130: \\n131:         # unified model\\n132:         unified_tokens = self.activation_checkpoint(\\n133:             self.unified_interaction_layers,\\n134:             unified_tokens\\n135:         )\\n136: \\n137:         # use task tokens for task-specific towers\\n138:         task_tokens = unified_tokens[:, self.num_field:, :]  # [B, num_tasks, token_dim]\\n139:         tower_output = [self.tower[i](task_tokens[:, i, :]) for i in range(self.num_tasks)]\\n140:         y_pred = [self.output_activation[i](tower_output[i]) for i in range(self.num_tasks)]\\n141:         return_dict = {}\\n142:         labels = self.feature_map.labels\\n143:         for i in range(self.num_tasks):\\n144:             return_dict[\\\"{}_pred\\\".format(labels[i])] = y_pred[i]\\n145:         return return_dict\\n146: \\n147: \\n148: class HiFormerTokenizer(nn.Module):\\n149:     def __init__(self, input_dim, token_dim, num_tokens, num_tasks):\\n150:         super(HiFormerTokenizer, self).__init__()\\n151:         self.task_tokens = nn.init.xavier_uniform_(\\n152:             nn.Parameter(torch.empty(1, num_tasks, token_dim))\\n153:         )\\n154:         self.token_mlps = FieldWiseTokenizer(input_dim, token_dim, num_tokens)\\n155: \\n156:     def forward(self, feature_embeddings):\\n157:         tokens = self.token_mlps(feature_embeddings)\\n158:         task_tokens = self.task_tokens.expand(tokens.size(0), -1, -1)\\n159:         return torch.cat([tokens, task_tokens], dim=1)\\n160: \\n161: \\n162: class HiFormerBlocks(nn.Module):\\n163:     def __init__(self,\\n164:                  token_dim,\\n165:                  num_token,\\n166:                  num_layers,\\n167:                  expand=2,\\n168:                  num_heads=2,\\n169:                  qkv_rank=256,\\n170:                  net_dropout=0.0):\\n171:         super(HiFormerBlocks, self).__init__()\\n172:         self.num_layers = num_layers\\n173:         self.mixer_norms = nn.ModuleList([\\n174:             nn.LayerNorm(token_dim)\\n175:             for _ in range(num_layers)\\n176:         ])\\n177:         self.pffn_norms = nn.ModuleList([\\n178:             nn.LayerNorm(token_dim)\\n179:             for _ in range(num_layers)\\n180:         ])\\n181: \\n182:         self.mixer_layers = nn.ModuleList([\\n183:             HiformerAttentionLayer(token_dim=token_dim,\\n184:                                         num_token=num_token,\\n185:                                         num_heads=num_heads,\"\n}\n","exit_code":0,"status":"completed"}}
