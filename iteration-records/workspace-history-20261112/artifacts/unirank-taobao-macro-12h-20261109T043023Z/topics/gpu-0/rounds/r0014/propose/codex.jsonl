 pair_count_source \"'!= '\"'joint':\n            raise ValueError('Coordinate study freezes joint pair counts')\n        self.pair_defining_source = pair_defining_source\n        self.pair_other_source = pair_other_source\n        self.pair_count_source = pair_count_source\n\\\"\\\"\\\"\nassert source.count(old)==1\nsource=source.replace(old,new)\nold=\\\"\\\"\\\"        self.register_buffer('pair_routes', routes)\n        self.model_to_device()\n\\\"\\\"\\\"\nnew=\\\"\\\"\\\"        self.register_buffer('pair_routes', routes)\n        # Fixed coordinate partition, constructed without any RNG draws.\n        # Pair indices are relation indices (zero is the global relation).\n        # Values concatenate item_fields in exactly this order, then action.\n        # The action block is always in the complementary coordinate group.\n        defining = torch.zeros(len(pairs), self.value_width, dtype=torch.bool)\n        for index, (left, right) in enumerate(pairs):\n            for relation in (left, right):\n                start = (relation - 1) * embedding_dim\n                defining[index, start:start + embedding_dim] = True\n        self.register_buffer('pair_defining_coordinates', defining)\n        self.model_to_device()\n\\\"\\\"\\\"\nassert source.count(old)==1\nsource=source.replace(old,new)\nold=\\\"\\\"\\\"        These controls use only information already in the parent. They are\n        approximations, not asserted data-generating independence models.\n        All arms compute both sources; parameters and contractions match.\n\\\"\\\"\\\"\nnew=\\\"\\\"\\\"        These controls use only the parent's marginal summaries. They are\n        approximations, not asserted data-generating independence models.\n        Independently select J or F for the two pair-defining item blocks\n        versus the other four item blocks plus action. Do not zero a block:\n        every coordinate remains active, and the joint count is held fixed.\n        All arms compute both sources; parameters and contractions match.\n\\\"\\\"\\\"\nassert source.count(old)==1\nsource=source.replace(old,new)\nold=\\\"\\\"\\\"            content = (joint_content if self.pair_content_source == 'joint'\n                       else factorized_content)\n\\\"\\\"\\\"\nnew=\\\"\\\"\\\"            defining_content = (joint_content\n                                if self.pair_defining_source == 'joint'\n                                else factorized_content)\n            other_content = (joint_content\n                             if self.pair_other_source == 'joint'\n                             else factorized_content)\n            # Broadcast [1,1,pairs,value_width] over batch and temporal bins.\n            # Homogeneous corners copy the original FP32 source exactly;\n            # torch.where introduces no subtract/re-add cancellation.\n            content = torch.where(self.pair_defining_coordinates[None, None],\n                                  defining_content, other_content)\n\\\"\\\"\\\"\nassert source.count(old)==1\nsource=source.replace(old,new)\nassert 'pair_content_source' not in source\nproposal=json.loads((root/'proposal.json').read_text())\nfor v in proposal['variants']:\n    text=source.replace(\\\"    'pair_defining_source': 'factorized',\\\", \\\"    'pair_defining_source': %r,\\\" % v['config']['pair_defining_source'])\n    text=text.replace(\\\"    'pair_other_source': 'joint',\\\", \\\"    'pair_other_source': %r,\\\" % v['config']['pair_other_source'])\n    text=text.replace(\\\"                 pair_defining_source='factorized', pair_other_source='joint',\\\", \\\"                 pair_defining_source=%r, pair_other_source=%r,\\\" % (v['config']['pair_defining_source'],v['config']['pair_other_source']))\n    (root/v['file']).write_text(text)\n    print(v['name'], v['file'],len(text))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
