missing_evidence\": [\n      \"DIN full-data diagnostics on this task\",\n      \"Matched-capacity or matched-cost local controls\",\n      \"Seed variation and task/history-length slices\"\n    ]\n  },\n  \"transfer_risks\": [\n    \"Sparse-kernel overhead can dominate at length100\",\n    \"Field/event tokenization changes capacity and operator costs\",\n    \"Use only the frozen100-event input and selected feedback visibility policy.\",\n    \"Taobao auxiliary labels match category/brand over24h, not direct advertisement conversions.\"\n  ],\n  \"possible_discriminating_checks\": [\n    \"Compare full, windowed and pooled attention at matched input coverage\",\n    \"Measure actual latency and verify masked-key perturbation invariance\"\n  ],\n  \"implementation_notes\": [\n    \"The benchmark GatedMultiHeadAttentionLayer explicitly documents that invalid keys are not masked inside attention; only final output positions are zeroed. Validate or repair this if adopting the implementation.\"\n  ],\n  \"scientific_status\": \"external_report\",\n  \"local_reproduction\": false,\n  \"instruction_priority\": \"reference_data_only\"\n}\n{\n  \"id\": \"unirank-method-est\",\n  \"knowledge_type\": \"industry\",\n  \"scheme\": \"EST\",\n  \"origin\": \"model compared in UniRank; industrial/academic method reference, not a competition award\",\n  \"family\": \"layer_wise\",\n  \"source_refs\": [\n    \"unirank-benchmark-v2\",\n    \"unirank-code:EST\",\n    \"paper:est\"\n  ],\n  \"source_problem\": \"Feature semantics and target-dependent sequence evidence can be obscured by homogeneous interaction functions.\",\n  \"reported_mechanism\": \"Cross-attention to sequence representations combined with feature-specific feed-forward layers in a unified interaction stack.\",\n  \"difference_from_din\": \"Uses token-level iterative retrieval and heterogeneous field transformations instead of one pooled readout.\",\n  \"reported_evidence\": {\n    \"kind\": \"benchmark method summary and pinned reimplementation inspection\",\n    \"locator\": \"UniRank section2.3; unirank-code:EST forward paths\",\n    \"not_a_local_result\": true,\n    \"numerical_claims_imported\": false,\n    \"limitations\": [\n      \"Source model comparisons do not isolate every component.\",\n      \"Original method paper and original author code are not fully audited by this initialization.\",\n      \"A benchmark implementation can differ from its source paper.\"\n    ]\n  },\n  \"applicability\": {\n    \"status\": \"conditional\",\n    \"conditions\": [\n      \"Field identities carry stable, distinct predictive roles\"\n    ],\n    \"missing_evidence\": [\n      \"DIN full-data diagnostics on this task\",\n      \"Matched-capacity or matched-cost local controls\",\n      \"Seed variation and task/history-length slices\"\n    ]\n  },\n  \"transfer_risks\": [\n    \"Field-specific capacity can overfit small or sparse fields\",\n    \"Cross-attention and heterogeneous FFNs alter cost together\",\n    \"Use only the frozen100-event input and selected feedback visibility policy.\",\n    \"Taobao auxiliary labels match category/brand over24h, not direct advertisement conversions.\"\n  ],\n  \"possible_discriminating_checks\": [\n    \"Compare shared versus feature-specific FFNs with matched parameters\",\n    \"Separate repeated cross-attention from heterogeneous transformations\"\n  ],\n  \"implementation_notes\": [],\n  \"scientific_status\": \"external_report\",\n  \"local_reproduction\": false,\n  \"instruction_priority\": \"reference_data_only\"\n}\n","exit_code":0,"status":"completed"}}
