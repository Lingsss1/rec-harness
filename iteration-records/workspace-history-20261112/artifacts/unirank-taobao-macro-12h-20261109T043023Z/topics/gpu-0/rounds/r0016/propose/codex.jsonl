oat() * rank_weights\n            joint_moment = torch.bmm(joint_weights.flatten(1, 2), values.float())\n            joint_moment = joint_moment.reshape(\n                batch, 5, self.pair_bank.shape[0], self.value_width)\n            joint_moment = joint_moment / math.sqrt(self.group_count)\n            marginal_weights = relation_masks.float() * rank_weights\n            marginal_moment = torch.bmm(marginal_weights.flatten(1, 2), values.float())\n            marginal_moment = marginal_moment.reshape(\n                batch, 5, self.group_count, self.value_width)\n            marginal_moment = marginal_moment / math.sqrt(self.group_count)\n            left_moment = marginal_moment.index_select(2, self.pair_left)\n            right_moment = marginal_moment.index_select(2, self.pair_right)\n            marginal = 0.5 * ((right_count / support) * left_moment\n                              + (left_count / support) * right_moment)\n            if self.pair_rank_source == 'marginal':\n                source = marginal\n            elif self.pair_rank_source == 'copy':\n                source = joint_content\n            else:\n                source = joint_moment\n        # FP32 accumulation followed by the same host-autocast contraction\n        # as the inherited pair bank. The copy cell is an active duplicate\n        # projection; zero is only a replay check, not a capacity control.\n        projected = torch.einsum('btpv,pvd->btpd', source, self.pair_rank_bank)\n        if self.pair_rank_source == 'zero':\n            projected = projected * 0.0\n        return torch.einsum('btpd,pg->btgd', projected,\n                            self.pair_routes.to(projected.dtype))\n\n    def _feedback_source\\\"\\\"\\\"\nassert source.count(old)==1\nsource=source.replace(old,new)\nsource=source.replace(\\\"                                        relation_counts)\\\\n\\\", \\\"                                        relation_counts, content_mask)\\\\n\\\")\n# Inherited methods 