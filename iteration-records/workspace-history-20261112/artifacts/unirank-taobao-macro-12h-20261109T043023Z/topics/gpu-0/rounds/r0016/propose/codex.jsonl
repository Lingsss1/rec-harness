se k for k,d in zip(idx,a))[n-len(self.shape):]\n   ib=tuple(0 if d==1 else k for k,d in zip(idx,b))[n-len(other.shape):]\n   data.append(fn(self.at(ia),other.at(ib)))\n  return T(data,shape)\n def __add__(self,o):return self.op(o,lambda a,b:a+b)\n __radd__=__add__\n def __sub__(self,o):return self.op(o,lambda a,b:a-b)\n def __mul__(self,o):return self.op(o,lambda a,b:a*b)\n __rmul__=__mul__\n def __truediv__(self,o):return self.op(o,lambda a,b:a/b)\n def float(self):return self\n def long(self):return T((int(x) for x in self.data),self.shape)\n def to(self,*a,**k):return self\n def square(self):return T((x*x for x in self.data),self.shape)\n def sqrt(self):return T((math.sqrt(x) for x in self.data),self.shape)\n def clamp_min(self,v):return T((max(x,v) for x in self.data),self.shape)\n def cumsum(self,dim):\n  dim%=len(self.shape)\n  return T((sum(self.at(idx[:dim]+(j,)+idx[dim+1:]) for j in range(idx[dim]+1)) for idx in coords(self.shape)),self.shape)\n def sum(self,dim,keepdim=False):\n  dim%=len(self.shape);shape=self.shape[:dim]+((1,) if keepdim else ())+self.shape[dim+1:];data=[]\n  for idx in coords(shape):\n   reduced=idx[:dim]+idx[dim+1:] if keepdim else idx\n   data.append(sum(self.at(reduced[:dim]+(j,)+reduced[dim:]) for j in range(self.shape[dim])))\n  return T(data,shape)\n def flatten(self,start,end):\n  shape=self.shape[:start]+(math.prod(self.shape[start:end+1]),)+self.shape[end+1:]\n  return T(self.data,shape)\n def reshape(self,*shape):return T(self.data,shape)\n def index_select(self,dim,indices):\n  shape=self.shape[:dim]+(len(indices.data),)+self.shape[dim+1:]\n  return T((self.at(idx[:dim]+(int(indices.data[idx[dim]]),)+idx[dim+1:]) for idx in coords(shape)),shape)\nclass Torch:\n def autocast(self,**kw):return contextlib.nullcontext()\n def bmm(self,a,b):\n  n,m,k=a.shape;bn,bk,d=b.shape;assert n==bn and k==bk\n  return T((sum(a.at((i,j,q))*b.at((i,q,z)) for q in range(k)) for i,j,z in coords((n,m,d))),(n,m,d))\n def einsum(self,eq,a,b):\n  if