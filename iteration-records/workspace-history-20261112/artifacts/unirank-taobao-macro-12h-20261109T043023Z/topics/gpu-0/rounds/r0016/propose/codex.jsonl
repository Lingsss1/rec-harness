ff.append(cs)\n  matches=[[bool(valid[i][k]) and (g==0 or rng.random()<.4) for k in range(L)] for g in range(G)]\n  relation.append([[[tm[t][k] and matches[g][k] for k in range(L)] for g in range(G)] for t in range(5)])\n values=[[[rng.uniform(-3,3) for _ in range(V)] for k in range(L)] for i in range(B)];weights=[[rng.uniform(-2,2) for k in range(L)] for i in range(B)]\n rt=T([x for i in relation for t in i for g in t for x in g],(B,5,G,L));tt=T([x for i in temporal for t in i for x in t],(B,5,L));vt=T([x for i in values for k in i for x in k],(B,L,V));wt=T([x for i in weights for x in i],(B,L))\n got_c=obj._moment_coefficients(tt);expected_c=[x for i in coeff for t in i for x in t]\n assert all(abs(x-y)<1e-12 for x,y in zip(got_c.data,expected_c))\n jm=[];jc=[];lc=[];rc=[];support=[];sources={m:[] for m in ('joint','marginal','copy')}\n for i,t in coords((B,5)):\n  n=sum(temporal[i][t]);support.append(max(1,n))\n  for p,(left,right) in enumerate(pairs):\n   mask=[relation[i][t][left][k] and relation[i][t][right][k] for k in range(L)];jm.extend(mask)\n   nl=sum(relation[i][t][left]);nr=sum(relation[i][t][right]);lc.append(nl);rc.append(nr)\n   for v in range(V):\n    def sm(g,rank):return sum(relation[i][t][g][k]*weights[i][k]*(coeff[i][t][k] if rank else 1)*values[i][k][v] for k in range(L))/math.sqrt(G)\n    copy=sum(mask[k]*weights[i][k]*values[i][k][v] for k in range(L))/math.sqrt(G);jc.append(copy)\n    joint=sum(mask[k]*weights[i][k]*coeff[i][t][k]*values[i][k][v] for k in range(L))/math.sqrt(G)\n    marginal=.5*(nr*sm(left,True)+nl*sm(right,True))/max(1,n)\n    sources['joint'].append(joint);sources['marginal'].append(marginal);sources['copy'].append(copy)\n args=[vt,wt,rt,tt,T(jm,(B,5,P,L)),T(jc,(B,5,P,V)),T(lc,(B,5,P,1)),T(rc,(B,5,P,1)),T(support,(B,5,1,1))]\n for mode in ('joint','marginal','copy','zero'):\n  obj.pair_rank_source=mode;got=env['_pair_rank_tokens'](obj,*args);assert got.shape==(B,5,G,D)\n  src=T(sources['joint' if mode=='zero' else mode],(B