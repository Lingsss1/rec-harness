{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport ast, itertools, math, random, types\nfrom pathlib import Path\n# Execute the production helper with a small standard-library tensor oracle.\n# This checks its indexing/broadcasting algebra; it is not a PyTorch test.\ndef indices(shape):return itertools.product(*(range(n) for n in shape))\nclass T:\n def __init__(self,shape,data):self.shape=tuple(shape); self.data=dict(data)\n def float(self):return T(self.shape,{i:float(v) for i,v in self.data.items()})\n def sum(self,dim,keepdim):\n  dim%=len(self.shape); shape=list(self.shape); shape[dim]=1\n  out={i:0.0 for i in indices(shape)}\n  for i,v in self.data.items():\n   dst=list(i);dst[dim]=0;out[tuple(dst)]+=v\n  return T(shape,out)\n def clamp_min(self,x):return T(self.shape,{i:max(v,x) for i,v in self.data.items()})\n def index_select(self,dim,idx):\n  shape=list(self.shape);shape[dim]=len(idx)\n  def source(i):j=list(i);j[dim]=idx[i[dim]];return tuple(j)\n  return T(shape,{i:self.data[source(i)] for i in indices(shape)})\n def __getitem__(self,key):\n  assert key==(slice(None),slice(None),None,slice(None))\n  return T((self.shape[0],self.shape[1],1,self.shape[2]),{(i[0],i[1],0,i[2]):v for i,v in self.data.items()})\n def binary(self,other,op):\n  if not isinstance(other,T):other=T((),{():other})\n  rank=max(len(self.shape),len(other.shape));a=(1,)*(rank-len(self.shape))+self.shape;b=(1,)*(rank-len(other.shape))+other.shape\n  assert all(x==y or x==1 or y==1 for x,y in zip(a,b))\n  shape=tuple(y if x==1 else x for x,y in zip(a,b))\n  def get(t,pad,i):\n   z=tuple(0 if n==1 else j for n,j in zip(pad,i));return t.data[z[rank-len(t.shape):]]\n  return T(shape,{i:op(get(self,a,i),get(other,b,i)) for i in indices(shape)})\n def __mul__(self,o):return self.binary(o,lambda x,y:x*y)\n __rmul__=__mul__\n def __add__(self,o):return self.binary(o,lambda x,y:x+y)\n def __truediv__(self,o):return self.binary(o,lambda x,y:x/y)\ntree=ast.parse(Path('candidate.py').read_text());cls=next(n for n in tree.body if isinstance(n,ast.ClassDef) and n.name=='Model');helper=next(n for n in cls.body if isinstance(n,ast.FunctionDef) and n.name=='_select_pair_rank_component')\nns={};exec(compile(ast.Module(body=[helper],type_ignores=[]),'production_helper','exec'),ns);fn=ns[helper.name]\npairs=list(itertools.combinations(range(1,7),2));left=[p[0] for p in pairs];right=[p[1] for p in pairs]\nrng=random.Random(78231); checked=0; diff=0\nfor length in [0,1,2,5,9]:\n shape=(2,5,7,length);relation={i:bool(rng.randrange(2)) for i in indices(shape)}\n # Include empty, identical-support and subset cases explicitly.\n for b in range(2):\n  for t in range(5):\n   for l in range(length):\n    if t==0:relation[(b,t,1,l)]=False\n    if t==1:relation[(b,t,2,l)]=relation[(b,t,1,l)]\n    if t==2:relation[(b,t,2,l)]=relation[(b,t,1,l)] and bool(l%2)\n q={(b,t,l):float(2*l-length+1) for b,t,l in indices((2,5,length))}\n pm={(b,t,p,l):relation[(b,t,x,l)] and relation[(b,t,y,l)] for b,t,p,l in indices((2,5,15,length)) for x,y in [pairs[p]]}\n content={}\n for b,t,p,v in indices((2,5,15,3)):\n  content[(b,t,p,v)]=sum(((-1)**l)*(v+1)*(l+1) for l in range(length) if pm[(b,t,p,l)])\n outputs={}\n for mode in ['joint','marginal']:\n  self=types.SimpleNamespace(pair_centroid_source=mode,pair_left=left,pair_right=right)\n  out=fn(self,None,T((2,5,15,3),content),T((2,5,15,length),pm),T((2,5,length),q),T(shape,relation));outputs[mode]=out\n  for (b,t,p,v),actual in out.data.items():\n   x,y=pairs[p];joint=[l for l in range(length) if pm[(b,t,p,l)]]\n   def mean(ls):return sum(q[(b,t,l)] for l in ls)/max(len(ls),1)\n   centroid=mean(joint) if mode=='joint' else .5*(mean([l for l in range(length) if relation[(b,t,x,l)]])+mean([l for l in range(length) if relation[(b,t,y,l)]]))\n   expected=centroid*content[(b,t,p,v)]\n   assert math.isfinite(actual) and math.isclose(actual,expected,abs_tol=1e-10)\n   if not joint:assert actual==0\n   if t==1 and p==0:assert math.isclose(outputs['joint'].data[(b,t,p,v)],actual,abs_tol=1e-10)\n   checked+=1\n diff+=sum(abs(outputs['joint'].data[i]-outputs['marginal'].data[i])>1e-10 for i in outputs['joint'].data)\nassert diff>0\nprint('PASS: production helper checked against independent scalar oracle:',checked,'values;',diff,'nontrivial source differences.')\nprint('Covered empty sequences, empty conjunction with populated marginals, singleton, identical and nested relations, signed/cancelling content, and finite zero-support output. No torch forward/backward or GPU validation performed.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
