{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport difflib\nprint(''.join(difflib.unified_diff(Path('history_g1_r0006_hybrid_none.py').read_text().splitlines(True),Path('candidate.py').read_text().splitlines(True),fromfile='committed hybrid_none',tofile='candidate.py')))\nPY\"","aggregated_output":"/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n--- committed hybrid_none\n+++ candidate.py\n@@ -1,22 +1,18 @@\n-\"\"\"g0 representation with g1-inspired evolving-query terminal retrieval.\n-\n-The committed g0 representation and towers are preserved. Four task queries\n-seeded by the final g0 state make two narrow reads, then pool wide values with\n-a terminal same-field match prior as in the committed g1 source. A zero-start\n-output adds that evidence to each tower's existing global pooled-value slice.\n-All four arms own and execute the same new modules. Only terminal prior\n-routing changes: adaptive, uniform, cyclically rotated, or none. This is a\n-compatibility experiment and local adaptation, with no originality claim.\n-\n-All incumbent factorized feedback and relation paths remain. The added memory\n-has 20 slots: global/four rank bins by four historical feedback masks. Choose\n-actual feedback-selected item content or rate-times-unconditional content;\n-keep four content vectors or broadcast their mean. Individual counts, slot\n-identities, validity, constructors and attention are identical in every arm.\n-Existing field/relation tokens read this memory before their JointBlock.\n-The new residual output starts at zero; inherited initialization is retained.\n-Behavior pooling and proxy cross-attention are related to INFNet. This is a\n-local adaptation and discriminating follow-up, with no originality claim.\n+\"\"\"Structured-state query refinement on the committed g0/g1 hybrid.\n+\n+Two narrow query-refinement reads address the final g0 field/relation tokens,\n+not the raw event stream. The final wide-value read still addresses exactly\n+the masked raw events. Learned versus uniform structured-state addressing is\n+crossed with adaptive versus absent terminal field-match prior. No modules,\n+parameters, inherited representations, task towers or training loss are added.\n+The existing zero-start output preserves the inherited g0 starting function.\n+\n+Exact historical event-memory behavior remains available as query_memory=\n+'events' for host parity checks. This is a local compatibility follow-up, not\n+an originality claim or a reproduction of a complete external architecture.\n+Strict masks and null handling follow the imported hybrid. Uniform routing is\n+an active content control with a different functional restriction, not equal\n+expressive capacity. Effective backward cost must be measured on the host.\n \"\"\"\n import math\n import torch\n@@ -46,6 +42,7 @@\n     'memory_source': 'joint',\n     'memory_layout': 'separate',\n     'terminal_prior': 'none',\n+    'query_memory': 'state_adaptive',\n }\n \n \n@@ -87,6 +84,32 @@\n         mixed = F.scaled_dot_product_attention(\n             query, key, value, attn_mask=valid[:, None, None, :],\n             dropout_p=0.0, is_causal=False)\n+        mixed = mixed.transpose(1, 2).contiguous().reshape(batch, count, width)\n+        return self.output(mixed)\n+\n+    def read_state(self, query, memory, valid, uniform=False):\n+        \"\"\"Read intact g0 tokens using shared Q/K/V and exact key masks.\n+\n+        Both arms calculate learned and uniform weights. Uniform is over\n+        valid tokens, never padded tokens; the null is used only if empty.\n+        Q/K remain active in terminal pooling and task mixing in every arm.\n+        FP32 logits/softmax are common to both structured-memory controls.\n+        \"\"\"\n+        batch, count, width = query.shape\n+        query = self._project(self.query_norm(query), self.query)\n+        memory, extended_valid = self._memory(memory, valid)\n+        key = self._project(memory, self.key)\n+        value = self._project(memory, self.value)\n+        with torch.autocast(device_type=query.device.type, enabled=False):\n+            logits = torch.matmul(query.float(), key.float().transpose(-2, -1))\n+            logits = logits / math.sqrt(self.head_width)\n+            logits = logits.masked_fill(~extended_valid[:, None, None, :], float('-inf'))\n+            adaptive = torch.softmax(logits, dim=-1)\n+            key_weights = extended_valid.float()\n+            key_weights = key_weights / key_weights.sum(dim=-1, keepdim=True).clamp_min(1.0)\n+            uniform_weights = adaptive * 0.0 + key_weights[:, None, None, :]\n+            weights = uniform_weights if uniform else adaptive\n+        mixed = torch.matmul(weights.to(value.dtype), value)\n         mixed = mixed.transpose(1, 2).contiguous().reshape(batch, count, width)\n         return self.output(mixed)\n \n@@ -143,16 +166,15 @@\n \n \n class TerminalRetrieval(nn.Module):\n-    \"\"\"Only four task queries retain sequence-wide reads within the cost cap.\n-\n-    Queries derive from the g0 final valid-token mean, rather than reproducing\n-    g1's full field stream. Events are read-only as in g1's committed setting.\n-    The low-rank value path and nonaffine normalization follow g1; an extra\n-    zero-start residual output preserves the exact g0 starting function.\n+    \"\"\"Four evolving queries refine against g0 state, then pool raw events.\n+\n+    g0 tokens and events are read-only on this path. The historical event\n+    memory is retained as an exact implementation control, not a new arm.\n     \"\"\"\n \n-    def __init__(self, value_width, width, heads, tasks, prior):\n+    def __init__(self, value_width, width, heads, tasks, prior, query_memory):\n         super().__init__()\n+        self.query_memory = query_memory\n         self.event_projection = nn.Linear(value_width, width, bias=False)\n         self.history_position = nn.Parameter(torch.empty(101, width))\n         self.task_identity = nn.Parameter(torch.empty(1, tasks, width))\n@@ -176,7 +198,13 @@\n         events = self.event_projection(values) + self.history_position[rank]\n         events = torch.where(valid.unsqueeze(-1), events, torch.zeros_like(events))\n         for mixer in self.after_read:\n-            states = mixer(states + 0.5 * self.read(states, events, valid))\n+            if self.query_memory == 'events':\n+                evidence = self.read(states, events, valid)\n+            else:\n+                evidence = self.read.read_state(\n+                    states, tokens, token_valid,\n+                    uniform=self.query_memory == 'state_uniform')\n+            states = mixer(states + 0.5 * evidence)\n         states = self.final_norm(states)\n         summary = self.read.pool_values(states, events, values, valid,\n                                         match_fields, matches)\n@@ -323,6 +351,7 @@\n                  content_bank_mode='relation', feedback_content_mode='factorized',\n                  memory_source='joint', memory_layout='separate',\n                  terminal_prior=CONFIG['terminal_prior'],\n+                 query_memory=CONFIG['query_memory'],\n                  num_tasks=None,\n                  task='binary_classification', **kwargs):\n         if num_tasks is not None and num_tasks != len(feature_map.labels):\n@@ -371,6 +400,8 @@\n             raise ValueError('Unknown memory layout')\n         if terminal_prior not in ('adaptive', 'uniform', 'rotated', 'none'):\n             raise ValueError('Unknown terminal match prior')\n+        if query_memory not in ('events', 'state_adaptive', 'state_uniform'):\n+            raise ValueError('Unknown query refinement memory')\n         self.feedback_content_mode = feedback_content_mode\n         self.content_bank_mode = content_bank_mode\n         self.bank_mode = bank_mode\n@@ -474,7 +505,7 @@\n         with torch.random.fork_rng(devices=[]):\n             self.terminal_retrieval = TerminalRetrieval(\n                 self.value_width, token_dim, num_heads, len(feature_map.labels),\n-                terminal_prior)\n+                terminal_prior, query_memory)\n         self.terminal_fields = [name for name in self.item_fields if name in\n                                 ('item_id', 'cate_id', 'campaign_id', 'customer_id', 'brand')]\n         if len(self.terminal_fields) != 5:\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport subprocess,json\nfor ref in ['trial://baseline-din','trial://g0-r0011-memory_joint_separate','trial://g1-r0004-match_terminal_only','trial://g1-r0006-hybrid_none','trial://g1-r0006-hybrid_adaptive','trial://g1-r0006-hybrid_uniform','trial://g1-r0006-hybrid_rotated']:\n p=subprocess.run(['python3','tools.py','resolve',ref],capture_output=True,text=True)\n assert p.returncode==0,(ref,p.stderr)\n v=json.loads(p.stdout)\n print(ref, 'resolved;', 'keys:',','.join(v.keys()))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
