nit.args.args.pop()\nnew_init.body=[n for n in new_init.body if not(isinstance(n,ast.Assign) and any(isinstance(x,ast.Attribute) and x.attr=='query_memory' for x in n.targets))]\nassert dump(old_init)==dump(new_init)\nprint('Terminal module/parameter constructors and RNG order unchanged')\nf=copy.deepcopy(methods(b['TerminalRetrieval'])['forward'])\nloop=next(n for n in f.body if isinstance(n,ast.For))\nbranch=loop.body[0]\nassert isinstance(branch,ast.If) and len(loop.body)==2\n# Reduce events compatibility path to exactly the original expression.\nassign=branch.body[0];original_mixer=loop.body[1]\nclass InlineEvidence(ast.NodeTransformer):\n def visit_Name(self,node):\n  if node.id=='evidence':return copy.deepcopy(assign.value)\n  return node\nloop.body=[InlineEvidence().visit(original_mixer)]\nassert dump(f)==dump(methods(a['TerminalRetrieval'])['forward'])\nprint('events compatibility branch AST reproduces exact historical TerminalRetrieval.forward')\n# Validate full supplied study schema recursively without additional packages.\nr=json.loads(subprocess.check_output(['python3','tools.py','resolve','run://r-001'],text=True))\np=json.loads(Path('proposal.json').read_text())\ndef check(v,s,path='study'):\n typ=s.get('type')\n if typ=='object':\n  assert isinstance(v,dict),path\n  assert set(s.get('required',[]))<=set(v),path\n  if s.get('additionalProperties') is False:assert set(v)<=set(s.get('properties',{})),path\n  for k,x in v.items():\n   if k in s.get('properties',{}):check(x,s['properties'][k],path+'.'+k)\n elif typ=='array':\n  assert isinstance(v,list) and len(v)>=s.get('minItems',0),path\n  for i,x in enumerate(v):check(x,s.get('items',{}),path+'['+str(i)+']')\n elif typ=='string':assert isinstance(v,str) and len(v)>=s.get('minLength',0),path\n if 'enum' in s:assert v in s['enum'],path\n if 'const' in s:assert v==s['const'] and type(v)==type(s['const']),path\ncheck(p['study'],r['study_schema'])\nprint('Full recursive study schema type/enum/const/required