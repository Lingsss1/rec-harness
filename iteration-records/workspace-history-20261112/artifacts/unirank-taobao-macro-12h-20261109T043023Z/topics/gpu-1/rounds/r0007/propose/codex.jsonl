{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nsource=Path('candidate.py').read_text()\nold_doc=source[:source.index('import math')]\nnew_doc='''\\\"\\\"\\\"Structured-state query refinement on the committed g0/g1 hybrid.\n\nTwo narrow query-refinement reads address the final g0 field/relation tokens,\nnot the raw event stream. The final wide-value read still addresses exactly\nthe masked raw events. Learned versus uniform structured-state addressing is\ncrossed with adaptive versus absent terminal field-match prior. No modules,\nparameters, inherited representations, task towers or training loss are added.\nThe existing zero-start output preserves the inherited g0 starting function.\n\nExact historical event-memory behavior remains available as query_memory=\n'events' for host parity checks. This is a local compatibility follow-up, not\nan originality claim or a reproduction of a complete external architecture.\nStrict masks and null handling follow the imported hybrid. Uniform routing is\nan active content control with a different functional restriction, not equal\nexpressive capacity. Effective backward cost must be measured on the host.\n\\\"\\\"\\\"\n'''\nsource=new_doc+source[len(old_doc):]\nsource=source.replace(\\\"    'terminal_prior': 'none',\\\\n}\\\",\\\"    'terminal_prior': 'none',\\\\n    'query_memory': 'state_adaptive',\\\\n}\\\",1)\nneedle='    def _match_bias(self, query, match_fields, matches):\\\\n'\nmethod='''    def read_state(self, query, memory, valid, uniform=False):\n        \\\"\\\"\\\"Read intact g0 tokens using shared Q/K/V and exact key masks.\n\n        Both arms calculate learned and uniform weights. Uniform is over\n        valid tokens, never padded tokens; the null is used only if empty.\n        Q/K remain active in terminal pooling and task mixing in every arm.\n        FP32 logits/softmax are common to both structured-memory controls.\n        \\\"\\\"\\\"\n        batch, count, width = query.shape\n        query = self._project(self.query_norm(query), self.query)\n        memory, extended_valid = self._memory(memory, valid)\n        key = self._project(memory, self.key)\n        value = self._project(memory, self.value)\n        with torch.autocast(device_type=query.device.type, enabled=False):\n            logits = torch.matmul(query.float(), key.float().transpose(-2, -1))\n            logits = logits / math.sqrt(self.head_width)\n            logits = logits.masked_fill(~extended_valid[:, None, None, :], float('-inf'))\n            adaptive = torch.softmax(logits, dim=-1)\n            key_weights = extended_valid.float()\n            key_weights = key_weights / key_weights.sum(dim=-1, keepdim=True).clamp_min(1.0)\n            uniform_weights = adaptive * 0.0 + key_weights[:, None, None, :]\n            weights = uniform_weights if uniform else adaptive\n        mixed = torch.matmul(weights.to(value.dtype), value)\n        mixed = mixed.transpose(1, 2).contiguous().reshape(batch, count, width)\n        return self.output(mixed)\n\n'''\nassert source.count(needle)==1\nsource=source.replace(needle,method+needle)\nsource=source.replace('''    \\\"\\\"\\\"Only four task queries retain sequence-wide reads within the cost cap.\n\n    Queries derive from the g0 final valid-token mean, rather than reproducing\n    g1's full field stream. Events are read-only as in g1's committed setting.\n    The low-rank value path and nonaffine normalization follow g1; an extra\n    zero-start residual output preserves the exact g0 starting function.\n    \\\"\\\"\\\"\n\n    def __init__(self, value_width, width, heads, tasks, prior):\n        super().__init__()\n''','''    \\\"\\\"\\\"Four evolving queries refine against g0 state, then pool raw events.\n\n    g0 tokens and events are read-only on this path. The historical event\n    memory is retained as an exact implementation control, not a new arm.\n    \\\"\\\"\\\"\n\n    def __init__(self, value_width, width, heads, tasks, prior, query_memory):\n        super().__init__()\n        self.query_memory = query_memory\n''',1)\nold='''        for mixer in self.after_read:\n            states = mixer(states + 0.5 * self.read(states, events, valid))\n'''\nnew='''        for mixer in self.after_read:\n            if self.query_memory == 'events':\n                evidence = self.read(states, events, valid)\n            else:\n                evidence = self.read.read_state(\n                    states, tokens, token_valid,\n                    uniform=self.query_memory == 'state_uniform')\n            states = mixer(states + 0.5 * evidence)\n'''\nassert source.count(old)==1\nsource=source.replace(old,new)\nsource=source.replace(\\\"                 terminal_prior=CONFIG['terminal_prior'],\\\\n\\\", \\\"                 terminal_prior=CONFIG['terminal_prior'],\\\\n                 query_memory=CONFIG['query_memory'],\\\\n\\\",1)\nneedle=\\\"        self.feedback_content_mode = feedback_content_mode\\\\n\\\"\nsource=source.replace(needle,\\\"        if query_memory not in ('events', 'state_adaptive', 'state_uniform'):\\\\n            raise ValueError('Unknown query refinement memory')\\\\n\\\"+needle,1)\nsource=source.replace('''                terminal_prior)\n        self.terminal_fields''','''                terminal_prior, query_memory)\n        self.terminal_fields''',1)\nassert 'self.query_memory = query_memory' in source\nassert \\\"query_memory=CONFIG['query_memory']\\\" in source\nPath('candidate.py').write_text(source)\nfor filename,memory,prior in [\n ('state_adaptive_prior.py','state_adaptive','adaptive'),\n ('state_uniform_none.py','state_uniform','none'),\n ('state_uniform_prior.py','state_uniform','adaptive')]:\n variant=source.replace(\\\"    'query_memory': 'state_adaptive',\\\",f\\\"    'query_memory': '{memory}',\\\",1)\n variant=variant.replace(\\\"    'terminal_prior': 'none',\\\",f\\\"    'terminal_prior': '{prior}',\\\",1)\n Path(filename).write_text(variant)\nprint('Wrote four standalone model modules; no model execution or training.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
