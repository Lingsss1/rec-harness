_click\": 0.25,\n        \"cart\": 0.25,\n        \"fav\": 0.25,\n        \"buy\": 0.25\n      },\n      \"primary\": \"macro_auc\",\n      \"direction\": \"maximize\",\n      \"tie_breakers\": [\n        \"macro_logloss ascending\",\n        \"parameters ascending\",\n        \"trial_id ascending\"\n      ],\n      \"missing_task\": \"invalid; never average only the available tasks\",\n      \"regression_policy\": \"Report each task's AUC and Logloss change against the reference and entry model; explain trade-offs in topic decisions. No undeclared per-task veto threshold.\",\n      \"test_policy\": \"Selection uses validation only; freeze before a single held-out assessment. Historical completed test suites remain unchanged.\"\n    }\n  },\n  \"implementation_boundary\": {\n    \"agent_editable\": [\n      \"candidate model modules\",\n      \"candidate training-loss hook\",\n      \"prospective experiment plans\",\n      \"evidence-linked agent knowledge\"\n    ],\n    \"host_owned\": [\n      \"raw data identities\",\n      \"causal feature construction and split policy\",\n      \"labels and scorers\",\n      \"resource ledger\",\n      \"held-out execution\",\n      \"read-only knowledge snapshots\"\n    ],\n    \"candidate_interface\": \"Defined by the task adapter at freeze time; must return prediction logits/probabilities with fixed sample identity and information boundary.\",\n    \"protocol_change\": \"Requires a new version and rerun of affected references before any new comparison; no silent changes during search.\"\n  },\n  \"final_assessment\": {\n    \"selection\": \"validation only\",\n    \"freeze\": [\n      \"candidate source/config/checkpoint hashes\",\n      \"selected candidates\",\n      \"closest references\",\n      \"key ablations and matched controls\",\n      \"repetition seeds\",\n      \"assessment commands\"\n    ],\n    \"repetitions\": \"Target three paired seeds for the final candidate and closest controls when budget permits; record omitted repetitions and retain single-seed conclusions as preliminary.\",\n    \"test\": \"Unavailable in this operational rerun; evaluate validation repetitions only. Closed assessment outputs are not authorized research inputs.\",\n    \"failure\": \"Retain failed assessment receipts; unknown execution state does not authorize automatic duplicate testing.\"\n  },\n  \"deliverables\": [\n    \"best supported model code/configuration and executable reproduction commands\",\n    \"problem and mechanism hypothesis\",\n    \"closest-work difference and inherited parts\",\n    \"baseline/candidate/ablation/cost tables\",\n    \"all experiment records including failures\",\n    \"updated scene-scoped agent knowledge\",\n    \"boundaries, unresolved questions and next hypotheses\"\n  ],\n  \"readiness_gates\": [\n    \"Verify pinned released parquet digests\",\n    \"Audit actual loader fields/labels/prefix semantics\",\n    \"Resolve and freeze visibility policy\",\n    \"Pass forward/backward/masking tests\",\n    \"Measure DIN full-unit cost\",\n    \"Freeze protocol before research\"\n  ],\n  \"baseline_role\": {\n    \"model\": \"DIN\",\n    \"purpose\": \"Initial empirical reference and calibration point for predictive quality, diagnostics and compute cost.\",\n    \"architectural_inheritance_required\": false,\n    \"final_model_family\": \"Open; selected from evidence and may be a completely different architecture.\",\n    \"later_comparisons\": \"Use the initial reference and the closest successful architectural alternatives or controls as the research progresses.\"\n  },\n  \"architecture_search\": {\n    \"scope\": \"Whole-model design, including replacement of the initial network and all internal representations.\",\n    \"design_dimensions\": [\n      \"Representation units: fields, events, behavior groups, learned slots and target/task tokens.\",\n      \"Information flow: stacked interaction, layer-wise joint interaction, parallel exchange, learned routing or other testable unified structures.\",\n      \"History selection/compression jointly designed with target/context-conditioned retrieval.\",\n      \"Derived features computed from authorized inputs: field matches, behavior counts/composition, grouping and sequence positions.\",\n      \"Shared and task-conditioned representations, prediction readouts and registered training-loss mechanisms.\"\n    ],\n    \"lineage\": \"parent_trial identifies a comparison and evidence lineage; it does not require code or architectural inheritance. inherited_components may be empty when the whole model is replaced.\",\n    \"proposal_unit\": \"A coherent mechanism hypothesis can require several coordinated structural changes. Build that structure and plan component, replacement or factorial controls to identify where its value comes from.\",\n    \"evidence\": \"Select by the equal-weight validation AUC mean across click, cart, favorite and purchase; report macro Logloss and every task change. Use that same rule for checkpoints, parents, topic gains, merge eligibility and final selection. Evaluate mechanism support, nearest-work differences and measured cost; compare closest architectural alternatives and the initial reference.\",\n    \"fixed_contracts\": \"Available sample information, labels, data split, scoring, resource accounting and the frozen host training recipe remain shared. Internal architecture and readout design are candidate choices.\",\n    \"reference_use\": \"UniRank comparison methods provide inspectable design references and nearest work. Agents choose and adapt mechanisms from local evidence.\"\n  },\n  \"protocol_hash\": \"427fc51900560816321ba9bbc170639eb26625972df75b22e3c47d523c363748\",\n  \"research_topic\": {\n    \"title\": \"Compatibility of representation construction and sequence-field interaction\",\n    \"question\": \"Under the frozen inputs and training protocol, does combining the committed g0 representation approach with the g1 interaction approach improve validation four-task macro ROC-AUC over both frozen source bests, particularly g0 at 0.8301982212762624, at justified parameter and measured compute cost?\",\n    \"hypothesis\": \"Inherit the two committed source approaches, subject to implementation inspection in the next phase. The adaptive/uniform and rotation contrast observed in g1 may retain useful information on g0's stronger representation, but representation changes may already capture that information or introduce interference. Source replacement/factorial and matched-capacity controls, followed by repetition, must distinguish complementary utility from extra capacity and optimization effects. A repeatable gain over both frozen source bests with justified measured cost would support compatibility; failure to exceed the stronger source, or gains reproduced by capacity controls, would oppose added utility for the tested implementation. Source gains are not additive, and repeated seeds alone do not identify a mechanism. Use validation for selection, then freeze the comparison suite before one withheld assessment; do not use withheld outcomes to revise the topic.\",\n    \"id\": \"g1-t001\",\n    \"status\": \"active\",\n    \"source_topic_ids\": [\n      \"g0-t000\",\n      \"g1-t000\"\n    ],\n    \"entry_trial_id\": \"g0-r0011-memory_joint_separate\",\n    \"entry_auc\": 0.8301982212762624,\n    \"import_trial_refs\": [\n      \"g0-r0011-memory_joint_separate\",\n      \"g1-r0004-match_terminal_only\"\n    ]\n  }\n}\n","exit_code":0,"status":"completed"}}
