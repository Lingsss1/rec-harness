  \"buy\": 0.25\n      },\n      \"primary\": \"macro_auc\",\n      \"direction\": \"maximize\",\n      \"tie_breakers\": [\n        \"macro_logloss ascending\",\n        \"parameters ascending\",\n        \"trial_id ascending\"\n      ],\n      \"missing_task\": \"invalid; never average only the available tasks\",\n      \"regression_policy\": \"Report each task's AUC and Logloss change against the reference and entry model; explain trade-offs in topic decisions. No undeclared per-task veto threshold.\",\n      \"test_policy\": \"Selection uses validation only; freeze before a single held-out assessment. Historical completed test suites remain unchanged.\"\n    },\n    \"final_assessment_scope\": \"validation only; no test scores or predictions are supplied\"\n  },\n  \"study_schema\": {\n    \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n    \"title\": \"Task-independent prospective mechanism study\",\n    \"type\": \"object\",\n    \"additionalProperties\": false,\n    \"required\": [\n      \"id\",\n      \"protocol_ref\",\n      \"evidence_refs\",\n      \"question\",\n      \"hypothesis\",\n      \"nearest_work\",\n      \"inherited_components\",\n      \"proposed_difference\",\n      \"predictions\",\n      \"falsifiers\",\n      \"alternative_explanations\",\n      \"contrasts\",\n      \"cost_plan\"\n    ],\n    \"properties\": {\n      \"id\": {\n        \"type\": \"string\",\n        \"minLength\": 1\n      },\n      \"protocol_ref\": {\n        \"type\": \"string\",\n        \"minLength\": 1\n      },\n      \"evidence_refs\": {\n        \"type\": \"array\",\n        \"minItems\": 1,\n        \"items\": {\n          \"type\": \"string\"\n        }\n      },\n      \"question\": {\n        \"type\": \"string\",\n        \"minLength\": 1\n      },\n      \"hypothesis\": {\n        \"type\": \"string\",\n        \"minLength\": 1\n      },\n      \"nearest_work\": {\n        \"type\": \"array\",\n        \"minItems\": 1,\n        \"items\": {\n          \"type\": \"object\",\n          \"additionalProperties\": false,\n          \"required\": [\n            \"source_ref\",\n            \"verification\",\n            \"difference\"\n          ],\n          \"properties\": {\n            \"source_ref\": {\n              \"type\": \"string\"\n            },\n            \"verification\": {\n              \"enum\": [\n                \"discovered\",\n                \"read\",\n                \"archived\",\n                \"implementation_checked\"\n              ]\n            },\n            \"difference\": {\n              \"type\": \"string\",\n              \"minLength\": 1\n            }\n          }\n        }\n      },\n      \"inherited_components\": {\n        \"type\": \"array\",\n        \"items\": {\n          \"type\": \"string\"\n        }\n      },\n      \"proposed_difference\": {\n        \"type\": \"string\",\n        \"minLength\": 1\n      },\n      \"predictions\": {\n        \"type\": \"array\",\n        \"minItems\": 1,\n        \"items\": {\n          \"type\": \"string\"\n        }\n      },\n      \"falsifiers\": {\n        \"type\": \"array\",\n        \"minItems\": 1,\n        \"items\": {\n          \"type\": \"string\"\n        }\n      },\n      \"alternative_explanations\": {\n        \"type\": \"array\",\n        \"minItems\": 1,\n        \"items\": {\n          \"type\": \"string\"\n        }\n      },\n      \"contrasts\": {\n        \"type\": \"array\",\n        \"minItems\": 1,\n        \"items\": {\n          \"type\": \"object\",\n          \"additionalProperties\": false,\n          \"required\": [\n            \"parent_ref\",\n            \"intervention\",\n            \"control\",\n            \"held_fixed\",\n            \"remaining_confounds\",\n            \"decision_if_supported\",\n            \"decision_if_not_supported\"\n          ],\n          \"properties\": {\n            \"parent_ref\": {\n              \"type\": \"string\"\n            },\n          