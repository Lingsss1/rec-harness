{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport ast\nroot=Path('/workspace')\nsource=(root/'history_g1_r0007_state_uniform_none.py').read_text()\n(root/'incumbent_replay.py').write_text(source)\ndoc='''\\\"\\\"\\\"Replacement controls for the source of the g0/g1 hybrid gain.\n\nThe committed g0 representation, towers, masks, initialization and all branch\nparameters are retained. Controls replace only retrieval-state content or the\nwide-value summary supplied to the existing low-rank normalized residual.\nAll narrow reads and event-attention scores are still computed. Thus nominal\ncapacity and common forward work are matched, but functional capacity and\nbackward cost differ; no efficiency improvement is claimed without pruning\nand a separate measured comparison. This is an attribution study, not a new\nattention method or an external-model reproduction.\n\\\"\\\"\\\"'''\nend=source.index('\\\"\\\"\\\"',3)+3\nsource=doc+source[end:]\nsource=source.replace(\\\"    'query_memory': 'state_uniform',\\\\n\\\", \\\"    'query_memory': 'state_uniform',\\\\n    'retrieval_state': 'content',\\\\n    'retrieval_summary': 'uniform',\\\\n\\\",1)\nsource=source.replace('def pool_values(self, query, memory, values, valid, match_fields, matches):',\n '''def pool_values(self, query, memory, values, valid, match_fields, matches,\n                    pooling='adaptive'):''',1)\nold='''            weights = torch.softmax(logits, dim=-1).mean(dim=1)\n        return torch.bmm(weights.to(values.dtype), values)'''\nnew='''            adaptive = torch.softmax(logits, dim=-1)\n            # The null is valid only for empty history and carries zero value.\n            # Preserve adaptive computation/graph in the replacement control.\n            uniform = extended_valid.float()\n            uniform = uniform / uniform.sum(dim=-1, keepdim=True).clamp_min(1.0)\n            uniform = adaptive * 0.0 + uniform[:, None, None, :]\n            weights = (uniform if pooling == 'uniform' else adaptive).mean(dim=1)\n        return torch.bmm(weights.to(values.dtype), values)'''\nassert old in source;source=source.replace(old,new,1)\nold='''    def __init__(self, value_width, width, heads, tasks, prior, query_memory):\n        super().__init__()\n        self.query_memory = query_memory'''\nnew='''    def __init__(self, value_width, width, heads, tasks, prior, query_memory,\n                 summary_mode):\n        super().__init__()\n        self.query_memory = query_memory\n        self.summary_mode = summary_mode'''\nassert old in source;source=source.replace(old,new,1)\nold='''    def forward(self, tokens, token_valid, values, valid, match_fields, matches):\n        denominator'''\nnew='''    def forward(self, tokens, token_valid, values, valid, match_fields, matches,\n                din_summary):\n        denominator'''\nassert old in source;source=source.replace(old,new,1)\nold='''        summary = self.read.pool_values(states, events, values, valid,\n                                        match_fields, matches)\n        summary = self.value_norm(self.value_up(self.value_down(summary)))'''\nnew='''        summary = self.read.pool_values(\n            states, events, values, valid, match_fields, matches,\n            pooling='uniform' if self.summary_mode == 'uniform' else 'adaptive')\n        if self.summary_mode == 'din':\n            # An active residual reparameterization of already available DIN\n            # content, with no new event selection. Queries remain in graph\n            # with zero gradient; value_down/up and output remain trainable.\n            summary = summary * 0.0 + din_summary[:, None, :].expand_as(summary)\n        summary = self.value_norm(self.value_up(self.value_down(summary)))'''\nassert old in source;source=source.replace(old,new,1)\nold=\\\"                 query_memory=CONFIG['query_memory'],\\\\n\\\"\nnew=\\\"\\\"\\\"                 query_memory=CONFIG['query_memory'],\n                 retrieval_state=CONFIG['retrieval_state'],\n                 retrieval_summary=CONFIG['retrieval_summary'],\n\\\"\\\"\\\"\nassert old in source;source=source.replace(old,new,1)\nold='''        self.feedback_content_mode = feedback_content_mode'''\nnew='''        if retrieval_state not in ('content', 'identity'):\n            raise ValueError('Unknown retrieval-state replacement')\n        if retrieval_summary not in ('adaptive', 'uniform', 'din'):\n            raise ValueError('Unknown retrieval-summary replacement')\n        self.retrieval_state = retrieval_state\n        self.feedback_content_mode = feedback_content_mode'''\nassert old in source;source=source.replace(old,new,1)\nold='''                terminal_prior, query_memory)'''\nnew='''                terminal_prior, query_memory, retrieval_summary)'''\nassert old in source;source=source.replace(old,new,1)\nold='''        updates = self.terminal_retrieval(tokens, token_valid, values, valid,\n                                           match_fields, matches)'''\nnew='''        # Replace only the residual branch's token content. Intact final g0\n        # tokens still enter the original towers in every arm. Token presence\n        # and its history-length information are preserved in this control.\n        retrieval_tokens = tokens\n        if self.retrieval_state == 'identity':\n            retrieval_tokens = self.token_identity.to(tokens.dtype).expand_as(tokens)\n            retrieval_tokens = retrieval_tokens * token_valid.unsqueeze(-1).to(tokens.dtype)\n        updates = self.terminal_retrieval(\n            retrieval_tokens, token_valid, values, valid, match_fields, matches,\n            din_summary=pooled[:, 0])'''\nassert old in source;source=source.replace(old,new,1)\nfor filename,state,summary in [('candidate.py','content','uniform'),('identity_attention.py','identity','adaptive'),('din_reparameterization.py','content','din')]:\n s=source.replace(\\\"    'retrieval_state': 'content',\\\",f\\\"    'retrieval_state': '{state}',\\\",1).replace(\\\"    'retrieval_summary': 'uniform',\\\",f\\\"    'retrieval_summary': '{summary}',\\\",1)\n ast.parse(s);compile(s,filename,'exec');(root/filename).write_text(s)\nprint('Wrote three replacement modules and exact incumbent replay; syntax compilation passed.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
