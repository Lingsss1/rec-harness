{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nsrc=Path('/workspace/history_g1_r0009_compact_mean.py').read_text()\nold_doc=src[:src.index('import math')]\nnew_doc='''\\\"\\\"\\\"Fixed fusion of complete mean and DIN summaries at inherited capacity.\n\nProspective study: g1-t001-coherent-summary-blend in proposal.json.\nMean and signed DIN endpoints have different four-task trade-offs, while\nitem/action coordinate splices did not beat the complete mean endpoint.\nTest equal fusion AFTER separate normalization through shared low-rank maps.\nThe uniform control computes the same two transforms with coefficients (1,0).\nNo external-method reproduction, novelty or new performance is claimed.\n\nAll g0 representation/interaction/readout code and compact ancestor parameter\ninitialization are inherited. Existing parameters are shared across summary\nsources. Numerical equivalence, active gradients, masking and cost are host\npreflight requirements; the coding environment has no tensor runtime.\n\\\"\\\"\\\"\n'''\nsrc=src.replace(old_doc,new_doc,1)\nstart=src.index('    def forward(self, values, valid, din_summary):',src.index('class TerminalRetrieval'))\nend=src.index('\\\\n\\\\nclass FeedbackMemory',start)\nnew_forward='''    def forward(self, values, valid, din_summary):\n        # Both arms compute complete seven-field summaries and both shared\n        # transforms. No item/action coordinates are spliced. Keep inherited\n        # [B,4,V] operation shapes and the zero null for an empty history.\n        values = torch.where(valid.unsqueeze(-1), values,\n                             torch.zeros_like(values))\n        values = torch.cat([values, values.new_zeros(\n            values.shape[0], 1, values.shape[-1])], dim=1)\n        extended_valid = torch.cat([valid, ~valid.any(dim=1, keepdim=True)], dim=1)\n        with torch.autocast(device_type=values.device.type, enabled=False):\n            weights = extended_valid.float()\n            weights = weights / weights.sum(dim=-1, keepdim=True).clamp_min(1.0)\n            weights = weights[:, None, :].expand(-1, self.tasks, -1).contiguous()\n        mean_summary = torch.bmm(weights.to(values.dtype), values)\n        target_summary = din_summary[:, None, :].expand(-1, self.tasks, -1)\n        mean_direction = self.value_norm(\n            self.value_up(self.value_down(mean_summary)))\n        target_direction = self.value_norm(\n            self.value_up(self.value_down(target_summary)))\n        # Separate normalization prevents unnormalized signed DIN magnitude\n        # from deciding the fixed fusion weights. No second normalization.\n        # The zero-weight arm stays in the graph; every map is shared and\n        # active through the mean path, with no extra trainable parameter.\n        if self.summary_mode == 'coherent_blend':\n            din_fraction = 0.5\n        elif self.summary_mode == 'din':\n            din_fraction = 1.0\n        else:\n            din_fraction = 0.0\n        direction = ((1.0 - din_fraction) * mean_direction\n                     + din_fraction * target_direction)\n        update = self.output(direction)\n        return torch.where(valid.any(dim=1)[:, None, None], update,\n                           torch.zeros_like(update))\n'''\nsrc=src[:start]+new_forward+src[end:]\nold=\\\"\\\"\\\"        if retrieval_summary not in ('adaptive', 'uniform', 'din'):\n            raise ValueError('Unknown retrieval-summary replacement')\n\\\"\\\"\\\"\nnew=\\\"\\\"\\\"        if retrieval_summary not in ('uniform', 'din', 'coherent_blend'):\n            raise ValueError('Unknown complete-summary source')\n\\\"\\\"\\\"\nassert src.count(old)==1\nsrc=src.replace(old,new)\nold=\\\"\\\"\\\"        if retrieval_summary not in ('uniform', 'din'):\n            raise ValueError('Pruned study supports uniform or DIN summaries')\n\\\"\\\"\\\"\nassert src.count(old)==1\nsrc=src.replace(old,'')\nassert src.count(\\\"    'retrieval_summary': 'uniform',\\\")==1\nPath('/workspace/control_mean.py').write_text(src)\nPath('/workspace/candidate.py').write_text(src.replace(\\\"    'retrieval_summary': 'uniform',\\\",\\\"    'retrieval_summary': 'coherent_blend',\\\",1))\nprint('Implemented candidate.py and standalone control_mean.py.')\nPY\n diff -u /workspace/history_g1_r0009_compact_mean.py /workspace/candidate.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
