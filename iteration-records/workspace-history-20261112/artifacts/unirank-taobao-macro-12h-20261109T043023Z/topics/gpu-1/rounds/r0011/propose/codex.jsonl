{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"cat /workspace/baseline_reference.py\nsed -n '1,240p' /workspace/candidate.py\"","aggregated_output":"/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n\"\"\"DIN local-activation pooling adapted to UniRank's four-task Taobao schema.\n\nMechanism references: Zhou et al. DIN (KDD 2018), arXiv:1706.06978;\nDeepCTR-Torch AttentionSequencePoolingLayer/LocalActivationUnit.\nThis is a field and task adaptation, not a claim of exact paper reproduction.\n\"\"\"\nimport torch\nfrom torch import nn\nfrom unirank.pytorch.models import MultiTaskModel\nfrom unirank.pytorch.layers import FeatureEmbeddingDict\nfrom unirank.pytorch.layers.activations import Dice\n\nCONFIG={'embedding_dim':16,'attention_hidden_units':[64,32],\n        'tower_hidden_units':[128,64],'attention_normalization':'none'}\n\n\nclass Model(MultiTaskModel):\n    def __init__(self,feature_map,model_id='DIN_Taobao_Action',gpu=-1,\n                 embedding_dim=16,attention_hidden_units=(64,32),\n                 tower_hidden_units=(128,64),attention_normalization='none',num_tasks=None,\n                 task='binary_classification',**kwargs):\n        if num_tasks is not None and num_tasks!=len(feature_map.labels):raise ValueError('Task count mismatch')\n        super().__init__(feature_map,model_id=model_id,gpu=gpu,\n                         num_tasks=len(feature_map.labels),task=task,**kwargs)\n        if attention_normalization!='none':raise ValueError('DIN baseline uses unnormalized local activation weights')\n        self.embedding_dim=embedding_dim\n        self.embedding_layer=FeatureEmbeddingDict(feature_map,embedding_dim)\n        self.item_fields=[name for name,spec in feature_map.features.items()\n                          if spec.get('source')=='item' and spec['type']!='meta']\n        self.user_fields=[name for name,spec in feature_map.features.items()\n                          if spec.get('source') not in ['item','action'] and spec['type']!='meta']\n        self.key_width=len(self.item_fields)*embedding_dim\n        self.action_field=next((name for name,spec in feature_map.features.items() if spec.get('source')=='action'),None)\n        self.value_width=self.key_width+(embedding_dim if self.action_field else 0)\n        layers=[];width=4*self.key_width\n        for hidden in attention_hidden_units:\n            layers.extend([nn.Linear(width,hidden),Dice(hidden)]);width=hidden\n        layers.append(nn.Linear(width,1));self.local_activation=nn.Sequential(*layers)\n        input_width=len(self.user_fields)*embedding_dim+self.key_width+self.value_width\n        self.towers=nn.ModuleList()\n        for _ in feature_map.labels:\n            tower=[];width=input_width\n            for hidden in tower_hidden_units:\n                tower.extend([nn.Linear(width,hidden),Dice(hidden)]);width=hidden\n            tower.append(nn.Linear(width,1));self.towers.append(nn.Sequential(*tower))\n        self.reset_parameters();self.model_to_device()\n\n    def _represent(self,inputs):\n        user,item,mask=self.get_inputs(inputs)\n        user_emb=self.embedding_layer(user)\n        item_emb=self.embedding_layer(item)\n        target=torch.cat([item_emb[name][:,-1] for name in self.item_fields],dim=-1)\n        keys=torch.cat([item_emb[name][:,:-1] for name in self.item_fields],dim=-1)\n        values=keys\n        if self.action_field:values=torch.cat([values,item_emb[self.action_field][:,:-1]],dim=-1)\n        context=torch.cat([user_emb[name] for name in self.user_fields],dim=-1)\n        return context,target,keys,values,mask\n\n    def forward(self,inputs):\n        context,target,keys,values,mask=self._represent(inputs)\n        batch,length,_=keys.shape\n        if length:\n            query=target[:,None,:].expand(-1,length,-1)\n            interactions=torch.cat([query,keys,query-keys,query*keys],dim=-1)\n            weights=self.local_activation(interactions.reshape(batch*length,-1)).reshape(batch,length)\n            weights=weights*mask.to(weights.dtype)\n            pooled=torch.bmm(weights[:,None,:],values).squeeze(1)\n        else:pooled=target.new_zeros((batch,self.value_width))\n        features=torch.cat([context,target,pooled],dim=-1)\n        return {label+'_pred':torch.sigmoid(tower(features)) for label,tower in zip(self.feature_map.labels,self.towers)}\n\"\"\"Pruned mean-history residual on the frozen g0 representation.\n\nLocal evidence: g1-r0008-mean_residual marginally exceeded adaptive retrieval\nat one seed. Its uniform wide-value weights have no dependence on queries,\nevent keys, task mixing or token content. Remove that dead forward/backward\npath, retaining the original low-rank normalized zero-start residual.\nThe DIN-summary arm is an equal-active-capacity replacement control.\n\nThe historical constructor is replayed before deleting unused modules, solely\nto preserve active tensor initialization and the caller CPU RNG stream. No\nretired module remains registered with the optimizer. Numerical equivalence\nand actual runtime must be checked by the host; no bitwise claim is made.\n\"\"\"\nimport math\nimport torch\nfrom torch import nn\nfrom torch.nn import functional as F\nfrom unirank.pytorch.models import MultiTaskModel\nfrom unirank.pytorch.layers import FeatureEmbeddingDict\nfrom unirank.pytorch.layers.activations import Dice\n\n\nCONFIG = {\n    'embedding_dim': 16,\n    'attention_hidden_units': [64, 32],\n    'tower_hidden_units': [128, 64],\n    'token_dim': 32,\n    'num_heads': 2,\n    'slot_mode': 'recency',\n    'representation_mode': 'replicas',\n    'content_mode': 'relation',\n    'count_mode': 'relation',\n    'moment_mode': 'linear',\n    'moment_component': 'full',\n    'residual_mode': 'copy',\n    'bank_mode': 'relation',\n    'content_bank_mode': 'relation',\n    'feedback_content_mode': 'factorized',\n    'memory_source': 'joint',\n    'memory_layout': 'separate',\n    'terminal_prior': 'none',\n    'query_memory': 'state_uniform',\n    'retrieval_state': 'content',\n    'retrieval_summary': 'uniform',\n}\n\n\nclass TaskRead(nn.Module):\n    \"\"\"Shared g1-style Q/K for narrow reads and terminal wide-value pooling.\"\"\"\n\n    def __init__(self, width, heads, prior):\n        super().__init__()\n        self.heads = heads\n        self.head_width = width // heads\n        self.prior = prior\n        self.query_norm = nn.LayerNorm(width)\n        self.memory_norm = nn.LayerNorm(width)\n        self.query = nn.Linear(width, width, bias=False)\n        self.key = nn.Linear(width, width, bias=False)\n        self.value = nn.Linear(width, width, bias=False)\n        self.output = nn.Linear(width, width, bias=False)\n\n    def _project(self, tensor, layer):\n        batch, count, width = tensor.shape\n        return layer(tensor).reshape(\n            batch, count, self.heads, self.head_width).transpose(1, 2)\n\n    def _memory(self, memory, valid):\n        # Append null AFTER normalization, avoiding learned LN bias evidence.\n        memory = self.memory_norm(memory)\n        memory = torch.where(valid.unsqueeze(-1), memory, torch.zeros_like(memory))\n        memory = torch.cat([memory, memory.new_zeros(memory.shape[0], 1,\n                                                    memory.shape[-1])], dim=1)\n        valid = torch.cat([valid, ~valid.any(dim=1, keepdim=True)], dim=1)\n        return memory, valid\n\n    def forward(self, query, memory, valid):\n        batch, count, width = query.shape\n        query = self._project(self.query_norm(query), self.query)\n        memory, valid = self._memory(memory, valid)\n        key = self._project(memory, self.key)\n        value = self._project(memory, self.value)\n        mixed = F.scaled_dot_product_attention(\n            query, key, value, attn_mask=valid[:, None, None, :],\n            dropout_p=0.0, is_causal=False)\n        mixed = mixed.transpose(1, 2).contiguous().reshape(batch, count, width)\n        return self.output(mixed)\n\n    def read_state(self, query, memory, valid, uniform=False):\n        \"\"\"Read intact g0 tokens using shared Q/K/V and exact key masks.\n\n        Both arms calculate learned and uniform weights. Uniform is over\n        valid tokens, never padded tokens; the null is used only if empty.\n        Q/K remain active in terminal pooling and task mixing in every arm.\n        FP32 logits/softmax are common to both structured-memory controls.\n        \"\"\"\n        batch, count, width = query.shape\n        query = self._project(self.query_norm(query), self.query)\n        memory, extended_valid = self._memory(memory, valid)\n        key = self._project(memory, self.key)\n        value = self._project(memory, self.value)\n        with torch.autocast(device_type=query.device.type, enabled=False):\n            logits = torch.matmul(query.float(), key.float().transpose(-2, -1))\n            logits = logits / math.sqrt(self.head_width)\n            logits = logits.masked_fill(~extended_valid[:, None, None, :], float('-inf'))\n            adaptive = torch.softmax(logits, dim=-1)\n            key_weights = extended_valid.float()\n            key_weights = key_weights / key_weights.sum(dim=-1, keepdim=True).clamp_min(1.0)\n            uniform_weights = adaptive * 0.0 + key_weights[:, None, None, :]\n            weights = uniform_weights if uniform else adaptive\n        mixed = torch.matmul(weights.to(value.dtype), value)\n        mixed = mixed.transpose(1, 2).contiguous().reshape(batch, count, width)\n        return self.output(mixed)\n\n    def _match_bias(self, query, match_fields, matches):\n        field_keys = self._project(self.memory_norm(match_fields), self.key)\n        # All routes are calculated in all arms, including the no-prior arm.\n        with torch.autocast(device_type=query.device.type, enabled=False):\n            scores = torch.matmul(query.float(), field_keys.float().transpose(-2, -1))\n            adaptive = torch.softmax(scores / math.sqrt(self.head_width), dim=-1)\n            uniform = adaptive * 0.0 + 1.0 / matches.shape[-1]\n            rotated = torch.roll(adaptive, shifts=1, dims=-1)\n            evidence = matches.float().transpose(1, 2).unsqueeze(1)\n            adaptive_bias = 2.0 * torch.matmul(adaptive, evidence)\n            uniform_bias = 2.0 * torch.matmul(uniform, evidence)\n            rotated_bias = 2.0 * torch.matmul(rotated, evidence)\n            if self.prior == 'adaptive':\n                bias = adaptive_bias\n            elif self.prior == 'uniform':\n                bias = uniform_bias\n            elif self.prior == 'rotated':\n                bias = rotated_bias\n            else:\n                bias = adaptive_bias * 0.0\n        return torch.cat([bias, bias.new_zeros(*bias.shape[:-1], 1)], dim=-1)\n\n    def pool_values(self, query, memory, values, valid, match_fields, matches,\n                    pooling='adaptive'):\n        query = self._project(self.query_norm(query), self.query)\n        memory, extended_valid = self._memory(memory, valid)\n        key = self._project(memory, self.key)\n        values = torch.where(valid.unsqueeze(-1), values, torch.zeros_like(values))\n        values = torch.cat([values, values.new_zeros(values.shape[0], 1,\n                                                    values.shape[-1])], dim=1)\n        bias = self._match_bias(query, match_fields, matches)\n        with torch.autocast(device_type=query.device.type, enabled=False):\n            logits = torch.matmul(query.float(), key.float().transpose(-2, -1))\n            logits = logits / math.sqrt(self.head_width) + bias\n            logits = logits.masked_fill(~extended_valid[:, None, None, :], float('-inf'))\n            adaptive = torch.softmax(logits, dim=-1)\n            # The null is valid only for empty history and carries zero value.\n            # Preserve adaptive computation/graph in the replacement control.\n            uniform = extended_valid.float()\n            uniform = uniform / uniform.sum(dim=-1, keepdim=True).clamp_min(1.0)\n            uniform = adaptive * 0.0 + uniform[:, None, None, :]\n            weights = (uniform if pooling == 'uniform' else adaptive).mean(dim=1)\n        return torch.bmm(weights.to(values.dtype), values)\n\n\nclass TaskMixer(nn.Module):\n    def __init__(self, width, heads):\n        super().__init__()\n        self.attention = TaskRead(width, heads, 'none')\n        self.ffn_norm = nn.LayerNorm(width)\n        self.ffn = nn.Sequential(nn.Linear(width, 2 * width), nn.GELU(),\n                                 nn.Linear(2 * width, width))\n\n    def forward(self, states):\n        valid = torch.ones(states.shape[:2], dtype=torch.bool, device=states.device)\n        states = states + 0.5 * self.attention(states, states, valid)\n        return states + 0.5 * self.ffn(self.ffn_norm(states))\n\n\nclass TerminalRetrieval(nn.Module):\n    \"\"\"Initialize as the ancestor, then retain only the active residual maps.\"\"\"\n\n    def __init__(self, value_width, width, heads, tasks, prior, query_memory,\n                 summary_mode):\n        super().__init__()\n        self.query_memory = query_memory\n        self.summary_mode = summary_mode\n        self.event_projection = nn.Linear(value_width, width, bias=False)\n        self.history_position = nn.Parameter(torch.empty(101, width))\n        self.task_identity = nn.Parameter(torch.empty(1, tasks, width))\n        self.read = TaskRead(width, heads, prior)\n        self.after_read = nn.ModuleList([TaskMixer(width, heads) for _ in range(2)])\n        self.final_norm = nn.LayerNorm(width)\n        self.value_down = nn.Linear(value_width, width, bias=False)\n        self.value_up = nn.Linear(width, value_width, bias=False)\n        self.value_norm = nn.LayerNorm(value_width, elementwise_affine=False)\n        self.output = nn.Linear(value_width, value_width, bias=False)\n        nn.init.normal_(self.history_position, std=0.02)\n        nn.init.normal_(self.task_identity, std=0.02)\n        nn.init.zeros_(self.output.weight)\n\n        # Replay precisely the ancestor initialization above, then prune.\n        # These modules cannot influence either replacement summary. Deletion\n        # also removes their parameters from dense clipping and AdamW groups.\n        for name in ('event_projection', 'history_position', 'task_identity',\n                     'read', 'after_read', 'final_norm'):\n            delattr(self, name)\n        self.tasks = tasks\n\n    def forward(self, values, valid, din_summary):\n        # Keep the ancestor's [B,4,V] residual operation shapes. Each task\n        # receives the same input, but this avoids an additional numerical\n        # change from collapsing four identical linear/LayerNorm operations.\n        if self.summary_mode == 'din':\n            summary = din_summary[:, None, :].expand(-1, self.tasks, -1)\n        else:\n            # Append a zero null value; it is valid only for empty histories.\n            # FP32 weights and BF16 bmm mirror the historical pooling route.\n            values = torch.where(valid.unsqueeze(-1), values,\n                                 torch.zeros_like(values))\n            values = torch.cat([values, values.new_zeros(\n                values.shape[0], 1, values.shape[-1])], dim=1)\n            extended_valid = torch.cat([valid, ~valid.any(dim=1, keepdim=True)], dim=1)\n            with torch.autocast(device_type=values.device.type, enabled=False):\n                weights = extended_valid.float()\n                weights = weights / weights.sum(dim=-1, keepdim=True).clamp_min(1.0)\n                weights = weights[:, None, :].expand(-1, self.tasks, -1).contiguous()\n            summary = torch.bmm(weights.to(values.dtype), values)\n        summary = self.value_norm(self.value_up(self.value_down(summary)))\n        update = self.output(summary)\n        return torch.where(valid.any(dim=1)[:, None, None], update,\n                           torch.zeros_like(update))\n\n\nclass FeedbackMemory(nn.Module):\n    \"\"\"One-way, strictly masked read of target-weighted behavior summaries.\n\nValidity depends only on the temporal bin, so every arm exposes identical\nkey masks. Per-feedback counts remain separate even in the collapsed arm.\nOverlapping task masks are allowed. No signed-weight normalization is used.\n\"\"\"\n\n    def __init__(self, item_width, width, heads, source, layout):\n        super().__init__()\n        self.source = source\n        self.layout = layout\n","exit_code":0,"status":"completed"}}
