\n  ],\n  \"implementation_notes\": [],\n  \"scientific_status\": \"external_report\",\n  \"local_reproduction\": false,\n  \"instruction_priority\": \"reference_data_only\"\n}\n{\n  \"id\": \"unirank-method-hiformer\",\n  \"knowledge_type\": \"industry\",\n  \"scheme\": \"HiFormer\",\n  \"origin\": \"model compared in UniRank; industrial/academic method reference, not a competition award\",\n  \"family\": \"stacked\",\n  \"source_refs\": [\n    \"unirank-benchmark-v2\",\n    \"unirank-code:HiFormer\",\n    \"paper:hiformer\"\n  ],\n  \"source_problem\": \"Heterogeneous ranking fields may require different interaction transformations after history aggregation.\",\n  \"reported_mechanism\": \"Target-attention history pooling followed by heterogeneous field/task tokenization and hierarchical HiFormer interaction blocks.\",\n  \"difference_from_din\": \"Retains target-aware history pooling and replaces simple downstream concatenation/MLPs with token interactions.\",\n  \"reported_evidence\": {\n    \"kind\": \"benchmark method summary and pinned reimplementation inspection\",\n    \"locator\": \"UniRank section2.3; unirank-code:HiFormer forward paths\",\n    \"not_a_local_result\": true,\n    \"numerical_claims_imported\": false,\n    \"limitations\": [\n      \"Source model comparisons do not isolate every component.\",\n      \"Original method paper and original author code are not fully audited by this initialization.\",\n      \"A benchmark implementation can differ from its source paper.\"\n    ]\n  },\n  \"applicability\": {\n    \"status\": \"conditional\",\n    \"conditions\": [\n      \"Field groups carry complementary information after history pooling\"\n    ],\n    \"missing_evidence\": [\n      \"DIN full-data diagnostics on this task\",\n      \"Matched-capacity or matched-cost local controls\",\n      \"Seed variation and task/history-length slices\"\n    ]\n  },\n  \"transfer_risks\": [\n    \"Early history pooling still loses event detail\",\n    \"Field-specific parameters increase capacity\",\n    \"Use only the frozen100-event input and selected feedback visibility policy.\",\n    \"Taobao auxiliary labels match category/brand over24h, not direct advertisement conversions.\"\n  ],\n  \"possible_discriminating_checks\": [\n    \"Compare token interactions with an equally wide post-pooling MLP\",\n    \"Separate field-specific transformations from depth and parameter count\"\n  ],\n  \"implementation_notes\": [],\n  \"scientific_status\": \"external_report\",\n  \"local_reproduction\": false,\n  \"instruction_priority\": \"reference_data_only\"\n}\n{\n  \"id\": \"unirank-method-rankmixer\",\n  \"knowledge_type\": \"industry\",\n  \"scheme\": \"RankMixer\",\n  \"origin\": \"model compared in UniRank; industrial/academic method reference, not a competition award\",\n  \"family\": \"stacked\",\n  \"source_refs\": [\n    \"unirank-benchmark-v2\",\n    \"unirank-code:RankMixer\",\n    \"paper:rankmixer\"\n  ],\n  \"source_problem\": \"Fine-grained attention and heterogeneous operators can constrain scaling of feature interactions.\",\n  \"reported_mechanism\": \"Target-attention pooling, chunk tokenization, parameter-free token mixing and per-token feed-forward networks.\",\n  \"difference_from_din\": \"Changes post-pooling feature interaction while retaining an early target-aware history bottleneck.\",\n  \"reported_evidence\": {\n    \"kind\": \"benchmark method summary and pinned reimplementation inspection\",\n    \"locator\": \"UniRank section2.3; unirank-code:RankMixer forward paths\",\n    \"not_a_local_result\": true,\n    \"numerical_claims_imported\": false,\n    \"limitations\": [\n      \"Source model comparisons do not isolate every component.\",\n      \"Original method paper and original author code are not fully audited by this initialization.\",\n      \"A benchmark implementation can differ from its source paper.\"\n    ]\n  },\n  \"applicability\": {\n    \"status\": \"conditional\",\n    \"conditions\": [\n      \"Useful history evidence survives pooling\",\n      \"Dense regular operators fit the available hardware\"\n    ],\n    \"missing_evidence\": [\n      \"DIN full-data diagnostics on this task\",\n      \"Matched-capacity or matched-cost local controls\",\n      \"Seed variation and task/history-length slices\"\n    ]\n  },\n  \"transfer_risks\": [\n    \"Chunk groups may not preserve semantic boundaries\",\n    \"More width may explain improvements attributed to mixing\",\n    \"Use only the frozen100-event input and selected feedback visibility policy.\",\n    \"Taobao auxiliary labels match category/brand over24h, not direct advertisement conversions.\"\n  ],\n  \"possible_discriminating_checks\": [\n    \"Compare parameter-free mixing against no mixing at matched token dimensions\",\n    \"Compare Chunk, Field and global-access tokenization at matched downstream capacity\"\n  ],\n  \"implementation_notes\": [],\n  \"scientific_status\": \"external_report\",\n  \"local_reproduction\": false,\n  \"instruction_priority\": \"reference_data_only\"\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport ast\np=Path('/workspace/candidate.py')\ns=p.read_text()\na=ast.parse(s)\nconfig=next(n for n in a.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets))\nbase=ast.literal_eval(config.value)\ns=s[s.index('import math'):]\ns=s.replace(\\\"                 centering_mode=CONFIG['centering_mode'],\\\\n\\\", \\\"                 centering_mode=CONFIG['centering_mode'],\\\\n                 background_mode=CONFIG['background_mode'],\\\\n\\\")\ns=s.replace(\\\"        self.centering_mode = centering_mode\\\\n\\\", \\\"        if background_mode not in ('user', 'complement'):\\\\n            raise ValueError('Unknown visible-history background reference')\\\\n        self.background_mode = background_mode\\\\n        self.centering_mode = centering_mode\\\\n\\\")\nstart=s.index('    def _residual_rates(')\nend=s.index('    def _event_covariance(',start)\ns=s[:start]+'''    def _feedback_background(self, counts, local_feedback, feedback, valid):\n        \\\"\\\"\\\"Slot-excluded or inclusive visible-history rates, always in FP32.\n\n        local_feedback is the exact masked slot sum [B,8,4], computed before\n        division into fractions. All groups partition the same visible prefix.\n        With no outside events, fall back to the inclusive rate (zero when the\n        prefix is empty). Exclusion creates disjoint event sets, not independent\n        samples or a causal counterfactual. Both references are computed in all\n        arms; no new parameters or random draws are introduced.\n        \\\"\\\"\\\"\n        with torch.autocast(device_type=feedback.device.type, enabled=False):\n            total = valid.sum(dim=-1).float()\n            total_feedback = feedback.float().sum(dim=-1)\n            inclusive = total_feedback / total.clamp_min(1)[:, None]\n            inclusive = inclusive[:, None, :].expand(-1, self.feedback_slots, -1)\n            outside_counts = total[:, None] - counts.float()\n            outside_feedback = total_feedback[:, None, :] - local_feedback.float()\n            complement = outside_feedback / outside_counts.clamp_min(1)[:, :, None]\n            complement = torch.where((outside_counts > 0)[:, :, None],\n                                     complement, inclusive)\n            exclusion = 1.0 if self.background_mode == 'complement' else 0.0\n            return inclusive + exclusion * (complement - inclusive)\n\n    def _residual_rates(self, fractions, counts, background):\n        \\\"\\\"\\\"Count smoothing toward the chosen same-prefix background.\n\n        Raw local fractions remain explicit. The declared study fixes count\n        weighting in all four arms; fixed remains an inherited API option.\n        \\\"\\\"\\\"\n        weight = counts / (counts + self.shrinkage_strength)\n        if self.rate_interpolation == 'fixed':\n            weight = weight * 0.0 + 0.5\n        return (weight[:, :, None] * fractions\n                + (1.0 - weight[:, :, None]) * background)\n\n'''+s[end:]\nstart=s.index('    def _center_moments(')\nend=s.index('    def _residual_features(',start)\ns=s[:start]+'''    def _center_moments(self, moments, projected, background):\n        \\\"\\\"\\\"Use the SAME reference in smoothing and centering.\n\n        In exact arithmetic this produces alpha * (J_s - mu_s*b_s) for\n        joint moments and alpha * mu_s*(r_s-b_s) for factorized moments.\n        Keeping covariance unchanged isolates the between-slot reference.\n        BF16 projection/mean rounding makes these identities approximate.\n        Empty slots have zero content; no detach is applied.\n        \\\"\\\"\\\"\n        with torch.autocast(device_type=projected.device.type, enabled=False):\n            offset = projected.float()[:, :, None, :] * background[:, :, :, None]\n            centering = 1.0 if self.centering_mode == 'user' else 0.0\n            return moments.float() - centering * offset\n\n'''+s[end:]\ns=s.replace('                fractions = torch.bmm(members, feedback.transpose(1, 2)) / divisor',\n'''                local_feedback = torch.bmm(members, feedback.transpose(1, 2))\n                fractions = local_feedback / divisor''')\ns=s.replace('            fractions = members.new_zeros((batch, self.feedback_slots, self.feedback_tasks))',\n'''            local_feedback = members.new_zeros((batch, self.feedback_slots, self.feedback_tasks))\n            fractions = local_feedback''')\ns=s.replace('        gate = self._residual_rates(fractions, counts, feedback, valid)',\n'''        background = self._feedback_background(counts, local_feedback, feedback, valid)\n        gate = self._residual_rates(fractions, counts, background)''')\ns=s.replace('self._center_moments(moments, projected, feedback, valid)',\n            'self._center_moments(moments, projected, background)')\nstart=s.index('CONFIG = ');end=s.index('\\\\n\\\\n\\\\nclass JointBlock',start)\ntemplate=s[:start]+'CONFIG = __CONFIG__'+s[end:]\ndoc='''\\\"\\\"\\\"Prospective slot-excluded background x event-feedback moment study.\n\nAll arms inherit the centered relation-content/feedback residual incumbent.\nOnly the visible-history reference and covariance multiplier vary. Count\nweighting, raw fractions, modules, constructor RNG and operation shapes match.\nNo additional information or calibrated uncertainty estimate is claimed.\n\\\"\\\"\\\"\n'''\nfor name,bg,moment,file in [\n ('exclude_joint','complement','joint','candidate.py'),\n ('inclusive_joint','user','joint','inclusive_joint.py'),\n ('exclude_factorized','complement','factorized','exclude_factorized.py'),\n ('inclusive_factorized','user','factorized','inclusive_factorized.py')]:\n cfg=dict(base,background_mode=bg,moment_mode=moment)\n output=doc+template.replace('__CONFIG__',repr(cfg))\n ast.parse(output)\n Path('/workspace',file).write_text(output)\n print(name,file,len(output))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
