{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport ast,contextlib,itertools,math,random,types,hashlib\nfrom pathlib import Path\nclass A:\n def __init__(self,shape,data):\n  self.shape=tuple(shape);self.data=list(data);self.device=types.SimpleNamespace(type='cpu')\n  assert math.prod(shape)==len(self.data)\n def float(self):return self\n def at(self,index):\n  off=0\n  for i,d in zip(index,self.shape):off=off*d+i\n  return self.data[off]\n def ix(self):return itertools.product(*(range(d) for d in self.shape))\n def __getitem__(self,key):\n  if not isinstance(key,tuple):key=(key,)\n  key=key+(slice(None),)*(len(self.shape)-sum(k is not None for k in key))\n  shape=[];dim=0\n  for k in key:\n   if k is None:shape.append(1)\n   elif isinstance(k,int):dim+=1\n   else:\n    assert k==slice(None);shape.append(self.shape[dim]);dim+=1\n  out=[]\n  for idx in itertools.product(*(range(d) for d in shape)):\n   src=[];j=0\n   for k in key:\n    if k is None:j+=1\n    elif isinstance(k,int):src.append(k)\n    else:src.append(idx[j]);j+=1\n   out.append(self.at(src))\n  return A(shape,out)\n @staticmethod\n def value(x,index,shape):\n  if not isinstance(x,A):return x\n  off=len(shape)-len(x.shape)\n  return x.at([0 if d==1 else index[off+i] for i,d in enumerate(x.shape)])\n def op(self,other,fn):\n  sh=other.shape if isinstance(other,A) else ()\n  n=max(len(self.shape),len(sh));s1=(1,)*(n-len(self.shape))+self.shape;s2=(1,)*(n-len(sh))+sh\n  shape=[]\n  for a,b in zip(s1,s2):\n   assert a==b or a==1 or b==1\n   shape.append(max(a,b))\n  return A(shape,[fn(A.value(self,i,shape),A.value(other,i,shape)) for i in itertools.product(*(range(d) for d in shape))])\n def __add__(self,x):return self.op(x,lambda a,b:a+b)\n __radd__=__add__\n def __sub__(self,x):return self.op(x,lambda a,b:a-b)\n def __rsub__(self,x):return self.op(x,lambda a,b:b-a)\n def __mul__(self,x):return self.op(x,lambda a,b:a*b)\n __rmul__=__mul__\n def __truediv__(self,x):return self.op(x,lambda a,b:a/b)\n def __gt__(self,x):return self.op(x,lambda a,b:a>b)\n def clamp_min(self,x):return A(self.shape,[max(x,v) for v in self.data])\n def sum(self,dim):\n  dim=dim%len(self.shape);shape=self.shape[:dim]+self.shape[dim+1:]\n  return A(shape,[sum(self.at(idx[:dim]+(j,)+idx[dim:]) for j in range(self.shape[dim])) for idx in itertools.product(*(range(d) for d in shape))])\n def expand(self,*shape):\n  shape=tuple(d if s==-1 else s for d,s in zip(self.shape,shape))\n  return A(shape,[A.value(self,idx,shape) for idx in itertools.product(*(range(d) for d in shape))])\ndef where(c,x,y):\n shape=x.op(y,lambda a,b:0).shape\n return A(shape,[A.value(x,i,shape) if A.value(c,i,shape) else A.value(y,i,shape) for i in itertools.product(*(range(d) for d in shape))])\nfake=types.SimpleNamespace(autocast=lambda **kw:contextlib.nullcontext(),where=where)\nfiles=['candidate.py','inclusive_joint.py','exclude_factorized.py','inclusive_factorized.py']\nmodels=[];trees=[]\nfor f in files:\n source=Path('/workspace',f).read_text(); tree=ast.parse(source);compile(source,f,'exec')\n cfg=ast.literal_eval(next(n.value for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets)))\n cls=next(n for n in tree.body if isinstance(n,ast.ClassDef) and n.name=='Model')\n funcs=[n for n in cls.body if isinstance(n,ast.FunctionDef) and n.name in ['_feedback_background','_residual_rates','_center_moments']]\n namespace={'torch':fake};exec(compile(ast.Module(body=funcs,type_ignores=[]),f,'exec'),namespace)\n model=types.SimpleNamespace(feedback_slots=8,background_mode=cfg['background_mode'],rate_interpolation=cfg['rate_interpolation'],shrinkage_strength=4.0,centering_mode='user',moment_mode=cfg['moment_mode'])\n for fn in funcs:setattr(model,fn.name,types.MethodType(namespace[fn.name],model))\n models.append(model)\n tree.body=[n for n in tree.body if not (isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets))]\n trees.append(ast.dump(tree,include_attributes=False))\n assert all(isinstance(n,(ast.Import,ast.ImportFrom,ast.Assign,ast.ClassDef,ast.Expr)) for n in tree.body)\n assert all(n.module is None or n.module.split('.')[0] in ['torch','unirank'] for n in ast.walk(tree) if isinstance(n,ast.ImportFrom))\n print(f,'SHA256',hashlib.sha256(source.encode()).hexdigest())\nassert len(set(trees))==1\nrng=random.Random(3132026);scenarios=0;arm_cases=0;discriminating=False\nfor length in [0,1,4,17,100]:\n for mask_style in ['full','empty','holey']:\n  for grouping in ['one_slot','balanced','dominant']:\n   B,S,T,D=2,8,4,3\n   vs=[];ys=[];cs=[];local=[];frs=[];mus=[];joints=[];covs=[]\n   for b in range(B):\n    valid=[int(mask_style=='full' or (mask_style=='holey' and (i+b)%3\"'!=0)) for i in range(length)]\n    group=[(b if grouping=='\"'one_slot' else i%S if grouping=='balanced' else (b if i%7 else (i+b)%S)) for i in range(length)]\n    feedback=[[int(rng.random()<(t+1)*0.14) * valid[i] for i in range(length)] for t in range(T)]\n    x=[[rng.uniform(-2,2)*valid[i] for d in range(D)] for i in range(length)]\n    counts=[sum(v and g==s for v,g in zip(valid,group)) for s in range(S)]\n    loc=[[sum(feedback[t][i] for i in range(length) if group[i]==s) for t in range(T)] for s in range(S)]\n    fractions=[[loc[s][t]/max(counts[s],1) for t in range(T)] for s in range(S)]\n    mu=[[sum(x[i][d] for i in range(length) if group[i]==s)/max(counts[s],1) for d in range(D)] for s in range(S)]\n    joint=[[[sum(x[i][d]*feedback[t][i] for i in range(length) if group[i]==s)/max(counts[s],1) for d in range(D)] for t in range(T)] for s in range(S)]\n    cov=[[[joint[s][t][d]-mu[s][d]*fractions[s][t] for d in range(D)] for t in range(T)] for s in range(S)]\n    vs.append(valid);ys.append(feedback);cs.append(counts);local.append(loc);frs.append(fractions);mus.append(mu);joints.append(joint);covs.append(cov)\n   flatten=lambda v:list(v) if not v or not isinstance(v[0],list) else sum((flatten(x) for x in v),[])\n   counts=A((B,S),flatten(cs)); local_a=A((B,S,T),flatten(local));feedback=A((B,T,length),flatten(ys));valid_a=A((B,length),flatten(vs));fractions=A((B,S,T),flatten(frs));mu_a=A((B,S,D),flatten(mus))\n   for model in models:\n    bg=model._feedback_background(counts,local_a,feedback,valid_a)\n    gate=model._residual_rates(fractions,counts,bg)\n    moment_values=[];oracle=[]\n    for b,s,t,d in itertools.product(range(B),range(S),range(T),range(D)):\n     N=sum(vs[b]);n=cs[b][s];total_y=sum(ys[b][t]);own=local[b][s][t]\n     expected=(total_y-own)/(N-n) if model.background_mode=='complement' and N>n else total_y/max(N,1)\n     assert abs(bg.at((b,s,t))-expected)<1e-12\n     assert 0<=expected<=1\n     a=n/(n+4);r=frs[b][s][t];m=mus[b][s][d];cov=covs[b][s][t][d] if model.moment_mode=='joint' else 0\n     g=a*r+(1-a)*expected\n     assert abs(gate.at((b,s,t))-g)<1e-12\n     moment_values.append(m*g+a*cov)\n     oracle.append(a*(m*(r-expected)+cov))\n     if model.background_mode=='complement' and N>n and n>0 and abs(expected-total_y/N)>1e-4:discriminating=True\n    centered=model._center_moments(A((B,S,T,D),moment_values),mu_a,bg)\n    assert max([abs(a-b) for a,b in zip(centered.data,oracle)]+[0])<1e-12\n    assert all(math.isfinite(v) for v in centered.data)\n    arm_cases+=1\n   scenarios+=1\nassert discriminating\nprint('PASS:',scenarios,'synthetic scenarios;',arm_cases,'actual-helper arm cases; independent scalar rate/centered-moment oracles; all four ASTs equal outside CONFIG.')\nprint('Checked empty, singleton, full, holey and skewed slot counts; complement fallback; overlapping task feedback; finite signed moments; zero empty slots.')\nprint('This checks extracted arithmetic only; no torch/BF16/autograd/full-model execution or training.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
