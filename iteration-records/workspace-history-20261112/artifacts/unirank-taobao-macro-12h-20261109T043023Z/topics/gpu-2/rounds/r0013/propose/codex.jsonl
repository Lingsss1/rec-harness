{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,230p' /workspace/history_g2_r0004_count_shrink.py\nsed -n '1,130p' /workspace/history_g0_r0003_relation_content_counts.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,230p' /workspace/history_g2_r0004_count_shrink.py\nsed -n '1,130p' /workspace/history_g0_r0003_relation_content_counts.py\"","aggregated_output":"/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n/bin/bash: warning: setlocale: LC_ALL: cannot change locale (C.UTF-8)\n\"\"\"Prospective count-conditioned shrinkage of compressed feedback products.\n\nOnly the product gate changes: sparse slots interpolate toward the same\nuser's visible-history feedback rate. Raw slot fractions remain explicit.\nFixed and reversed-count mixtures share all registered modules and columns.\nThe host must check forward/backward, masking, BF16 quality and cost.\nThis is an untested hypothesis; no originality or measured gain is claimed.\n\"\"\"\nimport math\nimport torch\nfrom torch import nn\nfrom torch.nn import functional as F\nfrom unirank.pytorch.models import MultiTaskModel\nfrom unirank.pytorch.layers import FeatureEmbeddingDict\nfrom unirank.pytorch.layers.activations import Dice\n\n\nCONFIG = {\n    'embedding_dim': 16,\n    'slot_dim': 32,\n    'attention_hidden_units': [64, 32],\n    'tower_hidden_units': [128, 64],\n    'grouping': 'target_fields',\n    'compression': 'early',\n    'recent_window': 16,\n    'slot_weighting': 'uniform',\n    'include_content': True,\n    'include_counts': True,\n    'feedback_mode': 'factorized',\n    'include_feedback_fractions': True,\n    'feedback_dim': 8,\n    'rate_interpolation': 'count',\n    'shrinkage_strength': 4.0,\n}\n\n\nclass Model(MultiTaskModel):\n    def __init__(self, feature_map, model_id='FieldRoutedHistory', gpu=-1,\n                 embedding_dim=16, slot_dim=32,\n                 attention_hidden_units=(64, 32),\n                 tower_hidden_units=(128, 64),\n                 grouping=CONFIG['grouping'], compression=CONFIG['compression'],\n                 recent_window=16,\n                 slot_weighting=CONFIG['slot_weighting'],\n                 include_content=CONFIG['include_content'],\n                 include_counts=CONFIG['include_counts'],\n                 feedback_mode=CONFIG['feedback_mode'],\n                 include_feedback_fractions=CONFIG['include_feedback_fractions'],\n                 feedback_dim=8,\n                 rate_interpolation=CONFIG['rate_interpolation'],\n                 shrinkage_strength=CONFIG['shrinkage_strength'], num_tasks=None,\n                 task='binary_classification', **kwargs):\n        if feedback_mode not in ('factorized', 'content', 'global'):\n            raise ValueError('Unknown feedback product replacement')\n        if not isinstance(include_feedback_fractions, bool):\n            raise ValueError('Feedback fraction switch must be bool')\n        if feedback_dim <= 0:\n            raise ValueError('feedback_dim must be positive')\n        if rate_interpolation not in ('count', 'fixed', 'reverse'):\n            raise ValueError('Unknown rate interpolation control')\n        if not math.isfinite(shrinkage_strength) or shrinkage_strength <= 0:\n            raise ValueError('shrinkage_strength must be finite and positive')\n        if feedback_mode != 'factorized':\n            raise ValueError('This study changes only the factorized product gate')\n        if len(feature_map.labels) != 4:\n            raise ValueError('This study requires the four contracted tasks')\n        if num_tasks is not None and num_tasks != len(feature_map.labels):\n            raise ValueError('Task count mismatch')\n        if grouping not in ('target_fields', 'position'):\n            raise ValueError('Unknown grouping')\n        if compression not in ('early', 'late'):\n            raise ValueError('Unknown compression timing')\n        if slot_weighting not in ('learned', 'uniform'):\n            raise ValueError('Unknown slot weighting')\n        if not isinstance(include_content, bool) or not isinstance(include_counts, bool):\n            raise ValueError('Information-path switches must be bool')\n        if slot_weighting == 'uniform' and compression != 'early':\n            raise ValueError('Uniform weighting is defined only for early compression')\n        if grouping != 'target_fields' or compression != 'early' or slot_weighting != 'uniform':\n            raise ValueError('This matched study requires uniform early target-field slots')\n        if recent_window <= 0:\n            raise ValueError('recent_window must be positive')\n        super().__init__(feature_map, model_id=model_id, gpu=gpu,\n                         num_tasks=len(feature_map.labels), task=task, **kwargs)\n        self.feedback_mode = feedback_mode\n        self.rate_interpolation = rate_interpolation\n        self.shrinkage_strength = float(shrinkage_strength)\n        self.include_feedback_fractions = include_feedback_fractions\n        self.feedback_dim = feedback_dim\n        self.feedback_tasks = len(feature_map.labels)\n        self.slot_weighting = slot_weighting\n        self.include_content = include_content\n        self.include_counts = include_counts\n        self.grouping = grouping\n        self.compression = compression\n        self.recent_window = recent_window\n        self.num_slots = 8\n        self.embedding_layer = FeatureEmbeddingDict(feature_map, embedding_dim)\n        self.item_fields = [n for n, s in feature_map.features.items()\n                            if s.get('source') == 'item' and s['type'] != 'meta']\n        self.user_fields = [n for n, s in feature_map.features.items()\n                            if s.get('source') not in ('item', 'action')\n                            and s['type'] != 'meta']\n        self.action_field = next((n for n, s in feature_map.features.items()\n                                  if s.get('source') == 'action'\n                                  and s['type'] != 'meta'), None)\n        if not {'cate_id', 'brand'}.issubset(self.item_fields):\n            raise ValueError('Expected the contracted category and brand fields')\n        def width(names):\n            return sum(feature_map.features[n].get('embedding_dim', embedding_dim)\n                       for n in names)\n        self.key_width = width(self.item_fields)\n        self.value_width = self.key_width + width(\n            [self.action_field] if self.action_field else [])\n        layers = []\n        dim = 4 * self.key_width\n        for hidden in attention_hidden_units:\n            # Pointwise ReLU avoids timing-dependent Dice batch statistics.\n            layers.extend([nn.Linear(dim, hidden), nn.ReLU()])\n            dim = hidden\n        layers.append(nn.Linear(dim, 1))\n        self.local_activation = nn.Sequential(*layers)\n        self.slot_projection = nn.Linear(self.value_width, slot_dim, bias=False)\n        self.feedback_projection = nn.Linear(self.key_width, feedback_dim, bias=False)\n        input_width = (width(self.user_fields) + self.key_width\n                       + self.num_slots * slot_dim + self.num_slots\n                       + self.num_slots * self.feedback_tasks * (feedback_dim + 1))\n        self.towers = nn.ModuleList()\n        for _ in feature_map.labels:\n            layers = []\n            dim = input_width\n            for hidden in tower_hidden_units:\n                layers.extend([nn.Linear(dim, hidden), Dice(hidden)])\n                dim = hidden\n            layers.append(nn.Linear(dim, 1))\n            self.towers.append(nn.Sequential(*layers))\n        self.reset_parameters()\n        self.model_to_device()\n\n    def _membership(self, item, mask):\n        \"\"\"Return B x 8 x L membership; each valid event belongs to one slot.\n\n        The last sixteen positions are an ordinal recent band, not a time\n        window. Target-conditioned slots encode both/category/brand/neither\n        matches in each band. Position controls split each band four ways.\n        Token zero never produces a category or brand match.\n        \"\"\"\n        batch, length = mask.shape\n        pos = torch.arange(length, device=mask.device)[None, :].expand(batch, -1)\n        old_length = max(length - self.recent_window, 0)\n        recent = pos >= old_length\n        if self.grouping == 'target_fields':\n            category = item['cate_id']\n            brand = item['brand']\n            cat_match = ((category[:, :-1] == category[:, -1:])\n                         & (category[:, :-1] != 0) & (category[:, -1:] != 0))\n            brand_match = ((brand[:, :-1] == brand[:, -1:])\n                           & (brand[:, :-1] != 0) & (brand[:, -1:] != 0))\n            group = 2 * cat_match.long() + brand_match.long() + 4 * recent.long()\n        else:\n            old_bin = (pos * 4 // max(old_length, 1)).clamp(max=3)\n            recent_bin = ((pos - old_length).clamp(min=0) * 4\n                          // max(length - old_length, 1)).clamp(max=3)\n            group = torch.where(recent, 4 + recent_bin, old_bin)\n        members = F.one_hot(group, num_classes=self.num_slots).transpose(1, 2)\n        return members.to(torch.float32) * (mask > 0)[:, None, :]\n\n    def _score(self, target, keys):\n        batch, length, _ = keys.shape\n        query = target[:, None, :].expand(-1, length, -1)\n        interactions = torch.cat((query, keys, query - keys, query * keys), dim=-1)\n        return self.local_activation(interactions.reshape(batch * length, -1)).reshape(\n            batch, length)\n\n    def _interpolate_rates(self, fractions, counts, feedback, mask):\n        \"\"\"Convex mixture using only the contracted masked prefix.\n\n        n/(n+4) trusts high-occupancy local rates more. The fixed control\n        uses 1/2 everywhere; reverse uses 4/(n+4). Strength four is fixed\n        prospectively, not fitted to validation. The global rate includes\n        the current slot; this is shrinkage, not an independent prior.\n        Empty slots contribute zero after the existing content mask.\n        \"\"\"\n        total = (mask > 0).sum(dim=-1).clamp(min=1)\n        global_rate = feedback.sum(dim=-1) / total[:, None]\n        strength = self.shrinkage_strength\n        # Execute the same small slot-sized arithmetic in all replacements.\n        weight = counts / (counts + strength)\n        if self.rate_interpolation == 'fixed':\n            weight = weight * 0.0 + 0.5\n        elif self.rate_interpolation == 'reverse':\n            weight = 1.0 - weight\n        return (weight[:, :, None] * fractions\n                + (1.0 - weight[:, :, None]) * global_rate[:, None, :])\n\n    def forward(self, inputs):\n        if len(inputs) != 4 or inputs[3] is None:\n            raise ValueError('Historical feedback masks are required by this study')\n        user, item, mask, task_masks = self.get_inputs(inputs, return_multi_masks=True)\n        if len(task_masks) != self.feedback_tasks:\n            raise ValueError('Historical feedback mask count mismatch')\n        user_emb = self.embedding_layer(user)\n        item_emb = self.embedding_layer(item)\n        target = torch.cat([item_emb[n][:, -1] for n in self.item_fields], dim=-1)\n        keys = torch.cat([item_emb[n][:, :-1] for n in self.item_fields], dim=-1)\n        values = keys\n        if self.action_field:\n            values = torch.cat((values, item_emb[self.action_field][:, :-1]), dim=-1)\n        # Arbitrary valid-vocabulary payloads at masked positions have no path\n        # into content, membership, counts or feedback statistics.\n        valid = (mask > 0)[:, :, None]\n        keys = keys * valid.to(keys.dtype)\n        values = values * valid.to(values.dtype)\n        context = torch.cat([user_emb[n] for n in self.user_fields], dim=-1)\n        members = self._membership(item, mask)\n        counts = members.sum(dim=-1)\n        divisor = counts.clamp(min=1)[:, :, None]\n        batch = mask.shape[0]\n        if keys.shape[1]:\n            mean_keys = torch.bmm(members.to(keys.dtype), keys) / divisor\n            mean_values = torch.bmm(members.to(values.dtype), values) / divisor\n        else:\n            mean_keys = keys.new_zeros((batch, self.num_slots, self.key_width))\n            mean_values = values.new_zeros((batch, self.num_slots, self.value_width))\n        occupied = (counts > 0)[:, :, None]\n        mean_keys = mean_keys * occupied.to(mean_keys.dtype)\n        mean_values = mean_values * occupied.to(mean_values.dtype)\n        slots = self.slot_projection(mean_values)\n        slots = slots * occupied.to(slots.dtype)\n        if not self.include_content:\n\"\"\"Target-relation summaries: content x explicit-count factorial study.\n\nInherited from g0-r0002-replica_seven: all trainable modules, initialization\norder, five temporal summaries, raw bypasses, interaction and task towers.\nSeven units now optionally select global or equal-target-field history events\nBEFORE pooling, retaining each selected event's complete item/action value.\nThe count switch controls only the explicit count channel; content magnitude\ncan still carry count information. This is not a claim of a novel mechanism.\n\"\"\"\nimport math\nimport torch\nfrom torch import nn\nfrom unirank.pytorch.models import MultiTaskModel\nfrom unirank.pytorch.layers import FeatureEmbeddingDict\nfrom unirank.pytorch.layers.activations import Dice\n\n\nCONFIG = {\n    'embedding_dim': 16,\n    'attention_hidden_units': [64, 32],\n    'tower_hidden_units': [128, 64],\n    'token_dim': 32,\n    'num_heads': 2,\n    'slot_mode': 'recency',\n    'representation_mode': 'replicas',\n    'content_mode': 'relation',\n    'count_mode': 'relation',\n}\n\n\nclass JointBlock(nn.Module):\n    \"\"\"Pre-norm attention with invalid slots excluded as keys and outputs.\"\"\"\n\n    def __init__(self, width, heads):\n        super().__init__()\n        self.heads = heads\n        self.head_width = width // heads\n        self.norm1 = nn.LayerNorm(width)\n        self.qkv = nn.Linear(width, 3 * width)\n        self.output = nn.Linear(width, width)\n        self.norm2 = nn.LayerNorm(width)\n        self.ffn = nn.Sequential(nn.Linear(width, 2 * width), nn.SiLU(),\n                                 nn.Linear(2 * width, width))\n\n    def forward(self, tokens, valid):\n        batch, count, width = tokens.shape\n        qkv = self.qkv(self.norm1(tokens)).reshape(\n            batch, count, 3, self.heads, self.head_width)\n        query, key, value = qkv.permute(2, 0, 3, 1, 4).unbind(0)\n        # FP32 scores/softmax avoid overflow under the frozen BF16 autocast.\n        # Explicitly disable autocast: .float() alone does not protect matmul.\n        with torch.autocast(device_type=tokens.device.type, enabled=False):\n            scores = torch.matmul(query.float(), key.float().transpose(-1, -2))\n            scores = scores / math.sqrt(self.head_width)\n            scores = scores.masked_fill(~valid[:, None, None, :], float('-inf'))\n            attention = torch.softmax(scores, dim=-1)\n        mixed = torch.matmul(attention.to(value.dtype), value)\n        mixed = mixed.transpose(1, 2).reshape(batch, count, width)\n        tokens = tokens + self.output(mixed)\n        tokens = tokens + self.ffn(self.norm2(tokens))\n        return tokens * valid.unsqueeze(-1).to(tokens.dtype)\n\n\nclass Model(MultiTaskModel):\n    def __init__(self, feature_map, model_id='TargetRelationStudy', gpu=-1,\n                 embedding_dim=16, attention_hidden_units=(64, 32),\n                 tower_hidden_units=(128, 64), token_dim=32, num_heads=2,\n                 slot_mode='recency', representation_mode='replicas',\n                 content_mode='relation', count_mode='relation', num_tasks=None,\n                 task='binary_classification', **kwargs):\n        if num_tasks is not None and num_tasks != len(feature_map.labels):\n            raise ValueError('Task count mismatch')\n        if list(feature_map.labels) != ['is_click', 'cart', 'fav', 'buy']:\n            raise ValueError('This study requires the frozen four-task order')\n        if slot_mode not in ('pooled', 'recency'):\n            raise ValueError('Unknown slot construction')\n        if token_dim <= 0 or num_heads <= 0 or token_dim % num_heads:\n            raise ValueError('token_dim must be divisible by num_heads')\n        super().__init__(feature_map, model_id=model_id, gpu=gpu,\n                         num_tasks=len(feature_map.labels), task=task, **kwargs)\n        if representation_mode != 'replicas':\n            raise ValueError('This factorial study starts from replica_seven')\n        if content_mode not in ('relation', 'replicas'):\n            raise ValueError('Unknown summary content')\n        if count_mode not in ('relation', 'temporal'):\n            raise ValueError('Unknown explicit count channel')\n        self.slot_mode = slot_mode\n        self.representation_mode = representation_mode\n        self.content_mode = content_mode\n        self.count_mode = count_mode\n        self.embedding_layer = FeatureEmbeddingDict(feature_map, embedding_dim)\n        self.item_fields = [name for name, spec in feature_map.features.items()\n                            if spec.get('source') == 'item' and spec['type'] != 'meta']\n        self.user_fields = [name for name, spec in feature_map.features.items()\n                            if spec.get('source') not in ('item', 'action')\n                            and spec['type'] != 'meta']\n        self.action_field = next((name for name, spec in feature_map.features.items()\n                                  if spec.get('source') == 'action'), None)\n        if not self.item_fields or not self.user_fields or self.action_field is None:\n            raise ValueError('Required released feature groups are missing')\n        self.key_width = len(self.item_fields) * embedding_dim\n        self.value_width = self.key_width + embedding_dim\n        self.static_count = len(self.user_fields) + len(self.item_fields)\n        # All four arms have 35 summary tokens and identical parameters.\n        value_fields = self.item_fields + [self.action_field]\n        expected = {'item_id', 'cate_id', 'campaign_id', 'customer_id',\n                    'brand', 'price_bucket', 'action'}\n        if set(value_fields) != expected or len(value_fields) != 7:\n            raise ValueError('Expected the frozen six item fields plus action')\n        self.group_count = len(value_fields)\n        self.token_count = self.static_count + 5 * self.group_count\n        # Keep the parent's nonrandom buffer and module construction order.\n        selection = torch.zeros(self.group_count, self.value_width)\n        selection.fill_(1.0 / math.sqrt(self.group_count))\n        self.register_buffer('content_selection', selection)\n        self.match_fields = list(self.item_fields)\n        self.match_padding = {name: feature_map.features[name].get('padding_idx', 0)\n                              for name in self.match_fields}\n        layers = []\n        width = 4 * self.key_width\n        for hidden in attention_hidden_units:\n            layers.extend([nn.Linear(width, hidden), Dice(hidden)])\n            width = hidden\n        layers.append(nn.Linear(width, 1))\n        self.local_activation = nn.Sequential(*layers)\n        self.field_projection = nn.Linear(embedding_dim, token_dim)\n        self.slot_projection = nn.Linear(self.value_width + 1, token_dim)\n        self.token_identity = nn.Parameter(torch.empty(1, self.token_count, token_dim))\n        self.interaction = JointBlock(token_dim, num_heads)\n        # Retain raw static fields and the original global DIN sum in all arms.\n","exit_code":0,"status":"completed"}}
