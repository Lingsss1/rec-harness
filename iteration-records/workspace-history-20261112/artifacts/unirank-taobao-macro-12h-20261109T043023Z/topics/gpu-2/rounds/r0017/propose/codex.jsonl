en (F) x token_dim\\n137: \\n138:         # unified model\\n139:         s_tokens, unified_tokens = self.activation_checkpoint(\\n140:             self.unified_interaction_layers,\\n141:             s_tokens,\\n142:             unified_tokens,\\n143:             mask\\n144:         )\\n145: \\n146:         bottom_output = torch.cat([\\n147:             unified_tokens.flatten(start_dim=1),\\n148:             self.masked_avg_pooling(s_tokens, mask),\\n149:         ], dim=-1)\\n150:         tower_output = [self.tower[i](bottom_output) for i in range(self.num_tasks)]\\n151:         y_pred = [self.output_activation[i](tower_output[i]) for i in range(self.num_tasks)]\\n152:         return_dict = {}\\n153:         labels = self.feature_map.labels\\n154:         for i in range(self.num_tasks):\\n155:             return_dict[\\\"{}_pred\\\".format(labels[i])] = y_pred[i]\\n156:         return return_dict\\n157: \\n158: class ESTBlocks(nn.Module):\"\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport ast, hashlib\noriginal=Path('history_g2_r0016_diversity_factorized.py').read_text()\nassert Path('candidate.py').read_text()==original\nchanges=[]\ndef change(old,new):\n global original\n assert original.count(old)==1,(old,original.count(old))\n original=original.replace(old,new)\n changes.append((old,new))\nold_doc=ast.get_docstring(ast.parse(original),clean=False)\nnew_doc='''Prospective component-specific reliability for centered feedback moments.\n\nA 2 x 2 replacement study independently assigns diversity or exposure support\nfor the local rate contrast and within-slot event-feedback covariance. All arms\nretain the same event moments, raw feedback fractions, counts and parameters.\nDiversity is inverse encoded-ad concentration, not an independence estimate.\nTied-support arms reproduce the previous joint formulas; mixed arms test the\nobserved support-by-moment crossover. Host evaluation determines utility.\n'''\nchange('\\\"\\\"\\\"'+old_doc+'\\\"\\\"\\\"','\\\"\\\"\\\"'+new_doc+'\\\"\\\"\\\"')\nold_config=next(n for n in ast.parse(original).body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets))\nconfig=ast.literal_eval(old_config.value)\nnewconfig=dict(config,moment_mode='joint',covariance_support_mode='exposure')\nchange(ast.get_source_segment(original,old_config),'CONFIG = '+repr(newconfig))\nchange(\\\"                 support_mode=CONFIG['support_mode'],\\\\n\\\", \\\"                 support_mode=CONFIG['support_mode'],\\\\n                 covariance_support_mode=CONFIG['covariance_support_mode'],\\\\n\\\")\nchange(\\\"        self.support_mode = support_mode\\\\n\\\", \\\"        if covariance_support_mode not in ('diversity', 'exposure'):\\\\n            raise ValueError('Unknown covariance reliability support')\\\\n        self.support_mode = support_mode\\\\n        self.covariance_support_mode = covariance_support_mode\\\\n\\\")\nchange('        \\\"\\\"\\\"Return n\"'^2 / sum_i n_i''^2, or the original exposure count n.'\"\\\\n', '        \\\"\\\"\\\"Return n\"'^2 / sum_i n_i''^2 for component-specific support selection.'\"\\\\n')\nchange(\\\"        return diversity if self.support_mode == 'diversity' else counts\\\\n\\\", \\\"        return diversity\\\\n\\\\n    def _component_supports(self, diversity, counts):\\\\n        \\\\\\\"\\\\\\\"\\\\\\\"Choose rate and covariance supports without modules or RNG changes.\\\\n\\\\n        Each support is slot-local [B,8]. Both choices are computed in every\\\\n        arm. Keep exposure denominators, raw counts and fractions unchanged.\\\\n        \\\\\\\"\\\\\\\"\\\\\\\"\\\\n        rate_support = diversity if self.support_mode == 'diversity' else counts\\\\n        covariance_support = (diversity if self.covariance_support_mode == 'diversity'\\\\n                              else counts)\\\\n        return rate_support, covariance_support\\\\n\\\")\nchange('        support = self._reliability_support(clean_item, valid, members, counts)\\\\n', '        diversity = self._reliability_support(clean_item, valid, members, counts)\\\\n        support, covariance_support = self._component_supports(diversity, counts)\\\\n')\nchange('        local_weight = support / (support + self.shrinkage_strength)\\\\n', '        # Rate interpolation and covariance reliability are independent factors.\\\\n        local_weight = covariance_support / (covariance_support + self.shrinkage_strength)\\\\n')\nchange('        # All four arms have 35 summary tokens and identical parameters.\\\\n', '        # All support assignments have 35 summary tokens and identical parameters.\\\\n')\nchange('        # Factorized arms perform the same arithmetic, then suppress only\\\\n        # the covariance. Thus parameters, initialization and operation shapes\\\\n        # are shared. They also calibrate equality to the archived products.\\\\n', '        # Retain both moment paths and operation shapes. A factorized setting\\\\n        # suppresses covariance only, permitting archived-incumbent calibration.\\\\n        # The proposed 2 x 2 suite uses joint moments in every arm.\\\\n')\n# Every non-CONFIG edit is reversible to the supplied incumbent source.\nrecovered=original\nfor old,new in reversed(changes):\n assert recovered.count(new)==1\n recovered=recovered.replace(new,old)\nassert recovered==Path('history_g2_r0016_diversity_factorized.py').read_text()\nvariants=[('candidate.py','diversity','exposure'),\n          ('control_reverse_support.py','exposure','diversity'),\n          ('control_tied_diversity.py','diversity','diversity'),\n          ('control_tied_exposure.py','exposure','exposure')]\nfor filename,rate,covariance in variants:\n cfg=dict(newconfig,support_mode=rate,covariance_support_mode=covariance)\n src=original.replace('CONFIG = '+repr(newconfig),'CONFIG = '+repr(cfg))\n compile(src,filename,'exec')\n Path(filename).write_text(src)\n print(filename,hashlib.sha256(src.encode()).hexdigest(),rate,covariance)\nprint('Inverse-edit exact incumbent recovery: PASS')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
