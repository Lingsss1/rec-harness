{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport ast, hashlib, random, math\nfrom pathlib import Path\nfiles=['candidate.py','control_reverse_support.py','control_tied_diversity.py','control_tied_exposure.py']\ntrees=[]\nfor name in files:\n text=Path(name).read_text();tree=ast.parse(text);compile(text,name,'exec')\n cfg=next(x for x in tree.body if isinstance(x,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in x.targets))\n config=ast.literal_eval(cfg.value)\n assert config['moment_mode']=='joint' and config['centering_mode']=='user'\n assert config['shrinkage_strength']==4.0\n for n in ast.walk(tree):\n  if isinstance(n,(ast.Import,ast.ImportFrom)):\n   modules=[a.name for a in n.names] if isinstance(n,ast.Import) else [n.module]\n   assert all(m.split('.')[0] in {'math','torch','unirank'} for m in modules)\n  if isinstance(n,ast.Call):\n   assert not (isinstance(n.func,ast.Name) and n.func.id in {'open','eval','exec','__import__'})\n   assert not (isinstance(n.func,ast.Attribute) and n.func.attr in {'load','save','read_text','write_text','system','popen'})\n tree.body.remove(cfg);trees.append(ast.dump(tree,include_attributes=False))\nassert len(set(trees))==1\nsrc=ast.parse(Path('candidate.py').read_text())\nmodel=next(n for n in src.body if isinstance(n,ast.ClassDef) and n.name=='Model')\nhelper=next(n for n in model.body if isinstance(n,ast.FunctionDef) and n.name=='_component_supports')\nns={};exec(compile(ast.fix_missing_locations(ast.Module(body=[helper],type_ignores=[])),'<extracted support selector>','exec'),ns)\nselect=ns['_component_supports']\nclass Settings:pass\nidentity_checks=0\nfor r in ('diversity','exposure'):\n for c in ('diversity','exposure'):\n  obj=Settings();obj.support_mode=r;obj.covariance_support_mode=c\n  diversity_marker=object();exposure_marker=object()\n  a,b=select(obj,diversity_marker,exposure_marker)\n  assert a is (diversity_marker if r=='diversity' else exposure_marker)\n  assert b is (diversity_marker if c=='diversity' else exposure_marker)\n  identity_checks+=2\n# Independent scalar ideal-arithmetic mechanism checks; these do not execute torch.\nrng=random.Random(20262027);checks=0\nfor n in range(101):\n for profile in ('unique','one_id','mixed'):\n  ids=list(range(n)) if profile=='unique' else ([1]*n if profile=='one_id' else [rng.randrange(max(1,n//3)) for _ in range(n)])\n  hist={}\n  for i in ids:hist[i]=hist.get(i,0)+1\n  diversity=n*n/max(1,sum(x*x for x in hist.values()))\n  assert 0<=diversity<=n+1e-12\n  if n and profile=='unique':assert diversity==n\n  if n and profile=='one_id':assert diversity==1\n  x=[rng.uniform(-2,2) for _ in ids];y=[rng.randrange(2) for _ in ids]\n  mean=sum(x)/max(1,n);fraction=sum(y)/max(1,n)\n  covariance=sum(a*b for a,b in zip(x,y))/max(1,n)-mean*fraction\n  background=rng.random()\n  outputs={}\n  for r in ('diversity','exposure'):\n   for c in ('diversity','exposure'):\n    obj=Settings();obj.support_mode=r;obj.covariance_support_mode=c\n    rs,cs=select(obj,diversity,float(n));ar=rs/(rs+4);ac=cs/(cs+4)\n    gate=ar*fraction+(1-ar)*background\n    actual=mean*gate+ac*covariance-mean*background\n    reference=ar*mean*(fraction-background)+ac*covariance\n    assert math.isclose(actual,reference,rel_tol=1e-12,abs_tol=1e-12)\n    if r==c:\n     old=mean*(ar*fraction+(1-ar)*background)+ar*covariance-mean*background\n     assert actual==old\n    if n==0:assert actual==0\n    outputs[r,c]=actual;checks+=1\n  if profile=='unique':assert len(set(outputs.values()))==1\nprint('PASS: syntax/compile for four standalone modules; identical AST outside CONFIG; allowed imports/no file IO audit')\nprint('PASS:',identity_checks,'exact extracted support-selector identity assertions')\nprint('PASS:',checks,'scalar decomposition/tied-endpoint/empty/unique-ID checks; no tensor or BF16 execution')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
