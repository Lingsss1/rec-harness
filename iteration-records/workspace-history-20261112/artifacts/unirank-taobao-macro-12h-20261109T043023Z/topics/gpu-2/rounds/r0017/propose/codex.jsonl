ocol_ref']==r['required_study_protocol_ref']\nallowed=set(r['context']['allowed_observation_ids'])\nassert set(p['study']['evidence_refs'])<=allowed\nassert p['parent_trial'] in allowed\nassert 1<=len(p['variants'])<=4\nassert len({v['name'] for v in p['variants']})==len(p['variants'])\nassert len({v['file'] for v in p['variants']})==len(p['variants'])\nassert any(v['role']=='candidate' for v in p['variants'])\nfrozen={'epochs','batch_size','train_seed','seed','history_limit','dense_learning_rate','sparse_learning_rate','optimizer','learning_rate','precision','num_workers'}\nfor v in p['variants']:\n assert v['role'] in {'candidate','control'}\n assert Path(v['file']).name==v['file'] and v['file'].endswith('.py')\n src=Path(v['file']).read_text();tree=ast.parse(src);compile(src,v['file'],'exec')\n literal=ast.literal_eval(next(n.value for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CONFIG' for t in n.targets)))\n assert literal==v['config']\n assert not(set(v['config']) & frozen)\n assert hashlib.sha256(src.encode()).hexdigest() in v['note']\n assert {n.name for n in tree.body if isinstance(n,ast.ClassDef)}>={'Model'}\n assert 'covariance_support_mode' in v['config']\nassert {x['knowledge_id'] for x in p['knowledge_assessments']}=={'unirank-method-infnet','unirank-method-est'}\nfor a in p['knowledge_assessments']:\n assert a['decision'] in {'used','considered','rejected','unresolved'}\n assert {'knowledge_id','decision','rationale','transformed_mechanism','variant_names','nearest_work_difference','falsifier'}<=set(a)\nPath('proposal.json').write_text(json.dumps(p,indent=2,allow_nan=False)+'\\\\n')\nprint('PASS: study schema, protocol hash, all evidence IDs, parent lineage, variant bounds/names/roles/files, literal configs, no frozen overrides, source hashes, knowledge-assessment coverage')\nprint('Proposal SHA256',hashlib.sha256(Path('proposal.json').read_bytes()).hexdigest())\nPY\"","aggregated_output":"","exit_code":null,"s