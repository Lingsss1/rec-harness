"study_schema\": {\n    \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n    \"title\": \"Task-independent prospective mechanism study\",\n    \"type\": \"object\",\n    \"additionalProperties\": false,\n    \"required\": [\n      \"id\",\n      \"protocol_ref\",\n      \"evidence_refs\",\n      \"question\",\n      \"hypothesis\",\n      \"nearest_work\",\n      \"inherited_components\",\n      \"proposed_difference\",\n      \"predictions\",\n      \"falsifiers\",\n      \"alternative_explanations\",\n      \"contrasts\",\n      \"cost_plan\"\n    ],\n    \"properties\": {\n      \"id\": {\n        \"type\": \"string\",\n        \"minLength\": 1\n      },\n      \"protocol_ref\": {\n        \"type\": \"string\",\n        \"minLength\": 1\n      },\n      \"evidence_refs\": {\n        \"type\": \"array\",\n        \"minItems\": 1,\n        \"items\": {\n          \"type\": \"string\"\n        }\n      },\n      \"question\": {\n        \"type\": \"string\",\n        \"minLength\": 1\n      },\n      \"hypothesis\": {\n        \"type\": \"string\",\n        \"minLength\": 1\n      },\n      \"nearest_work\": {\n        \"type\": \"array\",\n        \"minItems\": 1,\n        \"items\": {\n          \"type\": \"object\",\n          \"additionalProperties\": false,\n          \"required\": [\n            \"source_ref\",\n            \"verification\",\n            \"difference\"\n          ],\n          \"properties\": {\n            \"source_ref\": {\n              \"type\": \"string\"\n            },\n            \"verification\": {\n              \"enum\": [\n                \"discovered\",\n                \"read\",\n                \"archived\",\n                \"implementation_checked\"\n              ]\n            },\n            \"difference\": {\n              \"type\": \"string\",\n              \"minLength\": 1\n            }\n          }\n        }\n      },\n      \"inherited_components\": {\n        \"type\": \"array\",\n        \"items\":