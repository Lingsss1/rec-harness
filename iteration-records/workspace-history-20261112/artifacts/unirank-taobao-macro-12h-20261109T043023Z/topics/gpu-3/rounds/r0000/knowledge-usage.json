  "assessments": [
    {
      "knowledge_id": "unirank-method-infnet",
      "decision": "used",
      "rationale": "Used its inspected task-aware aggregation idea as nearest-work motivation for an early task-specific history readout, rather than copying a full architecture or accepting external effectiveness. Baseline source is the empirical reason for testing that location.",
      "transformed_mechanism": "One shared DIN relevance trunk with task-indexed score rows and action-aware input; keep every valid feedback accessible to each task. This deliberately omits task-mask hub pooling, iterative hub exchange and gated broadcasts.",
      "variant_names": [
        "task_action_relevance",
        "shared_action_relevance",
        "task_item_relevance",
        "shared_item_relevance"
      ],
      "nearest_work_difference": "Relative to pinned INFNet implementation, a one-stage controlled task/action relevance factorization without hub tokens or layered field/sequence/task broadcasting. Original method full-paper details unresolved; no novelty claim.",
      "falsifier": "No positive task-routing contrast after matched action controls and paired repetitions, or gains confined to shared controls.",
      "source_refs": [
        "unirank-benchmark-v2",
        "unirank-code:INFNet",
        "paper:infnet"
      ],
