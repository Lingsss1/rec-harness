    {
      "knowledge_id": "unirank-method-mixformer",
      "decision": "considered",
      "rationale": "Inspected evolving-query and shared-bottom forward path. Repeated sequence/field refinement is not identified by the present baseline diagnostics and would add interacting changes before task participation is tested.",
      "transformed_mechanism": "None adopted; retain as a possible future whole-model alternative after task-readout evidence.",
      "variant_names": [],
      "nearest_work_difference": "Current candidate keeps a single target-conditioned retrieval stage and task-specific summaries, not iterative query mixing/cross-attention with a shared averaged bottom.",
      "falsifier": "A later budget-matched repeated-query control could show that evolving field queries, rather than task-specific history weights, explain the useful signal.",
